{
  "name": "hubstudio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/check-content-todo.mjs && node --experimental-strip-types --no-warnings scripts/i18n-guard.mjs && node --experimental-strip-types scripts/generate-llms-full.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:pricing": "node --experimental-strip-types scripts/test-pricing.mjs && node --experimental-strip-types scripts/test-pricing-video.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,js,css,md}\"",
    "hooks:install": "node scripts/install-hooks.mjs",
    "img:batch": "node scripts/optimize-images-batch.mjs",
    "gen": "node scripts/generate-image.mjs",
    "gen:max": "node scripts/generate-image-max.mjs",
    "edit": "node scripts/edit-image.mjs",
    "edit:max": "node scripts/edit-image-max.mjs",
    "help:sync": "node scripts/sync-help.mjs",
    "content:todo": "node scripts/check-content-todo.mjs",
    "llms:full": "node --experimental-strip-types scripts/generate-llms-full.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "i18n": "node --experimental-strip-types --no-warnings scripts/i18n.mjs",
    "i18n:local": "node --experimental-strip-types --no-warnings scripts/i18n-local.mjs",
    "i18n:tx": "node --experimental-strip-types --no-warnings scripts/i18n-tx.mjs",
    "i18n:guard": "node --experimental-strip-types --no-warnings scripts/i18n-guard.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "dotenv": "^18.0.4",
    "node-html-parser": "^9.0.4",
    "resend": "^6.31.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
