---
/**
 * ArticleLayout: shared shell for every /resources/insights/<slug> article.
 * The page passes only `slug`; all meta comes from src/data/insights.ts.
 * Body markup goes in the default slot and is styled by `.prose` below.
 *
 * Allowed body elements (styled here, nothing else needed):
 *   <p>                        body paragraph
 *   <p class="standfirst">     larger opening paragraph
 *   <h2> / <h3>                section / sub headings
 *   <ul><li>                   bullet list (use for sequences too: no numerals)
 *   <li><strong>Label.</strong> copy   titled list row
 *   <blockquote>               pull quote
 *   <div class="callout">      emphasised aside box
 */
import Layout from './Layout.astro';
import Button from '../components/Button.astro';
import { getInsight, relatedInsights } from '../data/insights';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const insight = getInsight(slug);
const related = relatedInsights(slug, 3);

const SITE = 'https://hubstudio.ai';
const url = `${SITE}/resources/insights/${insight.slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: insight.title,
  description: insight.metaDescription,
  image: new URL(insight.image, SITE).href,
  datePublished: insight.dateISO,
  dateModified: insight.dateISO,
  author: { '@type': 'Person', name: insight.author },
  publisher: {
    '@type': 'Organization',
    name: 'hubStudio',
    url: SITE,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE}/logo/hubstudio-logo.png`,
      width: 1459,
      height: 416,
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: insight.category,
  inLanguage: 'en',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Insights',
      item: `${SITE}/resources/insights`,
    },
    { '@type': 'ListItem', position: 3, name: insight.title, item: url },
  ],
};
---

<Layout
  title={insight.metaTitle}
  description={insight.metaDescription}
  image={insight.image}
  ogType="article"
  publishedTime={insight.dateISO}
  modifiedTime={insight.dateISO}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- ===== Hero ===== -->
  <article class="art">
    <header class={`art-hero art-hero--${insight.tone}`}>
      <div class="container art-hero__inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/resources/insights">Insights</a>
          <span aria-hidden="true">/</span>
          <span>{insight.category}</span>
        </nav>
        <span class={`chip art-hero__tag art-hero__tag--${insight.tone}`}>{insight.category}</span>
        <h1 class="headline h1 reveal art-hero__title">{insight.title}</h1>
        <p class="lead art-hero__deck">{insight.deck}</p>
        <p class="art-hero__meta">
          <span>{insight.author}</span>
          <span class="art-hero__dot" aria-hidden="true"></span>
          <time datetime={insight.dateISO}>{insight.date}</time>
          <span class="art-hero__dot" aria-hidden="true"></span>
          <span>{insight.readingTime}</span>
        </p>
      </div>
      <div class="container">
        <img
          class="art-hero__img"
          src={insight.image}
          alt={insight.imageAlt}
          width="2000"
          height="1333"
          loading="eager"
        />
      </div>
    </header>

    <!-- ===== Body ===== -->
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>

    <!-- ===== Inline CTA ===== -->
    <div class="container">
      <aside class="art-cta card card--navy">
        <span class="eyebrow">Work with the studio</span>
        <h2 class="headline h3 art-cta__head">
          Turn this shift into a <span class="accent">content system</span>.
        </h2>
        <p class="art-cta__text">
          hubStudio builds human-led, AI-native content production: AIGC video and image work,
          structured content engines, and custom studios. Tell us what you need to produce.
        </p>
        <Button variant="primary-inverse" href="/contact">Talk to us</Button>
      </aside>
    </div>
  </article>

  <!-- ===== Related ===== -->
  <section class="section--tight related">
    <div class="container">
      <header class="related__head">
        <span class="eyebrow">Keep reading</span>
        <a class="related__all" href="/resources/insights">All insights &rarr;</a>
      </header>
      <div class="related__grid">
        {
          related.map((item) => (
            <a class="rcard card card--white" href={`/resources/insights/${item.slug}`}>
              <img
                class="rcard__img"
                src={item.image}
                alt={item.imageAlt}
                width="2000"
                height="1333"
                loading="lazy"
              />
              <span class="rcard__body">
                <span class={`chip rcard__tag rcard__tag--${item.tone}`}>{item.category}</span>
                <h3 class="rcard__title">{item.title}</h3>
                <p class="rcard__deck">{item.deck}</p>
                <span class="rcard__more">Read insight &rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .section--tight {
    padding-block: 64px 96px;
  }

  /* ---- Hero ---- */
  .art-hero {
    padding-top: 64px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--line-hairline);
  }
  .art-hero__inner {
    max-width: 820px;
  }
  .crumb {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .crumb a:hover {
    color: var(--brand-orange);
  }
  .art-hero__tag {
    margin-top: 26px;
  }
  .art-hero__tag--orange {
    background: rgba(233, 78, 27, 0.1);
    color: var(--brand-orange);
  }
  .art-hero__tag--navy {
    background: rgba(30, 58, 138, 0.1);
    color: var(--brand-navy);
  }
  .art-hero__title {
    margin-top: 20px;
    font-size: clamp(34px, 5vw, 60px);
  }
  .art-hero__deck {
    margin-top: 22px;
    max-width: 62ch;
  }
  .art-hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-mute);
  }
  .art-hero__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .art-hero__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    margin-top: 48px;
  }

  /* ---- Prose body ---- */
  .prose {
    max-width: 720px;
    margin-inline: auto;
    padding-top: 56px;
  }
  .prose :global(p) {
    font-size: var(--type-body);
    line-height: 1.7;
    color: var(--text-mute);
    margin-top: 22px;
  }
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(.standfirst) {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-ink);
  }
  .prose :global(strong) {
    color: var(--text-ink);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--brand-orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(h2) {
    margin-top: 52px;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-size: var(--type-h3);
  }
  .prose :global(h3) {
    margin-top: 36px;
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 14px;
  }
  .prose :global(ul) {
    margin-top: 22px;
    display: grid;
    gap: 12px;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 26px;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .prose :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
    opacity: 0.65;
  }
  .prose :global(li strong) {
    display: block;
    margin-bottom: 2px;
  }
  .prose :global(blockquote) {
    margin: 40px 0;
    padding: 4px 0 4px 28px;
    border-left: 3px solid var(--brand-orange);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.32;
    color: var(--text-ink);
  }
  .prose :global(.callout) {
    margin-top: 36px;
    padding: 28px 32px;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .prose :global(.callout > :first-child) {
    margin-top: 0;
  }

  /* ---- Inline CTA ---- */
  .art-cta {
    max-width: 720px;
    margin: 64px auto 0;
    padding: 44px;
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  @media (max-width: 600px) {
    .art-cta {
      padding: 32px 24px;
    }
  }
  .art-cta .eyebrow {
    color: rgba(240, 237, 233, 0.6);
  }
  .art-cta__text {
    font-size: var(--type-small);
    line-height: 1.6;
    color: rgba(240, 237, 233, 0.8);
    max-width: 56ch;
  }

  /* ---- Related ---- */
  .related__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    border-top: 1px solid var(--line-hairline);
    padding-top: 40px;
  }
  .related__all {
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .related__grid {
    display: grid;
    gap: var(--gap-card);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .rcard {
    display: flex;
    flex-direction: column;
    transition: transform 200ms ease-out;
  }
  .rcard:hover {
    transform: translateY(-4px);
  }
  .rcard__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .rcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 26px;
  }
  .rcard__tag--orange {
    background: rgba(233, 78, 27, 0.1);
    color: var(--brand-orange);
  }
  .rcard__tag--navy {
    background: rgba(30, 58, 138, 0.1);
    color: var(--brand-navy);
  }
  .rcard__title {
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .rcard__deck {
    font-size: var(--type-small);
    line-height: 1.55;
    color: var(--text-mute);
  }
  .rcard__more {
    margin-top: auto;
    padding-top: 4px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
</style>

<script>
  /* Reveal headline on scroll (matches global .reveal behaviour). */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>
