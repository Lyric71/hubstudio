---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, LOCALES, OG_LOCALE, alternates, pathIn } from '../i18n/paths';

interface Props {
  title?: string;
  description?: string;
  /** Render the header transparently over a dark hero (light nav until scroll). */
  heroOverlay?: boolean;
  /** Root-relative or absolute path to the social share image (1200x630). */
  image?: string;
  /** Open Graph object type. Articles and how-to guides pass 'article'. */
  ogType?: 'website' | 'article';
  /** Keep the page out of the search index (thank-you, 404). */
  noindex?: boolean;
  /** ISO dates, emitted as article:* tags when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Root-relative image to preload (the LCP hero image of the page). */
  preloadImage?: string;
}

const SITE = 'https://www.hubstudio.ai';

// A French or Chinese page renders this English page (Astro.url is the
// English address) and the middleware translates it; locals say which.
const locale = Astro.locals.locale ?? 'en';

const {
  title,
  description,
  heroOverlay = false,
  image = '/og-default.png',
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  preloadImage,
} = Astro.props;
const pageTitle = title ?? 'hubStudio | The AI production app, and the studio behind it';
const pageDescription =
  description ??
  'Make images, video and social posts with the leading AI engines in the hubStudio app, or have our studio make them for you. Pay as you go, no seat fees.';

const path = Astro.url.pathname;
const canonical = new URL(pathIn(path, locale) ?? path, SITE).href;
const ogImage = new URL(image, SITE).href;
const ogLocale = OG_LOCALE[locale];

// hreflang: every language the page ships in, plus x-default. A page with no
// translation (none today) emits none rather than alternates that 404.
const hreflang = noindex ? [] : alternates(path, SITE);

// Site-wide identity, carried on every page so any page can anchor the brand.
const orgId = `${SITE}/#organization`;
const founderId = `${SITE}/#cyril-drouin`;
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'hubStudio',
      url: SITE,
      description:
        'hubStudio makes images, video and social content with AI: a self-serve app with the leading image and video engines, and a creative studio that makes the work for brands, inside the app or outside it.',
      email: 'hello@bearingbridge.com',
      logo: {
        '@type': 'ImageObject',
        url: `${SITE}/logo/hubstudio-logo.png`,
        width: 358,
        height: 102,
      },
      image: `${SITE}/og-default.png`,
      areaServed: 'Worldwide',
      // Registered address. Studios are listed as departments below so each
      // city carries its own PostalAddress rather than one flattened blob.
      address: {
        '@type': 'PostalAddress',
        streetAddress: "Capitol Centre, 5-19 Jardine's Bazaar",
        addressLocality: 'Causeway Bay',
        addressRegion: 'Hong Kong',
        addressCountry: 'HK',
      },
      department: [
        {
          '@type': 'Organization',
          name: 'hubStudio Shanghai',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Trinity Plaza, 19F, 868 Changshou Road',
            addressLocality: 'Putuo District, Shanghai',
            addressCountry: 'CN',
          },
        },
        {
          '@type': 'Organization',
          name: 'hubStudio Paris',
          address: {
            '@type': 'PostalAddress',
            streetAddress: '12 rue Curial',
            addressLocality: 'Paris',
            postalCode: '75019',
            addressCountry: 'FR',
          },
        },
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'hello@bearingbridge.com',
        contactType: 'customer service',
        availableLanguage: ['English', 'French', 'Chinese'],
      },
      // sameAs: add once an official hubStudio company profile exists (company
      // LinkedIn, Crunchbase, etc.). The founder's personal profiles belong on
      // the Person node below, not here.
      parentOrganization: {
        '@type': 'Organization',
        name: 'BeyondBorderGroup',
        url: 'https://beyondbordergroup.org',
      },
      founder: { '@id': founderId },
    },
    {
      '@type': 'Person',
      '@id': founderId,
      name: 'Cyril Drouin',
      jobTitle: 'Founder and CEO',
      worksFor: { '@id': orgId },
      sameAs: [
        'https://www.linkedin.com/in/cyril-d-68835729/',
        'https://cyrildrouin.substack.com/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'hubStudio',
      description:
        'The hubStudio app for AI image, video and social production, and the hubStudio studio, which makes the work for you.',
      publisher: { '@id': orgId },
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Insights RSS feed autodiscovery (feed readers, LinkedIn, schedulers). -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="hubStudio Insights"
      href="/resources/insights/rss.xml"
    />

    <!-- Self-hosted fonts: preload the two that paint above the fold. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-500-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }

    {hreflang.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="hubStudio" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogType === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(siteSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header overlay={heroOverlay} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
