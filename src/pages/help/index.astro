---
/**
 * /help: the hubStudio help center home.
 * Hero with a filter box, then one band per group of index.md, each with its
 * article cards, then the way into the app. The articles come from
 * src/content/help/ (npm run help:sync). No ordinal numerals on cards.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { APP_URL } from '../../lib/links';
import { helpArticles, helpGroups, helpIntro } from '../../lib/help';

const SITE = 'https://www.hubstudio.ai';

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'hubStudio Help Center',
  description: 'Guides for the hubStudio app: images, videos, social posts, validation, teams, clients, payments and your account.',
  url: `${SITE}/help`,
  hasPart: helpArticles.map((a) => ({
    '@type': 'TechArticle',
    name: a.title,
    description: a.description,
    url: `${SITE}/help/${a.slug}`,
  })),
};
---

<Layout
  title="hubStudio Help Center: Guides for the App"
  description="Guides for the hubStudio app: explore the engines, create images and videos, publish on social networks, get approval, run your team and clients, and manage your balance."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <!-- ===== Hero ===== -->
  <section class="hc-hero">
    <div class="container">
      <span class="eyebrow">Help center</span>
      <h1 class="headline h1 reveal hc-hero__title">
        How to <span class="accent">hubStudio</span>.
      </h1>
      <p class="lead hc-hero__lead">{helpIntro}</p>

      <label class="hc-search" for="hc-filter">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
        <span class="sr-only">Search the guides</span>
        <input id="hc-filter" type="search" placeholder="Search the guides: clients, invoices, TikTok…" autocomplete="off" />
      </label>
      <p class="hc-empty" hidden>No guide matches. Try another word, or <a href="/contact">ask us</a>.</p>
    </div>
  </section>

  <!-- ===== Groups ===== -->
  <div class="hc-groups">
    {
      helpGroups.map((g) => (
        <section class="hc-group" data-hc-group>
          <div class="container hc-group__inner">
            <h2 class="hc-group__title">{g.title}</h2>
            <div class="hc-grid">
              {g.articles.map((a) => (
                <a
                  class="hc-card"
                  href={`/help/${a.slug}`}
                  data-hc-card
                  data-hc-text={`${a.title} ${a.excerpt} ${a.description}`.toLowerCase()}
                >
                  <h3 class="hc-card__title">{a.title}</h3>
                  <p class="hc-card__desc">{a.excerpt}</p>
                  <span class="hc-card__cta">
                    Read the guide <span aria-hidden="true">&rarr;</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- ===== Into the app ===== -->
  <section class="hc-cta">
    <div class="container">
      <div class="card card--navy hc-cta__card">
        <span class="eyebrow hc-cta__eyebrow">Ready when you are</span>
        <h2 class="headline h2 hc-cta__title">
          Open the <span class="accent">studio</span>.
        </h2>
        <p class="hc-cta__text">
          Sign in to make images, videos and posts with your team. Still stuck after reading?
          Write to us and a person answers.
        </p>
        <div class="hc-cta__actions">
          <Button variant="primary" href={APP_URL}>Open hubStudio</Button>
          <Button variant="on-dark" href="/contact">Contact us</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const input = document.getElementById('hc-filter') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-hc-card]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-hc-group]'));
  const empty = document.querySelector<HTMLElement>('.hc-empty');
  input?.addEventListener('input', () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    for (const c of cards) c.hidden = !words.every((w) => (c.dataset.hcText ?? '').includes(w));
    for (const g of groups) g.hidden = !g.querySelector('[data-hc-card]:not([hidden])');
    if (empty) empty.hidden = cards.some((c) => !c.hidden);
  });
</script>

<style>
  /* ---- Hero ---- */
  .hc-hero {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .hc-hero__title {
    margin-top: 16px;
  }
  .hc-hero__lead {
    margin-top: 22px;
    max-width: 62ch;
  }
  .hc-search {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    margin-top: 36px;
    padding: 0 22px;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
    transition: border-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .hc-search:focus-within {
    border-color: var(--brand-orange);
    box-shadow: 0 0 0 4px rgba(233, 78, 27, 0.12);
  }
  .hc-search svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--text-mute);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .hc-search input {
    flex: 1;
    min-width: 0;
    padding: 16px 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: var(--type-body);
    color: var(--text-ink);
  }
  .hc-empty {
    margin-top: 18px;
    color: var(--text-mute);
  }
  .hc-empty a {
    color: var(--brand-orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---- Groups ---- */
  .hc-group {
    border-top: 1px solid var(--line-hairline);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .hc-group[hidden] {
    display: none;
  }
  .hc-group__inner {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 1000px) {
    .hc-group__inner {
      grid-template-columns: 260px 1fr;
      gap: 48px;
    }
  }
  .hc-group__title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-ink);
    padding-top: 8px;
  }
  .hc-group__title::before {
    content: '//';
    margin-right: 10px;
    color: var(--brand-orange);
  }
  .hc-grid {
    display: grid;
    gap: var(--gap-card);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .hc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .hc-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(24px, 2.6vw, 32px);
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: 22px;
    box-shadow: var(--shadow-card);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out, border-color 200ms ease-out;
  }
  .hc-card[hidden] {
    display: none;
  }
  .hc-card:hover {
    transform: translateY(-4px);
    border-color: rgba(233, 78, 27, 0.35);
    box-shadow: 0 18px 40px rgba(10, 10, 20, 0.12);
  }
  .hc-card__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .hc-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-mute);
  }
  .hc-card__cta {
    margin-top: auto;
    padding-top: 10px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .hc-card__cta span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .hc-card:hover .hc-card__cta span {
    transform: translateX(4px);
  }

  /* ---- Into the app ---- */
  .hc-cta {
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 9vw, 128px);
  }
  .hc-cta__card {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding: clamp(36px, 5vw, 72px);
  }
  .hc-cta__eyebrow {
    color: rgba(240, 237, 233, 0.7);
  }
  .hc-cta__title {
    color: var(--text-on-dark);
  }
  .hc-cta__text {
    max-width: 56ch;
    font-size: var(--type-body);
    line-height: 1.6;
    color: rgba(240, 237, 233, 0.78);
  }
  .hc-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
