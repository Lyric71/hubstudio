---
/**
 * AI Excellence (`/the-studio/ai-excellence`).
 * Narrative content sourced from ai-excellence-page.md. Brand name normalised
 * to the canonical "hubStudio" casing throughout. No ordinal numerals in any
 * card or repeated block, per the permanent no-numbers-in-cards rule: the
 * five-stage pipeline carries its sequence through stage names and visual
 * order only. Stat figures are data display (units attached), not ordinals.
 *
 * Layout mirrors who-we-are.astro: layered editorial. Image hero, overlapping
 * stat card, an image-backed capabilities trio, asymmetric splits, an audience
 * grid, a vertical pipeline flow, service cards, an FAQ accordion and a
 * closing CTA. Motion:
 * page-load stagger in the hero, scroll-reveal elsewhere, parallax on section
 * media, count-up on stats, plus a scroll-progress bar.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const heroChips = [
  'AIGC image',
  'AIGC video',
  'AIGC content',
  'Custom model training',
  'Prompt engineering',
];

/* S3: the three capabilities that fold into one studio. */
const unitePillars = [
  {
    name: 'Best in class creative',
    desc: 'A strong creative and design team drawn from 4A agencies, mixing international and Chinese talent.',
  },
  {
    name: 'AIGC technical experts',
    desc: 'AIGC engineers with deep hands-on experience, running our own dedicated GPU infrastructure.',
  },
  {
    name: 'Studio capabilities',
    desc: 'Account services, media, and live photo and video shooting, all under one roof.',
  },
];

const stats = [
  { value: 60, suffix: '%', label: 'Below traditional studio production cost' },
  { value: 7, suffix: 'x', label: 'Output scaled for brands working this way' },
  { value: 78, suffix: '%', label: 'Internal approval rate on AI assets, up from 22%' },
  { value: 6, suffix: 'wk', label: 'From brief to a trained custom model, at most' },
];

/* S4: the three-way market position. The hubStudio card is the resolved
   answer, so it carries the accent treatment. */
const stance = [
  {
    kind: 'Traditional studios',
    line: 'Craft, but too slow and too expensive for the volume marketing teams need now.',
  },
  {
    kind: 'Generic AI tools',
    line: 'Fast and cheap, weak on cultural nuance and brand voice. They hand you a tool, not an output.',
  },
  {
    kind: 'hubStudio',
    line: 'AI does the heavy lifting. Senior creatives make sure the result is something the brand can put its name on.',
    lead: true,
  },
];

/* S6: who we work with. One creative angle each, written for hubStudio. */
const audiences = [
  {
    name: 'Agencies',
    desc: 'White-label production capacity for groups that need to scale output without scaling headcount.',
  },
  {
    name: 'Brand marketing teams',
    desc: 'HiSense in consumer electronics, age20 in beauty, both running always-on content programs through the studio.',
  },
  {
    name: 'Retailers and eCommerce',
    desc: 'Thousands of SKUs across an almost infinite set of format requirements, held to one brand standard.',
  },
  {
    name: 'Manufacturers',
    desc: 'Global product libraries localized so regional sales teams sell with assets that fit their market.',
  },
  {
    name: 'Procurement leads',
    desc: 'Predictable monthly spend, clear deliverables, quarterly advance billing for budget clarity.',
  },
];

/* S6 icon set: one consistent 1.7px stroke system drawn for hubStudio.
   Interlocking frames, campaign horn, price tag, product box, billing
   calendar. currentColor lets each card recolour them. */
const audienceIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="3" width="12" height="12" rx="2.6"/><rect x="9" y="9" width="12" height="12" rx="2.6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4a2 2 0 0 0 2 2h1l1.6 4.6"/><path d="M4 12 17 5.4v13.2L4 12Z"/><path d="M17.4 9.4a3.2 3.2 0 0 1 0 5.2"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.6 12.4 12 4h6.4v6.4L10 18.8a1.7 1.7 0 0 1-2.4 0l-4-4a1.7 1.7 0 0 1 0-2.4Z"/><circle cx="14.9" cy="9.1" r="1.4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 21 8v8l-9 5.2L3 16V8Z"/><path d="M3 8l9 5.2L21 8"/><path d="M12 13.2V21"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.4" y="4.6" width="17.2" height="16" rx="2.6"/><path d="M3.4 9.6h17.2"/><path d="M8 2.8v3.6M16 2.8v3.6"/><path d="M7.8 14.4 10.2 16.8 16 11"/></svg>',
];

/* S7: the production pipeline. Five stages, sequence carried by name and
   order, no ordinal numerals. */
const pipeline = [
  {
    name: 'Brief',
    desc: 'We sit with the client team to map objectives, brand codes, audiences and channels.',
    meta: 'One or two working sessions',
  },
  {
    name: 'Train',
    desc: 'Engineers train custom AI models, including LoRA, on the brand’s visual language and product library.',
    meta: 'Three to six weeks',
  },
  {
    name: 'Create',
    desc: 'Senior art directors generate options at volume, then narrow to the strongest cuts.',
    meta: 'A hundred concepts down to ten',
  },
  {
    name: 'Perfect',
    desc: 'Studio retouching, copy editing and brand QA before anything leaves the building.',
    meta: 'Final human pass',
  },
  {
    name: 'Deploy',
    desc: 'Files delivered in client formats, ready for social, eCommerce, paid media and CRM.',
    meta: 'Channel-ready output',
  },
];

/* S8: what collapsing production costs unlock for brands. */
const unlocks = [
  'A hundred concepts to test instead of five',
  'Native relevance for every audience, culture and platform, not a global creative that lands nowhere specific',
  'Bold ideas tested without production risk',
  'No props, no talent fees, no crew on standby',
  'Data feedback that improves the next round of assets',
  'Multi-market transcreation that respects local nuance, not a translated headline on a Western image',
  'Output at scale and speed, without the brand becoming unrecognizable in the process',
];

/* S9: the three AIGC service lines. Service detail pages are not yet live, so
   each card links to the work index rather than a dead route. */
const services = [
  {
    name: 'AIGC Image',
    img: '/Images/work/camper-hero.webp',
    w: 1440,
    h: 1920,
    alt: 'A Camper footwear campaign visual adapted across markets by hubStudio.',
    lead: 'Hundreds of on-brand product shots, lifestyle visuals and campaign assets, delivered in days.',
    detail: 'Product photography, seasonal campaigns, market adaptations, social assets. Cuts production time by 80 percent.',
  },
  {
    name: 'AIGC Video',
    img: '/Images/work/hisense-hero.webp',
    w: 1800,
    h: 1350,
    alt: 'A HiSense brand video frame produced through the hubStudio AIGC pipeline.',
    lead: 'Premium brand storytelling without the constraints of traditional video production.',
    detail: 'Short-form social, brand films, campaign cutdowns, built for the feed they ship to.',
  },
  {
    name: 'AIGC Content',
    img: '/Images/work/age20-hero.webp',
    w: 1800,
    h: 2423,
    alt: 'An age20 beauty campaign asset created by the hubStudio content team.',
    lead: 'PR articles, campaign storyboards, video scripts, email copy, product naming, website pages.',
    detail: 'Brand voice held steady across every format. Days, not weeks.',
  },
];

/* S10: how clients engage. Three models, most use a combination. */
const engage = [
  {
    kicker: 'One-off',
    name: 'Creative AI Setup',
    desc: 'The studio defines the client’s visual language and trains custom AI models, including LoRA, on the brand. A one-time engagement that becomes the foundation for everything after.',
  },
  {
    kicker: 'Monthly retainer',
    name: 'Ongoing Content Production',
    desc: 'A predictable monthly flow of text, images and video. Scoped to the channel mix, paced to the editorial calendar, billed quarterly in advance for budget clarity.',
  },
  {
    kicker: 'Project-based',
    name: 'Studio Services',
    desc: 'Live photo and video shoots when AIGC alone is not the right call, product image cleanup so AI output starts from a stronger base, plus distribution across social, web and eCommerce.',
  },
];

/* S11: what clients are actually paying for. Authored 1.8px line icons:
   four-point spark, code brackets, node graph, curation funnel. */
const payoff = [
  {
    name: 'Creative expertise',
    desc: 'People who know what works for your audience, not just what looks impressive on a render.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 2.4 14.9 9.1 21.6 12 14.9 14.9 12 21.6 9.1 14.9 2.4 12 9.1 9.1Z"/></svg>',
  },
  {
    name: 'Prompt engineering',
    desc: 'Writing instructions so the model produces what the brand needs the first time, not the fortieth.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7.2 4.4 12 9 16.8"/><path d="M15 7.2 19.6 12 15 16.8"/></svg>',
  },
  {
    name: 'Custom model training',
    desc: 'Teaching generation models the brand’s specific style, a visual intelligence off-the-shelf tools cannot match.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M7.3 7.3 16.7 11M7.3 16.7 16.7 13"/></svg>',
  },
  {
    name: 'Intelligent curation',
    desc: 'Hundreds of options get generated. The ten that actually perform are the ones we ship.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.4 5h17.2l-6.6 7.7V20l-4 1.6v-8.9Z"/></svg>',
  },
];

const ipPoints = [
  'Every asset documented: which model was used, which references trained it, which prompts produced it.',
  'The custom models we train on your brand are your property, not ours. Full stop.',
  'For commercial work, we use models with clear licensing terms.',
  'An audit trail any legal team can verify. No client legal review has come back with a problem yet.',
];

const faqs = [
  {
    q: 'How long does a Creative AI Setup take?',
    a: 'Three to six weeks from brief to trained model, depending on the depth of the brand library.',
  },
  {
    q: 'What does monthly content production cost?',
    a: 'Honestly, it depends. Retainers start in the low four figures per month for smaller brands and scale up from there based on volume. We price around the actual asset mix you need, not a fixed package, because no two brands run the same channel mix. Happy to walk you through what your numbers would look like on a call.',
  },
  {
    q: 'Can you match the quality of a traditional photo shoot?',
    a: 'For most product, lifestyle and campaign work, yes, easily. Where it gets more interesting is high-end fashion editorial, or shoots that need a specific talent or location. There we usually recommend a hybrid approach: live capture combined with AIGC post-production. The two are not mutually exclusive.',
  },
  {
    q: 'Do you work with agencies on a white-label basis?',
    a: 'Yes. White-label production for agencies is one of the studio’s largest service lines.',
  },
  {
    q: 'Where is your team based?',
    a: 'The studio is based in China, with creatives drawn from both Western 4A agencies and the Chinese market. Clients are across Asia, Europe and the Americas.',
  },
];
---

<Layout
  title="AI Excellence | hubStudio AIGC Content Studio"
  description="AI-native content studio with senior creatives, prompt engineers and GPU power. On-brand assets at scale, in days, at a fraction of traditional production cost."
>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <!-- ===== S1: Hero ===== -->
  <section class="hero" id="top">
    <div class="hero__media">
      <img
        class="hero__bg"
        data-parallax
        data-parallax-speed="0.16"
        src="/Images/hubstudio-shanghai-studio.webp"
        alt="The hubStudio production floor in Shanghai, creatives at GPU workstations."
        width="1024"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="grain hero__grain" aria-hidden="true"></div>
    </div>

    <div class="container hero__inner">
      <p class="eyebrow hero__kicker">The Studio</p>
      <h1 class="hero__title">
        <span class="hero__w">AI</span>
        <span class="hero__w hero__w--accent">Excellence</span>
      </h1>
      <p class="hero__lede">
        Creative intelligence is the new moat
      </p>
      <p class="hero__intro">
        When every brand has the same AI tools, the work that wins is the work
        humans choose to ship. hubStudio is an AI-native content studio built
        for exactly that.
      </p>
      <ul class="hero__chips">
        {heroChips.map((c) => <li class="hero__chip">{c}</li>)}
      </ul>
      <div class="hero__meta">
        <span class="hero__meta-item">A studio first, an AI company second</span>
        <span class="hero__meta-item">
          Clients across Asia, Europe and the Americas
        </span>
      </div>
    </div>

    <a class="hero__cue" href="#one-studio" aria-label="Scroll to read more">
      <span class="hero__cue-label">Scroll</span>
      <span class="hero__cue-line" aria-hidden="true"></span>
    </a>

    <svg class="hero__cube" viewBox="0 0 32 35" aria-hidden="true">
      <path d="M16 4 28 11 16 18 4 11Z" fill="var(--brand-orange)" />
      <path d="M4 11 16 18 16 31 4 24Z" fill="#fff" opacity="0.85" />
      <path d="M28 11 16 18 16 31 28 24Z" fill="#fff" opacity="0.55" />
    </svg>
  </section>

  <!-- ===== S2: Stats (overlapping card) ===== -->
  <section class="stats">
    <div class="container">
      <div class="stats__card">
        {
          stats.map((s, i) => (
            <article class="stat" data-reveal style={`--i:${i}`}>
              <span class="stat__num">
                <span class="stat__count" data-count={s.value}>0</span>
                <span class="stat__suffix">{s.suffix}</span>
              </span>
              <span class="stat__label">{s.label}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== S3: We unite all as one studio ===== -->
  <section class="unite" id="one-studio">
    <div class="unite__media">
      <img
        class="unite__bg"
        data-parallax
        data-parallax-speed="0.12"
        src="/Images/who-we-are-office.webp"
        alt="The hubStudio team at workstations in a bright open-plan studio."
        width="1050"
        height="573"
        loading="lazy"
      />
      <div class="unite__scrim" aria-hidden="true"></div>
      <div class="grain unite__grain" aria-hidden="true"></div>
    </div>
    <div class="container unite__inner">
      <header class="unite__head">
        <p class="eyebrow unite__eyebrow" data-reveal>Human-led, AI-generated</p>
        <h2 class="unite__title" data-reveal>
          We unite all as <span class="accent">one studio</span>
        </h2>
        <p class="unite__intro" data-reveal>
          Senior creatives, AIGC engineers and a working studio, pulling in the
          same direction on every brief.
        </p>
      </header>
      <ul class="unite__pillars">
        {
          unitePillars.map((p, i) => (
            <li class="upillar" data-reveal style={`--i:${i}`}>
              <span class="upillar__bar" aria-hidden="true" />
              <h3 class="upillar__name">{p.name}</h3>
              <p class="upillar__desc">{p.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== S4: A human-led AI studio ===== -->
  <section class="section studio">
    <div class="container studio__grid">
      <div class="studio__copy">
        <p class="eyebrow accent-eyebrow" data-reveal>Positioning</p>
        <h2 class="headline h2 studio__head" data-reveal>
          A <span class="accent">human-led</span> AI studio, not another
          generic tool
        </h2>
        <p class="studio__p" data-reveal>
          Most traditional studios are too slow and too expensive for the
          volume brands actually need now. Walk into any marketing department
          in November and ask how the year's content backlog is going. You will
          get your answer.
        </p>
        <p class="studio__p" data-reveal>
          Generic AI platforms are fast and cheap. They also fall short on
          cultural nuance, brand voice and creative judgment. They hand a
          marketing team a tool, not an output the team can ship without a
          rework. And that rework is usually where the savings evaporate.
        </p>

        <div class="stance" data-reveal>
          {
            stance.map((s) => (
              <article class:list={['stance__card', s.lead && 'stance__card--lead']}>
                <span class="stance__kind">{s.kind}</span>
                <p class="stance__line">{s.line}</p>
              </article>
            ))
          }
        </div>
      </div>

      <figure class="studio__media" data-reveal>
        <div class="media-frame media-frame--tall">
          <img
            data-parallax
            data-parallax-speed="0.08"
            src="/Images/who-we-are-studio.jpg"
            alt="A photographer shooting a product on a lit set inside the hubStudio space."
            width="1360"
            height="768"
            loading="lazy"
          />
        </div>
        <span class="studio__badge">AI lifts. Senior creatives sign off.</span>
      </figure>
    </div>
  </section>

  <!-- ===== S5: East and West ===== -->
  <section class="section markets">
    <div class="container markets__grid">
      <figure class="markets__media" data-reveal>
        <div class="media-frame media-frame--tall">
          <img
            data-parallax
            data-parallax-speed="0.1"
            src="/Images/who-we-are-china-speed.jpg"
            alt="A Chinese production crew working across Western and Chinese platform formats."
            width="768"
            height="1360"
            loading="lazy"
          />
        </div>
      </figure>
      <div class="markets__copy">
        <p class="eyebrow accent-eyebrow" data-reveal>Two ecosystems</p>
        <h2 class="headline h2 markets__head" data-reveal>
          East and West, under <span class="accent">one roof</span>
        </h2>
        <p class="markets__lead" data-reveal>
          Most studios know one ecosystem. We work in both.
        </p>
        <p class="markets__p" data-reveal>
          Western platforms: Google, Meta and the global creative stack you
          would expect. Chinese platforms: Alibaba, ByteDance, Tencent and the
          local AIGC tooling that outside teams rarely navigate well, even when
          they think they do.
        </p>
        <p class="markets__p" data-reveal>
          Our creative bench mixes 4A agency veterans with Chinese designers and
          art directors. The studio is led by founder Cyril Drouin, former CEO
          of Publicis Commerce for China and North Asia, who spent two decades
          running digital and commerce operations across both markets before
          launching hubStudio in 2024.
        </p>
        <blockquote class="pull-quote pull-quote--inline" data-reveal>
          <p class="pull-quote__text">
            After twenty years going back and forth between Western and Chinese
            digital ecosystems, one thing is obvious. You cannot brief your way
            to cultural relevance. You have to hire it.
          </p>
          <footer class="pull-quote__by">Cyril Drouin, Founder, hubStudio</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ===== S6: Who we work with ===== -->
  <section class="section audiences">
    <div class="container">
      <header class="audiences__head">
        <p class="eyebrow accent-eyebrow" data-reveal>Who we work with</p>
        <h2 class="headline h2" data-reveal>
          Built for teams that ship at <span class="accent">scale</span>
        </h2>
      </header>
      <ul class="audiences__grid">
        {
          audiences.map((a, i) => (
            <li class="aud" data-reveal style={`--i:${i % 3}`}>
              <span class="aud__icon" set:html={audienceIcons[i]} />
              <h3 class="aud__name">{a.name}</h3>
              <p class="aud__desc">{a.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== S7: How the pipeline works ===== -->
  <section class="pipeline">
    <div class="container">
      <header class="pipeline__head">
        <p class="eyebrow pipeline__eyebrow" data-reveal>How the work moves</p>
        <h2 class="pipeline__title" data-reveal>
          How the <span class="accent">pipeline</span> works
        </h2>
        <p class="pipeline__intro" data-reveal>
          Five stages. Each one has a clear owner and a clear output.
        </p>
      </header>
      <ol class="flow">
        {
          pipeline.map((stage, i) => (
            <li class="stage" data-reveal style={`--i:${i % 3}`}>
              <span class="stage__mark" aria-hidden="true" />
              <div class="stage__body">
                <h3 class="stage__name">{stage.name}</h3>
                <p class="stage__desc">{stage.desc}</p>
              </div>
              <span class="stage__meta">{stage.meta}</span>
            </li>
          ))
        }
      </ol>
      <p class="pipeline__close" data-reveal>
        Brands working with us this way have moved internal approval rates from
        22% to 78% on AI-generated assets, and scaled output by roughly 7x.
      </p>
    </div>
  </section>

  <!-- ===== S8: Why AIGC changes the economics ===== -->
  <section class="section economics">
    <div class="container economics__inner">
      <div class="economics__lead-col">
        <p class="eyebrow accent-eyebrow" data-reveal>The new economics</p>
        <h2 class="headline h2 economics__head" data-reveal>
          Why AIGC changes the <span class="accent">economics</span> of content
        </h2>
        <p class="economics__p" data-reveal>
          Production costs are collapsing. Props, talent fees, location rentals,
          crew, post-production: the line items that defined the old model are
          shrinking or, in some cases, gone entirely. What replaces them is
          infrastructure, talent direction and creative judgment.
        </p>
        <p class="economics__p" data-reveal>
          Hyper-relevance is the new baseline. Content needs to fit every
          platform, every audience, every market. The old production models
          cannot keep up, and patching them with one AI tool here and a
          freelancer there will not fix the problem.
        </p>
      </div>
      <ul class="unlocks">
        {
          unlocks.map((u, i) => (
            <li class="unlock" data-reveal style={`--i:${i % 2}`}>
              <span class="unlock__mark" aria-hidden="true" />
              <span>{u}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== S9: Our AIGC services ===== -->
  <section class="section services">
    <div class="container">
      <header class="services__head">
        <p class="eyebrow accent-eyebrow" data-reveal>What we make</p>
        <h2 class="headline h2" data-reveal>
          Our AIGC <span class="accent">services</span>
        </h2>
      </header>
      <div class="services__grid">
        {
          services.map((svc, i) => (
            <article class="svc" data-reveal style={`--i:${i}`}>
              <div class="svc__media">
                <img
                  src={svc.img}
                  alt={svc.alt}
                  width={svc.w}
                  height={svc.h}
                  loading="lazy"
                />
              </div>
              <div class="svc__body">
                <h3 class="svc__name">{svc.name}</h3>
                <p class="svc__lead">{svc.lead}</p>
                <p class="svc__detail">{svc.detail}</p>
                <a class="svc__link" href="/work">
                  See it in the work
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M5 12h13M12 5l7 7-7 7"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== S10: How we engage ===== -->
  <section class="section engage">
    <div class="container">
      <header class="engage__head">
        <p class="eyebrow accent-eyebrow" data-reveal>How we engage</p>
