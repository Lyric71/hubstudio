    40% { opacity: 1; }
    100% { transform: translateY(48px); opacity: 0; }
  }
  .hero__cube {
    position: absolute;
    width: clamp(40px, 6vw, 78px);
    right: clamp(24px, 7vw, 120px);
    top: clamp(110px, 18vh, 210px);
