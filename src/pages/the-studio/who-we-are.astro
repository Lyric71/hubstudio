  .media-frame--wide {
    aspect-ratio: 16 / 9;
  }
  .media-frame--tall {
    aspect-ratio: 9 / 16;
  }
  .media-frame img {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    will-change: transform;
  }

  /* ============ S1 Hero ============ */
  .hero {
