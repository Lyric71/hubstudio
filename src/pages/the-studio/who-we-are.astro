    filter: drop-shadow(0 12px 24px rgba(8, 12, 28, 0.5));
    animation: cubeFloat 7s ease-in-out infinite;
  }
  @keyframes cubeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-18px) rotate(8deg); }
  }

  /* Hero load orchestration */
  .hero__kicker,
  .hero__w,
  .hero__lede,
  .hero__intro,
  .hero__chip,
  .hero__meta,
  .hero__cue {
    opacity: 0;
    animation: heroRise 0.95s cubic-bezier(0.2, 0.75, 0.2, 1) forwards;
  }
  .hero__kicker { animation-delay: 0.1s; }
  .hero__w:nth-child(1) { animation-delay: 0.22s; }
  .hero__w:nth-child(2) { animation-delay: 0.32s; }
  .hero__w:nth-child(3) { animation-delay: 0.42s; }
  .hero__lede { animation-delay: 0.52s; }
  .hero__intro { animation-delay: 0.62s; }
  .hero__chip:nth-child(1) { animation-delay: 0.7s; }
  .hero__chip:nth-child(2) { animation-delay: 0.76s; }
  .hero__chip:nth-child(3) { animation-delay: 0.82s; }
  .hero__chip:nth-child(4) { animation-delay: 0.88s; }
  .hero__chip:nth-child(5) { animation-delay: 0.94s; }
  .hero__meta { animation-delay: 1s; }
  .hero__cue { animation-delay: 1.3s; }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(34px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============ S2 Stats ============ */
  .stats {
    position: relative;
    z-index: 2;
    margin-top: -96px;
  }
  .stats__card {
    background: var(--bg-white);
