  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        104deg,
        rgba(8, 12, 28, 0.92) 0%,
        rgba(8, 12, 28, 0.74) 38%,
        rgba(8, 12, 28, 0.3) 72%,
