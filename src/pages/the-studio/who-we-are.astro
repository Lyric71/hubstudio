    border: 1px solid var(--line-hairline);
    overflow: hidden;
  }
  @media (min-width: 620px) {
    .stats__card {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 940px) {
    .stats__card {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
