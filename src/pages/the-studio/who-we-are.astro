---
/**
 * Who We Are (`/the-studio/who-we-are`).
 * Narrative content sourced from who-we-are-page.md (the "What hybrid means"
 * copy is a client-approved shortened rewrite). Team roles and the four-pillar
 * creed are client-supplied. No ordinal numerals in any card or repeated
 * block, per the permanent no-numbers-in-cards rule. Stat figures below are
 * data display (units attached), not ordinals.
 *
 * Layout: layered editorial. Image hero, overlapping stat card, asymmetric
 * splits, an animated shoot/build ratio, a roles grid, a language marquee, an
 * interactive client list, and an accordion creed. Motion: page-load stagger
 * in the hero, scroll-reveal everywhere else, parallax on section media,
 * count-up on stats, plus a scroll-progress bar.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const contentTypes = [
  'Images',
  'Short video',
  'Ecommerce packs',
  'Social',
  'Campaign adaptations',
];

const stats = [
  { value: 15, suffix: '', label: 'Years in content and performance' },
  { value: 6, suffix: '', label: 'Working languages on the team' },
  { value: 48, suffix: 'h', label: 'Turnaround' },
  { value: 2, suffix: '', label: 'Production hubs, in China and the Philippines' },
];

/* S6: studio roles. Descriptions written for hubStudio, one creative angle each. */
const roles = [
  { name: 'Creative Directors', desc: 'They set the territory and own the idea. Every project starts here.' },
  { name: 'Designers', desc: 'Layout, type and brand systems, built to hold up across markets.' },
  { name: 'Copywriters', desc: 'The brand voice on the page, in the language each market speaks.' },
  { name: 'Photographers', desc: 'Real shoots, real light, for the core brand material.' },
  { name: 'Videographers', desc: 'Camera crews for the moments that need a set and a director.' },
  { name: 'Video Production', desc: 'Edit, grade and finish, from first cut to delivery.' },
  { name: 'Motion Designers', desc: 'Animation and motion graphics, where a frame needs to move.' },
  { name: 'Retouchers', desc: 'The final human pass: dodge, burn, grain, every AI tell stripped out.' },
  { name: 'AI Production', desc: 'Specialists who run the generation pipelines at studio scale.' },
  { name: 'IT Engineers', desc: 'They train the models and keep our own GPU infrastructure running.' },
  { name: 'Producers', desc: 'They hold the brief, the timeline and the budget together.' },
  { name: 'Localization', desc: 'Adapting copy and culture so nothing is lost between markets.' },
];

const languages = ['English', 'French', 'Japanese', 'Spanish', 'German', 'Mandarin'];

/* S9: each item is one verbatim sentence from the source paragraph. */
const clientSignals = [
  "You're launching dozens of product variations across markets, and you need every visual to look like it belongs to the same brand.",
  "You're spending six weeks on campaigns while competitors ship in days.",
  "You're testing three creative concepts when you should be testing 30.",
  "You're flying crews to eight markets for assets that could have been adapted from one good shoot.",
  'Your marketing team is drowning in daily content requests from sales, regional offices and retail partners, with no scalable way to answer them.',
];

/* S11: the four-pillar creed, client supplied. Two source lines had a missing
   sentence break; a period is inserted where the sentence clearly ends. */
const pillars = [
  {
    name: 'Creative Excellence',
    note: 'The work is the point.',
    image: '/Images/value-creative-excellence.jpg',
    points: [
      'Demonstrating our creative ability through breakthrough campaigns that set industry standards',
      'Making bold, informed creative decisions based on deep brand understanding and cultural insight',
      'Valuing artistic vision and storytelling craft to build inspiring partnerships with visionary brands',
    ],
  },
  {
    name: 'Tech Mastery',
    note: 'Tech earns its place.',
    image: '/Images/value-tech-mastery.jpg',
    points: [
      'Continuously mastering the latest AIGC models and techniques to stay ahead of the innovation curve',
      "Engineering custom AI workflows that push the boundaries of what's possible in content creation",
      'Sharing technical knowledge within our team to enhance collective capabilities and client outcomes',
    ],
  },
  {
    name: 'People First, Always',
    note: 'People are the asset.',
    image: '/Images/value-people-first.jpg',
    points: [
      'We take care of our creative talent and tech specialists. Our people are our greatest asset',
      'Relationships are the foundation of everything we do with our team, clients, and creative community',
      'We are constructive collaborators, not destructive disruptors, giving respect to earn it',
    ],
  },
  {
    name: 'Relentless Ambition',
    note: 'Hand up, every role.',
    image: '/Images/value-relentless-ambition.jpg',
    points: [
      'We put our hand up at every level and in every role, taking ownership of our craft and client success',
      'We are ambitious in pursuing new creative territories and breakthrough technological capabilities',
      "We trust our instincts. If something doesn't feel right creatively or technically, we speak up",
    ],
  },
];

/* Authored line-icon set for the five client tensions: variation grid, clock,
   rising bars, globe, overloaded stack. Same 1.7px stroke system. */
const clientIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3.2" y="3.2" width="7.3" height="7.3" rx="1.7"/><rect x="13.5" y="3.2" width="7.3" height="7.3" rx="1.7"/><rect x="3.2" y="13.5" width="7.3" height="7.3" rx="1.7"/><rect x="13.5" y="13.5" width="7.3" height="7.3" rx="1.7"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 6.8V12l3.7 2.3"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5h17"/><path d="M6.6 20.5v-5.2"/><path d="M12 20.5V10.6"/><path d="M17.4 20.5V4.8"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.7 2.8 2.7 15.2 0 18M12 3c-2.7 2.8-2.7 15.2 0 18"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 21 8l-9 5.2L3 8z"/><path d="M3 12 12 17.2 21 12"/><path d="M3 16 12 21.2 21 16"/></svg>',
];

const SITE = 'https://www.hubstudio.ai';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'The Studio', item: `${SITE}/the-studio` },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Who We Are',
      item: `${SITE}/the-studio/who-we-are`,
    },
  ],
};
---

<Layout
  title="Who We Are | hubStudio AI Content Studio"
  description="Hybrid AI content studio with teams in China and the Philippines. Founded by ex-Publicis CEO Cyril Drouin. Speed, scale, and creative craft."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <!-- ===== S1: Hero ===== -->
  <section class="hero" id="top">
    <div class="hero__media">
      <img
        class="hero__bg"
        data-parallax
        data-parallax-speed="0.16"
        src="/Images/who-we-are-office.webp"
        alt="The hubStudio team at workstations in a bright open-plan studio office."
        width="1050"
        height="573"
        fetchpriority="high"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="grain hero__grain" aria-hidden="true"></div>
    </div>

    <div class="container hero__inner">
      <p class="eyebrow hero__kicker">The Studio</p>
      <h1 class="hero__title">
        <span class="hero__w">Who</span>
        <span class="hero__w hero__w--accent">We</span>
        <span class="hero__w">Are</span>
      </h1>
      <p class="hero__lede">
        A content studio built for how brands actually work today
      </p>
      <p class="hero__intro">
        hubStudio makes content for brands, agencies, retailers and
        manufacturers whose production setup can't keep up with what marketing
        teams need now.
      </p>
      <ul class="hero__chips">
        {contentTypes.map((c) => <li class="hero__chip">{c}</li>)}
      </ul>
      <div class="hero__meta">
        <span class="hero__meta-item">Teams in China and the Philippines</span>
        <span class="hero__meta-item">
          Clients across Europe, North America and Asia
        </span>
      </div>
    </div>

    <a class="hero__cue" href="#vision" aria-label="Scroll to read more">
      <span class="hero__cue-label">Scroll</span>
      <span class="hero__cue-line" aria-hidden="true"></span>
    </a>

    <svg class="hero__cube" viewBox="0 0 32 35" aria-hidden="true">
      <path d="M16 4 28 11 16 18 4 11Z" fill="var(--brand-orange)" />
      <path d="M4 11 16 18 16 31 4 24Z" fill="#fff" opacity="0.85" />
      <path d="M28 11 16 18 16 31 28 24Z" fill="#fff" opacity="0.55" />
    </svg>
  </section>

  <!-- ===== S2: Stats (overlapping card) ===== -->
  <section class="stats">
    <div class="container">
      <div class="stats__card">
        {
          stats.map((s, i) => (
            <article class="stat" data-reveal style={`--i:${i}`}>
              <span class="stat__num">
                <span class="stat__count" data-count={s.value}>0</span>
                <span class="stat__suffix">{s.suffix}</span>
              </span>
              <span class="stat__label">{s.label}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== S3: Our Vision ===== -->
  <section class="section vision" id="vision">
    <div class="container">
      <header class="vision__head">
        <p class="eyebrow accent-eyebrow" data-reveal>From the founder</p>
        <h2 class="headline h2" data-reveal>
          Our <span class="accent">Vision</span>
        </h2>
      </header>
      <div class="vision__spread">
        <div class="vision__prose">
          <p class="vision__lead" data-reveal>
            Traditional production is dying. Slowly, but it is dying. Too slow,
            too expensive, and honestly too complicated for the volume of
            assets brands need now.
          </p>
          <p class="vision__p" data-reveal>
            The answer isn't to let AI do everything either. Pure AI content
            has a ceiling, and most brands have already hit it.
          </p>
          <p class="vision__p" data-reveal>
            The future is hybrid. Real shoots for the core brand material, the
            moments that need a director, a model, a real product on a real
            set. AI for everything that comes after: variations, adaptations,
            localizations, the long tail of assets that used to eat budgets and
            timelines.
          </p>
          <p class="vision__pull" data-reveal>
            Not every shot needs a shoot. And not every brand story can be told
            by a prompt.
          </p>
          <p class="vision__p" data-reveal>
            After 15 years inside Publicis working with some of the biggest
            advertisers in the world, I've seen what production used to be, and
            where it has to go. Hybrid works for luxury too, even in mature
            Western markets where craft and consistency matter most. The trick
            is knowing which 20% of the work needs a real set, and which 80%
            can be reimagined.
          </p>
        </div>
        <aside class="vision__aside">
          <div class="founder-card" data-reveal>
            <img
              class="founder-card__photo"
              src="/Team/cyril-drouin.jpg"
              alt="Cyril Drouin, founder and CEO of hubStudio."
              width="500"
              height="758"
              loading="lazy"
            />
            <div class="founder-card__body">
              <span
                class="founder-card__sign"
                role="img"
                aria-label="Cyril Drouin's handwritten signature"
              ></span>
              <p class="founder-card__name">Cyril Drouin</p>
              <p class="founder-card__role">Founder and CEO</p>
              <div class="founder-card__social">
              <a
                class="social-link"
                href="https://www.linkedin.com/in/cyril-d-68835729/"
                target="_blank"
                rel="noopener"
                aria-label="Cyril Drouin on LinkedIn"
              >
                <svg class="social-link__logo" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.86-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.73v20.53C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.73C24 .78 23.2 0 22.22 0z"
                  />
                </svg>
                <span>LinkedIn</span>
              </a>
              <a
                class="social-link"
                href="https://cyrildrouin.substack.com/"
                target="_blank"
                rel="noopener"
                aria-label="Cyril Drouin on Substack"
              >
                <svg class="social-link__logo" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M22.54 8.24H1.46V5.4h21.08v2.84zM1.46 10.81V24L12 18.11 22.54 24V10.81H1.46zM22.54 0H1.46v2.84h21.08V0z"
                  />
                </svg>
                <span>Substack</span>
              </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===== S4: What hybrid actually means ===== -->
  <section class="section hybrid">
    <div class="container hybrid__grid">
      <div class="hybrid__copy">
        <p class="eyebrow accent-eyebrow" data-reveal>Hybrid production</p>
        <h2 class="headline h2 hybrid__head" data-reveal>
          What <span class="accent">hybrid</span> actually means
        </h2>
        <p class="hybrid__p" data-reveal>
          Take a footwear launch: twelve colorways, four markets. The old way
          is a full shoot per market, weeks of post, a budget the CFO dreads.
          The hybrid way is one strong shoot of the hero product, then AI for
          every color variant, market adaptation and e-commerce angle. Same
          quality, a fraction of the cost.
        </p>
        <p class="hybrid__p" data-reveal>
          The real work is knowing which 20% to shoot and which 80% to build
          from there. That's where 15 years in the business counts.
        </p>

        <div class="ratio" data-reveal>
          <div class="ratio__bar">
            <span class="ratio__fill ratio__fill--shoot" style="--w:20%"></span>
            <span class="ratio__fill ratio__fill--build" style="--w:80%"></span>
          </div>
          <div class="ratio__legend">
            <div class="ratio__key">
              <span class="ratio__pct">20%</span>
              <span class="ratio__tag">Shoot for real</span>
            </div>
            <div class="ratio__key ratio__key--build">
              <span class="ratio__pct">80%</span>
              <span class="ratio__tag">Build with AI</span>
            </div>
          </div>
        </div>
      </div>

      <figure class="hybrid__media" data-reveal>
        <div class="media-frame">
          <img
            data-parallax
            data-parallax-speed="0.07"
            src="/Images/who-we-are-hybrid.jpg"
            alt="A single cream leather sneaker on a warm plaster ledge under hard directional light."
            width="1024"
            height="1024"
            loading="lazy"
          />
        </div>
        <figcaption class="hybrid__cap">One hero shoot. Every variant after.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== S5: What we are ===== -->
  <section class="section make">
    <div class="container make__grid">
      <figure class="make__media" data-reveal>
        <div class="media-frame media-frame--wide">
          <img
            data-parallax
            data-parallax-speed="0.08"
            src="/Images/who-we-are-studio.jpg"
            alt="A Chinese photographer shooting a product on a lit set with a crew assisting in a real studio."
            width="1536"
            height="864"
            loading="lazy"
          />
        </div>
        <span class="make__badge">Real shoots, real light</span>
      </figure>
      <div class="make__copy">
        <p class="eyebrow accent-eyebrow" data-reveal>Inside hubStudio</p>
        <h2 class="headline h2 make__head" data-reveal>
          What we <span class="accent">are</span>
        </h2>
        <p class="make__lead" data-reveal>
          A creative studio first. A technology company second.
        </p>
        <p class="make__p" data-reveal>
          Our team is senior art directors, designers, photographers and video
          directors who came up at large international agencies, both foreign
          and Chinese. We have engineers who actually know how to train models
          and build production pipelines, not just prompt their way through a
          brief.
        </p>
        <p class="make__p" data-reveal>
          We run our own GPU infrastructure, in China and outside. And we keep
          a full studio for real shooting, because hybrid only works if you can
          do both halves well.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== S6: Our team ===== -->
  <section class="section team">
    <div class="container">
      <header class="team__head">
        <p class="eyebrow accent-eyebrow" data-reveal>Our team</p>
        <h2 class="headline h2" data-reveal>
          One studio, every <span class="accent">craft</span>
        </h2>
      </header>
      <figure class="team__photo" data-reveal>
        <div class="media-frame media-frame--wide">
          <img
            data-parallax
            data-parallax-speed="0.06"
            src="/Team/team-photo.webp"
            alt="Members of the hubStudio team talking over coffee in the studio break area."
            width="1050"
            height="586"
            loading="lazy"
          />
        </div>
      </figure>
      <ul class="team__roles">
        {
          roles.map((role, i) => (
            <li class="role" data-reveal style={`--i:${i % 3}`}>
              <span class="role__mark" aria-hidden="true" />
              <h3 class="role__name">{role.name}</h3>
              <p class="role__desc">{role.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== S7: China Speed ===== -->
  <section class="section speed">
    <div class="container speed__grid">
      <figure class="speed__media" data-reveal>
        <div class="media-frame media-frame--tall">
          <img
            data-parallax
            data-parallax-speed="0.1"
            src="/Images/who-we-are-china-speed.jpg"
            alt="A Chinese production crew shooting and editing e-commerce content in the studio."
            width="864"
            height="1536"
            loading="lazy"
          />
        </div>
        <span class="speed__badge">
          <span class="speed__badge-dot" aria-hidden="true"></span>
          Two shifts, around the clock
        </span>
      </figure>
      <div class="speed__copy">
        <p class="eyebrow speed__eyebrow" data-reveal>Production speed</p>
        <h2 class="headline h2 speed__head" data-reveal>
          China <span class="accent">Speed</span>
        </h2>
        <p class="speed__lead" data-reveal>
          Our main hub is in China, and it's not by accident. China is where
          the fastest production in the world happens. Not because corners get
          cut. Because the domestic competition is brutal. Brands here expect
          work back in 48 hours that would take three weeks in Paris or New
          York.
        </p>
        <p class="speed__p" data-reveal>
          A simple example. A retail client briefs us on a Friday afternoon for
          a Monday morning livestream. Fifteen lifestyle visuals, three product
          videos, full localization. Our China team runs two shifts through the
          weekend, and the work ships on time. Most studios outside of Asia
          would have asked for two weeks just to scope it.
        </p>
        <p class="speed__p" data-reveal>
          When a campaign has to ship for a market launch, a flash sale, or a
          competitive response, our China team can work around the clock. We've
          built that muscle. Most studios outside Asia haven't.
        </p>
        <p class="speed__p" data-reveal>
          Our Philippines hub adds English-first creative talent and strong
          post-production craft. Between the two hubs, clients get close to
          24-hour coverage on bigger projects.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== S8: We speak your language ===== -->
  <section class="section langs">
    <div class="container">
      <header class="langs__head">
        <p class="eyebrow accent-eyebrow" data-reveal>Languages</p>
        <h2 class="headline h2" data-reveal>
          We speak your <span class="accent">language</span>
        </h2>
      </header>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="marquee__row">
        {
          [...languages, ...languages, ...languages, ...languages].map((l) => (
            <span class="marquee__item">
              {l}
              <span class="marquee__dot" />
            </span>
          ))
        }
      </div>
    </div>
    <div class="container">
      <p class="langs__p" data-reveal>
        Literally. Our team works in English, French, Japanese, Spanish, German
        and Mandarin. That matters more than most people think. Briefs don't
        get lost in translation. Cultural references actually land. A French
        luxury house can brief us in French. A Japanese retailer can review
        copy in their own market's voice. Small things, but they add up over a
        year.
      </p>
    </div>
  </section>

  <!-- ===== S9: You're the right client for us if ===== -->
  <section class="signals-sec">
    <div class="signals-sec__glow" aria-hidden="true"></div>
    <div class="container">
      <header class="signals__head">
        <p class="eyebrow signals__eyebrow" data-reveal>Who we work with</p>
        <h2 class="signals__title" data-reveal>
          You're the <span class="accent">right</span><br />
          client for us if
        </h2>
      </header>
      <ul class="signals">
        {
          clientSignals.map((signal, i) => (
            <li class="signal" data-reveal style={`--i:${i}`}>
              <a class="signal__link" href="/contact">
                <span class="signal__icon" set:html={clientIcons[i]} />
                <span class="signal__text">{signal}</span>
                <span class="signal__go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path
                      d="M5 12h13M12 5l7 7-7 7"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="signals__close" data-reveal>
        Sound familiar? You're not alone. There is a better way, and we've
        built it.
      </p>
    </div>
  </section>

  <!-- ===== S10: What we value ===== -->
  <section class="value">
    <div class="container value__inner">
      <div class="value__lead-col">
        <p class="eyebrow value__eyebrow" data-reveal>How we work</p>
        <p class="value__lead" data-reveal>
          Creative first. The technology is the means, the work is the point.
        </p>
      </div>
      <p class="value__body" data-reveal>
        Tech has to earn its place: if a model helps the work, we use it, if it
        doesn't, we don't. We try to be good partners to our team and to our
        clients, which mostly means putting our hand up when something isn't
        right, creatively or technically.
      </p>
    </div>
  </section>

  <!-- ===== S11: The values we live by ===== -->
  <section class="creed">
    <div class="container creed__head">
      <p class="eyebrow accent-eyebrow" data-reveal>Our values</p>
      <h2 class="creed__title" data-reveal>
        The values we <span class="accent">live</span> by
      </h2>
    </div>
    {
      pillars.map((pillar, i) => (
        <div class:list={['pillar', i % 2 === 0 ? 'pillar--dark' : 'pillar--flip']}>
          <div class="container pillar__inner">
            <div class="pillar__lead" data-reveal>
              <img
                class="pillar__visual"
                src={pillar.image}
                alt={`Abstract visual for ${pillar.name}`}
                width="512"
                height="512"
                loading="lazy"
              />
              <span class="pillar__note">{pillar.note}</span>
            </div>
            <div class="pillar__body">
              <h3 class="pillar__name" data-reveal>{pillar.name}</h3>
              <ul class="pillar__points">
                {pillar.points.map((point, j) => (
                  <li class="pillar__point" data-reveal style={`--i:${j}`}>
                    <span class="pillar__pt-mark" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <!-- ===== S12: Closing CTA ===== -->
  <section class="closing">
    <div class="closing__glow" aria-hidden="true"></div>
    <div class="container closing__inner">
      <p class="eyebrow closing__eyebrow" data-reveal>Let's talk</p>
      <h2 class="headline h2 closing__head" data-reveal>
        Want to see what this looks like for your <span class="accent">brand</span>?
      </h2>
      <p class="closing__p" data-reveal>
        The fastest way is a 30-minute call. Bring a brief, or just a category
        you want to test. We'll come back with sample work tailored to it.
      </p>
      <p class="closing__p closing__p--mute" data-reveal>
        Not ready to talk yet? Browse our use cases to see how we've worked
        with brands in fashion, beauty, retail and consumer electronics.
      </p>
      <div class="closing__cta" data-reveal>
        <Button variant="primary" href="/contact">Contact us</Button>
        <Button variant="on-dark" href="/work">See use cases</Button>
      </div>
      <svg class="closing__cube" viewBox="0 0 32 35" aria-hidden="true">
        <path d="M16 4 28 11 16 18 4 11Z" fill="var(--brand-orange)" />
        <path d="M4 11 16 18 16 31 4 24Z" fill="var(--brand-navy)" />
        <path d="M28 11 16 18 16 31 28 24Z" fill="var(--brand-navy-deep)" />
      </svg>
    </div>
  </section>
</Layout>

<style>
  /* ============ Shared ============ */
  .scroll-progress {
