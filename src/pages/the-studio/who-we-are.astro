    overflow: hidden;
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 14px;
    background: var(--brand-orange);
    animation: cueDrop 1.9s ease-in-out infinite;
  }
  @keyframes cueDrop {
