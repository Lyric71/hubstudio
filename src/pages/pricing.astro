  }
  .chapter__dark-blob--a {
    width: 600px;
    height: 600px;
    top: -120px;
    left: -120px;
    background: radial-gradient(circle, rgba(30, 58, 138, 0.65), transparent 70%);
    animation: float-a 24s ease-in-out infinite;
