        <div class="social-tabs" role="tablist" aria-label="Select a social network">
          {socialNetworks.map((net, idx) => (
            <button
              type="button"
              role="tab"
              id={`tab-${net.id}`}
              class="social-tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${net.id}`}
              data-social-tab={net.id}
            >
              {net.label}
            </button>
          ))}
        </div>
      </header>

      {socialNetworks.map((net, idx) => (
        <div
          id={`panel-${net.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${net.id}`}
          class="social-panel"
          data-social-panel={net.id}
          hidden={idx !== 0}
        >
          <div class="social-panel__intro">
            <div>
              <span class="social-panel__badge">{net.badge}</span>
              <h3 class="social-panel__title">
                {net.headlinePre}<span class="accent">{net.headlineAccent}</span>{net.headlinePost}
              </h3>
              <p class="social-panel__lead">{net.lead}</p>
            </div>
            <p class="social-panel__meta">{net.contractNote}</p>
          </div>

          <div class="social-tiers">
            {net.tiers.map((tier) => {
              const tierUsd = parseUsdPriceString(tier.price);
              return (
                <article class={`social-tier ${tier.popular ? 'social-tier--popular' : ''}`}>
                  <div class="social-tier__top">
                    <span class="social-tier__name">{tier.name}</span>
                    {tier.popular && <span class="social-tier__Ribbon">Most popular</span>}
                  </div>
                  <div class="social-tier__price-row">
                    <span
                      class="social-tier__price"
                      data-no-i18n
                      data-usd={tierUsd !== null ? String(tierUsd) : undefined}
                      data-usd-format="amount"
                    >
                      {localizePriceText(tier.price, pageLocale)}
                    </span>
                    <span class="social-tier__period">{tier.period}</span>
                  </div>
                  <p class="social-tier__desc">{tier.desc}</p>
                  <div class="social-tier__cta">
                    <Button
                      variant={tier.popular ? 'primary' : 'secondary'}
                      href={`${BRIEF_URL}?way=studio-app#brief`}
                    >
                      Send a brief
                    </Button>
                  </div>
                </article>
              );
            })}
          </div>

          <div class="social-table-wrap">
            <table class="social-table">
              <thead>
                <tr>
                  <th scope="col" class="social-table__th social-table__th--feature">Deliverables &amp; services</th>
                  {net.tiers.map((t) => {
                    const tierUsd = parseUsdPriceString(t.price);
                    return (
                      <th scope="col" class={`social-table__th ${t.popular ? 'social-table__th--popular' : ''}`}>
                        <span class="social-table__tier-name">{t.name}</span>
                        <span
                          class="social-table__tier-price"
                          data-usd={tierUsd !== null ? String(tierUsd) : undefined}
                          data-usd-format="monthly"
                        >
                          {t.price}{t.period}
                        </span>
                      </th>
                    );
                  })}
                </tr>
              </thead>
              <tbody>
                {net.rows.map((row) => (
                  <>
                    {row.category && (
                      <tr class="social-table__cat-row">
                        <td colspan="4" class="social-table__cat">{row.category}</td>
                      </tr>
                    )}
                    <tr class="social-table__row">
                      <th scope="row" class="social-table__feature">{row.label}</th>
                      {row.values.map((val, cIdx) => (
                        <td class={`social-table__cell ${net.tiers[cIdx].popular ? 'social-table__cell--popular' : ''}`}>
                          {val === true ? (
                            <span class="social-check" aria-label="Included">✓</span>
                          ) : val === false ? (
                            <span class="social-dash" aria-label="Not included">No</span>
                          ) : (
                            <span class="social-val">{val}</span>
                          )}
                        </td>
                      ))}
                    </tr>
                  </>
                ))}
              </tbody>
            </table>
          </div>

          <div class="social-extras">
            <article class="social-extra-card">
              <div class="social-extra-card__head">
                <span class="pillar__badge">Optional add-ons</span>
                <h4 class="social-extra-card__title">{net.addonTitle}</h4>
                <p class="social-extra-card__sub">{net.addonSub}</p>
              </div>
              <ul class="social-addon-list">
                {net.addons.map((addon) => {
                  const addonUsd = parseUsdPriceString(addon.price);
                  return (
                    <li class="social-addon-item">
                      <div class="social-addon-item__main">
                        <span class="social-addon-item__name">{addon.name}</span>
                        {addon.note && <span class="social-addon-item__note">{addon.note}</span>}
                      </div>
                      <div class="social-addon-item__price">
                        <strong
                          data-no-i18n={addonUsd !== null ? '' : undefined}
                          data-usd={addonUsd !== null ? String(addonUsd) : undefined}
                          data-usd-format={addonUsd !== null ? 'amount' : undefined}
                        >
                          {addonUsd !== null ? localizePriceText(addon.price, pageLocale) : addon.price}
                        </strong>
                        {addon.unit && <span> {addon.unit}</span>}
                      </div>
                    </li>
                  );
                })}
              </ul>
            </article>

            <article class="social-extra-card social-extra-card--ads">
              <div class="social-extra-card__head">
                <span class="pillar__badge pillar__badge--free">Paid media</span>
                <h4 class="social-extra-card__title">{net.adsTitle}</h4>
                <p class="social-extra-card__sub" data-usd="1500" data-usd-format="inline-replace">{net.adsSub}</p>
              </div>
              <ul class="social-addon-list">
                {net.adsTiers.map((ad) => {
                  const adValUsd = parseUsdPriceString(ad.value);
                  const adLabelUsd = parseUsdPriceString(ad.label);
                  return (
                    <li class="social-addon-item">
                      <div class="social-addon-item__main">
                        <span
                          class="social-addon-item__name"
                          data-usd={adLabelUsd !== null ? String(adLabelUsd) : undefined}
                          data-usd-format={adLabelUsd !== null ? 'inline-replace' : undefined}
                        >
                          {ad.label}
                        </span>
                        <span class="social-addon-item__note">{ad.note}</span>
                      </div>
                      <div class="social-addon-item__price">
                        <strong
                          data-usd={adValUsd !== null ? String(adValUsd) : undefined}
                          data-usd-format={adValUsd !== null ? 'monthly' : undefined}
                        >
                          {ad.value}
                        </strong>
                      </div>
                    </li>
                  );
                })}
              </ul>
              <div class="social-extra-card__foot">
                <p>Need a multi-network bundle across Western and Chinese platforms? Send a brief and we’ll build a combined scope.</p>
                <a class="arrow-link" href={`${BRIEF_URL}?way=studio-app#brief`}>
                  Request a custom bundle <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          </div>
        </div>
      ))}
