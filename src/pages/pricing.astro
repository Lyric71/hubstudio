---
/**
 * Pricing (`/pricing`).
 * Editorial treatment: hero, stat strip, three chapter spreads, two
 * pull-quote interludes, comparison matrix, filtered FAQ, dark closing.
 * Scroll-linked motion, magnetic CTAs, drawing-on-scroll timeline.
 *
 * SEO excerpt (25 words): hubStudio offers three pricing models: pay per
 * asset, scope a fixed project, or keep a creative studio on monthly
 * retainer. No mystery fees, no lock-in.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const models = ['Asset-Based', 'Project-Based', 'Subscription'];

const assetVolume = [
  { k: 'Image production', d: 'Briefed, finalized, ready to ship.' },
  { k: 'Short video', d: 'Vertical, fast, made for the feed.' },
  { k: 'Product copy & transcreation', d: 'Written natively, market by market.' },
  { k: 'Social captions', d: 'Tone-of-voice locked across channels.' },
];

const assetProject = [
  'Brand identity', 'Website design', 'Packaging & merch', 'Motion design',
  'Illustration', 'Storyboard', 'Presentation & pitch decks',
  'Ebooks & reports', 'Press releases', 'Concept creation',
  'Creative & marketing strategy', 'Long-form video',
  'Live photo & video shoots', '3D & CGI',
];

const projectTimeline = [
  {
    label: 'Brief',
    note: 'In your words. A page is enough.',
    icon: 'M4 4h12v16H4z M7 9h6 M7 13h6 M7 17h4',
  },
  {
    label: 'Proposal',
    note: '48-hour binding response.',
    icon: 'M4 12l4 4 12-12',
  },
  {
    label: 'Production',
    note: 'Creative director, art director, AIGC engineer, copywriter, producer.',
    icon: 'M4 12a8 8 0 1 0 8-8 M12 8v4l3 2',
  },
  {
    label: 'First review',
    note: 'Inside two weeks of kickoff.',
    icon: 'M3 12s3-6 9-6 9 6 9 6-3 6-9 6-9-6-9-6z M12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z',
  },
  {
    label: 'Delivery',
    note: 'Full delivery inside four weeks maximum.',
    icon: 'M5 13l4 4L19 7',
  },
];

const projectIncluded = [
  'Creative direction and concept development',
  'Production across image, video, text, motion, design, and live shoots',
  'AI model fine-tuning when the brand calls for it, Lora stays your property',
  'Post-production, rounds of modification, final asset packaging',
  'Project management with a single point of contact',
];

const projectUseCases = [
  'Product launches and seasonal campaigns',
  'eCommerce content packs across SKUs and platforms',
  'Pitch work for new business',
  'Brand identity refreshes paired with full asset libraries',
  'Multi-market campaign adaptations',
];

const retainerIncluded = [
  { k: 'Dedicated team', d: 'Creative director, art director, AIGC engineer.' },
  { k: 'Monthly volume', d: 'Agreed upfront, rolls over inside the quarter.' },
  { k: 'Across 20 services', d: 'Mix-and-match every format your brand needs.' },
  { k: 'Brand guardrails', d: 'Prompt library, consistency sets, brand-trained models.' },
  { k: 'Weekly cadence', d: 'Published SLA we share with your team.' },
  { k: 'Live shoot days', d: 'Bundled inside the retainer when the brief calls for it.' },
];

const retainerTerms = [
  { months: '3 months', sub: 'Pilot a workflow.' },
  { months: '6 months', sub: 'Lock in a season.' },
  { months: '12 months', sub: 'Build a content engine.' },
];

const currencies = ['USD', 'EUR', 'GBP', 'HKD', 'CNY'];

const matrixRows = [
  {
    feature: 'Best for',
    a: 'Volume work, scaling up or down each month',
    p: 'Defined campaigns with a clear scope and deadline',
    s: 'Continuous content across markets and channels',
  },
  {
    feature: 'Commitment',
    a: 'Per order, no lock-in',
    p: 'Per brief, milestone-based',
    s: '3, 6, or 12-month terms',
  },
  {
    feature: 'First delivery',
    a: 'In days, on most volume work',
    p: 'First review in two weeks',
    s: 'Weekly cadence, priority queue',
  },
  {
    feature: 'Rounds of modification',
    a: 'Three on finalized work',
    p: 'Three on finalized work',
    s: 'More, on retainer',
  },
  {
    feature: 'Lora training',
    a: 'Add-on when it fits',
    p: 'Included when the brand calls for it',
    s: 'Included, with prompt library',
  },
  {
    feature: 'Asset ownership',
    a: 'Yours on payment',
    p: 'Yours on payment',
    s: 'Yours on payment',
  },
  {
    feature: 'Surge capacity',
    a: 'Larger order with priority',
    p: 'Re-scope mid-flight',
    s: 'Double volume, no renegotiation',
  },
  {
    feature: 'Single point of contact',
    a: 'Producer on the order',
    p: 'Project lead, kickoff to delivery',
    s: 'Dedicated team, embedded',
  },
];

type FaqCategory = 'Engagement' | 'Ownership' | 'Pricing' | 'Delivery' | 'Production';

const faqs: { c: FaqCategory; q: string; a: string }[] = [
  { c: 'Engagement', q: 'Can we start small and grow into a subscription?', a: 'Yes, and most clients do exactly that. They place an Asset-Based order or run one Project first, then move to a Studio Retainer once the volume earns it. Moving over is simple. The brand assets, the prompts, and the models we trained for you all come with you.' },
  { c: 'Engagement', q: 'Do you sign annual contracts?', a: 'Only when it works in your favor. Asset and Project work has no lock-in at all. Studio Retainers run on three, six, or twelve-month terms, and the longer ones bring the rate per asset down.' },
  { c: 'Ownership', q: 'Who owns the assets and the prompts?', a: 'You do. The finished assets and the prompts behind them become yours the moment the invoice is paid. The one exception is the AI models and Loras trained on your products: those stay with hubStudio by default, though you can license them outright if you want them, quoted case by case.' },
  { c: 'Ownership', q: 'What about confidentiality and IP protection?', a: 'We sign an NDA on request, before a single brief changes hands. Anything we build for you is trained only on your shots, your references, and your guidelines. None of it feeds a public model, and none of it gets reused for another client.' },
  { c: 'Pricing', q: 'Why are there no prices on this page?', a: 'Because an honest number depends on the brief. A launch across five markets and a single batch of social images are not the same job, and a fixed rate card would overcharge the small order while underquoting the big one. Send the brief and the figure you get back reflects the actual work, with nothing padded and nothing buried.' },
  { c: 'Pricing', q: 'How is pricing set?', a: 'Your quote reflects scope, complexity, volume, and the deadline you are working to. We send a binding proposal within 48 hours of getting your brief. Asset, Project, and Subscription rates are all laid out plainly once we know what you need.' },
  { c: 'Pricing', q: 'How do we budget for this internally?', a: 'Send the brief early, even a rough version. Because the proposal is binding and comes back within 48 hours, you can take a real number into a budget conversation rather than a guess. If the scope changes later, we revise the proposal before anything gets signed.' },
  { c: 'Pricing', q: 'What does the MOQ actually mean? Can I order one image?', a: 'MOQs exist because the briefing, the onboarding, and the quality checks cost the same whether you order ten assets or one. Below the minimum, the math stops working for both sides. If your need really is a one-off, we can fold it into a Project quote or point you to a freelancer who suits it better.' },
  { c: 'Delivery', q: 'How fast can you deliver?', a: 'Three days is the floor on most volume work, and it is the rule rather than the exception. Projects hit their first review within two weeks of kickoff and wrap inside four weeks at the outside. Retainer clients get a weekly delivery rhythm and skip the queue.' },
  { c: 'Delivery', q: 'What if the first delivery is not right?', a: 'Every asset includes rounds of modification (three on finalized work, more on retainer). If we miss the brief, we redo the work, no extra charge. The brief alignment call happens before any production starts, which is why this rarely happens.' },
  { c: 'Production', q: 'Do you cover languages and markets outside English?', a: 'Yes. We work in English, French, German, Spanish, and Chinese. Operations run from China and the Philippines, with creative talent producing for clients across multiple markets. Transcreation is handled by people who write natively in the target language, not translated into it.' },
  { c: 'Production', q: 'Do you actually shoot, or only generate?', a: 'Both. We run a live-action studio for real photo and video shoots, the kind brands selling worldwide rely on. Plenty of briefs are better generated, or built as a hybrid of the two. We will tell you which makes sense before you commit. Where AI generation fits, the savings are real, and we pass them through to you.' },
  { c: 'Production', q: 'What inputs do you need from us to get started?', a: 'For images: a creative brief, your brand visual identity, product shots if applicable. For video: the above plus a finalized script (or we write one). For copy: tone-of-voice guide and product information. For shoots: brief, brand guidelines, product, talent direction if any. We have a one-page brief template that does the heavy lifting.' },
  { c: 'Production', q: 'Can you integrate with our DAM, PIM, or eCommerce platform?', a: 'Yes, on the hub4You Private Platform. We build connectors to Salsify, Akeneo, Bynder, Adobe Commerce, Shopify Plus, Salesforce Commerce Cloud, and most enterprise systems. Integration scope is part of the setup quote.' },
  { c: 'Pricing', q: 'What payment terms do you offer?', a: 'Asset orders take a deposit upfront, with the balance due on delivery. Project billing follows the milestones as they land. Retainers are invoiced monthly, in advance. Established clients and listed companies can ask us for Net 30.' },
  { c: 'Pricing', q: 'Which currencies do you bill in?', a: 'USD by default. We also invoice in EUR, GBP, HKD, and CNY on request. Cross-border invoicing runs through Beyond Border Group Limited in Hong Kong.' },
  { c: 'Ownership', q: 'Do you take usage rights into account?', a: 'Every quote assumes unlimited commercial use across your owned and paid channels. A few things sit outside that: broadcast TV, out-of-home at scale, and talent-likeness licensing for AI brand ambassadors get quoted separately. Tell us where the work will run, and we will be upfront about any uplift.' },
  { c: 'Engagement', q: 'What happens to my retainer volume if we do not use it?', a: 'Unused volume rolls into the next month, as long as it stays inside the same quarter. Anything past that resets. We would rather flag a slow month early and rebalance the plan than watch your budget quietly go to waste.' },
  { c: 'Delivery', q: 'Can you scale up for a peak season or product launch?', a: 'Yes. Retainer clients have a published surge clause that lets them double volume for one to two months without renegotiating the contract. Asset clients can simply place a bigger order with priority handling for a small uplift.' },
  { c: 'Engagement', q: 'What is the first step?', a: 'Send a brief, or just a rough idea, to hello@hubstudio.ai. You will hear back inside 24 hours. We come back with a proposal, three to five sample visuals at no charge, and whatever questions the brief raised for us, so you can judge the work before committing to it.' },
];

const faqCategories: ('All' | FaqCategory)[] = ['All', 'Engagement', 'Pricing', 'Delivery', 'Production', 'Ownership'];
---

<Layout
  title="hubStudio Pricing: Asset, Project, or Retainer"
  description="Three ways to work with hubStudio: pay per asset, scope a project, or keep a creative studio on retainer. No mystery fees and no lock-in."
>
  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="hero__tag">Pricing</span>
        <h1 class="hero__display reveal">
          Three ways to work with us. One <em>studio</em>.
        </h1>
        <p class="hero__lead">
          Some brands need a steady drip of content. Others need everything at
          once for a launch. Pick the model that matches how your team really
          works, not how a studio would prefer to bill you. No forced plans,
          and no contract that takes a lawyer to read.
        </p>

        <div class="hero__picker" role="tablist" aria-label="Pricing models">
          {
            models.map((m) => (
              <a
                class="hero__picker-item"
                role="tab"
                href={`#${m === 'Subscription' ? 'subscription' : m === 'Asset-Based' ? 'asset-based' : 'project-based'}`}
                data-model={m}
              >
                <span class="hero__picker-dot" aria-hidden="true"></span>
                {m}
              </a>
            ))
          }
        </div>

        <div class="hero__cta">
          <Button variant="primary" href="/contact" class="js-magnetic">Start a project</Button>
          <Button variant="secondary" href="#matrix" class="js-magnetic">Compare the three</Button>
        </div>
      </div>

      <figure class="hero__visual">
        <img
          src="/Images/pricing-hero.webp"
          alt="A hand poised with a fountain pen over the signature line of a typeset proposal on cream cardstock"
          class="js-parallax"
          data-speed="0.05"
          width="2000"
          height="1125"
          fetchpriority="high"
        />
        <span class="hero__visual-chip">48-hour binding proposal</span>
      </figure>
    </div>
  </section>

  <!-- ============================================================
       STAT STRIP
       ============================================================ -->
  <section class="stats" id="manifesto">
    <div class="container">
      <div class="stats__grid">
        <div class="stat-block">
          <span class="stat-block__num" data-count="20">0</span>
          <span class="stat-block__label">Service lines under one roof</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__num"><span data-count="48">0</span>h</span>
          <span class="stat-block__label">Binding proposal from brief</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__num">&lt;<span data-count="4">0</span>w</span>
          <span class="stat-block__label">Project delivery, maximum</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__num"><span data-count="16">0</span></span>
          <span class="stat-block__label">Markets we produce in</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CHAPTER: ASSET-BASED
       ============================================================ -->
  <section class="chapter chapter--light" id="asset-based">
    <div class="container chapter__grid">
      <header class="chapter__head">
        <span class="chapter__tag">Asset-Based</span>
        <h2 class="chapter__display reveal">
          Pay for what <em>you ship</em>.
        </h2>
        <p class="chapter__lead">
          You send the brief. We produce the work. Twenty service lines, the
          formats your brand reaches for, turned around in a few days instead
          of a few weeks. Some of it we generate, some we shoot, and plenty of
          briefs land somewhere in between. We will tell you which is right
          before you spend anything.
        </p>
      </header>

      <figure class="chapter__photo chapter__photo--asset js-tilt" data-tilt="6">
        <img src="/Images/pricing-asset.webp" alt="A concrete worktable covered with finished printed brand materials laid out in a loose grid" loading="lazy" width="1184" height="880" />
        <span class="chapter__photo-chip">Volume + per-project · One studio</span>
      </figure>

      <div class="chapter__body">
        <div class="pillar-row">
          <article class="pillar js-spotlight">
            <p class="pillar__head"><span></span>Volume formats, MOQs apply</p>
            <ul class="pillar__list">
              {assetVolume.map((it) => (
                <li>
                  <span class="pillar__list-k">{it.k}</span>
                  <span class="pillar__list-d">{it.d}</span>
                </li>
              ))}
            </ul>
            <p class="pillar__note">
              Every asset arrives finished and ready to use, with rounds of
              modification built in. Ask for the full MOQ list and we will send
              it over.
            </p>
          </article>

          <article class="pillar js-spotlight">
            <p class="pillar__head"><span></span>Quoted per project, no MOQ</p>
            <ul class="chip-cluster">
              {assetProject.map((it) => <li class="chip-cluster__chip">{it}</li>)}
            </ul>
            <p class="pillar__note">
              Pre- and post-production are quoted as add-ons on any format:
              scripting, voice-over, editing, subtitles, sound design,
              retouching, and talent direction.
            </p>
          </article>
        </div>

        <div class="chapter__cta">
          <Button variant="primary" href="/contact" class="js-magnetic">Get a quote on an asset order</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       INTERLUDE: pricing principle
       ============================================================ -->
  <section class="interlude">
    <div class="container">
      <blockquote class="interlude__quote">
        <p>
          We quote the job in front of us. Not a number picked to look tidy on a
          web page, and not a plan you have to grow into.
        </p>
        <cite class="interlude__cite">hubStudio, on how we price</cite>
      </blockquote>
    </div>
  </section>

  <!-- ============================================================
       CHAPTER: PROJECT-BASED
       ============================================================ -->
  <section class="chapter chapter--cream" id="project-based">
    <div class="container chapter__grid chapter__grid--reverse">
      <header class="chapter__head">
        <span class="chapter__tag">Project-Based</span>
        <h2 class="chapter__display reveal">
          Built for your next <em>launch</em>.
        </h2>
        <p class="chapter__lead">
          We assemble the team around your brief: a creative director, an art
          director, an AIGC engineer, a copywriter, a producer. You deal with
          one quote and one schedule, and the invoice comes once. Our live-action
          crew has shot for brands including Mazda, Nescafe, and Marriott.
        </p>
      </header>

      <figure class="chapter__photo chapter__photo--project js-tilt" data-tilt="-5">
        <img src="/Images/pricing-project.webp" alt="A small creative team gathered around a long studio worktable reviewing a printed campaign rollout" loading="lazy" width="1184" height="880" />
        <span class="chapter__photo-chip chapter__photo-chip--right">One team · One invoice</span>
      </figure>

      <div class="chapter__body">
        <div class="timeline" data-timeline>
          <svg class="timeline__path" viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M40 40 C 220 0, 320 80, 500 40 S 780 0, 960 40" />
          </svg>
          <ol class="timeline__list">
            {projectTimeline.map((t) => (
              <li class="timeline__step">
                <span class="timeline__node">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={t.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="timeline__label">{t.label}</span>
                <span class="timeline__note">{t.note}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="pair-row">
          <article class="pair-card pair-card--white">
            <p class="pair-card__head"><span></span>Included by default</p>
            <ul class="pair-card__list">
              {projectIncluded.map((it) => <li>{it}</li>)}
            </ul>
          </article>
          <article class="pair-card pair-card--white">
            <p class="pair-card__head"><span></span>Typical use cases</p>
            <ul class="pair-card__list">
              {projectUseCases.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        </div>

        <div class="chapter__cta">
          <Button variant="primary" href="/contact" class="js-magnetic">Brief us on a project</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       INTERLUDE: ownership
       ============================================================ -->
  <section class="interlude interlude--alt">
    <div class="container">
      <blockquote class="interlude__quote">
        <p>
          You own the brief, the finished files, and the prompts behind them the
          day the invoice clears.
        </p>
        <cite class="interlude__cite">hubStudio, on what you keep</cite>
      </blockquote>
    </div>
  </section>

  <!-- ============================================================
       CHAPTER: SUBSCRIPTION (dark immersive)
       ============================================================ -->
  <section class="chapter chapter--dark" id="subscription">
    <div class="chapter__dark-bg" aria-hidden="true">
      <div class="chapter__dark-blob chapter__dark-blob--a"></div>
      <div class="chapter__dark-blob chapter__dark-blob--b"></div>
    </div>

    <div class="container subscription__inner">
      <header class="chapter__head chapter__head--center">
        <span class="chapter__tag chapter__tag--on-dark">Subscription</span>
        <h2 class="chapter__display chapter__display--center reveal">
          Your studio <em>on retainer</em>.
        </h2>
        <p class="chapter__lead chapter__lead--on-dark">
          A fixed monthly cost, and a team that gets faster the longer it works
          with you, because it stops relearning your brand on every job. It
          runs like an in-house studio you never had to hire for. Mix and match
          across all twenty service lines, on a weekly schedule we put in
          writing.
        </p>
      </header>

      <div class="retainer">
        <div class="retainer__grid">
          {retainerIncluded.map((it) => (
            <article class="retainer__cell">
              <p class="retainer__cell-k">{it.k}</p>
              <p class="retainer__cell-d">{it.d}</p>
            </article>
          ))}
        </div>

        <div class="retainer__terms">
          <p class="retainer__terms-head">Terms that fit how you scale</p>
          <div class="retainer__terms-row">
            {retainerTerms.map((t) => (
              <button class="retainer__term" data-term type="button">
                <span class="retainer__term-mo">{t.months}</span>
                <span class="retainer__term-sub">{t.sub}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="retainer__currencies">
          <span class="retainer__currencies-label">Billed in</span>
          <div class="retainer__currencies-row">
            {currencies.map((c) => <span class="retainer__currency">{c}</span>)}
          </div>
        </div>

        <div class="chapter__cta chapter__cta--center">
          <Button variant="primary" href="/contact" class="js-magnetic">Scope a retainer</Button>
        </div>
      </div>
    </div>

    <figure class="subscription__photo" aria-hidden="true">
      <img src="/Images/pricing-subscription.webp" alt="" loading="lazy" width="1184" height="880" />
    </figure>
  </section>

  <!-- ============================================================
       S7 : COMPARISON MATRIX
       ============================================================ -->
  <section class="matrix" id="matrix">
    <div class="container">
      <header class="matrix__head">
        <span class="chapter__tag">At a glance</span>
        <h2 class="chapter__display reveal">
          Three models, <em>side by side</em>.
        </h2>
        <p class="section-note">
          Still weighing them up? This is the quickest way to see where the
          three differ before you talk to us.
        </p>
      </header>

      <div class="matrix__wrap">
        <table class="matrix__table">
          <thead>
            <tr>
              <th scope="col" class="matrix__th matrix__th--feature">&nbsp;</th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--orange">Asset-Based</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--navy">Project-Based</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--ink">Subscription</span></th>
            </tr>
          </thead>
          <tbody>
            {matrixRows.map((row) => (
              <tr class="matrix__row">
                <th scope="row" class="matrix__feature">{row.feature}</th>
                <td>{row.a}</td>
                <td>{row.p}</td>
                <td>{row.s}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S8 : FAQ (filtered)
       ============================================================ -->
  <section class="faq" id="faq">
    <div class="container">
      <header class="faq__head">
        <span class="chapter__tag">Frequently asked</span>
        <h2 class="chapter__display reveal">
          The questions buyers <em>always</em> ask.
        </h2>
        <p class="section-note">
          Filter by what you need to know. If your question is not here, email
          hello@hubstudio.ai and we will answer it directly.
        </p>
      </header>

      <div class="faq__filter" role="tablist" aria-label="FAQ categories">
        {faqCategories.map((cat, i) => (
          <button
            class="faq__filter-btn"
            type="button"
            role="tab"
            data-filter={cat}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="faq__list">
        {faqs.map((item) => (
          <details class="faq__item" data-category={item.c}>
            <summary class="faq__q">
              <span class="faq__cat">{item.c}</span>
              <span class="faq__q-text">{item.q}</span>
              <svg class="faq__chev" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       S9 : CLOSING (dark, immersive, animated cube)
       ============================================================ -->
  <section class="cta">
    <div class="cta__bg" aria-hidden="true">
      <div class="cta__blob cta__blob--a"></div>
      <div class="cta__blob cta__blob--b"></div>
      <div class="cta__grain"></div>
    </div>

    <div class="container cta__inner">
