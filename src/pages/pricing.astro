    color: var(--text-mute);
    max-width: 60ch;
    margin: 0;
  }
  .section-note a {
    color: var(--brand-orange);
    font-weight: 600;
  }
  .matrix__wrap {
    overflow-x: auto;
    border-radius: 28px;
    border: 1px solid var(--line-hairline);
    background: var(--bg-cream);
    box-shadow: 0 30px 80px rgba(10, 10, 20, 0.06);
  }
  .matrix__table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--type-body);
  }
  .matrix__th,
  .matrix__feature,
  .matrix__table td {
    padding: 22px 24px;
    text-align: left;
    vertical-align: top;
  }
  .matrix__th {
    background: #fff;
