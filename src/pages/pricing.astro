---

<Layout
  title="hubStudio pricing: the app and the studio"
  description="How you pay for hubStudio: a prepaid balance for the app, with the price shown before every run, and studio work quoted from your brief."
  preloadImage="/Images/pricing-hero.webp"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="hero__tag">Pricing</span>
        <h1 class="hero__display reveal">
          How you pay for the app and the <span class="accent">studio</span>.
        </h1>
        <p class="hero__lead">
          In the app, every run shows its price before you start it, and you
          pay from a prepaid balance. Studio work gets a written quote once
          we’ve read your brief. You won’t find a rate card on this page.
          Engine prices change with the settings you pick, and studio work
          changes with the brief.
        </p>

        <nav class="hero__picker" aria-label="On this page">
          {
            jumps.map((j) => (
              <a class="hero__picker-item" href={j.href}>
                <span class="hero__picker-dot" aria-hidden="true" />
                {j.label}
              </a>
            ))
          }
        </nav>

        <div class="hero__cta">
          <Button variant="primary" href={APP_SIGNUP} class="js-magnetic">Create your account</Button>
          <Button variant="secondary" href={BRIEF_URL} class="js-magnetic">Send a brief</Button>
        </div>
      </div>

      <figure class="hero__visual">
        <img
          src="/Images/pricing-hero.webp"
          alt="A hand poised with a fountain pen over the signature line of a typeset proposal on cream cardstock"
          class="js-parallax"
          data-speed="0.05"
          width="2000"
          height="1125"
          fetchpriority="high"
        />
        <span class="hero__visual-chip">Price shown before every run</span>
      </figure>
    </div>
  </section>

  <!-- ============================================================
       FACT STRIP (word-stats, no counters)
       ============================================================ -->
  <section class="stats" aria-label="The short version">
    <div class="container">
      <div class="stats__grid">
        <div class="stat-block">
          <span class="stat-block__word">Nothing</span>
          <span class="stat-block__label">Creating an account costs nothing</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__word">Upfront</span>
          <span class="stat-block__label">Every run shows its price before it starts</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__word">Never</span>
          <span class="stat-block__label">A failed run is never charged</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__num">48h</span>
          <span class="stat-block__label">To a written studio proposal</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       THE APP: prepaid balance
       ============================================================ -->
  <section class="chapter chapter--light" id="app">
    <div class="container chapter__grid chapter__grid--app">
      <header class="chapter__head">
        <span class="chapter__tag">The app</span>
        <h2 class="chapter__display chapter__display--app reveal">
          Free software. No seat fees. Pay only for what you <span class="accent">consume</span>.
        </h2>
        <p class="chapter__lead chapter__lead--app">
          Invite your whole team and use the built-in tools for free, even if
          you never consume any AI or storage. You only top up a prepaid
          balance for what you run or store, with the price shown upfront.
        </p>
        <ul class="app-highlights" aria-label="Included by default">
          <li>No subscription or seat fee</li>
          <li>Free tools with zero balance</li>
          <li>Balance never expires</li>
        </ul>
      </header>

      <figure class="app-shot js-tilt" data-tilt="3">
        <div class="app-shot__bar">
          <div class="app-shot__url" aria-hidden="true">
            <span class="app-shot__dot"></span>
            <span>hubstudio.bearingbridge.com<b>/billing</b></span>
          </div>
          <span class="app-shot__chip">Pay as you go</span>
        </div>
        <img
          src="/Images/help/credits-and-payments-buy.webp"
          alt="The billing page in hubStudio showing the shared team balance, personal balance, and top-up options by card, Alipay, or WeChat Pay"
          loading="lazy"
          width="1441"
          height="901"
        />
      </figure>

      <div class="chapter__body" data-meter-board data-balance-state="active" data-meter-view="all">
        <!-- Interactive Control Bar & Live Balance Simulator -->
        <div class="meter-toolbar reveal" data-meter-toolbar>
          <div class="meter-toolbar__left">
            <span class="meter-toolbar__label">View</span>
            <div class="meter-seg" role="tablist" aria-label="Filter app features by billing model">
              <span class="meter-seg__glider" data-meter-glider aria-hidden="true"></span>
              <button
                type="button"
                role="tab"
                class="meter-seg__btn is-active"
                aria-selected="true"
                data-meter-filter="all"
              >
                All features
              </button>
              <button
                type="button"
                role="tab"
                class="meter-seg__btn"
                aria-selected="false"
                data-meter-filter="free"
              >
                <span class="meter-seg__dot meter-seg__dot--free" aria-hidden="true"></span>
                Free with zero balance
              </button>
              <button
                type="button"
                role="tab"
                class="meter-seg__btn"
                aria-selected="false"
                data-meter-filter="paid"
              >
                <span class="meter-seg__dot meter-seg__dot--paid" aria-hidden="true"></span>
                Pay per use
              </button>
            </div>
          </div>

          <div class="meter-sim">
            <span class="meter-sim__eyebrow">Simulate balance</span>
            <button
              type="button"
              class="meter-sim__toggle"
              role="switch"
              aria-checked="false"
              data-balance-toggle
            >
              <span class="meter-sim__opt meter-sim__opt--active">Topped up</span>
              <span class="meter-sim__opt meter-sim__opt--zero">Zero balance</span>
              <span class="meter-sim__thumb" aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="zero-sim-banner" data-zero-notice hidden>
          <span class="zero-sim-banner__dot" aria-hidden="true"></span>
          <span data-sim-status-text>
            At zero balance, new paid runs pause automatically while all your History, files, and free tools stay open.
          </span>
        </div>

        <!-- Two-Zone Architectural Split: Metered vs Free -->
        <div class="pillar-row" data-pillar-stage>
          <!-- ZONE: WHAT COSTS NOTHING (FREE WITH ZERO BALANCE) -->
          <article class="pillar pillar--free" data-pillar-zone="free">
            <div class="pillar__glow" aria-hidden="true"></div>
            <div class="pillar__top">
              <div class="pillar__head-row">
                <h3 class="pillar__head"><span aria-hidden="true"></span>What costs nothing</h3>
                <span class="pillar__badge pillar__badge--free">Free with zero balance</span>
              </div>
              <p class="pillar__sub">Every workspace seat, browser studio editor, approval thread, and social scheduler stays unlocked forever.</p>
            </div>

            <!-- Interactive In-Browser Studio Sandbox inside Free Deck -->
            <div class="free-sandbox" data-free-sandbox>
              <div class="free-sandbox__bar">
                <div class="free-sandbox__tabs" role="tablist" aria-label="Interactive zero-balance tools preview">
                  <button type="button" class="free-sandbox__tab is-active" data-sandbox-tab="crop">Safe-zone studio</button>
                  <button type="button" class="free-sandbox__tab" data-sandbox-tab="exif">EXIF scrubber</button>
                  <button type="button" class="free-sandbox__tab" data-sandbox-tab="seats">Team roles</button>
                </div>
                <span class="free-sandbox__pill">
                  <span class="free-sandbox__pulse" aria-hidden="true"></span>
                  Runs at zero balance
                </span>
              </div>

              <!-- Mini Panel: Crop & Safe-zone -->
              <div class="free-sandbox__stage" data-sandbox-panel="crop">
                <div class="sandbox-crop">
                  <div class="sandbox-crop__viewport" aria-hidden="true">
                    <div class="sandbox-crop__frame" data-crop-frame="4:5">
                      <span class="sandbox-crop__ratio" data-crop-ratio-box>4:5</span>
                    </div>
                  </div>
                  <div class="sandbox-crop__controls">
                    <div class="sandbox-crop__meta">
                      <span class="sandbox-crop__hint">Test live format framing</span>
                      <span class="sandbox-crop__active-label" data-crop-label>4:5 Portrait</span>
                    </div>
                    <div class="sandbox-crop__btns">
                      <button type="button" class="sandbox-ratio-btn is-active" data-ratio="4:5" data-label="4:5 Portrait">Feed 4:5</button>
                      <button type="button" class="sandbox-ratio-btn" data-ratio="9:16" data-label="9:16 Vertical">Reel 9:16</button>
                      <button type="button" class="sandbox-ratio-btn" data-ratio="1:1" data-label="1:1 Square">Square 1:1</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Mini Panel: EXIF Scrubber -->
              <div class="free-sandbox__stage" data-sandbox-panel="exif" hidden>
                <div class="sandbox-exif" data-exif-box>
                  <div class="sandbox-exif__tags">
                    <span class="sandbox-exif__tag" data-exif-tag>GPS Coordinates</span>
                    <span class="sandbox-exif__tag" data-exif-tag>Camera Serial</span>
                    <span class="sandbox-exif__tag" data-exif-tag>Software Prompt</span>
                  </div>
                  <button type="button" class="sandbox-exif__btn" data-exif-scrub>
                    <span data-exif-btn-label>Scrub metadata in browser</span>
                  </button>
                </div>
              </div>

              <!-- Mini Panel: Unlimited Seats -->
              <div class="free-sandbox__stage" data-sandbox-panel="seats" hidden>
                <div class="sandbox-roles">
                  <div class="sandbox-role">
                    <span class="sandbox-role__name">Admin</span>
                    <span class="sandbox-role__tag">Full control · Free seat</span>
                  </div>
                  <div class="sandbox-role">
                    <span class="sandbox-role__name">Creator</span>
                    <span class="sandbox-role__tag">Daily cap · Free seat</span>
                  </div>
                  <div class="sandbox-role">
                    <span class="sandbox-role__name">Viewer &amp; Client</span>
                    <span class="sandbox-role__tag">Spends nothing · Free login</span>
                  </div>
                </div>
              </div>
            </div>

            <ul class="pillar__list pillar__list--free">
              {free.map((it) => (
                <li class="feature-card feature-card--free js-spotlight" data-shot-trigger={it.shotKey}>
                  <div class="feature-card__icon-wrap feature-card__icon-wrap--free" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d={it.icon} />
                    </svg>
                  </div>
                  <div class="feature-card__body">
                    <div class="feature-card__head-row">
                      <span class="feature-card__eyebrow feature-card__eyebrow--free">{it.tag}</span>
                      <span class="feature-card__state feature-card__state--free">{it.badge}</span>
                    </div>
                    <span class="pillar__list-k">{it.k}</span>
                    <div class="feature-card__foot">
                      <div class="feature-card__chips">
                        {it.chips.slice(0, 2).map((chip) => (
                          <span class="feature-chip feature-chip--free">{chip}</span>
                        ))}
                      </div>
                      <button type="button" class="feature-card__preview-btn" data-preview-target={it.shotKey}>
                        Preview UI
                        <span aria-hidden="true">&rarr;</span>
                      </button>
                    </div>
                  </div>
                </li>
              ))}
            </ul>

            <div class="pillar__foot-box pillar__foot-box--free">
              <div class="pillar__foot-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 8v4l2.5 2.5" />
                </svg>
              </div>
              <p class="pillar__note">
                Only scheduled or automatic publishing to X carries a charge, with
                the price shown before you send. Manual publishing to X costs nothing.
              </p>
            </div>
          </article>

          <!-- ZONE: WHAT COSTS MONEY (PAY PER USE) -->
