  }
  .stat-block__word {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(40px, 4vw, 56px);
    line-height: 1;
    color: var(--brand-orange);
  }
  .stat-block__label {
    font-size: var(--type-small);
    line-height: 1.45;
    color: var(--text-mute);
    max-width: 24ch;
  }

  /* ----------------------------------------------------------------
     Chapters (shared)
     ---------------------------------------------------------------- */
  .chapter {
    position: relative;
    padding-block: clamp(72px, 9vw, 128px);
  }
  .chapter--light { background: var(--bg-white); }

  .chapter__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: rgba(233, 78, 27, 0.12);
    color: var(--brand-orange);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    width: fit-content;
  }
  .chapter__tag--on-dark {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-on-dark);
  }

  .chapter__display {
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.04;
    font-size: clamp(34px, 4.2vw, 56px);
    margin: 0;
    max-width: 20ch;
  }
  .chapter__display--on-dark { color: var(--text-on-dark); }

  .chapter__lead {
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 54ch;
    margin-top: 28px;
  }
  .chapter__lead--on-dark {
    color: rgba(240, 237, 233, 0.78);
  }
  .chapter__head {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .chapter__head .chapter__tag {
    margin-bottom: 24px;
  }
  .chapter__cta {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  /* Head + photo on row 1, body full width on row 2. */
  .chapter__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .chapter__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      grid-template-areas:
        'head photo'
        'body body';
      column-gap: 56px;
      row-gap: 64px;
      align-items: center;
    }
    .chapter__grid > .chapter__head { grid-area: head; }
    .chapter__grid > .chapter__photo,
    .chapter__grid > .app-shot { grid-area: photo; }
    .chapter__grid > .chapter__body { grid-area: body; }

    .chapter__grid--app {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: 48px;
      row-gap: 56px;
    }

    .chapter__grid--reverse {
      grid-template-areas:
        'photo head'
        'body body';
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }
  .chapter__display--app {
    font-size: clamp(32px, 3.5vw, 48px);
