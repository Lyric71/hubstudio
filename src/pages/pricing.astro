    letter-spacing: 0.1em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ----------------------------------------------------------------
     Fact strip
     ---------------------------------------------------------------- */
  .stats {
    padding-block: 56px;
    background: var(--bg-cream);
    border-top: 1px solid var(--line-hairline);
  }
  @media (min-width: 1024px) {
