  /* ----------------------------------------------------------------
     FAQ
     ---------------------------------------------------------------- */
  .faq {
    padding-block: clamp(72px, 9vw, 120px);
    background: var(--bg-cream);
  }
  .faq__head {
    display: grid;
    gap: 18px;
    margin-bottom: 40px;
  }
  .faq__head .chapter__tag { justify-self: start; }
  .faq__updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
