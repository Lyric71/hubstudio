    -webkit-backdrop-filter: blur(8px);
  }
  .chapter__photo-chip--right {
    left: auto;
    right: 20px;
  }

  /* ----------------------------------------------------------------
     App: interactive control bar, zero-balance vs pay-per-use decks,
     live UI sandboxes, app screen inspector, and team bento grid
     ---------------------------------------------------------------- */
  .meter-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 20px;
    padding: 12px 18px;
    margin-bottom: 20px;
    border-radius: 22px;
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    box-shadow: 0 12px 32px -12px rgba(14, 22, 51, 0.08);
  }
  @media (min-width: 900px) {
    .meter-toolbar {
      flex-wrap: nowrap;
    }
  }
  .meter-toolbar__left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .meter-toolbar__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-left: 4px;
    white-space: nowrap;
  }
  .meter-seg {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    isolation: isolate;
  }
  .meter-seg__glider {
    position: absolute;
    top: 4px;
    left: 4px;
    height: calc(100% - 8px);
    border-radius: var(--radius-pill);
    background: var(--text-ink);
    box-shadow: 0 4px 14px rgba(10, 10, 20, 0.18);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), width 280ms cubic-bezier(0.22, 1, 0.36, 1), background-color 240ms;
    z-index: -1;
    pointer-events: none;
  }
  .meter-seg__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    color: var(--text-ink);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 200ms;
    white-space: nowrap;
  }
  .meter-seg__btn.is-active {
    color: #fff;
  }
  .meter-seg__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .meter-seg__dot--free {
    background: #1fa58a;
  }
  .meter-seg__dot--paid {
    background: var(--brand-orange);
  }

  .meter-sim {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
    flex-shrink: 0;
  }
  .meter-sim__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    white-space: nowrap;
  }
  .meter-sim__toggle {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    isolation: isolate;
    box-shadow: inset 0 1px 2px rgba(10, 10, 20, 0.05);
  }
  .meter-sim__opt {
    position: relative;
    z-index: 1;
    padding: 7px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    transition: color 220ms;
    white-space: nowrap;
  }
  .meter-sim__opt--active { color: #fff; }
  .meter-sim__opt--zero { color: var(--text-mute); }
  .meter-sim__thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    border-radius: var(--radius-pill);
    background: var(--brand-orange);
    box-shadow: 0 4px 12px rgba(233, 78, 27, 0.3);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), background-color 240ms, box-shadow 240ms;
    z-index: 0;
  }
  .meter-sim__toggle[aria-checked='true'] .meter-sim__thumb {
    transform: translateX(100%);
    background: #1fa58a;
    box-shadow: 0 4px 12px rgba(31, 165, 138, 0.32);
  }
  .meter-sim__toggle[aria-checked='true'] .meter-sim__opt--active { color: var(--text-mute); }
  .meter-sim__toggle[aria-checked='true'] .meter-sim__opt--zero { color: #fff; }

  .zero-sim-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    margin-bottom: 20px;
    border-radius: 16px;
    background: rgba(31, 165, 138, 0.1);
    border: 1px solid rgba(31, 165, 138, 0.3);
    color: #0e6350;
    font-size: 13.5px;
    font-weight: 500;
  }
  .zero-sim-banner[hidden] {
    display: none;
  }
  .zero-sim-banner__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1fa58a;
    flex: none;
    box-shadow: 0 0 0 4px rgba(31, 165, 138, 0.2);
  }

  /* Two-Zone Split Deck */
  .pillar-row {
    display: grid;
    gap: 28px;
    align-items: stretch;
    transition: grid-template-columns 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 960px) {
    .pillar-row {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    [data-meter-view='free'] .pillar-row,
    [data-meter-view='paid'] .pillar-row {
      grid-template-columns: 1fr;
    }
  }
  [data-meter-view='free'] [data-pillar-zone='paid'],
  [data-meter-view='paid'] [data-pillar-zone='free'] {
    display: none;
  }

  .pillar {
    position: relative;
    padding: clamp(24px, 2.8vw, 34px);
    border-radius: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    overflow: hidden;
    isolation: isolate;
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 360ms, border-color 360ms, opacity 320ms;
  }
  .pillar--free {
    background: linear-gradient(165deg, #ffffff 0%, #f5f9f8 52%, #eef4f8 100%);
    border: 1px solid rgba(30, 58, 138, 0.16);
    box-shadow:
      0 2px 6px rgba(14, 22, 51, 0.04),
      0 28px 64px -24px rgba(14, 22, 51, 0.12);
  }
  .pillar--paid {
    background: linear-gradient(165deg, #101835 0%, #0b1126 58%, #171528 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-on-dark);
    box-shadow:
      0 2px 8px rgba(10, 10, 20, 0.16),
      0 32px 72px -20px rgba(14, 22, 51, 0.36);
  }

  [data-balance-state='zero'] .pillar--free {
    border-color: #1fa58a;
    box-shadow:
      0 0 0 2px rgba(31, 165, 138, 0.2),
      0 32px 72px -18px rgba(31, 165, 138, 0.22);
  }
  [data-balance-state='zero'] .pillar--paid {
    border-color: rgba(255, 255, 255, 0.18);
  }

  .pillar__glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    top: -160px;
    right: -140px;
    background: radial-gradient(circle, rgba(31, 165, 138, 0.14), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .pillar__glow--paid {
    background: radial-gradient(circle, rgba(233, 78, 27, 0.28), transparent 70%);
  }

  .pillar__top {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .pillar__head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pillar__head {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-ink);
    margin: 0;
  }
  .pillar--paid .pillar__head {
    color: #ffffff;
  }
  .pillar__head span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand-orange);
    box-shadow: 0 0 0 4px rgba(233, 78, 27, 0.22);
    flex: none;
  }
  .pillar--free .pillar__head span {
    background: #1fa58a;
    box-shadow: 0 0 0 4px rgba(31, 165, 138, 0.18);
  }
  .pillar__sub {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-mute);
  }
  @media (min-width: 960px) {
    .pillar__sub {
      min-height: 42px;
    }
  }
  .pillar--paid .pillar__sub {
    color: rgba(240, 237, 233, 0.72);
  }

  .pillar__badge {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: rgba(233, 78, 27, 0.16);
    border: 1px solid rgba(233, 78, 27, 0.34);
    color: #ff7e55;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .chapter--social .pillar__badge,
  .app-inspector .pillar__badge {
    background: rgba(233, 78, 27, 0.12);
    border-color: rgba(233, 78, 27, 0.22);
    color: var(--brand-orange);
  }
  .pillar__badge--free {
    background: rgba(31, 165, 138, 0.12) !important;
    border: 1px solid rgba(31, 165, 138, 0.28) !important;
    color: #117862 !important;
  }

  /* Interactive Free Sandbox & Paid Run Widget (Matched Height on Desktop) */
  .free-sandbox,
  .run-widget {
    border-radius: 20px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }
  @media (min-width: 960px) {
    .free-sandbox,
    .run-widget {
      min-height: 144px;
    }
  }
  .free-sandbox {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(30, 58, 138, 0.12);
    box-shadow: 0 8px 24px -12px rgba(14, 22, 51, 0.08);
  }
  .free-sandbox__bar,
  .run-widget__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .free-sandbox__tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 3px;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--bg-cream);
  }
  .free-sandbox__tab {
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    transition: background-color 180ms, color 180ms;
    white-space: nowrap;
  }
  .free-sandbox__tab.is-active {
    background: var(--bg-white);
    color: var(--text-ink);
    box-shadow: 0 2px 6px rgba(10, 10, 20, 0.08);
  }
  .free-sandbox__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #117862;
    font-weight: 600;
    white-space: nowrap;
  }
  .free-sandbox__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1fa58a;
    box-shadow: 0 0 0 0 rgba(31, 165, 138, 0.6);
    animation: pulse-ring 2s infinite;
  }
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(31, 165, 138, 0.55); }
    70% { box-shadow: 0 0 0 7px rgba(31, 165, 138, 0); }
    100% { box-shadow: 0 0 0 0 rgba(31, 165, 138, 0); }
  }

  .sandbox-crop {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 2px 0;
  }
  .sandbox-crop__viewport {
    width: 76px;
    height: 66px;
    border-radius: 12px;
    background: var(--bg-cream);
    border: 1px solid rgba(14, 22, 51, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .sandbox-crop__frame {
    position: relative;
    border-radius: 8px;
    background: linear-gradient(135deg, #1e3a8a, #1fa58a);
    border: 1.5px dashed rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: width 240ms cubic-bezier(0.22, 1, 0.36, 1), height 240ms cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    flex: none;
  }
  .sandbox-crop__frame[data-crop-frame='4:5'] { width: 46px; height: 54px; }
  .sandbox-crop__frame[data-crop-frame='9:16'] { width: 36px; height: 56px; }
  .sandbox-crop__frame[data-crop-frame='1:1'] { width: 50px; height: 50px; }
  .sandbox-crop__ratio {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
  }
  .sandbox-crop__controls {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 8px;
  }
  .sandbox-crop__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .sandbox-crop__hint {
    font-size: 12px;
    color: var(--text-mute);
    font-weight: 500;
  }
  .sandbox-crop__active-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--brand-navy);
    text-transform: uppercase;
  }
  .sandbox-crop__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sandbox-ratio-btn {
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--bg-white);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-ink);
    cursor: pointer;
    transition: all 180ms;
  }
  .sandbox-ratio-btn.is-active {
    background: var(--brand-navy);
    border-color: var(--brand-navy);
    color: #fff;
  }

  .sandbox-exif {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    padding: 6px 2px;
  }
  .sandbox-exif__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sandbox-exif__tag {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(233, 78, 27, 0.1);
    color: var(--brand-orange-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    transition: all 240ms;
  }
  .sandbox-exif.is-scrubbed .sandbox-exif__tag {
    background: rgba(31, 165, 138, 0.12);
    color: #117862;
    text-decoration: line-through;
    opacity: 0.72;
  }
  .sandbox-exif__btn {
    padding: 6px 13px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--brand-navy);
    background: var(--brand-navy);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: transform 180ms, background-color 180ms;
  }
  .sandbox-exif.is-scrubbed .sandbox-exif__btn {
    background: #1fa58a;
    border-color: #1fa58a;
  }

  .sandbox-roles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .sandbox-role {
    padding: 8px 10px;
    border-radius: 12px;
    background: var(--bg-cream);
    display: grid;
    gap: 2px;
  }
  .sandbox-role__name {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-ink);
  }
  .sandbox-role__tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: #117862;
  }

  /* Interactive Upfront Run Widget inside Paid Deck */
  .run-widget {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
  }
  .run-widget__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ff9d7d;
    white-space: nowrap;
  }
  .run-widget__modes {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 3px;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.28);
  }
  .run-widget__mode {
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    color: rgba(240, 237, 233, 0.72);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 180ms;
    white-space: nowrap;
  }
  .run-widget__mode.is-active {
    background: var(--brand-orange);
    color: #fff;
  }
  .run-widget__console {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }
  @media (min-width: 560px) {
    .run-widget__console {
      flex-wrap: nowrap;
    }
  }
  .run-widget__meta {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .run-widget__engine {
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .run-widget__hint {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #ff9d7d;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .run-widget__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(233, 78, 27, 0.6);
    background: linear-gradient(135deg, var(--brand-orange), var(--brand-orange-deep));
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(233, 78, 27, 0.32);
    transition: transform 180ms, box-shadow 180ms, opacity 180ms;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .run-widget__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(233, 78, 27, 0.45);
  }
  .run-widget__cta-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
  }
  [data-balance-state='zero'] .run-widget__cta {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: none;
    color: rgba(240, 237, 233, 0.75);
  }

  /* Tactile Feature Cards inside Both Decks */
  .pillar__list {
    display: grid;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feature-card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    padding: 16px 18px;
    border-radius: 20px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 260ms, border-color 260ms;
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 960px) {
    .feature-card {
      min-height: 118px;
    }
  }
  .feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(31, 165, 138, 0.1), transparent 60%);
    opacity: 0;
    transition: opacity 240ms;
    pointer-events: none;
    z-index: -1;
  }
  .feature-card--paid::before {
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(233, 78, 27, 0.18), transparent 60%);
  }
  .feature-card:hover::before {
    opacity: 1;
  }
  .feature-card:hover {
    transform: translateY(-3px);
  }

  .feature-card--free {
    background: #ffffff;
    border: 1px solid rgba(14, 22, 51, 0.1);
    box-shadow: 0 4px 18px -6px rgba(14, 22, 51, 0.06);
  }
  .feature-card--free:hover {
    border-color: rgba(31, 165, 138, 0.45);
    box-shadow: 0 14px 32px -10px rgba(31, 165, 138, 0.16);
  }

  .feature-card--paid {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.11);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.28);
  }
  .feature-card--paid:hover {
    border-color: rgba(233, 78, 27, 0.55);
    background: rgba(255, 255, 255, 0.08);
  }

  .feature-card__icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    transition: transform 240ms;
  }
  .feature-card:hover .feature-card__icon-wrap {
    transform: scale(1.06) rotate(-3deg);
  }
  .feature-card__icon-wrap svg {
    width: 21px;
    height: 21px;
  }
  .feature-card__icon-wrap--free {
    background: linear-gradient(135deg, rgba(31, 165, 138, 0.14), rgba(30, 58, 138, 0.1));
    border: 1px solid rgba(31, 165, 138, 0.25);
    color: #117862;
  }
  .feature-card__icon-wrap--paid {
    background: linear-gradient(135deg, rgba(233, 78, 27, 0.24), rgba(233, 78, 27, 0.08));
    border: 1px solid rgba(233, 78, 27, 0.35);
    color: #ff855e;
  }

  .feature-card__body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .feature-card__head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: nowrap;
  }
  .feature-card__eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feature-card__eyebrow--free { color: var(--brand-navy); }
  .feature-card__eyebrow--paid { color: #ff9470; }

  .feature-card__state {
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .feature-card__state--free {
    background: rgba(31, 165, 138, 0.12);
    color: #117862;
  }
  .feature-card__state--paid {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(240, 237, 233, 0.85);
  }
  [data-balance-state='zero'] .feature-card__state--paid {
    background: rgba(233, 78, 27, 0.22);
    color: #ffb49c;
  }

  .pillar__list-k {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-ink);
    line-height: 1.25;
  }
  .feature-card--paid .pillar__list-k {
    color: #ffffff;
  }

  .feature-card__foot {
    margin-top: 2px;
    padding-top: 8px;
    border-top: 1px solid var(--line-hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: nowrap;
  }
  .feature-card--paid .feature-card__foot {
    border-top-color: rgba(255, 255, 255, 0.1);
  }
  .feature-card__chips {
    display: flex;
    flex-wrap: nowrap;
    gap: 5px;
    min-width: 0;
    overflow: hidden;
  }
  .feature-chip {
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feature-chip--free {
    background: var(--bg-cream);
    color: var(--text-ink);
  }
  .feature-chip--paid {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(240, 237, 233, 0.82);
  }
  .feature-card__preview-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(30, 58, 138, 0.18);
    background: rgba(30, 58, 138, 0.05);
    color: var(--brand-navy);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 180ms;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .feature-card__preview-btn:hover {
    background: var(--brand-navy);
    color: #fff;
  }
  .feature-card__preview-btn--paid {
    border-color: rgba(233, 78, 27, 0.4);
    background: rgba(233, 78, 27, 0.14);
    color: #ff9c7a;
  }
  .feature-card__preview-btn--paid:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
  }

  /* Foot Callout Boxes inside Decks */
  .pillar__foot-box {
    margin-top: auto;
    padding: 16px 18px;
    border-radius: 18px;
    display: grid;
    gap: 10px;
  }
  .pillar__foot-box--free {
    grid-template-columns: auto 1fr;
    align-items: flex-start;
    gap: 12px;
    background: rgba(30, 58, 138, 0.055);
    border: 1px solid rgba(30, 58, 138, 0.12);
  }
  .pillar__foot-icon {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: #fff;
    color: var(--brand-navy);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .pillar__foot-icon svg {
    width: 16px;
    height: 16px;
  }
  .pillar__foot-box--paid {
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .usage-ticker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .usage-ticker__pill {
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: var(--brand-orange);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .usage-ticker__entry {
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(240, 237, 233, 0.85);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .usage-ticker__entry--free {
    background: rgba(31, 165, 138, 0.18);
    color: #7bf0d6;
  }

  .pillar__note {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-mute);
  }
  .pillar--paid .pillar__note {
    color: rgba(240, 237, 233, 0.78);
  }

  .asof {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Interactive App Screen Inspector */
  .app-inspector {
    margin-top: 44px;
    padding: clamp(22px, 3vw, 34px);
    border-radius: 30px;
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    display: grid;
    gap: 24px;
  }
  .app-inspector__head {
    display: grid;
    gap: 16px;
  }
  .app-inspector__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-orange);
    display: block;
    margin-bottom: 6px;
  }
  .app-inspector__title {
    margin: 0;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-ink);
  }
  .app-inspector__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .app-inspector__tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--bg-white);
    color: var(--text-ink);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 180ms;
  }
  .app-inspector__tab:hover {
    border-color: var(--brand-orange);
  }
  .app-inspector__tab.is-active {
    background: var(--text-ink);
    border-color: var(--text-ink);
    color: #fff;
    box-shadow: 0 6px 18px rgba(10, 10, 20, 0.16);
  }
  .app-inspector__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .app-inspector__dot--free { background: #1fa58a; }
  .app-inspector__dot--paid { background: var(--brand-orange); }

  .app-inspector__frame {
    margin: 0;
    border-radius: 22px;
    overflow: hidden;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    box-shadow: 0 24px 56px -18px rgba(14, 22, 51, 0.18);
    animation: inspector-fade 280ms ease-out;
  }
  .app-inspector__frame[hidden] {
    display: none;
  }
  @keyframes inspector-fade {
    from { opacity: 0; transform: translateY(6px) scale(0.992); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .app-inspector__img-wrap {
    max-height: 520px;
    overflow: hidden;
    background: #f7f6f4;
  }
  .app-inspector__img-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: top center;
  }
  .app-inspector__caption {
    padding: 14px 20px;
    border-top: 1px solid var(--line-hairline);
    background: var(--bg-white);
    font-size: 14px;
    color: var(--text-mute);
    line-height: 1.5;
  }

  /* Team Billing & Governance Interactive Bento Grid */
  .team-grid {
    margin-top: 44px;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }
  }
  .team-cell {
    --mx: 50%;
    --my: 50%;
    position: relative;
    padding: 26px 28px;
    border-radius: 26px;
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    isolation: isolate;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 240ms, border-color 240ms;
  }
  .team-cell::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(233, 78, 27, 0.1), transparent 65%);
    opacity: 0;
    transition: opacity 240ms;
    pointer-events: none;
    z-index: -1;
  }
  .team-cell:hover {
    transform: translateY(-3px);
    border-color: rgba(233, 78, 27, 0.35);
    box-shadow: 0 18px 40px -16px rgba(14, 22, 51, 0.12);
  }
  .team-cell:hover::before {
    opacity: 1;
  }
  .team-cell__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .team-cell__icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    color: var(--brand-orange);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(10, 10, 20, 0.05);
  }
  .team-cell__icon svg {
    width: 19px;
    height: 19px;
  }
  .team-cell__eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .team-cell__k {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text-ink);
  }
  .team-cell__d {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 60ch;
  }
  .team-widget {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .team-role-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-ink);
  }
  .team-role-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #1fa58a;
  }
  .pay-badge,
  .audit-chip {
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--text-ink);
  }
  .pay-badge--stripe {
    background: rgba(30, 58, 138, 0.08);
    border-color: rgba(30, 58, 138, 0.2);
    color: var(--brand-navy);
  }
  .topup-sim-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px 6px 8px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-ink);
  }
  .topup-sim-btn__track {
    width: 28px;
    height: 16px;
    border-radius: var(--radius-pill);
    background: var(--brand-orange);
    position: relative;
    transition: background-color 200ms;
  }
  .topup-sim-btn[aria-pressed='false'] .topup-sim-btn__track {
    background: rgba(10, 10, 20, 0.25);
  }
  .topup-sim-btn__knob {
    position: absolute;
    top: 2px;
    left: 14px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    transition: left 200ms;
  }
  .topup-sim-btn[aria-pressed='false'] .topup-sim-btn__knob {
    left: 2px;
  }

  /* ----------------------------------------------------------------
     Studio: the three models
     ---------------------------------------------------------------- */
  .models {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 900px) {
    .models { grid-template-columns: repeat(3, 1fr); }
  }
  .model {
    padding: 32px;
    border-radius: 28px;
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    display: grid;
    gap: 14px;
    align-content: start;
    scroll-margin-top: 96px;
  }
  .model__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .model__tag span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .model__title {
    margin: 0;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text-ink);
  }
  .model__body {
    margin: 0;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }

  /* Timeline (drawn on scroll) */
  .timeline {
    position: relative;
    margin-top: 72px;
    padding-block: 0 8px;
  }
  .timeline__title,
  .drivers__title {
    margin: 0 0 28px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-ink);
  }
  .timeline__path {
    position: absolute;
    left: 0;
    width: 100%;
    height: 80px;
    pointer-events: none;
    top: 64px;
  }
  @media (max-width: 799px) {
    .timeline__path { display: none; }
  }
  .timeline__path path {
    fill: none;
    stroke: var(--brand-orange);
    stroke-width: 2;
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    transition: stroke-dashoffset 1400ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .timeline.is-in .timeline__path path { stroke-dashoffset: 0; }

  .timeline__list {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 16px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 800px) {
    .timeline__list {
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
    }
  }
  .timeline__step {
    display: grid;
    gap: 10px;
    justify-items: start;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 600ms, transform 600ms;
  }
  @media (min-width: 800px) {
    .timeline__step { justify-items: center; text-align: center; }
  }
  .timeline.is-in .timeline__step { opacity: 1; transform: translateY(0); }
  .timeline.is-in .timeline__step:nth-child(1) { transition-delay: 100ms; }
  .timeline.is-in .timeline__step:nth-child(2) { transition-delay: 260ms; }
  .timeline.is-in .timeline__step:nth-child(3) { transition-delay: 420ms; }
  .timeline.is-in .timeline__step:nth-child(4) { transition-delay: 580ms; }
  .timeline.is-in .timeline__step:nth-child(5) { transition-delay: 740ms; }

  .timeline__node {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--line-hairline);
    color: var(--brand-orange);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(10, 10, 20, 0.08);
    transition: transform 240ms, border-color 240ms;
  }
  .timeline__step:hover .timeline__node {
    transform: scale(1.08) rotate(-2deg);
    border-color: var(--brand-orange);
  }
  .timeline__node svg { width: 22px; height: 22px; }
  .timeline__label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--type-body);
    color: var(--text-ink);
  }
  .timeline__note {
    font-size: var(--type-body);
    color: var(--text-mute);
    line-height: 1.5;
    max-width: 22ch;
  }

  /* What drives a quote: prose, not another list */
  .drivers {
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--line-hairline);
    max-width: 68ch;
  }
  .drivers__title { margin-bottom: 14px; }
  .drivers__text {
    margin: 0;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-ink);
  }

  /* ----------------------------------------------------------------
     Studio: Assets by the brief (Quotation calculator intro)
     ---------------------------------------------------------------- */
  .calc-band {
    margin-top: 64px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: 28px;
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    display: grid;
    gap: 36px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .calc-band {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: 48px;
    }
  }
  .calc-band__copy {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .calc-band__title {
    margin: 4px 0 0;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
    font-size: clamp(28px, 3vw, 40px);
    color: var(--text-ink);
  }
  .calc-band__title .accent,
  .social-panel__title .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .calc-band__lead {
    margin: 0;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 52ch;
  }
  .calc-band .app-highlights {
    margin-top: 6px;
  }
  .calc-band .app-highlights li {
    background: var(--bg-white);
  }
  .calc-band__cta {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .calc-band__shot {
    background: var(--bg-white);
  }

  /* ----------------------------------------------------------------
     Social networks (#social)
     ---------------------------------------------------------------- */
  .chapter--social {
    background: var(--bg-cream);
    border-top: 1px solid var(--line-hairline);
  }
  .social-head {
    display: grid;
    gap: 18px;
    margin-bottom: 48px;
  }
  .social-head__top-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  .social-fx-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .social-fx-pill__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
    flex-shrink: 0;
  }
  .social-head__lead {
    margin-top: 8px;
    max-width: 60ch;
  }
  .social-tabs {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 6px;
    border-radius: 20px;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    width: fit-content;
    max-width: 100%;
  }
  .social-tab {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 0;
    background: transparent;
    color: var(--text-ink);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 180ms, color 180ms, box-shadow 180ms;
  }
  .social-tab:hover {
    color: var(--brand-orange);
  }
  .social-tab[aria-selected='true'] {
    background: var(--brand-orange);
    color: #fff;
    box-shadow: 0 6px 18px rgba(233, 78, 27, 0.24);
  }

  .social-panel {
    display: grid;
    gap: 36px;
  }
  .social-panel[hidden] {
    display: none;
  }
  .social-panel__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line-strong);
  }
  .social-panel__badge {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-orange);
    margin-bottom: 10px;
  }
  .social-panel__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-size: clamp(26px, 2.8vw, 38px);
    color: var(--text-ink);
  }
  .social-panel__lead {
    margin: 12px 0 0;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 62ch;
  }
  .social-panel__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  .social-tiers {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 900px) {
    .social-tiers {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .social-tier {
    padding: 32px;
    border-radius: 28px;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .social-tier--popular {
    border-color: var(--brand-orange);
    box-shadow: 0 20px 56px -16px rgba(233, 78, 27, 0.16);
  }
  .social-tier__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .social-tier__name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-ink);
  }
  .social-tier__Ribbon {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(233, 78, 27, 0.12);
    color: var(--brand-orange);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .social-tier__price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .social-tier__price {
    font-family: var(--font-sans);
    font-size: clamp(32px, 3.2vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-ink);
    font-variant-numeric: tabular-nums;
  }
  .social-tier__period {
    font-size: 14px;
    color: var(--text-mute);
  }
  .social-tier__desc {
    margin: 0;
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--text-mute);
  }
  .social-tier__cta {
    margin-top: auto;
    padding-top: 12px;
  }

  .social-table-wrap {
    overflow-x: auto;
    border-radius: 28px;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
  }
  .social-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 15px;
  }
  .social-table__th,
  .social-table__feature,
  .social-table__cell {
    padding: 16px 22px;
    text-align: left;
    vertical-align: middle;
  }
  .social-table__th {
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg-white);
  }
  .social-table__th--feature {
    width: 34%;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .social-table__th--popular,
  .social-table__cell--popular {
    background: rgba(233, 78, 27, 0.035);
  }
  .social-table__tier-name {
    display: block;
    font-weight: 600;
    color: var(--text-ink);
    font-size: 15px;
  }
  .social-table__tier-price {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-mute);
    margin-top: 2px;
  }
  .social-table__cat-row {
    border-top: 1px solid var(--line-strong);
    background: rgba(14, 22, 51, 0.03);
  }
  .social-table__cat {
    padding: 10px 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-navy);
  }
  .social-table__row {
    border-top: 1px solid var(--line-hairline);
  }
  .social-table__feature {
    font-weight: 500;
    color: var(--text-ink);
  }
  .social-table__cell {
    color: var(--text-ink);
  }
  .social-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(233, 78, 27, 0.12);
    color: var(--brand-orange);
    font-weight: 700;
    font-size: 12px;
  }
  .social-dash {
    color: var(--text-mute);
