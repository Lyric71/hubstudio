  }
  .faq__item[data-hide='true'] {
    display: none;
  }
  .faq__q {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 18px;
    padding-block: 22px;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__cat {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
    background: rgba(233, 78, 27, 0.1);
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  @media (max-width: 599px) {
    .faq__q { grid-template-columns: 1fr auto; }
    .faq__cat { grid-column: 1 / -1; }
  }
  .faq__q-text {
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--text-ink);
    line-height: 1.4;
  }
  .faq__chev {
    width: 16px;
    height: 16px;
    color: var(--text-mute);
    transition: transform 240ms ease-out;
    flex: none;
  }
  .faq__item[open] .faq__chev { transform: rotate(180deg); color: var(--brand-orange); }
  .faq__a {
    padding: 4px 0 24px;
    margin: 0;
    max-width: 72ch;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  @media (min-width: 600px) {
    .faq__a { margin-left: 114px; }
  }

  /* ----------------------------------------------------------------
     Reveal (shared) & Staggered Scroll Cards
     ---------------------------------------------------------------- */
  .reveal { opacity: 0; transform: translateY(24px); }
  .reveal.is-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 600ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .feature-card,
  .team-cell {
    opacity: 0;
    transform: translateY(22px);
  }
  .feature-card.is-in,
  .team-cell.is-in {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 540ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 540ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 260ms,
      border-color 260ms,
      background-color 260ms;
  }
  .feature-card.is-in:hover,
  .team-cell.is-in:hover {
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
    .reveal,
    .feature-card,
    .team-cell,
    .timeline__step { opacity: 1; transform: none; }
    .timeline__path path { stroke-dashoffset: 0; }
  }
</style>

<script>
  /* ============================================================
     Pricing page: scroll-linked motion and interaction
     ============================================================ */

  // Reveal on scroll (headlines, timeline drawing, and staggered feature/bento cards)
  const reveals = document.querySelectorAll('.reveal, [data-timeline]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.16 },
    );
    reveals.forEach((el) => io.observe(el));

    // Staggered scroll reveal for feature cards & team bento cells
    const staggerCards = document.querySelectorAll<HTMLElement>('.feature-card, .team-cell');
    const cardIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.transitionDelay = `${Math.min(idx * 65, 260)}ms`;
            el.classList.add('is-in');
            window.setTimeout(() => {
              el.style.transitionDelay = '';
            }, 650);
            cardIo.unobserve(el);
          }
        });
      },
      { threshold: 0.12 },
    );
    staggerCards.forEach((el) => cardIo.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
    document.querySelectorAll('.feature-card, .team-cell').forEach((el) => el.classList.add('is-in'));
  }

  // Pointer-tracking radial spotlight on feature & bento cards
  const spotlightCards = document.querySelectorAll<HTMLElement>('.js-spotlight');
  spotlightCards.forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Interactive App Pricing Board: View Filter + Sliding Glider Pill
  const meterBoard = document.querySelector<HTMLElement>('[data-meter-board]');
  const meterFilterBtns = document.querySelectorAll<HTMLButtonElement>('[data-meter-filter]');
  const meterGlider = document.querySelector<HTMLElement>('[data-meter-glider]');

  const syncMeterGlider = (activeBtn: HTMLButtonElement | null) => {
    if (!meterGlider || !activeBtn) return;
    const parent = activeBtn.parentElement;
    if (!parent) return;
    const pr = parent.getBoundingClientRect();
    const br = activeBtn.getBoundingClientRect();
    meterGlider.style.width = `${br.width}px`;
    meterGlider.style.transform = `translateX(${br.left - pr.left - 4}px)`;
  };

  if (meterFilterBtns.length) {
    const initialBtn = document.querySelector<HTMLButtonElement>('[data-meter-filter].is-active');
    requestAnimationFrame(() => syncMeterGlider(initialBtn));
    window.addEventListener('resize', () => {
      const current = document.querySelector<HTMLButtonElement>('[data-meter-filter].is-active');
      syncMeterGlider(current);
    });

    meterFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.meterFilter || 'all';
        meterFilterBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        syncMeterGlider(btn);
        if (meterBoard) meterBoard.dataset.meterView = view;
      });
    });
  }

  // Interactive Balance Simulator Toggle (Topped up vs Zero balance)
  const balanceToggle = document.querySelector<HTMLButtonElement>('[data-balance-toggle]');
  const zeroNotice = document.querySelector<HTMLElement>('[data-zero-notice]');
  const runCtaLabel = document.querySelector<HTMLElement>('[data-run-cta-label]');

  if (balanceToggle && meterBoard) {
    balanceToggle.addEventListener('click', () => {
      const isZero = balanceToggle.getAttribute('aria-checked') !== 'true';
      balanceToggle.setAttribute('aria-checked', isZero ? 'true' : 'false');
      meterBoard.dataset.balanceState = isZero ? 'zero' : 'active';
      if (zeroNotice) zeroNotice.hidden = !isZero;
      if (runCtaLabel) {
        runCtaLabel.textContent = isZero
          ? 'Top up balance to run'
          : 'Run with upfront price';
      }
    });
  }

  // Free Deck Sandbox: Safe-zone crop ratio switcher, EXIF scrubber, & tabs
  const sandboxTabs = document.querySelectorAll<HTMLButtonElement>('[data-sandbox-tab]');
  const sandboxPanels = document.querySelectorAll<HTMLElement>('[data-sandbox-panel]');
  sandboxTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.sandboxTab;
      sandboxTabs.forEach((t) => t.classList.toggle('is-active', t === tab));
      sandboxPanels.forEach((p) => {
        p.hidden = p.dataset.sandboxPanel !== target;
      });
    });
  });

  const ratioBtns = document.querySelectorAll<HTMLButtonElement>('[data-ratio]');
  const cropFrame = document.querySelector<HTMLElement>('[data-crop-frame]');
  const cropRatioBox = document.querySelector<HTMLElement>('[data-crop-ratio-box]');
  const cropLabel = document.querySelector<HTMLElement>('[data-crop-label]');
  ratioBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      ratioBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      if (cropFrame && btn.dataset.ratio) cropFrame.dataset.cropFrame = btn.dataset.ratio;
      if (cropRatioBox && btn.dataset.ratio) cropRatioBox.textContent = btn.dataset.ratio;
      if (cropLabel && btn.dataset.label) cropLabel.textContent = btn.dataset.label;
    });
  });

  const exifBox = document.querySelector<HTMLElement>('[data-exif-box]');
  const exifBtn = document.querySelector<HTMLButtonElement>('[data-exif-scrub]');
  const exifBtnLabel = document.querySelector<HTMLElement>('[data-exif-btn-label]');
  if (exifBox && exifBtn && exifBtnLabel) {
    exifBtn.addEventListener('click', () => {
      const scrubbed = exifBox.classList.toggle('is-scrubbed');
      exifBtnLabel.textContent = scrubbed
        ? 'Clean file ready · Reset preview'
        : 'Scrub metadata in browser';
    });
  }

  // Paid Deck Run Widget: Mode switcher & Simulated Upfront Run click
  const runModes = document.querySelectorAll<HTMLButtonElement>('[data-run-mode]');
  const runEngine = document.querySelector<HTMLElement>('[data-run-engine]');
  const runHint = document.querySelector<HTMLElement>('[data-run-hint]');
  const runTrigger = document.querySelector<HTMLButtonElement>('[data-run-trigger]');

  runModes.forEach((btn) => {
    btn.addEventListener('click', () => {
      runModes.forEach((b) => b.classList.toggle('is-active', b === btn));
      if (runEngine && btn.dataset.engine) runEngine.textContent = btn.dataset.engine;
      if (runHint && btn.dataset.status) runHint.textContent = btn.dataset.status;
    });
  });

  if (runTrigger && runCtaLabel && runHint) {
    runTrigger.addEventListener('click', () => {
      if (meterBoard?.dataset.balanceState === 'zero') {
        if (zeroNotice) zeroNotice.hidden = false;
        return;
      }
      const prevLabel = runCtaLabel.textContent;
      const prevHint = runHint.textContent;
      runCtaLabel.textContent = 'Run succeeded · Logged';
      runHint.textContent = 'Recorded in usage log with runner name (failed runs never charged)';
      window.setTimeout(() => {
        runCtaLabel.textContent = prevLabel;
        runHint.textContent = prevHint;
      }, 2200);
    });
  }

  // Interactive App Screen Inspector + Feature Card "Preview UI" triggers
  const inspectorTabs = document.querySelectorAll<HTMLButtonElement>('[data-inspector-tab]');
  const inspectorPanels = document.querySelectorAll<HTMLElement>('[data-inspector-panel]');
  const inspectorEl = document.querySelector<HTMLElement>('[data-app-inspector]');

  const activateInspectorScreen = (key: string, scrollIntoView = false) => {
    inspectorTabs.forEach((tab) => {
      const active = tab.dataset.inspectorTab === key;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    inspectorPanels.forEach((panel) => {
      const active = panel.dataset.inspectorPanel === key;
      panel.classList.toggle('is-active', active);
      panel.hidden = !active;
    });
    if (scrollIntoView && inspectorEl) {
      inspectorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  };

  inspectorTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.dataset.inspectorTab) activateInspectorScreen(tab.dataset.inspectorTab, false);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-preview-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.previewTarget;
      if (target) activateInspectorScreen(target, true);
    });
  });

  // Team Bento Grid: Auto top-up interactive guardrail switch
  const topupSimBtn = document.querySelector<HTMLButtonElement>('[data-topup-sim]');
  const topupSimLabel = document.querySelector<HTMLElement>('[data-topup-sim-label]');
  if (topupSimBtn && topupSimLabel) {
    topupSimBtn.addEventListener('click', () => {
      const next = topupSimBtn.getAttribute('aria-pressed') !== 'true';
      topupSimBtn.setAttribute('aria-pressed', next ? 'true' : 'false');
      topupSimLabel.textContent = next
        ? 'Auto top-up guardrails: Trigger + Daily cap'
        : 'Optional: Manual top-up only';
    });
  }

  // Parallax on the hero image
  const parallaxEls = document.querySelectorAll<HTMLElement>('.js-parallax');
  let parallaxRaf = 0;
  const onScrollParallax = () => {
    parallaxRaf = 0;
    const y = window.scrollY;
    parallaxEls.forEach((el) => {
      const speed = Number(el.dataset.speed || 0.2);
      el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
    });
  };
  if (parallaxEls.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!parallaxRaf) parallaxRaf = requestAnimationFrame(onScrollParallax);
      },
      { passive: true },
    );
  }

  // Gentle pointer tilt on chapter photos
  const tilters = document.querySelectorAll<HTMLElement>('.js-tilt');
  tilters.forEach((el) => {
    const max = Number(el.dataset.tilt || 5);
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      el.style.transform = `perspective(1200px) rotateY(${px * max}deg) rotateX(${-py * max}deg)`;
    });
    el.addEventListener('pointerleave', () => {
      el.style.transform = '';
    });
  });

  // Magnetic buttons
  const magnetic = document.querySelectorAll<HTMLElement>('.js-magnetic');
  magnetic.forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = e.clientX - r.left - r.width / 2;
      const y = e.clientY - r.top - r.height / 2;
      el.style.transform = `translate(${x * 0.18}px, ${y * 0.22}px)`;
    });
    el.addEventListener('pointerleave', () => {
      el.style.transform = '';
    });
  });

  // Social networks tab switcher
  const socialTabBtns = document.querySelectorAll<HTMLButtonElement>('[data-social-tab]');
  const socialPanels = document.querySelectorAll<HTMLElement>('[data-social-panel]');
  socialTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.socialTab;
      socialTabBtns.forEach((b) => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'));
      socialPanels.forEach((panel) => {
        panel.hidden = panel.dataset.socialPanel !== targetId;
      });
    });
  });

  // Weekly FX conversion check & live pricing updater for French (EUR €) & Chinese (CNY ¥)
  const socialSection = document.querySelector<HTMLElement>('#social[data-social-fx-currency]');
  if (socialSection) {
    const htmlLang = (document.documentElement.lang || '').toLowerCase();
    const targetCurrency: 'USD' | 'EUR' | 'CNY' = htmlLang.startsWith('fr')
      ? 'EUR'
      : htmlLang.startsWith('zh')
        ? 'CNY'
        : ((socialSection.dataset.socialFxCurrency as 'USD' | 'EUR' | 'CNY') || 'USD');

    const roundSocial = (raw: number) => (raw >= 200 ? Math.round(raw / 10) * 10 : Math.round(raw));

    const formatSocialCurrency = (usd: number, currency: 'USD' | 'EUR' | 'CNY', rates: { EUR: number; CNY: number }) => {
      if (currency === 'EUR') {
        const val = roundSocial(usd * rates.EUR);
        return `${val.toLocaleString('fr-FR', { maximumFractionDigits: 0 }).replace(/\s/g, '\u00a0')}\u00a0€`;
      }
      if (currency === 'CNY') {
        const val = roundSocial(usd * rates.CNY);
        return `¥${val.toLocaleString('en-US', { maximumFractionDigits: 0 })}`;
      }
      return `$${Math.round(usd).toLocaleString('en-US', { maximumFractionDigits: 0 })}`;
    };

    const applySocialFxRates = (rates: { EUR: number; CNY: number }) => {
      if (targetCurrency === 'USD') return;
      const monthSuffix = targetCurrency === 'EUR' ? '/mois' : '/月';

      socialSection.querySelectorAll<HTMLElement>('[data-usd]').forEach((el) => {
        const usd = Number(el.dataset.usd);
        if (!Number.isFinite(usd) || usd <= 0) return;
        const formatted = formatSocialCurrency(usd, targetCurrency, rates);
        const mode = el.dataset.usdFormat;

        if (mode === 'amount') {
          el.textContent = formatted;
        } else if (mode === 'monthly') {
          el.textContent = `${formatted}${monthSuffix}`;
        } else if (mode === 'inline-replace' && el.textContent) {
          if (targetCurrency === 'EUR') {
            el.textContent = el.textContent.replace(/[0-9][0-9\s\u00a0\u202f.,]*\s*[€$]/u, formatted);
          } else if (targetCurrency === 'CNY') {
            el.textContent = el.textContent.replace(/[¥$]\s*[0-9][0-9,]*/u, formatted);
          }
        }
      });
    };

    const STORAGE_KEY = 'hubstudio_weekly_social_fx_v1';
    const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
    const defaultRates = {
      EUR: Number(socialSection.dataset.socialFxEur) || 0.89015,
      CNY: Number(socialSection.dataset.socialFxCny) || 6.6761,
    };

    // Always ensure localized currency formatting matches the active language on first paint
    applySocialFxRates(defaultRates);

    // Check weekly FX cache; refresh from ECB (Frankfurter) only once per 7-day window
    if (targetCurrency !== 'USD') {
      try {
        const rawCache = window.localStorage.getItem(STORAGE_KEY);
        const cached = rawCache ? (JSON.parse(rawCache) as { EUR: number; CNY: number; checkedAt: number }) : null;
        const now = Date.now();
        const serverNextDue = Date.parse(socialSection.dataset.socialFxNextDue || '') || 0;

        if (cached && cached.EUR > 0 && cached.CNY > 0 && now - cached.checkedAt < WEEK_MS) {
          applySocialFxRates({ EUR: cached.EUR, CNY: cached.CNY });
        } else if (now >= serverNextDue || !cached) {
          fetch('https://api.frankfurter.app/latest?from=USD&to=EUR,CNY', {
            headers: { accept: 'application/json' },
          })
            .then((r) => (r.ok ? r.json() : null))
            .then((data) => {
              const eur = data?.rates?.EUR;
              const cny = data?.rates?.CNY;
              if (typeof eur === 'number' && typeof cny === 'number' && eur > 0 && cny > 0) {
                const nextSnapshot = { EUR: eur, CNY: cny, checkedAt: Date.now() };
                try {
                  window.localStorage.setItem(STORAGE_KEY, JSON.stringify(nextSnapshot));
                } catch {
                  /* ignore storage quota errors */
                }
                applySocialFxRates({ EUR: eur, CNY: cny });
              }
            })
            .catch(() => {
              /* fallback to server-rendered weekly snapshot */
            });
        }
      } catch {
        /* ignore storage access errors */
      }
    }
  }

  // FAQ filter by offer. Questions about both offers show under either filter.
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.faq__filter-btn');
  const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq__item');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const filter = btn.dataset.filter;
      faqItems.forEach((item) => {
        const topic = item.dataset.topic;
        const hide = filter !== 'all' && topic !== 'both' && topic !== filter;
        item.dataset.hide = hide ? 'true' : 'false';
        if (hide) item.open = false;
      });
    });
  });

  // FAQ accordion: one open at a time
  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        faqItems.forEach((other) => {
          if (other !== item && other.dataset.hide !== 'true') other.open = false;
        });
      }
    });
  });

  // Smooth scroll for in-page links
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
