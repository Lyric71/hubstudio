    lead="Still deciding? The app and the studio are one company. Start with either one and move between them when the work changes."
  />

  <!-- ============================================================
       COMPARISON MATRIX
       ============================================================ -->
  <section class="matrix" id="compare">
    <div class="container">
      <header class="matrix__head">
        <span class="chapter__tag">Side by side</span>
        <h2 class="chapter__display reveal">
          The three ways, <span class="accent">compared</span>.
        </h2>
        <p class="section-note">
          The big differences are who makes the work and how you pay for it.
          Read across a row to compare.
        </p>
      </header>

      <div class="matrix__wrap">
        <table class="matrix__table">
          <thead>
            <tr>
              <th scope="col" class="matrix__th matrix__th--feature"><span class="sr-only">Question</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--orange">Use the app</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--navy">Studio + app</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--ink">Studio only</span></th>
            </tr>
          </thead>
          <tbody>
            {matrixRows.map((row) => (
              <tr class="matrix__row">
                <th scope="row" class="matrix__feature">{row.feature}</th>
                <td>{row.app}</td>
                <td>{row.both}</td>
                <td>{row.studio}</td>
              </tr>
            ))}
            <tr class="matrix__row matrix__row--cta">
              <th scope="row" class="matrix__feature">Start here</th>
              <td><a class="arrow-link" href={APP_SIGNUP} target="_blank" rel="noopener">Create your account <span aria-hidden="true">&rarr;</span></a></td>
              <td><a class="arrow-link" href={`${BRIEF_URL}?way=studio-app`}>Send a brief <span aria-hidden="true">&rarr;</span></a></td>
              <td><a class="arrow-link" href={`${BRIEF_URL}?way=studio-only`}>Send a brief <span aria-hidden="true">&rarr;</span></a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FAQ (filtered by offer)
       ============================================================ -->
  <section class="faq" id="faq">
    <div class="container">
      <header class="faq__head">
        <span class="chapter__tag">Questions</span>
        <h2 class="chapter__display reveal">
          What buyers ask before they <span class="accent">pay</span>.
        </h2>
        <p class="faq__updated">Updated September 2026</p>
        <p class="section-note">
          Filter by offer, or read them all. If your question isn’t here,
          write to <a href="mailto:hello@hubstudio.ai">hello@hubstudio.ai</a>
          and a person will answer it.
        </p>
      </header>

      <div class="faq__filter" role="group" aria-label="Filter questions by offer">
        {faqFilters.map((f, i) => (
          <button
            class="faq__filter-btn"
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))}
      </div>

      <div class="faq__list">
        {faqs.map((item) => (
          <details class="faq__item" data-topic={item.c}>
            <summary class="faq__q">
              <span class="faq__cat">{topicLabel[item.c]}</span>
              <span class="faq__q-text">{item.q}</span>
              <svg class="faq__chev" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       INSIGHTS LAYER (cost method, buying models)
       ============================================================ -->
  <InsightsLayer placement="pricing" tone="white" id="reading" />

  <!-- ============================================================
       CLOSING: both doors
       ============================================================ -->
  <DualCta
    eyebrow="Two ways in"
    pre="Open an account, or send us the "
    accent="brief"
    post="."
    text="Creating an account costs nothing, and every run shows its price first. For studio work, a producer reads your brief within one business day."
  />
</Layout>

<style>
  /* ============================================================
     PRICING PAGE
     Design variables come from global.css. Local rules add the hero, the
     chapters, the drawing timeline, the matrix, and the FAQ.
     ============================================================ */

  /* One Playfair italic accent word per headline. */
  .hero__display .accent,
  .chapter__display .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-orange);
    font-weight: 600;
    font-size: var(--type-button);
  }
  .arrow-link span {
    transition: transform 200ms ease-out;
  }
  .arrow-link:hover span {
    transform: translateX(6px);
  }

  /* ----------------------------------------------------------------
     Hero
     ---------------------------------------------------------------- */
  .hero {
    position: relative;
    background: var(--bg-cream);
    padding-block: 56px 64px;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: 88px 96px;
    }
  }
  .hero__grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 64px;
    }
  }
  .hero__copy {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .hero__tag {
    align-self: start;
    display: inline-flex;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: rgba(233, 78, 27, 0.12);
    color: var(--brand-orange);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    width: fit-content;
  }
  .hero__display {
    font-family: var(--font-sans);
