  /* ----------------------------------------------------------------
     Studio + app (dark)
     ---------------------------------------------------------------- */
  .chapter--dark {
    background: var(--bg-ink);
    color: var(--text-on-dark);
    isolation: isolate;
    overflow: hidden;
  }
  .chapter__dark-bg {
    position: absolute;
