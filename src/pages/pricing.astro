       ============================================================ -->
  <InsightsLayer placement="pricing" tone="white" id="reading" />

  <!-- ============================================================
       CLOSING: both doors
       ============================================================ -->
  <DualCta
    eyebrow="Two ways in"
    pre="Open an account, or send us the "
    accent="brief"
    post="."
    text="Creating an account costs nothing, and every run shows its price first. For studio work, a producer reads your brief within one business day."
  />
</Layout>

