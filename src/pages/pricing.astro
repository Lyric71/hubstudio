---
/**
 * Pricing (`/pricing`).
 *
 * How you pay for the two offers, with no amounts anywhere: the app runs on a
 * prepaid balance held in real currency (price shown before every run), the
 * studio quotes from a brief (asset-based, project-based, or retainer). Then
 * Studio + app (who pays for the runs), the three ways to work, a comparison
 * table, the FAQ, the insights layer, and both doors.
 *
 * Money language follows hubstudio-positioning.md: balance, top-up, run.
 * Never an amount, a currency code, a rate, or the old unit names.
 *
 * SEO excerpt (25 words): hubStudio's app runs on a prepaid balance, and every
 * run shows its price first. Studio work is quoted per asset, per project, or
 * on retainer.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import InsightsLayer from '../components/InsightsLayer.astro';
import WaysToWork from '../components/WaysToWork.astro';
import DualCta from '../components/DualCta.astro';
import { APP_SIGNUP, BRIEF_URL, HELP_URL } from '../lib/links';

const jumps = [
  { label: 'The app', href: '#app' },
  { label: 'The studio', href: '#studio' },
  { label: 'Studio + app', href: '#studio-app' },
  { label: 'Compare', href: '#compare' },
];

const paid = [
  { k: 'Image and video runs', d: 'Every engine has its own price, and the button shows it before you run.' },
  { k: 'AI drafts and “Improve with AI” rewrites', d: 'A post drafted for you, a new version, a rewritten prompt.' },
  { k: 'Voice input', d: 'Speech turned into text by an AI model, in any text box.' },
  { k: 'Storage', d: 'A small daily charge for the files your team keeps.' },
  { k: 'Downloads', d: 'A transfer charge when a stored file is downloaded.' },
];

const free = [
  'Creating an account',
  'Adding people to your team',
  'The Image editor',
  'The Image anonymizer',
  'The Video editor',
  'Validation',
  'Publishing to LinkedIn, Instagram, Facebook, and TikTok',
];

const teamCells = [
  {
    k: 'One team balance',
    d: 'Working alone, you’re a team of one. In a team, everyone draws on one shared balance. Admins can set a daily spending limit for each creator. Viewers and clients spend nothing, and clients hold no balance at all.',
  },
  {
    k: 'Card, Alipay, or WeChat Pay',
    d: 'You pay on Stripe’s own page, so your payment details are never typed into hubStudio.',
  },
  {
    k: 'Automatic top-up',
    d: 'It’s optional and needs a saved card. You pick the level that triggers a top-up, and a cap on what can be charged automatically in one day.',
  },
  {
    k: 'Invoices and usage',
    d: 'You get an invoice for every top-up. The usage log lists every paid action, and admins see it person by person.',
  },
];

const studioModels = [
  {
    id: 'asset-based',
    tag: 'Asset-based',
    title: 'Pay for finished assets.',
    body: 'You order finished assets. Volume formats, such as product images, short vertical video, product copy, and social captions, carry minimum order quantities. Bespoke formats, such as brand identity, packaging, motion, 3D, or a live shoot, are quoted one by one with no minimum. It suits volume that rises and falls from month to month.',
  },
  {
    id: 'project-based',
    tag: 'Project-based',
    title: 'A team around one launch.',
    body: 'We put a team around your brief: a creative director, an art director, an AIGC engineer, a copywriter, and a producer. You get one quote and one schedule, and we bill by milestone. A launch or a seasonal campaign usually fits here, since both come with a clear scope and a date.',
  },
  {
    id: 'retainer',
    tag: 'Retainer',
    title: 'A studio team, month after month.',
    body: 'A fixed monthly fee buys a dedicated team and an agreed monthly volume, mixed across our twenty service lines. The team keeps your prompt library and brand-trained models, so it doesn’t relearn your brand on every job. Terms run three, six, or twelve months. It suits steady work across channels that doesn’t stop between campaigns.',
  },
];

const projectTimeline = [
  {
    label: 'Brief',
    note: 'In your words. A page is enough.',
    icon: 'M4 4h12v16H4z M7 9h6 M7 13h6 M7 17h4',
  },
  {
    label: 'Proposal',
    note: 'In writing, within 48 hours.',
    icon: 'M4 12l4 4 12-12',
  },
  {
    label: 'Production',
    note: 'Art directors lead, AIGC production underneath.',
    icon: 'M4 12a8 8 0 1 0 8-8 M12 8v4l3 2',
  },
  {
    label: 'Review',
    note: 'You comment, we revise.',
    icon: 'M3 12s3-6 9-6 9 6 9 6-3 6-9 6-9-6-9-6z M12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z',
  },
  {
    label: 'Delivery',
    note: 'Finished files, with provenance recorded for each asset.',
    icon: 'M5 13l4 4L19 7',
  },
];

const matrixRows = [
  {
    feature: 'Who does the work',
    app: 'Your own team, in hubStudio',
    both: 'Our studio, inside hubStudio',
    studio: 'Our studio, outside the app',
  },
  {
    feature: 'How you pay',
    app: 'From a prepaid balance, at the price shown before each run.',
    both: 'A studio fee, quoted from your brief. In our workspace the fee covers the runs; in yours they come from your balance.',
    studio: 'A studio fee, quoted from your brief: per asset, per project, or on retainer.',
  },
  {
    feature: 'What you see',
    app: 'Everything: prompts, engines, prices, History, and the usage log.',
    both: 'A Client space with your finished work, or your whole workspace if we work in it.',
    studio: 'The finished files we deliver.',
  },
  {
    feature: 'Approvals',
    app: 'Validation, between teammates or with your clients.',
    both: 'Validation, version by version, on one thread.',
    studio: 'You review drafts with our team directly. No login needed.',
  },
  {
    feature: 'What you need to start',
    app: 'An account, which costs nothing.',
    both: 'A brief.',
    studio: 'A brief. No account needed.',
  },
  {
    feature: 'Best for',
    app: 'Teams that want to make the work and control every run.',
    both: 'Brands that want studio work with approvals and files in one place.',
    studio: 'Launches and bespoke work handed over end to end.',
  },
];

type FaqTopic = 'app' | 'studio' | 'both';

const topicLabel: Record<FaqTopic, string> = {
  app: 'The app',
  studio: 'The studio',
  both: 'Both',
};

const faqs: { c: FaqTopic; q: string; a: string }[] = [
  {
    c: 'both',
    q: 'Why doesn’t this page list prices?',
    a: 'Every engine in the app has its own price, and the price moves with the settings you pick: the size, the number of images, the length of a clip. No table on this page could keep up with every combination. The app shows the exact price on the button before every run. Studio work depends on the brief, so we quote it in writing after we’ve read it.',
  },
  {
    c: 'app',
    q: 'Is there a subscription, a seat fee, or a free trial?',
    a: 'No. There’s no subscription, no seat fee, and no free trial. Creating an account costs nothing, and so do the Image editor, the Image anonymizer, the Video editor, Validation, and publishing to LinkedIn, Instagram, Facebook, and TikTok. Runs need money on the balance, and a small first top-up is enough to try the engines you care about.',
  },
  {
    c: 'app',
    q: 'What happens when a run fails?',
    a: 'You pay nothing for it. A run is charged only when it succeeds, at the price you saw before it started. One exception: a video clip longer than 15 seconds can time out after the engine has billed it, and the form warns you before you run it.',
  },
  {
    c: 'app',
    q: 'Does the balance expire?',
    a: 'No. It stays there until you spend it. Top-ups aren’t refunded, though, so add what you expect to use.',
  },
  {
    c: 'app',
    q: 'How do I keep an eye on what my team spends?',
    a: 'Admins can set a daily spending limit for each creator. The usage log shows every paid action, and admins can see it person by person. Viewers and client logins spend nothing.',
  },
  {
    c: 'app',
    q: 'How can I pay?',
    a: 'By card, Alipay, or WeChat Pay, on Stripe’s page. Automatic top-up is optional and works with a saved card.',
  },
  {
    c: 'app',
    q: 'Do I get an invoice?',
    a: 'Yes, one for every top-up, automatic ones included. It’s made out to your team or to you.',
  },
  {
    c: 'studio',
    q: 'How do you price studio work?',
    a: 'Per asset, per project, or on a monthly retainer. The quote depends on the scope, the method, the deadline, and where the work will run. You get it as a written proposal within 48 hours of your brief.',
  },
  {
    c: 'studio',
    q: 'When the studio works in the app, who pays for the runs?',
    a: 'It depends on whose workspace we’re in. When we work in our own, the runs come out of our balance and your studio fee covers them. Inside your workspace, our creatives are members like anyone else, so their runs are charged to your balance at the price shown before each one.',
  },
  {
    c: 'studio',
    q: 'What are the payment terms for studio work?',
    a: 'Asset orders take a deposit up front, with the rest due on delivery. Projects are billed at milestones. Retainers are invoiced monthly, in advance. Established clients can ask for Net 30.',
  },
  {
    c: 'studio',
    q: 'Who owns the finished work?',
    a: 'You do. The finished assets and the prompts behind them are yours once the invoice is paid. Models trained on your products stay with hubStudio by default, and they’re never used for another client. If you want to own one, we quote a license case by case.',
  },
  {
    c: 'both',
    q: 'Can we start with the app and bring in the studio later?',
    a: 'Yes. You can make everyday work in the app and hand a launch to the studio, or the other way around. Send a brief whenever you want us to take a job on. If you’d rather we work inside your own workspace, say so in the brief.',
  },
];

const faqFilters: { key: 'all' | 'app' | 'studio'; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'app', label: 'The app' },
  { key: 'studio', label: 'The studio' },
];

const SITE = 'https://www.hubstudio.ai';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: `${SITE}/pricing` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="hubStudio pricing: the app and the studio"
  description="How you pay for hubStudio: a prepaid balance for the app, with the price shown before every run, and studio work quoted from your brief."
  preloadImage="/Images/pricing-hero.webp"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="hero__tag">Pricing</span>
        <h1 class="hero__display reveal">
          How you pay for the app and the <span class="accent">studio</span>.
        </h1>
        <p class="hero__lead">
          In the app, every run shows its price before you start it, and you
          pay from a prepaid balance. Studio work gets a written quote once
          we’ve read your brief. You won’t find a rate card on this page.
          Engine prices change with the settings you pick, and studio work
          changes with the brief.
        </p>

        <nav class="hero__picker" aria-label="On this page">
          {
            jumps.map((j) => (
              <a class="hero__picker-item" href={j.href}>
                <span class="hero__picker-dot" aria-hidden="true" />
                {j.label}
              </a>
            ))
          }
        </nav>

        <div class="hero__cta">
          <Button variant="primary" href={APP_SIGNUP} class="js-magnetic">Create your account</Button>
          <Button variant="secondary" href={BRIEF_URL} class="js-magnetic">Send a brief</Button>
        </div>
      </div>

      <figure class="hero__visual">
        <img
          src="/Images/pricing-hero.webp"
          alt="A hand poised with a fountain pen over the signature line of a typeset proposal on cream cardstock"
          class="js-parallax"
          data-speed="0.05"
          width="2000"
          height="1125"
          fetchpriority="high"
        />
        <span class="hero__visual-chip">Price shown before every run</span>
      </figure>
    </div>
  </section>

  <!-- ============================================================
       FACT STRIP (word-stats, no counters)
       ============================================================ -->
  <section class="stats" aria-label="The short version">
    <div class="container">
      <div class="stats__grid">
        <div class="stat-block">
          <span class="stat-block__word">Nothing</span>
          <span class="stat-block__label">Creating an account costs nothing</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__word">Upfront</span>
          <span class="stat-block__label">Every run shows its price before it starts</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__word">Never</span>
          <span class="stat-block__label">A failed run is never charged</span>
        </div>
        <div class="stat-block">
          <span class="stat-block__num">48h</span>
          <span class="stat-block__label">To a written studio proposal</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       THE APP: prepaid balance
       ============================================================ -->
  <section class="chapter chapter--light" id="app">
    <div class="container chapter__grid">
      <header class="chapter__head">
        <span class="chapter__tag">The app</span>
        <h2 class="chapter__display reveal">
          A prepaid balance, spent one <span class="accent">run</span> at a time.
        </h2>
        <p class="chapter__lead">
          A run is one job for the AI: an image, a clip, a post draft, or a
          rewritten prompt. You add money to a balance held in real currency,
          and each run is charged against it at the price shown before it
          starts. There’s no subscription and no seat fee, and the balance
          doesn’t expire.
        </p>
      </header>

      <figure class="chapter__photo js-tilt" data-tilt="5">
        <img
          src="/Images/app-desk.webp"
          alt="A small in-house team gathered at a laptop, working in hubStudio"
          loading="lazy"
          width="1600"
          height="1200"
        />
        <span class="chapter__photo-chip">Pay as you go</span>
      </figure>

      <div class="chapter__body">
        <div class="pillar-row">
          <article class="pillar">
            <h3 class="pillar__head"><span aria-hidden="true"></span>What costs money</h3>
            <ul class="pillar__list">
              {paid.map((it) => (
                <li>
                  <span class="pillar__list-k">{it.k}</span>
                  <span class="pillar__list-d">{it.d}</span>
                </li>
              ))}
            </ul>
            <p class="pillar__note">
              All of it shows up in the usage log, line by line, with the name
              of whoever ran it.
            </p>
          </article>

          <article class="pillar pillar--free">
            <h3 class="pillar__head"><span aria-hidden="true"></span>What costs nothing</h3>
            <ul class="pillar__free">
              {free.map((it) => <li>{it}</li>)}
            </ul>
            <p class="pillar__note">
              Posts sent to X through hubStudio are the exception. The price
              shows before you send.
            </p>
          </article>
        </div>
        <p class="asof">What’s charged and what’s free, as of September 2026.</p>

        <div class="team-grid">
          {teamCells.map((c) => (
            <article class="team-cell">
              <h3 class="team-cell__k">{c.k}</h3>
              <p class="team-cell__d">{c.d}</p>
            </article>
          ))}
        </div>

        <div class="chapter__cta">
          <Button variant="primary" href={APP_SIGNUP} class="js-magnetic">Create your account</Button>
          <a class="arrow-link" href={HELP_URL}>
            Read the app’s help center <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       INTERLUDE: how we price
       ============================================================ -->
  <section class="interlude">
    <div class="container">
      <blockquote class="interlude__quote">
        <p>
          You see the price of a run on the button before you press it. A
          studio job gets its price in writing, before anyone on our side
          starts work.
        </p>
        <cite class="interlude__cite">hubStudio, on how we price</cite>
      </blockquote>
    </div>
  </section>

  <!-- ============================================================
       THE STUDIO: asset-based, project-based, retainer
       ============================================================ -->
  <section class="chapter chapter--light" id="studio">
    <div class="container chapter__grid chapter__grid--reverse">
      <header class="chapter__head">
        <span class="chapter__tag">The studio</span>
        <h2 class="chapter__display reveal">
          Studio work, quoted from your <span class="accent">brief</span>.
        </h2>
        <p class="chapter__lead">
          Send us a brief and a producer reads it within one business day; the
          written proposal follows within 48 hours. Every job is led by a
          senior art director, with AIGC production underneath. We price the
          work in one of three ways, and you can move from one to another as
          your needs change.
        </p>
      </header>

      <figure class="chapter__photo js-tilt" data-tilt="-5">
        <img
          src="/Images/studio-brief.webp"
          alt="Hands annotating a printed creative brief with a pencil"
          loading="lazy"
          width="1600"
          height="1200"
        />
        <span class="chapter__photo-chip chapter__photo-chip--right">Senior art direction on every brief</span>
      </figure>

      <div class="chapter__body">
        <div class="models">
          {studioModels.map((m) => (
            <article class="model" id={m.id}>
              <span class="model__tag"><span aria-hidden="true"></span>{m.tag}</span>
              <h3 class="model__title">{m.title}</h3>
              <p class="model__body">{m.body}</p>
            </article>
          ))}
        </div>

        <div class="timeline" data-timeline>
          <h3 class="timeline__title">From brief to delivery</h3>
          <svg class="timeline__path" viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M40 40 C 220 0, 320 80, 500 40 S 780 0, 960 40" />
          </svg>
          <ol class="timeline__list">
            {projectTimeline.map((t) => (
              <li class="timeline__step">
                <span class="timeline__node">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={t.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="timeline__label">{t.label}</span>
                <span class="timeline__note">{t.note}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="drivers">
          <h3 class="drivers__title">What drives a quote</h3>
          <p class="drivers__text">
            A quote starts with scope: how many assets, in which formats. Then
            method, because some assets are shot, some are generated, and most
            mix both; we decide that asset by asset. A tight deadline changes
            the team we need. So does a model trained on your products. Last
            comes usage. Our quotes assume your owned and paid channels, and
            broadcast, large out-of-home campaigns, or a real person’s likeness
            in AI work are quoted separately.
          </p>
        </div>

        <div class="chapter__cta">
          <Button variant="primary" href={`${BRIEF_URL}?way=studio`} class="js-magnetic">Send a brief</Button>
          <Button variant="secondary" href="/studio" class="js-magnetic">Meet the studio</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STUDIO + APP: who pays for the runs (dark)
       ============================================================ -->
  <section class="chapter chapter--dark" id="studio-app">
    <div class="chapter__dark-bg" aria-hidden="true">
      <div class="chapter__dark-blob chapter__dark-blob--a"></div>
      <div class="chapter__dark-blob chapter__dark-blob--b"></div>
    </div>

    <div class="container chapter__grid">
      <header class="chapter__head">
        <span class="chapter__tag chapter__tag--on-dark">Studio + app</span>
        <h2 class="chapter__display chapter__display--on-dark reveal">
          When our studio works inside <span class="accent">hubStudio</span>.
        </h2>
        <p class="chapter__lead chapter__lead--on-dark">
          Our creatives can make your work in the app, and you review and
          approve it there. Who pays for the runs? That depends on whose
          workspace we use.
        </p>
      </header>

      <figure class="chapter__photo chapter__photo--dark">
        <img
          src="/Images/studio-on-app.webp"
          alt="A producer at a desk on a call, reviewing work on screen"
          loading="lazy"
          width="1600"
          height="1200"
        />
      </figure>

      <div class="chapter__body">
        <div class="ws-row">
          <article class="ws">
            <h3 class="ws__k">In our workspace</h3>
            <p class="ws__d">
              We create in our own hubStudio team and tag the work “Made for”
              your company. The runs come out of our workspace, and the studio
              fee in your proposal covers them. Your people get client logins
              and a Client space that shows only the finished work made for
              them. They download it, comment on it, and approve it or send it
              back in Validation. They never see prompts, engines, or costs,
              and they hold no balance.
            </p>
          </article>
          <article class="ws">
            <h3 class="ws__k">In your workspace</h3>
            <p class="ws__d">
              You add our creatives as members of your team. We create from
              your workspace and your balance, at the price shown before each
              run. Your proposal covers our team’s time. Your admins approve in
              Validation, and everything stays in your History and Assets
              Library when the project ends.
            </p>
          </article>
        </div>

        <p class="ws-note">
          Either way, every version stays on one approval thread, and nothing
          on it can be deleted. There’s no “order from the studio” button in
          the app. A studio job starts with a brief.
        </p>

        <div class="chapter__cta">
          <Button variant="primary" href={`${BRIEF_URL}?way=studio-app`} class="js-magnetic">Send a brief</Button>
          <Button variant="on-dark" href="/studio/with-the-app" class="js-magnetic">How Studio + app works</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       THREE WAYS TO WORK (shared band)
       ============================================================ -->
  <WaysToWork
    tone="cream"
    eyebrow="Three ways to work"
    pre="Pick how you want to "
    accent="work"
    post="."
    lead="Still deciding? The app and the studio are one company. Start with either one and move between them when the work changes."
  />

  <!-- ============================================================
       COMPARISON MATRIX
       ============================================================ -->
  <section class="matrix" id="compare">
    <div class="container">
      <header class="matrix__head">
        <span class="chapter__tag">Side by side</span>
        <h2 class="chapter__display reveal">
          The three ways, <span class="accent">compared</span>.
        </h2>
        <p class="section-note">
          The big differences are who makes the work and how you pay for it.
          Read across a row to compare.
        </p>
      </header>

      <div class="matrix__wrap">
        <table class="matrix__table">
          <thead>
            <tr>
              <th scope="col" class="matrix__th matrix__th--feature"><span class="sr-only">Question</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--orange">Use the app</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--navy">Studio + app</span></th>
              <th scope="col" class="matrix__th"><span class="matrix__th-chip matrix__th-chip--ink">Studio only</span></th>
            </tr>
          </thead>
          <tbody>
            {matrixRows.map((row) => (
              <tr class="matrix__row">
                <th scope="row" class="matrix__feature">{row.feature}</th>
                <td>{row.app}</td>
                <td>{row.both}</td>
                <td>{row.studio}</td>
              </tr>
            ))}
            <tr class="matrix__row matrix__row--cta">
              <th scope="row" class="matrix__feature">Start here</th>
              <td><a class="arrow-link" href={APP_SIGNUP} rel="noopener">Create your account <span aria-hidden="true">&rarr;</span></a></td>
              <td><a class="arrow-link" href={`${BRIEF_URL}?way=studio-app`}>Send a brief <span aria-hidden="true">&rarr;</span></a></td>
              <td><a class="arrow-link" href={`${BRIEF_URL}?way=studio`}>Send a brief <span aria-hidden="true">&rarr;</span></a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================================
