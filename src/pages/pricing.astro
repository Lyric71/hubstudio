  /* ----------------------------------------------------------------
     Comparison matrix
     ---------------------------------------------------------------- */
  .matrix {
    padding-block: clamp(72px, 9vw, 120px);
    background: var(--bg-white);
  }
  .matrix__head {
    margin-bottom: 56px;
    display: grid;
    gap: 18px;
  }
  .section-note {
    font-size: var(--type-body);
