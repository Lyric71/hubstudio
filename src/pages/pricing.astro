  .interlude__quote {
    max-width: 940px;
    margin: 0 auto;
    padding-left: clamp(20px, 3vw, 44px);
    border-left: 3px solid var(--brand-orange);
  }
  .interlude__quote p {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.24;
    font-size: clamp(24px, 3vw, 40px);
    color: var(--text-ink);
  }
  .interlude__cite {
    display: block;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* ----------------------------------------------------------------
     Comparison matrix
     ---------------------------------------------------------------- */
  .matrix {
    padding-block: clamp(72px, 9vw, 120px);
    background: var(--bg-white);
  }
  .matrix__head {
    margin-bottom: 56px;
    display: grid;
    gap: 18px;
  }
  .section-note {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 60ch;
    margin: 0;
  }
  .section-note a {
    color: var(--brand-orange);
    font-weight: 600;
  }
  .matrix__wrap {
    overflow-x: auto;
    border-radius: 28px;
    border: 1px solid var(--line-hairline);
    background: var(--bg-cream);
    box-shadow: 0 30px 80px rgba(10, 10, 20, 0.06);
  }
  .matrix__table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--type-body);
  }
  .matrix__th,
  .matrix__feature,
  .matrix__table td {
    padding: 22px 24px;
    text-align: left;
    vertical-align: top;
  }
  .matrix__th {
    background: #fff;
    border-bottom: 1px solid var(--line-hairline);
    font-weight: 500;
  }
  .matrix__th--feature {
    width: 20%;
  }
  .matrix__th-chip {
    display: inline-flex;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .matrix__th-chip--orange { background: var(--brand-orange); }
  .matrix__th-chip--navy { background: var(--brand-navy); }
  .matrix__th-chip--ink { background: var(--text-ink); }

  .matrix__feature {
    width: 20%;
    font-weight: 600;
    color: var(--text-ink);
    background: rgba(0, 0, 0, 0.015);
    font-size: var(--type-body);
  }
  .matrix__row {
    border-top: 1px solid var(--line-hairline);
    transition: background-color 200ms;
  }
  .matrix__row:hover {
    background: rgba(233, 78, 27, 0.04);
  }
  .matrix__row td {
    color: var(--text-mute);
    line-height: 1.6;
  }
  .matrix__row--cta td,
  .matrix__row--cta:hover {
    background: #fff;
  }

  /* ----------------------------------------------------------------
     FAQ
     ---------------------------------------------------------------- */
  .faq {
    padding-block: clamp(72px, 9vw, 120px);
    background: var(--bg-cream);
  }
  .faq__head {
    display: grid;
    gap: 18px;
    margin-bottom: 40px;
  }
  .faq__head .chapter__tag { justify-self: start; }
  .faq__updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .faq__filter {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line-hairline);
    margin-bottom: 8px;
  }
  .faq__filter-btn {
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    background: #fff;
    border: 1px solid var(--line-hairline);
    color: var(--text-ink);
    font-size: var(--type-button);
    font-weight: 500;
    cursor: pointer;
    transition: background-color 200ms, color 200ms, border-color 200ms, transform 200ms;
  }
  .faq__filter-btn:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  .faq__filter-btn[aria-pressed='true'] {
    background: var(--brand-orange);
    color: #fff;
    border-color: var(--brand-orange);
  }
  .faq__list {
    display: grid;
    gap: 4px;
  }
  .faq__item {
    border-bottom: 1px solid var(--line-hairline);
  }
  .faq__item[data-hide='true'] {
    display: none;
  }
  .faq__q {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 18px;
    padding-block: 22px;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__cat {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
    background: rgba(233, 78, 27, 0.1);
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  @media (max-width: 599px) {
    .faq__q { grid-template-columns: 1fr auto; }
    .faq__cat { grid-column: 1 / -1; }
  }
  .faq__q-text {
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--text-ink);
    line-height: 1.4;
  }
  .faq__chev {
    width: 16px;
    height: 16px;
    color: var(--text-mute);
    transition: transform 240ms ease-out;
    flex: none;
  }
  .faq__item[open] .faq__chev { transform: rotate(180deg); color: var(--brand-orange); }
  .faq__a {
    padding: 4px 0 24px;
    margin: 0;
    max-width: 72ch;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  @media (min-width: 600px) {
    .faq__a { margin-left: 114px; }
  }

  /* ----------------------------------------------------------------
     Reveal (shared)
     ---------------------------------------------------------------- */
  .reveal { opacity: 0; transform: translateY(24px); }
  .reveal.is-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 600ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
    .reveal,
    .timeline__step { opacity: 1; transform: none; }
    .timeline__path path { stroke-dashoffset: 0; }
  }
</style>

<script>
  /* ============================================================
     Pricing page: scroll-linked motion and interaction
     ============================================================ */

  // Reveal on scroll (headlines, timeline drawing)
  const reveals = document.querySelectorAll('.reveal, [data-timeline]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }

  // Parallax on the hero image
  const parallaxEls = document.querySelectorAll<HTMLElement>('.js-parallax');
  let parallaxRaf = 0;
  const onScrollParallax = () => {
    parallaxRaf = 0;
    const y = window.scrollY;
    parallaxEls.forEach((el) => {
      const speed = Number(el.dataset.speed || 0.2);
      el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
    });
  };
  if (parallaxEls.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!parallaxRaf) parallaxRaf = requestAnimationFrame(onScrollParallax);
      },
      { passive: true },
    );
  }

  // Gentle pointer tilt on chapter photos
  const tilters = document.querySelectorAll<HTMLElement>('.js-tilt');
  tilters.forEach((el) => {
    const max = Number(el.dataset.tilt || 5);
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      el.style.transform = `perspective(1200px) rotateY(${px * max}deg) rotateX(${-py * max}deg)`;
    });
    el.addEventListener('pointerleave', () => {
      el.style.transform = '';
    });
  });

  // Magnetic buttons
  const magnetic = document.querySelectorAll<HTMLElement>('.js-magnetic');
  magnetic.forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = e.clientX - r.left - r.width / 2;
      const y = e.clientY - r.top - r.height / 2;
      el.style.transform = `translate(${x * 0.18}px, ${y * 0.22}px)`;
    });
    el.addEventListener('pointerleave', () => {
      el.style.transform = '';
    });
  });

  // FAQ filter by offer. Questions about both offers show under either filter.
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.faq__filter-btn');
  const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq__item');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const filter = btn.dataset.filter;
      faqItems.forEach((item) => {
        const topic = item.dataset.topic;
        const hide = filter !== 'all' && topic !== 'both' && topic !== filter;
        item.dataset.hide = hide ? 'true' : 'false';
        if (hide) item.open = false;
      });
    });
  });

  // FAQ accordion: one open at a time
  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        faqItems.forEach((other) => {
          if (other !== item && other.dataset.hide !== 'true') other.open = false;
        });
      }
    });
  });

  // Smooth scroll for in-page links
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
