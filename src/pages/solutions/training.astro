---
/**
 * App Training  ·  /solutions/training
 *
 * Hands-on training exclusively on the hubStudio app for brand, agency,
 * retail, and manufacturing teams. Teaches operators and leads how to get the
 * best out of every AI model and engine available inside the app (Explore
 * image and video engines, text model picker, Model benchmarks, Improve with
 * AI, and reusable Skills), plus the full workflow across both pillars:
 * Creative assets and Social networks, with Validation and Assets Library.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import AppShot from '../../components/AppShot.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import { appShots } from '../../data/app-shots';
import type { AppShot as Shot } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL, HELP_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/solutions/training`;
const briefHref = `${BRIEF_URL}?way=studio-app`;

/* Calibration color bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Why train on the app. Card content carries no ordinal numerals. */
const reasons = [
  {
    label: 'The right model for each job',
    title: 'Know which AI engine to pick, and how to prompt it.',
    body: 'hubStudio gives your team image, video, and text models from OpenAI, Google, Black Forest Labs, ByteDance, Kling, Alibaba, xAI, MiniMax, and Meta in one place. No single model wins every brief. We teach your team how each engine behaves and when to switch.',
  },
  {
    label: 'Both pillars in one routine',
    title: 'From first prompt to edited asset to scheduled post.',
    body: 'Most courses stop at generating a picture. Because we train exclusively on the hubStudio app, your team learns the entire loop in one workspace: generating assets, cutting formats in the free editors, grouping campaigns, getting sign-off in Validation, and publishing to social networks.',
  },
  {
    label: 'Ready on Monday morning',
    title: 'Train inside the workspace your team keeps using.',
    body: 'Every participant works inside your live hubStudio team account during the session. By the time training ends, your roles, daily spending limits, Team skills, Assets Library folders, and social connections are already configured and tested.',
  },
];

/* Centerpiece: getting the best out of the AI models in the app. */
const modelTracks = [
  {
    eyebrow: 'Image engines · Explore',
    title: 'Pick the right image model for packshots, lifestyle, or type.',
    providers: 'OpenAI (ChatGPT Image) · Google (Imagen, Nano Banana) · Black Forest Labs (FLUX) · ByteDance (Seedream) · Alibaba (Wan) · xAI · Meta',
    body: 'Each image engine in Explore has a distinct strength. Some hold packaging typography and logos cleanly; others excel at natural skin, studio lighting, architectural depth, or fast ideation. We teach your team how to match the engine to the brief, feed up to four reference photos to lock product geometry or style, choose aspect ratio and resolution up to 4K, and weigh price per run before clicking Generate.',
    bullets: [
      'When to use FLUX, ChatGPT Image, Imagen, Nano Banana, or Seedream',
      'Using 1 to 4 reference images to keep products and framing consistent',
      'Writing engine-specific prompts vs. using “Improve with AI”',
      'Generating 1 to 10 variations and comparing cost before every run',
    ],
    shot: appShots.exploreCard,
    path: '/explore',
  },
  {
    eyebrow: 'Video engines · Explore',
    title: 'Direct motion, camera paths, and pacing across video models.',
    providers: 'Google (Veo) · Kling · ByteDance (Seedance) · Alibaba (Wan) · MiniMax (Hailuo)',
    body: 'Video models respond very differently to motion prompts. We train your team to generate an approved still frame first, then bring it into the Video studio as the starting frame so the product never morphs. Participants learn which engine handles camera pans, human motion, product turntables, or native audio best, and how to pick duration and aspect ratio for Reels, TikTok, Shorts, or widescreen.',
    bullets: [
      'Image-to-video from an approved packshot vs. pure text-to-video',
      'Prompting camera movement, lighting shifts, and subject action per engine',
      'Choosing between Veo, Kling, Seedance, Wan, and Hailuo by shot type',
      'Turning raw clips into captioned vertical cuts in the Video editor and Shorts',
    ],
    shot: appShots.videoStudio,
    path: '/content/video-generate',
  },
  {
    eyebrow: 'Text models, Benchmarks & Skills',
    title: 'Steer AI writing, prompt rewriting, and reusable brand rules.',
    providers: 'Quick, Balanced & Best text presets · Specific model picker · Model benchmarks · Skills Catalog & Team skills',
    body: 'Inside the app, text models power social post drafting, Re-purpose across networks, and “Improve with AI” prompt expansion. We show your team how to read the in-app Model benchmarks table to compare speed, quality, and cost across every text, image, and video model, when to switch between Quick, Balanced, and Best, and how to write Team skills so every AI model follows your brand voice and visual rules automatically.',
    bullets: [
      'Reading the in-app Model benchmarks to evaluate newly released models',
      'Picking Quick, Balanced, or Best (or a specific LLM) for post writing',
      'How “Improve with AI” combines your Team skills with the target engine’s rules',
      'Building My skills and Team skills from the Skills Catalog',
    ],
    shot: appShots.benchmarks,
    path: '/benchmarks',
  },
];

/* "For who" audiences. Repeated card block, no numerals per repo standard. */
const audiences = [
  {
    label: 'Brand & marketing teams',
    title: 'In-house marketers, designers, and social managers.',
    body: 'Teams that create daily visuals and run company social channels in-house. Leave knowing which model to pick, how to edit in the browser, and how to schedule a full campaign.',
  },
  {
    label: 'Agency crews',
    title: 'Creative, social, and account teams.',
    body: 'Agencies running multiple client brands in hubStudio. Learn how to switch Team skills per client, route deliverables through Validation, and share clean Client spaces.',
  },
  {
    label: 'Retail & e-commerce teams',
    title: 'Merchandising, catalog, and performance marketers.',
    body: 'Teams turning out high-volume SKU variants, seasonal promos, and daily Reels or TikToks on a tight calendar without waiting on reshoots.',
  },
  {
    label: 'Team admins & leads',
    title: 'Creative directors and workspace owners.',
    body: 'Leaders setting up governance in the app: roles, module permissions, daily spending limits on the prepaid balance, Team skills, and approval rules.',
  },
];

/* Four hands-on curriculum modules on the hubStudio app. */
type Lane = {
  label: string;
  heading: string;
  lead: string;
  body: string[];
  tags: string[];
  shot: Shot;
  path: string;
};

const lanes: Lane[] = [
  {
    label: 'Module · AI models & prompting in the app',
    heading: 'Master Explore, Model benchmarks, and prompt craft.',
    shot: appShots.exploreApp,
    path: '/explore',
    lead: 'How to choose, prompt, and combine the AI models inside hubStudio.',
    body: [
      'We start in Explore and Model benchmarks. Participants compare the live roster of image, video, and text models side by side, learning what each model is built for, what it costs per run, and how its prompt syntax differs.',
      'Then we practice hands-on prompting on your own products and campaigns: writing structured prompts, feeding reference images, using “Improve with AI” to tailor prompts to the chosen engine, and troubleshooting common model artifacts.',
    ],
    tags: [
      'Explore engine gallery', 'Model benchmarks',
      'Image model selection', 'Video model selection',
      'Quick / Balanced / Best text models', 'Reference image workflows',
      'Improve with AI', 'Cost vs. quality per run',
    ],
  },
  {
    label: 'Module · Pillar: Creative assets',
    heading: 'Generate, retouch, crop, and cut in the browser.',
    shot: appShots.editorSocial,
    path: '/editor',
    lead: 'Turn raw model outputs into finished images and vertical video that ship.',
    body: [
      'In the Image studio and Video studio, cohorts generate high-resolution product shots, lifestyle scenes, and short video clips from still frames. Every render is automatically logged in History with its exact prompt and engine so any winning look can be reproduced.',
      'Next, participants move into the free in-browser Image editor, Video editor, and Shorts autopilot: cropping to network safe zones (Instagram 4:5, Stories/Reels 9:16, LinkedIn 1.91:1), adding logos and text layers, sequencing multi-clip timelines, and styling word-by-word captions.',
    ],
    tags: [
      'Image studio up to 4K', 'Video studio from first frame',
      'Free Image editor', 'Social safe-zone overlays',
      'Free Video editor', 'Shorts autopilot & captions',
      'History & prompt reuse', 'Assets Library folders & tags',
    ],
  },
  {
    label: 'Module · Pillar: Social networks & campaigns',
    heading: 'Draft, repurpose, validate, and publish across channels.',
    shot: appShots.campaignPost,
    path: '/campaigns',
    lead: 'Run your entire social calendar from the same workspace where assets are made.',
    body: [
      'Cohorts build a live Campaign in the app, grouping visuals, videos, briefs, and posts on one page. Participants connect social accounts and draft posts for Instagram, Facebook, TikTok (Beta), LinkedIn, X, and YouTube with a live side-by-side preview for each network.',
      'We train the team to use “Draft with AI” and “Re-purpose” so one post is adapted for every other network’s tone and character limit, schedule posts to up to 20 accounts at once, and configure the Social publishing watcher agent to monitor the calendar.',
    ],
    tags: [
      'Campaigns workspace', 'Instagram, Facebook & TikTok',
      'LinkedIn, X & YouTube', 'Draft with AI',
      'Re-purpose across networks', 'Multi-account scheduling',
      'Social publishing watcher', 'Live network previews',
    ],
  },
  {
    label: 'Module · Skills, governance & Validation',
    heading: 'Lock your brand rules and approval chain into the app.',
    shot: appShots.skillsCatalog,
    path: '/skills/catalog',
    lead: 'Make sure every teammate and every AI model follows the same house rules.',
    body: [
      'Starting from the Skills Catalog, we help your cohort write My skills and Team skills: framing rules for product photos, lighting and color preferences, forbidden words, and tone of voice per social channel. Once saved, those skills steer every prompt rewrite and social draft across the workspace.',
      'Finally, we run a full approval cycle in Validation: sending assets and scheduled posts to teammates or clients, reviewing versions on one permanent thread, and configuring Admin, Creator, Viewer, and Client roles with daily spending limits.',
    ],
    tags: [
      'Skills Catalog', 'My skills & Team skills',
      'Brand voice & framing rules', 'Validation threads',
      'Locked posts until sign-off', 'Roles & daily spend limits',
      'Client spaces', 'Audit trail in History',
    ],
  },
];

/* The setup a cohort leaves with when it trains on the hubStudio app. */
const onApp = [
  {
    title: 'Accounts, roles, and daily limits',
    body: 'Everyone works in your live team workspace with the right role: Admin, Creator, Viewer, or Client. Admins learn how to switch modules on or off per person and set daily spending limits on the shared prepaid balance.',
  },
  {
    title: 'Your Team skills written and tested',
    body: 'Your brand’s visual and writing rules are built as Team skills during the session, so “Improve with AI” and every social post drafted with AI follow them from day one.',
  },
  {
    title: 'A live campaign and approval flow',
    body: 'Your team builds a real Campaign, routes assets and social posts through Validation, and leaves with organized folders in the Assets Library ready for the next brief.',
  },
];

const faqs: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'Do you teach generic external AI tools, or only the hubStudio app?',
    a: 'We offer training exclusively on the hubStudio app. Because hubStudio already brings together the leading image, video, and text models alongside editors, Skills, Validation, and social publishing, your team learns one cohesive production environment rather than a patchwork of disconnected tools.',
  },
  {
    q: 'Will our team learn how to choose and use the different AI models in the app?',
    a: 'Yes, that is a centerpiece of the training. We cover the image and video engines in Explore (across OpenAI, Google, Black Forest Labs, ByteDance, Kling, Alibaba, xAI, MiniMax, and Meta) as well as the text model picker and the in-app Model benchmarks. Your team learns which model fits each creative or social job, how to prompt each one, and how to use reference images and Team skills for consistent results.',
  },
  {
    q: 'Does the training cover both creative assets and social networks?',
    a: 'Yes. Every program covers both pillars of the app: generating and editing images and video on one side, and grouping campaigns, drafting, repurposing, validating, and scheduling posts across social networks on the other. We weight the agenda toward whichever pillar your team uses most.',
  },
  {
    q: 'Can you customize the training around our brand and industry?',
    a: 'Yes. Before the session, we review your brand guidelines, product category, and social channels. During the workshop, participants practice on your actual products, write Team skills tuned to your brand voice, and build real campaign assets they can publish.',
  },
  {
    q: 'What technical prerequisites do participants need?',
    a: 'None. Everything runs in the browser inside the hubStudio app. Marketers, copywriters, social managers, art directors, and designers can all participate in the same cohort without installing anything or managing GPUs.',
  },
  {
    q: 'What is the difference between App Training and the Onboarding package?',
    a: 'Our Onboarding package is a focused 2-hour live setup and training session for 500 USD (with 250 USD credited directly to your team’s prepaid balance). Full App Training is a deeper half-day, full-day, or multi-session program for teams that want hands-on workshops across every AI model, editor, campaign workflow, and approval step.',
    link: { label: 'See the Onboarding package', href: '/services/onboarding' },
  },
  {
    q: 'Where does the training take place, and in what languages?',
    a: 'Training runs either live online with your team or in person at our Shanghai studio, or on-site at your offices on request. Sessions are delivered in English, French, or Mandarin Chinese, matching the three languages of the hubStudio app.',
  },
  {
    q: 'How is training priced?',
    a: 'Full training cohorts are scoped to your team size and agenda and quoted within 48 hours of your brief. If you just want a fast live setup and starter training, the fixed-price Onboarding session is 500 USD with 250 USD added to your wallet.',
  },
  {
    q: 'Do you also offer broader workflow and governance consulting?',
    a: 'Yes. If you want us to audit your current production process, design a multi-market approval chain, and run a staged rollout across departments, see our AI consulting practice.',
    link: { label: 'See AI consulting', href: '/solutions/consulting' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'App training', item: pageUrl },
  ],
};
---

<Layout
  title="hubStudio App Training: Master the AI Models & Workflows | hubStudio"
  description="Hands-on training on the hubStudio app. Learn how to get the best out of every image, video, and text AI model in the app, build creative assets, and run social campaigns."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> App training
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Train your team</span></span>
            <span class="line"><span class="line__i">on the hubStudio</span></span>
            <span class="line"><span class="line__i serif">app.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Every AI model in the app, and the workflow that makes them <em>ship</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We train exclusively on the hubStudio app. Your team learns on
              the exact workspace it will use every week: how to choose and
              prompt the right AI model for each job, finish images and video
              in the browser editors, and run campaigns across your social
              networks.
            </p>
            <p>
              Taught by the senior art directors, AI specialists, and social
              strategists who produce client work inside hubStudio every day.
              Your team leaves with its workspace configured, its Team skills
              written, and real campaign work ready to publish.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={briefHref}>Start a training brief</Button>
            <a class="ghost-link ghost-link--light" href="#models">
              How we teach the AI models
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            100% on the hubStudio app <span>/</span> AI models, assets & social <span>/</span> English, French & Mandarin
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/training-hero.jpg"
          alt="A late-afternoon hubStudio workshop floor with a senior trainer at a whiteboard and four participants at calibrated workstations reviewing AIGC frames."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">App training <span>/</span> Live online or Shanghai studio</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why train on the app</p>
            <h2 class="dh r" style="--d:.05s">
              Access to models is easy.<br />Knowing how to <span class="serif">drive</span> them is the craft.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Opening an account gives your team dozens of AI engines and
            publishing tools in one browser tab. Training turns that access
            into a repeatable weekly habit across creative assets and social
            channels.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S2b · GETTING THE BEST OUT OF THE AI MODELS ============ -->
    <section class="models" id="models">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>AI models in the app</p>
            <h2 class="dh r" style="--d:.05s">
              Get the best out of every<br />AI model in <span class="serif">hubStudio</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Through the app, your team can run image, video, and text models
            from nine leading providers. We teach your people how to pick the
            right engine for the job, feed it the right inputs, and keep quality
            high without wasting balance.
          </p>
        </header>

        <div class="mtracks">
          {
            modelTracks.map((m, i) => (
              <article class={`mtrack ${i % 2 === 1 ? 'mtrack--rev' : ''}`}>
                <div class="mtrack__media r">
                  <AppShot shot={m.shot} path={m.path} caption />
                </div>
                <div class="mtrack__body">
                  <p class="kicker r"><span class="kicker__tick"></span>{m.eyebrow}</p>
                  <h3 class="dh dh--sm r" style="--d:.05s">{m.title}</h3>
                  <p class="mtrack__prov r" style="--d:.08s">{m.providers}</p>
                  <p class="mtrack__p r" style="--d:.12s">{m.body}</p>
                  <ul class="mtrack__list r" style="--d:.16s">
                    {m.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S3 · FOR WHO ============ -->
    <section class="audience">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>For whom</p>
          <h2 class="dh r" style="--d:.05s">
            Built for the people who <span class="serif">create</span>,<br />publish, and approve in the app.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Each session is shaped to the roles in the room, whether your team
            focuses on visual production, social calendars, or workspace
            governance.
          </p>
        </header>

        <div class="aud-grid">
          {
            audiences.map((a, i) => (
              <article class="aud r" style={`--d:${i * 0.06}s`}>
                <p class="aud__label">
                  <span class="aud__tick"></span>
                  {a.label}
                </p>
                <h3 class="aud__title">{a.title}</h3>
                <p class="aud__body">{a.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S4 · CURRICULUM MODULES ============ -->
    <section class="cover" id="curriculum">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What you will learn</p>
          <h2 class="dh r" style="--d:.05s">
            Four modules inside the <span class="serif">app</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Every module runs live inside hubStudio on your own briefs. Run the
            full program across a day or two, or pick the modules your team
            needs right now.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <div class="feature__media r">
                <AppShot shot={c.shot} path={c.path} caption />
              </div>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__lead r" style="--d:.1s">{c.lead}</p>
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4b · LEAVE WITH A WORKING SETUP ============ -->
    <section class="onapp" id="on-the-app">
      <div class="shell onapp__grid">
        <div class="onapp__copy">
          <p class="kicker r"><span class="kicker__tick"></span>Your workspace, ready</p>
          <h2 class="dh r" style="--d:.05s">
            Leave with a working <span class="serif">setup</span>.
          </h2>
          <p class="onapp__lead r" style="--d:.1s">
            After most courses, someone still has to go back to their desk and
            configure everything alone. Because we train directly inside your
            hubStudio workspace, we build that setup during the session with
            your team at the keyboard.
          </p>
          <ul class="onapp__list">
            {
              onApp.map((item, i) => (
                <li class="onapp__item r" style={`--d:${0.16 + i * 0.06}s`}>
                  <h3 class="onapp__title">{item.title}</h3>
                  <p class="onapp__p">{item.body}</p>
                </li>
              ))
            }
          </ul>
          <p class="onapp__p r" style="--d:.34s">
            Want a fast 2-hour live setup and starter training first? See our
            <a class="inline-link" href="/services/onboarding">Onboarding package</a> (500 USD, with 250 USD credited back to your team’s wallet). Or for full multi-team governance and rollout, <a class="inline-link" href="/solutions/consulting">see AI consulting</a>.
          </p>
        </div>
        <div class="onapp__media">
          <div class="r" style="--d:.1s">
            <AppShot shot={appShots.modelPicker} path="/social/linkedin/posts" caption />
          </div>
          <div class="onapp__cta r" style="--d:.2s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
            <a class="ghost-link" href={HELP_URL}>
              Read the help center
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="onapp__note r" style="--d:.24s">
            Creating an account costs nothing. The app and training run in English, French, and Chinese.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S5 · TRAINERS ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/training-trainers.jpg"
                alt="A senior hubStudio trainer reviewing an AI generation workflow on a large monitor with a cohort participant, warm afternoon light through a Shanghai studio window."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">Senior leads</span>
            <span class="source__stat-cap">Art directors, AI specialists & social leads</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Who teaches</p>
          <h2 class="dh r" style="--d:.05s">
            Taught by the people who build<br />and run the <span class="serif">app</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Your trainers are the senior creative directors, AI specialists,
            and social strategists who use hubStudio every day on live client
            campaigns. hubStudio was founded by Cyril Drouin, former CEO at
            Publicis.
          </p>
          <p class="source__p r" style="--d:.16s">
            When a new image, video, or text model lands in Explore, our team
            benchmarks it on real client briefs that same week. We bring those
            exact findings into your training session: where the model shines,
            where it breaks, and the prompt patterns that get consistent output.
          </p>
          <p class="source__p r" style="--d:.22s">
            Every cohort is tailored to your category, whether beauty, luxury,
            automotive, retail, food and beverage, or industrial manufacturing,
            and to the social channels your team actually publishes on.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Senior leads only
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              English, French & Mandarin
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Tailored to your brand
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Live online or Shanghai studio
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ S5b · WAYS TO WORK ============ -->
    <WaysToWork tone="white" highlight="app" />

    <!-- ============ S6 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">session</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions teams ask before booking app training. If yours is
            not below, put it in the brief.
          </p>
          <p class="faq__fresh r" style="--d:.13s">Updated October 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={briefHref}>Start a training brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.a}
                      {faq.link && (
                        <>
                          {' '}
                          <a class="inline-link" href={faq.link.href}>{faq.link.label}</a>.
                        </>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S7 · CLOSING ============ -->
    <DualCta
      eyebrow="Next cohort"
      pre="Train your team on the "
      accent="app"
      post="."
      text="Send your team size, the channels you publish on, and the skills you want to build. A producer reads your brief within one business day and replies with a tailored agenda. Or open the app and explore the models first."
      lead="studio"
      briefQuery="way=studio-app"
    />
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
    display: grid;
    gap: 18px;
  }
  .band--split {
    max-width: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .band--split {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 18px 60px;
    }
    .band--split > div {
      display: grid;
      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .band__note--light {
    color: rgba(240, 237, 233, 0.76);
  }

  /* Calibration color bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }

  /* ===================== S1 · Hero ===================== */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__panel {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px);
    overflow: clip;
  }
  .hero__reg {
    position: absolute;
    width: clamp(240px, 28vw, 420px);
    right: -12%;
    bottom: -14%;
    color: rgba(240, 237, 233, 0.055);
    pointer-events: none;
  }
  .hero__panel-in {
    position: relative;
    width: 100%;
    max-width: 600px;
  }
  .hero__title {
    margin-top: 24px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(40px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding: 0.22em 0.14em;
    margin: -0.22em -0.14em;
  }
  .hero__title .line__i {
    display: block;
    transform: translateY(145%);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero__title .line:nth-child(1) .line__i {
    transition-delay: 0.12s;
  }
  .hero__title .line:nth-child(2) .line__i {
    transition-delay: 0.22s;
  }
  .hero__title .line:nth-child(3) .line__i {
    transition-delay: 0.32s;
  }
  .hero.in .hero__title .line__i {
    transform: translateY(0);
  }
  .hero__title .serif {
    font-size: 1.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line__i {
      transform: none;
    }
  }
  .hero__tag {
    margin-top: 26px;
    font-size: clamp(18px, 1.5vw, 23px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__tag em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .hero__lead {
    margin-top: 20px;
    display: grid;
    gap: 13px;
    max-width: 48ch;
  }
  .hero__lead p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.74);
  }
  .hero__cta {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero__meta {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1.5px dashed rgba(240, 237, 233, 0.2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
  }
  .hero__meta span {
    color: var(--brand-orange);
  }
  .hero__visual {
    position: relative;
    overflow: hidden;
    min-height: 58vh;
  }
  @media (min-width: 900px) {
    .hero__visual {
      min-height: auto;
    }
  }
  .hero__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero.in .hero__visual img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual img {
      transform: none;
    }
  }
  .hero__chip {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.78);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }
  .hero__chip span {
    color: var(--brand-orange);
  }

  /* ===================== S2 · Why ===================== */
  .why {
    background: var(--ink);
    color: var(--text-on-dark);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .reasons {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 820px) {
    .reasons {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  .reason {
    padding-top: 26px;
    border-top: 1.5px solid rgba(240, 237, 233, 0.18);
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .reason__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .reason__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .reason__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--text-on-dark);
  }
  .reason__body {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.74);
  }

  /* ===================== S2b · AI Models in the App ===================== */
  .models {
    background: #ffffff;
    padding-block: clamp(80px, 10vw, 150px);
  }
  .mtracks {
    display: grid;
  }
  .mtrack {
    display: grid;
    gap: 36px;
    align-items: center;
    padding-block: clamp(40px, 5vw, 68px);
    border-top: 1.5px dashed var(--line-strong);
  }
  .mtrack:last-child {
    border-bottom: 1.5px dashed var(--line-strong);
  }
  @media (min-width: 940px) {
    .mtrack {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }
    .mtrack--rev {
      grid-template-columns: 0.95fr 1.05fr;
    }
    .mtrack--rev .mtrack__media {
      order: 2;
    }
  }
  .mtrack__body .dh {
    margin-top: 14px;
  }
  .mtrack__prov {
    margin-top: 14px;
    padding: 10px 14px;
    background: var(--paper);
    border-left: 2.5px solid var(--brand-orange);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.55;
    letter-spacing: 0.04em;
    color: var(--text-ink);
  }
  .mtrack__p {
    margin-top: 16px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .mtrack__list {
    margin-top: 18px;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--text-ink);
  }
  .mtrack__list li::marker {
    color: var(--brand-orange);
  }

  /* ===================== S3 · Audience ===================== */
  .audience {
    background: var(--paper);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .aud-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 720px) {
    .aud-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
  }
  @media (min-width: 1080px) {
    .aud-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  .aud {
    padding: 26px 22px 30px;
    background: #fff;
    border: 1px solid var(--line-hairline);
    border-radius: 6px;
    display: grid;
    gap: 14px;
    align-content: start;
    transition: border-color 0.18s ease, transform 0.24s ease;
  }
  .aud:hover {
    border-color: var(--brand-orange);
    transform: translateY(-2px);
  }
  .aud__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .aud__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .aud__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(19px, 1.5vw, 22px);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--text-ink);
  }
  .aud__body {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }

  /* ===================== S4 · Curriculum lanes ===================== */
  .cover {
    background: var(--paper-2);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .feature {
    display: grid;
    gap: 36px;
    align-items: center;
    padding-block: clamp(40px, 5vw, 72px);
    border-top: 1.5px dashed var(--line-strong);
  }
  .feature:last-child {
    border-bottom: 1.5px dashed var(--line-strong);
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }
    .feature--rev {
      grid-template-columns: 0.95fr 1.05fr;
    }
    .feature--rev .feature__media {
      order: 2;
    }
  }
  .feature__idx {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .feature__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .feature__body .dh {
    margin-top: 16px;
  }
  .feature__lead {
    margin-top: 14px;
    font-size: var(--type-lead);
    line-height: 1.42;
    color: var(--text-ink);
    font-weight: 500;
  }
  .feature__p {
    margin-top: 14px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .feature__scope {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .chips {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 500;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .chip:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
  }

  /* ===================== S5 · Trainers ===================== */
  .source {
