---
/**
 * AIGC Training  ·  /solutions/training
 *
 * Professional AIGC training for marketing teams and agencies, drawn from
 * the existing /professional-aigc-training-course-ai-content-creation-for-brands/
 * page. Shares the print-shop typographic frame, calibration bars and
 * editorial display headings used across the solutions pages.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Why training matters. Card content carries no ordinal numerals; the
   heading and visual order do the sequencing. */
const reasons = [
  {
    label: 'Beyond basic prompting',
    title: 'Past the prompt-syntax demo, into the production muscle.',
    body: "Most courses stop at typing a prompt. We teach the surrounding discipline: brief, generate, judge, retouch, brand-check, ship. The skill that compounds is the workflow around the tool, not the tool itself.",
  },
  {
    label: 'Competitive advantage',
    title: 'Move at the pace of brands already pulling ahead.',
    body: 'The teams compounding their output through AIGC are not the ones with the biggest stack. They are the ones with the trained operators. Train inside an active studio and your team ships campaign-grade work the week after class.',
  },
  {
    label: 'Future-proof skills',
    title: 'Skills the next model release does not break.',
    body: 'Models change every quarter. The underlying craft does not. The curriculum builds the visual judgement, prompt engineering and workflow architecture that survive each new release rather than getting rebuilt by it.',
  },
];

/* "For who" audiences. Repeated card block, no numerals per repo standard. */
const audiences = [
  {
    label: 'Brand professionals',
    title: 'In-house brand and content teams.',
    body: 'Marketing, brand and content leads who commission AIGC work and own the output. Leave the cohort with the literacy to brief, review and approve.',
  },
  {
    label: 'Agency teams',
    title: 'Creative, account and production crews.',
    body: 'Agencies adopting AIGC inside live client workflows. The training fits around an existing approval chain rather than replacing it.',
  },
  {
    label: 'Creative directors',
    title: 'Design and creative leadership.',
    body: 'Directors building an AI-fluent studio without losing the brand voice. The course foregrounds craft, judgement and the editorial pass models still skip.',
  },
  {
    label: 'Procurement & operations',
    title: 'Policy, vendor and cost owners.',
    body: 'Procurement, operations and finance teams writing the AIGC policy, picking vendors and setting the cost model. Built to give the non-creative side a real working knowledge.',
  },
];

/* Two curriculum lanes. Each carries a lead, body and a tag list of the
   underlying topics. The tag list replaces numbered sub-headings, satisfying
   the no-numbers rule while preserving the substance. */
const lanes = [
  {
    label: 'AIGC for beginners',
    heading: 'AIGC for beginners.',
    image: '/Images/training-beginner.jpg',
    alt: 'A daylit hubStudio workshop with a participant generating brand visuals on a colour-calibrated monitor, a printed brief on the desk beside the keyboard.',
    lead: 'Two days inside the studio. Real tools, real briefs, work that ships.',
    body: [
      "Fundamentals first: an intuition for diffusion models, prompt engineering, parameter optimisation, brand-safety guardrails and the legal frameworks every team now has to work inside. The theory is short, the workshop is long.",
      'Then the tool tour: MidJourney, Gemini, ChatGPT-4o, Flux, Wan and Veo, with three real brand-case workshops running alongside. The cohort leaves with a motion module, a starter prompt library tuned to their brand voice and a portfolio of pieces they generated themselves.',
    ],
    tags: [
      'Diffusion fundamentals', 'Prompt engineering',
      'Parameter optimisation', 'Brand-safety guardrails',
      'Legal frameworks',
      'MidJourney / Gemini / ChatGPT-4o',
      'Flux / Wan / Veo',
      'Three brand-case workshops', 'Motion module',
      'Prompt library starter',
    ],
  },
  {
    label: 'Advanced AIGC',
    heading: 'Advanced AIGC.',
    image: '/Images/training-advanced.jpg',
    alt: 'A dim, daylit advanced-training workstation with a ComfyUI node graph on one monitor and a high-resolution render preview on the other.',
    lead: 'ComfyUI, ControlNet and Stable Diffusion treated as a production stack.',
    body: [
      'Node-based logic, sampling techniques, AnimateDiff for motion and high-resolution processing pipelines. The curriculum is the workflow itself, taught by the engineers who built and run hubStudio production every week.',
      'Then the enterprise layer: character consistency at scale, scalable asset production, brand-voice fine-tuning, export optimisation and the integration patterns that connect AIGC into existing creative software, asset management and approval chains. Built for teams already shipping content and ready to industrialise it.',
    ],
    tags: [
      'ComfyUI', 'ControlNet', 'Stable Diffusion',
      'AnimateDiff', 'Sampling techniques',
      'Node-based workflows', 'High-resolution processing',
      'Character consistency', 'Scalable asset production',
      'Brand-voice fine-tuning', 'Workflow integration',
      'Quality control',
    ],
  },
];

/* FAQ: phrasing held close to the source page, restructured for the repo
   standard (no em-dashes, native phrasing). */
const faqs = [
  {
    q: 'Can you customise the AIGC training for our specific industry?',
    a: 'Yes. The curriculum is shaped by sector: beauty, automotive, luxury, food and beverage, technology, with industry-specific case studies and a preliminary consultation that aligns the cohort with the work your team actually ships.',
  },
  {
    q: 'What technical prerequisites do participants need?',
    a: 'None. No advanced background is required, though basic familiarity with design software helps. The advanced module benefits from creative-workflow experience but is not gated on it.',
  },
  {
    q: 'Can we focus on specific aspects of AIGC rather than the full curriculum?',
    a: 'Yes. Customised half-day and full-day sessions dive deep on the topics most relevant to your immediate needs and strategic goals. Most clients run a focused first cohort, then expand.',
  },
  {
    q: 'Do you offer post-training support for our team?',
    a: 'Thirty days of post-training support is included on every corporate program: trainer access for technical questions, implementation guidance and prompt-library refinement. Extended packages run quarterly or annually.',
  },
  {
    q: 'Can you deliver training at our company offices?',
    a: 'The default is on-premise at the Shanghai studio, with the high-performance workstations, GPU acceleration and licensed software the curriculum needs. On-site delivery at your offices is available on request, subject to hardware and software validation.',
  },
  {
    q: "What's the difference between the Beginner and Advanced modules?",
    a: 'The beginner module covers popular tools and prompt engineering for everyday content production. The advanced module covers ComfyUI workflows, ControlNet and the enterprise production pipelines a studio runs at scale. Both together give the full stack; either alone is useful in isolation.',
  },
  {
    q: 'How long are the training sessions and can they be shortened?',
    a: 'Sessions are designed as four-hour or eight-hour intensives, with a 30% theory and 70% practical split. Shorter overview sessions are possible for executive briefings.',
  },
  {
    q: 'What languages is the training available in?',
    a: 'English and Mandarin Chinese. The trainer team is international, with cultural perspectives baked into the case studies rather than treated as a translation step.',
  },
  {
    q: 'What will participants take away from the training?',
    a: 'A portfolio of brand-aligned visual content they generated themselves, documented workflows ready for ongoing implementation, a reusable prompt library tuned to the brand, technical troubleshooting capabilities and the strategic context to brief future AIGC work.',
  },
  {
    q: 'Do you offer consulting services beyond training?',
    a: 'Yes. AIGC implementation consulting covers content audits, workflow optimisation, tool selection, brand-safety protocols and ongoing creative direction. Many clients start with a training cohort and continue with a consulting engagement on the studio side.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Professional AIGC Training Course | AI Content Creation for Brands | hubStudio"
  description="Professional AIGC training for marketing teams and agencies. Master AI content creation tools with expert-led courses and hands-on workshops at hubStudio."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Training
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Master the future</span></span>
            <span class="line"><span class="line__i">of creative</span></span>
            <span class="line"><span class="line__i serif">intelligence.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Transform your brand's content production with cutting-edge AI
            technologies and human creativity, <em>working in concert</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most AI training stops at prompt syntax. The teams pulling ahead
              learn the whole loop: tooling, judgement, brand safety and the
              production pipeline that turns a generated frame into a campaign
              asset.
            </p>
            <p>
              We train inside an active content studio, so the curriculum is
              the workflow we run every week. Cohorts leave with a portfolio
              of pieces they generated, the prompt library to repeat them and
              the workflow architecture to scale.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start a training brief</Button>
            <a class="ghost-link ghost-link--light" href="#curriculum">
              See the curriculum
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> English & Mandarin, on-site cohorts
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/training-hero.jpg"
          alt="A late-afternoon hubStudio workshop floor with a senior trainer at a whiteboard and four participants at calibrated workstations reviewing AIGC frames."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Training floor</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why train</p>
            <h2 class="dh r" style="--d:.05s">
              Why AI generated<br />content <span class="serif">training</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            The buy-a-tool reflex stops at the demo. The brands compounding
            real content output have trained operators inside the workflow,
            and the training itself is what gets them there.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S3 · FOR WHO ============ -->
    <section class="audience">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>For whom</p>
          <h2 class="dh r" style="--d:.05s">
            Built for the people who <span class="serif">commission</span>,<br />approve and run the work.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Four audiences, one curriculum. Each cohort is shaped to the
            role mix in the room, so the work tracks the way your team
            actually operates.
          </p>
        </header>

        <div class="aud-grid">
          {
            audiences.map((a, i) => (
              <article class="aud r" style={`--d:${i * 0.06}s`}>
                <p class="aud__label">
                  <span class="aud__tick"></span>
                  {a.label}
                </p>
                <h3 class="aud__title">{a.title}</h3>
                <p class="aud__body">{a.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S4 · CURRICULUM LANES ============ -->
    <section class="cover" id="curriculum">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What you will learn</p>
          <h2 class="dh r" style="--d:.05s">
            Two modules, one <span class="serif">studio</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Beginner builds fluency, advanced builds production capability.
            Most teams run both back to back; some pick the module that
            matches their current stage and grow into the other.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  Curriculum module
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S5 · TRAINERS ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/training-trainers.jpg"
                alt="A senior hubStudio trainer reviewing a ComfyUI workflow on a large monitor with a cohort participant, warm afternoon light through a Shanghai studio window."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">Senior leads</span>
            <span class="source__stat-cap">Creative directors and AIGC engineers, no juniors</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Who teaches</p>
          <h2 class="dh r" style="--d:.05s">
            Elite creative and<br />technical <span class="serif">experts</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Former CEOs and creative directors from Publicis Commerce paired
            with the AIGC engineers who run hubStudio's production stack.
            Trainers who have shipped both sides of the table.
          </p>
          <p class="source__p r" style="--d:.16s">
            Years of brand and campaign work for global accounts, plus the
            current studio practice of generating, fine-tuning and deploying
            models for clients every week. The course material is whatever
            shipped that morning, not last year's deck.
          </p>
          <p class="source__p r" style="--d:.22s">
            The curriculum is customisable for beauty, automotive, luxury,
            food and beverage, technology. A preliminary consultation aligns
            the cohort with your category, your toolchain and the formats you
            already ship to.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Senior leads only
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              English & Mandarin
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Customised by industry
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Shanghai studio
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ S6 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">cohort</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions teams ask before a cohort starts. If yours is not
            below, put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start a training brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S7 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Train with us</p>
        <h2 class="end__title r" style="--d:.05s">
          Train with<br /><span class="serif">us</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send a roster, a desired window or just the gap you want to close.
          A senior lead reads it inside two working days and replies with a
          curriculum, format and outcome plan, plus an honest read on whether
          training, consulting or production is the right starting line.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start a training brief</Button>
          <a class="ghost-link ghost-link--light" href="/the-studio">
            See the studio
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
