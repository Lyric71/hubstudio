---
/**
 * AIGC Content Creation  ·  /solutions/ai-production/content
 *
 * AI copywriting and content production at studio scale, with human
 * strategists running every brief. Drawn from the source page's
 * strategy-first framing and the three content categories the studio
 * actually ships.
 *
 * Repositioned for the two offers: the studio writes the copy; the
 * customer's own team can draft social posts, and only social posts, in the
 * hubStudio app ("Draft with AI" per network, Skills). Copy deck: scratchpad
 * cq/aiprod-content/final.md.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import AppShot from '../../../components/AppShot.astro';
import WaysToWork from '../../../components/WaysToWork.astro';
import DualCta from '../../../components/DualCta.astro';
import { appShots } from '../../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL, HELP_URL } from '../../../lib/links';

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/solutions/ai-production/content`;
const briefHref = `${BRIEF_URL}?way=studio`;

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Infinite iterations',
    title: 'Test messaging angles without burning writer bandwidth.',
    body: 'Run a dozen tones, formats and angles before the campaign goes live. The first version is no longer the only version the team can afford. Iteration becomes a strategy lever rather than a budget item.',
  },
  {
    label: 'Speed without sacrifice',
    title: 'Launch campaigns at the pace of culture, not the calendar.',
    body: 'Fill content calendars, respond to market moments and ship new variants in days, not weeks. The bottleneck moves from production to strategy, which is where it belonged in the first place.',
  },
  {
    label: 'Personalized at scale',
    title: 'Different personas, markets and journey stages, same voice.',
    body: 'Variants for persona, channel, market and stage of journey while keeping the brand voice consistent. Hyper-personalized content stops being a luxury the budget cannot afford.',
  },
];

const lanes = [
  {
    label: 'Brand & campaign',
    heading: 'Brand and campaign content.',
    image: '/Images/pr-hero.jpg',
    alt: 'A daylit editorial review with campaign storyboards and bylined articles pinned beside a calibrated monitor showing a brand narrative draft, warm shadow grade.',
    lead: 'Campaign concepting, PR and editorial, video and social scripts. The headline-grade work, faster.',
    body: [
      "Campaign narratives, visual storyboards with scene descriptions, multi-channel messaging frameworks, concept testing at speed. Press releases, thought leadership, industry reports and brand storytelling. Video scripts for product launches, social calendars and platform-specific captions.",
      'Useful where the campaign needs to ship in many places at the same time, in a voice that holds across channels and registers.',
    ],
    tags: [
      'Campaign concepting', 'Visual storyboards',
      'PR & editorial', 'Thought leadership',
      'Video scripts', 'Social calendars',
      'TikTok / Reels scripting',
    ],
  },
  {
    label: 'Commercial & performance',
    heading: 'Commercial and performance content.',
    image: '/Images/hub4presentation.jpg',
    alt: 'A daylit performance content review with PDP copy variations, email sequences and landing page drafts pinned beside a calibrated monitor, lifted black point, real-photography grade.',
    lead: 'E-commerce, email and CRM, website and landing pages. The content that closes the loop.',
    body: [
      "Product descriptions optimized for conversion, category copy, A+ content, marketplace-specific content for Amazon, Tmall and Shopify. Email campaign sequences, welcome flows, abandoned-cart recovery, behavior-triggered personalization, subject-line and preview-text testing.",
      'Useful where the channel has a measurable goal and the content has a measurable job. The PDP, the email, the landing page, all built for the conversion they exist to drive.',
    ],
    tags: [
      'Product descriptions', 'Category page copy',
      'A+ content', 'Amazon / Tmall / Shopify',
      'Email sequences', 'Welcome flows',
      'Subject-line testing', 'Landing-page copy',
    ],
  },
  {
    label: 'Strategic & naming',
    heading: 'Strategic and naming content.',
    image: '/Images/ms-hero.jpg',
    alt: 'A documentary in-studio frame of a strategist reviewing brand naming explorations and tone-of-voice frameworks on a calibrated monitor, warm window light, real-photography grade.',
    lead: 'Naming exploration, tone-of-voice frameworks, SEO and content strategy. The strategic spine.',
    body: [
      "Product and service naming, tagline and positioning, brand voice guidelines and tone frameworks. Messaging architecture and key messages. SEO-optimized blog and pillar content, keyword-rich category descriptions, meta description and title-tag optimization, content briefs and editorial calendars.",
      'Useful where the work upstream of every campaign needs to be sharper than what AI alone will return. The strategic layer is human; the execution layer scales around it.',
    ],
    tags: [
      'Naming exploration', 'Tagline and positioning',
      'Tone of voice', 'Messaging architecture',
      'SEO pillar content', 'Meta description / title tag',
      'Content briefs', 'Editorial calendars',
    ],
  },
];

/* The two routes side by side, plain lists, no numerals. The app side is
   social posts only: that is all the app drafts. */
const appSide = [
  'Your accounts, connected in My Connections',
  'A brief, then Draft with AI',
  'A format skill for each network',
  'Team skills for the house voice',
  'Versions, and rewrites passage by passage',
  'Approval in Validation, then publish or schedule',
];
const studioSide = [
  'Campaign ideas and storyboards',
  'Product pages and marketplace copy',
  'Email sequences',
  'SEO articles on an editorial calendar',
  'Naming, taglines and a tone of voice',
];

const faqs: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'How does AI content creation compare to traditional copywriting?',
    a: 'AI helps most with high-volume, structured work: product descriptions, email sequences, social captions. Traditional copywriting is still the right call for brand manifestos and highly conceptual work. We use both, with a strategist in charge.',
  },
  {
    q: 'What types of content work best with AIGC?',
    a: 'Product descriptions, email campaigns, social media content, video scripts, SEO articles, press releases and campaign storyboards perform exceptionally well. AIGC is particularly powerful for creating variations, testing messaging angles and adapting content across channels and markets.',
  },
  {
    q: 'How long does it take to produce AI-generated content?',
    a: 'It depends on the brief. A producer reads it within one business day, and a written proposal with the schedule follows within 48 hours. A batch of product descriptions moves much faster than a campaign storyboard or a thought-leadership piece.',
  },
  {
    q: 'Do you only generate content, or can you adapt existing brand materials?',
    a: 'Both. We create entirely new content from strategy briefs, or work from existing material to generate variations, adaptations and extensions. We also specialize in transcreating content across languages while maintaining brand voice and cultural relevance.',
  },
  {
    q: 'How do you handle brand voice consistency?',
    a: 'We start from your brand guidelines and the copy you\u2019ve already approved, and write them into the instructions our writers and AI tools follow. A strategist reviews every piece before delivery. If your team drafts posts in the app, the same rules can live in its Team skills.',
  },
  {
    q: 'How do you price content projects?',
    a: 'Studio work is priced per asset, per project or on retainer, and quoted after we read your brief, with a written proposal within 48 hours. We don\u2019t publish rates. In the app, drafting a post with AI is paid from your team\u2019s prepaid balance, the draft shows what it cost, and \u201cWrite it myself\u201d costs nothing.',
  },
  {
    q: 'What is included in your content training programs?',
    a: 'The course covers language AI tools and how to prompt for each type of content, with hands-on workshops on workflow and quality control. Participants leave with content they wrote and prompts they can reuse.',
    link: { label: 'See AI training', href: '/solutions/training' },
  },
  {
    q: 'Can you create content in multiple languages?',
    a: 'Yes. Major global languages with cultural adaptation beyond literal translation. The team includes native speakers who ensure messaging resonates locally while maintaining global brand consistency.',
  },
  {
    q: 'How do you ensure content accuracy and avoid AI hallucinations?',
    a: 'Every piece goes through human review by subject-matter experts. Fact-checking protocols, source verification and editorial oversight are built in. For technical or specialized content, we collaborate with your internal teams to validate accuracy.',
  },
  {
    q: 'What about SEO optimization for AI-generated content?',
    a: 'SEO best practice is built into the content generation process: keyword integration, semantic relevance, content-structure optimization and metadata. The content is designed to perform in both traditional search and emerging AI-powered search platforms.',
  },
  {
    q: 'Can AI-generated content be used across all marketing channels?',
    a: 'Yes. All content meets platform requirements, maintains brand compliance and adapts to channel-specific formats. The content works across paid advertising, social media, websites, email and commerce platforms.',
  },
  {
    q: 'Do you handle content localization for global markets?',
    a: 'We specialize in market-specific content adaptation that goes beyond translation: cultural nuance, local market preferences, platform requirements and regulatory compliance for each region the brand operates in.',
  },
  {
    q: 'Can our team write social posts in the app?',
    a: 'Yes, and a team that posts every week gets the most from it. Connect your accounts in My Connections, write a brief, and the app drafts the post and sends it out when you say. Long-form copy, product pages and emails stay with the studio.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'AI content production', item: pageUrl },
  ],
};
---

<Layout
  title="AIGC Content Creation | AI Copywriting Studio | hubStudio"
  description="AI copywriting led by human strategists: campaigns, product pages, email, SEO and naming. Your team can draft social posts in the hubStudio app."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>AI Production
            <span class="kicker__sep">/</span> Content
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">A month of</span></span>
            <span class="line"><span class="line__i">content in</span></span>
            <span class="line"><span class="line__i serif">a day.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Strategic writers, <em>not just software</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Brand positioning cannot be automated. Audience insight
              requires human empathy. Creative direction shapes every
              line. AIGC executes faster and cheaper than traditional
              copywriting, but human intelligence still leads every word
              we write.
            </p>
            <p>
              The studio pairs content strategists and creative directors
              with AI tools set up for your brand&rsquo;s voice. AI speeds up
              the drafting, and people still decide what the story is.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={briefHref}>Start a content brief</Button>
            <a class="ghost-link ghost-link--light" href="#app">
              Or draft posts in the app
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Human strategists, AIGC execution
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/aiprod-content-hero.jpg"
          alt="A daylit AIGC content production floor with a single strategist reviewing campaign copy variations on a calibrated monitor and printed editorial proofs pinned along the back wall, warm window light from camera left."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Content floor</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why now</p>
            <h2 class="dh r" style="--d:.05s">
              When strategic writing<br />meets <span class="serif">machine intelligence</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Drafting gets faster and cheaper, so budget can move from
            execution into strategy and testing. The same team can cover more
            channels.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cover" id="lanes">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What we write</p>
          <h2 class="dh r" style="--d:.05s">
            Three lanes of <span class="serif">content production</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Brand and campaign, commercial and performance, strategic and
            naming. Each lane shares the same model training, the same
            voice guardrails and the same senior strategist sign-off.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  Content lane
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="onapp" id="app">
      <div class="shell">
        <div class="onapp__grid">
          <div class="onapp__copy">
            <p class="kicker r"><span class="kicker__tick"></span>Your team, in the app</p>
            <h2 class="dh r" style="--d:.05s">
              Social posts, drafted in the <span class="serif">app</span>.
            </h2>
            <p class="onapp__lead r" style="--d:.1s">
              There&rsquo;s one exception. Social posts are the kind of copy
              your own team can draft in hubStudio. The app writes posts for
              LinkedIn, Instagram, Facebook, TikTok (Beta) and X. It
              doesn&rsquo;t write campaigns, product pages, emails or names;
              that&rsquo;s what the studio lanes are for.
            </p>
            <p class="onapp__p r" style="--d:.14s">
              You write a brief the way you&rsquo;d brief a writer, then click
              &ldquo;Draft with AI,&rdquo; or &ldquo;Write it myself&rdquo; if
              you&rsquo;d rather start from a blank page. Each network has its
              own format skill, with its length, hashtag and tone rules. Your
              Team skills carry the house voice into every draft.
            </p>
            <p class="onapp__p r" style="--d:.17s">
              Every version of the copy is kept, and you can rewrite one
              passage at a time. &ldquo;Re-purpose for other networks&rdquo;
              turns one post into posts for the others.
            </p>
            <p class="onapp__p r" style="--d:.2s">
              Add pictures or a carousel, send the post for approval in
              Validation, then publish now or schedule it, on up to 20 accounts
              at once. Tag a post &ldquo;Made for&rdquo; a client and it
              appears in their Client space.
            </p>
            <div class="onapp__cta r" style="--d:.24s">
              <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
              <a class="ghost-link" href={`${HELP_URL}/linkedin`}>
                How LinkedIn posts work
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
          <div class="onapp__media r" style="--d:.1s">
            <AppShot shot={appShots.linkedin} path="/social/linkedin/posts" caption />
          </div>
        </div>

        <div class="adds">
          <div class="adds__col r">
            <p class="adds__tag">In the app</p>
            <h3 class="adds__title">Your team writes the posts.</h3>
            <ul class="adds__list">
              {appSide.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div class="adds__col adds__col--studio r" style="--d:.08s">
            <p class="adds__tag">With the studio</p>
            <h3 class="adds__title">What we write.</h3>
            <ul class="adds__list">
              {studioSide.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <WaysToWork tone="cream" highlight="studio" />

    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/hubstudio-shanghai-studio.webp"
                alt="A wide view of the hubStudio Shanghai floor with editorial daylight, calibrated stations and printed editorial proofs along the back wall."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">Strategist-led</span>
            <span class="source__stat-cap">A person signs off every line</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Strategy first.<br />Technology <span class="serif">second</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            AIGC generates text. It cannot craft a market position,
            define what makes a brand different, or understand the
            competitive landscape that shapes the message. Algorithms
            analyze data; strategists understand the emotional triggers,
            the cultural context and the human motivations that build
            brand loyalty.
          </p>
          <p class="source__p r" style="--d:.16s">
            Our strategists and creative directors guide every brief, so
            AI serves the narrative vision rather than producing generic
            copy that sounds like everyone else.
          </p>
          <p class="source__p r" style="--d:.22s">
            For studio work, you receive finished copy. If your team also
            works in hubStudio, we can write your brand rules into its Team
            skills, so the posts it drafts start from the same rules as the
            rest of your content.
          </p>
          <p class="source__p r" style="--d:.25s">
            The work we&rsquo;ve shipped is on the
            <a class="inline-link inline-link--light" href="/work">Work page</a>.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Strategist sign-off
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              House voice rules
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Native-speaker localization
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              NDA in place
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">draft</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions content leads ask before we begin. If yours is
            not below, put it in the brief.
          </p>
          <p class="faq__fresh r" style="--d:.13s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={briefHref}>Start a content brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.a}
                      {faq.link && (
                        <>
                          {' '}
                          <a class="inline-link" href={faq.link.href}>{faq.link.label}</a>.
                        </>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <DualCta
      eyebrow="Build with us"
      pre="Write at our "
      accent="pace"
      post="."
      text="Send a campaign brief, an editorial calendar or the content gap you keep running into. A producer reads it within one business day. Or open the app and draft your first social post."
      lead="studio"
      briefQuery="way=studio"
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
