---
/**
 * AIGC Video Creation  ·  /solutions/ai-production/video
 *
 * Studio-grade AIGC video, with the narrative arc kept human. Drawn from
 * the source page's "what just became possible" framing, the economics
 * section and the four content lanes the studio actually ships.
 *
 * Repositioned for the two offers: the studio makes the film, or the
 * customer's own team makes clips in the hubStudio app (Video studio,
 * Explore). Copy deck: scratchpad cq/aiprod-video/final.md.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import InsightsLayer from '../../../components/InsightsLayer.astro';
import AppShot from '../../../components/AppShot.astro';
import WaysToWork from '../../../components/WaysToWork.astro';
import DualCta from '../../../components/DualCta.astro';
import { appShots } from '../../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL, HELP_URL } from '../../../lib/links';

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/solutions/ai-production/video`;
const briefHref = `${BRIEF_URL}?way=studio`;

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'What became possible',
    title: 'Create what was previously impossible.',
    body: 'Underwater product reveals. Places that don\u2019t exist. Talent in cities they\u2019ve never visited. Ideas that were out of reach can now go on the storyboard.',
  },
  {
    label: 'Test before invest',
    title: 'Test everything before investing anything.',
    body: 'Run five creative directions in parallel. Test them. Refine. Scale the winner. What used to require separate productions now happens at the same time, removing guesswork from creative strategy and from media spend.',
  },
  {
    label: 'Scale and speed',
    title: 'One concept, many versions, on the news cycle.',
    body: 'Get the master story right once, then cut it for each platform and adapt it for each market, with lip-sync where it matters. A trending topic on Tuesday can have a branded answer by Wednesday. Every extra version is quicker to make than the first.',
  },
];

const lanes = [
  {
    label: 'Short-form social',
    heading: 'Short-form social video.',
    image: '/Images/sb-sample-digital.jpg',
    alt: 'A daylit edit suite frame with vertical short-form variations laid out in the timeline panel and a master cut paused on the main monitor, warm shadow grade.',
    lead: 'Platform-optimized content for TikTok, Reels and Shorts, with native pacing and rhythm.',
    body: [
      "Product demonstrations, unboxing experiences, lifestyle-driven brand storytelling and UGC-style adaptations. Each cut is built for the platform it will live on, not retrofitted from a master that was made for somewhere else.",
      'Useful where the channel demands constant new creative and the team cannot afford to wait for a shoot every time a new angle is on the table.',
    ],
    tags: [
      'TikTok / Reels / Shorts', 'Product demonstrations',
      'Unboxing experiences', 'Lifestyle storytelling',
      'UGC-style adaptations', 'Vertical-first edits',
    ],
  },
  {
    label: 'E-commerce video',
    heading: 'E-commerce and retail video.',
    image: '/Images/sb-sample-explainer.jpg',
    alt: 'A daylit product video review with multiple PDP-ready angles arranged on a calibrated monitor and seasonal variants pinned beside it, lifted black point, real-photography grade.',
    lead: 'Product showcases with dynamic angles, demonstrations, tutorials and marketplace-ready content for global platforms.',
    body: [
      "Hero product video, feature demonstrations, installation walkthroughs and platform-specific assets for Amazon, Tmall and the rest of the global marketplace stack.",
      'Useful for retailers and manufacturers shipping high volumes of product variations, where the PDP video and the marketplace tile carry the conversion weight.',
    ],
    tags: [
      'Product showcases', 'Feature demonstrations',
      'Tutorials', 'Amazon / Tmall ready',
      'Seasonal adaptations', 'Promotional variants',
    ],
  },
  {
    label: 'Brand & campaign',
    heading: 'Brand and campaign video.',
    image: '/Images/sb-sample-tv.jpg',
    alt: 'A cinematic narrative-driven brand video paused on a large calibrated monitor with the master storyboard pinned along the wall to the right, warm shadow grade.',
    lead: 'Narrative-driven brand stories, concept testing and ambassador content, with multi-language lip-sync adaptation.',
    body: [
      "Concept visualization through to finished master film. Multi-language adaptation with lip-sync, so the brand ambassador is recognizable in every market without re-shooting.",
      'Useful for global campaigns where the master idea has to travel across languages and cultures while keeping the line that made it work in the first place.',
    ],
    tags: [
      'Brand storytelling', 'Concept testing',
      'Multi-language lip-sync', 'Ambassador content',
      'Hero film', 'Director-led storyboard',
    ],
  },
  {
    label: 'Long to short',
    heading: 'Long-form to short-form adaptation.',
    image: '/Images/sb-sample-branded.jpg',
    alt: 'A daylit edit-suite frame of an editor selecting key moments from a long-form master timeline and assembling them into short-form social cuts, warm shadow grade.',
    lead: 'Editors pick the moments that matter. AI helps cut and reformat them for each platform.',
    body: [
      'Several social cuts from one master file, each formatted for its platform, with your brand elements and messages placed the same way every time.',
      'Useful for getting more out of video you already own: the keynote that becomes a social series, the interview that feeds the channel for months, the launch film that keeps working after launch week.',
    ],
    tags: [
      'Key-moment selection', 'Auto social cuts',
      'Platform-specific formats', 'Brand element overlay',
      'Master to feed', 'Always-on content',
    ],
  },
];

/* The two routes side by side, plain lists, no numerals. */
const appSide = [
  'Pick the engine for each clip',
  'A price on every run, shown first',
  'Start from a picture in the Assets Library or one you upload',
  'Tag a clip \u201cMade for\u201d a client, so it lands in their Client space',
  'Send a clip for approval in Validation',
  'Post to TikTok (Beta), Instagram or Facebook from the app',
];
const studioSide = [
  'A director and a storyboard, shot by shot',
  'A shoot when the film needs one, generation when it doesn\u2019t, or both',
  'Editing and sound design, with lip-sync for other languages',
  'Brand-trained models on our own GPU pipelines',
  'A record of how each asset was made',
];

const faqs: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'How does AI video generation compare to traditional video production?',
    a: 'AI video is strong at scalable content for digital platforms, product demos and social. Traditional production is still the better call for complex stories that need actors, big sets or a specific camera technique. For most brand video, AI gets you there sooner and lets you try more versions.',
  },
  {
    q: 'What types of video content work best with AI generation?',
    a: 'Product showcases, social content, e-commerce video, brand storytelling, explainer content and adaptations perform exceptionally well. AI generation is particularly powerful for creating multiple variations, platform-specific formats and localized content at scale.',
  },
  {
    q: 'How long does it take to produce AI-generated videos?',
    a: 'It depends on the brief. A producer reads it within one business day, and a written proposal with the schedule follows within 48 hours. Simple clips move much faster than projects that need a brand-trained model or heavy post-production.',
  },
  {
    q: 'Can you create videos featuring real people, or only AI-generated characters?',
    a: 'Both. We can work with footage of real people (actors, brand ambassadors, employees) and enhance it with AI, or create entirely AI-generated characters and spokespersons. We also specialize in lip-sync technology for multi-language adaptation of existing content.',
  },
  {
    q: 'How do you handle data privacy and confidentiality?',
    a: 'Work you brief to the studio stays with the studio team, under NDA, and brand-trained models run on our own GPU pipelines. When your own team works in the app, what it renders stays in its History and Assets Library.',
  },
  {
    q: 'What is included in your video training programs?',
    a: 'The course covers the video engines, how to prompt for motion and how to build a video workflow, with hands-on workshops at beginner and advanced levels. Participants leave with clips they made and workflows they can reuse.',
    link: { label: 'See AI training', href: '/solutions/training' },
  },
  {
    q: 'What video formats and platforms do you support?',
    a: 'All major platforms including Instagram, TikTok, YouTube, LinkedIn and Facebook, plus e-commerce platforms such as Amazon and Tmall. Square, vertical, horizontal and custom aspect ratios as needed.',
  },
  {
    q: 'How do you ensure brand consistency across AI-generated videos?',
    a: 'Custom AI models trained on your brand visual identity, color palette, typography and style guidelines. Creative directors oversee every project to ensure brand consistency, and the QC process verifies that every video aligns with the brand standard before delivery.',
  },
  {
    q: 'Can you adapt existing long-form video into short-form content?',
    a: 'Yes. Our editors pick the key moments, and AI helps cut them into several social versions formatted for each platform. It\u2019s one of the best ways to get more out of video you already own.',
  },
  {
    q: 'What about music and sound design for AI-generated video?',
    a: 'We handle the audio too: background music, sound effects, voiceovers in several languages and text-to-speech, matched to your brand\u2019s sound. We clear the audio for the uses in your brief.',
  },
  {
    q: 'Can AI-generated video be used across all marketing channels?',
    a: 'Yes, with proper licensing and compliance considerations. We ensure all generated content meets platform requirements and provide guidance on usage rights. The video is designed for multi-channel deployment across paid, social, web and e-commerce.',
  },
  {
    q: 'How do you price video projects?',
    a: 'In the app, you pay per run from a prepaid balance, at the price shown before each run, and a failed run is never charged. There\u2019s no subscription, and the balance doesn\u2019t expire. Studio work is priced per asset, per project or on retainer, and quoted after we read your brief. We don\u2019t publish rates.',
  },
  {
    q: 'Can our own team make the videos instead?',
    a: 'Yes, for clips that don\u2019t need a director. Create an account in the hubStudio app and your team works in the Video studio. The account costs nothing and there\u2019s no subscription. When a film needs a storyboard and a director, that\u2019s where we come in.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'AI video production', item: pageUrl },
  ],
};
---

<Layout
  title="AIGC Video Production for Brands | hubStudio"
  description="AI video production for brands: director-led films from our studio, or clips your own team makes in the hubStudio app’s Video studio."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>AI Production
            <span class="kicker__sep">/</span> Video
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Direct the film</span></span>
            <span class="line"><span class="line__i">you couldn&rsquo;t</span></span>
            <span class="line"><span class="line__i serif">shoot.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            The narrative arc is still <em>everything</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              For decades, video was defined by what it cost to shoot:
              studio days, talent fees and location permits. Much of that
              list can now go. So the first question is what to make, not
              what it will cost.
            </p>
            <p>
              The thinking stays with people. Our directors design every
              shot, and AI helps ship it in every format and language as fast
              as each channel needs them.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={briefHref}>Start a video brief</Button>
            <a class="ghost-link ghost-link--light" href="#app">
              Or make it in the app
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Director-led storyboards, AIGC execution
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/aiprod-video-hero.jpg"
          alt="A daylit edit-suite floor with a large calibrated monitor showing a paused master cut, vertical and square variations arranged in the timeline panel, warm window light from camera left and a single editor reviewing the work."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Video floor</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>What just became possible</p>
            <h2 class="dh r" style="--d:.05s">
              The constraints that<br />defined video, <span class="serif">gone</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Production gets cheaper, and speed becomes part of the strategy.
            Testing an idea now costs a fraction of what it did. The brands
            that build video into their weekly routine pull ahead of the ones
            still waiting for a shoot.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cover" id="lanes">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What we build for brands</p>
          <h2 class="dh r" style="--d:.05s">
            Four lanes of video<br /><span class="serif">production</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Short-form, e-commerce, brand and adaptation, all run inside
            the same studio with the same senior creative leads. The
            storyboard is human; the execution is AIGC.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  Video lane
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="onapp" id="app">
      <div class="shell">
        <div class="onapp__grid">
          <div class="onapp__copy">
            <p class="kicker r"><span class="kicker__tick"></span>Or make it yourself</p>
            <h2 class="dh r" style="--d:.05s">
              Your team can make clips in the <span class="serif">app</span>.
            </h2>
            <p class="onapp__lead r" style="--d:.1s">
              That&rsquo;s the studio side, and a director-led film belongs
              there. A quick product clip or a social loop is often something
              your own team can make, in hubStudio&rsquo;s Video studio, paying
              only for what it runs.
            </p>
            <p class="onapp__p r" style="--d:.14s">
              The Video studio does three jobs. Text to video starts from a
              description. Image to video starts from a picture, as the first
              frame or as the first and last frames. Reference to video works
              from pictures, clips and sound you supply. Clips go up to 4K, up
              to 30 seconds on some engines, with generated sound. Length and
              resolution vary by engine, so check both before you write a long
              prompt.
            </p>
            <p class="onapp__p r" style="--d:.18s">
              Engines include Veo 3.1 Fast, Kling, Seedance, Wan, MiniMax and
              Grok Imagine, with more as they ship. Each run shows its price
              before it starts, it&rsquo;s paid from a prepaid balance, and
              every clip lands in History.
            </p>
            <div class="onapp__cta r" style="--d:.22s">
              <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
              <a class="ghost-link" href={`${HELP_URL}/create-a-video`}>
                How the Video studio works
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
          <div class="onapp__media onapp__shots">
            <div class="r" style="--d:.1s">
              <AppShot shot={appShots.videoStudio} path="/content/video" caption />
            </div>
            <div class="r" style="--d:.16s">
              <AppShot shot={appShots.explore} path="/explore" caption />
            </div>
          </div>
        </div>

        <div class="adds">
          <div class="adds__col r">
            <p class="adds__tag">In the app</p>
            <h3 class="adds__title">Your team decides.</h3>
            <ul class="adds__list">
              {appSide.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div class="adds__col adds__col--studio r" style="--d:.08s">
            <p class="adds__tag">With the studio</p>
            <h3 class="adds__title">What we add.</h3>
            <ul class="adds__list">
              {studioSide.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
        <p class="onapp__p onapp__both r">
          Or both at once: our studio can make the work inside hubStudio, and
          you approve it there.
          <a class="inline-link" href="/studio/with-the-app">How Studio + app works</a>.
        </p>
      </div>
    </section>

    <WaysToWork tone="cream" highlight="studio-app" />

    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-studio.jpg"
                alt="A wide view of the hubStudio Shanghai floor with editorial daylight, calibrated stations and master films paused on monitors along the central row."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">Director-led</span>
            <span class="source__stat-cap">Every shot designed before AIGC executes it</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Production execution<br />no longer limits the <span class="serif">vision</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Strategy first: target audience, key message, desired action.
            Then the storyboard, shot by shot, with visual direction. Our
            creative directors define what viewers see, feel and remember.
            No AI makes these decisions.
          </p>
          <p class="source__p r" style="--d:.16s">
            The same product in ten different rooms. A brand ambassador in
            Paris, Tokyo and New York without a flight. A winter campaign
            reworked for summer. We storyboard it the same way; what changes
            is how it gets made.
          </p>
          <p class="source__p r" style="--d:.22s">
            Choose how you receive it: finished files with Studio only, or
            reviews and approvals in hubStudio with Studio + app.
          </p>
          <p class="source__p r" style="--d:.25s">
            The work we&rsquo;ve shipped is on the
            <a class="inline-link inline-link--light" href="/work">Work page</a>.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Senior creative direction
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Lip-sync localization
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Provenance per asset
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              NDA in place
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">cut</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions brand and performance leads ask before we begin.
            If yours is not below, put it in the brief.
          </p>
          <p class="faq__fresh r" style="--d:.13s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={briefHref}>Start a video brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.a}
                      {faq.link && (
                        <>
                          {' '}
                          <a class="inline-link" href={faq.link.href}>{faq.link.label}</a>.
                        </>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <InsightsLayer placement="aiVideo" tone="white" id="reading" />

    <DualCta
      eyebrow="Build with us"
      pre="Shoot less. Ship "
      accent="more"
      post="."
      text="Send a storyboard, a master film or the campaign you keep wanting to extend. A producer reads it within one business day, and a written proposal follows within 48 hours. Or open the app and render the first clip yourself."
      lead="studio"
      briefQuery="way=studio"
    />
  </div>
</Layout>

<style>
