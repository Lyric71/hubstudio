---
/**
 * AIGC Image Creation  ·  /solutions/ai-production/image
 *
 * Studio-grade image production with creative direction at the front and
 * AIGC at the back. Drawn from the source page's volume / timeline /
 * budget framing and the content categories the studio actually ships.
 *
 * Repositioned for the two offers: the studio makes the work, or the
 * customer's own team makes it in the hubStudio app (Image studio, Explore).
 * Copy deck: scratchpad cq/aiprod-image/final.md.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import InsightsLayer from '../../../components/InsightsLayer.astro';
import AppShot from '../../../components/AppShot.astro';
import WaysToWork from '../../../components/WaysToWork.astro';
import DualCta from '../../../components/DualCta.astro';
import { appShots } from '../../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL, HELP_URL } from '../../../lib/links';

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/solutions/ai-production/image`;
const briefHref = `${BRIEF_URL}?way=studio`;

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Volume',
    title: 'Marketing needs far more images than a shoot can supply.',
    body: 'Every channel, format and market wants its own version. A studio built for a few dozen frames per campaign can\u2019t keep up by adding people and location days. AI closes that gap without asking the team to drop its standards.',
  },
  {
    label: 'Timeline',
    title: 'Marketing wants days, not months.',
    body: 'A traditional shoot takes weeks to book, light and deliver. Campaigns now move faster than that. AI works at the new pace, because the slow part is now the brief, not the camera.',
  },
  {
    label: 'Budget',
    title: 'Flat budgets, rising demand.',
    body: 'When every image needs its own set and crew, the budget decides how many ideas get made. AI takes a large part of that cost out, so the team can make the variations a campaign deserves instead of the few a line item allows.',
  },
];

/* The two routes side by side: what the customer's team does in the app,
   and what the studio adds. Plain lists, no numerals. */
const appSide = [
  'Pick the engine for each job',
  'A price on every run, shown first',
  'Find every render in History, with its prompt',
  'Edit, crop and add a logo in the free Image editor',
  'Send a picture for approval in Validation',
  'Keep every file in the Assets Library',
];
const studioSide = [
  'A senior art director on the brief',
  'The concept behind the picture',
  'A shoot when the picture needs one, generation when it doesn\u2019t, or both',
  'Brand-trained models on our own GPU pipelines',
  'Retouching by hand',
];

const lanes = [
  {
    label: 'Performance creative',
    heading: 'Advertising and performance creative.',
    image: '/Images/hub4fashion.jpg',
    alt: 'A daylit performance creative review with social ad variations on a calibrated monitor and printed contact sheets pinned alongside, prime-lens shallow focus, warm shadow grade.',
    lead: 'Ad creative, carousels, video, influencer-style and UGC frames, landing visuals. The full performance stack, at the pace the channel demands.',
    body: [
      'The studio operates as the production arm of the brand performance team. Briefs in, variations out, all tracked against the same standard the in-house creative would hold.',
      'Useful where the channel needs constant testing and the team cannot afford to wait for a shoot every time a new angle is on the table.',
    ],
    tags: [
      'Ad creative', 'Carousels',
      'Video advertisements', 'Influencer-style',
      'UGC-style content', 'Landing-page visuals',
    ],
  },
  {
    label: 'E-commerce',
    heading: 'E-commerce and product imagery.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A daylit product still life on a calibrated background with the hero shot pinned beside the in-context lifestyle frame and the marketplace tile, warm shadow grade.',
    lead: 'Hero product, context and lifestyle, demos with and without models, marketplace-optimized assets. The library that closes the sale.',
    body: [
      "The same starting asset becomes the hero, the editorial frame and the marketplace tile, all under the same brand standard. The PDP, the A+ content and the configurator stay in step.",
      'Useful for retailers and DTC brands shipping high volumes of product variations across multiple marketplaces, where consistency is the moat and speed is the constraint.',
    ],
    tags: [
      'Hero product images', 'Lifestyle context',
      'Product descriptions', 'Demos with and without models',
      'Marketplace-optimized', '360-degree views',
    ],
  },
  {
    label: 'Social',
    heading: 'Social media content.',
    image: '/Images/sb-sample-branded.jpg',
    alt: 'A daylit social content review with vertical, square and wide variations laid out on a calibrated monitor, real-photography grade.',
    lead: 'Platform-specific posts, animated content, video plus caption combinations, story frames and social-commerce assets.',
    body: [
      'Each platform gets the variant it wants: vertical for the feed, square for the carousel, wide for the in-feed video. The brand voice carries; the format adapts.',
      'Useful where the channel mix is wide and the appetite for new creative is constant. The studio runs the variation layer so the team writes the next idea.',
    ],
    tags: [
      'Platform-specific posts', 'Animated content',
      'Video and caption', 'Story content',
      'Social-commerce assets', 'Vertical / square / wide',
    ],
  },
  {
    label: 'Brand identity',
    heading: 'Brand identity and visual systems.',
    image: '/Images/hub4presentation.jpg',
    alt: 'A daylit brand-identity review with logo applications and brand photography pinned beside a calibrated monitor showing a master visual system, warm shadow grade.',
    lead: 'Visual identity development, logo applications, brand photography, website design elements, presentation templates and collateral.',
    body: [
      "The studio builds the visual system, then runs it at scale. Identity, photography and the asset library that follows, all tuned to the same line.",
      'Useful for brands that need a coherent visual standard across product, communications and channel, rather than a deck of guidelines and a hope.',
    ],
    tags: [
      'Visual identity', 'Logo applications',
      'Brand photography', 'Website design elements',
      'Presentation templates', 'Marketing collateral',
    ],
  },
  {
    label: 'Product visualization',
    heading: 'Product visualization and campaign adaptation.',
    image: '/Images/ecom-listings.jpg',
    alt: 'A daylit product-visualization review with 360-degree views and technical illustrations on calibrated monitors, real-photography grade, lifted black point.',
    lead: '360-degree views, technical illustrations, packaging variants and multi-market campaign adaptations.',
    body: [
      "From the master campaign idea to the local adaptation, the seasonal variant, the format multiplication and the A/B testing variant. One brief, many on-brand expressions.",
      'Useful for global brands shipping the same campaign across markets, formats and channels, where consistency is the brief and adaptation is the work.',
    ],
    tags: [
      '360-degree product views', 'Technical illustrations',
      'Assembly instructions', 'Packaging design',
      'Multi-market localization', 'Format adaptations',
      'A/B testing variants',
    ],
  },
];

const faqs = [
  {
    q: 'Who owns the copyright to AI-generated images?',
    a: 'AI-generated images can\u2019t be copyrighted in most jurisdictions, including the US, because copyright law requires human authorship. As the client commissioning the work, you get usage rights through the service agreement, and we record the provenance of every asset we deliver.',
  },
  {
    q: 'Is my brand data safe with you?',
    a: 'Work you brief to the studio stays with the studio team, under NDA, and brand-trained models run on our own GPU pipelines. In the app, your team picks the engine for each run and keeps the results in its own History and Assets Library. For clean delivery files, the free Image anonymizer shows the hidden data in a picture (camera data, location, content credentials) and rebuilds it clean without uploading it.',
  },
  {
    q: 'Could AI-generated images infringe on existing copyrights?',
    a: 'This is a valid concern. While AI models learn patterns rather than copy images directly, outputs can resemble existing works. We mitigate this through careful training-data curation, deduplication, post-generation review and reverse image search before delivery.',
  },
  {
    q: 'How do you ensure brand safety and quality control?',
    a: 'A senior art director leads every brief. The process runs from a first read of your brand to human direction during generation, a brand compliance review and a final check before delivery.',
  },
  {
    q: 'Can AI really create content that fits my brand and audience?',
    a: 'Yes, with the right setup and people. For studio work we use models trained on your brand\u2019s look, products and guidelines. AI is the tool. Our creative team develops the concept and decides what serves the brand.',
  },
  {
    q: 'What happens if the AI generates something off-brand?',
    a: 'We catch it before you see it. Prompt craft, content filters and human review run at every stage, and nothing reaches you without a person signing it off. If something slips through, we fix it.',
  },
  {
    q: 'How much human involvement is there in the AI generation process?',
    a: 'Significant. AI handles the technical generation. Humans drive every creative decision: concept development, prompt crafting, style direction, quality evaluation and final selection. Creative directors, not algorithms, decide what gets delivered.',
  },
  {
    q: 'Will AIGC replace traditional photography and design for our brand?',
    a: 'No. AIGC complements traditional creative rather than replacing it. It excels at scaling content production, rapid iteration and exploring concept cost-effectively. Certain campaigns, high-touch brand moments and authentic human stories still require traditional photography. We help determine the optimal mix per project.',
  },
  {
    q: 'Can our own team make the images instead?',
    a: 'Yes. Create an account in the hubStudio app and your team works in the Image studio, with engines from several makers in one place. Creating the account costs nothing, there\u2019s no subscription, and each run shows its price before it starts. When a job needs an art director, send it to us instead.',
  },
  {
    q: 'How is image production priced?',
    a: 'In the app, you pay per run from a prepaid balance, at the price shown before each run, and a failed run is never charged. There\u2019s no subscription, and the balance doesn\u2019t expire. Studio work is priced per asset, per project or on retainer, and quoted after we read your brief. A written proposal follows within 48 hours. We don\u2019t publish rates.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'AI image production', item: pageUrl },
  ],
};
---

<Layout
  title="AIGC Image Production for Brands | hubStudio"
  description="AI image production for brands. Our studio makes it with senior art direction, or your own team makes it in the hubStudio app. Or mix the two."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>AI Production
            <span class="kicker__sep">/</span> Image
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Never book the</span></span>
            <span class="line"><span class="line__i">same shoot</span></span>
            <span class="line"><span class="line__i serif">twice.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Creative direction leads. <em>Technology follows</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              AIGC generates pixels brilliantly. It cannot conceive brand
              stories, make strategic creative decisions or understand what
              resonates with an audience. That is still human work.
            </p>
            <p>
              Senior art directors lead every brief, and our studio runs
              models trained on your brand. The idea comes first, and AI is
              how we get it made. The output reads like a campaign because a
              campaign is what we made.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={briefHref}>Start an image brief</Button>
            <a class="ghost-link ghost-link--light" href="#app">
              Or make it in the app
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Brand-trained models, senior art direction
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/aiprod-image-hero.jpg"
          alt="A daylit hubStudio visual production floor with a single creative director under window light from camera left, calibrated monitors behind, brand variations pinned along a back wall in editorial review."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Image floor</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>What changed</p>
            <h2 class="dh r" style="--d:.05s">
              Traditional production<br />cannot match the <span class="serif">brief</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Volume, timeline and budget have moved in three directions
            traditional production cannot chase at the same time. AIGC
            changes what is physically possible, when it is operated by
            people who hold the line on craft.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cover" id="lanes">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What we build</p>
          <h2 class="dh r" style="--d:.05s">
            Five lanes of <span class="serif">image production</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Each lane is a self-contained engagement. Most clients start in
            one or two and expand as the engine proves itself. The lanes
            share the same model training, the same brand standard and the
            same senior creative leads.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  Image lane
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="onapp" id="app">
      <div class="shell">
        <div class="onapp__grid">
          <div class="onapp__copy">
            <p class="kicker r"><span class="kicker__tick"></span>Or make it yourself</p>
            <h2 class="dh r" style="--d:.05s">
              Your team can make it in the <span class="serif">app</span>.
            </h2>
            <p class="onapp__lead r" style="--d:.1s">
              Everything above is studio work. Some images need an art
              director, and plenty don&rsquo;t. For the second kind, your own
              team can make the pictures in hubStudio, our app, and pay only
              for what it runs.
            </p>
            <p class="onapp__p r" style="--d:.14s">
              The Image studio does three jobs: text to image, editing up to
              four of your own pictures (depending on the engine), and
              upscaling or restoring a picture. It renders up to 4K and one to
              ten images a run. You set the shape and the format, and add a
              transparent background or a mask when you need one.
              &ldquo;Improve with AI&rdquo; rewrites your prompt for the engine
              you picked.
            </p>
            <p class="onapp__p r" style="--d:.18s">
              Engines come from OpenAI, Google, Black Forest Labs, ByteDance,
              Meta and others, and you can browse them all in Explore: ChatGPT
              Image 2, Nano Banana 2 and Pro, FLUX, Seedream and more as they
              ship. They differ, so it pays to test two on the same prompt.
              Each run shows its price before it starts, and it&rsquo;s paid
              from a prepaid balance.
            </p>
            <div class="onapp__cta r" style="--d:.22s">
              <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
              <a class="ghost-link" href={`${HELP_URL}/create-an-image`}>
                How the Image studio works
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
          <div class="onapp__media onapp__shots">
            <div class="r" style="--d:.1s">
              <AppShot shot={appShots.imageStudio} path="/content/image-generate" caption />
            </div>
            <div class="r" style="--d:.16s">
              <AppShot shot={appShots.explore} path="/explore" caption />
            </div>
          </div>
        </div>

        <div class="adds">
          <div class="adds__col r">
            <p class="adds__tag">In the app</p>
            <h3 class="adds__title">Your team decides.</h3>
            <ul class="adds__list">
              {appSide.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div class="adds__col adds__col--studio r" style="--d:.08s">
            <p class="adds__tag">With the studio</p>
            <h3 class="adds__title">What we add.</h3>
            <ul class="adds__list">
              {studioSide.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
        <p class="onapp__p onapp__both r">
          Or both at once: our studio can make the work inside hubStudio, and
          you approve it there.
          <a class="inline-link" href="/studio/with-the-app">How Studio + app works</a>.
        </p>
      </div>
    </section>

    <WaysToWork tone="cream" highlight="studio-app" />

    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/hubstudio-shanghai-studio.webp"
                alt="A wide view of the hubStudio Shanghai floor with editorial daylight, calibrated stations and image proofs pinned along the back wall."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">Asset by asset</span>
            <span class="source__stat-cap">Shot, generated or both, decided image by image</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Studio execution<br />at AI <span class="serif">speed</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            We bring an agency&rsquo;s instincts and a production floor that
            runs AI every day, under one roof.
          </p>
          <p class="source__p r" style="--d:.16s">
            For work you brief to us, our studio trains models on your brand
            and runs them on its own GPU pipelines. The team that runs them is
            the team that art-directs your work.
          </p>
          <p class="source__p r" style="--d:.22s">
            Choose how you receive it. With Studio only, you get finished files
            and need no account. Choose Studio + app and you review, comment
            on and approve the work in hubStudio.
          </p>
          <p class="source__p r" style="--d:.25s">
            The work we&rsquo;ve shipped is on the
            <a class="inline-link inline-link--light" href="/work">Work page</a>.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Brand-trained models
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Provenance per asset
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Senior art direction
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              NDA in place
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">brief</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions brand and performance leads ask before we begin.
            If yours is not below, put it in the brief.
          </p>
          <p class="faq__fresh r" style="--d:.13s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={briefHref}>Start an image brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <InsightsLayer placement="aiImage" tone="white" id="reading" />

    <DualCta
      eyebrow="Build with us"
      pre="Brief us, or open the "
      accent="app"
      post="."
      text="Send a campaign brief, a content gap or the channel you keep underfeeding. A producer reads it within one business day, and a written proposal follows within 48 hours. Or open the app and make the first images yourself."
      lead="studio"
      briefQuery="way=studio"
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }
  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }
  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }
  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.82fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
