  @media (prefers-reduced-motion: reduce) { .hero__title .line__i { transform: none; } }
  .hero__tag { margin-top: 26px; font-size: clamp(18px, 1.5vw, 23px); font-weight: 600; letter-spacing: -0.02em; }
