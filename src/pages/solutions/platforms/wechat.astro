---
/**
 * WeChat · /solutions/platforms/wechat
 *
 * Editorial layout adapted from /solutions/platforms/meta. Same print-shop
 * primitives (crop marks, calibration colour bar, mono figure labels, dashed
 * rules) reframed for WeChat: the four surfaces we ship creative into, the
 * AIGC mechanics for each, the partnership model.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 4, suffix: '', label: 'Lanes we ship', note: 'Content, ad creative, Channels, storefront' },
  { from: 0, to: 50, suffix: '+', label: 'Variations per concept', note: 'From one signed-off master' },
  { from: 0, to: 48, suffix: 'h', label: 'Brief to first cut', note: 'On Moments ads and Channels' },
];

const samples = [
  {
    src: '/Images/wechat-sample-a.jpg',
    kind: 'Content · OA article',
    alt: 'A vertical phone held in soft window light, the screen showing an open WeChat Official Account article with a wide cover image and the article headline stacked above warm editorial body text.',
  },
  {
    src: '/Images/wechat-sample-b.jpg',
    kind: 'Ad creative · Moments',
    alt: 'A phone screen showing the WeChat Moments feed, a sponsored brand card with image, advertiser name and a call-to-action button sitting between two personal posts.',
  },
  {
    src: '/Images/wechat-sample-c.jpg',
    kind: 'Ad creative · Channels',
    alt: 'A phone screen showing a WeChat Channels video, a sponsored in-feed ad frame of a skincare product with the advertiser label and an action button along the lower interface.',
  },
  {
    src: '/Images/wechat-sample-d.jpg',
    kind: 'Channels · Short-form',
    alt: 'A phone held vertically, the screen showing a WeChat Channels video paused mid-frame, the like, comment and share rail running up the right edge of the interface.',
  },
  {
    src: '/Images/wechat-sample-e.jpg',
    kind: 'Storefront · Mini Program',
    alt: 'A phone screen showing a WeChat Mini Program storefront, a campaign banner above a grid of product cards, the rounded capsule menu visible in the top corner of the interface.',
  },
];

const coverage = [
  {
    fig: 'B',
    label: 'Content',
    heading: 'Content. Official Account articles and feed.',
    image: '/Images/wechat-content.jpg',
    alt: 'A phone held in both hands, the screen filled with an open WeChat Official Account article, the cover image and headline at the top and an in-article image stack below, the WeChat chrome visible across the top of the screen.',
    lead: 'Editorial-grade Official Account articles, written and designed by the studio for the surface readers actually open.',
    body: [
      "We write, art-direct and build the graphic articles that carry a WeChat Official Account: a cover that earns the tap from a crowded subscription list, a headline that survives the feed, an article laid out as a piece of editorial design rather than a wall of pasted screenshots. Long-form brand storytelling, product features, launch announcements and seasonal pieces, each one set to the brand book.",
      "Copy is written by native Mandarin writers who publish on WeChat every week, never run through a translation of an English draft. The article is finished image by image, retouched by the same hand as the campaign hero, and delivered ready to schedule. The cadence rises, the brand line does not move.",
    ],
    tags: [
      'Service Account articles', 'Subscription posts', 'Cover design',
      'Long-form features', 'Launch announcements', 'Seasonal editorials',
      'Article image sets', 'Always-on calendar',
    ],
  },
  {
    fig: 'C',
    label: 'Ad creative',
    heading: 'Ad creative. Built for Tencent Ads.',
    image: '/Images/wechat-ads.jpg',
    alt: 'A wide monitor showing the Tencent Ads creative library, a grid of WeChat Moments and Channels ad variants lined up in the placement preview panel.',
    lead: 'Performance creative produced for every Tencent Ads surface, at the volume the buying actually wants.',
    body: [
      "Moments ads that read as native to the feed rather than an interruption in it. Channels in-feed video built to hold past the first second. Banner placements, Mini Program ads and search creative, all briefed around the placement set the media team is buying. We produce the format diversity the auction needs and the naming conventions the downstream reporting expects.",
      "Conversion frames, catalogue cards, hook-tested Channels cuts and lead-gen units all run through the same studio pass, so the long tail of variants looks like the hero rather than a thinned-out clone of it.",
    ],
    tags: [
      'Moments ads', 'Channels in-feed', 'Banner placements',
      'Mini Program ads', 'Search creative', 'Catalogue cards',
      'Hook A/B testing', 'Retargeting variants',
    ],
  },
  {
    fig: 'D',
    label: 'Channels',
    heading: 'Channels. Short-form video and livestream.',
    image: '/Images/wechat-video.jpg',
    alt: 'A phone screen showing a WeChat Channels video paused mid-frame, the vertical video interface with the like, comment and share rail running up the right edge.',
    lead: 'Short-form video and livestream creative for WeChat Channels, scripted and finished end to end.',
    body: [
      "We script, produce and edit the organic side of a Channels presence: short videos built to hold attention from the opening frame, livestream creative with lower-thirds, product cards and overlays that match the brand, replay cuts and highlight clips that keep working after the stream ends. Channels links straight to the Official Account and the Mini Program, so every video is built to carry a viewer onward.",
      "The work is signed off by a creative director, graded in the studio and shipped in the vertical format Channels serves. Optional brand-owned avatar presenters host the clips and the livestreams in any language, so the cast never has to be re-booked.",
    ],
    tags: [
      'Short-form video', 'Livestream creative', 'Lower-thirds and overlays',
      'Replay highlight cuts', 'Product card frames', 'Avatar presenters',
      'Vertical edits', 'Always-on calendar',
    ],
  },
  {
    fig: 'E',
    label: 'Storefront',
    heading: 'Storefront. Mini Program, designed to sell.',
    image: '/Images/wechat-miniprogram.jpg',
    alt: 'A phone screen showing a WeChat Mini Program storefront, a campaign banner above a grid of product cards, the rounded capsule menu in the top corner of the interface.',
    lead: 'The visual design of a Mini Program storefront: covers, banners, product cards and campaign skins, on-brand and built to convert.',
    body: [
      "A Mini Program is a brand's owned commerce surface inside WeChat, and it should look authored rather than assembled from a template. We design the storefront's visual system: the home banner, the category tiles, the product card grid, the campaign landing skins, the seasonal refresh. Product and lifestyle imagery is shot or generated to fill it, sized to the exact frames the Mini Program serves.",
      "We design the look and produce the imagery; your developers ship the build. Every campaign gets a matching storefront skin, so a launch that runs on Moments lands on a storefront designed inside the same brief.",
    ],
    tags: [
      'Home banners', 'Category tiles', 'Product card imagery',
      'Campaign landing skins', 'Seasonal refreshes', 'Lifestyle photography',
      'Promo modules', 'Brand-book system',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to lock the goal, audience, WeChat surfaces in scope, brand truth and no-go zones. Output is a one-page strategic brief and an asset map by surface and by service lane.',
    image: '/Images/wechat-p1-brief.jpg',
    alt: 'A creative director and a brand lead at a studio table, a laptop between them showing the WeChat Official Account dashboard alongside printed Moments and Channels screenshots.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction across the four lanes.',
    body: 'Visual references locked, tone defined, the editorial voice set for the Official Account, AIGC and avatar model selection made per surface. Content, ad creative, Channels and storefront each get their own treatment. This is where a campaign becomes ownable.',
    image: '/Images/wechat-p2-direction.jpg',
    alt: 'A storyboard wall with four columns of frame sketches labelled Content, Ads, Channels and Storefront, each column anchored by a printed WeChat phone mock.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Per-lane generation across the agreed surfaces. Every output goes through the studio retouch and brand-check pass before any media plan or publishing calendar sees it.',
    image: '/Images/wechat-p3-aigc.jpg',
    alt: 'A motion designer at a calibrated workstation, the main monitor showing a single WeChat Channels hero frame, the side panel showing the Tencent Ads creative library grid of variants.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-surface, per-market.',
    body: 'Assets handed over in the formats WeChat actually serves: article image sets ready to schedule, Moments and Channels ads named for Tencent Ads, storefront skins sized to the Mini Program frames. Tracking and creative naming built for downstream reporting.',
    image: '/Images/wechat-p4-launch.jpg',
    alt: 'A media buyer at a daylit studio desk, the calibrated monitor showing the Tencent Ads campaign dashboard with WeChat Moments ad placements live.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Variants, refresh, season.',
    body: 'Once the hero is signed off, the variant cascade lands in days. New audiences, new cities, new festivals, new seasons. The brief stays the same, the variants compound.',
    image: '/Images/wechat-p5-adapt.jpg',
    alt: 'A colourist at a calibrated grading suite, the main reference monitor showing a warm WeChat Channels frame paused on a product still, the Channels interface elements visible at the screen edges.',
  },
];

const faqs = [
  {
    q: 'What exactly do you produce for WeChat?',
    a: 'Four lanes, one studio. Content covers Official Account articles, from the cover image to the full editorial layout, for both Service and Subscription accounts. Ad creative covers Moments ads, Channels in-feed video, banner and Mini Program placements built for Tencent Ads. Channels covers short-form video and livestream creative for the WeChat Channels surface. Storefront covers the visual design of a Mini Program: banners, product cards and campaign skins. The four lanes share one creative direction and one finishing pass, so the long tail looks like the hero.',
  },
  {
    q: 'Who writes the Official Account articles?',
    a: 'Native Mandarin writers who publish on WeChat every week, not translators working from an English document. An article is written for the surface from the first line: a cover that earns the tap, a headline that survives a crowded subscription list, an editorial layout designed image by image rather than pasted together. The English brief sets the strategy; the article itself is authored in Chinese for a Chinese reader.',
  },
  {
    q: 'What does the Storefront lane actually cover?',
    a: 'The visual design and the imagery, not the back end. We design the Mini Program storefront system, the home banner, the category tiles, the product card grid, the campaign landing skins, and we shoot or generate the product and lifestyle imagery that fills it, sized to the frames the Mini Program serves. Your team or your developer handles registration, verification and the build; we hand over a finished design and a full image set.',
  },
  {
    q: 'Can you produce Channels video at the volume our plan needs?',
    a: 'Yes. A single hero shoot or AIGC sprint produces the master, and the variant cascade lands per audience and per city inside days. The cost-per-variation curve flattens fast: the first variant is expensive, the fiftieth is close to free. Custom-trained LoRA models on your brand keep every frame on-brand, and optional avatar presenters mean a refresh never needs a re-shoot.',
  },
  {
    q: 'How do you keep the brand line consistent across the four lanes?',
    a: 'The hero concept is signed off once, in the direction step. After that, every variant in every lane runs through the same retouch pass, the same colour grade and the same brand-safety check. The studio is what keeps articles, ad creative, Channels video and storefront design reading like one campaign rather than four parallel ones.',
  },
  {
    q: 'What is your turnaround for a Moments ad or a Channels cut?',
    a: 'Short-form creative on an existing brand can be brief to first cut in 24 to 72 hours. A new brand or a new product takes a one-time onboarding to lock the treatment, the LoRA models and the avatar; after that, weekly drops at production-grade quality are the working tempo. Trend-reactive pieces can turn around inside a day or two when the calendar calls for it.',
  },
  {
    q: 'Do you handle Tencent Ads placements and dynamic creative?',
    a: 'Yes. We brief the ad creative lane around the placement set the media team is buying across Tencent Ads, including Moments, Channels, banner and Mini Program units. Variants are produced with the format diversity dynamic creative needs and named so the reporting downstream stays legible. We produce and finish the creative; the media buying itself stays with whoever runs your account.',
  },
  {
    q: 'How do you keep the work from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, grain, chromatic aberration and a colour grade in Lightroom or Capture One. The image style guide rules out the AI tells: poreless skin, identical bokeh, melted product detail, almost-but-not-quite text. The final file passes a human review before any media plan or publishing calendar sees it. This is what closes the gap between an AI image and a campaign image.',
  },
  {
    q: 'Can you white-label this for our agency?',
    a: 'Yes. A significant share of our WeChat work runs under agency brands, with full white-label delivery and confidential collaboration. The agency owns the relationship and the client communication; we deliver the production capability behind it.',
  },
  {
    q: 'Who owns the assets, the masters and the trained models?',
    a: 'You own all finished assets, all masters, and any LoRA, fine-tuned or avatar models trained on your IP. Commercial use rights for AIGC outputs are routed through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="WeChat AIGC: Official Account, Channels & Moments Creative at Scale"
  description="AIGC for WeChat. Official Account articles, Moments ads, Channels video and Mini Program storefront design, produced inside a working studio. One brief, every surface."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- S1 · HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> WeChat
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Four lanes,</span></span>
            <span class="line"><span class="line__i serif">one WeChat brief.</span></span>
            <span class="line"><span class="line__i">AIGC, in scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Content. Ad creative. Channels. <em>Storefront.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We ship four kinds of work into WeChat: editorial articles for
              the Official Account; performance ad creative for Tencent Ads;
              short-form video and livestream for Channels; and the visual
              design of a Mini Program storefront.
            </p>
            <p>
              One brief, four lanes, every surface. One hero direction, fifty
              market variants. AIGC inside a working production company, not in
              place of one.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> WeChat-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/wechat-hero.jpg"
          alt="A close editorial portrait of a hand holding a phone in warm rim light, the phone screen filled with an open WeChat Official Account article showing the wide cover image and the stacked article headline."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> WeChat</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- S2 · WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              What we ship<br /><span class="serif">into WeChat</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              We do four kinds of work for WeChat, end to end. Editorial
              articles for the Official Account, written by native Mandarin
              hands. Paid ad creative built for every Tencent Ads surface.
              Short-form video and livestream for Channels. The visual design
              of a Mini Program storefront, sized to the frames it serves.
            </p>
            <p class="r" style="--d:.16s">
              One creative direction sits across all four. The same studio
              hands that retouch the hero finish every variant in every lane,
              so the long tail looks like the campaign rather than a thinned
              clone of it.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/wechat-roots.jpg"
              alt="A wide editorial shot of two designers at a daylit studio table, four laptop screens lined up showing a WeChat Official Account article, the Tencent Ads creative library, a WeChat Channels video feed and a Mini Program storefront, one per service lane."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Four lanes, one creative direction</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            One WeChat brief, four service lanes, every surface. Articles, ad
            creative, Channels and storefront finished by the same studio
            hands, with fifty-plus variants per concept and brief to first cut
            inside forty-eight hours on short-form work.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S3 · COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Four lanes, one <span class="serif">brand line</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} surface</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Surface</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- S4 · PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Articles, Moments ads, Channels cuts and storefront stills produced
            through the studio pipeline. Every frame is authored work, sized
            for the surface it ships on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S5 · PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/wechat-hybrid-main.jpg"
                alt="A producer at a wide reference monitor showing the Tencent Ads creative library, four columns of WeChat ad variants tagged Content, Ads, Channels and Storefront."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/wechat-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand holding a phone vertically against a soft cream background, the screen filled with an open WeChat Official Account article showing the cover image and the article header."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Four lanes, every surface, every market</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Authored creative, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The WeChat brands compounding their results in 2026 are not the
            ones with the loudest stack. They are the ones running an authored
            creative process with AIGC inside it.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit between the technical and the creative: a working studio
            with directors, writers, retouchers and colourists alongside the
            AIGC engineers and the LoRA-training pipeline. Every variant ships
            with the same brand discipline as the hero, because the same hands
            sign it off.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in mainland
            China, Hong Kong, the EU or the US depending on your data
            sovereignty position. Custom-trained LoRA models stay your
            property and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            We pick up where you need us and step back where you do not.
          </p>
        </div>
      </div>
    </section>

    <!-- S6 · PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a WeChat campaign runs</p>
        <h2 class="dh r" style="--d:.05s">
          One brief,<br />every <span class="serif">surface</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Articles, Moments ads, Channels video and storefront design share
          the same brand line, and the same process. The format changes; the
          discipline stays the same. The work is won in the direction, not in
          the launch.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- S7 · FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S8 · CLOSE -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the WeChat brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          A surface-by-surface recommendation, a scope outline, an indicative
          timeline and a few free article or Channels frames so you can see
          the thinking before any budget commits.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Send the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }

  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }

  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }

  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
