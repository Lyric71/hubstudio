---
/**
 * WeChat · /solutions/platforms/wechat
 *
 * Editorial layout adapted from /solutions/platforms/meta. Same print-shop
 * primitives (crop marks, calibration color bar, mono figure labels, dashed
 * rules) reframed for WeChat: the four surfaces we ship creative into, the
 * AIGC mechanics for each, the partnership model.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 *
 * Page excerpt (25 words): hubStudio produces WeChat creative across four
 * surfaces: Official Account articles, Tencent Ads, Channels video, and Mini
 * Program storefronts. One brief, one creative direction, every market.
 *
 * Two attributed blockquote citations (Tencent results) carry the external
 * data points; both use the .cite component. Copy reviewed early 2026.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 4, suffix: '', label: 'Lanes we ship', note: 'Content, ad creative, Channels, storefront' },
  { from: 0, to: 50, suffix: '+', label: 'Variations per concept', note: 'From one signed-off master' },
  { from: 0, to: 48, suffix: 'h', label: 'Brief to first cut', note: 'On Moments ads and Channels' },
];

const samples = [
  {
    src: '/Images/wechat-sample-a.jpg',
    kind: 'Content · OA article',
    alt: 'A vertical phone held in soft window light, the screen showing an open WeChat Official Account article with a wide cover image and the article headline stacked above warm editorial body text.',
  },
  {
    src: '/Images/wechat-sample-b.jpg',
    kind: 'Ad creative · Moments',
    alt: 'A phone screen showing the WeChat Moments feed, a sponsored brand card with image, advertiser name and a call-to-action button sitting between two personal posts.',
  },
  {
    src: '/Images/wechat-sample-c.jpg',
    kind: 'Ad creative · Channels',
    alt: 'A phone screen showing a WeChat Channels video, a sponsored in-feed ad frame of a skincare product with the advertiser label and an action button along the lower interface.',
  },
  {
    src: '/Images/wechat-sample-d.jpg',
    kind: 'Channels · Short-form',
    alt: 'A phone held vertically, the screen showing a WeChat Channels video paused mid-frame, the like, comment and share rail running up the right edge of the interface.',
  },
  {
    src: '/Images/wechat-sample-e.jpg',
    kind: 'Storefront · Mini Program',
    alt: 'A phone screen showing a WeChat Mini Program storefront, a campaign banner above a grid of product cards, the rounded capsule menu visible in the top corner of the interface.',
  },
];

const coverage = [
  {
    fig: 'B',
    label: 'Content',
    heading: 'Content. Articles for the Official Account.',
    image: '/Images/wechat-content.jpg',
    alt: 'A phone held in both hands, the screen filled with an open WeChat Official Account article, the cover image and headline at the top and an in-article image stack below, the WeChat chrome visible across the top of the screen.',
    lead: 'Official Account articles, written and designed in-house for a surface readers choose to open.',
    body: [
      "We write, art-direct, and build the articles that carry a WeChat Official Account. That means a cover good enough to earn the tap in a crowded subscription list, a headline that holds up in the feed, and a layout that reads as designed rather than pasted together. One month it is a long brand feature, the next a product launch or a seasonal piece. Either way, it stays inside the brand book.",
      "Native Mandarin writers handle the copy. They publish on WeChat every week, so they write for the platform from the first line, and nothing gets run through a translated English draft. We finish each article image by image, retouched by the same people who handle the campaign hero, then hand it over ready to schedule.",
    ],
    tags: [
      'Service Account articles', 'Subscription posts', 'Cover design',
      'Long-form features', 'Launch announcements', 'Seasonal editorials',
      'Article image sets', 'Always-on calendar',
    ],
  },
  {
    fig: 'C',
    label: 'Ad creative',
    heading: 'Ad creative. Built for Tencent Ads.',
    image: '/Images/wechat-ads.jpg',
    alt: 'A wide monitor showing the Tencent Ads creative library, a grid of WeChat Moments and Channels ad variants lined up in the placement preview panel.',
    lead: 'Performance creative for every Tencent Ads surface, made at the volume a real media plan burns through.',
    body: [
      "A Moments ad should look like it belongs between two friends' posts, not crash into the middle of them. Channels video has to hold attention through the first second or it loses the rest. We build banner placements, Mini Program ads, and search creative the same way, each one briefed around the exact placements the media team is buying.",
      "Conversion frames, catalog cards, hook-tested Channels cuts, retargeting units: all of it goes through the same studio finish as the hero ad. Files arrive named the way Tencent Ads and your reporting expect, so nobody downstream has to rename anything.",
    ],
    tags: [
      'Moments ads', 'Channels in-feed', 'Banner placements',
      'Mini Program ads', 'Search creative', 'Catalog cards',
      'Hook A/B testing', 'Retargeting variants',
    ],
  },
  {
    fig: 'D',
    label: 'Channels',
    heading: 'Channels. Video and livestream.',
    image: '/Images/wechat-video.jpg',
    alt: 'A phone screen showing a WeChat Channels video paused mid-frame, the vertical video interface with the like, comment and share rail running up the right edge.',
    lead: 'Short-form video and livestream creative for WeChat Channels, scripted, shot, and finished by one team.',
    body: [
      "We handle the organic side of a Channels presence. The short videos are built to hold attention from the opening frame. Livestreams come with lower-thirds, product cards, and overlays that match the brand, plus replay cuts and highlight clips that keep earning views after the stream ends. Because Channels links straight through to the Official Account and the Mini Program, every video is made to move the viewer somewhere next.",
      "A creative director signs off the work, it gets graded in the studio, and it ships vertical, the way Channels serves it. If you want, brand-owned avatar presenters can host the clips and the livestreams in any language, which means a seasonal refresh never sends anyone back to a booking agent.",
    ],
    tags: [
      'Short-form video', 'Livestream creative', 'Lower-thirds and overlays',
      'Replay highlight cuts', 'Product card frames', 'Avatar presenters',
      'Vertical edits', 'Always-on calendar',
    ],
  },
  {
    fig: 'E',
    label: 'Storefront',
    heading: 'Storefront. A Mini Program designed to sell.',
    image: '/Images/wechat-miniprogram.jpg',
    alt: 'A phone screen showing a WeChat Mini Program storefront, a campaign banner above a grid of product cards, the rounded capsule menu in the top corner of the interface.',
    lead: 'The visual design of a Mini Program storefront: covers, banners, product cards, and campaign skins, all on-brand and built to convert.',
    body: [
      "A Mini Program is the brand's own storefront inside WeChat, and it should not look like it came out of a template. We design the visual system for it, from the home banner and category tiles to the product grid and the campaign landing screens. Then we shoot or generate the product and lifestyle photography to fill it, sized to the exact frames the storefront serves.",
      "We design the look and produce the images. Your developers handle the build itself. Every campaign also gets a storefront skin to match, designed from the same brief as the ads sending traffic to it.",
    ],
    tags: [
      'Home banners', 'Category tiles', 'Product card imagery',
      'Campaign landing skins', 'Seasonal refreshes', 'Lifestyle photography',
      'Promo modules', 'Brand-book system',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to settle the goal, the audience, which WeChat surfaces are in scope, and what the brand will and will not do. You get back a one-page brief and an asset map broken out by surface and by lane.',
    image: '/Images/wechat-p1-brief.jpg',
    alt: 'A creative director and a brand lead at a studio table, a laptop between them showing the WeChat Official Account dashboard alongside printed Moments and Channels screenshots.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction across the four lanes.',
    body: 'We lock the visual references and set the editorial voice for the Official Account. AIGC and avatar models get chosen surface by surface. Content, ad creative, Channels, and storefront each get their own treatment, all of it under one direction.',
    image: '/Images/wechat-p2-direction.jpg',
    alt: 'A storyboard wall with four columns of frame sketches labeled Content, Ads, Channels and Storefront, each column anchored by a printed WeChat phone mock.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Now the generation runs, lane by lane, across the surfaces we agreed on. Every output still goes through the studio retouch and a brand check before a media plan or a publishing calendar ever sees it.',
    image: '/Images/wechat-p3-aigc.jpg',
    alt: 'A motion designer at a calibrated workstation, the main monitor showing a single WeChat Channels hero frame, the side panel showing the Tencent Ads creative library grid of variants.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-surface, per-market.',
    body: 'Assets are handed over in the formats WeChat actually uses: article image sets ready to schedule, Moments and Channels ads named for Tencent Ads, storefront skins cut to the Mini Program frames. Tracking and naming are set up so the reporting later makes sense.',
    image: '/Images/wechat-p4-launch.jpg',
    alt: 'A media buyer at a daylit studio desk, the calibrated monitor showing the Tencent Ads campaign dashboard with WeChat Moments ad placements live.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Variants, refresh, season.',
    body: 'Once the hero is approved, new variants land within days, for a new audience, another city, a festival, or the next season. The brief does not change, so each new batch is faster and cheaper than the one before it.',
    image: '/Images/wechat-p5-adapt.jpg',
    alt: 'A colorist at a calibrated grading suite, the main reference monitor showing a warm WeChat Channels frame paused on a product still, the Channels interface elements visible at the screen edges.',
  },
];

const faqs = [
  {
    q: 'What exactly do you produce for WeChat?',
    a: 'Four things, all under one studio. We write and design Official Account articles, for both Service and Subscription accounts. We build ad creative for Tencent Ads, across Moments, Channels in-feed, banner, and Mini Program placements. We script and produce Channels video and livestreams. And we design the look of a Mini Program storefront, down to the banners and product cards. One creative direction sits over all four.',
  },
  {
    q: 'Who writes the Official Account articles?',
    a: "Native Mandarin writers, not translators working off an English document. They publish on WeChat every week, so they write for the platform's habits from the first line. The brief can reach us in English; the article itself is written in Chinese, for a Chinese reader.",
  },
  {
    q: 'What does the Storefront lane actually cover?',
    a: 'Design and imagery, not the back end. We design the storefront system, the banners, the category tiles, the product grid, the campaign screens, and we shoot or generate the photography that fills it. What we do not do is the build. Registration, verification, and development stay with your team or your developer. You get a finished design and a full set of images, ready to drop in.',
  },
  {
    q: 'Can you produce Channels video at the volume our plan needs?',
    a: 'Yes. One hero shoot, or one AIGC sprint, produces the master. After that the variants come fast, sorted by audience and by city, usually within days. LoRA models trained on your brand keep every frame consistent, and the optional avatar presenters mean a refresh does not need another shoot.',
  },
  {
    q: 'How does pricing work?',
    a: 'Every project is scoped from the brief, so there is no public rate card. What it costs depends on which surfaces are in scope, how many variants you need, and whether the brand needs a one-time setup for LoRA models or an avatar. The more you order, the lower the cost per asset, since most of the work sits in the master and not the variants behind it. Send the brief and you get a written scope and an indicative figure back, usually within 48 hours.',
  },
  {
    q: 'How do you keep the brand line consistent across the four lanes?',
    a: 'The hero concept gets signed off once, during the direction step. From then on, every variant in every lane runs through the same retouch, the same color grade, and the same brand-safety check. That shared finish is what keeps the articles, the ads, the Channels video, and the storefront looking like a single campaign.',
  },
  {
    q: 'What is your turnaround for a Moments ad or a Channels cut?',
    a: 'For a brand we already work with, short-form creative runs about 24 to 72 hours from brief to first cut. A new brand or a new product needs a one-time setup first, to lock the treatment, train the LoRA models, and build the avatar. After that, a weekly drop at full production quality is the normal pace. When something is trending and the calendar calls for it, we can turn a piece around in a day or two.',
  },
  {
    q: 'Do you handle Tencent Ads placements and dynamic creative?',
    a: 'Yes. We brief the ad creative around whatever placements the media team is buying across Tencent Ads: Moments, Channels, banner, Mini Program. Dynamic creative needs a lot of format variety, and we produce it, named cleanly so the reporting stays readable afterward. We make and finish the creative. The media buying itself stays with whoever runs your account.',
  },
  {
    q: 'How do you keep the work from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, film grain, a little chromatic aberration, a color grade in Lightroom or Capture One. We keep a written image style guide that bans the usual AI tells, things like poreless skin, identical bokeh, melted product detail, and text that is almost but not quite real letters. A person reviews every final file before it goes anywhere near a media plan.',
  },
  {
    q: 'Can you white-label this for our agency?',
    a: "Yes, and a good share of our WeChat work already does. We deliver under your agency's brand, with NDAs in place, and we stay out of sight. You keep the client relationship and run the conversation. We are the production capacity behind it.",
  },
  {
    q: 'Who owns the assets, the masters and the trained models?',
    a: 'You do. That covers the finished assets, the masters, and any LoRA, fine-tuned, or avatar models trained on your IP. Commercial-use rights for AIGC output are handled through enterprise tiers that grant them. The Copyright and AI guide goes through the legal detail.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="WeChat AIGC: Content, Ads & Channels Creative | hubStudio"
  description="AIGC creative for WeChat: Official Account articles, Moments and Channels ads, and Mini Program storefront design from one studio, one brief."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- S1 · HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> WeChat
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Four lanes,</span></span>
            <span class="line"><span class="line__i serif">one WeChat brief.</span></span>
            <span class="line"><span class="line__i">AIGC, at scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Content. Ad creative. Channels. <em>Storefront.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We make four kinds of work for WeChat: editorial articles for
              your Official Account, paid ad creative for Tencent Ads,
              short-form video and livestreams for Channels, and the design of
              a Mini Program storefront.
            </p>
            <p>
              It all runs off one brief. A single creative direction holds the
              surfaces together, and one approved concept becomes around fifty
              versions, each tuned to a different city or market. The AI runs
              inside a working studio. People still direct it and sign off
              every frame.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> WeChat-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/wechat-hero.jpg"
          alt="A close editorial portrait of a hand holding a phone in warm rim light, the phone screen filled with an open WeChat Official Account article showing the wide cover image and the stacked article headline."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> WeChat</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- S2 · WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              What we ship<br /><span class="serif">into WeChat</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              WeChat behaves like four products inside one app. People read on
              the Official Account, scroll Moments, watch Channels, and shop in
              Mini Programs, mostly without switching to anything else. We make
              work for all four.
            </p>
            <p class="r" style="--d:.16s">
              A single creative direction sits over everything we make. The
              same studio hands that retouch the hero image also finish every
              variant behind it. That keeps the fiftieth ad looking like the
              brand, not a tired knockoff of the first.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/wechat-roots.jpg"
              alt="A wide editorial shot of two designers at a daylit studio table, four laptop screens lined up showing a WeChat Official Account article, the Tencent Ads creative library, a WeChat Channels video feed and a Mini Program storefront, one per service lane."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Four lanes, one creative direction</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__lead r">
            Start with the audience. Its scale is the one thing about WeChat
            that nobody disputes.
          </p>
          <blockquote class="cite r" style="--d:.08s">
            <p>
              Combined monthly active users of Weixin and WeChat reached 1.41
              billion as of September 30, 2025.
            </p>
            <cite>Tencent Holdings, Q3 2025 results</cite>
          </blockquote>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S3 · COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Four lanes, one <span class="serif">brand line</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} surface</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Surface</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- S4 · PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            A selection of finished work: articles, Moments ads, Channels cuts,
            and storefront stills, all run through the studio. Each frame is
            authored, and sized for the surface it runs on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S5 · PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/wechat-hybrid-main.jpg"
                alt="A producer at a wide reference monitor showing the Tencent Ads creative library, four columns of WeChat ad variants tagged Content, Ads, Channels and Storefront."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/wechat-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand holding a phone vertically against a soft cream background, the screen filled with an open WeChat Official Account article showing the cover image and the article header."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Four lanes, every surface, every market</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Authored creative, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Right now, plenty of brands have AI tools for WeChat. Fewer have
            kept a real creative process around those tools. The ones that did
            tend to be the ones getting results, because the tooling was never
            the hard part.
          </p>
          <p class="source__p r" style="--d:.14s">
            WeChat is also where the ad money is heading. Tencent's own results
            say as much, and Channels, which the company reports under the name
            Video Accounts, is a big part of why.
          </p>
          <blockquote class="cite r" style="--d:.18s">
            <p>
              Marketing-services revenue rose 19% in 2025, lifted by higher ad
              impressions as user engagement grew on Video Accounts and Weixin
              Search.
            </p>
            <cite>Tencent Holdings, full-year 2025 results</cite>
          </blockquote>
          <p class="source__p r" style="--d:.22s">
            We are a working studio before anything else. Directors, writers,
            retouchers, and colorists sit next to the AIGC engineers, the
            people who run the AI image and video generation. Nothing goes
            straight from a model to a client. Every file gets the same review
            the hero shot does.
          </p>
          <ul class="creds r" style="--d:.28s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.32s">
            Everything runs on private infrastructure. You choose where it is
            hosted, in mainland China, Hong Kong, the EU, or the US, depending
            on where your data needs to sit. The LoRA models we train, small
            add-on models that teach the AI your brand's look, stay your
            property, and you can take them with you if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.36s">
            We do as much or as little of this as you need.
          </p>
        </div>
      </div>
    </section>

    <!-- S6 · PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a WeChat campaign runs</p>
        <h2 class="dh r" style="--d:.05s">
          One brief,<br />every <span class="serif">surface</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Articles, Moments ads, Channels video, and storefront design all run
          through the same process. The format at the end of it changes, but
          the steps to get there do not. Most of the outcome is settled early,
          in the brief and the creative direction.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps decide most of it. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- S7 · FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="faq__main">
          <div class="acc">
            {
              faqs.map((faq) => (
                <div class="acc__row r">
                  <button class="acc__q" type="button" aria-expanded="false">
                    <span class="acc__qmark">Q</span>
                    <span class="acc__qtext">{faq.q}</span>
                    <span class="acc__icon" aria-hidden="true">
                      <span></span><span></span>
                    </span>
                  </button>
                  <div class="acc__a">
                    <div class="acc__a-inner">
                      <p>
                        {faq.link ? (
                          <>
                            {faq.a.split(faq.link.match)[0]}
                            <a href={faq.link.href}>{faq.link.match}</a>
                            {faq.a.split(faq.link.match)[1]}
                          </>
                        ) : (
                          faq.a
                        )}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="faq__updated r">
            WeChat platform and ad-format details on this page were last
            reviewed in early 2026.
          </p>
        </div>
      </div>
    </section>

    <!-- S8 · CLOSE -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the WeChat brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          You get a recommendation surface by surface, a scope outline, a rough
          timeline, and a few sample article or Channels frames, free, so you
          can see how we think before you commit a budget.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Send the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }

  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }

  /* Attributed citation, shared by the Why and Partnership sections */
  .cite { margin: clamp(22px, 3vw, 30px) 0; max-width: 56ch; display: grid; gap: 13px; padding-left: clamp(18px, 2vw, 26px); border-left: 2px solid var(--brand-orange); }
  .cite p { font-family: var(--font-serif); font-style: italic; font-size: clamp(19px, 1.9vw, 25px); line-height: 1.44; color: var(--text-on-dark); }
  .cite cite { font-family: var(--font-mono); font-style: normal; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(240, 237, 233, 0.55); }

  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }

  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.82fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
  }
  .band__note { font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }

  .cbar { display: flex; height: 12px; }
  .cbar span { flex: 1; }
  .cbar--end { margin-top: clamp(60px, 8vw, 110px); }

  /* Hero */
  .hero { display: grid; background: var(--ink); color: var(--text-on-dark); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1fr; } }
  .hero__panel { position: relative; display: flex; align-items: center; padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px); overflow: clip; }
  .hero__reg { position: absolute; width: clamp(240px, 28vw, 420px); right: -12%; bottom: -14%; color: rgba(240, 237, 233, 0.055); pointer-events: none; }
  .hero__panel-in { position: relative; width: 100%; max-width: 600px; }
  .hero__title { margin-top: 24px; font-family: var(--font-sans); font-weight: 600; font-size: clamp(46px, 6.6vw, 92px); line-height: 1.02; letter-spacing: -0.045em; }
  .hero__title .line { display: block; overflow: hidden; padding: 0.22em 0.14em; margin: -0.22em -0.14em; }
  .hero__title .line__i { display: block; transform: translateY(145%); transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero__title .line:nth-child(1) .line__i { transition-delay: 0.12s; }
  .hero__title .line:nth-child(2) .line__i { transition-delay: 0.22s; }
  .hero__title .line:nth-child(3) .line__i { transition-delay: 0.32s; }
  .hero.in .hero__title .line__i { transform: translateY(0); }
  .hero__title .serif { font-size: 1.04em; }
  @media (prefers-reduced-motion: reduce) { .hero__title .line__i { transform: none; } }
  .hero__tag { margin-top: 26px; font-size: clamp(18px, 1.5vw, 23px); font-weight: 600; letter-spacing: -0.02em; }
  .hero__tag em { font-family: var(--font-serif); font-style: italic; font-weight: 500; color: var(--brand-orange); }
  .hero__lead { margin-top: 20px; display: grid; gap: 13px; max-width: 46ch; }
  .hero__lead p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.74); }
  .hero__cta { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .hero__meta { margin-top: 34px; padding-top: 20px; border-top: 1.5px dashed rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(240, 237, 233, 0.5); }
  .hero__meta span { color: var(--brand-orange); }
  .hero__visual { position: relative; overflow: hidden; min-height: 58vh; }
  @media (min-width: 900px) { .hero__visual { min-height: auto; } }
  .hero__visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero.in .hero__visual img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) { .hero__visual img { transform: none; } }
  .hero__chip { position: absolute; left: 18px; bottom: 18px; z-index: 2; display: inline-flex; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); background: rgba(14, 22, 51, 0.78); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-on-dark); }
  .hero__chip span { color: var(--brand-orange); }

  /* Why */
  .why { background: var(--ink); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .why__top { display: grid; gap: 30px; }
  @media (min-width: 900px) { .why__top { grid-template-columns: 1fr 1fr; gap: 70px; align-items: start; } }
  .why__head .dh { margin-top: 18px; }
  .why__text { display: grid; gap: 16px; align-content: start; padding-top: 6px; }
  .why__text p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.78); }
  .why__clients { color: rgba(240, 237, 233, 0.6) !important; }
  .why__clients strong { color: var(--text-on-dark); font-weight: 600; }
  .why__shot { margin-top: clamp(40px, 5vw, 72px); }
  .why__shot .crop__inner { aspect-ratio: 16 / 8; }
  .why__shot .fig { color: rgba(240, 237, 233, 0.5); }

  .stats { margin-top: clamp(48px, 6vw, 84px); border-top: 1.5px dashed rgba(240, 237, 233, 0.22); padding-top: clamp(36px, 4vw, 56px); }
  .stats__lead { max-width: 50ch; font-size: var(--type-body); line-height: 1.6; color: rgba(240, 237, 233, 0.78); margin-bottom: 24px; }
  .stats__grid { margin-top: 40px; display: grid; gap: 30px; }
  @media (min-width: 720px) { .stats__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .stat { display: grid; gap: 5px; padding-top: 24px; border-top: 1.5px solid rgba(240, 237, 233, 0.16); }
  .stat__num { font-size: clamp(56px, 7vw, 96px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--brand-orange); }
  .stat__label { margin-top: 6px; font-size: 16px; font-weight: 600; }
  .stat__note { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(240, 237, 233, 0.55); }

  /* Coverage */
  .cover { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .feature { display: grid; gap: 36px; align-items: center; padding-block: clamp(40px, 5vw, 72px); border-top: 1.5px dashed var(--line-strong); }
  .feature:last-child { border-bottom: 1.5px dashed var(--line-strong); }
  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1fr; gap: 72px; }
    .feature--rev .feature__media { order: 2; }
  }
  .feature__media .crop__inner { aspect-ratio: 5 / 4; }
  .feature__idx { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .feature__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .feature__body .dh { margin-top: 16px; }
  .feature__lead { margin-top: 14px; font-size: var(--type-lead); line-height: 1.42; color: var(--text-ink); font-weight: 500; }
  .feature__p { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .feature__scope { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line-hairline); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); }
  .chips { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); font-size: 12px; font-weight: 500; transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease; }
  .chip:hover { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }

  /* Proof */
  .proof { background: var(--bg-white); padding-block: clamp(80px, 10vw, 150px); }
  .sheet { display: grid; gap: clamp(22px, 3vw, 40px); }
  @media (min-width: 720px) {
    .sheet { grid-template-columns: repeat(3, 1fr); }
    .sheet .shot:nth-child(3n + 2) { margin-top: 60px; }
    .sheet .shot:nth-child(3n) { margin-top: 30px; }
  }
  .shot .crop__inner { aspect-ratio: 1 / 1; }
  .shot .crop__inner img { transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .shot:hover .crop__inner img { transform: scale(1.06); }
  .shot__cap { margin-top: 14px; display: flex; align-items: baseline; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .shot__kind { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-ink); }

  /* Partnership / Source */
  .source { background: var(--navy); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .source__grid { display: grid; gap: 52px; }
  @media (min-width: 940px) { .source__grid { grid-template-columns: 0.92fr 1.08fr; gap: 70px; align-items: center; } }
  .source__visual { position: relative; }
  .source__main .crop__inner { aspect-ratio: 5 / 4; }
  .source__inset { position: absolute; right: -14px; bottom: -34px; width: 42%; max-width: 200px; margin: 0; border-radius: 8px; overflow: hidden; border: 5px solid var(--navy); box-shadow: 0 20px 36px rgba(0, 0, 0, 0.42); }
  .source__inset img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  @media (max-width: 520px) { .source__inset { display: none; } }
  .source__stat { position: absolute; left: -10px; top: 36px; display: grid; gap: 3px; padding: 15px 19px; border-radius: 12px; background: var(--brand-orange); color: #fff; box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42); }
  .source__stat-num { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .source__stat-cap { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase; max-width: 15ch; line-height: 1.4; }
  .source__body .dh { margin-top: 16px; }
  .source__lead { margin-top: 20px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-on-dark); }
  .source__p { margin-top: 15px; font-size: var(--type-body); line-height: 1.66; color: rgba(240, 237, 233, 0.78); }
  .source__p--quiet { color: rgba(240, 237, 233, 0.55); }
  .creds { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 9px; }
  .cred { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); border: 1px solid rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 12px; font-weight: 500; transition: border-color 0.2s ease, background-color 0.2s ease; }
  .cred:hover { border-color: var(--brand-orange); background: rgba(233, 78, 27, 0.16); }
  .cred svg { width: 13px; height: 13px; color: var(--brand-orange); }

  /* Process */
  .craft { background: var(--paper); padding-top: clamp(80px, 10vw, 150px); }
  .craft__intro { max-width: 780px; margin-bottom: clamp(36px, 5vw, 60px); }
  .craft__intro .kicker { color: var(--brand-orange); }
  .craft__intro .dh { margin-top: 16px; }
  .craft__lede { margin-top: 18px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }
  .craft__note { margin-top: 22px; display: inline-block; padding: 13px 20px; border-left: 3px solid var(--brand-orange); background: rgba(233, 78, 27, 0.07); border-radius: 0 10px 10px 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--text-ink); }

  .seq__nav { display: none; }
  .seq__panels { display: grid; gap: clamp(48px, 7vw, 96px); padding-bottom: clamp(80px, 10vw, 150px); }
  .seq__panel { display: grid; gap: 28px; }
  @media (min-width: 760px) {
    .seq__panel { grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .seq__panel:nth-child(even) .seq__media { order: 2; }
  }
  .seq__media .crop__inner { aspect-ratio: 4 / 3; }
  .seq__tier { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .seq__title { margin-top: 12px; font-size: clamp(25px, 2.7vw, 38px); font-weight: 600; line-height: 1.12; letter-spacing: -0.025em; }
  .seq__body { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }

  .craft--pinned .seq { height: 480vh; }
  .craft--pinned .seq__stick { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; overflow: hidden; }
  .craft--pinned .seq__stage { width: 100%; display: flex; flex-direction: column; gap: clamp(22px, 3vw, 40px); }
  .craft--pinned .seq__nav { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .seq__step { display: flex; flex-direction: column; gap: 10px; padding: 0; background: transparent; border: none; text-align: left; cursor: pointer; }
  .seq__step-dot { height: 5px; border-radius: 3px; background: var(--line-strong); overflow: hidden; }
  .seq__step-fill { display: block; height: 100%; width: 100%; background: var(--brand-orange); transform: scaleX(0); transform-origin: 0 50%; }
  .seq__step-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-mute); transition: color 0.3s ease; }
  .seq__step[data-active='true'] .seq__step-label { color: var(--text-ink); }
  .craft--pinned .seq__panels { position: relative; display: block; height: clamp(340px, 60vh, 540px); padding-bottom: 0; }
  .craft--pinned .seq__panel { position: absolute; inset: 0; align-content: center; opacity: 0; visibility: hidden; transform: translateY(26px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.5s; }
  .craft--pinned .seq__panel[data-active='true'] { opacity: 1; visibility: visible; transform: none; transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .craft--pinned .seq__panel:nth-child(even) .seq__media { order: 0; }
  .craft--pinned .seq__media .crop__inner { aspect-ratio: auto; height: clamp(280px, 52vh, 460px); }
  @media (prefers-reduced-motion: reduce) { .craft--pinned .seq__panel { transition: none; } }

  /* FAQ */
  .faq { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .faq__grid { display: grid; gap: 44px; }
  @media (min-width: 1000px) {
    .faq__grid { grid-template-columns: 0.78fr 1.22fr; gap: 72px; align-items: start; }
    .faq__intro { position: sticky; top: 96px; }
  }
  .faq__intro .dh { margin-top: 18px; }
  .faq__sub { margin-top: 18px; margin-bottom: 26px; font-size: var(--type-body); line-height: 1.62; color: var(--text-mute); }
  .faq__updated { margin-top: 26px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .acc { display: grid; }
  .acc__row { border-top: 1.5px solid var(--ink); }
  .acc__row:last-child { border-bottom: 1.5px solid var(--ink); }
  .acc__q { width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 16px; padding: 26px 0; background: transparent; border: none; text-align: left; }
  .acc__qmark { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--brand-orange); padding-top: 3px; }
  .acc__qtext { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; color: var(--text-ink); transition: color 0.18s ease; }
  .acc__q:hover .acc__qtext { color: var(--brand-orange); }
  .acc__icon { position: relative; width: 22px; height: 22px; margin-top: 2px; }
  .acc__icon span { position: absolute; top: 50%; left: 50%; width: 14px; height: 2px; border-radius: 2px; background: var(--text-ink); transform: translate(-50%, -50%); transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(90deg); }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(0deg); }
  .acc__q[aria-expanded='true'] .acc__icon span { background: var(--brand-orange); }
  .acc__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s ease; }
  .acc__q[aria-expanded='true'] + .acc__a { grid-template-rows: 1fr; }
  .acc__a-inner { overflow: hidden; }
  .acc__a-inner p { padding: 0 0 26px 41px; max-width: 64ch; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .acc__a-inner a { color: var(--brand-orange); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  /* Close */
  .end { position: relative; background: var(--ink); color: var(--text-on-dark); padding-top: clamp(80px, 11vw, 150px); overflow: clip; }
  .end__reg { position: absolute; width: clamp(300px, 36vw, 560px); top: -16%; right: -9%; color: rgba(240, 237, 233, 0.05); pointer-events: none; }
  .end__inner { position: relative; display: grid; justify-items: start; gap: 22px; }
  .end__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(40px, 6.6vw, 96px); line-height: 0.98; letter-spacing: -0.04em; }
  .end__p { max-width: 54ch; font-size: var(--type-lead); line-height: 1.5; color: rgba(240, 237, 233, 0.78); }
  .end__cta { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const progBar = document.querySelector<HTMLElement>('.prog__bar');
  if (progBar) {
    const onScroll = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      progBar.style.transform = `scaleX(${max > 0 ? Math.min(1, d.scrollTop / max) : 0})`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  const revealEls = document.querySelectorAll('.r, .r-clip, .hero');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -7% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  const nums = Array.from(document.querySelectorAll<HTMLElement>('.stat__num'));
  const runCount = (el: HTMLElement) => {
    const from = Number(el.dataset.from || 0);
    const to = Number(el.dataset.to || 0);
    const suffix = el.dataset.suffix || '';
    if (reduceMotion.matches) {
      el.textContent = `${to}${suffix}`;
      return;
    }
    const dur = 1500;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = `${Math.round(from + (to - from) * eased)}${suffix}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && nums.length) {
    const io2 = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runCount(e.target as HTMLElement);
            io2.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((n) => io2.observe(n));
  } else {
    nums.forEach(runCount);
  }

  const craft = document.getElementById('craft');
  const seq = document.getElementById('seq');
  if (craft && seq) {
    const steps = Array.from(seq.querySelectorAll<HTMLElement>('.seq__step'));
    const panels = Array.from(seq.querySelectorAll<HTMLElement>('.seq__panel'));
    const fills = steps.map((s) => s.querySelector<HTMLElement>('.seq__step-fill'));
    const n = panels.length;
    const wide = window.matchMedia('(min-width: 880px)');

    const setActive = (idx: number, sub: number) => {
      panels.forEach((p, i) => (p.dataset.active = String(i === idx)));
      steps.forEach((s, i) => {
        s.dataset.active = String(i === idx);
        const f = fills[i];
        if (f) f.style.transform = `scaleX(${i < idx ? 1 : i === idx ? sub : 0})`;
      });
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      if (!craft.classList.contains('craft--pinned')) return;
      const total = seq.offsetHeight - window.innerHeight;
      const scrolled = Math.min(total, Math.max(0, -seq.getBoundingClientRect().top));
      const p = total > 0 ? scrolled / total : 0;
      const exact = p * n;
      const idx = Math.min(n - 1, Math.floor(exact));
      const sub = Math.min(1, Math.max(0, exact - idx));
      setActive(idx, idx === n - 1 ? 1 : sub);
    };
    const onScrollSeq = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const applyMode = () => {
      if (wide.matches && !reduceMotion.matches) {
        craft.classList.add('craft--pinned');
        update();
      } else {
        craft.classList.remove('craft--pinned');
        panels.forEach((p) => (p.dataset.active = 'true'));
      }
    };

    steps.forEach((s, i) => {
      s.addEventListener('click', () => {
        if (!craft.classList.contains('craft--pinned')) return;
        const railTop = seq.getBoundingClientRect().top + window.scrollY;
        const total = seq.offsetHeight - window.innerHeight;
        window.scrollTo({
          top: railTop + ((i + 0.5) / n) * total,
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
        });
      });
    });

    window.addEventListener('scroll', onScrollSeq, { passive: true });
    window.addEventListener('resize', () => {
      applyMode();
      update();
    });
    applyMode();
  }

  const accQs = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc__q'));
  accQs.forEach((q) => {
    q.addEventListener('click', () => {
      const open = q.getAttribute('aria-expanded') === 'true';
      accQs.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      q.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
