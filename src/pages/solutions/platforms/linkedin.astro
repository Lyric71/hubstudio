---
/**
 * LinkedIn · /solutions/platforms/linkedin
 *
 * Editorial layout adapted from /services/design/video-production. Same
 * print-shop primitives reframed for B2B: thought leadership, precision
 * advertising and the long buyer journey.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 252, suffix: '%', label: 'Higher CTR', note: 'Thought Leader Ads vs standard formats' },
  { from: 0, to: 113, suffix: '%', label: 'Higher ROAS', note: 'LinkedIn vs other paid social' },
  { from: 0, to: 30, suffix: '%', label: 'Lower cost per lead', note: 'Native integration vs generic creative' },
];

const samples = [
  {
    src: '/Images/li-sample-arden.jpg',
    brand: 'Arden',
    kind: 'Consulting · Portrait',
    alt: 'A close editorial portrait of a senior consultant in a charcoal blazer seated at a daylit oak desk, mid-sentence.',
  },
  {
    src: '/Images/li-sample-brent.jpg',
    brand: 'Brent',
    kind: 'Finance · Report',
    alt: 'A printed annual report and a leather notebook stacked on a warm oak desk, a black pen resting on top.',
  },
  {
    src: '/Images/li-sample-cardel.jpg',
    brand: 'Cardel',
    kind: 'Enterprise · Deal',
    alt: 'Two professionals shaking hands across a daylit oak table, framed from the wrists to mid-chest.',
  },
  {
    src: '/Images/li-sample-doran.jpg',
    brand: 'Doran',
    kind: 'SaaS · Dashboard',
    alt: 'A calibrated monitor on a daylit oak desk displaying a B2B dashboard with bar charts and a single hero metric.',
  },
  {
    src: '/Images/li-sample-erith.jpg',
    brand: 'Erith',
    kind: 'Industrial · Exec',
    alt: 'A close editorial portrait of a senior executive in a navy blazer leaning slightly forward at a daylit oak desk.',
  },
];

const coverage = [
  {
    label: 'Authority',
    heading: 'Thought leadership, on the surface that rewards it.',
    image: '/Images/li-thought.jpg',
    alt: 'An executive writing in a leather-bound notebook at a daylit oak desk, a printed long-form article draft beside the notebook.',
    lead: 'Carousel posts on LinkedIn achieve 11.2 times more impressions than text-only updates. The platform pays attention to brands that publish like media.',
    body: [
      "B2B buyers research for an average of 320 days before they sign. On a platform with 900 million professionals where roughly 80 percent sit in decision-making roles, that means a year of impressions that either compound your authority or train the buyer to ignore you.",
      "The studio produces the long-form editorial work the platform rewards: carousel essays, thought-leader op-eds, executive-voice video, on-brand visualisations and the kind of explainer assets that get sent inside a procurement chain. AIGC scales the variant cascade; the editorial pass keeps the voice trustworthy.",
    ],
    tags: [
      'Carousel essays', 'Executive op-eds', 'Thought-leader video',
      'Long-form posts', 'Newsletter editions', 'Live event assets',
      'Data visualisation', 'Annual-report-style decks',
    ],
  },
  {
    label: 'Ads',
    heading: 'Precision ads. Cost per lead, down.',
    image: '/Images/li-ads.jpg',
    alt: 'A B2B media planner at a daylit studio desk reviewing a calibrated monitor showing a LinkedIn campaign dashboard.',
    lead: 'LinkedIn campaigns deliver 113 percent higher ROAS than other paid social when the creative respects the surface.',
    body: [
      "LinkedIn ad inventory is expensive. The make-or-break is creative that matches the audience's posture and the placement's grammar: Sponsored Content, Document Ads, Conversation Ads, Lead Gen Forms, Thought Leader Ads. Each format has its own rules, its own pacing and its own conversion behaviour.",
      "The studio produces native-feeling B2B creative format by format, with the precision targeting metadata named so downstream reporting is legible. AIGC drives the per-audience variant volume; the studio sign-off keeps every piece on-brand. Buyers see one consistent voice across every touch in the 320-day journey.",
    ],
    tags: [
      'Sponsored Content', 'Document Ads', 'Thought Leader Ads',
      'Conversation Ads', 'Lead Gen Forms', 'Message Ads',
      'Video ads', 'ABM-tier targeting',
    ],
  },
  {
    label: 'Brand',
    heading: 'One voice, the whole funnel.',
    image: '/Images/li-authority.jpg',
    alt: 'Three professional speakers seated on a low stage at a small daylit conference room, one mid-sentence.',
    lead: 'Awareness, consideration and intent each ask for a different note. The brand voice has to read the same across all three.',
    body: [
      "The fastest way to lose a B2B buyer is to show them three different versions of the brand inside one quarter. Awareness creative that does not match the consideration deck, an executive op-ed that does not match the sales one-pager, a paid-ads voice that contradicts the company page tone.",
      "The studio runs the whole funnel as one editorial system. The brand book is shared across organic and paid, across owned and earned, across executive voice and house voice. AIGC scales the volume; the editorial discipline keeps the system coherent.",
    ],
    tags: [
      'Company-page strategy', 'Executive presence', 'Funnel-stage variants',
      'Event lead-up assets', 'Recruitment creative', 'Investor-grade visuals',
      'Internal launch decks', 'Sales-enablement collateral',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to lock the goal, audience, funnel stage, executive voice and brand truth. Output is a one-page strategic brief and an asset map by placement.',
    image: '/Images/li-p1-brief.jpg',
    alt: 'A creative director and a B2B brand lead at an oak studio table covered in printed long-form article references and a one-page brief.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction. Editorial and ads in parallel.',
    body: "Visual references locked, voice defined, carousel layouts drafted, executive-video treatment sketched, AIGC model selection made per surface. This is where the brand stops sounding like everyone else's LinkedIn page.",
    image: '/Images/li-p2-direction.jpg',
    alt: 'A storyboard wall with two columns of horizontal carousel frame sketches, one labelled Carousel and the other Video, pinned in sequence.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Per-placement generation across the agreed surfaces. Each output goes through the studio retouch and brand-check pass, with executive-voice scripts run past the brand lead before publication.',
    image: '/Images/li-p3-aigc.jpg',
    alt: 'A motion designer at a calibrated workstation reviewing a single editorial B2B carousel frame and a grid of variations on a side panel.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-segment, per-funnel stage.',
    body: 'Assets handed to the media team in the formats Campaign Manager actually serves, with naming, durations and targeting metadata matched to ABM tiers. Tracking and creative naming built for downstream reporting.',
    image: '/Images/li-p4-launch.jpg',
    alt: 'A B2B media planner at a daylit studio desk reviewing a printed campaign calendar beside a LinkedIn analytics dashboard.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Funnel-stage variants, weekly.',
    body: 'Once the hero is signed off, the variant cascade lands weekly. New segments, new objections, new product chapters, new conferences. The brief stays the same, the variants compound.',
    image: '/Images/li-p5-adapt.jpg',
    alt: 'A colourist at a calibrated grading suite, the main reference monitor showing a warm editorial B2B video frame.',
  },
];

const faqs = [
  {
    q: 'Why does AIGC make sense specifically for LinkedIn?',
    a: 'LinkedIn rewards two things at once: editorial-grade authority and per-segment precision. Traditional production can deliver one of those well; AIGC inside an authored process delivers both. The platform itself has surfaced that Thought Leader Ads can return 252 percent higher CTR and that LinkedIn campaigns can deliver 113 percent higher ROAS than other paid social, but only when the creative respects the surface. AIGC is what makes per-segment, per-funnel-stage creative economically viable.',
  },
  {
    q: 'How do you handle thought leadership without making it sound generic?',
    a: 'The brand voice is captured up front: how the executives actually write, what they care about, the references they reach for. That voice trains the LoRA models and the prompt library, so every variant runs through a filter that keeps it sounding like a person with a point of view, not a brand mouthpiece. The editorial pass at the end strips the AI tells before publication.',
  },
  {
    q: "What LinkedIn formats can you actually produce?",
    a: 'Sponsored Content, Document Ads, Carousel Ads, Thought Leader Ads, Conversation Ads, Lead Gen Forms, Video ads, Message Ads, plus the full organic side: long-form posts, carousel essays, executive-voice video, newsletter editions, company-page covers, event lead-up assets. Each format is briefed against its own placement rules rather than recycled from a single asset.',
  },
  {
    q: 'How does the 30 percent cost reduction work on B2B creative?',
    a: 'B2B creative at scale is expensive because every audience segment wants a slightly different version: industry-specific, role-specific, funnel-stage-specific. AIGC inside an authored process moves the budget from per-asset cost to per-concept cost. The first variant is expensive; the fiftieth is close to free. The editorial sign-off is what keeps the long tail from looking like a content farm.',
  },
  {
    q: 'Can you train AIGC on our executive voice?',
    a: 'Yes. A one-time onboarding to train brand-specific LoRA models on your executive voice, your approved talent, your visual references and your editorial tone. After that, every variant runs through the trained pipeline, and every output sits inside the brand book without a fresh prompt cycle per piece. The executive still signs off; the production cycle to get there shrinks from weeks to days.',
  },
  {
    q: 'How long does it take to launch a LinkedIn campaign?',
    a: 'After the initial brand AI training (two to three weeks for a new brand), we can launch LinkedIn campaigns within days. For brands already onboarded, brief to first cut on short-form work is 24 to 72 hours, and the multi-segment variant cascade lands inside a week.',
  },
  {
    q: 'How do you measure success on a 320-day buyer journey?',
    a: 'The same way the buyer measures it: across the whole journey, not against a single click. We name creative for downstream reporting, build variants matched to funnel-stage cohorts, and feed campaign results back into the creative cycle so the next wave sharpens against what actually converted. The studio sees the reporting; the cycle compounds.',
  },
  {
    q: 'How do you keep B2B AIGC from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, grain, native-feeling imperfection, a colour grade matched to the brand book. The image style guide rules out the AI tells (poreless skin, identical bokeh, melted jewellery, almost-but-not-quite text). On LinkedIn specifically, the bar is editorial-grade authority, which is the bar the studio already shoots to.',
  },
  {
    q: 'Can you white-label this for our agency?',
    a: 'Yes. A significant share of our LinkedIn work runs under agency brands, with full white-label delivery and confidential collaboration. The agency owns the relationship and the client communication; we deliver the production capability behind it.',
  },
  {
    q: 'Who owns the assets, the masters and the trained models?',
    a: 'You own all finished assets, all masters and any LoRA or fine-tuned models trained on your IP. Commercial use rights for AIGC outputs are routed through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="LinkedIn AIGC: B2B Creative That Compounds Authority"
  description="AIGC for LinkedIn. Thought-leadership editorial, precision ads and the 320-day B2B buyer journey, produced inside a working studio."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> LinkedIn
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">B2B Authority.</span></span>
            <span class="line"><span class="line__i serif">Compounding</span></span>
            <span class="line"><span class="line__i">Weekly.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Thought leadership and precision ads. <em>One editorial voice.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              900 million professionals, 80 percent in decision-making
              roles, a buyer journey that runs 320 days from first
              impression to signed deal. LinkedIn pays attention to brands
              that publish like media.
            </p>
            <p>
              Authored B2B creative inside a working production company.
              Executive-voice models, carousel essays, precision ads,
              every variant signed off by a studio rather than a prompt.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> B2B-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/li-hero.jpg"
          alt="A close editorial portrait of a B2B executive in a charcoal merino crewneck seated at a daylit desk, soft window daylight."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> LinkedIn</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              The 320-day<br /><span class="serif">buyer journey</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              B2B buyers research for the better part of a year before
              they sign. On LinkedIn that means a year of impressions
              that either compound your authority or train the buyer to
              ignore you.
            </p>
            <p class="r" style="--d:.16s">
              Most B2B brands ship one polished asset per quarter and call
              it thought leadership. LinkedIn rewards the brands that
              publish like a small media outlet: carousels, executive
              voice, op-eds, video, week after week, signed off by a
              human at the end.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Recent LinkedIn-side campaigns for <strong>Shiseido</strong>,
              <strong>Camper</strong>, <strong>HiSense</strong>,
              <strong>age20</strong> and <strong>Mexicash</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/li-roots.jpg"
              alt="A wide editorial photograph of a quiet daylit boardroom, two people at a long oak table reviewing a printed thought-leadership brief."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Publish like media, not like a brand page</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Two hundred and fifty-two percent higher click-through on
            Thought Leader Ads, one hundred and thirteen percent higher
            ROAS than other paid social, cost per lead down by thirty
            percent when the creative actually fits the surface.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Three lanes, one <span class="serif">brand voice</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} mode</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Lane</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Editorial-grade B2B frames produced through the studio
            pipeline. Every image is authored work, sized for the
            surface it ships on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/li-hybrid-main.jpg"
                alt="A producer at a wide reference monitor reviewing a horizontal grid of B2B thought-leadership carousel posts side by side."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/li-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand on a charcoal merino sleeve resting beside a leather notebook on an oak desk."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 voice</span>
            <span class="source__stat-cap">Every segment, every stage, every quarter</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Editorial discipline, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The B2B brands that win the buyer at month nine are the
            ones who were already in the feed at month one, and at
            month four, with the same voice and a sharper point of
            view each time.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit between the editorial and the technical: directors,
            writers and editors alongside the AIGC engineers and the
            LoRA-training pipeline. Every variant ships with the same
            editorial standard as the hero, because the same hands sign
            it off.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in
            mainland China, Hong Kong, the EU or the US depending on
            your data sovereignty position. Custom-trained LoRA models
            stay your property and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            We pick up where you need us and step back where you do not.
          </p>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a LinkedIn program runs</p>
        <h2 class="dh r" style="--d:.05s">
          One voice,<br />the whole <span class="serif">funnel</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Sponsored Content, Document Ads, Thought Leader Ads and
          organic editorial share the same brand voice, and the same
          process. The placement changes; the discipline stays the
          same. The work is won in the direction, not in the launch.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here,
            put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
