---
/**
 * LinkedIn · /solutions/platforms/linkedin
 *
 * Full-service LinkedIn agency and AIGC production studio: company page
 * management, newsletters and events, full-funnel Campaign Manager advertising
 * and ABM media buying, executive personal branding and ghostwriting, employee
 * advocacy and team training, plus studio AIGC and brand-owned avatar video.
 *
 * Copy: American English, journalistic register. Per repo standards: no
 * em-dashes (U+2014), no decorative numerals inside cards or repeated
 * blocks, body copy at var(--type-body), hubStudio keeps its canonical
 * lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import PlatformAppBand from '../../../components/PlatformAppBand.astro';
import WaysToWork from '../../../components/WaysToWork.astro';
import { appShots } from '../../../data/app-shots';
import { APP_SIGNUP, APP_SIGNIN, BRIEF_URL } from '../../../lib/links';

