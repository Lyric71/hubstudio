const credentials = ['LinkedIn Certified Buyers', 'Private GPU infra', 'NDA & DPA', 'CRM & CAPI Attribution'];

const processSteps = [
  {
    short: 'Audit',
    tier: 'Where it is won',
    title: 'Audit, positioning and funnel architecture.',
    body: 'We start by auditing your company page, executive profiles, past Campaign Manager performance, and competitor footprint. You leave with a sharp positioning strategy, an ABM audience map, and a unified plan across organic, paid media, and leadership voices.',
    image: '/Images/linkedin-p1-brief.jpg',
