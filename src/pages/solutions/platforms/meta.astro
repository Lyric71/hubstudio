  @media (min-width: 720px) { .matrix__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1060px) { .matrix__grid { grid-template-columns: repeat(3, 1fr); } }
  .mcard { background: var(--bg-white); border: 1px solid var(--line-strong); border-radius: 8px; padding: clamp(24px, 2.8vw, 32px); display: flex; flex-direction: column; gap: 12px; transition: border-color 0.2s ease, transform 0.2s ease; }
  .mcard:hover { border-color: var(--brand-orange); transform: translateY(-2px); }
  .mcard__eyebrow { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .mcard__title { font-family: var(--font-sans); font-size: clamp(19px, 1.8vw, 22px); font-weight: 600; line-height: 1.22; letter-spacing: -0.02em; color: var(--text-ink); }
  .mcard__desc { font-size: 14.5px; line-height: 1.58; color: var(--text-mute); }
  .mcard__list { margin: 8px 0 0; padding: 14px 0 0; border-top: 1px solid var(--line-hairline); list-style: none; display: grid; gap: 8px; }
  .mcard__list li { position: relative; padding-left: 16px; font-size: 13px; line-height: 1.48; color: var(--text-ink); }
  .mcard__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 1.5px; background: var(--brand-orange); }

  /* Proof */
  .proof { background: var(--bg-white); padding-block: clamp(80px, 10vw, 150px); }
  .sheet { display: grid; gap: clamp(22px, 3vw, 40px); }
  @media (min-width: 720px) {
    .sheet { grid-template-columns: repeat(3, 1fr); }
    .sheet .shot:nth-child(3n + 2) { margin-top: 60px; }
    .sheet .shot:nth-child(3n) { margin-top: 30px; }
  }
  .shot .crop__inner { aspect-ratio: 1 / 1; }
  .shot .crop__inner img { transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .shot:hover .crop__inner img { transform: scale(1.06); }
  .shot__cap { margin-top: 14px; display: flex; align-items: baseline; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .shot__kind { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-ink); }

  /* Partnership / Source */
  .source { background: var(--navy); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .source__grid { display: grid; gap: 52px; }
  @media (min-width: 940px) { .source__grid { grid-template-columns: 0.92fr 1.08fr; gap: 70px; align-items: center; } }
  .source__visual { position: relative; }
  .source__main .crop__inner { aspect-ratio: 5 / 4; }
  .source__inset { position: absolute; right: -14px; bottom: -34px; width: 42%; max-width: 200px; margin: 0; border-radius: 8px; overflow: hidden; border: 5px solid var(--navy); box-shadow: 0 20px 36px rgba(0, 0, 0, 0.42); }
  .source__inset img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  @media (max-width: 520px) { .source__inset { display: none; } }
  .source__stat { position: absolute; left: -10px; top: 36px; display: grid; gap: 3px; padding: 15px 19px; border-radius: 12px; background: var(--brand-orange); color: #fff; box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42); }
  .source__stat-num { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .source__stat-cap { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase; max-width: 15ch; line-height: 1.4; }
  .source__body .dh { margin-top: 16px; }
  .source__lead { margin-top: 20px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-on-dark); }
  .source__p { margin-top: 15px; font-size: var(--type-body); line-height: 1.66; color: rgba(240, 237, 233, 0.78); }
  .source__p--quiet { color: rgba(240, 237, 233, 0.55); }
  .creds { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 9px; }
  .cred { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); border: 1px solid rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 12px; font-weight: 500; transition: border-color 0.2s ease, background-color 0.2s ease; }
  .cred:hover { border-color: var(--brand-orange); background: rgba(233, 78, 27, 0.16); }
  .cred svg { width: 13px; height: 13px; color: var(--brand-orange); }

  /* Process */
  .craft { background: var(--paper); padding-top: clamp(80px, 10vw, 150px); }
  .craft__intro { max-width: 780px; margin-bottom: clamp(36px, 5vw, 60px); }
  .craft__intro .kicker { color: var(--brand-orange); }
  .craft__intro .dh { margin-top: 16px; }
  .craft__lede { margin-top: 18px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }
  .craft__note { margin-top: 22px; display: inline-block; padding: 13px 20px; border-left: 3px solid var(--brand-orange); background: rgba(233, 78, 27, 0.07); border-radius: 0 10px 10px 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--text-ink); }

  .seq__nav { display: none; }
  .seq__panels { display: grid; gap: clamp(48px, 7vw, 96px); padding-bottom: clamp(80px, 10vw, 150px); }
  .seq__panel { display: grid; gap: 28px; }
  @media (min-width: 760px) {
    .seq__panel { grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .seq__panel:nth-child(even) .seq__media { order: 2; }
  }
  .seq__media .crop__inner { aspect-ratio: 4 / 3; }
  .seq__tier { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .seq__title { margin-top: 12px; font-size: clamp(25px, 2.7vw, 38px); font-weight: 600; line-height: 1.12; letter-spacing: -0.025em; }
  .seq__body { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }

  .craft--pinned .seq { height: 480vh; }
  .craft--pinned .seq__stick { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; overflow: hidden; }
  .craft--pinned .seq__stage { width: 100%; display: flex; flex-direction: column; gap: clamp(22px, 3vw, 40px); }
  .craft--pinned .seq__nav { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .seq__step { display: flex; flex-direction: column; gap: 10px; padding: 0; background: transparent; border: none; text-align: left; cursor: pointer; }
  .seq__step-dot { height: 5px; border-radius: 3px; background: var(--line-strong); overflow: hidden; }
  .seq__step-fill { display: block; height: 100%; width: 100%; background: var(--brand-orange); transform: scaleX(0); transform-origin: 0 50%; }
  .seq__step-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-mute); transition: color 0.3s ease; }
  .seq__step[data-active='true'] .seq__step-label { color: var(--text-ink); }
  .craft--pinned .seq__panels { position: relative; display: block; height: clamp(340px, 60vh, 540px); padding-bottom: 0; }
  .craft--pinned .seq__panel { position: absolute; inset: 0; align-content: center; opacity: 0; visibility: hidden; transform: translateY(26px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.5s; }
  .craft--pinned .seq__panel[data-active='true'] { opacity: 1; visibility: visible; transform: none; transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .craft--pinned .seq__panel:nth-child(even) .seq__media { order: 0; }
  .craft--pinned .seq__media .crop__inner { aspect-ratio: auto; height: clamp(280px, 52vh, 460px); }
  @media (prefers-reduced-motion: reduce) { .craft--pinned .seq__panel { transition: none; } }

  /* FAQ */
  .faq { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .faq__grid { display: grid; gap: 44px; }
  @media (min-width: 1000px) {
    .faq__grid { grid-template-columns: 0.78fr 1.22fr; gap: 72px; align-items: start; }
    .faq__intro { position: sticky; top: 96px; }
  }
  .faq__intro .dh { margin-top: 18px; }
  .faq__sub { margin-top: 18px; margin-bottom: 26px; font-size: var(--type-body); line-height: 1.62; color: var(--text-mute); }
  .acc { display: grid; }
  .acc__row { border-top: 1.5px solid var(--ink); }
  .acc__row:last-child { border-bottom: 1.5px solid var(--ink); }
  .acc__q { width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 16px; padding: 26px 0; background: transparent; border: none; text-align: left; }
  .acc__qmark { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--brand-orange); padding-top: 3px; }
  .acc__qtext { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; color: var(--text-ink); transition: color 0.18s ease; }
  .acc__q:hover .acc__qtext { color: var(--brand-orange); }
  .acc__icon { position: relative; width: 22px; height: 22px; margin-top: 2px; }
  .acc__icon span { position: absolute; top: 50%; left: 50%; width: 14px; height: 2px; border-radius: 2px; background: var(--text-ink); transform: translate(-50%, -50%); transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(90deg); }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(0deg); }
  .acc__q[aria-expanded='true'] .acc__icon span { background: var(--brand-orange); }
  .acc__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s ease; }
  .acc__q[aria-expanded='true'] + .acc__a { grid-template-rows: 1fr; }
  .acc__a-inner { overflow: hidden; }
  .acc__a-inner p { padding: 0 0 26px 41px; max-width: 64ch; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .acc__a-inner a { color: var(--brand-orange); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  /* Close */
  .end { position: relative; background: var(--ink); color: var(--text-on-dark); padding-top: clamp(80px, 11vw, 150px); overflow: clip; }
  .end__reg { position: absolute; width: clamp(300px, 36vw, 560px); top: -16%; right: -9%; color: rgba(240, 237, 233, 0.05); pointer-events: none; }
  .end__inner { position: relative; display: grid; justify-items: start; gap: 22px; }
  .end__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(40px, 6.6vw, 96px); line-height: 0.98; letter-spacing: -0.04em; }
  .end__p { max-width: 54ch; font-size: var(--type-lead); line-height: 1.5; color: rgba(240, 237, 233, 0.78); }
  .end__cta { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .end__signin { font-size: var(--type-small); color: rgba(240, 237, 233, 0.62); }
  .end__signin a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { t } from '../../../scripts/i18n';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const progBar = document.querySelector<HTMLElement>('.prog__bar');
  if (progBar) {
    const onScroll = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      progBar.style.transform = `scaleX(${max > 0 ? Math.min(1, d.scrollTop / max) : 0})`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  const revealEls = document.querySelectorAll('.r, .r-clip, .hero');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -7% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  const nums = Array.from(document.querySelectorAll<HTMLElement>('.stat__num'));
  const runCount = (el: HTMLElement) => {
    const from = Number(el.dataset.from || 0);
    const to = Number(el.dataset.to || 0);
    // The number goes into a whole template ({n} days, {n}h) so a language
    // can translate the unit and place it where it reads naturally.
    const suffix = el.dataset.suffix || '';
    if (reduceMotion.matches) {
      el.textContent = t(`{n}${suffix}`, { n: to });
      return;
    }
    const dur = 1500;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = t(`{n}${suffix}`, { n: Math.round(from + (to - from) * eased) });
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && nums.length) {
    const io2 = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runCount(e.target as HTMLElement);
            io2.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((n) => io2.observe(n));
  } else {
    nums.forEach(runCount);
  }

  const craft = document.getElementById('craft');
  const seq = document.getElementById('seq');
  if (craft && seq) {
    const steps = Array.from(seq.querySelectorAll<HTMLElement>('.seq__step'));
    const panels = Array.from(seq.querySelectorAll<HTMLElement>('.seq__panel'));
    const fills = steps.map((s) => s.querySelector<HTMLElement>('.seq__step-fill'));
    const n = panels.length;
    const wide = window.matchMedia('(min-width: 880px)');

    const setActive = (idx: number, sub: number) => {
      panels.forEach((p, i) => (p.dataset.active = String(i === idx)));
      steps.forEach((s, i) => {
        s.dataset.active = String(i === idx);
        const f = fills[i];
        if (f) f.style.transform = `scaleX(${i < idx ? 1 : i === idx ? sub : 0})`;
      });
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      if (!craft.classList.contains('craft--pinned')) return;
      const total = seq.offsetHeight - window.innerHeight;
      const scrolled = Math.min(total, Math.max(0, -seq.getBoundingClientRect().top));
      const p = total > 0 ? scrolled / total : 0;
      const exact = p * n;
      const idx = Math.min(n - 1, Math.floor(exact));
      const sub = Math.min(1, Math.max(0, exact - idx));
      setActive(idx, idx === n - 1 ? 1 : sub);
    };
    const onScrollSeq = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const applyMode = () => {
      if (wide.matches && !reduceMotion.matches) {
        craft.classList.add('craft--pinned');
        update();
      } else {
        craft.classList.remove('craft--pinned');
        panels.forEach((p) => (p.dataset.active = 'true'));
      }
    };

    steps.forEach((s, i) => {
      s.addEventListener('click', () => {
        if (!craft.classList.contains('craft--pinned')) return;
        const railTop = seq.getBoundingClientRect().top + window.scrollY;
        const total = seq.offsetHeight - window.innerHeight;
        window.scrollTo({
          top: railTop + ((i + 0.5) / n) * total,
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
        });
      });
    });

    window.addEventListener('scroll', onScrollSeq, { passive: true });
    window.addEventListener('resize', () => {
      applyMode();
      update();
    });
    applyMode();
  }

  const accQs = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc__q'));
  accQs.forEach((q) => {
    q.addEventListener('click', () => {
      const open = q.getAttribute('aria-expanded') === 'true';
      accQs.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      q.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
