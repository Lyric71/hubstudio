---
/**
 * TikTok · /solutions/platforms/tiktok
 *
 * Editorial layout adapted from /services/design/video-production. Same
 * print-shop primitives reframed for a single vertical-first platform:
 * the algorithm, authenticity at speed, the trend cycle.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 10, suffix: 'x', label: 'Content output velocity', note: 'Hundreds of assets per concept' },
  { from: 0, to: 70, suffix: '%', label: 'Lower creative cost', note: 'Versus traditional UGC production' },
  { from: 0, to: 5, suffix: 'x', label: 'Higher engagement', note: 'AI-tuned vs generic creative' },
];

const samples = [
  {
    src: '/Images/tt-sample-arlen.jpg',
    brand: 'Arlen',
    kind: 'Beauty · UGC-style',
    alt: 'A close cinematic still of a young creator holding a small skincare product to soft window daylight, eyes off-camera.',
  },
  {
    src: '/Images/tt-sample-briar.jpg',
    brand: 'Briar',
    kind: 'Food · Lifestyle Reel',
    alt: 'Two friends laughing while preparing breakfast on a sunlit kitchen counter, one filming vertically.',
  },
  {
    src: '/Images/tt-sample-callan.jpg',
    brand: 'Callan',
    kind: 'Footwear · Street',
    alt: 'A low-angle still of a chestnut leather sneaker stepping onto wet city pavement at dusk under a warm street lamp.',
  },
  {
    src: '/Images/tt-sample-dane.jpg',
    brand: 'Dane',
    kind: 'Tech · Tabletop',
    alt: 'A matte black wireless earbuds case on warm sand-coloured concrete, a hand placing one earbud beside it.',
  },
  {
    src: '/Images/tt-sample-elin.jpg',
    brand: 'Elin',
    kind: 'Apparel · Motion',
    alt: 'A dancer in a warm studio mid-spin, motion-blurred fabric, soft single softbox, deep navy backdrop.',
  },
];

const coverage = [
  {
    label: 'Algorithm',
    heading: 'The algorithm rewards volume that feels native.',
    image: '/Images/tt-algorithm.jpg',
    alt: 'An overhead studio still of a long printed timeline laid across a wood table, dozens of small vertical thumbnails in clusters.',
    lead: '1.58 billion monthly users, 95 minutes a day, an attention window measured in seconds.',
    body: [
      'TikTok is the platform where the opening frame either earns the thumb stop or loses the impression. Traditional creative processes that ship one polished spot per quarter cannot keep pace with a surface that rewards iteration, freshness and frequency at the volume the algorithm needs to learn from.',
      "AIGC inside an authored production process gives the algorithm what it actually wants: dozens of native-feeling variants per concept, shipped weekly, each one tuned to a trend, an audience or an audio. The brief stays one brief. The variants compound.",
    ],
    tags: [
      'Micro-videos', 'Short-form ads', 'Spark Ads',
      'In-feed creative', 'Top-View takeovers',
      'A/B creative testing', 'Audience-cohort variants',
      'Performance-optimised cuts',
    ],
  },
  {
    label: 'Authenticity',
    heading: 'Authentic at artificial speed.',
    image: '/Images/tt-authentic.jpg',
    alt: 'A close handheld still of a creator filming a UGC-style product unboxing on a sunlit kitchen counter, phone held vertically.',
    lead: 'TikTok users are 1.4 times more likely to look forward to generative AI in ads. The brief is to feel right, not to look polished.',
    body: [
      "The authenticity paradox of TikTok is that hyper-produced work loses to creator-style edits that still hit a brand brief. Solved by AIGC: native-feeling rough cuts, handheld grammar, on-brand voice, generated at the pace the platform demands while staying inside the brand guidelines.",
      "The studio writes the brand book for the surface, trains LoRA models on the brand voice and the talent, and ships variants that read as creator content with the rigor of a campaign. No more cycle of brief, shoot, retouch, ship, repeat. The cycle becomes brief, generate, judge, ship.",
    ],
    tags: [
      'UGC-style edits', 'Talking-head creative', 'Synthetic talent',
      'Brand-trained LoRA', 'Voice cloning', 'AR effects',
      'Native-feeling captions', 'Sound-on edits',
    ],
  },
  {
    label: 'Trends',
    heading: 'Trend velocity, brand intact.',
    image: '/Images/tt-trends.jpg',
    alt: 'A wide editorial still of a strategist at a studio whiteboard taping printed trending sounds and challenges in a horizontal sequence.',
    lead: 'The trend window on TikTok closes faster than a traditional production schedule can open.',
    body: [
      "By the time a conventional shoot wraps, the audio has rotated, the hashtag has cooled and the moment has passed. The studio runs a continuous trend-watch on sound, hashtag and challenge surfaces, then turns the signals into ready-to-ship variants the same day.",
      "Brand-safe trend surfing means the brand book is not negotiable but the surface treatment is. The hero concept signs off once; the trend variants ship in hours, with the brand grammar that keeps them recognisable in feed.",
    ],
    tags: [
      'Trend-watch ops', 'Sound-led edits', 'Hashtag adaptations',
      'Challenge participation', 'Cultural localisation',
      'Same-day refresh', 'Creator-style variants',
      'Multi-market drops',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to lock the goal, audience, content tempo and brand truth. Output is a one-page strategic brief and a vertical-first asset map by surface.',
    image: '/Images/tt-p1-brief.jpg',
    alt: 'A creative strategist and a brand lead at a studio table covered in printed vertical screenshots and a one-page brief.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction. Vertical-first.',
    body: 'Visual references locked, tone defined, vertical storyboards drafted, AIGC model selection made per concept. Audio choices, captions, on-screen text, all native to the surface.',
    image: '/Images/tt-p2-direction.jpg',
    alt: 'A storyboard wall with a single column of vertical frame sketches pinned in sequence top to bottom.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Per-concept generation across the agreed cohorts. Brand-trained LoRA models keep the variants on-message. Each output goes through the studio retouch and brand-check pass before any media plan sees it.',
    image: '/Images/tt-p3-aigc.jpg',
    alt: 'A motion designer at a calibrated workstation reviewing a single hero vertical frame on the main monitor and a grid of variations on a side panel.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-cohort, per-audio.',
    body: 'Assets handed to the media team in the formats TikTok Ads Manager actually serves, with naming, durations and audio choices matched to In-Feed, TopView and Spark Ads. Tracking and creative naming built for downstream reporting.',
    image: '/Images/tt-p4-launch.jpg',
    alt: 'A young media operator at a daylit studio desk reviewing a printed posting schedule beside a vertical analytics dashboard.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Trends, audiences, weekly.',
    body: 'Once the hero is signed off, the variant cascade lands daily. New trends, new audios, new audiences, new markets. The brief stays the same, the variants compound.',
    image: '/Images/tt-p5-adapt.jpg',
    alt: 'A colourist at a calibrated grading suite, the main vertical reference monitor showing a warm short-form frame.',
  },
];

const faqs = [
  {
    q: 'Why does AIGC make sense specifically for TikTok?',
    a: 'TikTok rewards volume that feels native and freshness that arrives weekly, not quarterly. Traditional production tops out at one polished spot per cycle; AIGC inside an authored process gives the algorithm dozens of variants per concept, each one tuned to a trend, an audience or an audio. The platform itself has reported TikTok users are 1.4 times more likely to look forward to generative AI in ads, which means the surface is asking for this work, not resisting it.',
  },
  {
    q: 'How do you reach a 10x content output velocity?',
    a: 'AI-assisted planning explores hundreds of concept variants where a traditional team would explore five, and the cost-per-variation curve flattens fast: the first variant is expensive, the fiftieth is close to free. The studio still signs off every frame, which is what keeps the volume on-brand rather than just on-feed.',
  },
  {
    q: 'What TikTok formats can your AIGC actually produce?',
    a: 'In-Feed creative, TopView takeovers, Spark Ads, branded AR effects, vertical micro-videos, talking-head UGC, dance and challenge participation, sound-led brand edits, and Shopping content for TikTok Shop. Each surface gets its own crop, tempo and audio treatment, not the same square asset stretched vertical.',
  },
  {
    q: 'How does the 70% cost reduction actually work?',
    a: 'The expensive part of TikTok production at scale is the per-shoot setup: talent booking, location, crew day rate, retouch hours. AIGC inside an authored process moves the budget from per-asset cost to per-concept cost. Once the LoRA models are trained and the treatment is locked, the variant cascade lands without booking a fresh shoot per drop.',
  },
  {
    q: 'Can you actually move at trend speed?',
    a: "Yes. Brief to first cut on short-form work runs 24 to 72 hours; same-day refreshes on existing brand treatments run in hours. The trend-watch ops sit alongside the production line, so the signals turn into variants the same week, not the same quarter.",
  },
  {
    q: 'How do you keep AIGC TikTok content from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, grain, native-feeling imperfection, a colour grade matched to the brand book. The image style guide rules out the AI tells (poreless skin, identical bokeh, melted jewellery, almost-but-not-quite text). On TikTok specifically, the brief is to feel right rather than to look polished, which favours the work we already do.',
  },
  {
    q: 'What makes your approach different from other AIGC providers?',
    a: 'A working studio underneath the AI pipeline. Directors, retouchers and colourists alongside the AIGC engineers and the LoRA-training stack. We own the cameras, the lights and the GPU infrastructure, so the work moves between live shooting and AIGC without a handoff. The AI is one tool on a much bigger bench.',
  },
  {
    q: 'How do you train AIGC on our brand voice?',
    a: 'A one-time onboarding to train brand-specific LoRA models on your approved talent, your sonic identity, your colour grade and your visual references. After that, every variant runs through the trained pipeline, and every output sits inside the brand book without a fresh prompt cycle per piece.',
  },
  {
    q: 'Do you handle global TikTok campaigns and localisation?',
    a: 'Yes. One hero concept, every market. Phoneme-level lip-sync across forty-plus languages from a single filmed master, culturally adapted scripts, market-specific trend variants. The hero ships once; the localisation cascade lands inside days.',
  },
  {
    q: 'Who owns the assets, the masters and the trained models?',
    a: 'You own all finished assets, all masters and any LoRA or fine-tuned models trained on your IP. Commercial use rights for AIGC outputs are routed through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="TikTok AIGC: Creative That Dominates the Algorithm"
  description="AIGC for TikTok. Native-feeling vertical creative at the pace the algorithm rewards, produced inside a working studio. Trend velocity, brand intact."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> TikTok
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Vertical First.</span></span>
            <span class="line"><span class="line__i serif">Algorithm</span></span>
            <span class="line"><span class="line__i">Native.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Volume, freshness, brand. <em>All three, weekly.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              TikTok is the platform where one polished spot per quarter
              loses to fifty native-feeling variants per week. Most studios
              are not built for that cadence. We are.
            </p>
            <p>
              Authored AIGC inside a working production company. Brand-trained
              LoRA models, trend-watch ops alongside the production line,
              and a studio sign-off on every frame.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> Vertical-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/tt-hero.jpg"
          alt="A close editorial portrait of a young creator filming themselves on a phone mounted to a tripod, soft warm window daylight."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> TikTok</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Volume that feels<br /><span class="serif">native</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              1.58 billion monthly users, 95 minutes a day, an attention
              window measured in seconds. TikTok rewards work that respects
              that posture: native grammar, sound-on, freshness shipped
              weekly rather than quarterly.
            </p>
            <p class="r" style="--d:.16s">
              Hyper-produced spots lose to creator-style edits that still
              hit a brand brief. The brands compounding on the platform in
              2026 are the ones running an authored process with AIGC
              inside it.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Recent TikTok-side campaigns for <strong>Shiseido</strong>,
              <strong>Camper</strong>, <strong>HiSense</strong>,
              <strong>age20</strong> and <strong>Mexicash</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/tt-roots.jpg"
              alt="A wide editorial photograph of a vertical-content production studio at golden hour, two operators at vertical reference monitors."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Where the trend signal becomes a shipped variant</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Hundreds of native-feeling variants per concept, cost-per-asset
            cut by seventy percent, brief to first cut inside forty-eight
            hours, and the brand grammar still intact at the fiftieth drop.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Three lanes, one <span class="serif">brand line</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} mode</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Lane</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Vertical stills from short-form work produced through the studio
            pipeline. Every frame is authored, sized for the surface, signed
            off by the brand.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/tt-hybrid-main.jpg"
                alt="A producer at a wide reference monitor reviewing a vertical grid of TikTok video variants side by side."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/tt-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand swiping a vertical phone screen showing a short-form video frame."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Every cohort, every audio, every trend</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Studio sign-off, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The TikTok brands that compound on the platform in 2026 are
            not the ones with the most agencies on the brief. They are
            the ones running a working studio with AIGC inside it.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit between the technical and the creative: directors,
            retouchers and colourists alongside the AIGC engineers and the
            LoRA-training pipeline. Every variant ships with the same brand
            discipline as the hero, because the same hands sign it off.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in
            mainland China, Hong Kong, the EU or the US depending on your
            data sovereignty position. Custom-trained LoRA models stay your
            property and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            We pick up where you need us and step back where you do not.
          </p>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a TikTok program runs</p>
        <h2 class="dh r" style="--d:.05s">
          One brief,<br />every <span class="serif">trend</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          In-Feed, TopView, Spark Ads and Shopping share the same brand
          line, and the same process. The trend changes; the discipline
          stays the same. The work is won in the direction, not in the
          launch.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here,
            put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
