---
/**
 * RedNote (Xiaohongshu) · /solutions/platforms/rednote
 *
 * Editorial layout adapted from /solutions/platforms/meta. Same print-shop
 * primitives (crop marks, calibration colour bar, mono figure labels, dashed
 * rules) reframed for RedNote: the four lanes we ship creative into, the AIGC
 * mechanics for each, the partnership model.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 4, suffix: '', label: 'Lanes we ship', note: 'Notes, ad creative, KOC, avatar' },
  { from: 0, to: 50, suffix: '+', label: 'Variations per concept', note: 'From one signed-off master' },
  { from: 0, to: 48, suffix: 'h', label: 'Brief to first note', note: 'On photo and video notes' },
];

const samples = [
  {
    src: '/Images/rednote-sample-note.jpg',
    kind: 'Organic · Photo note',
    alt: 'A vertical phone held in soft window light, the screen showing an open RedNote photo note: a swipeable cover image of a warm ceramic skincare flatlay with a row of page dots beneath it and the heart, star and speech-bubble icons along the bottom of the interface.',
  },
  {
    src: '/Images/rednote-sample-feed.jpg',
    kind: 'Ad creative · In-feed note',
    alt: 'A phone screen showing the RedNote discovery feed, a two-column staggered waterfall of lifestyle note cards, the lead card carrying a small paid-placement label over a sand-toned cover photo.',
  },
  {
    src: '/Images/rednote-sample-search.jpg',
    kind: 'Ad creative · Search note',
    alt: 'A phone screen showing RedNote search results, a rounded search field at the top and a two-column grid of note cards below, the lead card a boosted product note with a small paid label.',
  },
  {
    src: '/Images/rednote-sample-koc.jpg',
    kind: 'KOC · Photo note',
    alt: 'A phone held vertically in a creator hand, the screen showing a candid hand-held RedNote photo note of a cosmetics product held up to a bathroom mirror, the save and like counts visible on the bottom bar of the interface.',
  },
  {
    src: '/Images/rednote-sample-avatar.jpg',
    kind: 'Avatar · Video note',
    alt: 'A phone screen showing a RedNote video note paused on an AI avatar presenter speaking to camera in neutral knitwear, the progress bar and the heart, star and speech-bubble rail visible in the interface.',
  },
];

const coverage = [
  {
    fig: 'B',
    label: 'Notes',
    heading: 'Notes. Photo and video, built to be saved.',
    image: '/Images/rednote-notes.jpg',
    alt: 'A phone held in both hands, the screen filled with an open RedNote photo note, a large editorial product image with a row of swipe dots beneath it, the title and body text in Chinese and the bottom interaction bar of the app visible.',
    lead: 'Editorial-grade organic notes for RedNote, photo and video, written and produced inside the studio.',
    body: [
      "We script, shoot and finish the organic side of a RedNote presence: photo notes that earn the tap from a crowded discovery feed, video notes that hold past the cover frame, swipe sequences built so the second image is as considered as the first. The cover is treated as the campaign still it actually is, because on RedNote the cover is what gets clicked.",
      "Titles and body copy are written natively in Chinese, for search as much as for the feed, never carried across from an English caption. Every note is signed off by a creative director and retouched by the same hand as the campaign hero. The calendar fills; the brand line does not move.",
    ],
    tags: [
      'Photo notes', 'Video notes', 'Cover frames',
      'Search-led titles', 'Swipe sequences', 'Brand-book grids',
      'Native Chinese copy', 'Always-on calendar',
    ],
  },
  {
    fig: 'C',
    label: 'Ad creative',
    heading: 'Ad creative. Built for feed and search.',
    image: '/Images/rednote-ads.jpg',
    alt: 'A wide monitor showing a RedNote ad creative library, a grid of in-feed sponsored notes and search-result notes lined up in a placement preview, each carrying a small paid-placement label.',
    lead: "Performance creative produced at the volume RedNote's feed and search auctions actually reward.",
    body: [
      "RedNote runs on two engines, the discovery feed and search, and a paid note has to win both without ever reading as an interruption. We brief, generate and finish in-feed sponsored notes, search-led notes and splash frames around the placement set the media team is buying, with the cover variety the auction needs to keep learning.",
      "Conversion notes, shoppable-note creative and keyword-targeted variants all run through the same studio pass, so the paid long tail looks like the organic feed rather than a thinned-out clone of it. Ratios and naming are matched to what the buying tools expect downstream.",
    ],
    tags: [
      'In-feed notes', 'Search ads', 'Splash frames',
      'Cover A/B testing', 'Keyword-led notes', 'Shoppable note creative',
      'Conversion notes', 'Retargeting variants',
    ],
  },
  {
    fig: 'D',
    label: 'KOC',
    heading: 'KOC. Creator notes at studio scale.',
    image: '/Images/rednote-koc.jpg',
    alt: 'A phone screen showing a RedNote photo note shot in a creator hand-held style, a product held up in soft bathroom light, the like and save counts visible on the bottom interaction bar.',
    lead: 'Authored creator-style notes for RedNote, without the seeding-list chase or the rights cleanup.',
    body: [
      "RedNote was built on the creator note: the honest-looking review, the haul, the get-ready sequence, the before-and-after, the round-up of things actually bought. We produce that work end to end. Real hand-held grammar, real product-in-hand frames, finished inside the studio so the brand keeps the masters and the usage rights from the first cut.",
      "Volume is the point: thirty creator notes for one launch, ten fresh angles every week on an always-on account, market-specific edits per audience. No seeding-list chase, no rights cleanup after the fact, and the cost-per-variant curve flattens fast.",
    ],
    tags: [
      'Review notes', 'Hauls', 'Before-and-after',
      'GRWM notes', 'Dupe comparisons', 'Founder POV',
      'Wishlist round-ups', 'Always-on KOC',
    ],
  },
  {
    fig: 'E',
    label: 'Avatar',
    heading: 'Avatar. Spokespeople you own.',
    image: '/Images/rednote-avatar.jpg',
    alt: 'A phone screen showing a RedNote video note paused on an AI avatar presenter speaking to camera in neutral knitwear, the progress bar and the heart, star and speech-bubble rail visible in the interface.',
    lead: 'Bespoke synthetic talent that lives only on your RedNote account, on-brand and fluent in every cut.',
    body: [
      "We build and train brand-owned avatars: a founder twin, a brand spokesperson, a product expert. They present to camera in video notes, host live shopping sessions, narrate tutorial swipe notes and front always-on review content. One avatar, every note, with no scheduling around a creator's calendar.",
      "Lip-sync is studio-tight, the speech is native Mandarin, and the look stays inside the brand book. The rights stay with you in perpetuity, so a seasonal refresh never needs a re-shoot and the account never needs a re-cast.",
    ],
    tags: [
      'Founder twin', 'Brand spokespeople', 'Product expert',
      'Video-note hosts', 'Live shopping hosts', 'Tutorial notes',
      'Localised casts', 'Always-on avatar notes',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to lock the goal, audience, RedNote surfaces in scope, brand truth and no-go zones. Output is a one-page strategic brief and an asset map by surface and by service lane.',
    image: '/Images/rednote-p1-brief.jpg',
    alt: 'A creative director and a brand lead at a cluttered Shanghai studio table, tea mugs and sticky notes around a laptop showing the RedNote discovery feed alongside printed photo-note cover frames.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction across the four lanes.',
    body: 'Visual references locked, tone defined, the cover-frame system designed, AIGC and avatar model selection made per surface. Notes, ad creative, KOC and avatar each get their own treatment. This is where a campaign becomes ownable.',
    image: '/Images/rednote-p2-direction.jpg',
    alt: 'A storyboard wall with four columns of frame sketches labelled Notes, Ads, KOC and Avatar, each column anchored by a printed RedNote photo-note phone mock.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Per-lane generation across the agreed surfaces. Every output goes through the studio retouch and brand-check pass, and every title through a search pass, before any media plan sees it.',
    image: '/Images/rednote-p3-aigc.jpg',
    alt: 'A motion designer at a calibrated workstation, the main monitor showing a single RedNote photo-note cover frame, the side panel showing a grid of cover variants.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-surface, per-keyword.',
    body: 'Assets handed to the media team in the formats RedNote actually serves: cover frames, titles and keywords matched to the discovery feed and to search, ratios set for in-feed and splash placements. Tracking and creative naming built for downstream reporting.',
    image: '/Images/rednote-p4-launch.jpg',
    alt: 'A media buyer at a daylit Shanghai studio desk, the calibrated monitor showing a RedNote ad campaign dashboard with in-feed and search placements live.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Variants, refresh, season.',
    body: 'Once the hero is signed off, the variant cascade lands in days. New audiences, new cities, new festivals, new seasons. The brief stays the same, the variants compound.',
    image: '/Images/rednote-p5-adapt.jpg',
    alt: 'A colourist at a calibrated grading suite, the main reference monitor showing a warm RedNote video-note frame paused on a lifestyle still, the note interaction rail visible at the screen edge.',
  },
];

const faqs = [
  {
    q: 'What exactly do you produce for RedNote?',
    a: 'Four lanes, one studio. Notes covers organic photo and video notes for the discovery feed and for search. Ad creative covers in-feed sponsored notes, search-led notes and splash frames built for the RedNote auction. KOC covers creator-style notes at volume. Avatar covers brand-owned synthetic spokespeople for video notes and live shopping. The four lanes share one creative direction and one finishing pass, so the long tail looks like the hero.',
  },
  {
    q: 'How is the KOC lane different from booking real creators?',
    a: 'We script the brief, build the creator profile, generate the takes inside the studio and finish them with the same studio pass as the hero. Real hand-held grammar, real product-in-hand frames, no seeding-list chase and no rights cleanup after the fact. You keep the masters and the usage rights from the first cut, and the cost-per-variant curve flattens to near zero by the tenth note.',
  },
  {
    q: 'Tell me more about the Avatar lane.',
    a: 'We build and train a brand-owned synthetic presenter: a founder twin, a brand spokesperson or a product expert. The avatar speaks to camera in video notes, hosts live shopping sessions and narrates tutorial swipe notes. Lip-sync is studio-tight, the speech is native Mandarin, and the look stays inside the brand book, so the account stays live without a re-shoot.',
  },
  {
    q: 'Why does the cover frame matter so much on RedNote?',
    a: 'On RedNote the cover is the ad. It is the single image that wins or loses the tap from a crowded discovery feed and from search results, before a reader sees anything else. We treat every cover as a campaign still, A/B the cover separately from the note it sits on, and run the studio retouch pass over it first.',
  },
  {
    q: 'Do you write the notes in Chinese?',
    a: 'Yes. Titles and body copy are written natively in Chinese by Mandarin copywriters, never translated across from an English caption. RedNote is a search engine as much as a feed, so titles are written to be found as well as to be read, with the keywords a buyer actually types.',
  },
  {
    q: 'Can you produce notes at the volume and speed our calendar needs?',
    a: 'Yes. A single hero shoot or AIGC sprint produces the master, and the variant cascade lands per audience and per city inside days. On an existing brand, brief to first note runs 24 to 72 hours; a new brand takes a one-time onboarding to lock the treatment, the LoRA models and the avatar, after which weekly drops at production-grade quality are the working tempo. Trend-reactive notes can turn around inside a day or two.',
  },
  {
    q: 'Do you handle RedNote paid placements?',
    a: 'We produce the creative for them. The ad creative lane is briefed around the in-feed and search placements the media team is buying, with the cover variety the auction needs and the naming the reporting expects. The media buying itself stays with whoever runs your RedNote account, unless you ask us to recommend a partner.',
  },
  {
    q: 'How do you keep the work from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, grain, chromatic aberration and a colour grade in Lightroom or Capture One. The image style guide rules out the AI tells: poreless skin, identical bokeh, melted product detail, almost-but-not-quite text. The final file passes a human review before any note goes live. This is what closes the gap between an AI image and a campaign image.',
  },
  {
    q: 'Can you white-label this for our agency?',
    a: 'Yes. A significant share of our RedNote work runs under agency brands, with full white-label delivery and confidential collaboration. The agency owns the relationship and the client communication; we deliver the production capability behind it.',
  },
  {
    q: 'Who owns the notes, the masters and the trained models?',
    a: 'You own all finished notes, all masters, and any LoRA, fine-tuned or avatar models trained on your IP. Commercial use rights for AIGC outputs are routed through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="RedNote AIGC: Xiaohongshu Notes & Ad Creative at Scale"
  description="AIGC for RedNote. Photo notes, video notes, KOC and search ad creative for Xiaohongshu, produced inside a working studio. One brief, every surface."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- S1 · HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> RedNote
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Four lanes,</span></span>
            <span class="line"><span class="line__i serif">one RedNote brief.</span></span>
            <span class="line"><span class="line__i">AIGC, in scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Notes. Ad creative. KOC. <em>Avatar.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We ship four kinds of work into RedNote: organic photo and video
              notes for the discovery feed and search; performance ad creative
              built for the feed and search auctions; creator-style KOC notes
              at volume; and brand-owned avatar spokespeople that host video
              notes and live shopping.
            </p>
            <p>
              One brief, four lanes, every surface. One hero direction, fifty
              market variants. AIGC inside a working production company, not in
              place of one.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> RedNote-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/rednote-hero.jpg"
          alt="A close editorial portrait of a hand holding a phone in warm rim light, the phone screen filled with the RedNote discovery feed shown as a two-column staggered grid of lifestyle note cards, each card a cover photo with a small heart-shaped like count."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> RedNote</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- S2 · WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              What we ship<br /><span class="serif">into RedNote</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              We do four kinds of work for RedNote, end to end. Organic photo
              and video notes for the discovery feed and for search. Paid ad
              creative built for the in-feed and search auctions.
              Creator-style KOC notes at volume. Brand-owned avatar
              spokespeople that host video notes and live shopping.
            </p>
            <p class="r" style="--d:.16s">
              One creative direction sits across all four. The same studio
              hands that retouch the hero cover finish every variant in every
              lane, so the long tail looks like the campaign rather than a
              thinned clone of it.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/rednote-roots.jpg"
              alt="A wide editorial shot of two designers at a daylit Shanghai studio table, four laptop screens lined up showing the RedNote discovery feed, an open photo note, a RedNote search results page and a vertical video note, one per service lane."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Four lanes, one creative direction</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            One RedNote brief, four service lanes, every surface. Notes, ad
            creative, KOC and avatar finished by the same studio hands, with
            fifty-plus variants per concept and brief to first note inside
            forty-eight hours on short-form work.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S3 · COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Four lanes, one <span class="serif">brand line</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} surface</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Surface</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- S4 · PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Photo notes, video notes and ad covers produced through the studio
            pipeline. Every frame is authored work, sized for the surface it
            ships on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S5 · PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/rednote-hybrid-main.jpg"
                alt="A producer at a wide reference monitor showing a RedNote ad creative library, four columns of photo and video notes tagged Notes, Ads, KOC and Avatar."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/rednote-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand holding a phone vertically against a soft cream background, the screen filled with an open RedNote photo note showing the swipe dots and the bottom interaction bar."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Four lanes, every surface, every market</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Authored creative, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The brands compounding their RedNote results in 2026 are not the
            ones posting the most. They are the ones running an authored
            creative process with AIGC inside it.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit between the technical and the creative: a working studio
            with directors, retouchers and colourists alongside the AIGC
            engineers and the LoRA-training pipeline. Every note ships with
            the same brand discipline as the hero, because the same hands
            sign it off.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in
            mainland China, Hong Kong, the EU or the US depending on your
            data sovereignty position. Custom-trained LoRA models stay your
            property and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            We pick up where you need us and step back where you do not.
          </p>
        </div>
      </div>
    </section>

    <!-- S6 · PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a RedNote campaign runs</p>
        <h2 class="dh r" style="--d:.05s">
          One brief,<br />every <span class="serif">placement</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Notes, ad covers, KOC and avatar share the same brand line, and
          the same process. The surface changes; the discipline stays the
          same. The work is won in the direction, not in the launch.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- S7 · FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S8 · CLOSE -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the RedNote brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          A surface-by-surface recommendation, a scope outline, an indicative
          timeline and a few free photo-note covers so you can see the
          thinking before any budget commits.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Send the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
