  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
