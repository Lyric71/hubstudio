const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const SITE = 'https://www.hubstudio.ai';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'RedNote', item: `${SITE}/solutions/platforms/rednote` },
  ],
};
---

<Layout
  title="RedNote (Xiaohongshu) Agency & AIGC Studio: Notes, KOLs, Juguang Ads & Store | hubStudio"
  description="Full-service RedNote (Xiaohongshu) agency and AIGC studio: Blue V setup, search-optimized notes, Pugongying KOL seeding, Juguang ads, RedNote Store, and live commerce."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- S1 · HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> RedNote
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Full-service</span></span>
            <span class="line"><span class="line__i serif">RedNote growth.</span></span>
            <span class="line"><span class="line__i">AIGC, at scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Blue V &amp; Notes. KOL Seeding. Juguang Ads. Store. <em>Studio AIGC.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We run your entire RedNote (Xiaohongshu) presence from Shanghai:
              Professional Account (Blue V) verification, search-optimized photo
              and video notes, verified KOL and KOC seeding on Pugongying,
              full-funnel media buying on Juguang and Chengfeng, plus RedNote
              Store and livestream commerce.
            </p>
            <p>
              Underneath the agency operation sits our AIGC production studio,
              turning one creative direction into fifty-plus cover variants,
              owned studio KOC notes, and custom Mandarin avatar hosts.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> Full-service RedNote agency &amp; AIGC studio
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/rednote-hero.jpg"
          alt="A close editorial portrait of a hand holding a phone in warm rim light, the phone screen filled with the RedNote discovery feed shown as a two-column staggered grid of lifestyle note cards, each card a cover photo with a small heart-shaped like count."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> RedNote</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- S2 · WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Everything we do<br /><span class="serif">on RedNote</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              RedNote is where over 300 million Chinese consumers research
              products, read trusted reviews, and buy directly in-app. Winning
              here takes more than pretty pictures: it requires Blue V account
              authority, search-keyword SEO, Pugongying KOL seeding, Juguang
              paid amplification, and a converting RedNote Store.
            </p>
            <p class="r" style="--d:.16s">
              We keep all six pillars in one Shanghai and Hong Kong team,
              combining licensed Chinese media buying and KOL management with a
              production studio that ships fifty-plus cover and KOC variants off
              a single brief.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/rednote-roots.jpg"
              alt="A wide editorial shot of two designers at a daylit Shanghai studio table, four laptop screens lined up showing the RedNote discovery feed, an open photo note, a RedNote search results page and a vertical video note, one per service lane."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Six RedNote pillars, one integrated Shanghai &amp; Hong Kong team</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            One brief across Blue V account management, Pugongying KOL seeding,
            Juguang and Chengfeng ad buying, RedNote Store commerce, and studio
            AIGC production.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S3 · COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Feed, search and store, <span class="serif">connected</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} surface</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Pillar</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }

        <div class="matrix">
          <header class="matrix__head">
            <p class="kicker r"><span class="kicker__tick"></span>Complete service catalog</p>
            <h3 class="dh dh--sm r" style="--d:.05s">
              Six RedNote pillars, <span class="serif">end to end</span>.
            </h3>
          </header>
          <div class="matrix__grid">
            {
              servicePillars.map((p, i) => (
                <article class="mcard r" style={`--d:${(i % 3) * 0.08}s`}>
                  <p class="mcard__eyebrow">{p.eyebrow}</p>
                  <h4 class="mcard__title">{p.title}</h4>
                  <p class="mcard__body">{p.body}</p>
                  <ul class="mcard__list">
                    {p.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S4 · PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Photo notes, video notes and ad covers, all made through the studio
            pipeline. Every frame is original work, sized to the surface it
            ships on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S5 · PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/rednote-hybrid-main.jpg"
                alt="A producer at a wide reference monitor showing a RedNote ad creative library, four columns of photo and video notes tagged Notes, Ads, KOC and Avatar."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/rednote-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand holding a phone vertically against a soft cream background, the screen filled with an open RedNote photo note showing the swipe dots and the bottom interaction bar."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Six pillars, feed, search and store</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Shanghai agency ops, <span class="serif">AIGC volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The brands pulling ahead on RedNote in 2026 are not choosing between
            a Pugongying KOL agency, a Juguang media buyer, and a production
            studio. They run all three inside one coordinated operation.
          </p>
          <p class="source__p r" style="--d:.16s">
            In our Shanghai studio, RedNote account strategists, Pugongying
            KOL managers, and Juguang media buyers work in the same building as
            our directors, retouchers, colorists, and AIGC engineers. Every
            campaign is built around Chinese search intent and backed by the
            cover and note volume the auction demands.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure. Hosting sits in
            mainland China, Hong Kong, the EU or the US, depending on where
            your data needs to live. The LoRA and avatar models we train for
            you stay your property, and you can take them with you if you ever
            leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Hand us the entire RedNote channel, or start with a single pillar.
          </p>
        </div>
      </div>
    </section>

    <!-- APP OR STUDIO -->
    <PlatformAppBand
      pre={'Full-service RedNote from our '}
      accent={'Shanghai & HK team'}
      post={'.'}
      paras={[
        'Our Shanghai and Hong Kong team manages your RedNote presence end to end: Blue V verification, search-optimized photo and video notes, Pugongying KOL and KOC seeding, Juguang and Chengfeng paid media buying, and RedNote Store and livestream operations. Because RedNote requires local execution, our team handles publishing and campaign management directly while sharing every draft and report in your workspace.',
        'Your internal team can also generate product visuals and video inside the hubStudio app, then pass them to our Shanghai studio to retouch, write native Chinese search copy, and deploy across RedNote.',
      ]}
      actions={[
        { label: 'Send a brief', href: `${BRIEF_URL}?way=studio`, kind: 'primary' },
        { label: 'What the app makes', href: '/app/create' },
      ]}
    />

    <!-- S6 · PROCESS -->
    <section class="craft" id="craft">
      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell craft__intro">
            <p class="kicker r"><span class="kicker__tick"></span>How a RedNote program runs</p>
            <h2 class="dh r" style="--d:.05s">
              One brief,<br />every <span class="serif">RedNote lever</span>.
            </h2>
            <p class="craft__lede r" style="--d:.12s">
              Blue V setup, organic notes, Pugongying KOL seeding, Juguang paid
              media, RedNote Store operations, and studio AIGC all run through one
              five-step process. Most of the outcome is decided early, in the
              search strategy and creative direction, before anything launches.
            </p>
            <p class="craft__note r" style="--d:.16s">
              The first two steps are where it is won or lost. The rest is execution and optimization.
            </p>
          </div>

          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- S7 · FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <WaysToWork tone="white" highlight="studio" />

    <!-- S8 · CLOSE -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the RedNote brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          A producer reads your brief within one business day, and the proposal that comes back gives you a recommendation for each surface, with the scope and the timing. Would you rather make the covers in-house? The app can do that. Creating an account costs nothing, and you pay only for what you run.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href={BRIEF_URL}>Send a brief</Button>
          <a class="ghost-link ghost-link--light" href={APP_SIGNUP} target="_blank" rel="noopener">
            Create your account
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
        <p class="end__signin r" style="--d:.22s">
          Already on hubStudio? <a href={APP_SIGNIN} target="_blank" rel="noopener">Sign in</a>
        </p>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow-x: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }

  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }

  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }

  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.82fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
  }
  .band__note { font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }

  .cbar { display: flex; height: 12px; }
  .cbar span { flex: 1; }
  .cbar--end { margin-top: clamp(60px, 8vw, 110px); }

  /* Hero */
  .hero { display: grid; background: var(--ink); color: var(--text-on-dark); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1fr; } }
  .hero__panel { position: relative; display: flex; align-items: center; padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px); overflow: clip; }
  .hero__reg { position: absolute; width: clamp(240px, 28vw, 420px); right: -12%; bottom: -14%; color: rgba(240, 237, 233, 0.055); pointer-events: none; }
  .hero__panel-in { position: relative; width: 100%; max-width: 600px; }
  .hero__title { margin-top: 24px; font-family: var(--font-sans); font-weight: 600; font-size: clamp(46px, 6.6vw, 92px); line-height: 1.02; letter-spacing: -0.045em; }
  .hero__title .line { display: block; overflow: hidden; padding: 0.22em 0.14em; margin: -0.22em -0.14em; }
  .hero__title .line__i { display: block; transform: translateY(145%); transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero__title .line:nth-child(1) .line__i { transition-delay: 0.12s; }
  .hero__title .line:nth-child(2) .line__i { transition-delay: 0.22s; }
  .hero__title .line:nth-child(3) .line__i { transition-delay: 0.32s; }
  .hero.in .hero__title .line__i { transform: translateY(0); }
  .hero__title .serif { font-size: 1.04em; }
  @media (prefers-reduced-motion: reduce) { .hero__title .line__i { transform: none; } }
  .hero__tag { margin-top: 26px; font-size: clamp(18px, 1.5vw, 23px); font-weight: 600; letter-spacing: -0.02em; }
  .hero__tag em { font-family: var(--font-serif); font-style: italic; font-weight: 500; color: var(--brand-orange); }
  .hero__lead { margin-top: 20px; display: grid; gap: 13px; max-width: 46ch; }
  .hero__lead p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.74); }
  .hero__cta { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .hero__meta { margin-top: 34px; padding-top: 20px; border-top: 1.5px dashed rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(240, 237, 233, 0.5); }
  .hero__meta span { color: var(--brand-orange); }
  .hero__visual { position: relative; overflow: hidden; min-height: 58vh; }
  @media (min-width: 900px) { .hero__visual { min-height: auto; } }
  .hero__visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero.in .hero__visual img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) { .hero__visual img { transform: none; } }
  .hero__chip { position: absolute; left: 18px; bottom: 18px; z-index: 2; display: inline-flex; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); background: rgba(14, 22, 51, 0.78); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-on-dark); }
  .hero__chip span { color: var(--brand-orange); }

  /* Why */
  .why { background: var(--ink); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .why__top { display: grid; gap: 30px; }
  @media (min-width: 900px) { .why__top { grid-template-columns: 1fr 1fr; gap: 70px; align-items: start; } }
  .why__head .dh { margin-top: 18px; }
  .why__text { display: grid; gap: 16px; align-content: start; padding-top: 6px; }
  .why__text p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.78); }
  .why__clients { color: rgba(240, 237, 233, 0.6) !important; }
  .why__clients strong { color: var(--text-on-dark); font-weight: 600; }
  .why__shot { margin-top: clamp(40px, 5vw, 72px); }
  .why__shot .crop__inner { aspect-ratio: 16 / 8; }
  .why__shot .fig { color: rgba(240, 237, 233, 0.5); }

  .stats { margin-top: clamp(48px, 6vw, 84px); border-top: 1.5px dashed rgba(240, 237, 233, 0.22); padding-top: clamp(36px, 4vw, 56px); }
  .stats__quote { max-width: 60ch; font-family: var(--font-serif); font-style: italic; font-size: clamp(19px, 1.9vw, 25px); line-height: 1.42; color: var(--text-on-dark); }
  .stats__grid { margin-top: 40px; display: grid; gap: 30px; }
  @media (min-width: 720px) { .stats__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .stat { display: grid; gap: 5px; padding-top: 24px; border-top: 1.5px solid rgba(240, 237, 233, 0.16); }
  .stat__num { font-size: clamp(56px, 7vw, 96px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--brand-orange); }
  .stat__label { margin-top: 6px; font-size: 16px; font-weight: 600; }
  .stat__note { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(240, 237, 233, 0.55); }

  /* Coverage */
  .cover { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .feature { display: grid; gap: 36px; align-items: center; padding-block: clamp(40px, 5vw, 72px); border-top: 1.5px dashed var(--line-strong); }
  .feature:last-child { border-bottom: 1.5px dashed var(--line-strong); }
  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1fr; gap: 72px; }
    .feature--rev .feature__media { order: 2; }
  }
  .feature__media .crop__inner { aspect-ratio: 5 / 4; }
  .feature__idx { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .feature__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .feature__body .dh { margin-top: 16px; }
  .feature__lead { margin-top: 14px; font-size: var(--type-lead); line-height: 1.42; color: var(--text-ink); font-weight: 500; }
  .feature__p { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .feature__scope { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line-hairline); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); }
  .chips { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); font-size: 12px; font-weight: 500; transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease; }
  .chip:hover { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }

  .matrix { margin-top: clamp(56px, 7vw, 96px); padding-top: clamp(48px, 6vw, 80px); border-top: 1.5px dashed var(--line-strong); }
  .matrix__head { max-width: 680px; margin-bottom: clamp(32px, 4vw, 52px); display: grid; gap: 14px; }
  .matrix__grid { display: grid; gap: 22px; }
  @media (min-width: 720px) { .matrix__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .matrix__grid { grid-template-columns: repeat(3, 1fr); } }
  .mcard { display: flex; flex-direction: column; gap: 12px; padding: clamp(24px, 3vw, 32px); background: var(--bg-white); border: 1px solid var(--line-strong); border-radius: 6px; }
  .mcard__eyebrow { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .mcard__title { font-size: clamp(19px, 1.8vw, 23px); font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; color: var(--text-ink); }
  .mcard__body { font-size: var(--type-body); line-height: 1.6; color: var(--text-mute); }
  .mcard__list { margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--line-strong); list-style: none; padding-left: 0; display: grid; gap: 7px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--text-ink); }
  .mcard__list li { position: relative; padding-left: 14px; }
  .mcard__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 1.5px; background: var(--brand-orange); }

  /* Proof */
  .proof { background: var(--bg-white); padding-block: clamp(80px, 10vw, 150px); }
  .sheet { display: grid; gap: clamp(22px, 3vw, 40px); }
  @media (min-width: 720px) {
    .sheet { grid-template-columns: repeat(3, 1fr); }
    .sheet .shot:nth-child(3n + 2) { margin-top: 60px; }
    .sheet .shot:nth-child(3n) { margin-top: 30px; }
  }
  .shot .crop__inner { aspect-ratio: 1 / 1; }
  .shot .crop__inner img { transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .shot:hover .crop__inner img { transform: scale(1.06); }
  .shot__cap { margin-top: 14px; display: flex; align-items: baseline; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .shot__kind { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-ink); }

  /* Partnership / Source */
  .source { background: var(--navy); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .source__grid { display: grid; gap: 52px; }
  @media (min-width: 940px) { .source__grid { grid-template-columns: 0.92fr 1.08fr; gap: 70px; align-items: center; } }
  .source__visual { position: relative; }
  .source__main .crop__inner { aspect-ratio: 5 / 4; }
  .source__inset { position: absolute; right: -14px; bottom: -34px; width: 42%; max-width: 200px; margin: 0; border-radius: 8px; overflow: hidden; border: 5px solid var(--navy); box-shadow: 0 20px 36px rgba(0, 0, 0, 0.42); }
  .source__inset img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  @media (max-width: 520px) { .source__inset { display: none; } }
  .source__stat { position: absolute; left: -10px; top: 36px; display: grid; gap: 3px; padding: 15px 19px; border-radius: 12px; background: var(--brand-orange); color: #fff; box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42); }
  .source__stat-num { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .source__stat-cap { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase; max-width: 15ch; line-height: 1.4; }
  .source__body .dh { margin-top: 16px; }
  .source__lead { margin-top: 20px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-on-dark); }
  .source__p { margin-top: 15px; font-size: var(--type-body); line-height: 1.66; color: rgba(240, 237, 233, 0.78); }
  .source__p--quiet { color: rgba(240, 237, 233, 0.55); }
  .creds { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 9px; }
  .cred { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); border: 1px solid rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 12px; font-weight: 500; transition: border-color 0.2s ease, background-color 0.2s ease; }
  .cred:hover { border-color: var(--brand-orange); background: rgba(233, 78, 27, 0.16); }
  .cred svg { width: 13px; height: 13px; color: var(--brand-orange); }

  /* Process */
  .craft { background: var(--paper); padding-top: clamp(72px, 8vw, 120px); }
  .craft--pinned { padding-top: 0; }
  .craft__intro { margin-bottom: clamp(20px, 2.4vh, 32px); }
  .craft__intro .kicker { color: var(--brand-orange); }
  .craft__intro .dh { margin-top: 10px; }
  .craft__lede { margin-top: 12px; font-size: var(--type-lead); line-height: 1.48; color: var(--text-mute); }
  .craft__note { margin-top: 14px; display: inline-block; padding: 11px 18px; border-left: 3px solid var(--brand-orange); background: rgba(233, 78, 27, 0.07); border-radius: 0 10px 10px 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--text-ink); }
  @media (min-width: 880px) {
    .craft__intro { display: grid; grid-template-columns: 1.08fr 0.92fr; column-gap: clamp(40px, 5vw, 72px); align-items: start; }
    .craft__intro .kicker { grid-column: 1 / -1; }
    .craft__intro .dh { grid-column: 1; grid-row: 2 / span 2; margin-top: 10px; }
    .craft__lede { grid-column: 2; grid-row: 2; margin-top: 10px; }
    .craft__note { grid-column: 2; grid-row: 3; margin-top: 12px; justify-self: start; }
  }

  .seq__nav { display: none; }
  .seq__panels { display: grid; gap: clamp(48px, 7vw, 96px); padding-bottom: clamp(80px, 10vw, 150px); }
  .seq__panel { display: grid; gap: 28px; }
  @media (min-width: 760px) {
    .seq__panel { grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .seq__panel:nth-child(even) .seq__media { order: 2; }
  }
  .seq__media .crop__inner { aspect-ratio: 4 / 3; }
  .seq__tier { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .seq__title { margin-top: 12px; font-size: clamp(25px, 2.7vw, 38px); font-weight: 600; line-height: 1.12; letter-spacing: -0.025em; }
  .seq__body { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }

  .craft--pinned .seq { height: 380vh; }
  .craft--pinned .seq__stick { position: sticky; top: var(--nav-h); min-height: calc(100vh - var(--nav-h)); display: flex; flex-direction: column; justify-content: center; padding-block: clamp(20px, 2.8vh, 36px) clamp(24px, 3.5vh, 44px); overflow: hidden; }
  .craft--pinned .seq__stage { width: 100%; display: flex; flex-direction: column; gap: clamp(16px, 2vh, 24px); }
  .craft--pinned .seq__nav { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .seq__step { display: flex; flex-direction: column; gap: 10px; padding: 0; background: transparent; border: none; text-align: left; cursor: pointer; }
  .seq__step-dot { height: 5px; border-radius: 3px; background: var(--line-strong); overflow: hidden; }
  .seq__step-fill { display: block; height: 100%; width: 100%; background: var(--brand-orange); transform: scaleX(0); transform-origin: 0 50%; }
  .seq__step-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-mute); transition: color 0.3s ease; }
  .seq__step[data-active='true'] .seq__step-label { color: var(--text-ink); }
  .craft--pinned .seq__panels { position: relative; display: block; height: clamp(290px, 44vh, 420px); padding-bottom: 0; }
  .craft--pinned .seq__panel { position: absolute; inset: 0; align-content: start; padding-top: 8px; opacity: 0; visibility: hidden; transform: translateY(26px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.5s; }
  .craft--pinned .seq__panel[data-active='true'] { opacity: 1; visibility: visible; transform: none; transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .craft--pinned .seq__panel:nth-child(even) .seq__media { order: 0; }
  .craft--pinned .seq__media .crop__inner { aspect-ratio: auto; height: clamp(260px, 40vh, 390px); }
  @media (prefers-reduced-motion: reduce) { .craft--pinned .seq__panel { transition: none; } }

  /* FAQ */
  .faq { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .faq__grid { display: grid; gap: 44px; }
  @media (min-width: 1000px) {
    .faq__grid { grid-template-columns: 0.78fr 1.22fr; gap: 72px; align-items: start; }
    .faq__intro { position: sticky; top: 96px; }
  }
  .faq__intro .dh { margin-top: 18px; }
  .faq__sub { margin-top: 18px; margin-bottom: 26px; font-size: var(--type-body); line-height: 1.62; color: var(--text-mute); }
  .acc { display: grid; }
  .acc__row { border-top: 1.5px solid var(--ink); }
  .acc__row:last-child { border-bottom: 1.5px solid var(--ink); }
  .acc__q { width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 16px; padding: 26px 0; background: transparent; border: none; text-align: left; }
  .acc__qmark { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--brand-orange); padding-top: 3px; }
  .acc__qtext { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; color: var(--text-ink); transition: color 0.18s ease; }
  .acc__q:hover .acc__qtext { color: var(--brand-orange); }
  .acc__icon { position: relative; width: 22px; height: 22px; margin-top: 2px; }
  .acc__icon span { position: absolute; top: 50%; left: 50%; width: 14px; height: 2px; border-radius: 2px; background: var(--text-ink); transform: translate(-50%, -50%); transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(90deg); }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(0deg); }
  .acc__q[aria-expanded='true'] .acc__icon span { background: var(--brand-orange); }
  .acc__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s ease; }
  .acc__q[aria-expanded='true'] + .acc__a { grid-template-rows: 1fr; }
  .acc__a-inner { overflow: hidden; }
  .acc__a-inner p { padding: 0 0 26px 41px; max-width: 64ch; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .acc__a-inner a { color: var(--brand-orange); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  /* Close */
  .end { position: relative; background: var(--ink); color: var(--text-on-dark); padding-top: clamp(80px, 11vw, 150px); overflow: clip; }
  .end__reg { position: absolute; width: clamp(300px, 36vw, 560px); top: -16%; right: -9%; color: rgba(240, 237, 233, 0.05); pointer-events: none; }
  .end__inner { position: relative; display: grid; justify-items: start; gap: 22px; }
  .end__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(40px, 6.6vw, 96px); line-height: 0.98; letter-spacing: -0.04em; }
  .end__p { max-width: 54ch; font-size: var(--type-lead); line-height: 1.5; color: rgba(240, 237, 233, 0.78); }
  .end__cta { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .end__signin { font-size: var(--type-small); color: rgba(240, 237, 233, 0.62); }
  .end__signin a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { t } from '../../../scripts/i18n';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const progBar = document.querySelector<HTMLElement>('.prog__bar');
  if (progBar) {
    const onScroll = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      progBar.style.transform = `scaleX(${max > 0 ? Math.min(1, d.scrollTop / max) : 0})`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  const revealEls = document.querySelectorAll('.r, .r-clip, .hero');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -7% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  const nums = Array.from(document.querySelectorAll<HTMLElement>('.stat__num'));
  const runCount = (el: HTMLElement) => {
    const from = Number(el.dataset.from || 0);
    const to = Number(el.dataset.to || 0);
    // The number goes into a whole template ({n} days, {n}h) so a language
    // can translate the unit and place it where it reads naturally.
    const suffix = el.dataset.suffix || '';
    if (reduceMotion.matches) {
      el.textContent = t(`{n}${suffix}`, { n: to });
      return;
    }
    const dur = 1500;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = t(`{n}${suffix}`, { n: Math.round(from + (to - from) * eased) });
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && nums.length) {
    const io2 = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runCount(e.target as HTMLElement);
            io2.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((n) => io2.observe(n));
  } else {
    nums.forEach(runCount);
  }

  const craft = document.getElementById('craft');
  const seq = document.getElementById('seq');
  if (craft && seq) {
    const steps = Array.from(seq.querySelectorAll<HTMLElement>('.seq__step'));
    const panels = Array.from(seq.querySelectorAll<HTMLElement>('.seq__panel'));
    const fills = steps.map((s) => s.querySelector<HTMLElement>('.seq__step-fill'));
    const n = panels.length;
    const wide = window.matchMedia('(min-width: 880px)');

    const setActive = (idx: number, sub: number) => {
      panels.forEach((p, i) => (p.dataset.active = String(i === idx)));
      steps.forEach((s, i) => {
        s.dataset.active = String(i === idx);
        const f = fills[i];
        if (f) f.style.transform = `scaleX(${i < idx ? 1 : i === idx ? sub : 0})`;
      });
    };

    const stick = seq.querySelector<HTMLElement>('.seq__stick');
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!craft.classList.contains('craft--pinned')) return;
      const stickH = stick ? stick.offsetHeight : window.innerHeight;
      const stickTop = stick ? parseFloat(getComputedStyle(stick).top) || 0 : 0;
      const total = Math.max(1, seq.offsetHeight - stickH);
      const scrolled = Math.min(total, Math.max(0, stickTop - seq.getBoundingClientRect().top));
      const p = total > 0 ? scrolled / total : 0;
      const exact = p * n;
      const idx = Math.min(n - 1, Math.floor(exact));
      const sub = Math.min(1, Math.max(0, exact - idx));
      setActive(idx, idx === n - 1 ? 1 : sub);
    };
    const onScrollSeq = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const applyMode = () => {
      if (wide.matches && !reduceMotion.matches) {
        craft.classList.add('craft--pinned');
        update();
      } else {
        craft.classList.remove('craft--pinned');
        panels.forEach((p) => (p.dataset.active = 'true'));
      }
    };

    steps.forEach((s, i) => {
      s.addEventListener('click', () => {
        if (!craft.classList.contains('craft--pinned')) return;
        const stickH = stick ? stick.offsetHeight : window.innerHeight;
        const stickTop = stick ? parseFloat(getComputedStyle(stick).top) || 0 : 0;
        const railTop = seq.getBoundingClientRect().top + window.scrollY - stickTop;
        const total = Math.max(1, seq.offsetHeight - stickH);
        window.scrollTo({
          top: railTop + ((i + 0.5) / n) * total,
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
        });
      });
    });

    window.addEventListener('scroll', onScrollSeq, { passive: true });
    window.addEventListener('resize', () => {
      applyMode();
      update();
    });
    applyMode();
  }

  const accQs = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc__q'));
  accQs.forEach((q) => {
    q.addEventListener('click', () => {
      const open = q.getAttribute('aria-expanded') === 'true';
      accQs.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      q.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
