---
/**
 * Amazon · /solutions/platforms/amazon
 *
 * What hubStudio does for Amazon, across three service lanes: product
 * content, store content and ad creative. Editorial print-shop layout (crop
 * marks, calibration colour bar, mono figure labels, dashed rules) carried
 * over from meta.astro, the platform-page reference implementation.
 *
 * Page excerpt (25 words): hubStudio makes three kinds of work for Amazon:
 * product content for the detail page, store content for the Brand Store and
 * Posts, and ad creative.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 3, suffix: '', label: 'Lanes we ship', note: 'Product content, store, ad creative' },
  { from: 0, to: 50, suffix: '+', label: 'Variants per concept', note: 'From one signed-off master' },
  { from: 0, to: 48, suffix: 'h', label: 'Brief to first cut', note: 'On listing images and A+ modules' },
];

const samples = [
  {
    src: '/Images/amazon-sample-aplus.jpg',
    kind: 'Product content · A+ module',
    alt: 'A laptop screen showing an Amazon product detail page scrolled to the A+ Content section, a comparison chart module and an image-with-text module stacked below the listing.',
  },
  {
    src: '/Images/amazon-sample-listing.jpg',
    kind: 'Product content · Listing images',
    alt: 'A vertical phone held in soft window light, the screen showing an Amazon product detail page with the large main image on white and the vertical strip of gallery thumbnails beside it.',
  },
  {
    src: '/Images/amazon-sample-store.jpg',
    kind: 'Store content · Brand Store',
    alt: 'A phone held vertically, the screen displaying an Amazon Brand Store homepage, a brand header banner above a grid of shoppable category tiles.',
  },
  {
    src: '/Images/amazon-sample-sbrands.jpg',
    kind: 'Ad creative · Sponsored Brands',
    alt: 'A laptop screen showing Amazon search results, a Sponsored Brands banner at the top with a logo lockup, a headline and three product thumbnails in a row.',
  },
  {
    src: '/Images/amazon-sample-display.jpg',
    kind: 'Ad creative · Sponsored Display',
    alt: 'A phone screen showing an Amazon product detail page with a Sponsored Display ad placement sitting in the right-hand column beside the price block.',
  },
];

const coverage = [
  {
    fig: 'B',
    label: 'Product content',
    heading: 'Product content. The whole detail page.',
    image: '/Images/amazon-product.jpg',
    alt: 'A phone held in both hands, the screen showing an Amazon product detail page scrolled to the A+ Content section, a comparison chart module and an image-with-text module visible above the Amazon app navigation bar.',
    lead: 'Everything on the detail page that sells the product: the image stack, the A+ modules and the listing video, made to the standard of the paid work.',
    body: [
      "The detail page is where the sale is won, and most catalogues treat it like a form. A main image shot years ago, a few soft gallery photos, an A+ section the manufacturer sent over. We build the whole page instead: the main image clean on white the way Amazon policy demands, gallery frames carrying the infographics, the scale shots, the lifestyle context and the comparison a shopper scrolls for, A+ Content and the Brand Story module designed rather than assembled, and a listing video that survives the first three seconds.",
      "Deal badges, coupon graphics and value-comparison callouts get the same treatment, sized to Amazon's placement rules so nothing is suppressed at upload. A creative director signs off every module, and the retoucher who finishes the hero image finishes the scale diagram too. That is how a catalogue scales without quietly drifting listing to listing.",
    ],
    tags: [
      'Main image', 'Gallery infographics', 'Lifestyle frames',
      'A+ Content modules', 'A+ Brand Story', 'Premium A+',
      'Listing video', 'Deal & coupon graphics',
    ],
  },
  {
    fig: 'C',
    label: 'Store content',
    heading: 'Store content. The Brand Store and the feed.',
    image: '/Images/amazon-store.jpg',
    alt: 'A phone screen showing an Amazon Brand Store homepage, a brand header banner above a grid of shoppable category tiles, the Amazon app navigation visible at the top of the interface.',
    lead: "The brand's own storefront on Amazon: the multi-page Brand Store and the Posts feed, run like a real channel rather than a default template.",
    body: [
      "Amazon hands every Brand Registry seller a Store, a multi-page site inside Amazon that most brands fill with a header and a product grid, then forget. We design it as a real destination instead. A landing page that states what the brand is. Category pages that merchandise rather than dump. Shoppable lifestyle tiles. Seasonal refreshes timed to the retail calendar. The Posts feed runs on a weekly rhythm, the social surface inside Amazon kept alive instead of going stale.",
      "Same direction as the detail page, same finishing hands. The Store, the Posts feed and the listings all read as one brand, because they come off one bench. When a campaign launches, the Store moves with it, not three weeks later.",
    ],
    tags: [
      'Brand Store pages', 'Store landing page', 'Category merchandising',
      'Shoppable tiles', 'Amazon Posts', 'Seasonal refresh',
      'Brand banners', 'Always-on feed',
    ],
  },
  {
    fig: 'D',
    label: 'Ad creative',
    heading: 'Ad creative. Sponsored Brands, Display and DSP.',
    image: '/Images/amazon-ads.jpg',
    alt: 'A wide monitor showing the Amazon advertising console creative library, a grid of Sponsored Brands banners and Sponsored Display ad variants lined up in the placement preview panel.',
    lead: "Paid creative for Amazon's ad surfaces, made in the volume the placements and the auction actually reward.",
    body: [
      "Sponsored Brands wants a logo lockup, a custom headline and a curated product set. Sponsored Brands video wants a hook in the first second. Sponsored Display and Amazon DSP want creative that works on the detail page and off Amazon entirely. We build to the exact placement set the media team is buying, in every ratio and length the auction will take, and we name the files so the reporting still reads clearly a month later.",
      "Custom headlines, video hooks, retargeting variants, off-Amazon display: all of it gets the same studio finish as the hero. The fortieth variant should still look like the campaign, not a tired copy of it.",
    ],
    tags: [
      'Sponsored Brands', 'Sponsored Brands video', 'Sponsored Display',
      'Amazon DSP display', 'DSP video', 'Custom headlines',
      'Retargeting variants', 'Off-Amazon creative',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session. We pin down the catalogue, the priority ASINs, which Amazon surfaces are in play, what the brand stands for and what it will not do. You leave with a one-page brief and a map of every asset, sorted by ASIN and by lane.',
    image: '/Images/amazon-p1-brief.jpg',
    alt: 'A creative director and a brand lead at a studio table, a laptop between them showing an Amazon Brand Store layout alongside printed product detail page and A+ Content screenshots.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction across the three lanes.',
    body: 'References go on the wall, the tone gets named, the module list takes shape, and we pick the AI models that suit each lane. Product content, store and ad creative each get their own treatment. This is the step that makes a catalogue yours and not a template.',
    image: '/Images/amazon-p2-direction.jpg',
    alt: 'A storyboard wall with three columns of frame sketches labelled Product, Store and Ads, each column anchored by a printed Amazon product detail page mock.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Now the volume gets made, lane by lane, ASIN by ASIN. Nothing reaches a listing or a media plan until it has been through the retouch bench and the brand check.',
    image: '/Images/amazon-p3-aigc.jpg',
    alt: 'A motion designer at a calibrated workstation, the main monitor showing a single Amazon A+ Content hero module, the side panel showing the Amazon advertising console creative library grid of variants.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-ASIN, per-marketplace.',
    body: 'Files go to the catalogue and media teams in the formats Amazon actually serves: the right ratios for each ad placement, the module set for each detail page, the image stack named per ASIN. The naming matters more than it sounds. It is what keeps the catalogue legible once it is live.',
    image: '/Images/amazon-p4-launch.jpg',
    alt: 'A media buyer at a daylit studio desk, the calibrated monitor showing the Amazon advertising console campaign dashboard with Sponsored Brands and Sponsored Display placements live.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Variants, refresh, season.',
    body: 'Once the hero listing is approved, new variants come fast: a new ASIN in the range, a different marketplace, a seasonal swap on the Store. The original brief still holds. You are adding to it, not starting over.',
    image: '/Images/amazon-p5-adapt.jpg',
    alt: 'A colourist at a calibrated grading suite, the main reference monitor showing a warm Amazon lifestyle listing image paused on a product still, the gallery thumbnail strip visible at the screen edge.',
  },
];

const faqs = [
  {
    q: 'What exactly do you produce for Amazon?',
    a: 'Three lanes, one studio. Product content covers the main image, gallery infographics, lifestyle frames, A+ Content modules, the Brand Story and the listing video for the detail page. Store content covers the multi-page Brand Store and the Posts feed. Ad creative covers Sponsored Brands, Sponsored Brands video, Sponsored Display and Amazon DSP. The lanes share one creative direction and one finishing pass, so the long tail of the catalogue looks like the hero ASIN.',
  },
  {
    q: 'How does the Product content lane handle A+ Content and listing images?',
    a: "We design the full detail page, not a single asset. The main image is built clean on white to Amazon's policy, the gallery carries the infographics, scale shots, lifestyle frames and comparison a shopper scrolls for, and the A+ Content and Brand Story modules are designed module by module rather than dropped in from a manufacturer template. Premium A+ is built where the brand is enrolled. Everything is sized to Amazon's current image and A+ guidelines so nothing is suppressed at upload.",
  },
  {
    q: 'What is in the Store content lane?',
    a: 'The brand-owned storefront inside Amazon: the multi-page Brand Store with a real landing page, merchandised category pages and shoppable lifestyle tiles, plus the Amazon Posts feed run on a weekly rhythm. We treat the Store as a channel, not a default template, and refresh it on the retail calendar so it moves with the campaigns rather than going stale between them.',
  },
  {
    q: 'Can you produce listing and ad creative at the volume our catalogue needs?',
    a: 'Yes. A single hero shoot or AIGC sprint produces the master, and the variant cascade lands per ASIN, per marketplace and per ad placement inside days. The cost-per-variation curve flattens fast: the first variant is expensive, the fiftieth is close to free. Custom-trained LoRA models on your products keep every frame on-brand across the catalogue.',
  },
  {
    q: 'How do you keep the brand line consistent across a large catalogue?',
    a: 'The hero concept is signed off once, in the direction step. After that, every A+ module, every Store tile and every ad variant runs through the same retouch pass, the same colour grade and the same brand check. The studio is what keeps a ten-ASIN or hundred-ASIN catalogue reading like one brand rather than a pile of listings built by different freelancers.',
  },
  {
    q: 'What is your turnaround for a detail page or an ad asset?',
    a: 'Listing images and A+ modules on an existing brand can be brief to first cut in 24 to 72 hours. A new brand or a new product line takes a one-time onboarding to lock the treatment and the LoRA models; after that, weekly drops at production-grade quality are the working tempo.',
  },
  {
    q: 'Do you handle Sponsored Brands, Sponsored Display and Amazon DSP creative?',
    a: 'Yes. We brief the ad creative lane around the placement set the media team is buying: Sponsored Brands logo lockups and custom headlines, Sponsored Brands video, Sponsored Display for the detail page and off Amazon, and Amazon DSP display and video. Variants are produced in every ratio and length the auction will take and named so the reporting downstream stays legible.',
  },
  {
    q: 'How do you keep the work from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, grain, chromatic aberration and a colour grade in Lightroom or Capture One. The image style guide rules out the AI tells (poreless skin, identical bokeh, melted product edges, almost-but-not-quite text). The final file passes a human review before any listing or media plan sees it. This is what closes the gap between an AI image and a campaign image.',
  },
  {
    q: 'Can you white-label this for our agency?',
    a: 'Yes. A significant share of our Amazon work runs under agency brands, with full white-label delivery and confidential collaboration. The agency owns the relationship and the client communication; we deliver the production capability behind it.',
  },
  {
    q: 'Who owns the assets, the masters and the trained models?',
    a: 'You own all finished assets, all masters, and any LoRA, fine-tuned or avatar models trained on your IP. Commercial use rights for AIGC outputs are routed through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Amazon AIGC: Listing, Store & Ad Creative at Scale"
  description="AIGC for Amazon. Product detail pages, A+ Content, Brand Store and Sponsored Brands creative, produced inside a working studio. One brief, every ASIN."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- S1 · HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> Amazon
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Three lanes,</span></span>
            <span class="line"><span class="line__i serif">one Amazon brief.</span></span>
            <span class="line"><span class="line__i">AIGC, in scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Product content. Store content. <em>Ad creative.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We ship three kinds of work into Amazon: product content for the
              detail page, from the main image to the A+ modules and the
              listing video; store content for the Brand Store and the Posts
              feed; and ad creative built for Sponsored Brands, Sponsored
              Display and Amazon DSP.
            </p>
            <p>
              One brief, three lanes, every ASIN. One hero direction, fifty
              market variants. AIGC inside a working production company, not in
              place of one.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> Amazon-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/amazon-hero.jpg"
          alt="A close editorial portrait of a hand holding a phone in warm rim light, the phone screen filled with an Amazon product detail page showing the image thumbnail strip, the star rating row, the price block and the stacked Add to Cart and Buy Now buttons."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> Amazon</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- S2 · WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              What we ship<br /><span class="serif">into Amazon</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              We do three kinds of work for Amazon, end to end. Product content
              for the detail page: the main image, the gallery infographics,
              the lifestyle frames, the A+ Content modules and the listing
              video. Store content for the multi-page Brand Store and the
              Posts feed. Ad creative built for Sponsored Brands, Sponsored
              Display and Amazon DSP.
            </p>
            <p class="r" style="--d:.16s">
              One creative direction sits across all three. The same studio
              hands that retouch the hero image finish every A+ module, every
              Store tile and every ad variant, so a ten-ASIN catalogue reads
              like one brand rather than ten listings built by ten freelancers.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/amazon-roots.jpg"
              alt="A wide editorial shot of two designers at a daylit studio table, three laptop screens lined up showing an Amazon product detail page with A+ Content, an Amazon Brand Store homepage and a Sponsored Brands banner above Amazon search results, one per service lane."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Three lanes, one creative direction</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            One Amazon brief, three service lanes, every ASIN. Product content,
            store and ad creative finished by the same studio hands, with
            fifty-plus variants per concept and brief to first cut inside
            forty-eight hours on listing work.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S3 · COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Three lanes, one <span class="serif">brand line</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} surface</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Surface</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- S4 · PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Listing, Store and ad stills produced through the studio pipeline.
            Every frame is authored work, sized for the surface it ships on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S5 · PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/amazon-hybrid-main.jpg"
                alt="A producer at a wide reference monitor showing the Amazon advertising console creative library, three columns of detail-page, Brand Store and Sponsored Brands assets tagged Product, Store and Ads."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/amazon-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand holding a phone vertically against a soft cream background, the screen showing an Amazon product detail page with the image thumbnail strip and the price block visible."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Three lanes, every ASIN, every marketplace</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Authored creative, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The Amazon brands compounding their results in 2026 are not the
            ones with the biggest ad budget. They are the ones running an
            authored creative process across the detail page, the Store and
            the ads, with AIGC inside it.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit between the technical and the creative: a working studio
            with directors, retouchers and colourists alongside the AIGC
            engineers and the LoRA-training pipeline. Every variant ships
            with the same brand discipline as the hero, because the same
            hands sign it off.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in
            mainland China, Hong Kong, the EU or the US depending on your
            data sovereignty position. Custom-trained LoRA models stay your
            property and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            We pick up where you need us and step back where you do not.
          </p>
        </div>
      </div>
    </section>

    <!-- S6 · PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How an Amazon campaign runs</p>
        <h2 class="dh r" style="--d:.05s">
          One brief,<br />every <span class="serif">placement</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          The detail page, the Brand Store and the ad surfaces share the same
          brand line, and the same process. The format changes; the discipline
          stays the same. The work is won in the direction, not in the launch.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- S7 · FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S8 · CLOSE -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the Amazon brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          A placement-by-placement recommendation, a scope outline, an
          indicative timeline and a few free listing images or A+ frames so
          you can see the thinking before any budget commits.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Send the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }

  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }

  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }

  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.82fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
  }
  .band__note { font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }

  .cbar { display: flex; height: 12px; }
  .cbar span { flex: 1; }
  .cbar--end { margin-top: clamp(60px, 8vw, 110px); }

  /* Hero */
  .hero { display: grid; background: var(--ink); color: var(--text-on-dark); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1fr; } }
  .hero__panel { position: relative; display: flex; align-items: center; padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px); overflow: clip; }
  .hero__reg { position: absolute; width: clamp(240px, 28vw, 420px); right: -12%; bottom: -14%; color: rgba(240, 237, 233, 0.055); pointer-events: none; }
  .hero__panel-in { position: relative; width: 100%; max-width: 600px; }
  .hero__title { margin-top: 24px; font-family: var(--font-sans); font-weight: 600; font-size: clamp(46px, 6.6vw, 92px); line-height: 1.02; letter-spacing: -0.045em; }
  .hero__title .line { display: block; overflow: hidden; padding: 0.22em 0.14em; margin: -0.22em -0.14em; }
  .hero__title .line__i { display: block; transform: translateY(145%); transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero__title .line:nth-child(1) .line__i { transition-delay: 0.12s; }
  .hero__title .line:nth-child(2) .line__i { transition-delay: 0.22s; }
  .hero__title .line:nth-child(3) .line__i { transition-delay: 0.32s; }
  .hero.in .hero__title .line__i { transform: translateY(0); }
  .hero__title .serif { font-size: 1.04em; }
  @media (prefers-reduced-motion: reduce) { .hero__title .line__i { transform: none; } }
  .hero__tag { margin-top: 26px; font-size: clamp(18px, 1.5vw, 23px); font-weight: 600; letter-spacing: -0.02em; }
  .hero__tag em { font-family: var(--font-serif); font-style: italic; font-weight: 500; color: var(--brand-orange); }
  .hero__lead { margin-top: 20px; display: grid; gap: 13px; max-width: 46ch; }
  .hero__lead p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.74); }
  .hero__cta { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .hero__meta { margin-top: 34px; padding-top: 20px; border-top: 1.5px dashed rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(240, 237, 233, 0.5); }
  .hero__meta span { color: var(--brand-orange); }
  .hero__visual { position: relative; overflow: hidden; min-height: 58vh; }
  @media (min-width: 900px) { .hero__visual { min-height: auto; } }
  .hero__visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero.in .hero__visual img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) { .hero__visual img { transform: none; } }
  .hero__chip { position: absolute; left: 18px; bottom: 18px; z-index: 2; display: inline-flex; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); background: rgba(14, 22, 51, 0.78); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-on-dark); }
  .hero__chip span { color: var(--brand-orange); }

  /* Why */
  .why { background: var(--ink); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .why__top { display: grid; gap: 30px; }
  @media (min-width: 900px) { .why__top { grid-template-columns: 1fr 1fr; gap: 70px; align-items: start; } }
  .why__head .dh { margin-top: 18px; }
  .why__text { display: grid; gap: 16px; align-content: start; padding-top: 6px; }
  .why__text p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.78); }
  .why__clients { color: rgba(240, 237, 233, 0.6) !important; }
  .why__clients strong { color: var(--text-on-dark); font-weight: 600; }
  .why__shot { margin-top: clamp(40px, 5vw, 72px); }
  .why__shot .crop__inner { aspect-ratio: 16 / 8; }
  .why__shot .fig { color: rgba(240, 237, 233, 0.5); }

  .stats { margin-top: clamp(48px, 6vw, 84px); border-top: 1.5px dashed rgba(240, 237, 233, 0.22); padding-top: clamp(36px, 4vw, 56px); }
  .stats__quote { max-width: 60ch; font-family: var(--font-serif); font-style: italic; font-size: clamp(19px, 1.9vw, 25px); line-height: 1.42; color: var(--text-on-dark); }
  .stats__grid { margin-top: 40px; display: grid; gap: 30px; }
  @media (min-width: 720px) { .stats__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .stat { display: grid; gap: 5px; padding-top: 24px; border-top: 1.5px solid rgba(240, 237, 233, 0.16); }
  .stat__num { font-size: clamp(56px, 7vw, 96px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--brand-orange); }
  .stat__label { margin-top: 6px; font-size: 16px; font-weight: 600; }
  .stat__note { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: rgba(240, 237, 233, 0.55); }

  /* Coverage */
  .cover { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .feature { display: grid; gap: 36px; align-items: center; padding-block: clamp(40px, 5vw, 72px); border-top: 1.5px dashed var(--line-strong); }
  .feature:last-child { border-bottom: 1.5px dashed var(--line-strong); }
  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1fr; gap: 72px; }
    .feature--rev .feature__media { order: 2; }
  }
  .feature__media .crop__inner { aspect-ratio: 5 / 4; }
  .feature__idx { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .feature__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .feature__body .dh { margin-top: 16px; }
  .feature__lead { margin-top: 14px; font-size: var(--type-lead); line-height: 1.42; color: var(--text-ink); font-weight: 500; }
  .feature__p { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .feature__scope { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line-hairline); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); }
  .chips { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); font-size: 12px; font-weight: 500; transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease; }
  .chip:hover { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }

  /* Proof */
  .proof { background: var(--bg-white); padding-block: clamp(80px, 10vw, 150px); }
  .sheet { display: grid; gap: clamp(22px, 3vw, 40px); }
  @media (min-width: 720px) {
    .sheet { grid-template-columns: repeat(3, 1fr); }
    .sheet .shot:nth-child(3n + 2) { margin-top: 60px; }
    .sheet .shot:nth-child(3n) { margin-top: 30px; }
  }
  .shot .crop__inner { aspect-ratio: 1 / 1; }
  .shot .crop__inner img { transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .shot:hover .crop__inner img { transform: scale(1.06); }
  .shot__cap { margin-top: 14px; display: flex; align-items: baseline; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .shot__kind { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-ink); }

  /* Partnership / Source */
  .source { background: var(--navy); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .source__grid { display: grid; gap: 52px; }
  @media (min-width: 940px) { .source__grid { grid-template-columns: 0.92fr 1.08fr; gap: 70px; align-items: center; } }
  .source__visual { position: relative; }
  .source__main .crop__inner { aspect-ratio: 5 / 4; }
  .source__inset { position: absolute; right: -14px; bottom: -34px; width: 42%; max-width: 200px; margin: 0; border-radius: 8px; overflow: hidden; border: 5px solid var(--navy); box-shadow: 0 20px 36px rgba(0, 0, 0, 0.42); }
  .source__inset img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  @media (max-width: 520px) { .source__inset { display: none; } }
  .source__stat { position: absolute; left: -10px; top: 36px; display: grid; gap: 3px; padding: 15px 19px; border-radius: 12px; background: var(--brand-orange); color: #fff; box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42); }
  .source__stat-num { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .source__stat-cap { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase; max-width: 15ch; line-height: 1.4; }
  .source__body .dh { margin-top: 16px; }
  .source__lead { margin-top: 20px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-on-dark); }
  .source__p { margin-top: 15px; font-size: var(--type-body); line-height: 1.66; color: rgba(240, 237, 233, 0.78); }
  .source__p--quiet { color: rgba(240, 237, 233, 0.55); }
  .creds { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 9px; }
  .cred { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); border: 1px solid rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 12px; font-weight: 500; transition: border-color 0.2s ease, background-color 0.2s ease; }
  .cred:hover { border-color: var(--brand-orange); background: rgba(233, 78, 27, 0.16); }
  .cred svg { width: 13px; height: 13px; color: var(--brand-orange); }

  /* Process */
  .craft { background: var(--paper); padding-top: clamp(80px, 10vw, 150px); }
  .craft__intro { max-width: 780px; margin-bottom: clamp(36px, 5vw, 60px); }
  .craft__intro .kicker { color: var(--brand-orange); }
  .craft__intro .dh { margin-top: 16px; }
  .craft__lede { margin-top: 18px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }
  .craft__note { margin-top: 22px; display: inline-block; padding: 13px 20px; border-left: 3px solid var(--brand-orange); background: rgba(233, 78, 27, 0.07); border-radius: 0 10px 10px 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--text-ink); }

  .seq__nav { display: none; }
  .seq__panels { display: grid; gap: clamp(48px, 7vw, 96px); padding-bottom: clamp(80px, 10vw, 150px); }
  .seq__panel { display: grid; gap: 28px; }
  @media (min-width: 760px) {
    .seq__panel { grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .seq__panel:nth-child(even) .seq__media { order: 2; }
  }
  .seq__media .crop__inner { aspect-ratio: 4 / 3; }
  .seq__tier { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .seq__title { margin-top: 12px; font-size: clamp(25px, 2.7vw, 38px); font-weight: 600; line-height: 1.12; letter-spacing: -0.025em; }
  .seq__body { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }

  .craft--pinned .seq { height: 480vh; }
  .craft--pinned .seq__stick { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; overflow: hidden; }
  .craft--pinned .seq__stage { width: 100%; display: flex; flex-direction: column; gap: clamp(22px, 3vw, 40px); }
  .craft--pinned .seq__nav { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .seq__step { display: flex; flex-direction: column; gap: 10px; padding: 0; background: transparent; border: none; text-align: left; cursor: pointer; }
  .seq__step-dot { height: 5px; border-radius: 3px; background: var(--line-strong); overflow: hidden; }
  .seq__step-fill { display: block; height: 100%; width: 100%; background: var(--brand-orange); transform: scaleX(0); transform-origin: 0 50%; }
  .seq__step-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-mute); transition: color 0.3s ease; }
  .seq__step[data-active='true'] .seq__step-label { color: var(--text-ink); }
  .craft--pinned .seq__panels { position: relative; display: block; height: clamp(340px, 60vh, 540px); padding-bottom: 0; }
  .craft--pinned .seq__panel { position: absolute; inset: 0; align-content: center; opacity: 0; visibility: hidden; transform: translateY(26px); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.5s; }
  .craft--pinned .seq__panel[data-active='true'] { opacity: 1; visibility: visible; transform: none; transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .craft--pinned .seq__panel:nth-child(even) .seq__media { order: 0; }
  .craft--pinned .seq__media .crop__inner { aspect-ratio: auto; height: clamp(280px, 52vh, 460px); }
  @media (prefers-reduced-motion: reduce) { .craft--pinned .seq__panel { transition: none; } }

  /* FAQ */
  .faq { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .faq__grid { display: grid; gap: 44px; }
  @media (min-width: 1000px) {
    .faq__grid { grid-template-columns: 0.78fr 1.22fr; gap: 72px; align-items: start; }
    .faq__intro { position: sticky; top: 96px; }
  }
  .faq__intro .dh { margin-top: 18px; }
  .faq__sub { margin-top: 18px; margin-bottom: 26px; font-size: var(--type-body); line-height: 1.62; color: var(--text-mute); }
  .acc { display: grid; }
  .acc__row { border-top: 1.5px solid var(--ink); }
  .acc__row:last-child { border-bottom: 1.5px solid var(--ink); }
  .acc__q { width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 16px; padding: 26px 0; background: transparent; border: none; text-align: left; }
  .acc__qmark { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--brand-orange); padding-top: 3px; }
  .acc__qtext { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; color: var(--text-ink); transition: color 0.18s ease; }
  .acc__q:hover .acc__qtext { color: var(--brand-orange); }
  .acc__icon { position: relative; width: 22px; height: 22px; margin-top: 2px; }
  .acc__icon span { position: absolute; top: 50%; left: 50%; width: 14px; height: 2px; border-radius: 2px; background: var(--text-ink); transform: translate(-50%, -50%); transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(90deg); }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(0deg); }
  .acc__q[aria-expanded='true'] .acc__icon span { background: var(--brand-orange); }
  .acc__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s ease; }
  .acc__q[aria-expanded='true'] + .acc__a { grid-template-rows: 1fr; }
  .acc__a-inner { overflow: hidden; }
  .acc__a-inner p { padding: 0 0 26px 41px; max-width: 64ch; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .acc__a-inner a { color: var(--brand-orange); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  /* Close */
  .end { position: relative; background: var(--ink); color: var(--text-on-dark); padding-top: clamp(80px, 11vw, 150px); overflow: clip; }
  .end__reg { position: absolute; width: clamp(300px, 36vw, 560px); top: -16%; right: -9%; color: rgba(240, 237, 233, 0.05); pointer-events: none; }
  .end__inner { position: relative; display: grid; justify-items: start; gap: 22px; }
  .end__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(40px, 6.6vw, 96px); line-height: 0.98; letter-spacing: -0.04em; }
  .end__p { max-width: 54ch; font-size: var(--type-lead); line-height: 1.5; color: rgba(240, 237, 233, 0.78); }
  .end__cta { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const progBar = document.querySelector<HTMLElement>('.prog__bar');
  if (progBar) {
    const onScroll = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      progBar.style.transform = `scaleX(${max > 0 ? Math.min(1, d.scrollTop / max) : 0})`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  const revealEls = document.querySelectorAll('.r, .r-clip, .hero');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -7% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  const nums = Array.from(document.querySelectorAll<HTMLElement>('.stat__num'));
  const runCount = (el: HTMLElement) => {
    const from = Number(el.dataset.from || 0);
    const to = Number(el.dataset.to || 0);
    const suffix = el.dataset.suffix || '';
    if (reduceMotion.matches) {
      el.textContent = `${to}${suffix}`;
      return;
    }
    const dur = 1500;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = `${Math.round(from + (to - from) * eased)}${suffix}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && nums.length) {
    const io2 = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runCount(e.target as HTMLElement);
            io2.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((n) => io2.observe(n));
  } else {
    nums.forEach(runCount);
  }

  const craft = document.getElementById('craft');
  const seq = document.getElementById('seq');
  if (craft && seq) {
    const steps = Array.from(seq.querySelectorAll<HTMLElement>('.seq__step'));
    const panels = Array.from(seq.querySelectorAll<HTMLElement>('.seq__panel'));
    const fills = steps.map((s) => s.querySelector<HTMLElement>('.seq__step-fill'));
    const n = panels.length;
    const wide = window.matchMedia('(min-width: 880px)');

    const setActive = (idx: number, sub: number) => {
      panels.forEach((p, i) => (p.dataset.active = String(i === idx)));
      steps.forEach((s, i) => {
        s.dataset.active = String(i === idx);
        const f = fills[i];
        if (f) f.style.transform = `scaleX(${i < idx ? 1 : i === idx ? sub : 0})`;
      });
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      if (!craft.classList.contains('craft--pinned')) return;
      const total = seq.offsetHeight - window.innerHeight;
      const scrolled = Math.min(total, Math.max(0, -seq.getBoundingClientRect().top));
      const p = total > 0 ? scrolled / total : 0;
      const exact = p * n;
      const idx = Math.min(n - 1, Math.floor(exact));
      const sub = Math.min(1, Math.max(0, exact - idx));
      setActive(idx, idx === n - 1 ? 1 : sub);
    };
    const onScrollSeq = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const applyMode = () => {
      if (wide.matches && !reduceMotion.matches) {
        craft.classList.add('craft--pinned');
        update();
      } else {
        craft.classList.remove('craft--pinned');
        panels.forEach((p) => (p.dataset.active = 'true'));
      }
    };

    steps.forEach((s, i) => {
      s.addEventListener('click', () => {
        if (!craft.classList.contains('craft--pinned')) return;
        const railTop = seq.getBoundingClientRect().top + window.scrollY;
        const total = seq.offsetHeight - window.innerHeight;
        window.scrollTo({
          top: railTop + ((i + 0.5) / n) * total,
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
        });
      });
    });

    window.addEventListener('scroll', onScrollSeq, { passive: true });
    window.addEventListener('resize', () => {
      applyMode();
      update();
    });
    applyMode();
  }

  const accQs = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc__q'));
  accQs.forEach((q) => {
    q.addEventListener('click', () => {
      const open = q.getAttribute('aria-expanded') === 'true';
      accQs.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      q.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
