---
/**
 * Douyin · /solutions/platforms/douyin
 *
 * Editorial layout adapted from /solutions/platforms/meta. Same print-shop
 * primitives (crop marks, calibration colour bar, mono figure labels, dashed
 * rules) reframed for Douyin: the five service lanes, the AIGC mechanics for
 * each, the partnership model.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing. The page sells to international brands,
 * so the copy is English; the on-screen work content in the imagery is
 * Mandarin, because Douyin is a Chinese-market platform.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const stats = [
  { from: 0, to: 5, suffix: '', label: 'Lanes we ship', note: 'Content, ad creative, UGC, live, avatar' },
  { from: 0, to: 60, suffix: '+', label: 'Cuts per concept', note: 'From one signed-off master' },
  { from: 0, to: 48, suffix: 'h', label: 'Brief to first cut', note: 'On short-form Douyin video' },
];

const samples = [
  {
    src: '/Images/douyin-sample-feed.jpg',
    kind: 'Content · For You feed',
    alt: 'A vertical phone held in soft window light, the screen filled with a Douyin For You video of a styled product scene in warm tones, the right-side icon rail and bottom navigation bar visible.',
  },
  {
    src: '/Images/douyin-sample-topview.jpg',
    kind: 'Ad creative · TopView',
    alt: 'A phone screen showing a full-screen Douyin TopView ad at app open, a paused fashion frame with a call-to-action button visible in the lower interface.',
  },
  {
    src: '/Images/douyin-sample-ugc.jpg',
    kind: 'UGC · KOC review',
    alt: 'A phone screen showing a vertical Douyin video of a creator holding a product to camera in a sunlit bedroom, the caption overlay and the like-comment-share rail visible in the interface.',
  },
  {
    src: '/Images/douyin-sample-live.jpg',
    kind: 'Live commerce · Shop livestream',
    alt: 'A phone held vertically showing a Douyin Shop livestream, a host gesturing toward a product, floating heart animations rising up the frame and a pinned product card with a shopping cart icon.',
  },
  {
    src: '/Images/douyin-sample-avatar.jpg',
    kind: 'Avatar · Digital host',
    alt: 'A phone screen showing a vertical Douyin video of a digital host presenter speaking to camera in neutral knitwear, captions and the For You icon rail visible in the interface.',
  },
];

const coverage = [
  {
    fig: 'B',
    label: 'Content',
    heading: 'Content. The Douyin-native short-form feed.',
    image: '/Images/douyin-content.jpg',
    alt: 'A phone held in both hands, the screen filled with the vertical Douyin For You feed, the right-side icon rail of profile photo, heart, comment and share visible alongside the spinning circular music disc.',
    lead: 'Editorial-grade short-form video for the For You feed, scripted and produced by the studio.',
    body: [
      "We script, shoot and finish the organic side of a Douyin presence: product demos that earn the watch-through, lifestyle cuts that look like the rest of the brand book, education pieces built as a weekly rhythm, trend formats caught while the trend is still moving. Every cut is vertical, sound-on, and built to win or lose in the first second.",
      "The work is signed off by a creative director, retouched by the same hand as the campaign hero, written in native Mandarin from scratch rather than translated, and shipped in the exact 9:16 format the feed serves. The volume rises, the brand line does not move.",
    ],
    tags: [
      'Product demos', 'Lifestyle video', 'Education cuts',
      'Trend formats', 'Vertical 9:16', 'Hook-first edits',
      'Sound-on mix', 'Always-on calendar',
    ],
  },
  {
    fig: 'C',
    label: 'Ad creative',
    heading: 'Ad creative. Built for Ocean Engine.',
    image: '/Images/douyin-ads.jpg',
    alt: 'A wide monitor showing the Ocean Engine creative library, a grid of vertical In-Feed and TopView ad cuts lined up in the placement preview panel.',
    lead: "Performance creative produced at the volume Ocean Engine's buying surfaces actually want.",
    body: [
      "Ocean Engine keeps getting better the more cuts the system has to learn from. We brief, generate and finish paid creative around the placement set the media team is buying: In-Feed video, TopView, Search and Shop cards, with the format diversity dynamic creative needs and the naming conventions the downstream reporting expects.",
      "In-Feed conversion video, full-screen TopView, Search units, DOU+ boosts and Branded Effects all run through the same studio pass, so the long tail looks like the hero rather than a thinned-out clone of it.",
    ],
    tags: [
      'In-Feed video', 'TopView', 'Search ads',
      'DOU+ boosts', 'Shop cards', 'Branded Effects',
      'Hook A/B testing', 'Retargeting cuts',
    ],
  },
  {
    fig: 'D',
    label: 'UGC',
    heading: 'UGC. KOC-style at studio scale.',
    image: '/Images/douyin-ugc.jpg',
    alt: 'A phone screen showing a vertical Douyin video of a creator filming a product review in a sunlit room, the For You icon rail and the caption overlay visible in the interface.',
    lead: 'Authored KOC-style content for the feed, without the casting cycle and the rights chase.',
    body: [
      "We produce KOC-style content end to end: product reviews, hauls, unboxing, GRWM, founder testimonials and reaction cuts. Real creator briefs, real handheld grammar, native Mandarin captions, finished inside the studio so the brand keeps the masters and the usage rights from the first cut.",
      "Volume is the point: thirty KOC cuts for one launch, ten new hooks every week on always-on accounts, market-specific edits per audience. The cost-per-cut curve flattens fast.",
    ],
    tags: [
      'KOC reviews', 'Hauls', 'Unboxing',
      'GRWM cuts', 'Testimonials', 'Reaction edits',
      'Native Mandarin', 'Always-on UGC',
    ],
  },
  {
    fig: 'E',
    label: 'Live commerce',
    heading: 'Live commerce. The shoppable stream, produced.',
    image: '/Images/douyin-live.jpg',
    alt: 'A phone screen showing a Douyin Shop livestream, floating heart animations rising up the frame and a product card pinned in the lower corner with a shopping cart icon.',
    lead: 'The full visual production behind a Douyin Shop livestream: set, graphics and segments.',
    body: [
      "We produce the visual side of a Douyin Shop livestream, not the operations of running one: set design and dressing, on-screen overlays and lower-thirds, product-showcase segment scripts, shoppable card creative, and the replay cut down into short-form afterwards.",
      "The stream reads like the rest of the brand book rather than a folding-table booth. A digital host from the avatar lane can front it, or a real host can work to a studio run-of-show. Either way the look stays inside the brand.",
    ],
    tags: [
      'Livestream sets', 'Segment scripts', 'On-screen overlays',
      'Product cards', 'Shop integration', 'Replay cut-downs',
      'Run-of-show', 'Always-on lives',
    ],
  },
  {
    fig: 'F',
    label: 'Avatar',
    heading: 'Avatar. A digital host you own.',
    image: '/Images/douyin-avatar.jpg',
    alt: 'A phone screen showing a vertical Douyin video of a digital host presenting to camera, captions and the For You icon rail visible in the interface.',
    lead: 'A bespoke digital host that lives only on your channels, in every language Douyin reaches.',
    body: [
      "We build and train brand-owned digital hosts: a founder twin, a brand presenter, a product expert, a localised cast per market. They present to camera in short-form video, front the Shop livestream, and host shopping clips. One host, every language, every Douyin surface.",
      "Lip-sync is studio-tight, the look stays inside the brand book, and the rights stay with you in perpetuity. No re-shoot to refresh, no re-cast to localise.",
    ],
    tags: [
      'Digital host', 'Founder twin', 'Product expert',
      'Livestream host', 'Multi-language cuts', 'Localised casts',
      'Shop hosts', 'Always-on avatar',
    ],
  },
];

const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to lock the goal, audience, Douyin surfaces in scope, brand truth, no-go zones and the platform compliance line. Output is a one-page strategic brief and an asset map by placement and by service lane.',
    image: '/Images/douyin-p1-brief.jpg',
    alt: 'A creative director and a brand lead at a studio table in a lived-in Shanghai office, tea mugs and sticky notes around a laptop showing the Ocean Engine planner beside printed Douyin For You feed screenshots.',
  },
  {
    short: 'Direction',
    tier: 'Where it is won',
    title: 'Creative direction across the five lanes.',
    body: 'Visual references locked, tone defined, shot list drafted, AIGC and digital-host model selection made per surface and per service. Content, ad creative, UGC, live commerce and avatar each get their own treatment. This is where a campaign becomes ownable.',
    image: '/Images/douyin-p2-direction.jpg',
    alt: 'A storyboard wall in a Shanghai studio with five columns of frame sketches labelled Content, Ads, UGC, Live and Avatar, each column anchored by a printed phone mock of the vertical Douyin feed.',
  },
  {
    short: 'AIGC',
    tier: 'The rest is execution',
    title: 'AIGC generation and authored finish.',
    body: 'Per-lane generation across the agreed surfaces. Each output goes through the studio retouch, the brand check and the platform-compliance pass before any media plan sees it.',
    image: '/Images/douyin-p3-aigc.jpg',
    alt: 'A Chinese motion designer at a calibrated workstation in a cluttered Shanghai studio, the main monitor showing a single vertical Douyin video frame, the side panel showing the Ocean Engine creative library grid of cuts.',
  },
  {
    short: 'Launch',
    tier: 'The rest is execution',
    title: 'Launch. Per-placement, per-market.',
    body: 'Assets handed to the media team in the formats Ocean Engine actually serves, with naming, ratios and durations matched to In-Feed, TopView and Search placements. Tracking and creative naming built for downstream reporting.',
    image: '/Images/douyin-p4-launch.jpg',
    alt: 'A Chinese media buyer at a daylit studio desk in Shanghai, the calibrated monitor showing the Ocean Engine campaign dashboard with In-Feed and TopView placements live.',
  },
  {
    short: 'Adapt',
    tier: 'The rest is execution',
    title: 'Adapt. Cuts, refresh, trend.',
    body: 'Once the hero is signed off, the cut cascade lands in days. New audiences, new trends, new hashtags, new seasons. The brief stays the same, the cuts compound.',
    image: '/Images/douyin-p5-adapt.jpg',
    alt: 'A Chinese colourist at a calibrated grading suite in a Shanghai studio, the reference monitor showing a warm vertical Douyin video frame paused on a product still, the For You icon rail visible at the screen edge.',
  },
];

const faqs = [
  {
    q: 'What exactly do you produce for Douyin?',
    a: 'Five lanes, one studio. Content covers organic short-form video for the For You feed: product demos, lifestyle, education and trend-driven formats. Ad creative covers In-Feed, TopView, Search and Shop-card creative built for Ocean Engine. UGC covers KOC-style reviews and hauls at volume. Live commerce covers the full visual production behind a Douyin Shop livestream. Avatar covers a brand-owned digital host that presents across every surface. The lanes share one creative direction and one finishing pass, so the long tail looks like the hero.',
  },
  {
    q: 'How is the UGC lane different from sourcing KOCs through Xingtu?',
    a: 'We script the brief, build the creator profile, generate the takes inside the studio and finish them with the same studio pass as the hero. Real handheld grammar, real product-in-hand frames, native Mandarin written from scratch rather than translated captions, no casting cycle and no rights chase. You keep the masters and the usage rights from the first cut, and the cost-per-cut curve flattens to near zero by the tenth take. When a campaign genuinely needs a named creator and their audience, that is a media decision you run alongside this lane, not instead of it.',
  },
  {
    q: 'Tell me more about the Avatar lane.',
    a: 'We build and train a brand-owned digital host: a founder twin, a brand presenter, a product expert or a localised cast per market. The host speaks to camera in short-form video, fronts the Shop livestream and narrates shopping clips. Lip-sync is studio-tight, the look stays inside the brand book, and the same host runs in every language Douyin reaches with no re-shoot. The host is yours, trained on your IP, and never appears on another brand channel.',
  },
  {
    q: 'What does the Live commerce lane actually deliver?',
    a: 'The visual production behind a Douyin Shop livestream, not the operations of running one. We design the set, build the on-screen overlays and lower-thirds, script the product-showcase segments, produce the shoppable card creative, and cut the replay down into short-form afterwards. The stream reads like the rest of the brand book rather than a folding-table booth. A digital host from the avatar lane can front the stream, or a real host can work to a studio run-of-show.',
  },
  {
    q: 'How do you keep the brand line consistent across the five lanes?',
    a: 'The hero concept is signed off once, in the direction step. After that, every cut in every lane runs through the same retouch pass, the same colour grade and the same brand-safety check. The studio is what keeps content, ad creative, UGC, live commerce and avatar reading like one campaign rather than five parallel ones.',
  },
  {
    q: 'What is your turnaround, and can you hit the volume our plan needs?',
    a: 'Short-form video on an existing brand can be brief to first cut in 24 to 72 hours. A single hero shoot or AIGC sprint produces the master, and the cut cascade lands per audience and per trend inside days: the first cut is expensive, the sixtieth is close to free. A new brand or a new product takes a one-time onboarding to lock the treatment, the LoRA models and the digital host; after that, three to five drops a week at production-grade quality are the working tempo.',
  },
  {
    q: 'Do you handle Ocean Engine paid placements and dynamic creative?',
    a: 'Yes. We brief the ad creative lane around the placement set the media team is buying: In-Feed video, TopView, Search ads, DOU+ boosts, Shop cards and Branded Effects. Cuts are produced with the format diversity dynamic creative needs and named so the reporting downstream is legible. The media team owns the buying and the spend; we own the creative behind it.',
  },
  {
    q: 'How do you keep the work from feeling AI-generated?',
    a: 'Every output goes through a studio retouch pass: dodge and burn, grain, chromatic aberration and a colour grade in Lightroom or Capture One. The image style guide rules out the AI tells: poreless skin, identical bokeh, melted jewellery, almost-but-not-quite text. The final file passes a human review before any media plan sees it. This is what closes the gap between an AI image and a campaign image.',
  },
  {
    q: 'Can you white-label this for our agency?',
    a: 'Yes. A significant share of our Douyin work runs under agency brands, with full white-label delivery and confidential collaboration. The agency owns the relationship and the client communication; we deliver the production capability behind it.',
  },
  {
    q: 'Who owns the assets, the masters and the trained models?',
    a: 'You own all finished assets, all masters, and any LoRA, fine-tuned or digital-host models trained on your IP. Commercial use rights for AIGC outputs are routed through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Douyin AIGC: For You Feed & Ocean Engine Creative at Scale"
  description="AIGC for Douyin. Short-form video, Ocean Engine ad creative, livestream and avatar work, produced inside a working studio. One brief, every placement."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- S1 · HERO -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Platform
            <span class="kicker__sep">/</span> Douyin
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Five lanes,</span></span>
            <span class="line"><span class="line__i serif">one Douyin brief.</span></span>
            <span class="line"><span class="line__i">AIGC, in scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Content. Ad creative. UGC. Live. <em>Avatar.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              We ship five kinds of work into Douyin: organic short-form video
              for the For You feed; performance ad creative built for Ocean
              Engine; KOC-style UGC at volume; the full visual production
              behind a Douyin Shop livestream; and a brand-owned digital host
              that presents in every language Douyin reaches.
            </p>
            <p>
              One brief, five lanes, every placement. One hero direction, sixty
              market cuts. AIGC inside a working production company, not in
              place of one.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> Douyin-native creative under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/douyin-hero.jpg"
          alt="A close editorial portrait of a hand holding a phone in warm rim light, the phone screen filled with a paused vertical Douyin video including the right-side icon rail and the spinning circular music disc of the For You interface."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Platform work <span>/</span> Douyin</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- S2 · WHY -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              What we ship<br /><span class="serif">into Douyin</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              We do five kinds of work for Douyin, end to end. Organic
              short-form video for the For You feed. Paid ad creative built for
              Ocean Engine across In-Feed, TopView, Search and Shop cards.
              KOC-style UGC for the feed at volume. The full visual production
              behind a Douyin Shop livestream. A brand-owned digital host that
              fronts every surface Douyin serves.
            </p>
            <p class="r" style="--d:.16s">
              One creative direction sits across all five. The same studio
              hands that retouch the hero finish every cut in every lane, so
              the long tail looks like the campaign rather than a thinned clone
              of it.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/douyin-roots.jpg"
              alt="A wide editorial shot of two Chinese designers at a daylit table in a lived-in Shanghai studio, four laptop screens lined up showing the Douyin For You feed, the Ocean Engine creative library, a Douyin Shop livestream and a KOC review video, one per service lane."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">Five lanes, one creative direction</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            One Douyin brief, five service lanes, every placement. Content, ad
            creative, UGC, live commerce and avatar finished by the same studio
            hands, with sixty-plus cuts per concept and brief to first cut
            inside forty-eight hours on short-form work.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- S3 · COVERAGE -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Five lanes, one <span class="serif">brand line</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} surface</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Surface</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- S4 · PROOF -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            For You feed, TopView and livestream stills produced through the
            studio pipeline. Every frame is authored work, sized for the
            surface it ships on.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S5 · PARTNERSHIP -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/douyin-hybrid-main.jpg"
                alt="A Chinese producer at a wide reference monitor in a Shanghai studio showing the Ocean Engine creative library, five columns of vertical Douyin cuts tagged Content, Ads, UGC, Live and Avatar."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/douyin-hybrid-inset.jpg"
              alt="A close cinematic detail of a hand holding a phone vertically against a soft cream background, the screen filled with a vertical Douyin video including the right-side icon rail and bottom navigation of the For You interface."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 brief</span>
            <span class="source__stat-cap">Five lanes, every placement, every market</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Partnership</p>
          <h2 class="dh r" style="--d:.05s">
            Authored creative, <span class="serif">AI volume</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The Douyin brands compounding their results in 2026 are not the
            ones with the loudest stack. They are the ones running an authored
            creative process with AIGC inside it.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit between the technical and the creative: a working studio
            with directors, retouchers and colourists alongside the AIGC
            engineers and the LoRA-training pipeline. Every cut ships with the
            same brand discipline as the hero, because the same hands sign it
            off.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in mainland
            China, Hong Kong, the EU or the US depending on your data
            sovereignty position. Custom-trained LoRA models stay your property
            and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            We pick up where you need us and step back where you do not.
          </p>
        </div>
      </div>
    </section>

    <!-- S6 · PROCESS -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a Douyin campaign runs</p>
        <h2 class="dh r" style="--d:.05s">
          One brief,<br />every <span class="serif">placement</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Feed video, TopView, livestream and avatar cuts share the same brand
          line, and the same process. The format changes; the discipline stays
          the same. The work is won in the direction, not in the launch.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- S7 · FAQ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- S8 · CLOSE -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the Douyin brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          A placement-by-placement recommendation, a scope outline, an
          indicative timeline and a few free For You or TopView frames so you
          can see the thinking before any budget commits.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Send the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }

  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }

  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }

  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.82fr; align-items: end; gap: 18px 60px; }
