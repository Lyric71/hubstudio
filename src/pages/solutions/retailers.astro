---
/**
 * hubStudio for retailers  ·  /solutions/retailers
 *
 * Volume and seasonality. The app for fast variants, resizes and scheduled
 * posts (real captures of the Image studio, the Image editor crop and the
 * Instagram post studio); the studio for the seasonal campaign set and
 * marketplace work, linking the Amazon, Tmall, JD and Shopify platform pages.
 * Use the app is the highlighted way; the closing leads with the app door.
 * Copy from the content-quality-us deck (cq/sol-retailers).
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Volume',
    title: 'Every product needs a hero, a detail, and a scene.',
    body: 'Multiply that by a catalog and the photo budget runs out long before the SKUs do.',
  },
  {
    label: 'Seasons',
    title: 'Holiday, back to school, and summer each want new pictures of the same products.',
    body: 'Few budgets stretch to a reshoot every time the season turns.',
  },
  {
    label: 'Channels',
    title: 'Your store, the marketplaces, and each social feed all want their own sizes.',
    body: 'And somebody has to crop and caption every one.',
  },
];

/* The app, by job. Labels are captions for the captures, not ordinals. */
const shots = [
  { job: 'Variant', shot: appShots.imageStudio, path: '/content/image-generate', wide: true },
  { job: 'Resize', shot: appShots.editorCrop, path: '/files/tools/image-editor', wide: false },
  { job: 'Post', shot: appShots.instagram, path: '/social/instagram/posts', wide: false },
];

const platforms = [
  { name: 'Amazon', href: '/solutions/platforms/amazon' },
  { name: 'Tmall', href: '/solutions/platforms/tmall' },
  { name: 'JD', href: '/solutions/platforms/jd' },
  { name: 'Shopify', href: '/solutions/platforms/shopify' },
];

/* Four kinds of retail work and who usually makes them. Prose lanes. */
const lanes = [
  {
    label: 'Product scenes',
    heading: 'One product, many settings.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A daylit product still life on a kitchen counter, late-afternoon window light from camera left, warm shadow grade, generous negative space.',
    body: 'From a kitchen counter to a garden table. Most teams make the quick scenes in the app and ask the studio for the hero set.',
  },
  {
    label: 'Seasonal refresh',
    heading: 'The same products, dressed for the next date on the calendar.',
    image: '/Images/pmd-factory.jpg',
    alt: 'A documentary in-studio frame of a retail content team reviewing seasonal creative on a large monitor, warm window light, lifted black point.',
    body: 'This is where Studio + app fits best: we work in your own workspace, the key visual sits in your Assets Library, and your team adapts it all season.',
  },
  {
    label: 'Commerce pages',
    heading: 'Product pages, A+ modules, and marketplace tiles.',
    image: '/Images/ecom-listings.jpg',
    alt: 'A clean marketplace product layout on a calibrated monitor, with tile, hero and lifestyle variants pinned in a contact-sheet grid alongside.',
    body: 'Each one follows its platform’s rules. The first build usually comes from the studio, and the team keeps it fresh afterward.',
  },
  {
    label: 'Social commerce',
    heading: 'Vertical video, carousels, and captions.',
    image: '/Images/sb-sample-branded.jpg',
    alt: 'A social-first video frame of a model holding a product, vertical aspect, soft natural daylight, prime-lens shallow focus.',
    body: 'Made for the feeds where people shop. Day to day, it’s app work. Launch films go to the studio.',
  },
];

const faqs = [
  {
    q: 'How fast can we make seasonal content?',
    a: 'In the app, as fast as your team can work. You pick an engine, see the price, and run it. For the studio, a producer reads your brief within one business day and sends a written proposal within 48 hours.',
  },
  {
    q: 'Will the product look right?',
    a: 'Start from your own product pictures where the engine allows it, and check every image before it goes live. Generated images can get details wrong. For hero products, the studio can shoot the product or retouch it by hand.',
  },
  {
    q: 'Do you make marketplace pages?',
    a: 'Yes, in the studio: listing images, A+ content, and store pages for Amazon, Tmall, JD, and Shopify.',
  },
  {
    q: 'How do we pay?',
    a: 'The app runs on a prepaid balance in real currency, topped up by card, Alipay, or WeChat Pay, with an invoice for every top-up. There are no seat fees. The studio is priced per asset, per project, or on retainer.',
  },
  {
    q: 'Can we still do a real shoot?',
    a: 'Yes. The studio decides asset by asset what to shoot and what to generate, and most campaigns mix both.',
  },
  {
    q: 'Is there a contract or a minimum?',
    a: 'Not for the app. There’s no subscription and no seat fees, and your balance doesn’t expire. Studio terms are set out in the written proposal.',
  },
  {
    q: 'Does it connect to our PIM or DAM?',
    a: 'No, the app has no connectors. Files live in its Assets Library, in folders, with tags, and with versions, and you download them in the format you need.',
  },
  {
    q: 'Can the whole team work in the app?',
    a: 'Yes. Invite people as Admins, Creators, or Viewers. They share one balance, and an admin can set a daily spending limit for each creator.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Retailers', item: `${SITE}/solutions/retailers` },
  ],
};

const arrow = 'M4 10h12M11 5l5 5-5 5';
---

<Layout
  title="hubStudio for retailers: variants, seasons, marketplaces"
  description="Retail teams make product variants and schedule posts in the hubStudio app, and get seasonal campaigns and marketplace pages from our studio."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Retailers
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">The sale starts</span></span>
            <span class="line"><span class="line__i">Friday. Make the</span></span>
            <span class="line"><span class="line__i">pictures <span class="serif">today.</span></span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Variants in the app. Campaign sets from the <em>studio</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Retail runs on volume and dates. Thousands of products need
              pictures, each season wants new ones, and a promotion rarely
              waits for a shoot to be booked.
            </p>
            <p>
              Your team makes the fast variants in the hubStudio app and
              publishes them. Our studio makes the seasonal campaign and the
              marketplace pages.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
            <a class="ghost-link ghost-link--light" href={`${BRIEF_URL}?way=studio`}>
              Send a brief
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Variants <span>/</span> Seasons <span>/</span> Marketplaces
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/retailers-hero.jpg"
          alt="A retail product still life on a sunlit kitchen counter with late-afternoon window light from camera left, prime-lens shallow focus, warm shadow grade and generous negative space."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Retail <span>/</span> Seasonal set</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The retail calendar</p>
            <h2 class="dh r" style="--d:.05s">
              The calendar doesn’t <span class="serif">wait</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Booking a shoot can take weeks. By the time the photographer is
            free, the promotion it was for has often come and gone.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ THE APP ============ -->
    <section class="appsec" id="app">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Use the app</p>
            <h2 class="dh r" style="--d:.05s">
              Variants, resizes, and<br />posts from one <span class="serif">app</span>.
            </h2>
          </div>
          <div class="band__prose">
            <p class="band__p r" style="--d:.1s">
              In the Image studio, pick an engine and make 1 to 10 images a
              run, up to 4K, with a transparent background on the engines that
              offer one. Some engines take up to four of your own product
              pictures as a starting point. In the Video studio, a product
              picture can become the first frame of a short clip.
            </p>
            <p class="band__p r" style="--d:.14s">
              The Image editor crops to each network’s format and adds text,
              arrows, or your logo. It costs nothing to use.
            </p>
            <p class="band__p r" style="--d:.18s">
              Posts go to Instagram, Facebook, LinkedIn, X, and TikTok (Beta),
              now or on a schedule, to up to 20 accounts at once. A queue
              retries automatically, and one post can be re-purposed for the
              other networks. Every file lands in the Assets Library.
            </p>
          </div>
        </header>

        <div class="shots">
          {
            shots.map((s, i) => (
              <div class:list={['shots__item', 'r', s.wide && 'shots__item--wide']} style={`--d:${i * 0.06}s`}>
                <p class="shots__job"><span class="kicker__tick"></span>{s.job}</p>
                <AppShot shot={s.shot} path={s.path} caption />
              </div>
            ))
          }
        </div>

        <p class="appsec__more r">
          <a class="ghost-link" href="/app">
            See what the app does
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
      </div>
    </section>

    <!-- ============ THE STUDIO ============ -->
    <section class="studio" id="studio">
      <div class="shell studio__grid">
        <figure class="studio__media crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/studio-brief.webp"
              alt="Hands marking up a printed creative brief for a seasonal product launch, with proof prints and color swatches on the table beside it."
              width="1600"
              height="1200"
              loading="lazy"
            />
          </div>
          <figcaption class="fig fig--light">The studio <span>/</span> Brief review</figcaption>
        </figure>
        <div class="studio__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Studio only</p>
          <h2 class="dh r" style="--d:.05s">
            Campaign sets and<br />marketplace pages, from the <span class="serif">studio</span>.
          </h2>
          <p class="studio__p r" style="--d:.1s">
            For the season’s hero campaign or a new storefront, send a brief.
            A senior art director leads it, and our team decides asset by
            asset what to shoot and what to generate.
          </p>
          <p class="studio__p r" style="--d:.14s">
            We make listing images, A+ content, and store pages for Amazon,
            Tmall, JD, and Shopify.
          </p>
          <ul class="plats r" style="--d:.18s">
            {
              platforms.map((p) => (
                <li>
                  <a class="plat" href={p.href}>{p.name}</a>
                </li>
              ))
            }
          </ul>
          <p class="studio__case r" style="--d:.22s">
            <a class="ghost-link ghost-link--light" href="/work/diy-european-retailer">
              For a European DIY retailer, we turned basic shots of thousands of
              products into seasonal lifestyle images for catalog, web, and
              store, without booking a shoot per season
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ THREE WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="app"
      pre="Pick the way that fits the "
      accent="season"
      post="."
      lead="Many retailers run the daily variants in the app and bring the studio in for the big seasonal set. Some have us make it inside the app, so the team can re-use every file."
    />

    <!-- ============ WHO MAKES WHAT ============ -->
    <section class="cover" id="lanes">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Who makes what</p>
          <h2 class="dh r" style="--d:.05s">
            Four kinds of retail work, and who usually <span class="serif">makes them</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Planning next season? This is the part to skim. It’s a rough guide
            from the work we see. Some teams do all four in the app. Others
            hand every one of them to us.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="1024" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-china-speed.jpg"
                alt="A documentary frame of hubStudio operators reviewing retail variations on a wall of pinned proofs, warm shadow grade, calibrated stations behind."
                width="768"
                height="1360"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48 hours</span>
            <span class="source__stat-cap">A written proposal after your brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Built around the<br />retail <span class="serif">calendar</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The app and the studio belong to one company, so your team and
            ours can share a season’s files.
          </p>
          <p class="source__p r" style="--d:.16s">
            Your team sees the price before every run and pays only for what
            it makes. Nothing is charged for a failed run, and the balance
            doesn’t expire between seasons.
          </p>
          <p class="source__p r" style="--d:.22s">
            For studio work, a senior art director leads every brief and the
            provenance of every asset is recorded. The studio was founded by
            Cyril Drouin, former CEO at Publicis.
          </p>
          <ul class="creds r" style="--d:.28s">
            {
              ['Marketplace pages', 'Senior art directors', 'Price shown before every run', 'Twenty service lines'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />next <span class="serif">season</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">What retail teams ask us first.</p>
          <p class="faq__updated r" style="--d:.12s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="app"
      briefQuery="way=studio"
      pre="Start this season in the "
      accent="app"
      post="."
      text="Creating an account costs nothing, and you pay only for what you run. For the campaign set or a marketplace build, send us a brief and a producer replies within one business day."
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { display: inline-block; width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }
  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }
  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .fig span { color: var(--brand-orange); }
  .fig--light { color: rgba(240, 237, 233, 0.6); }
  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { flex: none; width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }
  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.9fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
  }
