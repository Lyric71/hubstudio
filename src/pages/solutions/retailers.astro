---
/**
 * hubStudio for retailers  ·  /solutions/retailers
 *
 * Retail teams run two jobs side by side: creative assets (product packshots,
 * lifestyle scenes, seasonal refreshes, marketplace listings) and social
 * networks (daily Reels, Stories, TikToks, promotional carousels, paid social
 * ads, and Chinese social commerce). This page explains how retailers run both
 * in the hubStudio app ("Use the app") and with our creative and social teams
 * inside the same workspace ("Work with us in the app").
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Creative assets',
    title: 'Every SKU needs a packshot, a detail shot, and a lifestyle scene.',
    body: 'Multiply that across a seasonal catalog and the photo budget runs out long before the product list does.',
  },
  {
    label: 'Social networks',
    title: 'Promotions live or die on the daily social calendar.',
    body: 'Every weekend sale needs Instagram Reels, TikTok clips, Facebook carousels, and paid ad variants sized and captioned on time.',
  },
  {
    label: 'Marketplaces & feeds',
    title: 'Storefronts, marketplaces, and social feeds never share a ratio.',
    body: 'Amazon, Tmall, JD, Shopify, and every social network enforce their own dimensions, safe zones, and copy rules.',
  },
];

/* The app across both pillars. Labels are captions for the captures, not ordinals. */
const shots = [
  { job: 'Creative assets · Generate variants', shot: appShots.imageStudio, path: '/content/image-generate', wide: true },
  { job: 'Creative assets · Size for each feed', shot: appShots.editorSocial, path: '/files/tools/image-editor', wide: false },
  { job: 'Social networks · Schedule & publish', shot: appShots.instagram, path: '/social/instagram/posts', wide: false },
];

const platforms = [
  { name: 'Amazon', href: '/solutions/platforms/amazon' },
  { name: 'Tmall', href: '/solutions/platforms/tmall' },
  { name: 'JD', href: '/solutions/platforms/jd' },
  { name: 'Shopify', href: '/solutions/platforms/shopify' },
  { name: 'Meta', href: '/solutions/platforms/meta' },
  { name: 'TikTok', href: '/solutions/platforms/tiktok' },
  { name: 'RedNote', href: '/solutions/platforms/rednote' },
  { name: 'Douyin', href: '/solutions/platforms/douyin' },
];

/* Four parts of retail work across both creative assets and social networks. */
const lanes = [
  {
    label: 'Creative assets · Product scenes',
    heading: 'One SKU, staged for every season and room.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A daylit product still life on a kitchen counter, late-afternoon window light from camera left, warm shadow grade, generous negative space.',
    body: 'From a kitchen counter in spring to a holiday table in December. Retail teams generate quick variants in the app and bring our studio in for the hero seasonal set.',
  },
  {
    label: 'Creative assets · Marketplaces & storefronts',
    heading: 'Product pages, A+ modules, and flagship tiles.',
    image: '/Images/ecom-listings.jpg',
    alt: 'A clean marketplace product layout on a calibrated monitor, with tile, hero and lifestyle variants pinned in a contact-sheet grid alongside.',
    body: 'Each marketplace enforces its own rules. Our team builds the listing images, A+ modules, and store pages for Amazon, Tmall, JD, and Shopify inside your workspace, and your team keeps them updated all season.',
  },
  {
    label: 'Social networks · Always-on feeds & Reels',
    heading: 'Weekly posts, Stories, and vertical video that move stock.',
    image: '/Images/sb-sample-branded.jpg',
    alt: 'A social-first video frame of a model holding a product, vertical aspect, soft natural daylight, prime-lens shallow focus.',
    body: 'Made for the feeds where shoppers browse. Your team drafts and schedules daily posts across Instagram, Facebook, TikTok (Beta), LinkedIn, X, and YouTube in the app, or hands the calendar to our social editors.',
  },
  {
    label: 'Social networks · Paid social & China commerce',
    heading: 'Ad variants tested for conversion, plus RedNote and Douyin.',
    image: '/Images/pmd-factory.jpg',
    alt: 'A documentary in-studio frame of a retail content team reviewing seasonal creative on a large monitor, warm window light, lifted black point.',
    body: 'Our social and media teams plan paid social funnels, produce and test creative variants in hubStudio with media billed straight to your ad accounts, and run seeding notes and short video on RedNote, Douyin, WeChat, and Weibo.',
  },
];

const faqs = [
  {
    q: 'Does hubStudio cover both catalog visuals and social media for retailers?',
    a: 'Yes. On the creative assets side, your team generates product scenes and video clips in the app and crops them in the free browser editors, while our studio produces seasonal campaigns and marketplace pages. On the social networks side, the app handles Campaigns and scheduling to Instagram, Facebook, TikTok (Beta), LinkedIn, X, and YouTube, while our social team runs weekly calendars, paid social ads, and Chinese social commerce.',
  },
  {
    q: 'How fast can we turn out seasonal assets and promotional posts?',
    a: 'In the app, as fast as your team works: pick an engine, see the price before the run, generate up to 10 images at a time, and schedule the post. When you work with our team, a producer reads your brief within one business day and sends a written proposal within 48 hours.',
  },
  {
    q: 'Will our products look accurate in generated scenes?',
    a: 'Start from your own product photos where the engine supports it (up to four reference images at once), and check every image before it ships. For hero SKUs and complex packaging, our studio shoots the product or retouches the renders by hand.',
  },
  {
    q: 'Do you build marketplace pages and run social commerce in China?',
    a: 'Yes. Our Shanghai and Changsha teams build listing images, A+ content, and flagship store pages for Amazon, Tmall, JD, and Shopify, and run social commerce on RedNote, Douyin, WeChat, and Weibo.',
  },
  {
    q: 'How do paid social campaigns work with your team?',
    a: 'We plan the campaign, produce the image and video ad variants inside hubStudio, send them through Validation for your sign-off, and run audience targeting and A/B testing. Media spend is billed directly to your own ad accounts.',
  },
  {
    q: 'How do we pay?',
    a: 'The app runs on a prepaid balance in real currency, topped up by card, Alipay, or WeChat Pay, with an invoice for every top-up. There is no subscription, no seat fee, and your balance never expires between seasons. Our creative and social services are priced per asset, per project, or on retainer.',
  },
  {
    q: 'Does the app connect to our PIM or DAM?',
    a: 'No, the app has no connectors. Files live in its Assets Library in folders, with tags, versions, and a Campaign filter, and you download them in PNG, JPG, WebP, or MP4.',
  },
  {
    q: 'Can regional and store teams work in the same workspace?',
    a: 'Yes. Invite people as Admins, Creators, or Viewers at no seat cost. They share one balance, an admin can set a daily spending limit per creator, and Validation keeps every price or visual approval on one permanent thread.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Retailers', item: `${SITE}/solutions/retailers` },
  ],
};

const arrow = 'M4 10h12M11 5l5 5-5 5';
---

<Layout
  title="hubStudio for retailers: catalog visuals & social commerce"
  description="Retail teams make product visuals and run social feeds in the hubStudio app, and work with our team for seasonal campaigns, marketplaces, and paid ads."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Retailers
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">The sale starts</span></span>
            <span class="line"><span class="line__i">Friday. Ship the visuals</span></span>
            <span class="line"><span class="line__i">and the <span class="serif">posts.</span></span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Product assets and social feeds in the app. Seasonal campaigns and paid ads with our <em>team</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Retail runs on two clocks at once. One produces creative assets:
              packshots, lifestyle scenes, seasonal refreshes, and marketplace
              listings across thousands of SKUs. The other feeds social
              networks: daily Reels, Stories, TikToks, carousels, and paid ads
              that bring shoppers to the store.
            </p>
            <p>
              Your team makes product variants and schedules posts in the
              hubStudio app. When a season turns or a promotion scales up, our
              creative and social teams work with you inside the app to deliver
              the campaign set, the marketplace pages, and the paid social
              calendar.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
            <a class="ghost-link ghost-link--light" href={`${BRIEF_URL}?way=studio-app`}>
              Send a brief
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Product assets <span>/</span> Social & paid ads <span>/</span> Marketplaces
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/retailers-hero.jpg"
          alt="A retail product still life on a sunlit kitchen counter with late-afternoon window light from camera left, prime-lens shallow focus, warm shadow grade and generous negative space."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Retail <span>/</span> Seasonal set</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The retail calendar</p>
            <h2 class="dh r" style="--d:.05s">
              The calendar doesn’t <span class="serif">wait</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Booking a traditional shoot takes weeks, and social feeds burn
            through creative in days. By the time a reshoot wraps, the
            promotion has already moved on.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ THE APP ============ -->
    <section class="appsec" id="app">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Use the app</p>
            <h2 class="dh r" style="--d:.05s">
              Product assets and social<br />posts from one <span class="serif">app</span>.
            </h2>
          </div>
          <div class="band__prose">
            <p class="band__p r" style="--d:.1s">
              <strong>Pillar · Creative assets:</strong> In the Image studio,
              pick an engine and generate 1 to 10 images a run up to 4K,
              starting from up to four of your own product photos. In the Video
              studio, turn a still packshot into the first frame of a short
              clip. The free browser Image and Video editors crop to each
              network’s safe zones, add price callouts or logos, and time
              captions word by word.
            </p>
            <p class="band__p r" style="--d:.14s">
              <strong>Pillar · Social networks:</strong> Group a promotion’s
              visuals, clips, and promo sheets in a Campaign. Draft and
              schedule posts across Instagram, Facebook, TikTok (Beta),
              LinkedIn, X, and YouTube to up to 20 accounts at once. Re-purpose
              one post for the other feeds, while the Social publishing watcher
              agent flags empty schedules or failed posts.
            </p>
            <p class="band__p r" style="--d:.18s">
              Every render and uploaded file lands in the Assets Library, with
              folders, tags, and versions ready for the next sale.
            </p>
          </div>
        </header>

        <div class="shots">
          {
            shots.map((s, i) => (
              <div class:list={['shots__item', 'r', s.wide && 'shots__item--wide']} style={`--d:${i * 0.06}s`}>
                <p class="shots__job"><span class="kicker__tick"></span>{s.job}</p>
                <AppShot shot={s.shot} path={s.path} caption />
              </div>
            ))
          }
        </div>

        <p class="appsec__more r">
          <a class="ghost-link" href="/app">
            See what the app does
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
      </div>
    </section>

    <!-- ============ WORK WITH US IN THE APP ============ -->
    <section class="studio" id="studio">
      <div class="shell studio__grid">
        <figure class="studio__media crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/studio-brief.webp"
              alt="Hands marking up a printed creative brief for a seasonal product launch, with proof prints and color swatches on the table beside it."
              width="1600"
              height="1200"
              loading="lazy"
            />
          </div>
          <figcaption class="fig fig--light">Our team <span>/</span> Brief review</figcaption>
        </figure>
        <div class="studio__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Work with us in the app</p>
          <h2 class="dh r" style="--d:.05s">
            Seasonal campaigns, marketplaces,<br />and paid social with our <span class="serif">team</span>.
          </h2>
          <p class="studio__p r" style="--d:.1s">
            <strong>Creative assets:</strong> For a seasonal hero campaign, a
            catalog refresh, or a new storefront, send us a brief. A senior art
            director leads the production, mixing live shoots and brand-trained
            AI models asset by asset, and builds listing images, A+ modules,
            and store pages for Amazon, Tmall, JD, and Shopify.
          </p>
          <p class="studio__p r" style="--d:.14s">
            <strong>Social networks:</strong> Our social editors and media
            buyers can run your retail channels inside hubStudio: weekly posts,
            Reels, and TikToks, paid social and retargeting campaigns on your
            ad accounts, and Chinese social commerce on RedNote, Douyin,
            WeChat, and Weibo.
          </p>
          <ul class="plats r" style="--d:.18s">
            {
              platforms.map((p) => (
                <li>
                  <a class="plat" href={p.href}>{p.name}</a>
                </li>
              ))
            }
          </ul>
          <p class="studio__case r" style="--d:.22s">
            <a class="ghost-link ghost-link--light" href="/work/diy-european-retailer">
              For a European DIY retailer, we turned basic shots of thousands of
              products into seasonal lifestyle images for catalog, web, and
              store, without booking a shoot per season
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ TWO WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="app"
      pre="Pick the way that fits the "
      accent="season"
      post="."
      lead="Retailers run daily product variants and social posts in the app, and bring our team into their workspace for seasonal campaigns, marketplace builds, and paid social."
    />

    <!-- ============ FOUR PARTS OF RETAIL WORK ============ -->
    <section class="cover" id="lanes">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Across both pillars</p>
          <h2 class="dh r" style="--d:.05s">
            Four parts of retail work, across assets and <span class="serif">social</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Planning next season? Here is how retail teams split creative
            assets and social networks between the app and our team.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="1024" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-china-speed.jpg"
                alt="A documentary frame of hubStudio operators reviewing retail variations on a wall of pinned proofs, warm shadow grade, calibrated stations behind."
                width="768"
                height="1360"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48 hours</span>
            <span class="source__stat-cap">A written proposal after your brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Built around the<br />retail <span class="serif">calendar</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The app and our creative and social teams belong to one company, so
            your catalog visuals, marketplace listings, and social feeds share
            one library and one approval record.
          </p>
          <p class="source__p r" style="--d:.16s">
            In the app, your team sees the price before every run and pays only
            for what it makes. Nothing is charged for a failed run, and the
            prepaid balance never expires between seasons.
          </p>
          <p class="source__p r" style="--d:.22s">
            When our team works with you, a senior art director or social lead
            runs the brief and the provenance of every asset is recorded.
            hubStudio was founded by Cyril Drouin, former CEO at Publicis.
          </p>
          <ul class="creds r" style="--d:.28s">
            {
              ['Catalog & marketplace assets', 'Social & paid ads', 'Western & China platforms', 'Price shown before every run'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />next <span class="serif">season</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">What retail e-commerce and social teams ask us first.</p>
          <p class="faq__updated r" style="--d:.12s">Updated October 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="app"
      briefQuery="way=studio-app"
      pre="Start this season in the "
      accent="app"
      post="."
      text="Creating an account costs nothing, and you pay only for what you run. For a seasonal campaign set, marketplace pages, or social management, send us a brief and a producer replies within one business day."
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { display: inline-block; width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }
  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
