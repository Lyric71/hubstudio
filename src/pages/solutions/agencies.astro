---
/**
 * hubStudio for agencies  ·  /solutions/agencies
 *
 * Two stories for agencies. First, the app as the place an agency serves its
 * own clients: the Client role, the Client space, "Made for", Validation, the
 * team roles and daily spending limits (facts from src/content/help/
 * client-space.md and your-team.md; no custom branding or domains, and the
 * page says so plainly). Second, the studio as the agency's quiet production
 * team: white-label production delivered to the agency. Use the app is the
 * highlighted way; the closing leads with the app door.
 * Copy from the content-quality-us deck (cq/sol-agencies).
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import InsightsLayer from '../../components/InsightsLayer.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Volume',
    title: 'Clients want more variants for more networks.',
    body: 'Staffing up for every launch month breaks the budget in the quiet ones.',
  },
  {
    label: 'Feedback',
    title: 'Comments come by email, chat, and phone.',
    body: 'Versions get lost, and nobody is sure which file the client actually approved.',
  },
  {
    label: 'Ownership',
    title: 'You own the client relationship.',
    body: 'Any tool or partner you bring in has to leave it that way.',
  },
];

/* Story A: how an agency serves a client in the app. No ordinals; the
   headings carry the order. Captures are real; clientSpace is an empty
   state and its caption says so. */
const steps = [
  {
    title: 'Add the client.',
    body: 'In Your team, an admin adds the client company and gives its people a login. They get an email invitation and set their own password.',
    shot: appShots.teamClients,
    path: '/team',
    caption: true as boolean | string,
  },
  {
    title: 'Tag the work “Made for” them.',
    body: 'Pick the client in the Image or Video studio before a run, on a card in History, or on a post in any network module. The piece then shows up in that client’s Client space, and nowhere else outside your team.',
    shot: appShots.clientSpace,
    path: '/client',
    caption: 'A client’s view before anything is shared: only Client space and Validation in the menu.' as boolean | string,
  },
  {
    title: 'Get it approved in Validation.',
    body: 'Send the piece to one of the client’s people. They validate it or send it back with a comment, and each new version joins the same thread.',
    shot: appShots.validation,
    path: '/validation',
    caption: true as boolean | string,
  },
];

const roles = [
  {
    name: 'Admin',
    body: 'Runs the team. Invites people, adds clients, sets each creator’s daily spending limit, and switches modules on or off per person.',
  },
  {
    name: 'Creator',
    body: 'Makes images, video, and posts, tags who they’re for, and sends them for approval, within a daily limit if an admin set one.',
  },
  {
    name: 'Viewer',
    body: 'Sees the team’s work in History and the Assets Library. Creates nothing and spends nothing.',
  },
  {
    name: 'Client',
    body: 'Sees only what was made for their company. Downloads it, comments on it, and approves it or sends it back.',
  },
];

/* Story B: the two production lanes the studio runs for agencies. */
const lanes = [
  {
    label: 'Images and visuals',
    heading: 'Campaign visuals, delivered to you.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A daylit visual studio frame with calibrated monitors showing brand variations in progress, prime-lens depth, warm shadow grade, generous negative space.',
    body: 'Campaign visuals, social adaptations, product pictures, and localized versions, briefed by you and delivered to you.',
    tags: ['Campaign visuals', 'Social adaptations', 'Product pictures', 'Localized versions', 'Format variants'],
  },
  {
    label: 'Video',
    heading: 'One master film, cut for every feed.',
    image: '/Images/sb-hub.jpg',
    alt: 'A documentary-style frame of a video edit suite with a master TVC paused on the monitor and short-form cuts arranged in the timeline panel, warm window light, real-photography grade.',
    body: 'Short social cuts, product demos, and a master film cut down for every feed and ratio.',
    tags: ['Short-form social', 'Product demos', 'Master to social cuts', 'Ratio variants'],
    caseStudy: { label: 'The Mexicash video campaign, briefed and shipped across five platforms', href: '/work/mexicash' },
  },
];

const faqs: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'Can our clients see and approve work in hubStudio?',
    a: 'Yes. An admin adds each client company and gives its people a login. They see a Client space with only the work tagged “Made for” them, and they approve it or send it back in Validation.',
  },
  {
    q: 'Will our clients see prompts, engines, or costs?',
    a: 'No. A client login shows the finished work and the approval thread. Prompts, engines, and prices stay with your team, and clients hold no balance.',
  },
  {
    q: 'Can we put our agency’s logo on the Client space?',
    a: 'No. The Client space is part of hubStudio, at hubStudio’s address. If a client must see only your agency’s name, download the approved work and deliver it yourself, or use the studio, which delivers to you.',
  },
  {
    q: 'How do we keep spending under control?',
    a: 'The team pays from one prepaid balance. An admin can set a daily spending limit for each creator; admins have none. Every run shows its price before it starts.',
  },
  {
    q: 'Do client logins cost anything?',
    a: 'There are no seat fees for anyone, clients included, and a client never spends from a balance of its own. When a client downloads a file, that download is charged to your team’s balance, like any download.',
  },
  {
    q: 'How does the white-label studio work?',
    a: 'You brief us, we produce, and we deliver the finished files to you. You present them to your client under your agency’s name.',
  },
  {
    q: 'Can we mix the app and the studio?',
    a: 'Yes. Add our creatives to your agency’s workspace and we work from your balance. Your admins approve in Validation, and you tag the approved work for your client.',
  },
  {
    q: 'How is it priced?',
    a: 'The app runs on a prepaid balance with no subscription and no seat fees, and a failed run is never charged. Every top-up comes with an invoice made out to your agency. The studio is priced per asset, per project, or on retainer, quoted after a brief.',
  },
  {
    q: 'Can we earn from the accounts we bring to the app?',
    a: 'Yes. Agencies can join as partners: you open accounts for the customers you bring and earn a commission on what those accounts spend. Details are on the Partners page.',
    link: { label: 'Partners', href: '/partners' },
  },
  {
    q: 'What do you need from us to start?',
    a: 'For the app, an email address. For the studio, a brief, your client’s brand guidelines, and a few examples of work they liked. A producer reads the brief within one business day.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Agencies', item: `${SITE}/solutions/agencies` },
  ],
};

const arrow = 'M4 10h12M11 5l5 5-5 5';
---

<Layout
  title="hubStudio for agencies: client logins and white-label work"
  description="Agencies run client work in the hubStudio app, with client logins and approvals in one place, or use our studio as a quiet production team."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Agencies
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Your clients in</span></span>
            <span class="line"><span class="line__i">the app. Our studio</span></span>
            <span class="line"><span class="line__i serif">behind you.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Show clients the work where you <em>made it</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              An agency needs a place to make the work and a place to show it
              to clients. It also needs extra hands when a pitch comes through
              or a launch lands.
            </p>
            <p>
              In the hubStudio app, your team makes and publishes the work,
              and your clients log in to approve it. When you need more
              capacity, our studio produces under your agency’s name and hands
              the files to you, not your client.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
            <a class="ghost-link ghost-link--light" href={`${BRIEF_URL}?way=studio`}>
              Send a brief
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Client logins <span>/</span> Approvals <span>/</span> Made under your name
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/agencies-hero.jpg"
          alt="A daylit agency production floor with two creative directors reviewing a wall of pinned campaign variations, prime-lens shallow focus, warm shadow grade, calibrated stations along the back."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Agency <span>/</span> Review day</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The agency squeeze</p>
            <h2 class="dh r" style="--d:.05s">
              More work per client,<br />and no more <span class="serif">margin</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Clients want more every month. Hiring for each peak doesn’t pay,
            and client feedback is scattered across inboxes.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ STORY A: YOUR CLIENTS, INSIDE THE APP ============ -->
    <section class="clients" id="clients">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Use the app</p>
          <h2 class="dh r" style="--d:.05s">
            Run client work from<br />one <span class="serif">workspace</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Your agency is one team in hubStudio. Admins run it, Creators make
            the work, Viewers follow along. Each client company gets its own
            logins, with the Client role.
          </p>
        </header>

        <div class="steps">
          {
            steps.map((s) => (
              <article class="step">
                <div class="step__body">
                  <h3 class="step__title r">{s.title}</h3>
                  <p class="step__p r" style="--d:.05s">{s.body}</p>
                </div>
                <div class="step__shot r" style="--d:.1s">
                  <AppShot shot={s.shot} path={s.path} caption={s.caption} />
                </div>
              </article>
            ))
          }
        </div>

        <div class="roles">
          <h3 class="roles__title r">Four roles, one team</h3>
          <div class="aud-grid">
            {
              roles.map((a, i) => (
                <article class="aud r" style={`--d:${i * 0.06}s`}>
                  <p class="aud__label">
                    <span class="aud__tick"></span>
                    Role
                  </p>
                  <h4 class="aud__title">{a.name}</h4>
                  <p class="aud__body">{a.body}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="notes">
          <p class="notes__p r">
            Clients never see a prompt, an engine, or a cost, and they hold no
            balance.
          </p>
          <p class="notes__p notes__p--flag r" style="--d:.05s">
            One thing to know up front: the Client space runs on hubStudio’s
            own address and looks like hubStudio, not like your agency. If a
            client should only ever see your name, download the approved files
            and send them yourself.
          </p>
          <p class="r" style="--d:.1s">
            <a class="ghost-link" href="/app/review">
              How review works in the app
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ THREE WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="app"
      pre="Start in the app, add the "
      accent="studio"
      post=" when it helps."
      lead="Run client work in the app day to day. When a big job lands, bring in the studio, inside the app or outside it."
    />

    <!-- ============ STORY B: THE STUDIO AS YOUR PRODUCTION TEAM ============ -->
    <section class="cover" id="white-label">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Studio only</p>
            <h2 class="dh r" style="--d:.05s">
              A production team<br />behind your <span class="serif">name</span>.
            </h2>
          </div>
          <div class="band__prose">
            <p class="band__p r" style="--d:.1s">
              That’s the app side. The studio side is simpler to explain. In
              the trade, it’s called white-label production. You win the
              account and own the strategy. We make the images and the video,
              and we hand the finished files to you. Questions from your
              client still come to you.
            </p>
            <p class="band__p r" style="--d:.14s">
              We work to your brand guides, your specs, and your approval
              steps, so you don’t have to learn ours. A senior art director
              leads every brief and checks the work before it leaves the
              studio.
            </p>
            <p class="band__p r" style="--d:.18s">
              Book us per asset, per project, or on retainer. Plenty of
              agencies use us for the launch month and not for the quiet ones.
            </p>
          </div>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="820" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  White-label lane
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
                <p class="feature__scope r" style="--d:.16s">In scope</p>
                <ul class="chips r" style="--d:.2s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
                {c.caseStudy && (
                  <p class="feature__case r" style="--d:.24s">
                    <a class="ghost-link" href={c.caseStudy.href}>
                      {c.caseStudy.label}
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </p>
                )}
              </div>
            </article>
          ))
        }

        <aside class="combo r">
          <p class="combo__label">
            <span class="kicker__tick"></span>Studio + app, in your workspace
          </p>
          <p class="combo__p">
            There’s a middle way too. Add our creatives as members of your
            agency’s hubStudio team. We make the work from your workspace and
            your balance, your admins approve it in Validation, and you tag it
            “Made for” your client when it’s ready. Everything stays in your
            workspace afterward.
          </p>
          <a class="ghost-link" href="/studio/with-the-app">
            How Studio + app works
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </aside>
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-hybrid.jpg"
                alt="A documentary frame of a hybrid creative-technical pair reviewing brand variations on a large monitor inside the hubStudio Shanghai floor, warm shadow grade."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 business day</span>
            <span class="source__stat-cap">A producer reads every brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            A production partner<br />that knows agency <span class="serif">life</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            We make work for brands and for agencies, and we know the
            difference between a client and the agency that holds the account.
          </p>
          <p class="source__p r" style="--d:.16s">
            Your agency owns the strategy, the client relationship, and the
            creative direction. The studio owns production and delivery to
            you. The studio was founded by Cyril Drouin, former CEO at
            Publicis, so we’ve sat on the agency side of the table.
          </p>
          <p class="source__p r" style="--d:.22s">
            The same company builds the app, so moving a job between your
            team, our studio, and the app doesn’t need a new contract or a new
            tool.
          </p>
          <ul class="creds r" style="--d:.28s">
            {
              ['Senior art directors', 'Delivered to you', 'Twenty service lines', 'Proposal within 48 hours'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">client</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What agency owners and producers ask us first.
          </p>
          <p class="faq__updated r" style="--d:.12s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.a}
                      {faq.link && (
                        <>
                          {' '}
                          <a class="acc__link" href={faq.link.href}>{faq.link.label}</a>
                        </>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <InsightsLayer placement="agencies" tone="cream" />

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="app"
      briefQuery="way=studio"
      pre="Open the app, or send us the "
      accent="brief"
      post="."
      text="Create your agency’s account and add your first client today, at no cost. For the next launch, send us a brief and a producer reads it within one business day."
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { display: inline-block; width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
