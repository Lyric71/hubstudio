---
/**
 * hubStudio for agencies  ·  /solutions/agencies
 *
 * Agencies run two jobs for every client: creative assets (campaign visuals,
 * video cuts, product shots, presentations) and social networks (monthly
 * calendars, multi-account publishing, paid social variants, executive
 * advocacy). This page explains how agencies run both in the hubStudio app
 * with Client spaces and Validation ("Use the app"), and how our creative and
 * social teams back them up inside their workspace or behind their name
 * ("Work with us in the app").
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import InsightsLayer from '../../components/InsightsLayer.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Assets & feeds',
    title: 'Clients want campaign visuals and daily social on the same retainer.',
    body: 'One brief now asks for hero imagery, vertical video cuts, LinkedIn carousels, and paid ad variants across five networks.',
  },
  {
    label: 'Feedback',
    title: 'Approvals scatter across email, chat, and decks.',
    body: 'Visuals sit in a transfer link while post copy sits in a spreadsheet, and nobody is sure which version the client actually approved.',
  },
  {
    label: 'Ownership',
    title: 'You own the client relationship and the strategy.',
    body: 'Any workspace or production partner you bring in has to keep your agency in front and scale up without adding fixed headcount.',
  },
];

/* Story A: how an agency serves a client in the app across both assets and
   social networks. No ordinals; the headings carry the order. */
const steps = [
  {
    title: 'Add each client company.',
    body: 'In Your team, an admin adds the client company and gives its people logins. Each client gets its own space, separate from every other account you manage.',
    shot: appShots.teamClients,
    path: '/team',
    caption: true as boolean | string,
  },
  {
    title: 'Tag assets and social posts “Made for” them.',
    body: 'Generate images and video in the studios, crop in the free editors, and draft posts for LinkedIn, Instagram, Facebook, TikTok (Beta), X, and YouTube. Tag any render or scheduled post “Made for” that client, and it appears in their Client space and nowhere else outside your agency.',
    shot: appShots.clientSpace,
    path: '/client',
    caption: 'A client’s view before anything is shared: only Client space and Validation in the menu.' as boolean | string,
  },
  {
    title: 'Lock approvals in Validation before publishing.',
    body: 'Send an image, a video, a social post, or a deck to the client’s approver. They validate it or send it back with a comment on one permanent thread, and a social post waiting for approval is locked so it cannot go out early.',
    shot: appShots.validation,
    path: '/validation',
    caption: true as boolean | string,
  },
];

const roles = [
  {
    name: 'Admin',
    body: 'Runs the agency workspace. Invites teammates, adds client companies, sets each creator’s daily spending limit, and switches modules on or off per person.',
  },
  {
    name: 'Creator',
    body: 'Generates images and video, edits in the browser tools, drafts and schedules social posts, tags which client they’re for, and sends them for approval.',
  },
  {
    name: 'Viewer',
    body: 'Account managers or strategists who check the team’s work in History and the Assets Library without creating or spending from the balance.',
  },
  {
    name: 'Client',
    body: 'Sees only the finished assets and scheduled posts tagged for their company. Downloads files, comments, and approves or sends items back in Validation.',
  },
];

/* Story B: the three lanes our team runs for agencies across both pillars. */
const lanes = [
  {
    label: 'Pillar · Creative assets (Images & design)',
    heading: 'Campaign visuals, product shots, and decks delivered to you.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A daylit visual studio frame with calibrated monitors showing brand variations in progress, prime-lens depth, warm shadow grade, generous negative space.',
    body: 'Senior art directors, designers, and retouchers produce campaign key visuals, ecommerce sets, packaging, presentations, and localized adaptations across twenty studio service lines, briefed by you and delivered under your name.',
    tags: ['Campaign visuals', 'Product & ecommerce sets', 'Presentations & pitch decks', 'Localized adaptations', 'Format variants'],
  },
  {
    label: 'Pillar · Creative assets (Video & motion)',
    heading: 'One master film, cut for every feed and ratio.',
    image: '/Images/sb-hub.jpg',
    alt: 'A documentary-style frame of a video edit suite with a master TVC paused on the monitor and short-form cuts arranged in the timeline panel, warm window light, real-photography grade.',
    body: 'Launch films, storyboards, motion design, product demos, and vertical social cuts sized for TikTok, Reels, YouTube Shorts, and Douyin.',
    tags: ['Launch films', 'Short-form social video', 'Product demos & motion', 'Master to social cuts'],
    caseStudy: { label: 'The Mexicash video campaign, briefed and shipped across five platforms', href: '/work/mexicash' },
  },
  {
    label: 'Pillar · Social networks (Content, ads & China)',
    heading: 'Social calendars, paid ad variants, and Chinese channels.',
    image: '/Images/sm-hero.jpg',
    alt: 'A content creator in a sunlit Shanghai loft holding a vertical smartphone close to her face.',
    body: 'When a client needs full social execution or a local team in China, our social editors and media buyers produce weekly posts and carousels, build paid social variant sets, ghostwrite executive posts, and run WeChat, RedNote, Douyin, and Weibo behind your agency.',
    tags: ['Monthly social calendars', 'Paid social ad variants', 'Executive ghostwriting', 'WeChat, RedNote, Douyin & Weibo'],
  },
];

const faqs: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'Can we run both creative production and client social publishing in hubStudio?',
    a: 'Yes. Your team uses the Create modules (Explore, Image, Video, and the free browser editors) to produce assets, and the Publish modules (Campaigns, LinkedIn, Instagram, Facebook, TikTok Beta, X, and YouTube) to draft and schedule client posts across up to 20 accounts per post.',
  },
  {
    q: 'Can our clients see and approve assets and social posts in hubStudio?',
    a: 'Yes. An admin adds each client company and gives its people logins. They see a Client space with only the images, videos, posts, and files tagged “Made for” their company, and they approve or return items with a comment in Validation.',
  },
  {
    q: 'Will our clients see prompts, engines, or costs?',
    a: 'No. A client login shows only the finished work, the scheduled posts, and the approval thread. Prompts, engines, and prices stay with your agency team, and clients hold no balance.',
  },
  {
    q: 'Can we put our agency’s logo on the Client space?',
    a: 'No. The Client space runs on hubStudio’s address and carries hubStudio’s interface. If a client must see only your agency’s name, download the approved files and deliver them yourself, or brief our team for white-label delivery.',
  },
  {
    q: 'How do we keep team spending under control across client accounts?',
    a: 'Your agency pays from one shared prepaid balance. An admin can set a daily spending limit for each creator, and every run shows its price before it starts. The Image editor, Video editor, Campaigns, Validation, and publishing to LinkedIn, Instagram, Facebook, and TikTok cost nothing to use.',
  },
  {
    q: 'Do client logins cost anything?',
    a: 'There are no seat fees for anyone, clients included, and a client never spends from a balance of its own. When a client downloads a file, that download carries the same small charge against your team’s balance as any download.',
  },
  {
    q: 'How does working with your creative and social team work for an agency?',
    a: 'Two ways. You can add our creatives and social managers as members of your agency’s hubStudio workspace, where we produce assets and draft posts from your balance and your admins approve them before tagging them for your client. Or you send us a brief for white-label delivery, and we hand the finished files straight to your team.',
  },
  {
    q: 'Can your team handle Chinese social networks for our Western clients?',
    a: 'Yes. Many Western agencies bring us in specifically for China. Our Shanghai and Changsha teams produce and manage content for WeChat Official Accounts and Channels, RedNote, Douyin, and Weibo, while your agency keeps the client relationship.',
  },
  {
    q: 'Can we earn a commission from client accounts we bring to the app?',
    a: 'Yes. Agencies that join as partners open hubStudio accounts for the clients they bring and earn a commission on what those accounts spend. Details are on the Partners page.',
    link: { label: 'Partners', href: '/partners' },
  },
  {
    q: 'How is it priced?',
    a: 'The app runs on a prepaid balance in real currency with no subscription and no seat fees, a failed run is never charged, and every top-up comes with an invoice made out to your agency. Our services are priced per asset, per project, or on retainer, quoted in writing within 48 hours of your brief.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Agencies', item: `${SITE}/solutions/agencies` },
  ],
};

const arrow = 'M4 10h12M11 5l5 5-5 5';
---

<Layout
  title="hubStudio for agencies: client assets, social & approvals"
  description="Agencies produce creative assets and run client social networks in the hubStudio app with client logins, or use our team for white-label production."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Agencies
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Your clients in</span></span>
            <span class="line"><span class="line__i">the app. Our team</span></span>
            <span class="line"><span class="line__i serif">behind you.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Creative assets and social networks, approved where you <em>make them</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Clients hire an agency for two jobs that run side by side:
              producing creative assets (campaign visuals, video cuts, product
              shots, decks) and running social networks (monthly calendars,
              multi-account posts, paid social ads, executive voices).
            </p>
            <p>
              In the hubStudio app, your team makes the assets, schedules the
              posts, and gives each client a login to approve its own work.
              When a pitch or launch needs extra capacity, our creative and
              social teams work inside your workspace or deliver white-label
              under your agency’s name.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
            <a class="ghost-link ghost-link--light" href={`${BRIEF_URL}?way=studio-app`}>
              Send a brief
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Creative assets <span>/</span> Social networks <span>/</span> Client logins & white-label
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/agencies-hero.jpg"
          alt="A daylit agency production floor with two creative directors reviewing a wall of pinned campaign variations, prime-lens shallow focus, warm shadow grade, calibrated stations along the back."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Agency <span>/</span> Review day</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The agency squeeze</p>
            <h2 class="dh r" style="--d:.05s">
              More assets and feeds per client,<br />on the same <span class="serif">margin</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Clients expect campaign-grade visuals and a full social calendar
            every month. Staffing for every peak breaks the quiet months, and
            approvals get lost across inboxes.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ STORY A: YOUR CLIENTS, INSIDE THE APP ============ -->
    <section class="clients" id="clients">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Use the app</p>
          <h2 class="dh r" style="--d:.05s">
            Run client assets and social<br />from one <span class="serif">workspace</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Your agency is one team in hubStudio. Creators generate visuals
            with the leading AI engines, finish them in the browser editors,
            organize launches in Campaigns, and schedule posts across LinkedIn,
            Instagram, Facebook, TikTok (Beta), X, and YouTube. Each client
            company gets its own logins, with the Client role.
          </p>
        </header>

        <div class="steps">
          {
            steps.map((s) => (
              <article class="step">
                <div class="step__body">
                  <h3 class="step__title r">{s.title}</h3>
                  <p class="step__p r" style="--d:.05s">{s.body}</p>
                </div>
                <div class="step__shot r" style="--d:.1s">
                  <AppShot shot={s.shot} path={s.path} caption={s.caption} />
                </div>
              </article>
            ))
          }
        </div>

        <div class="roles">
          <h3 class="roles__title r">Four roles, one agency workspace</h3>
          <div class="aud-grid">
            {
              roles.map((a, i) => (
                <article class="aud r" style={`--d:${i * 0.06}s`}>
                  <p class="aud__label">
                    <span class="aud__tick"></span>
                    Role
                  </p>
                  <h4 class="aud__title">{a.name}</h4>
                  <p class="aud__body">{a.body}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="notes">
          <p class="notes__p r">
            Clients never see a prompt, an engine, or a cost, and they hold no
            balance.
          </p>
          <p class="notes__p notes__p--flag r" style="--d:.05s">
            One thing to know up front: the Client space runs on hubStudio’s
            own address and looks like hubStudio, not like your agency. If a
            client should only ever see your name, download the approved files
            and send them yourself.
          </p>
          <p class="r" style="--d:.1s">
            <a class="ghost-link" href="/app/review">
              How review and Client space work in the app
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ TWO WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="app"
      pre="Run client work in the app, or bring our "
      accent="team"
      post=" in."
      lead="Handle daily assets and social calendars in the app with your own crew. When a pitch lands or an account scales up, add our creative and social teams inside your workspace."
    />

    <!-- ============ STORY B: OUR TEAM AS YOUR PRODUCTION PARTNER ============ -->
    <section class="cover" id="white-label">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Work with us in the app · Or white-label</p>
            <h2 class="dh r" style="--d:.05s">
              A creative and social team<br />behind your <span class="serif">name</span>.
            </h2>
          </div>
          <div class="band__prose">
            <p class="band__p r" style="--d:.1s">
              You win the account and own the strategy. When you need extra
              hands across creative production or social channels, our team
              produces the images, the video, the social posts, and the ad
              variants, and hands them to you. Questions from your client still
              come to you.
            </p>
            <p class="band__p r" style="--d:.14s">
              We follow your client’s brand guides, specs, and tone of voice. A
              senior art director or social lead checks every deliverable
              before it reaches your desk.
            </p>
            <p class="band__p r" style="--d:.18s">
              Book us per asset, per project, or on retainer. Plenty of
              agencies bring us in for launch months or Chinese channels and
              run the quiet months on their own in the app.
            </p>
          </div>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="820" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
                <p class="feature__scope r" style="--d:.16s">In scope</p>
                <ul class="chips r" style="--d:.2s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
                {c.caseStudy && (
                  <p class="feature__case r" style="--d:.24s">
                    <a class="ghost-link" href={c.caseStudy.href}>
                      {c.caseStudy.label}
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </p>
                )}
              </div>
            </article>
          ))
        }

        <aside class="combo r">
          <p class="combo__label">
            <span class="kicker__tick"></span>Work with us inside your agency’s workspace
          </p>
          <p class="combo__p">
            Want everything in one place? Add our creatives and social managers
            as members of your agency’s hubStudio team. We produce the assets
            and draft the posts from your workspace and your balance, your
            admins approve them in Validation, and you tag them “Made for” your
            client when they’re ready. Every file and approval thread stays in
            your workspace afterward.
          </p>
          <a class="ghost-link" href="/studio/with-the-app">
            How working together in the app runs
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </aside>
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-hybrid.jpg"
                alt="A documentary frame of a hybrid creative-technical pair reviewing brand variations on a large monitor inside the hubStudio Shanghai floor, warm shadow grade."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 business day</span>
            <span class="source__stat-cap">A producer reads every brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            A partner that knows<br />agency <span class="serif">life</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            We know the difference between a brand client and the agency that
            holds the account.
          </p>
          <p class="source__p r" style="--d:.16s">
            Your agency owns the strategy, the client relationship, and the
            creative direction. Our team backs you up on creative assets and
            social execution, inside your workspace or delivered behind your
            name. Founded by Cyril Drouin, former CEO at Publicis, we’ve sat on
            the agency side of the table.
          </p>
          <p class="source__p r" style="--d:.22s">
            And because we build the hubStudio app as well, your team can move
            work between self-serve production and our studio without switching
            tools or opening a new contract.
          </p>
          <ul class="creds r" style="--d:.28s">
            {
              ['Senior art directors', 'Creative & social teams', 'Western & China channels', 'Proposal within 48 hours'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">client</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What agency owners, account leads, and producers ask us first.
          </p>
          <p class="faq__updated r" style="--d:.12s">Updated October 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.a}
                      {faq.link && (
                        <>
                          {' '}
                          <a class="acc__link" href={faq.link.href}>{faq.link.label}</a>
                        </>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <InsightsLayer placement="agencies" tone="cream" />

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="app"
      briefQuery="way=studio-app"
      pre="Open the app, or send us the "
      accent="brief"
      post="."
      text="Create your agency’s account and add your first client today, at no cost. When a launch or a social retainer needs extra hands, send us a brief and a producer reads it within one business day."
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { display: inline-block; width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }
  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }
  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { flex: none; width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }
  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.9fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
  }
  .band__note { font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }
  .band__note--light { color: rgba(240, 237, 233, 0.76); }
  .band__prose { display: grid; gap: 14px; }
  .band__p { font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .cbar { display: flex; height: 12px; }
  .cbar span { flex: 1; }
  .hero { display: grid; background: var(--ink); color: var(--text-on-dark); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1fr; } }
  .hero__panel { position: relative; display: flex; align-items: center; padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px); overflow: clip; }
  .hero__reg { position: absolute; width: clamp(240px, 28vw, 420px); right: -12%; bottom: -14%; color: rgba(240, 237, 233, 0.055); pointer-events: none; }
  .hero__panel-in { position: relative; width: 100%; max-width: 600px; }
  .hero__title { margin-top: 24px; font-family: var(--font-sans); font-weight: 600; font-size: clamp(38px, 5vw, 72px); line-height: 1.02; letter-spacing: -0.045em; }
  .hero__title .line { display: block; overflow: hidden; padding: 0.22em 0.14em; margin: -0.22em -0.14em; }
  .hero__title .line__i { display: block; transform: translateY(145%); transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero__title .line:nth-child(1) .line__i { transition-delay: 0.12s; }
  .hero__title .line:nth-child(2) .line__i { transition-delay: 0.22s; }
  .hero__title .line:nth-child(3) .line__i { transition-delay: 0.32s; }
  .hero.in .hero__title .line__i { transform: translateY(0); }
  .hero__title .serif { font-size: 1.04em; }
  @media (prefers-reduced-motion: reduce) { .hero__title .line__i { transform: none; } }
  .hero__tag { margin-top: 26px; font-size: clamp(18px, 1.5vw, 23px); font-weight: 600; letter-spacing: -0.02em; }
  .hero__tag em { font-family: var(--font-serif); font-style: italic; font-weight: 500; color: var(--brand-orange); }
  .hero__lead { margin-top: 20px; display: grid; gap: 13px; max-width: 48ch; }
  .hero__lead p { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.74); }
  .hero__cta { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  .hero__meta { margin-top: 34px; padding-top: 20px; border-top: 1.5px dashed rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(240, 237, 233, 0.5); }
  .hero__meta span { color: var(--brand-orange); }
  .hero__visual { position: relative; overflow: hidden; min-height: 58vh; }
  @media (min-width: 900px) { .hero__visual { min-height: auto; } }
  .hero__visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .hero.in .hero__visual img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) { .hero__visual img { transform: none; } }
  .hero__chip { position: absolute; left: 18px; bottom: 18px; z-index: 2; display: inline-flex; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); background: rgba(14, 22, 51, 0.78); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-on-dark); }
  .hero__chip span { color: var(--brand-orange); }
  .why { background: var(--ink); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .reasons { display: grid; gap: 28px; }
  @media (min-width: 820px) { .reasons { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .reason { padding-top: 26px; border-top: 1.5px solid rgba(240, 237, 233, 0.18); display: grid; gap: 14px; align-content: start; }
  .reason__label { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .reason__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .reason__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(22px, 2vw, 28px); line-height: 1.18; letter-spacing: -0.02em; color: var(--text-on-dark); }
  .reason__body { font-size: var(--type-body); line-height: 1.62; color: rgba(240, 237, 233, 0.74); }

  /* Story A: the client workflow in the app, with real captures. */
  .clients { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .steps { display: grid; }
  .step { display: grid; gap: 28px; align-items: center; padding-block: clamp(36px, 4.5vw, 60px); border-top: 1.5px dashed var(--line-strong); }
  @media (min-width: 940px) { .step { grid-template-columns: 0.75fr 1.25fr; gap: 64px; } }
  .step__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.12; letter-spacing: -0.025em; color: var(--text-ink); }
  .step__p { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); max-width: 52ch; }
  .roles { padding-top: clamp(40px, 5vw, 64px); border-top: 1.5px dashed var(--line-strong); }
  .roles__title { margin-bottom: 26px; font-family: var(--font-sans); font-weight: 600; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.12; letter-spacing: -0.025em; }
  .aud-grid { display: grid; gap: 24px; }
  @media (min-width: 720px) { .aud-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (min-width: 1080px) { .aud-grid { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .aud { padding: 26px 22px 30px; background: #fff; border: 1px solid var(--line-hairline); border-radius: 6px; display: grid; gap: 12px; align-content: start; transition: border-color 0.18s ease, transform 0.24s ease; }
  .aud:hover { border-color: var(--brand-orange); transform: translateY(-2px); }
  .aud__label { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .aud__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .aud__title { font-family: var(--font-sans); font-weight: 600; font-size: clamp(19px, 1.5vw, 22px); line-height: 1.22; letter-spacing: -0.02em; color: var(--text-ink); }
  .aud__body { font-size: var(--type-body); line-height: 1.6; color: var(--text-mute); }
  .notes { margin-top: clamp(36px, 4vw, 56px); display: grid; gap: 16px; max-width: 72ch; }
  .notes__p { font-size: var(--type-body); line-height: 1.66; color: var(--text-ink); }
  .notes__p--flag { padding: 18px 22px; border-left: 3px solid var(--brand-orange); background: #fff; border-radius: 0 6px 6px 0; color: var(--text-mute); }

  /* Story B: creative and social production lanes. */
  .cover { background: var(--paper-2); padding-block: clamp(80px, 10vw, 150px); }
  .feature { display: grid; gap: 36px; align-items: center; padding-block: clamp(40px, 5vw, 72px); border-top: 1.5px dashed var(--line-strong); }
  @media (min-width: 900px) {
    .feature { grid-template-columns: 1fr 1fr; gap: 72px; }
    .feature--rev .feature__media { order: 2; }
  }
  .feature__media .crop__inner { aspect-ratio: 5 / 4; }
  .feature__idx { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .feature__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .feature__body .dh { margin-top: 16px; }
  .feature__p { margin-top: 14px; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .feature__scope { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line-hairline); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); }
  .feature__case { margin-top: 22px; }
  .chips { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); font-size: 12px; font-weight: 500; transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease; }
  .chip:hover { background: var(--brand-orange); border-color: var(--brand-orange); color: #fff; }
  .combo { margin-top: clamp(40px, 5vw, 64px); padding: clamp(26px, 3vw, 40px); background: #fff; border: 1px solid var(--line-hairline); border-radius: var(--radius-card); box-shadow: var(--shadow-card); display: grid; gap: 16px; justify-items: start; }
  .combo__label { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-orange); }
  .combo__p { max-width: 70ch; font-size: var(--type-body); line-height: 1.66; color: var(--text-ink); }

  .source { background: var(--navy); color: var(--text-on-dark); padding-block: clamp(80px, 10vw, 150px); }
  .source__grid { display: grid; gap: 52px; }
  @media (min-width: 940px) { .source__grid { grid-template-columns: 0.92fr 1.08fr; gap: 70px; align-items: center; } }
  .source__visual { position: relative; }
  .source__main .crop__inner { aspect-ratio: 5 / 4; }
  .source__stat { position: absolute; left: -10px; top: 36px; display: grid; gap: 3px; padding: 15px 19px; border-radius: 12px; background: var(--brand-orange); color: #fff; box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42); }
  .source__stat-num { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
  .source__stat-cap { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase; max-width: 18ch; line-height: 1.4; }
  .source__body .dh { margin-top: 16px; }
  .source__lead { margin-top: 20px; font-size: var(--type-lead); line-height: 1.5; color: var(--text-on-dark); }
  .source__p { margin-top: 15px; font-size: var(--type-body); line-height: 1.66; color: rgba(240, 237, 233, 0.78); }
  .creds { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 9px; }
  .cred { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: var(--radius-pill); border: 1px solid rgba(240, 237, 233, 0.2); font-family: var(--font-mono); font-size: 12px; font-weight: 500; transition: border-color 0.2s ease, background-color 0.2s ease; }
  .cred:hover { border-color: var(--brand-orange); background: rgba(233, 78, 27, 0.16); }
  .cred svg { width: 13px; height: 13px; color: var(--brand-orange); }
  .faq { background: var(--paper); padding-block: clamp(80px, 10vw, 150px); }
  .faq__grid { display: grid; gap: 44px; }
  @media (min-width: 1000px) {
    .faq__grid { grid-template-columns: 0.78fr 1.22fr; gap: 72px; align-items: start; }
    .faq__intro { position: sticky; top: 96px; }
  }
  .faq__intro .dh { margin-top: 18px; }
  .faq__sub { margin-top: 18px; font-size: var(--type-body); line-height: 1.62; color: var(--text-mute); }
  .faq__updated { margin-top: 12px; margin-bottom: 26px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); }
  .acc { display: grid; }
  .acc__row { border-top: 1.5px solid var(--ink); }
  .acc__row:last-child { border-bottom: 1.5px solid var(--ink); }
  .acc__q { width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 16px; padding: 26px 0; background: transparent; border: none; text-align: left; cursor: pointer; }
  .acc__qmark { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--brand-orange); padding-top: 3px; }
  .acc__qtext { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; color: var(--text-ink); transition: color 0.18s ease; }
  .acc__q:hover .acc__qtext { color: var(--brand-orange); }
  .acc__icon { position: relative; width: 22px; height: 22px; margin-top: 2px; }
  .acc__icon span { position: absolute; top: 50%; left: 50%; width: 14px; height: 2px; border-radius: 2px; background: var(--text-ink); transform: translate(-50%, -50%); transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
  .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(90deg); }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child { transform: translate(-50%, -50%) rotate(0deg); }
  .acc__q[aria-expanded='true'] .acc__icon span { background: var(--brand-orange); }
  .acc__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s ease; }
  .acc__q[aria-expanded='true'] + .acc__a { grid-template-rows: 1fr; }
  .acc__a-inner { overflow: hidden; }
  .acc__a-inner p { padding: 0 0 26px 41px; max-width: 64ch; font-size: var(--type-body); line-height: 1.66; color: var(--text-mute); }
  .acc__link { color: var(--brand-orange); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  const progBar = document.querySelector<HTMLElement>('.prog__bar');
  if (progBar) {
    const onScroll = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      progBar.style.transform = `scaleX(${max > 0 ? Math.min(1, d.scrollTop / max) : 0})`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
  const revealEls = document.querySelectorAll('.r, .r-clip, .hero');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -7% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }
  const accQs = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc__q'));
  accQs.forEach((q) => {
    q.addEventListener('click', () => {
      const open = q.getAttribute('aria-expanded') === 'true';
      accQs.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      q.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
