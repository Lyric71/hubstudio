---
/**
 * AIGC for Agencies (white-label)  ·  /solutions/agencies
 *
 * White-label content production for creative agencies. Drawn from the
 * source page's challenge / how-we-work / advantage framing, the four
 * white-label promises, the responsibilities split, and the two lanes
 * (images and video) we deliver under partner branding.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

const reasons = [
  {
    label: 'Agency challenge',
    title: 'More content, faster, across more platforms than ever.',
    body: "Clients demand the volume. Hiring more designers and editors is expensive, hard to scale and difficult to manage. The traditional fix breaks the agency P&L; the technology fix waits for a partner who can operate it inside an agency workflow.",
  },
  {
    label: 'How we work',
    title: 'Your invisible content production team, powered by AIGC.',
    body: 'You win the client, write the strategy and own the relationship. We handle the heavy lifting: visuals, video, adaptations, all using current AIGC. Your clients see only your agency. We stay behind the scenes.',
  },
  {
    label: 'AIGC advantage',
    title: 'A 24/7 studio that scales with the agency.',
    body: 'Thousands in talent fees, props and studio time replaced by content at a fraction of the price. No overhead, no hiring cycle, no traditional production cost. Capacity flexes with the brief instead of the headcount plan.',
  },
];

const promises = [
  {
    label: 'Invisible partner',
    title: 'Your clients never know we exist.',
    body: 'All work delivered under your agency brand. We stay off the call, off the credentials deck and off the LinkedIn announcement. The client experience is yours, end to end.',
  },
  {
    label: 'Agency standards',
    title: 'We follow your processes, timelines and quality bars.',
    body: 'Existing brand guidelines, asset specs and approval chains stay intact. The studio adapts to the way the agency already operates rather than asking the agency to adapt to it.',
  },
  {
    label: 'Client-ready delivery',
    title: 'Outputs that protect the agency reputation.',
    body: 'Every asset is reviewed by senior creatives before it leaves the studio. The work lands in client inboxes finished to the standard you would have hit with a full internal team.',
  },
  {
    label: 'Flexible capacity',
    title: 'Scale up for the campaign, scale down between.',
    body: 'Capacity flexes around your workload, not the other way around. Big launch month, big throughput; quiet month, no fixed cost. The studio is yours when you need it, and dormant when you do not.',
  },
];

const lanes = [
  {
    label: 'Images & visuals',
    heading: 'AIGC images and visuals.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A daylit visual studio frame with calibrated monitors showing brand variations in progress, prime-lens depth, warm shadow grade, generous negative space.',
    lead: 'Your dedicated visual production team. You brief, we deliver hundreds of on-brand variations across every format the client needs.',
    body: [
      "Hero campaign visuals, social media adaptations, product photography, localised content. Creative control and the client relationship stay with the agency. The execution lift comes from the studio.",
      'Useful where the campaign needs more variations than the agency can staff for, or where the timeline cuts the production window below what a traditional shoot can deliver.',
    ],
    tags: [
      'Hero campaign visuals', 'Social adaptations',
      'Product photography', 'Localised content',
      'Brand-guided variations', 'Format multiplication',
      'Senior QC pass',
    ],
  },
  {
    label: 'Video content',
    heading: 'AIGC video content.',
    image: '/Images/sb-hub.jpg',
    alt: 'A documentary-style frame of a video edit suite with a master TVC paused on the monitor and short-form cuts arranged in the timeline panel, warm window light, real-photography grade.',
    lead: 'Short-form social, product demos, campaign adaptations, all at agency speed and scale.',
    body: [
      'One TVC into fifty social variations, platform-specific cuts for global markets, region-by-region localisation with on-brand pacing and rhythm. The studio executes while the agency focuses on strategy and client growth.',
      'Useful for campaigns where the master film needs to stretch across formats, channels and markets without losing the line that made it work in the first place.',
    ],
    tags: [
      'Short-form social', 'Product demos',
      'Campaign adaptation', 'TVC to social',
      'Platform-specific cuts', 'Global localisation',
      'Brand-paced edit',
    ],
  },
];

const faqs = [
  {
    q: 'How does the white-label partnership actually work?',
    a: 'Your clients never know we exist. You handle all client communication, strategy and relationship management. We execute the production work and deliver finished assets directly to you, under the agency brand. Clients see only your agency and your processes.',
  },
  {
    q: 'What is the typical turnaround time for content production?',
    a: 'AIGC accelerates timelines dramatically. Simple visuals and social content: 24 to 48 hours. Complex campaigns with multiple formats: 3 to 5 days. Video: 5 to 7 days depending on length and complexity. Rush projects can often be accommodated with premium pricing.',
  },
  {
    q: 'How do you maintain our brand standards and creative quality?',
    a: 'We integrate your brand guidelines, design systems and quality standards into the AI models and the workflow. Every output goes through human creative review by 4A-trained team members. We become an extension of the creative department, not a replacement.',
  },
  {
    q: 'What types of content can you produce?',
    a: 'Visuals: product photography, lifestyle imagery, social graphics, advertising creative, campaign adaptations, localised content, commerce assets, banner formats. Video: social videos, product demos, TVC adaptations, brand films, animated content, multi-format campaigns and cultural localisations.',
  },
  {
    q: 'How does pricing work compared to traditional production?',
    a: 'AIGC eliminates most traditional costs: no talent fees, location rentals, prop purchases or extensive crew. Typically 60 to 80% cost reduction versus traditional production, while delivering more variations and faster turnaround.',
  },
  {
    q: 'Can you handle multiple clients and maintain confidentiality?',
    a: 'Yes. Each client relationship is fully siloed with dedicated team members, separate AI models when needed and strict confidentiality protocols. Competing accounts never overlap. Your competitors will not know you are using the same production partner.',
  },
  {
    q: 'What happens if our client does not like the initial output?',
    a: 'Revisions are built into the process. AIGC allows unlimited iteration at minimal cost, so we adjust direction, style or specific elements quickly. We work until both the agency and the client are completely satisfied.',
  },
  {
    q: 'How do you ensure content works across different markets and cultures?',
    a: 'The team includes local creative talent and cultural consultants. We adapt language, visual reference, colour psychology, cultural symbol and contextual detail to ensure authentic local relevance in each market the agency operates in.',
  },
  {
    q: 'What is required from our agency to get started?',
    a: 'Minimal onboarding: brand guidelines, examples of preferred creative styles and clear briefs for each project. We handle all technical setup, AI training and workflow integration. The agency focuses on what it does best: relationships and strategy.',
  },
  {
    q: 'How do we explain increased output capacity to our clients?',
    a: 'Most agencies position it as "expanded creative capabilities" or "enhanced production infrastructure". Clients see faster turnaround, more creative options and better cost efficiency. They do not need to know the technical detail behind it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="White-Label AI Content Production for Agencies | hubStudio"
  description="hubStudio's white-label AIGC production for creative agencies: unlimited visuals and video, 60 to 80% lower costs, fully invisible behind your agency brand."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Agencies
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Your AI-powered</span></span>
            <span class="line"><span class="line__i">content production</span></span>
            <span class="line"><span class="line__i serif">team.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            More content, lower costs, <em>zero overhead</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Clients want more content across more platforms than ever.
              Hiring more designers and editors is expensive, hard to scale
              and difficult to manage. The agency P&L breaks before the
              capacity catches up.
            </p>
            <p>
              We operate as an invisible production team behind the agency
              brand. You own the relationship, the strategy and the creative
              direction. We handle visuals, video and adaptations at AIGC
              speed, delivered under your name.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start a white-label brief</Button>
            <a class="ghost-link ghost-link--light" href="#promise">
              See the promise
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Behind your brand, end to end
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/agencies-hero.jpg"
          alt="A daylit agency production floor with two creative directors reviewing a wall of pinned campaign variations, prime-lens shallow focus, warm shadow grade, calibrated stations along the back."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Agency floor</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why partner</p>
            <h2 class="dh r" style="--d:.05s">
              Ten times the output<br />without ten times the <span class="serif">hiring</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            The volume the client wants no longer fits inside the team
            you can afford. White-label AIGC capacity is the only honest
            way to keep the margin and the quality at the same time.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="audience" id="promise">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Our white-label promise</p>
          <h2 class="dh r" style="--d:.05s">
            Your brand. <span class="serif">Our engine</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Four commitments shape every engagement. Together they define
            what white-label actually means when it is run inside an
            active studio rather than sold as a label on a deck.
          </p>
        </header>

        <div class="aud-grid">
          {
            promises.map((a, i) => (
              <article class="aud r" style={`--d:${i * 0.06}s`}>
                <p class="aud__label">
                  <span class="aud__tick"></span>
                  {a.label}
                </p>
                <h3 class="aud__title">{a.title}</h3>
                <p class="aud__body">{a.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cover" id="lanes">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What we do for the agency</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, both<br /><span class="serif">behind the curtain</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Visuals and video, both run under your agency brand, both
            paced to the campaign you are pitching rather than the team
            you can hire. The hand-off is invisible; the output is yours.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  Agency lane
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-hybrid.jpg"
                alt="A documentary frame of a hybrid creative-technical pair reviewing brand variations on a large monitor inside the hubStudio Shanghai floor, warm shadow grade."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">60 to 80%</span>
            <span class="source__stat-cap">Cost reduction versus traditional production</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            A production partner<br />built for <span class="serif">agency life</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            We have shipped under agency brands for global accounts inside
            the active hubStudio production floor. The methodology is
            proven on the studio's own client work first, then handed to
            partners as a white-label engine.
          </p>
          <p class="source__p r" style="--d:.16s">
            That positions the agency at the front of rapidly evolving AI
            capability while keeping the client relationship, the creative
            direction and the strategic narrative exactly where they
            belong, with the agency.
          </p>
          <p class="source__p r" style="--d:.22s">
            Clear responsibilities: agency owns strategy, client
            relationship and creative direction. Studio owns technical
            execution, content production, optimisation and delivery.
            Together we run a tight loop of feedback and performance
            review.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Fully siloed teams
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Senior creative QC
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              35+ markets shipped
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              NDA in place
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">campaign</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions account leads and producers ask before we begin.
            If yours is not below, put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start a white-label brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Build with us</p>
        <h2 class="end__title r" style="--d:.05s">
          Win the pitch.<br /><span class="serif">Ship the work</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send a current scope, an upcoming brief or just the volume gap
          you keep running into. A senior lead reads it inside two
          working days and replies with a phased plan, a cost shape and
          a recommendation on which lane to open first.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start a white-label brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See client work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }
  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }
  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fig { margin-top: 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .ghost-link { display: inline-flex; align-items: center; gap: 9px; font-size: var(--type-small); font-weight: 600; color: var(--text-ink); }
  .ghost-link svg { width: 19px; height: 19px; transition: transform 0.24s ease-out; }
  .ghost-link:hover svg { transform: translateX(5px); }
  .ghost-link--light { color: var(--text-on-dark); }
  .band { max-width: 720px; margin-bottom: clamp(40px, 5vw, 70px); display: grid; gap: 18px; }
  .band--split { max-width: none; grid-template-columns: 1fr; }
  @media (min-width: 880px) {
    .band--split { grid-template-columns: 1fr 0.82fr; align-items: end; gap: 18px 60px; }
    .band--split > div { display: grid; gap: 18px; }
  }
  .band__note { font-size: var(--type-lead); line-height: 1.5; color: var(--text-mute); }
  .band__note--light { color: rgba(240, 237, 233, 0.76); }
  .cbar { display: flex; height: 12px; }
  .cbar span { flex: 1; }
  .cbar--end { margin-top: clamp(60px, 8vw, 110px); }
  .hero { display: grid; background: var(--ink); color: var(--text-on-dark); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1fr; } }
  .hero__panel { position: relative; display: flex; align-items: center; padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px); overflow: clip; }
