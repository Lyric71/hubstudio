---
/**
 * AI Consulting  ·  /solutions/consulting
 *
 * Studio setup, integration and governance for brand and agency teams. The
 * tool the client's own team runs on is the hubStudio app (roles, daily
 * limits, Skills, Validation, Client space); the consulting is the process
 * and the rules around it. No private deployments, GPUs, SSO, API or
 * connectors are offered to clients: brand-trained models stay with the
 * studio. Copy deck: scratchpad cq/sol-consulting/final.md.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio retains
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import AppShot from '../../components/AppShot.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import { appShots } from '../../data/app-shots';
import type { AppShot as Shot } from '../../data/app-shots';
import { BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/solutions/consulting`;
const briefHref = `${BRIEF_URL}?way=studio-app`;

/* Calibration color bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Why it matters. Card content carries no ordinal numerals; the heading and
   visual order do the sequencing. */
const reasons = [
  {
    label: 'Operations',
    title: 'Keep your people. Change their tools.',
    body: 'We fit AI into the way your team already works. Your writers, designers and marketers stay in charge of the work. They get the hubStudio app and a clear process for using it.',
  },
  {
    label: 'Integration',
    title: 'Put AI inside the workflow you already run.',
    body: 'Pilots stall when the tool sits outside the brief, the review and the approval. We map your chain step by step and rebuild it in the app, so AI work goes through the same checks as everything else.',
  },
  {
    label: 'Governance',
    title: 'Know who made what, and who approved it.',
    body: 'Every render keeps its prompt and its engine. Every approval stays on one thread, version by version, and nothing on it can be deleted. That record is there when legal or a client asks for it.',
  },
];

/* The four parts of an engagement. A lane shows either a real app capture
   (shot + path) or a studio photograph (image + alt). The chip list replaces
   numbered sub-headings, per the no-numbers rule. */
type Lane = {
  label: string;
  heading: string;
  lead: string;
  body: string[];
  tags: string[];
  shot?: Shot;
  path?: string;
  caption?: string;
  image?: string;
  alt?: string;
  link?: { pre: string; label: string; href: string };
};

const lanes: Lane[] = [
  {
    label: 'Team setup',
    heading: 'The team, the roles and the limits.',
    shot: appShots.teamClients,
    path: '/team',
    caption: 'Your team, Clients: add a client company and give its people a login.',
    lead: 'We set up hubStudio for your team, person by person.',
    body: [
      'First, who creates, who reviews and who only watches. The app has four roles for that: Admin, Creator, Viewer and Client. Admins send the invitations and can switch modules on or off for each person.',
      'The team shares one prepaid balance. An admin can set a daily spending limit for each creator, and each run shows its price before it starts. If you make work for clients, we add them too and give their people a login. They see a Client space with only the finished work made for them, and nothing else.',
    ],
    tags: [
      'Roles and permissions', 'Daily limit per creator',
      'Modules per person', 'Shared team balance',
      'Client logins', 'Invitations and join requests',
    ],
  },
  {
    label: 'House rules',
    heading: 'Brand rules the AI follows every time.',
    shot: appShots.skillsCatalog,
    path: '/skills/catalog',
    caption: 'The Skills Catalog: ready-made rules to start from.',
    lead: 'Your house rules, written once as Skills, instead of pasted into every prompt.',
    body: [
      'A skill is a set of instructions the AI follows. In hubStudio, skills shape “Improve with AI,” which rewrites a prompt for the engine you picked, and they shape every social post drafted with AI.',
      'Admins write Team skills that apply to everyone. Your admins write them with us: how a packshot is framed, the look of your pictures, the words you never use, the posting format for each network. The Catalog gives us a starting point for each one.',
    ],
    tags: [
      'Team skills', 'Brand look and framing',
      'Words to avoid', 'Posting format per network',
      'Improve with AI', 'Catalog starting points',
    ],
  },
  {
    label: 'Approvals',
    heading: 'An approval chain with a permanent record.',
    shot: appShots.validation,
    path: '/validation',
    caption: 'Validation before the first request: Waiting for me, My requests and All assets.',
    lead: 'Whatever your review steps are today, they move into Validation.',
    body: [
      'In Validation, anyone can send an image, a video, a post, a file, a text or a link to a teammate or a client for approval. The validator approves it or sends it back with a comment. Each new version joins the same thread, and a post waiting for approval is locked.',
      'History keeps every render made by the team, with its prompt and engine, and the Assets Library holds the finished files in folders, with tags and versions. We help you write the policy that sits around the tools: what needs approval, who signs off, when legal sees it and how AI use is disclosed.',
    ],
    tags: [
      'Validation flow', 'Versions on one thread',
      'Client approvals', 'History and prompts',
      'Disclosure policy', 'Sign-off rules',
    ],
  },
  {
    label: 'Rollout',
    heading: 'A rollout plan your team can keep running.',
    image: '/Images/app-desk.webp',
    alt: 'A small in-house team gathered around a laptop at a shared desk, reviewing a set of generated product pictures.',
    lead: 'We start from the work you ship today and pick where AI helps first.',
    body: [
      'We pick the jobs where AI earns its place and choose an engine for each one from the app’s Explore gallery. Then we run a pilot on real briefs, with your people doing the work and our lead in the room.',
      'Some jobs shouldn’t go near AI at all, and we’ll name them. Others are better sent to a studio. When a job needs our art directors, they can join your hubStudio team as members and work from your workspace. What they make stays with you.',
    ],
    link: { pre: 'Training usually runs alongside the rollout.', label: 'See AI training', href: '/solutions/training' },
    tags: [
      'Content audit', 'Pilot on real briefs',
      'Engine choice per job', 'Team training',
      'Rollout review', 'In-house or studio',
    ],
  },
];

const faqs: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'How long does a setup take?',
    a: 'That depends on how many people and how many workflows are involved. Opening the accounts is the quick part, and it costs nothing. The process, the skills and the approval chain take longer, and your proposal gives the schedule. A producer reads your brief within one business day, and a written proposal follows within 48 hours.',
  },
  {
    q: 'Is there a minimum team size?',
    a: 'No. We work with small in-house teams and with large creative departments. A very small team often gets more from using the app directly, or from our production services, than from a consulting project. We’ll say so before we quote anything.',
  },
  {
    q: 'Which tools do you set us up on?',
    a: 'The hubStudio app. It gathers image and video engines from OpenAI, Google, Black Forest Labs, ByteDance, Kling, Alibaba, xAI, MiniMax and Meta, with more added as they ship. We pick engines job by job; no single one is best at everything. There’s no subscription and no seat fee: the team pays for what it runs from a prepaid balance.',
  },
  {
    q: 'Do you install anything on our servers or train a private model for us?',
    a: 'No. Your team works in the hubStudio app, in a browser. We don’t set up private servers, GPUs, connectors or an API for clients. When a project calls for a brand-trained model, our studio runs it on its own pipelines and delivers the finished work to you.',
  },
  {
    q: 'Can the app follow our existing approval chain?',
    a: 'Yes. Validation lets you name who approves each piece, a teammate or someone at a client. We map your current steps to it before anyone makes a thing.',
  },
  {
    q: 'How do we keep the work on brand?',
    a: 'Team skills carry your rules into every AI rewrite and draft, and Validation puts a person between the render and the channel. And if you want a second pair of eyes, our lead can review the early output with you.',
  },
  {
    q: 'How do we control what the team spends?',
    a: 'The team shares one prepaid balance. Each run shows its price before it starts, a failed run is never charged, and an admin can set a daily limit for each creator. Every top-up comes with an invoice. Consulting is priced per project or on retainer and quoted after we read your brief; we don’t publish rates. Creating the team’s account costs nothing.',
  },
  {
    q: 'Do you support us after the setup?',
    a: 'Yes, when you want it. A retainer covers the upkeep: updating your skills as engines change, adding people, training newcomers. Some teams keep the studio on call for the jobs they’d rather not do in-house.',
  },
  {
    q: 'Do you train the team?',
    a: 'Yes. Our training runs as cohorts in the Shanghai studio, in English or Mandarin, and can run on the app so the team leaves with a working setup. The app’s interface is in English; its sign-in page speaks English, French and Chinese.',
    link: { label: 'See AI training', href: '/solutions/training' },
  },
  {
    q: 'Can your studio work inside our hubStudio team?',
    a: 'Yes. You add our creatives as members. They create from your workspace and your balance, your admins approve in Validation, and everything stays in your History and Assets Library when the project ends.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'AI consulting', item: pageUrl },
  ],
};
---

<Layout
  title="AI Consulting for Creative Teams | hubStudio"
  description="AI consulting for brand and agency teams: roles, house rules, approvals and a rollout plan, set up on the hubStudio app by senior studio leads."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> AI consulting
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Set up an AI</span></span>
            <span class="line"><span class="line__i">studio your team</span></span>
            <span class="line"><span class="line__i">can <span class="serif">run.</span></span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Setup, integration and governance from a studio that <em>produces every day</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most brands start the same way. Someone buys access to an image
              model, runs a pilot and gets a few good pictures. Then it
              stalls, because nobody decided who approves the work or where
              the brand rules are written down.
            </p>
            <p>
              We help your team make AI part of the weekly work. We set up the
              process, write the rules with you and build the approval chain.
              The tool your team runs it on is the hubStudio app.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={briefHref}>Send a consulting brief</Button>
            <a class="ghost-link ghost-link--light" href="#expertise">
              See the four parts
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong headquarters <span>/</span> studios in Shanghai and Changsha
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/who-we-are-studio.jpg"
          alt="A daylit hubStudio creative floor with workstations, calibrated monitors and a wall of printed proofs pinned for review."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Studio floor</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              A tool is not<br />a <span class="serif">routine</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Buying a tool is the easy part. The hard part is the routine: who
            makes the work, who checks it, which rules it follows and where
            it&rsquo;s kept.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE SET UP ============ -->
    <section class="cover" id="expertise">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>What we set up</p>
          <h2 class="dh r" style="--d:.05s">
            Four parts, one <span class="serif">routine</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Most teams need all four. Some start with one and add the rest as
            the work grows. The same senior lead runs the engagement from the
            first call to the last review. If you only have time for one
            part, read the approvals.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              {c.shot ? (
                <div class="feature__media feature__media--shot r">
                  <AppShot shot={c.shot} path={c.path} caption={c.caption} />
                </div>
              ) : (
                <figure class="feature__media crop r-clip">
                  <div class="crop__inner">
                    <img src={c.image} alt={c.alt} width="1024" height="820" loading="lazy" />
                  </div>
                  <figcaption class="fig">{c.label}</figcaption>
                </figure>
              )}
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__lead r" style="--d:.1s">{c.lead}</p>
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                {c.link && (
                  <p class="feature__p r" style="--d:.2s">
                    {c.link.pre} <a class="inline-link" href={c.link.href}>{c.link.label}</a>.
                  </p>
                )}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/studio-on-app.webp"
                alt="A hubStudio producer at a desk on a video call, a brief and a laptop open in front of her."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">One company</span>
            <span class="source__stat-cap">The app and the studio, under one roof</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Advice from a studio<br />that <span class="serif">ships</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            AI consulting usually comes from one side. Either the adviser
            knows the software and has never shipped a campaign, or knows
            campaigns and has never run the software.
          </p>
          <p class="source__p r" style="--d:.16s">
            We have both. Our studio makes images, video and social content
            with AI every day, and the app your team would use is ours too.
            So the advice comes from people who do the work.
          </p>
          <p class="source__p r" style="--d:.22s">
            We don&rsquo;t install software on your servers or build a private
            model setup for you. Your team works in the hubStudio app, in a
            browser. When a project needs a brand-trained model, our studio
            runs it on its own pipelines and sends you the finished files.
          </p>
          <p class="source__p r" style="--d:.26s">
            hubStudio was founded by Cyril Drouin, a former CEO at Publicis.
            Our case studies are on the <a class="inline-link inline-link--light" href="/work">Work page</a>.
          </p>
          <ul class="creds r" style="--d:.3s">
            {
              ['Senior lead on every project', 'The app and the studio', 'NDA in place', 'Hong Kong, Shanghai, Changsha'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ S5 · WAYS TO WORK ============ -->
    <WaysToWork tone="white" highlight="studio-app" />

    <!-- ============ S6 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions teams ask before we start. If yours isn&rsquo;t here,
            put it in the brief.
          </p>
          <p class="faq__fresh r" style="--d:.13s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={briefHref}>Send a consulting brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.a}
                      {faq.link && (
                        <>
                          {' '}
                          <a class="inline-link" href={faq.link.href}>{faq.link.label}</a>.
                        </>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S7 · CLOSING ============ -->
    <DualCta
      eyebrow="Start small"
      pre="Bring us the "
      accent="question"
      post="."
      text="Send a brief, a note on how your team works today, or just the question that led you here. You’ll get a scope, a plan and a straight answer on whether you need consulting at all. Or open an account and try the app first."
      lead="studio"
      briefQuery="way=studio-app"
    />
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
