---
/**
 * hubStudio for brands  ·  /solutions/brands
 *
 * In-house brand teams do two jobs every week: creative assets (text, images,
 * and video) and social networks (posts, campaigns, publishing, paid social,
 * and executive advocacy). This page explains how both parts of the job run in
 * the hubStudio app on their own ("Use the app") and with our creative and
 * social teams working inside the same workspace ("Work with us in the app").
 *
 * Keeps the print-shop frame of the solutions pages (calibration bars, crop
 * marks, editorial display headings) and the brands insights layer, which is
 * permanent (see CLAUDE.md, insights distribution).
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import InsightsLayer from '../../components/InsightsLayer.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* The brand team's week across both pillars and approvals. No ordinals. */
const reasons = [
  {
    label: 'Creative assets',
    title: 'Launches and product visuals still need an art director’s eye.',
    body: 'Off-the-shelf AI output looks like everyone else’s, and a product’s shape, label, or color drifts from one shot to the next.',
  },
  {
    label: 'Social networks',
    title: 'Every channel wants its own format, cadence, and voice.',
    body: 'One campaign turns into LinkedIn carousels, Instagram Reels, TikTok scripts, paid social variants, and regional posts across Western and Chinese feeds.',
  },
  {
    label: 'Sign-off',
    title: 'Approvals scatter across email and chat.',
    body: 'Visuals sit in a shared drive while post copy sits in a spreadsheet. Six weeks later, nobody can show who signed off on which version.',
  },
];

/* Categories we see most with brand teams, covering both assets and social. */
const lanes = [
  {
    label: 'Fashion',
    heading: 'Lookbooks, seasonal drops, and daily social feeds.',
    image: '/Images/hub4fashion.jpg',
    alt: 'A daylit fashion editorial frame with a model in a sculpted coat against a warm-grey wall, prime-lens shallow focus, soft window light from camera left.',
    body: 'We keep fit, fabric, and color true from the lookbook and ecommerce listings down to the weekly Instagram Reels, TikTok clips, and RedNote notes.',
  },
  {
    label: 'Automotive',
    heading: 'Regional launch visuals and local social calendars, without shipping a car.',
    image: '/Images/md-launch.jpg',
    alt: 'A wide cinematic vehicle frame on a quiet coastal road at the end of the afternoon, single low-angle sun source, warm shadow grade, restrained negative space for headline copy.',
    body: 'We build the road and the weather around the vehicle for each market, then cut vertical videos, carousels, and paid social ads for local feeds.',
    caseStudy: { label: 'A premium SUV, shown without shipping a car', href: '/work/premium-suv' },
  },
  {
    label: 'Electronics',
    heading: 'Launch films, product explainers, and short-form social video.',
    image: '/Images/md-saas.jpg',
    alt: 'A clean tech product still life on a matte-grey surface, single softbox from camera right, lifted black point, subtle film grain on the highlights.',
    body: 'We turn a spec sheet into scenes a buyer understands, from the keynote launch film down to YouTube Shorts, TikTok demos, and LinkedIn posts.',
    caseStudy: { label: 'A global AI wearable launch for iFlytek', href: '/work/iflytek-anypin' },
  },
  {
    label: 'Food and drink',
    heading: 'Appetite visuals, seasonal refreshes, and always-on social.',
    image: '/Images/md-ooh.jpg',
    alt: 'A close food editorial frame, ingredients with imperfect surfaces, hard side light raking across texture, warm shadow grade.',
    body: 'We light bottles and ingredients for texture, restage them when the season turns, and keep Instagram, Facebook, and paid social stocked.',
    caseStudy: { label: 'A gin launch built from zero assets', href: '/work/1834-gin' },
  },
  {
    label: 'B2B',
    heading: 'Decks, case-study visuals, LinkedIn pages, and executive posts.',
    image: '/Images/hub4presentation.jpg',
    alt: 'A small client workshop in a sunlit meeting room with a printed campaign roadmap on the wall and three people discussing a phase, documentary in-studio register.',
    body: 'Your sales deck, trade-show visuals, company LinkedIn page, and leadership posts all read like one company made them.',
  },
];

const faqs = [
  {
    q: 'How do brand teams split the work between the app and your team?',
    a: 'Most run both. Your marketers use the app for daily visuals, resizes, and scheduled social posts. When you have a campaign launch or want full management of your social pages and paid ads, our creative and social teams work with you inside the same hubStudio workspace.',
  },
  {
    q: 'Does hubStudio cover both creative production and social network management?',
    a: 'Yes. Those are the two pillars of hubStudio. On the creative side, the app gives you image and video AI engines and free browser editors, while our studio runs twenty creative service lines. On the social side, the app handles Campaigns and publishing to LinkedIn, Instagram, Facebook, TikTok (Beta), X, and YouTube, while our team manages weekly calendars, paid social ads, executive posts, and Chinese networks (WeChat, RedNote, Douyin, and Weibo).',
  },
  {
    q: 'Does the app learn our brand voice and visual style?',
    a: 'In the app, your admins write Team skills that shape every AI prompt rewrite and social post draft so the tone and framing stay consistent. When a campaign needs a brand-trained visual model, our studio trains and runs it on our own GPU pipelines.',
  },
  {
    q: 'How do approvals work for assets and social posts?',
    a: 'In Validation. You or our team send an image, a video, a social post, a file, or a link to your marketing lead, legal, or a regional manager. They approve it or send it back with a comment. Every version stays on one permanent thread, and a social post waiting for approval is locked until someone signs off.',
  },
  {
    q: 'What does it cost?',
    a: 'The app runs on a prepaid balance in real currency. You see the price before every run, a failed run is never charged, there are no subscriptions or seat fees, and the balance never expires. You top up by card, Alipay, or WeChat Pay and get an invoice every time. Our services are priced per asset, per project, or on retainer, quoted in writing within 48 hours of your brief.',
  },
  {
    q: 'Can you manage our social channels in both Western and Chinese markets?',
    a: 'Yes. Inside the app, your team or ours can draft and schedule posts across LinkedIn, Instagram, Facebook, TikTok (Beta), X, and YouTube. For China, our social team manages WeChat Official Accounts and Channels, RedNote, Douyin, and Weibo, with every asset and post reviewed in hubStudio.',
  },
  {
    q: 'Can the app start from our own product photos and campaign briefs?',
    a: 'Yes. In the Image studio, choose Edit an image and drop in up to four product photos on supported engines. In Campaigns, upload up to 20 brief or product documents so Draft with AI writes social posts directly from your facts.',
  },
  {
    q: 'How quickly can your team start on a brief?',
    a: 'A producer reads every brief within one business day and sends a written proposal within 48 hours.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Brands', item: `${SITE}/solutions/brands` },
  ],
};
---

<Layout
  title="hubStudio for brands: creative assets & social networks"
  description="In-house brand teams create visuals and video and run social networks in the hubStudio app, or work with our creative and social teams inside it."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Brands
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Creative assets</span></span>
            <span class="line"><span class="line__i">and social networks,</span></span>
            <span class="line"><span class="line__i">in one <span class="serif">workspace.</span></span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Use the app on your own, or work with our team <em>inside it</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A brand team does two jobs every week. It makes creative assets:
              product visuals, launch films, campaign key visuals, and decks.
              And it runs social networks: weekly posts, Reels, carousels, paid
              social ads, and executive pages.
            </p>
            <p>
              hubStudio puts both in one place. Your marketers generate assets
              and schedule posts in the app. When a launch lands or you want
              full channel management, our art directors and social managers
              work with you inside the same workspace.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
            <a class="ghost-link ghost-link--light" href={`${BRIEF_URL}?way=studio-app`}>
              Send a brief
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Creative assets <span>/</span> Social networks <span>/</span> Approvals on record
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/brands-hero.jpg"
          alt="A daylit hubStudio creative floor with a single model under window light from camera left, calibrated monitors in the background and printed brand variations pinned along the wall for review."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Brand team <span>/</span> Review wall</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The brand team’s week</p>
            <h2 class="dh r" style="--d:.05s">
              Two jobs at once,<br />and the same <span class="serif">team</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Brand teams are asked to ship campaign-grade assets and feed every
            social channel at the same time. Three things usually break first.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ TWO PILLARS: CREATIVE ASSETS & SOCIAL NETWORKS ============ -->
    <section class="fit" id="app-and-studio">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Two pillars, one workspace</p>
          <h2 class="dh r" style="--d:.05s">
            The assets and the channels,<br />under one <span class="serif">roof</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Both parts of a brand team’s job run inside hubStudio. Your team
            handles the daily flow in the app, and our creative and social
            teams step into the same workspace whenever you want extra hands.
          </p>
        </header>

        <article class="fit__row">
          <div class="fit__media r">
            <AppShot shot={appShots.imageStudio} path="/content/image-generate" caption />
          </div>
          <div class="fit__body">
            <p class="kicker r"><span class="kicker__tick"></span>Pillar · Creative assets</p>
            <h2 class="dh dh--sm r" style="--d:.05s">Text, images, and video that stay on <span class="serif">brand</span>.</h2>
            <p class="fit__p r" style="--d:.1s">
              <strong>In the app:</strong> Your team picks an image or video
              engine in Explore from OpenAI, Google, Black Forest Labs,
              ByteDance, or Kling, sees the price first, and renders up to 4K.
              The free browser Image editor crops to each network’s safe zones
              and places your logo; the Video editor and Shorts autopilot cut
              and caption vertical clips.
            </p>
            <p class="fit__p r" style="--d:.14s">
              <strong>With our team:</strong> For a launch or a seasonal
              campaign, send us a brief. A senior art director leads the work
              across twenty studio service lines, running brand-trained models
              on our own GPU pipelines and mixing live shoots with AI asset by
              asset.
            </p>
            <p class="fit__links r" style="--d:.18s">
              <a class="ghost-link" href="/app/create">
                How creation works in the app
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a class="ghost-link" href="/studio">
                See the twenty creative services
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a class="ghost-link" href="/work/elizabeth-gage">
                The Elizabeth Gage campaign
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </p>
          </div>
        </article>

        <article class="fit__row fit__row--rev">
          <div class="fit__media r">
            <AppShot shot={appShots.linkedin} path="/social/linkedin/posts" caption />
          </div>
          <div class="fit__body">
            <p class="kicker r"><span class="kicker__tick"></span>Pillar · Social networks</p>
            <h2 class="dh dh--sm r" style="--d:.05s">Posts, campaigns, paid social, and executive <span class="serif">voices</span>.</h2>
            <p class="fit__p r" style="--d:.1s">
              <strong>In the app:</strong> Group a launch’s visuals, clips, and
              up to 20 brief documents in a Campaign, then draft and schedule
              posts to LinkedIn, Instagram, Facebook, TikTok (Beta), X, and
              YouTube. Re-purpose one post across the other networks in a
              click, while Team skills keep the copy in your voice and the
              Social publishing watcher agent flags quiet channels.
            </p>
            <p class="fit__p r" style="--d:.14s">
              <strong>With our team:</strong> Our social strategists, editors,
              and media buyers can run your channels inside hubStudio. We
              manage your monthly calendar and weekly posts, run paid social
              campaigns and creative testing on your ad accounts, ghostwrite
              for executives, and operate your Chinese presence on WeChat,
              RedNote, Douyin, and Weibo.
            </p>
            <p class="fit__links r" style="--d:.18s">
              <a class="ghost-link" href="/app/publish">
                Social publishing in the app
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a class="ghost-link" href="/#social-services">
                Our social network services
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- ============ TWO WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="studio-app"
      pre="Pick the way that fits the "
      accent="job"
      post="."
      lead="Most brand teams use both across the year: the app for daily visuals and scheduled posts, and our team inside the app for campaign launches, social page management, and paid social."
    />

    <!-- ============ WORK WITH US IN THE APP: APPROVALS ON RECORD ============ -->
    <section class="record" id="approvals">
      <div class="shell record__grid">
        <div class="record__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Work with us in the app</p>
          <h2 class="dh r" style="--d:.05s">
            Who approved which asset and post, and <span class="serif">when</span>.
          </h2>
          <p class="record__p r" style="--d:.1s">
            When you work with us in the app, our creatives and social managers
            produce the visuals and draft the posts inside hubStudio. Your
            marketing lead reviews each piece in Validation, and so can legal
            or a regional director. Each person validates it or sends it back
            with a comment.
          </p>
          <p class="record__p r" style="--d:.14s">
            Every revision lands on the same thread as the last one, and
            nothing on that thread can be deleted. A social post waiting for
            approval is locked so it cannot go out early. When someone asks who
            signed off on the spring key visual or Tuesday’s LinkedIn post, you
            open the thread and look.
          </p>
          <p class="record__p r" style="--d:.18s">
            We can work in our workspace and give your people free client
            logins, so they see only the finished assets and scheduled posts
            made for them. Or we join your workspace as members, work from your
            balance, and leave every render, file, and post in your History,
            Assets Library, and publishing queue.
          </p>
          <p class="r" style="--d:.22s">
            <a class="ghost-link ghost-link--light" href="/studio/with-the-app">
              How working with us in the app runs
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
        <div class="record__media r" style="--d:.1s">
          <AppShot shot={appShots.validation} path="/validation" caption dark />
        </div>
      </div>
    </section>

    <!-- ============ CATEGORIES ============ -->
    <section class="cover" id="categories">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Categories</p>
          <h2 class="dh r" style="--d:.05s">
            Five categories we know <span class="serif">well</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            One detour before the questions. These five categories come up most
            with brand teams across both creative production and social
            management: a fashion label might schedule daily Reels in the app
            and bring our team in for the seasonal lookbook and paid social.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="820" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
                {c.caseStudy && (
                  <p class="feature__case r" style="--d:.16s">
                    <a class="ghost-link" href={c.caseStudy.href}>
                      {c.caseStudy.label}
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/hubstudio-shanghai-studio.webp"
                alt="A wide view of the hubStudio Shanghai floor with editorial daylight, calibrated stations and brand-variation proofs pinned along the back wall."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48 hours</span>
            <span class="source__stat-cap">A written proposal after your brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Creative direction and social execution, under one <span class="serif">roof</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Senior art directors lead every creative brief, and seasoned social
            strategists and editors run your channels alongside them.
          </p>
          <p class="source__p r" style="--d:.16s">
            The same company builds the app your marketers use and runs the
            team that produces your campaigns and social calendars. Moving work
            between your in-house team and ours never means switching tools or
            rebuilding your approval chain.
          </p>
          <p class="source__p r" style="--d:.2s">
            We record the provenance of every asset, so you always know what
            was shot, what was generated, and what was retouched. Founded by
            Cyril Drouin, former CEO at Publicis, hubStudio is headquartered in
            Hong Kong, with studios in Shanghai and Changsha, a team in the
            Philippines, and an office in Paris.
          </p>
          <ul class="creds r" style="--d:.26s">
            {
              ['Senior art directors', 'Brand-trained models', 'Western & Chinese networks', 'Provenance per asset'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">brief</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What brand teams ask us first about assets, social channels, and
            approvals. If yours isn’t here, put it in the brief.
          </p>
          <p class="faq__updated r" style="--d:.12s">Updated October 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
