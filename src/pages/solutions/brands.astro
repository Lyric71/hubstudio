---
/**
 * hubStudio for brands  ·  /solutions/brands
 *
 * In-house brand teams: the app for the daily run, the studio for campaigns,
 * and Studio + app when they want both with every approval on record. The
 * page highlights Studio + app in the three ways band and closes with the
 * studio door first. Copy from the content-quality-us deck (cq/sol-brands).
 *
 * Keeps the print-shop frame of the solutions pages (calibration bars, crop
 * marks, editorial display headings) and the brands insights layer, which is
 * permanent (see CLAUDE.md, insights distribution).
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import InsightsLayer from '../../components/InsightsLayer.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* The brand team's week: three problems. No ordinals; the labels carry them. */
const reasons = [
  {
    label: 'Volume',
    title: 'Every network wants its own shape.',
    body: 'One campaign visual becomes a square, a Story, a banner, and a LinkedIn post. The resizing and rewriting eats the week.',
  },
  {
    label: 'Craft',
    title: 'A launch still needs an art director’s eye.',
    body: 'Off-the-shelf AI output looks like everyone else’s, and the product’s shape or color drifts from one shot to the next.',
  },
  {
    label: 'Sign-off',
    title: 'Approvals scatter across email and chat.',
    body: 'Six weeks later, nobody can say who signed off on which version.',
  },
];

/* Categories the studio sees most with brand teams. Images kept from the
   previous page; each lane is prose now, with a case link where one exists. */
const lanes = [
  {
    label: 'Fashion',
    heading: 'Lookbooks, drops, and seasonal campaigns.',
    image: '/Images/hub4fashion.jpg',
    alt: 'A daylit fashion editorial frame with a model in a sculpted coat against a warm-grey wall, prime-lens shallow focus, soft window light from camera left.',
    body: 'We keep fit, fabric, and color true from the first frame to the last, whether it ends up on a billboard or a product page.',
  },
  {
    label: 'Automotive',
    heading: 'The vehicle in context, without shipping it anywhere.',
    image: '/Images/md-launch.jpg',
    alt: 'A wide cinematic vehicle frame on a quiet coastal road at the end of the afternoon, single low-angle sun source, warm shadow grade, restrained negative space for headline copy.',
    body: 'We build the road and the weather around the car, market by market.',
    caseStudy: { label: 'A premium SUV, shown without shipping a car', href: '/work/premium-suv' },
  },
  {
    label: 'Electronics',
    heading: 'Launch films and product explainers.',
    image: '/Images/md-saas.jpg',
    alt: 'A clean tech product still life on a matte-grey surface, single softbox from camera right, lifted black point, subtle film grain on the highlights.',
    body: 'They turn a spec sheet into something a buyer understands. The feature list becomes a scene someone can picture at home.',
    caseStudy: { label: 'A global AI wearable launch for iFlytek', href: '/work/iflytek-anypin' },
  },
  {
    label: 'Food and drink',
    heading: 'Appetite, texture, and season.',
    image: '/Images/md-ooh.jpg',
    alt: 'A close food editorial frame, ingredients with imperfect surfaces, hard side light raking across texture, warm shadow grade.',
    body: 'We light food for texture and restage it when the menu changes.',
    caseStudy: { label: 'A gin launch built from zero assets', href: '/work/1834-gin' },
  },
  {
    label: 'B2B',
    heading: 'Decks, case-study visuals, and sales material in one voice.',
    image: '/Images/hub4presentation.jpg',
    alt: 'A small client workshop in a sunlit meeting room with a printed campaign roadmap on the wall and three people discussing a phase, documentary in-studio register.',
    body: 'The deck and the trade-show panel end up looking like one company made them.',
  },
];

const faqs = [
  {
    q: 'Should our team use the app or the studio?',
    a: 'Usually both. The daily content runs in the app, and the studio takes launches and seasonal campaigns. If you want the two joined up, Studio + app puts our creatives inside hubStudio and your people approve there.',
  },
  {
    q: 'Does the app learn our brand?',
    a: 'Not the way a trained model does. In the app, Team skills written by your admins shape the AI’s post drafts and prompt rewrites. Brand-trained models are studio work: our team trains them and runs them on the studio’s own pipelines.',
  },
  {
    q: 'How do approvals work?',
    a: 'In Validation. You send an image, a video, a post, a file, or a link to a colleague or a client, and they approve it or send it back with a comment. Versions stay on one thread, and nothing on that thread can be deleted.',
  },
  {
    q: 'What does it cost?',
    a: 'The app runs on a prepaid balance in real currency. You see the price before every run, a failed run is never charged, there are no seat fees, and the balance doesn’t expire. You top up by card, Alipay, or WeChat Pay and get an invoice every time. The studio is priced per asset, per project, or on retainer, and quoted after a brief.',
  },
  {
    q: 'Can we start with the studio and move to the app later?',
    a: 'Yes. If we worked in your workspace, the files are already in your History and Assets Library. If we worked in ours, you download the finished work and carry on in your own account.',
  },
  {
    q: 'Who sees our work?',
    a: 'In the app, your team and the people you invite. A client login sees only what was made for its company, never a prompt, an engine, or a cost. Brand-trained models are run by the studio team on its own GPU pipelines.',
  },
  {
    q: 'Can the app start from our own product photos?',
    a: 'Yes. In the Image studio, choose Edit an image and drop in your product photo; some engines take up to four at once. Keep the originals in the Assets Library. For a hero campaign, the studio can shoot new ones.',
  },
  {
    q: 'How quickly can the studio start?',
    a: 'A producer reads every brief within one business day and sends a written proposal within 48 hours.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Brands', item: `${SITE}/solutions/brands` },
  ],
};
---

<Layout
  title="hubStudio for brands: daily content, campaigns, approvals"
  description="In-house brand teams use the hubStudio app for daily content and our studio for campaigns, with every approval kept on one record."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Brands
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Daily content in</span></span>
            <span class="line"><span class="line__i">the app. Campaigns</span></span>
            <span class="line"><span class="line__i">from the <span class="serif">studio.</span></span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Or both, with every approval <em>on record</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A brand team does two kinds of work. The daily run: posts,
              resizes, product variants for this week’s promotion. And the
              campaign, where the brand has to look its best.
            </p>
            <p>
              hubStudio covers both. Your team makes the daily work in the
              app. Our studio makes the campaign, led by a senior art
              director, and if we work inside the app your people review it
              all in one place.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</Button>
            <a class="ghost-link ghost-link--light" href={APP_SIGNUP} rel="noopener">
              Create your account
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong HQ <span>/</span> Studios in Shanghai and Changsha <span>/</span> Paris office
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/brands-hero.jpg"
          alt="A daylit hubStudio creative floor with a single model under window light from camera left, calibrated monitors in the background and printed brand variations pinned along the wall for review."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Brand team <span>/</span> Review wall</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The brand team’s week</p>
            <h2 class="dh r" style="--d:.05s">
              More channels to fill,<br />and the same <span class="serif">team</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Channels multiplied faster than headcount. Most brand teams we
            meet run into the same three problems.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ THE APP AND THE STUDIO ============ -->
    <section class="fit" id="app-and-studio">
      <div class="shell">
        <article class="fit__row">
          <div class="fit__media r">
            <AppShot shot={appShots.linkedin} path="/social/linkedin/posts" caption />
          </div>
          <div class="fit__body">
            <p class="kicker r"><span class="kicker__tick"></span>Use the app</p>
            <h2 class="dh dh--sm r" style="--d:.05s">The daily run, in your team’s <span class="serif">hands</span>.</h2>
            <p class="fit__p r" style="--d:.1s">
              Your team picks an engine in Explore, sees the price, and runs
              it. Need the product in a spring scene for Friday’s post?
              That’s a few minutes of work, and nobody books a photographer.
            </p>
            <p class="fit__p r" style="--d:.14s">
              The Image editor crops to each network’s format and adds your
              logo. Posts go to LinkedIn, Instagram, Facebook, TikTok (Beta),
              and X, now or on a schedule. Team skills, written by your
              admins, shape the AI’s post drafts and prompt rewrites, so the
              tone stays yours.
            </p>
            <p class="fit__links r" style="--d:.18s">
              <a class="ghost-link" href="/app">
                See what the app does
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </p>
          </div>
        </article>

        <article class="fit__row fit__row--rev">
          <figure class="fit__media crop r-clip">
            <div class="crop__inner fit__photo">
              <img
                src="/Images/studio-hero.webp"
                alt="An art director marks a pinned proof with a red pencil while a colleague holds another print, in front of a wall of campaign prints at the hubStudio studio."
                width="2000"
                height="1333"
                loading="lazy"
              />
            </div>
            <figcaption class="fig">The studio <span>/</span> Proof wall</figcaption>
          </figure>
          <div class="fit__body">
            <p class="kicker r"><span class="kicker__tick"></span>Studio only</p>
            <h2 class="dh dh--sm r" style="--d:.05s">Campaigns that stay on brand, shot after <span class="serif">shot</span>.</h2>
            <p class="fit__p r" style="--d:.1s">
              For a launch or a seasonal campaign, send us a brief. A senior
              art director leads it from the first frame to the last file.
            </p>
            <p class="fit__p r" style="--d:.14s">
              Our team trains models on your brand and runs them on the
              studio’s own GPU pipelines. That’s what keeps a product, a face,
              or a palette the same across a whole campaign. Some pictures
              are shot, some generated, and most mix both, decided asset by
              asset.
            </p>
            <p class="fit__links r" style="--d:.18s">
              <a class="ghost-link" href="/work/elizabeth-gage">
                The content we made for Elizabeth Gage, a heritage London jeweler
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a class="ghost-link" href="/studio">
                Meet the studio
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- ============ THREE WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="studio-app"
      pre="Pick the way that fits the "
      accent="job"
      post="."
      lead="Plenty of brand teams use all three in a year: the daily run in the app, a launch from the studio, and a steady retainer where we work inside hubStudio and your people approve there."
    />

    <!-- ============ STUDIO + APP: APPROVALS ON RECORD ============ -->
    <section class="record" id="approvals">
      <div class="shell record__grid">
        <div class="record__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Studio + app</p>
          <h2 class="dh r" style="--d:.05s">
            Who approved what,<br />and <span class="serif">when</span>.
          </h2>
          <p class="record__p r" style="--d:.1s">
            With Studio + app, our creatives make the work inside hubStudio.
            Your marketing lead reviews it in Validation, and so can legal or
            the regional team. Each person approves it or sends it back with
            a comment.
          </p>
          <p class="record__p r" style="--d:.14s">
            A new version lands on the same thread as the last one, and
            nothing on that thread can be deleted. When someone asks who
            approved the spring key visual, you open the thread and look.
          </p>
          <p class="record__p r" style="--d:.18s">
            We can work in our own workspace and give your people client
            logins, so they see only the finished work made for them and hold
            no balance. Or we join your workspace as members, work from your
            balance, and everything stays in your History and Assets Library
            when the project ends.
          </p>
          <p class="r" style="--d:.22s">
            <a class="ghost-link ghost-link--light" href="/studio/with-the-app">
              How Studio + app works
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
        <div class="record__media r" style="--d:.1s">
          <AppShot shot={appShots.validation} path="/validation" caption dark />
        </div>
      </div>
    </section>

    <!-- ============ CATEGORIES ============ -->
    <section class="cover" id="categories">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Categories</p>
          <h2 class="dh r" style="--d:.05s">
            Five categories we know <span class="serif">well</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            One detour before the questions. The studio works across many
            categories. These five come up most with brand teams, and any of
            the three ways works for each: a fashion team might post daily
            from the app and bring us the lookbook.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="820" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
                {c.caseStudy && (
                  <p class="feature__case r" style="--d:.16s">
                    <a class="ghost-link" href={c.caseStudy.href}>
                      {c.caseStudy.label}
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/hubstudio-shanghai-studio.webp"
                alt="A wide view of the hubStudio Shanghai floor with editorial daylight, calibrated stations and brand-variation proofs pinned along the back wall."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48 hours</span>
            <span class="source__stat-cap">A written proposal after your brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Creative judgment, with<br />the AI <span class="serif">underneath</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Senior art directors lead every brief, and the AI production runs
            under their direction.
          </p>
          <p class="source__p r" style="--d:.16s">
            The same company builds the app your team uses and runs the
            studio that makes your campaigns. So moving a job from one to the
            other doesn’t mean starting over.
          </p>
          <p class="source__p r" style="--d:.2s">
            We record the provenance of every asset, so you know what was
            shot, what was generated, and what was retouched. The studio was
            founded by Cyril Drouin, former CEO at Publicis, and has its
            headquarters in Hong Kong.
          </p>
          <ul class="creds r" style="--d:.26s">
            {
              ['Senior art directors', 'Brand-trained models', 'Provenance per asset', 'Twenty service lines'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">brief</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What brand teams ask us first. If yours isn’t here, put it in the
            brief.
          </p>
          <p class="faq__updated r" style="--d:.12s">Updated September 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ INSIGHTS LAYER (permanent) ============ -->
    <InsightsLayer placement="brands" tone="white" id="reading" />

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="studio"
      briefQuery="way=studio-app"
      pre="Send a brief, or open the "
      accent="app"
      post="."
      text="Tell us about the campaign, and a producer replies within one business day. Or create an account today, at no cost, and your team can start on the daily run."
    />
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

