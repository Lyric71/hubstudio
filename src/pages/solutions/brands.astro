                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ INSIGHTS LAYER (permanent) ============ -->
    <InsightsLayer placement="brands" tone="white" id="reading" />

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="app"
      briefQuery="way=studio-app"
      pre="Open the app, or send us a "
      accent="brief"
      post="."
      text="Create an account today at no cost and start making assets and scheduling posts. Or send us a brief for a campaign or social management, and a producer replies within one business day."
