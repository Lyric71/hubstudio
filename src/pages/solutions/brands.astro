---
/**
 * AIGC for Brands  ·  /solutions/brands
 *
 * Built around the existing AIGC-for-Brands content: hyper-relevance, the
 * five industry-ready model families and the production logic that follows.
 * Shares the print-shop typographic frame, calibration bars and editorial
 * display headings used across the other solutions pages.
 *
 * Per repo standards: no em-dashes (U+2014), no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Why-it-matters reasons, drawn from the source page's hyper-relevance
   imperative and creative-destiny sections. No ordinals; the visual order
   and headings do the sequencing. */
const reasons = [
  {
    label: 'Hyper-relevance',
    title: 'Modern audiences expect more than personalisation.',
    body: 'They expect content tuned to a platform, an audience, a cultural moment, a single interaction. Templates with swapped variables no longer pass. AIGC makes that level of specificity not just possible, but practical, at the volume modern brands need.',
  },
  {
    label: 'Past scarcity',
    title: 'Traditional production runs on scarcity. AIGC removes the limit.',
    body: 'Limited budgets, finite timelines, constrained exploration. The old equation does not deliver hundreds of authentic variations. The new one does, so creative teams move from execution gatekeepers to curators of brilliance.',
  },
  {
    label: 'Creative destiny',
    title: 'A brand that speaks fluently in a thousand voices.',
    body: 'AIGC does not just generate content, it architects experiences that resonate across every touchpoint. Tokyo, Sao Paulo, Stockholm, each interaction crafted for that culture and that moment, without losing the line that makes the brand the brand.',
  },
];

/* Industry-ready models, each with a tag list of the underlying workflow
   blocks. The tag list replaces numbered sub-headings, satisfying the
   no-numbers rule while preserving the substance. */
const lanes = [
  {
    label: 'Fashion',
    heading: 'Pre-fine-tuned models for style innovation.',
    image: '/Images/hub4fashion.jpg',
    alt: 'A daylit fashion editorial frame with a model in a sculpted coat against a warm-grey wall, prime-lens shallow focus, soft window light from camera left.',
    lead: 'Trained on seasonal trends, colour psychology and global style preferences. Sophisticated fashion content from day one.',
    body: [
      "Ready workflows for editorial storytelling, social commerce visuals, seasonal campaigns and lifestyle content. The model already speaks the language of the category, so the team moves to direction rather than starting at zero.",
      'The output is built to slot into an existing fashion calendar: lookbooks, drop adaptations, performance creative and cultural variations, all tracked against your brand voice rather than the generic editorial defaults of the public tools.',
    ],
    tags: [
      'Editorial storytelling', 'Social commerce visuals',
      'Seasonal campaigns', 'Lifestyle content',
      'Lookbook adaptations', 'Drop creative',
      'Performance variants', 'Cultural localisation',
    ],
  },
  {
    label: 'Automotive',
    heading: 'Pre-built workflows for vehicle marketing.',
    image: '/Images/md-launch.jpg',
    alt: 'A wide cinematic vehicle frame on a quiet coastal road at the end of the afternoon, single low-angle sun source, warm shadow grade, restrained negative space for headline copy.',
    lead: 'Fine-tuned on vehicle specifications, lifestyle benefits and regional preferences. Compelling narratives, immediately.',
    body: [
      "Ready deployments cover product showcases, lifestyle integration, technical presentations and emotional storytelling. The same launch ships from spec-sheet detail to wide cinematic context without rebriefing the team.",
      'Regional variants account for the way each market actually drives, parks and lives with the vehicle, so a single hero idea adapts to the climate and culture it lands in rather than reading as a translated press kit.',
    ],
    tags: [
      'Product showcases', 'Lifestyle integration',
      'Technical presentations', 'Emotional storytelling',
      'Regional variants', 'Spec-sheet visualisation',
      'Launch campaigns', 'Configurator stills',
    ],
  },
  {
    label: 'Electronics',
    heading: 'Plug-and-play models for tech brands.',
    image: '/Images/md-saas.jpg',
    alt: 'A clean tech product still life on a matte-grey surface, single softbox from camera right, lifted black point, subtle film grain on the highlights.',
    lead: 'Pre-trained on technical benefit and lifestyle integration. Make the product accessible from the first campaign.',
    body: [
      "Ready workflows for product demonstrations, lifestyle contexts, technical simplification and feature-benefit translation. The model already knows how to make a circuit board read as a benefit rather than a brochure.",
      'Useful where category friction is highest: the dense spec sheet, the unfamiliar feature, the launch where the team has to teach and sell at the same time. AIGC absorbs the heavy lifting so the campaign can lead with the human payoff.',
    ],
    tags: [
      'Product demonstrations', 'Lifestyle contexts',
      'Feature-benefit translation', 'Technical simplification',
      'Launch creative', 'Spec to story',
      'Tutorial visuals', 'Comparative frames',
    ],
  },
  {
    label: 'Food',
    heading: 'Ready-made models for culinary brands.',
    image: '/Images/md-ooh.jpg',
    alt: 'A close food editorial frame, ingredients with imperfect surfaces, hard side light raking across texture, warm shadow grade.',
    lead: 'Pre-fine-tuned on flavour profiles, cultural preference and appetite psychology. Irresistible content across diverse markets.',
    body: [
      "Ready workflows for photography enhancement, cultural adaptation, seasonal menus and social content. The model already understands the difference between a tasting menu and a quick-service hero, and what each market expects from each.",
      'Useful across the full calendar: launch campaigns, seasonal pushes, recipe content, partnership creative and the relentless social drip in between. One brand voice, many authentic local expressions, all tracked against the same standard.',
    ],
    tags: [
      'Photography enhancement', 'Cultural adaptation',
      'Seasonal menus', 'Social content',
      'Recipe visualisation', 'Partnership creative',
      'Appetite-led variants', 'In-format social drops',
    ],
  },
  {
    label: 'B2B',
    heading: 'Enterprise-ready AI for business communication.',
    image: '/Images/hub4presentation.jpg',
    alt: 'A small client workshop in a sunlit meeting room with a printed campaign roadmap on the wall and three people discussing a phase, documentary in-studio register.',
    lead: 'Pre-trained on industry terminology, decision-making frameworks and professional communication.',
    body: [
      "Ready workflows for solution presentations, case-study visualisation, technical documentation and stakeholder communication. The same model writes the deck, the leave-behind and the field-sales asset, in the same voice.",
      'Useful where the audience is technical, the buying cycle is long and the channel mix includes a sales team. AIGC industrialises the visual layer so the sellers spend their time selling rather than waiting on creative.',
    ],
    tags: [
      'Solution presentations', 'Case-study visualisation',
      'Technical documentation', 'Stakeholder communication',
      'Field-sales enablement', 'Deck design',
      'Whitepaper visuals', 'Account-based variants',
    ],
  },
];

const faqs = [
  {
    q: 'Is AI training mandatory for every brand project?',
    a: 'Yes. AI training is essential to unlock authentic, brand-safe AIGC. Generic AI does not reflect your colour, your style or your tone. Custom training ensures every generated asset captures the brand and stays consistent across channels. One training is valid for one product and one specific AIGC model.',
  },
  {
    q: 'How do you protect our brand data and intellectual property?',
    a: 'We maintain complete privacy through a closed-loop system. Your data never goes to public AI models, all prompts are anonymised and we use open-source models installed on private servers. You get your own dedicated AI engine based on custom models. Servers can be located in China, the USA or Europe depending on your requirements.',
  },
  {
    q: "What's included in your industry-specific solutions?",
    a: 'Each industry package includes pre-fine-tuned AI models and ready-to-deploy workflows. Fashion gets editorial storytelling and social commerce templates. Automotive includes product showcases and emotional storytelling frameworks. Electronics features technical simplification and lifestyle integration. Food offers cultural adaptation and appetite-driven content. B2B provides solution presentations and stakeholder communication workflows.',
  },
  {
    q: 'How quickly can we start generating content?',
    a: 'With the pre-trained industry models, sophisticated content can launch from day one. No long training period, no learning curve. The standard workflows are immediately deployable, so creative output speed transforms without sacrificing quality or brand authenticity.',
  },
  {
    q: "What's the difference between your solution and using ChatGPT or MidJourney directly?",
    a: 'Public tools generate generic content that does not reflect your brand identity. Our approach combines custom AI training with industry-specific expertise, so every asset feels authentically yours. We architect complete brand experiences, not just individual pieces of content, with built-in brand safety and consistency controls.',
  },
  {
    q: 'Can AIGC handle multiple markets and cultural adaptations simultaneously?',
    a: 'Yes. Multi-market transcreation lets your brand speak authentically to audiences in Tokyo, Sao Paulo and Stockholm at the same time. Each interaction feels personally crafted for that culture and context, going past translation to true cultural adaptation while keeping the core brand essence intact.',
  },
  {
    q: 'What types of content formats can you generate?',
    a: 'Comprehensive brand assets including bold visuals, short videos, eCommerce packs, campaign adaptations, social content, technical documentation, lifestyle contexts and seasonal campaigns. The AI handles everything from product photography enhancement to emotional storytelling frameworks, all tuned to the brand.',
  },
  {
    q: 'How do you ensure content quality and brand compliance?',
    a: 'The process includes strategic planning, AI creation with creative direction, extensive prompt fine-tuning, quality control checkpoints and post-production refinement. Every asset goes through client QC before delivery. Brand governance runs on filtering systems, compliance controls and usage-policy frameworks.',
  },
  {
    q: "What's the investment range for AIGC implementation?",
    a: 'Pricing varies with scope, complexity, volume and creative considerations. We provide a customised proposal after assessing the project. Published prices are indicative, with actual project pricing reflecting the specific requirements and the outcome.',
  },
  {
    q: 'How does AIGC integrate with our existing creative workflows?',
    a: 'AIGC enhances rather than replaces the creative process. Teams become curators of brilliance instead of being limited by production constraints. We work alongside your creative strategy, amplifying the team and enabling exploration of concepts that were previously impossible on the timeline or the budget. The technology serves the creativity, not the other way around.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="AIGC for Brands: Industry-Specific Models | hubStudio"
  description="Pre-trained AIGC models for fashion, automotive, electronics, food and B2B. Custom brand training, multi-market content and instant deployment from hubStudio."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Brands
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">AIGC built</span></span>
            <span class="line"><span class="line__i">around the</span></span>
            <span class="line"><span class="line__i serif">brand.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Where creative intelligence meets <em>brand excellence</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Modern audiences no longer settle for personalisation. They
              expect content tuned to a platform, an audience, a moment, a
              single interaction. Traditional production cannot deliver that
              level of specificity at scale.
            </p>
            <p>
              We architect AIGC capability around the brand: industry-trained
              models, custom training on your visual DNA, multi-market output,
              all run inside an active studio. The same line shows up in
              fifty places and reads native in every one.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start a brand brief</Button>
            <a class="ghost-link ghost-link--light" href="#industries">
              See the industry models
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> 35+ markets, private model hosting
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/brands-hero.jpg"
          alt="A daylit hubStudio creative floor with a single model under window light from camera left, calibrated monitors in the background and printed brand variations pinned along the wall for review."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Shanghai <span>/</span> Brand floor</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              The hyper-relevance<br />imperative, <span class="serif">made practical</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            Traditional production economics never delivered hyper-relevance.
            AIGC does, when it is architected around the brand rather than
            bought as a tool. The output reads native because the model was
            trained that way.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S3 · INDUSTRY LANES ============ -->
    <section class="cover" id="industries">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Industry-ready models</p>
          <h2 class="dh r" style="--d:.05s">
            Five categories, one <span class="serif">operating model</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Each industry package ships with pre-fine-tuned models and
            ready-to-deploy workflows tuned to the category. Most clients
            start in one lane, then expand to the adjacent ones as the
            content operation matures.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  Industry model
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/hubstudio-shanghai-studio.webp"
                alt="A wide view of the hubStudio Shanghai floor with editorial daylight, calibrated stations and brand-variation proofs pinned along the back wall."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">One studio</span>
            <span class="source__stat-cap">Creative and technical, under one roof</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            Deep technical AIGC expertise<br />with creative <span class="serif">sensibility</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Most partners come from one side of the divide: a systems
            integrator who has never authored a campaign, or a creative
            agency adding "AI" to the deck cover. The engagement then bends
            toward whichever side wrote the proposal.
          </p>
          <p class="source__p r" style="--d:.16s">
            We sit on both. The consulting and production practices run
            inside one active content studio, so AI implementation enhances
            rather than disrupts the creative culture it lands in. The
            methodology is proven on the studio's own work first, then handed
            to clients.
          </p>
          <p class="source__p r" style="--d:.22s">
            That positions the brand at the front of rapidly evolving AI
            capability while building a content operation that survives the
            next model release rather than being rebuilt by it.
          </p>
          <ul class="creds r" style="--d:.28s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Custom-trained models
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Private hosting
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              35+ markets shipped
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              NDA in place
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ S5 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">brief</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The questions brand teams ask before we begin. If yours is not
            below, put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start a brand brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S6 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Build with us</p>
        <h2 class="end__title r" style="--d:.05s">
          Architect with<br /><span class="serif">us</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send a brief, a current state or just the question that prompted
          this page. A senior lead reads it inside two working days and
          replies with a scope, a phased plan and an honest read on which
          industry model is the right starting line.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start a brand brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See client work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }

  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }

  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }

  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }

  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
  .dh--sm { font-size: clamp(26px, 2.6vw, 38px); }
  .serif { font-family: var(--font-serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; color: var(--brand-orange); }

  .crop { position: relative; margin: 0; }
  .crop::before, .crop::after { content: ''; position: absolute; width: 16px; height: 16px; z-index: 2; }
  .crop::before { top: -9px; left: -9px; border-top: 1.5px solid var(--brand-orange); border-left: 1.5px solid var(--brand-orange); }
  .crop::after { right: -9px; bottom: 28px; border-right: 1.5px solid var(--brand-orange); border-bottom: 1.5px solid var(--brand-orange); }
  .crop__inner { overflow: hidden; border-radius: 4px; }
  .crop__inner img { display: block; width: 100%; height: 100%; object-fit: cover; }
