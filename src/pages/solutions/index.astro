---

<Layout
  title="Solutions for Brands, Agencies & Retailers | hubStudio"
  description="How hubStudio plugs into your brand: the clients we serve, consulting and training, AI production, and platform-native content for social, ecommerce, and web."
>
  <!-- ===== Hero ===== -->
  <section class="sol-hero">
    <div class="container">
      <span class="eyebrow">Solutions</span>
      <h1 class="headline h1 reveal sol-hero__title">
        Built around how your brand <span class="accent">sells</span>.
      </h1>
      <p class="lead sol-hero__lead">
        Who we work with, the consulting we run, and the platforms we produce for:
        every solution matched to your market and the way you sell.
      </p>
      <nav class="sol-jump" aria-label="Solution categories">
        {
          categories.map((cat) => (
            <a class="sol-jump__link" href={`#${cat.id}`}>
              {cat.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ===== Categories ===== -->
  <div class="sol-cats">
    <div class="container">
      {
        categories.map((cat) => (
          <section class="sol-cat" id={cat.id}>
            <header class="sol-cat__head">
              <h2 class="sol-cat__title reveal">{cat.title}</h2>
              <p class="sol-cat__blurb">{cat.blurb}</p>
            </header>
            {cat.subgroups.map((sub) => (
              <div class="sol-sub">
                {sub.heading && <p class="sol-sub__head">{sub.heading}</p>}
                <div class="sol-grid">
                  {sub.items.map((s) => (
                    <a class="sol-card" href={s.href}>
                      <div class="sol-card__media">
                        <img
                          class="sol-card__img"
                          src={s.img}
                          alt={s.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="sol-card__body">
                        <h3 class="sol-card__name">{s.name}</h3>
                        <p class="sol-card__desc">{s.desc}</p>
                        <span class="sol-card__cta">
                          Explore <span aria-hidden="true">&rarr;</span>
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </div>

  <!-- ===== Closing CTA ===== -->
  <section class="sol-cta">
    <div class="container">
      <div class="sol-cta__card card card--orange grain">
        <span class="eyebrow sol-cta__eyebrow">Where to start</span>
        <h2 class="headline h3 sol-cta__title">Not sure where your brand fits?</h2>
        <p class="sol-cta__text">
          Tell us your market and what you sell. We will map the right solution, or
          shape one around the way you work.
        </p>
        <Button variant="primary-inverse" href="/contact">Talk to us</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---------------------------------------------------- */
  .sol-hero {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 76px);
  }
  .sol-hero__title {
    margin-top: 16px;
    max-width: 18ch;
  }
  .sol-hero__lead {
    margin-top: 22px;
    max-width: 58ch;
  }

  /* Category jump links */
  .sol-jump {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .sol-jump__link {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--text-ink);
    transition: color 120ms ease-out, border-color 120ms ease-out;
  }
  .sol-jump__link:hover {
    color: var(--brand-orange);
    border-color: var(--brand-orange);
  }

  /* ---- Category sections --------------------------------------- */
  .sol-cats {
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .sol-cat {
    scroll-margin-top: 96px;
  }
  .sol-cat + .sol-cat {
    margin-top: clamp(64px, 9vw, 112px);
  }
  .sol-cat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 32px;
    padding-top: 26px;
    border-top: 1px solid var(--line-strong);
    margin-bottom: 36px;
  }
  .sol-cat__title {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(28px, 3.2vw, 46px);
  }
  .sol-cat__blurb {
    font-size: var(--type-body);
    color: var(--text-mute);
  }

  /* ---- Subgroups (Platforms) ----------------------------------- */
  .sol-sub + .sol-sub {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .sol-sub__head {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-bottom: 14px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line-hairline);
  }

  /* ---- Solution grid + cards ----------------------------------- */
  .sol-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-card);
  }
  @media (min-width: 640px) {
    .sol-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sol-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sol-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
  }
  .sol-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(10, 10, 20, 0.12);
  }
  .sol-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-cream);
  }
  .sol-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-out;
  }
  .sol-card:hover .sol-card__img {
    transform: scale(1.04);
  }
  .sol-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px 24px;
  }
  .sol-card__name {
    font-family: var(--font-sans);
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .sol-card__desc {
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--text-mute);
  }
  .sol-card__cta {
    margin-top: auto;
    padding-top: 14px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .sol-card__cta span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .sol-card:hover .sol-card__cta span {
    transform: translateX(4px);
  }

  /* ---- Closing CTA -------------------------------------------- */
  .sol-cta {
    padding-bottom: clamp(80px, 10vw, 150px);
  }
  .sol-cta__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: clamp(40px, 6vw, 76px) clamp(24px, 5vw, 64px);
    color: #fff;
  }
  .sol-cta__eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }
  .sol-cta__title {
    color: #fff;
  }
  .sol-cta__text {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.86);
  }
  .sol-cta__card .btn {
    margin-top: 10px;
  }
</style>

<script>
  /* Fade-in on scroll, matching the home page reveal pattern. */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>
