  name: string;
  href: string;
  img: string;
  alt: string;
  desc: string;
};
type SubGroup = {
  /** null renders a plain grid with no sub-heading (flat categories). */
  heading: string | null;
  items: Solution[];
};
type Category = {
  id: string;
  title: string;
  blurb: string;
  subgroups: SubGroup[];
};

