---
/**
 * Solutions index  ·  /solutions
 *
 * The "who it is for" hub. Each audience card says which of the three ways to
 * work usually fits and links onward; a two-column band shows the real app
 * (a capture) and the real studio (a photograph); the three ways band follows
 * with Use the app highlighted, the site's first door. The rest of the page
 * is a map to consulting, training, AI production and platform work, grouped
 * to mirror the Solutions mega menu in Header.astro.
 * Copy from the content-quality-us deck (cq/solutions).
 *
 * No ordinal numerals anywhere (project card rule). Images are reused from
 * the individual solution pages and the studio set; no new raster assets.
 */
import Layout from '../../layouts/Layout.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

type Solution = {
  name: string;
  href: string;
  img: string;
  alt: string;
  desc: string;
  /** The way to work that usually fits this audience (locked names). */
  fit?: 'Use the app' | 'Work with us in the app';
  /** Link label; defaults to "Explore". */
  cta?: string;
};
type SubGroup = {
  /** null renders a plain grid with no sub-heading (flat categories). */
  heading: string | null;
  items: Solution[];
};
type Category = {
  id: string;
  title: string;
  blurb: string;
  subgroups: SubGroup[];
};

const audiences: Category = {
  id: 'who',
  title: 'Who it’s for',
  blurb:
    'Every team has two jobs: making creative assets and running social networks. Here is how each kind of team uses the app and works with us inside it.',
  subgroups: [
    {
      heading: null,
      items: [
        {
          name: 'Brands',
          href: '/solutions/brands',
          img: '/Images/brands-hero.jpg',
          alt: 'A hubStudio creative floor with a model under window light and brand variations pinned for review.',
          desc: 'Your team creates daily visuals and schedules social posts in the app. Our creative and social teams build campaigns and run channels inside the same workspace.',
          fit: 'Work with us in the app',
          cta: 'How brand teams use it',
        },
        {
          name: 'Agencies',
          href: '/solutions/agencies',
          img: '/Images/agencies-hero.jpg',
          alt: 'Two creative directors reviewing a wall of pinned campaign variations on an agency production floor.',
          desc: 'Produce client assets, manage multi-brand social calendars, and get client sign-off in Client spaces. When pitches or launches stack up, our team produces behind your name.',
          fit: 'Use the app',
          cta: 'The agency setup',
        },
        {
          name: 'Retailers',
          href: '/solutions/retailers',
          img: '/Images/retailers-hero.jpg',
          alt: 'A retail product still life on a sunlit kitchen counter in late-afternoon window light.',
          desc: 'Turn out SKU visuals, promo clips, and daily social posts in the app. Our team handles seasonal campaigns, marketplace pages, and paid or China social.',
          fit: 'Use the app',
          cta: 'Retail, season by season',
        },
        {
          name: 'Manufacturers',
          href: '/solutions/manufacturers',
          img: '/Images/manufacturers-hero.jpg',
          alt: 'A partially assembled industrial product under tall window light on a daylit shop floor.',
          desc: 'Turn CAD files and specs into photoreal product visuals, launch films, and B2B social campaigns on LinkedIn, YouTube, and WeChat, with engineering sign-off in Validation.',
          fit: 'Work with us in the app',
          cta: 'From CAD to assets & B2B social',
        },
      ],
    },
  ],
};

const categories: Category[] = [
  {
    id: 'consulting',
    title: 'Consulting and training',
    blurb: 'For teams that want their workspace, AI models, and approval chain set up right.',
    subgroups: [
      {
        heading: null,
        items: [
          {
            name: 'Consulting',
            href: '/solutions/consulting',
            img: '/Images/who-we-are-office.webp',
            alt: 'A client workshop in a sunlit meeting room with a printed twelve-month roadmap pinned to the wall.',
            desc: 'Advice on setting up your own AI content team: who does what, and how the work gets approved.',
          },
          {
            name: 'Training',
            href: '/solutions/training',
            img: '/Images/training-hero.jpg',
            alt: 'A senior trainer at a whiteboard with four participants reviewing AIGC frames at workstations.',
            desc: 'Hands-on training on the hubStudio app: how to get the best out of every AI model in the app, build assets, and run social campaigns.',
          },
          {
            name: 'Onboarding',
            href: '/services/onboarding',
            img: '/Images/app-desk.webp',
            alt: 'Two colleagues at a laptop in a sunlit office, one pointing at the screen while the other listens, pen in hand.',
            desc: 'We set up your hubStudio team with you and train your people, live. Half of the 500 USD comes back to your wallet.',
          },
        ],
      },
    ],
  },
  {
    id: 'ai-production',
    title: 'AI production',
    blurb: 'The craft behind the studio’s images, video, and copy.',
    subgroups: [
      {
        heading: null,
        items: [
          {
            name: 'Image',
            href: '/solutions/ai-production/image',
            img: '/Images/aiprod-image-hero.jpg',
            alt: 'A creative director reviewing brand image variations on calibrated monitors in a daylit studio.',
            desc: 'Brand-trained image work, art-directed before it ships.',
          },
          {
            name: 'Video',
            href: '/solutions/ai-production/video',
            img: '/Images/aiprod-video-hero.jpg',
            alt: 'An editor reviewing a paused master cut with vertical and square variations in the timeline.',
            desc: 'Generated and hybrid video, from concept to final cut.',
          },
          {
            name: 'Content',
            href: '/solutions/ai-production/content',
            img: '/Images/aiprod-content-hero.jpg',
            alt: 'A strategist reviewing campaign copy variations on a calibrated monitor beside printed proofs.',
            desc: 'Copy and content written around your brand voice.',
          },
        ],
      },
    ],
  },
  {
    id: 'platforms',
    title: 'Platforms',
    blurb:
      'Full-service channel management, paid media buying, creator seeding, social commerce and studio AIGC across Western and Chinese platforms.',
    subgroups: [
      {
        heading: 'Social',
        items: [
          {
            name: 'Meta',
            href: '/solutions/platforms/meta',
            img: '/Images/meta-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a paused Instagram Reels frame.',
            desc: 'IG & FB management, Advantage+ ads, creator whitelisting, Shops and studio AIGC.',
          },
          {
            name: 'TikTok',
            href: '/solutions/platforms/tiktok',
            img: '/Images/tt-hero.jpg',
            alt: 'A young creator filming themselves on a tripod-mounted phone in soft window daylight.',
            desc: 'Organic channels, Spark Ads, TikTok Shop, affiliate creators, LIVE and vertical AIGC.',
          },
          {
            name: 'LinkedIn',
            href: '/solutions/platforms/linkedin',
            img: '/Images/linkedin-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a LinkedIn feed post.',
            desc: 'Company Pages, executive ghostwriting, ABM LinkedIn Ads, KOLs and B2B creative.',
          },
          {
            name: 'WeChat',
            href: '/solutions/platforms/wechat',
            img: '/Images/wechat-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing an open WeChat Official Account article.',
            desc: 'Official Accounts, Channels, Mini-Programs, Moments Ads, WeCom CRM and studio creative.',
          },
          {
            name: 'RedNote',
            href: '/solutions/platforms/rednote',
            img: '/Images/rednote-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing the RedNote discovery feed.',
            desc: 'Pro accounts, Note SEO, KOL/KOC seeding, JuGuang ads, RedNote Shops and creative.',
          },
          {
            name: 'Douyin',
            href: '/solutions/platforms/douyin',
            img: '/Images/douyin-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a paused vertical Douyin video.',
            desc: 'Blue V accounts, Ocean Engine ads, Douyin Store, livestream selling, KOLs and video.',
          },
          {
            name: 'Weibo',
            href: '/solutions/platforms/weibo',
            img: '/Images/weibo-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a Weibo feed post.',
            desc: 'Blue V verification, Super Topics, Hot Search PR, Fan Tong ads, KOLs and studio creative.',
          },
        ],
      },
      {
        heading: 'eCommerce',
        items: [
          {
            name: 'Website',
            href: '/solutions/platforms/ecommerce-website',
            img: '/Images/ecommerce-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing an online store product detail page.',
            desc: 'Product, category, and campaign visuals for your own store.',
          },
          {
            name: 'Amazon',
            href: '/solutions/platforms/amazon',
            img: '/Images/amazon-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing an Amazon product detail page.',
            desc: 'Listing images and A+ content for Amazon.',
          },
          {
            name: 'Tmall',
            href: '/solutions/platforms/tmall',
            img: '/Images/tmall-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a Tmall flagship store homepage.',
            desc: 'Flagship store visuals and detail pages for Tmall.',
          },
          {
            name: 'JD',
            href: '/solutions/platforms/jd',
            img: '/Images/jd-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a JD product detail page.',
            desc: 'Product and store content for JD.',
          },
          {
            name: 'Shopify',
            href: '/solutions/platforms/shopify',
            img: '/Images/shopify-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a Shopify storefront product page.',
            desc: 'Storefront and product visuals for Shopify.',
          },
        ],
      },
      {
        heading: 'Brand',
        items: [
          {
            name: 'Website',
            href: '/solutions/platforms/brand-website',
            img: '/Images/brand-website-hero.jpg',
            alt: 'A hand holding a phone in warm rim light showing a company website homepage.',
            desc: 'An editorial brand site, designed and written.',
          },
        ],
      },
    ],
  },
];

const jump = [
  { id: 'who', label: 'Who it’s for' },
  { id: 'offers', label: 'The app and our team' },
  { id: 'consulting', label: 'Consulting and training' },
  { id: 'ai-production', label: 'AI production' },
  { id: 'platforms', label: 'Platforms' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
  ],
};
---

<Layout
  title="hubStudio solutions: creative assets and social networks for your team"
  description="Brands, agencies, retailers, and manufacturers use hubStudio to make creative assets and run social networks: use the app yourself, or work with our team in the app."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- ===== Hero ===== -->
  <section class="sol-hero">
    <div class="container">
      <span class="eyebrow">Solutions</span>
      <h1 class="headline h1 reveal sol-hero__title">
        Creative assets and social networks, made the way your team <span class="accent">works</span>.
      </h1>
      <p class="lead sol-hero__lead">
        hubStudio brings both parts of the job into one workspace: generating
        and editing text, images, and video on one side, and running campaigns
        and social channels on the other. Use the app yourself, or have our
        creative and social teams work with you inside the app.
      </p>
      <nav class="sol-jump" aria-label="On this page">
        {
          jump.map((j) => (
            <a class="sol-jump__link" href={`#${j.id}`}>
              {j.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ===== Who it's for ===== -->
  <div class="sol-cats sol-cats--top">
    <div class="container">
      <section class="sol-cat" id={audiences.id}>
        <header class="sol-cat__head">
          <h2 class="sol-cat__title reveal">{audiences.title}</h2>
          <p class="sol-cat__blurb">{audiences.blurb}</p>
        </header>
        <div class="sol-grid sol-grid--four">
          {
            audiences.subgroups[0].items.map((s) => (
              <a class="sol-card" href={s.href}>
                <div class="sol-card__media">
                  <img class="sol-card__img" src={s.img} alt={s.alt} loading="lazy" decoding="async" />
                </div>
                <div class="sol-card__body">
                  {s.fit && (
                    <span class="sol-card__fit">
                      <span class="sol-card__dot" aria-hidden="true" />
                      Usual fit: {s.fit}
                    </span>
                  )}
                  <h3 class="sol-card__name">{s.name}</h3>
                  <p class="sol-card__desc">{s.desc}</p>
                  <span class="sol-card__cta">
                    {s.cta ?? 'Explore'} <span aria-hidden="true">&rarr;</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
        <p class="sol-aside">
          Not on this list? Every team can start in the app or with our team.
          <a href={APP_SIGNUP} target="_blank" rel="noopener">Open an account and try the app</a>, or
          <a href={BRIEF_URL}>send a brief</a> and a producer will help you scope the work.
        </p>
      </section>
    </div>
  </div>

  <!-- ===== The app and our team ===== -->
  <section class="sol-offers" id="offers">
    <div class="container">
      <span class="eyebrow">See both</span>
      <h2 class="headline h2 sol-offers__title reveal">
        What the app looks like, and who works with you <span class="accent">inside</span> it.
      </h2>
      <div class="sol-offers__grid">
        <article class="sol-offer">
          <p class="sol-offer__label">Use the hubStudio app</p>
          <AppShot shot={appShots.exploreApp} path="/explore" caption />
          <p class="sol-offer__text">
            Your team picks an AI engine, sees the price, and runs it, then
            edits in the browser, gets sign-off in Validation, and schedules
            posts across social networks. You pay as you go from a prepaid
            balance, with no subscription and no seat fees.
          </p>
          <p class="sol-offer__links">
            <a href="/app">Tour the app <span aria-hidden="true">&rarr;</span></a>
            <a href="/help">Help center <span aria-hidden="true">&rarr;</span></a>
          </p>
        </article>
        <article class="sol-offer">
          <p class="sol-offer__label">Work with us in the app</p>
          <figure class="sol-offer__photo">
            <img
              src="/Images/studio-hero.webp"
              alt="An art director marks a pinned proof with a red pencil while a colleague holds another print, in front of a wall of campaign prints at the hubStudio studio."
              width="2000"
              height="1333"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <p class="sol-offer__text">
            Senior art directors, designers, retouchers, motion designers, and
            social strategists produce creative assets and run social channels
            inside your hubStudio workspace. Founded by Cyril Drouin, former
            CEO at Publicis, and headquartered in Hong Kong, with studios in
            Shanghai and Changsha. A producer reads every brief within one
            business day.
          </p>
          <p class="sol-offer__links">
            <a href="/studio">Meet our team <span aria-hidden="true">&rarr;</span></a>
            <a href="/work">See the work <span aria-hidden="true">&rarr;</span></a>
          </p>
        </article>
      </div>
      <p class="sol-offers__price">
        The app is pay as you go; working with our team is quoted after a brief.
        <a href="/pricing">How pricing works</a>
      </p>
    </div>
  </section>

  <!-- ===== Two ways to work ===== -->
  <WaysToWork
    tone="white"
    highlight="app"
    lead="Each card above points to where teams usually start. Both ways happen in the same workspace, so you can add our team whenever a campaign or channel needs extra hands."
  />

  <!-- ===== The map: consulting, AI production, platforms ===== -->
  <div class="sol-cats">
    <div class="container">
      <p class="sol-transition">
        The rest of this page is a map. If you already know what you need
        (advice, training, a craft, or a platform), jump straight to it.
      </p>
      {
        categories.map((cat) => (
          <section class="sol-cat" id={cat.id}>
            <header class="sol-cat__head">
              <h2 class="sol-cat__title reveal">{cat.title}</h2>
              <p class="sol-cat__blurb">{cat.blurb}</p>
            </header>
            {cat.subgroups.map((sub) => (
              <div class="sol-sub">
                {sub.heading && <p class="sol-sub__head">{sub.heading}</p>}
                <div class="sol-grid">
                  {sub.items.map((s) => (
                    <a class="sol-card" href={s.href}>
                      <div class="sol-card__media">
                        <img
                          class="sol-card__img"
                          src={s.img}
                          alt={s.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="sol-card__body">
                        <h3 class="sol-card__name">{s.name}</h3>
                        <p class="sol-card__desc">{s.desc}</p>
                        <span class="sol-card__cta">
                          {s.cta ?? 'Explore'} <span aria-hidden="true">&rarr;</span>
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </div>

  <!-- ===== Closing ===== -->
  <DualCta
    eyebrow="Where to start"
    pre="Open the app, or send us a "
    accent="brief"
    post="."
    text="Creating an account costs nothing, and you pay only for what you run. For studio work, a producer reads your brief within one business day and sends a written proposal within 48 hours."
    lead="app"
  />
</Layout>

<style>
  /* ---- Hero ---------------------------------------------------- */
  .sol-hero {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 76px);
  }
  .sol-hero__title {
    margin-top: 16px;
    max-width: 20ch;
  }
  .sol-hero__lead {
    margin-top: 22px;
    max-width: 60ch;
  }

  /* Section jump links */
  .sol-jump {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .sol-jump__link {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--text-ink);
    transition: color 120ms ease-out, border-color 120ms ease-out;
  }
  .sol-jump__link:hover {
    color: var(--brand-orange);
    border-color: var(--brand-orange);
  }

  /* ---- Category sections --------------------------------------- */
  .sol-cats {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .sol-cats--top {
    padding-top: 0;
  }
  .sol-cat {
    scroll-margin-top: 96px;
  }
  .sol-cat + .sol-cat {
    margin-top: clamp(64px, 9vw, 112px);
  }
  .sol-cat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 32px;
    padding-top: 26px;
    border-top: 1px solid var(--line-strong);
    margin-bottom: 36px;
  }
  .sol-cat__title {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(28px, 3.2vw, 46px);
  }
  .sol-cat__blurb {
    max-width: 56ch;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .sol-transition {
    max-width: 60ch;
    margin-bottom: clamp(36px, 5vw, 56px);
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .sol-aside {
    margin-top: 28px;
    max-width: 70ch;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .sol-aside a {
    color: var(--brand-orange);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Subgroups (Platforms) ----------------------------------- */
  .sol-sub + .sol-sub {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .sol-sub__head {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-bottom: 14px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line-hairline);
  }

  /* ---- Solution grid + cards ----------------------------------- */
  .sol-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-card);
  }
  @media (min-width: 640px) {
    .sol-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sol-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1180px) {
    .sol-grid--four {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sol-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
  }
  .sol-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(10, 10, 20, 0.12);
  }
  .sol-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-cream);
  }
  .sol-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-out;
  }
  .sol-card:hover .sol-card__img {
    transform: scale(1.04);
  }
  .sol-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px 24px;
  }
  .sol-card__fit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg-cream);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-ink);
  }
  .sol-card__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .sol-card__name {
    font-family: var(--font-sans);
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .sol-card__desc {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .sol-card__cta {
    margin-top: auto;
    padding-top: 14px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .sol-card__cta span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .sol-card:hover .sol-card__cta span {
    transform: translateX(4px);
  }

  /* ---- The app and the studio ---------------------------------- */
  .sol-offers {
    scroll-margin-top: 96px;
    padding-block: clamp(80px, 10vw, 140px);
    background: var(--bg-white);
  }
  .sol-offers__title {
    margin-top: 16px;
    max-width: 22ch;
  }
  .sol-offers__grid {
    margin-top: clamp(40px, 5vw, 64px);
    display: grid;
    gap: clamp(48px, 6vw, 72px);
