---
/**
 * Solutions index  ·  /solutions
 *
 * A visual hub that introduces every solution, grouped to mirror the
 * Solutions mega menu in Header.astro: Clients, Consulting, AI
 * Production, and Platforms (with Social / eCommerce / Brand
 * subgroups). Each solution is a card: image, name, one-line intro,
 * and a link through to its own page. No ordinal numerals anywhere
 * (project card rule).
 *
 * Images are reused from the individual solution pages; no new raster
 * assets are added here.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

