---
/**
 * hubStudio for manufacturers  ·  /solutions/manufacturers
 *
 * Covers both parts of the job for manufacturers:
 *   - Creative assets (CAD-derived photoreal product images, application
 *     scenes, launch films, dealer catalogs, assembly and safety visuals)
 *   - Social networks (B2B LinkedIn feeds, trade-show campaigns, executive
 *     ghostwriting, employee advocacy, B2B lead ads, and WeChat Official
 *     Accounts and Channels)
 * across both ways to work:
 *   - Use the app (marketing generates visuals, edits in the browser, runs
 *     campaigns, and schedules posts)
 *   - Work with us in the app (our studio produces from CAD/specs and runs
 *     B2B social channels inside the workspace, with engineering sign-off on
 *     record in Validation)
 *
 * Per repo standards: no em dash character, no decorative numerals inside
 * cards or repeated blocks, body copy at var(--type-body), hubStudio keeps
 * its canonical lowercase-h casing.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import AppShot from '../../components/AppShot.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';

const SITE = 'https://www.hubstudio.ai';

const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* The bottleneck, as three plain cards across assets and channels. No ordinals. */
const reasons = [
  {
    label: 'Creative assets',
    title: 'Engineers end up at the wrong desk.',
    body: 'The people who designed the product end up making renders and screenshots for marketing, instead of engineering the next machine.',
  },
  {
    label: 'Social networks',
    title: 'The company page goes quiet between trade shows.',
    body: 'Launch dates slip because visuals arrive late, and LinkedIn, YouTube, and WeChat sit quiet when buyers and distributors are looking.',
  },
  {
    label: 'Version control',
    title: 'Marketing, sales, and dealers drift apart.',
    body: 'Each region holds a different picture of the machine and posts its own specs. Nobody is sure which version engineering signed off.',
  },
];

/* What our creative and social teams build with you inside the app. */
const lanes = [
  {
    label: 'Pillar · Creative assets · CAD to photoreal',
    heading: 'Photoreal product images, made from your CAD files.',
    image: '/Images/pmd-inspect.jpg',
    alt: 'A documentary frame of a manufacturing engineer reviewing CAD-derived assembly guides on a calibrated monitor, warm window light from camera left, lifted black point.',
    body: 'Often ready before the first unit comes off the line. Materials, tolerances, and finishes follow your engineering references, ready for catalogs, spec sheets, and social posts.',
    tags: ['CAD-based imagery', 'Exploded views', '360-degree views', 'Finish and color variants'],
  },
  {
    label: 'Pillar · Creative assets · Launch & context',
    heading: 'The machine in context, plus launch film and dealer kits.',
    image: '/Images/md-launch.jpg',
    alt: 'A wide industrial environment with a piece of equipment in context, single low-angle directional light, calibrated negative space for headline copy, real-photography grade.',
    body: 'Show a machine inside the kind of plant or site where your customers work, without shipping heavy equipment anywhere. We deliver launch films, vertical video cuts, dealer catalogs, and localized versions for every market.',
    tags: ['Application scenes', 'Launch films', 'Dealer catalogs', 'Localized market kits'],
  },
  {
    label: 'Pillar · Creative assets · Documentation visuals',
    heading: 'Assembly, maintenance, and safety visuals.',
    image: '/Images/md-fmcg.jpg',
    alt: 'A precise close-up of a compliance label and a printed safety instruction sheet on a workshop bench, hard side light, real-photography grade.',
    body: 'Drawn from your approved source files. Your engineers and your compliance team sign them off in Validation. The certification itself stays with your team.',
    tags: ['Assembly visuals', 'Maintenance guides', 'Safety sheet visuals', 'Revision updates'],
  },
  {
    label: 'Pillar · Social networks · B2B & global channels',
    heading: 'LinkedIn, trade-show campaigns, executive voices, and WeChat.',
    image: '/Images/pmd-factory.jpg',
    alt: 'A wide shop-floor frame of a partially assembled product on a rig with calibrated daylight from a tall window, prime-lens depth of field, warm shadow grade.',
    body: 'Our social strategists and writers run your B2B social calendar inside the app: company-page posts and carousels on LinkedIn, YouTube product walkthroughs, executive ghostwriting, employee advocacy kits for sales engineers, paid B2B lead campaigns, and WeChat Official Accounts and Channels for China and APAC.',
    tags: ['LinkedIn management', 'Executive ghostwriting', 'Employee advocacy kits', 'Paid B2B lead ads', 'WeChat Official Account', 'Trade-show social kits'],
  },
];

const faqs = [
  {
    q: 'Can you make product visuals from CAD before production?',
    a: 'Yes. We work from CAD exports, prototype photos, and spec sheets to make product images, launch material, film, and social cuts while the product is still in production. Tell us the file formats you have and we will say what we need.',
  },
  {
    q: 'Can hubStudio handle our B2B social networks as well as our product visuals?',
    a: 'Yes. The app and our team cover both pillars. Your marketing team can use the app to group launch assets in a Campaign and draft and schedule posts across LinkedIn, YouTube, X, Facebook, Instagram, and TikTok (Beta). Or our team can manage your LinkedIn pages, executive posts, paid B2B ads, and WeChat Official Account directly inside your workspace.',
  },
  {
    q: 'Which way should we work with you?',
    a: 'There are two ways, and both happen in the same workspace. With Use the app, your marketing team creates visuals, edits video, and schedules social posts on its own. With Work with us in the app, our creative directors, 3D/AI specialists, and social managers produce the assets and run the channels inside your hubStudio workspace while your engineers and marketers approve in Validation.',
  },
  {
    q: 'How do you keep technical details right across visuals and posts?',
    a: 'We work from your engineering files and spec sheets, and your engineers approve every visual and technical post in Validation before it ships. If they spot an error, they send the piece back with a comment and the fix arrives on the same thread as a new version.',
  },
  {
    q: 'Can you localize assets and social campaigns for other markets?',
    a: 'Yes. We adapt industrial settings, safety signage, subtitles, and post copy for each market you sell in, including Western networks and Chinese B2B channels like WeChat, and your local teams can review in the same Validation thread.',
  },
  {
    q: 'What can you make and run for us?',
    a: 'On the asset side: CAD-derived product images, 360-degree and exploded views, application scenes, assembly and maintenance visuals, dealer catalogs, trade-show material, and launch films. On the social side: LinkedIn company posts and carousels, YouTube clips, executive ghostwriting, employee advocacy kits, paid B2B lead campaigns, and WeChat articles and video.',
  },
  {
    q: 'Does it connect to our DAM, PIM, or ERP?',
    a: 'The app has no external connectors, SSO, or public API. Your approved files live in the Assets Library with folders, tags, and version history, and for studio deliverables we export finished files in the exact formats and sizes your systems need.',
  },
  {
    q: 'How is it priced?',
    a: 'The app runs on a shared prepaid balance in real currency with no subscription and no seat fees; you see the price before every run. Working with our creative and social teams is priced per asset, per project, or on a monthly retainer, and quoted in writing within 48 hours of your brief.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE}/solutions` },
    { '@type': 'ListItem', position: 3, name: 'Manufacturers', item: `${SITE}/solutions/manufacturers` },
  ],
};

const arrow = 'M4 10h12M11 5l5 5-5 5';
---

<Layout
  title="hubStudio for manufacturers: CAD-to-photoreal assets and B2B social"
  description="Turn CAD files and specs into photoreal product visuals, launch films, and B2B social campaigns on LinkedIn, YouTube, and WeChat inside hubStudio."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Solutions
            <span class="kicker__sep">/</span> Manufacturers
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">From CAD file</span></span>
            <span class="line"><span class="line__i">to finished assets</span></span>
            <span class="line"><span class="line__i">and B2B <span class="serif">channels</span>.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Your engineers get back to <em>engineering</em>, and your launches go live on time.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A new machine is signed off. Marketing needs product pictures and
              a launch film, sales needs a dealer kit in four languages, and the
              LinkedIn, YouTube, and WeChat feeds need a steady drumbeat before
              the trade show opens.
            </p>
            <p>
              hubStudio covers both parts of the job in one workspace:
              <strong>creative assets</strong> drawn from your CAD files and
              specs, and <strong>social networks</strong> across Western and
              Chinese B2B channels. Your marketing team can run the app itself,
              or work with our creative and social teams inside the app.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</Button>
            <a class="ghost-link ghost-link--light" href={APP_SIGNUP} target="_blank" rel="noopener">
              Create your account
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            CAD to photoreal <span>/</span> Launch film & catalogs <span>/</span> LinkedIn, YouTube & WeChat
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/manufacturers-hero.jpg"
          alt="A wide shop-floor frame of a partially assembled industrial product under tall window light, prime-lens depth of field, warm shadow grade, calibrated stations and engineering reference sheets pinned along the back wall."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Manufacturing <span>/</span> Assets & B2B social</span>
      </div>
    </section>

    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ WHY ============ -->
    <section class="why">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The bottleneck</p>
            <h2 class="dh r" style="--d:.05s">
              The content cost<br />nobody <span class="serif">measures</span>.
            </h2>
          </div>
          <p class="band__note band__note--light r" style="--d:.1s">
            You will not find it on a budget line. You find it when a launch
            sits waiting for its pictures and the company feed goes silent
            between trade shows.
          </p>
        </header>

        <div class="reasons">
          {
            reasons.map((r, i) => (
              <article class="reason r" style={`--d:${i * 0.08}s`}>
                <p class="reason__label">
                  <span class="reason__tick"></span>
                  {r.label}
                </p>
                <h3 class="reason__title">{r.title}</h3>
                <p class="reason__body">{r.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ WORK WITH US IN THE APP: ASSETS & CHANNELS ============ -->
    <section class="cover" id="studio">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>Work with us in the app</p>
          <h2 class="dh r" style="--d:.05s">
            From your CAD files to finished<br />assets and B2B <span class="serif">channels</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            Send what you have: CAD exports, material and color references,
            prototype photos, spec sheets, or your trade-show calendar. A
            producer reads your brief within one business day, and our creative
            and social teams build the assets and run the feeds inside your
            workspace.
          </p>
        </header>

        {
          lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img src={c.image} alt={c.alt} width="1024" height="1024" loading="lazy" />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__p r" style="--d:.1s">{c.body}</p>
                <p class="feature__scope r" style="--d:.16s">In scope</p>
                <ul class="chips r" style="--d:.2s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ USE THE APP ============ -->
    <section class="appsec" id="app">
      <div class="shell appsec__grid">
        <div class="appsec__body">
          <p class="kicker r"><span class="kicker__tick"></span>Use the app</p>
          <h2 class="dh r" style="--d:.05s">
            Your marketing team’s own<br />assets and B2B <span class="serif">posts</span>.
          </h2>
          <p class="appsec__p r" style="--d:.1s">
            <strong>Pillar · Creative assets:</strong> Not every visual needs a
            studio brief. Your marketing team can place a studio render into a
            new industrial scene in the Image studio, turn a product still into
            a short clip in the Video studio, or crop and caption visuals for
            each network in the free browser Image and Video editors.
          </p>
          <p class="appsec__p r" style="--d:.14s">
            <strong>Pillar · Social networks:</strong> Group every asset, dealer
            sheet, and post for a product launch or trade show inside a
            Campaign. Draft and schedule company posts across LinkedIn, YouTube,
            X, Facebook, Instagram, and TikTok (Beta) to up to 20 accounts at
            once, and use Re-purpose to adapt one technical announcement for
            every channel.
          </p>
          <p class="appsec__p r" style="--d:.16s">
            Approved files live in the Assets Library with folders, tags, and
            versions, so sales and dealers always pull the current spec.
            Engineers who only need to inspect or sign off can join as Viewers
            at no cost.
          </p>
          <p class="r" style="--d:.18s">
            <a class="ghost-link" href="/app">
              See what the app does
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
        <div class="appsec__shots">
          <div class="r" style="--d:.08s">
            <AppShot shot={appShots.linkedin} path="/social/linkedin/posts" caption />
          </div>
          <div class="r" style="--d:.14s">
            <AppShot shot={appShots.libraryActions} path="/files" caption />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ TWO WAYS TO WORK ============ -->
    <WaysToWork
      tone="white"
      highlight="studio-app"
      pre="Two ways to work with "
      accent="us"
      post="."
      lead="Many manufacturers start by having our team turn CAD files into launch assets and B2B social campaigns inside the app, while marketing uses the same workspace for day-to-day product posts."
    />

    <!-- ============ ENGINEERING SIGN-OFF ON RECORD ============ -->
    <section class="record" id="approvals">
      <div class="shell record__grid">
        <div class="record__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Validation & audit trail</p>
          <h2 class="dh r" style="--d:.05s">
            A sign-off your<br />engineers can <span class="serif">trace</span>.
          </h2>
          <p class="record__lead r" style="--d:.08s">
            Before a render enters a dealer catalog or a technical post goes to
            LinkedIn, your engineers have the final word.
          </p>
          <p class="record__p r" style="--d:.12s">
            When you work with us in the app, our creatives and social managers
            submit every product visual, launch video, and scheduled post
            through Validation. Your engineers and marketers approve it in one
            click, or send it back with a comment.
          </p>
          <p class="record__p r" style="--d:.16s">
            Each version sits on one permanent thread, and nothing on that
            thread can be deleted. A social post waiting for engineering review
            is locked until sign-off. When a distributor asks whether the
            exploded view matches revision C, you can show who approved it and
            when.
          </p>
          <p class="record__p r" style="--d:.2s">
            Every approved render and post stays in your workspace’s History and
            Assets Library when the project ends.
          </p>
          <p class="record__more r" style="--d:.24s">
            <a class="ghost-link ghost-link--light" href="/studio/with-the-app">
              How working with us in the app works
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
        <div class="record__media r" style="--d:.1s">
          <AppShot shot={appShots.validationSend} path="/validation" caption dark />
        </div>
      </div>
    </section>

    <!-- ============ WHY HUBSTUDIO ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/who-we-are-studio.jpg"
                alt="A documentary frame of the hubStudio floor with calibrated stations, engineering proofs along the back wall and a quiet review session at one of the central monitors."
                width="1360"
                height="768"
                loading="lazy"
              />
            </div>
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48 hours</span>
            <span class="source__stat-cap">A written proposal after your brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why hubStudio</p>
          <h2 class="dh r" style="--d:.05s">
            A team that can read a CAD file<br />and run a B2B <span class="serif">feed</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Senior art directors and B2B social strategists lead every brief,
            with AI production underneath. Some assets are rendered from CAD or
            shot on location, others generated, and every piece is cut for the
            channels where your buyers actually look.
          </p>
          <p class="source__p r" style="--d:.16s">
            Two jobs show how this works. For a premium SUV, we built <a class="source__a" href="/work/premium-suv">the launch imagery for each market</a> without shipping the car anywhere. For iFlytek’s AI wearable, <a class="source__a" href="/work/iflytek-anypin">one launch film</a> mixed live shooting, CGI, and AIGC, then was cut for every social channel.
          </p>
          <p class="source__p r" style="--d:.22s">
            We record the provenance of every asset, so you can tell how each
            one was made. hubStudio was founded by Cyril Drouin, former CEO
            at Publicis.
          </p>
          <ul class="creds r" style="--d:.28s">
            {
              ['CAD to content', 'B2B social & WeChat', 'Provenance per asset', 'Engineering sign-off on record'].map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">unit</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What engineering and marketing leads ask us first.
          </p>
          <p class="faq__updated r" style="--d:.12s">Updated October 2026</p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ CLOSING ============ -->
    <DualCta
      lead="studio"
      briefQuery="way=studio-app"
      pre="Send us the "
      accent="files"
      post="."
      text="A CAD set, a trade-show date, or the product line and social channels you want to move next. A producer reads your brief within one business day. Or open the app for your marketing team at no cost."
    />
  </div>
</Layout>

<style>
  .page { --ink: #0e1633; --navy: #0e1f4e; --paper: #f0ede9; --paper-2: #e7e3dd; overflow-x: clip; }
  .shell { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: clamp(22px, 5vw, 60px); }
  .prog { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog__bar { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: 0 50%; background: var(--brand-orange); }
  .r, .r-clip { --d: 0s; }
  .r { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d); }
  .r.in { opacity: 1; transform: none; }
  .r-clip .crop__inner { clip-path: inset(0 0 101% 0); transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip .crop__inner img { transform: scale(1.12); transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: var(--d, 0s); }
  .r-clip.in .crop__inner { clip-path: inset(0 0 0 0); }
  .r-clip.in .crop__inner img { transform: scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .r, .r.in { opacity: 1; transform: none; transition: none; }
    .r-clip .crop__inner, .r-clip .crop__inner img { clip-path: none; transform: none; transition: none; }
  }
  .kicker { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-mute); }
  .kicker--light { color: rgba(240, 237, 233, 0.66); }
  .kicker__tick { width: 22px; height: 0; border-top: 1.5px solid var(--brand-orange); }
  .kicker__sep { color: var(--brand-orange); }
  .dh { font-family: var(--font-sans); font-weight: 600; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.02; letter-spacing: -0.03em; }
