---
/**
 * How we use AI  ·  /studio/ai-excellence (moved from the old studio path,
 * which 301s here).
 *
 * How the STUDIO uses AI: brand-trained models on GPU pipelines, human
 * direction and QA, the economics, the legal trail, and how the studio works
 * inside the hubStudio app. Copy comes from the content-quality-us deck
 * `studio-ai-excellence` (final.md). No ordinal numerals in any card or
 * repeated block: the five-stage pipeline carries its sequence through stage
 * names and visual order only, in an unnumbered list. Fact-band figures are
 * data with units attached, not ordinals, and come from the positioning file.
 *
 * Layout: image hero, overlapping fact card, an image-backed pillar trio,
 * asymmetric splits, an audience grid, a vertical pipeline, service cards, the
 * studio-inside-the-app split, engagement models, an FAQ, the insights layer
 * and the shared DualCta. Motion: page-load stagger in the hero,
 * scroll-reveal elsewhere, parallax on section media, count-up on the numeric
 * facts, plus a scroll-progress bar.
 */
import Layout from '../../layouts/Layout.astro';
import InsightsLayer from '../../components/InsightsLayer.astro';
import DualCta from '../../components/DualCta.astro';
import { BRIEF_URL } from '../../lib/links';

const heroChips = [
  'AIGC image',
  'AIGC video',
  'AIGC content',
  'Brand-trained models',
  'Prompt engineering',
];

/* Fact band. Figures from hubstudio-positioning.md only; a word-fact is set
   in the Playfair italic accent, per the style guide. */
const facts: { count?: number; suffix?: string; word?: string; label: string }[] = [
  { count: 48, suffix: 'h', label: 'From brief to a written proposal' },
  { word: 'One day', label: 'Until a producer has read your brief' },
  { count: 20, label: 'Service lines under one roof' },
  { word: 'Per asset', label: 'Provenance recorded on everything we deliver' },
];

/* The three crafts that make one studio. */
const unitePillars = [
  {
    name: 'Senior creative',
    desc: 'Art directors and designers from international agencies and the Chinese market.',
  },
  {
    name: 'AIGC specialists',
    desc: 'Engineers who run the studio’s GPU pipelines and train models on each brand.',
  },
  {
    name: 'Studio capabilities',
    desc: 'Producers, retouchers, and live photo and video shoots when a picture needs a camera. See it in client work like the iFlytek launch, which mixed a live shoot, CGI, and AIGC.',
  },
];

/* Who we work with. One creative angle each, written for hubStudio. */
const audiences = [
  {
    name: 'Agencies',
    desc: 'Production capacity when the work grows faster than the headcount.',
  },
  {
    name: 'Brand marketing teams',
    desc: 'Always-on content, from launch films to the weekly feed.',
  },
  {
    name: 'Retailers and eCommerce',
    desc: 'Thousands of SKUs in every format a marketplace asks for, held to one brand standard.',
  },
  {
    name: 'Manufacturers',
    desc: 'Global product libraries adapted so regional sales teams get assets that fit their market.',
  },
  {
    name: 'Procurement leads',
    desc: 'A clear price model (per asset, per project, or retainer) and a provenance record on every file you pay for.',
  },
];

/* Audience icon set: one consistent 1.7px stroke system drawn for hubStudio.
   Interlocking frames, campaign horn, price tag, product box, billing
   calendar. currentColor lets each card recolor them. */
const audienceIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="3" width="12" height="12" rx="2.6"/><rect x="9" y="9" width="12" height="12" rx="2.6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4a2 2 0 0 0 2 2h1l1.6 4.6"/><path d="M4 12 17 5.4v13.2L4 12Z"/><path d="M17.4 9.4a3.2 3.2 0 0 1 0 5.2"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.6 12.4 12 4h6.4v6.4L10 18.8a1.7 1.7 0 0 1-2.4 0l-4-4a1.7 1.7 0 0 1 0-2.4Z"/><circle cx="14.9" cy="9.1" r="1.4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 21 8v8l-9 5.2L3 16V8Z"/><path d="M3 8l9 5.2L21 8"/><path d="M12 13.2V21"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.4" y="4.6" width="17.2" height="16" rx="2.6"/><path d="M3.4 9.6h17.2"/><path d="M8 2.8v3.6M16 2.8v3.6"/><path d="M7.8 14.4 10.2 16.8 16 11"/></svg>',
];

/* The production pipeline. Five stages, sequence carried by name and order,
   no ordinal numerals. */
const pipeline = [
  {
    name: 'Brief',
    desc: 'We map objectives, brand codes, audiences, and channels with your team.',
    meta: 'One or two working sessions',
  },
  {
    name: 'Train',
    desc: 'Engineers train custom models, including LoRA, on your visual language and product library. The point is that the bottle on screen is your bottle, not a close cousin. For Noyz, we trained a model on fluid physics so its perfume’s mist-to-milk effect looked real on screen.',
    meta: 'Before volume production',
  },
  {
    name: 'Create',
    desc: 'Art directors generate options at volume, then narrow them to the strongest.',
    meta: 'Wide exploration, tight selection',
  },
  {
    name: 'Perfect',
    desc: 'Retouching, copy editing, and brand QA before anything leaves the studio.',
    meta: 'Final human pass',
  },
  {
    name: 'Deploy',
    desc: 'Files delivered in your formats, ready for social, eCommerce, paid media, and CRM.',
    meta: 'Channel-ready output',
  },
];

/* The three AIGC service lines, each linked to its solution page. */
const services = [
  {
    name: 'AIGC Image',
    img: '/Images/work/camper-hero.webp',
    w: 1440,
    h: 1920,
    alt: 'A Camper footwear campaign visual adapted across markets by hubStudio.',
    lead: 'Product shots, lifestyle visuals, and campaign assets that stay on brand.',
    detail: 'Product photography, seasonal campaigns, market adaptations, social assets.',
    href: '/solutions/ai-production/image',
    cta: 'AI image production',
  },
  {
    name: 'AIGC Video',
    img: '/Images/work/hisense-hero.webp',
    w: 1800,
    h: 1350,
    alt: 'A HiSense brand video frame produced through the hubStudio AIGC pipeline.',
    lead: 'Brand films, product videos, and social cuts, made with or without a camera.',
    detail: 'Short-form social, brand films, campaign cutdowns, cut for the feed they run in.',
    href: '/solutions/ai-production/video',
    cta: 'AI video production',
  },
  {
    name: 'AIGC Content',
    img: '/Images/work/age20-hero.webp',
    w: 1800,
    h: 2423,
    alt: 'An age20 beauty campaign asset created by the hubStudio content team.',
    lead: 'PR articles, storyboards, video scripts, email copy, product names, and web pages.',
    detail: 'One brand voice across every format.',
    href: '/solutions/ai-production/content',
    cta: 'AI content production',
  },
];

/* How studio work is scoped. Three models, most clients combine them. */
const engage = [
  {
    kicker: 'One-off',
    name: 'Creative AI Setup',
    desc: 'We define your visual language and train custom models, including LoRA, on the brand. It’s the foundation for everything after.',
  },
  {
    kicker: 'Monthly retainer',
    name: 'Ongoing content production',
    desc: 'A steady flow of text, images, and video, scoped to your channel mix and paced to your calendar.',
  },
  {
    kicker: 'Project-based',
    name: 'Studio services',
    desc: 'Live photo and video shoots when AI alone isn’t the right call, product image cleanup so generation starts from a better base, and delivery across social, web, and eCommerce.',
  },
];

/* FAQ: `a` is plain text for the JSON-LD; `html` adds the in-page links. */
const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: 'How long does a Creative AI Setup take?',
    a: 'It depends mostly on your brand library: how many products, how many looks, and how clean the reference images are. In our experience, a clean catalog shot on one background is quicker to train on than years of mixed campaign photography. The proposal gives a timeline once we’ve seen what you have.',
  },
  {
    q: 'What does monthly content production cost?',
    a: 'It depends on the volume and the mix of images, video, and copy. We price around what you actually need rather than a fixed package, quote after reading your brief, and send a written proposal within 48 hours. We don’t publish rates.',
    html: 'It depends on the volume and the mix of images, video, and copy. We price around what you actually need rather than a fixed package, quote after reading your brief, and send a written proposal within 48 hours. We don’t publish rates, but <a href="/pricing">the pricing page</a> explains each model.',
  },
  {
    q: 'Can you match the quality of a traditional photo shoot?',
    a: 'For most product, lifestyle, and campaign work, yes. High-end fashion, or a shoot that needs a specific person or place, is different. There we usually recommend a hybrid: live capture, finished with AIGC.',
  },
  {
    q: 'Can the studio work inside our hubStudio workspace?',
    a: 'Yes. Add our creatives as members of your team. We create from your balance, your admins approve in Validation, and everything stays in your History and Assets Library.',
    html: 'Yes. Add our creatives as members of your team. We create from your balance, your admins approve in Validation, and everything stays in your History and Assets Library. <a href="/studio/with-the-app">Studio + app</a> explains both setups.',
  },
  {
    q: 'Do you work with agencies?',
    a: 'Yes. Agencies brief the studio like any client. With Studio + app, we can work inside your agency’s hubStudio team, and your clients approve with their own logins. Our partner program covers referrals.',
    html: 'Yes. Agencies brief the studio like any client. With Studio + app, we can work inside your agency’s hubStudio team, and your clients approve with their own logins. <a href="/partners">Our partner program</a> covers referrals.',
  },
  {
    q: 'Where is your team based?',
    a: 'The studio is headquartered in Hong Kong, with studios in Shanghai and Changsha, a team in the Philippines, and an office in Paris.',
  },
];

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/studio/ai-excellence`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Studio', item: `${SITE}/studio` },
    { '@type': 'ListItem', position: 3, name: 'How we use AI', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="How our AI content studio works | hubStudio"
  description="How the hubStudio studio uses AI: GPU pipelines, brand-trained models, human QA, and a legal trail for every asset, in the app or outside it."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <!-- ===== S1: Hero ===== -->
  <section class="hero" id="top">
    <div class="hero__media">
      <img
        class="hero__bg"
        data-parallax
        data-parallax-speed="0.16"
        src="/Images/hubstudio-shanghai-studio.webp"
        alt="The hubStudio production floor in Shanghai, creatives at GPU workstations."
        width="1024"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="grain hero__grain" aria-hidden="true"></div>
    </div>

    <div class="container hero__inner">
      <nav class="hero__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/studio">Studio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">How we use AI</span>
      </nav>
      <p class="eyebrow hero__kicker">The studio</p>
      <h1 class="hero__title">
        <span class="hero__w">How we use</span>
        <span class="hero__w hero__w--accent">AI</span>
      </h1>
      <p class="hero__lede">Models trained on your brand, directed by people who know it.</p>
      <p class="hero__intro">
        The hubStudio studio runs its own AI production. Our engineers maintain the pipelines,
        we train models on your brand, and senior art directors decide what ships. This page
        walks through how it works, including when we work inside the hubStudio app.
      </p>
      <ul class="hero__chips">
        {heroChips.map((c) => <li class="hero__chip">{c}</li>)}
      </ul>
      <div class="hero__meta">
        <span class="hero__meta-item">Senior art directors on every brief</span>
        <span class="hero__meta-item">
          Hong Kong, Shanghai, Changsha, the Philippines, and Paris
        </span>
      </div>
    </div>

    <a class="hero__cue" href="#one-studio" aria-label="Scroll to read more">
      <span class="hero__cue-label">Scroll</span>
      <span class="hero__cue-line" aria-hidden="true"></span>
    </a>

    <svg class="hero__cube" viewBox="0 0 32 35" aria-hidden="true">
      <path d="M16 4 28 11 16 18 4 11Z" fill="var(--brand-orange)" />
      <path d="M4 11 16 18 16 31 4 24Z" fill="#fff" opacity="0.85" />
      <path d="M28 11 16 18 16 31 28 24Z" fill="#fff" opacity="0.55" />
    </svg>
  </section>

  <!-- ===== S2: Facts (overlapping card) ===== -->
  <section class="stats">
    <div class="container">
      <div class="stats__card">
        {
          facts.map((s, i) => (
            <article class="stat" data-reveal style={`--i:${i}`}>
              {s.count !== undefined ? (
                <span class="stat__num">
                  <span class="stat__count" data-count={s.count}>
                    {s.count}
                  </span>
                  {s.suffix && <span class="stat__suffix">{s.suffix}</span>}
                </span>
              ) : (
                <span class="stat__num stat__num--word">{s.word}</span>
              )}
              <span class="stat__label">{s.label}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== S3: Three crafts, one studio ===== -->
  <section class="unite" id="one-studio">
    <div class="unite__media">
      <img
        class="unite__bg"
        data-parallax
        data-parallax-speed="0.12"
        src="/Images/who-we-are-office.webp"
        alt="The hubStudio team at workstations in a bright open-plan studio."
        width="1050"
        height="573"
        loading="lazy"
      />
      <div class="unite__scrim" aria-hidden="true"></div>
      <div class="grain unite__grain" aria-hidden="true"></div>
    </div>
    <div class="container unite__inner">
      <header class="unite__head">
        <p class="eyebrow unite__eyebrow" data-reveal>Human-led, AI-generated</p>
        <h2 class="unite__title" data-reveal>
          Three crafts, one <span class="accent">studio</span>
        </h2>
        <p class="unite__intro" data-reveal>
          The people who direct the work and the people who run the models sit on the same
          brief.
        </p>
      </header>
      <ul class="unite__pillars">
        {
          unitePillars.map((p, i) => (
            <li class="upillar" data-reveal style={`--i:${i}`}>
              <span class="upillar__bar" aria-hidden="true" />
              <h3 class="upillar__name">{p.name}</h3>
              <p class="upillar__desc">{p.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== S4: Where we fit ===== -->
  <section class="section studio">
    <div class="container studio__grid">
      <div class="studio__copy">
        <p class="eyebrow accent-eyebrow" data-reveal>Where we fit</p>
        <h2 class="headline h2 studio__head" data-reveal>
          Anyone can use the engines. Knowing what to <span class="accent">ship</span> is the
          hard part.
        </h2>
        <p class="studio__p" data-reveal>
          The leading image and video engines are open to anyone now, including in
          <a href="/app">the hubStudio app</a>, where your own team can use them. So the engine
          isn’t what sets the work apart anymore.
        </p>
        <p class="studio__p" data-reveal>
          Direction does. Somebody has to pick the output that fits the brand and fix the one
          that’s almost right.
        </p>
        <p class="studio__p" data-reveal>
          Traditional studios have the craft, but their pace and cost don’t fit a weekly content
          calendar. Your own team in the app is fast and fully in your hands, and that’s the
          right call when you have people who can direct the engines. The studio sits between the
          two: our art directors direct the engines for you and sign off on every asset.
        </p>
      </div>

      <figure class="studio__media" data-reveal>
        <div class="media-frame media-frame--tall">
          <img
            data-parallax
            data-parallax-speed="0.08"
            src="/Images/who-we-are-studio.jpg"
            alt="A photographer shooting a product on a lit set inside the hubStudio space."
            width="1360"
            height="768"
            loading="lazy"
          />
        </div>
        <span class="studio__badge">AI lifts. Senior creatives sign off.</span>
      </figure>
    </div>
  </section>

  <!-- ===== S5: East and West ===== -->
  <section class="section markets">
    <div class="container markets__grid">
      <figure class="markets__media" data-reveal>
        <div class="media-frame media-frame--tall">
          <img
            data-parallax
            data-parallax-speed="0.1"
            src="/Images/who-we-are-china-speed.jpg"
            alt="A Chinese production crew working across Western and Chinese platform formats."
            width="768"
            height="1360"
            loading="lazy"
          />
        </div>
      </figure>
      <div class="markets__copy">
        <p class="eyebrow accent-eyebrow" data-reveal>Two ecosystems</p>
        <h2 class="headline h2 markets__head" data-reveal>
          East and West, under one <span class="accent">roof</span>
        </h2>
        <p class="markets__lead" data-reveal>
          Most studios know one ecosystem. We work in both.
        </p>
        <p class="markets__p" data-reveal>
          On the Western side, Google, Meta, and the global creative stack. On the Chinese side,
          Alibaba, ByteDance, Tencent, and the local AIGC tools that outside teams rarely use
          well.
        </p>
        <p class="markets__p" data-reveal>
          Our bench mixes international agency veterans with Chinese designers and art
          directors. The studio’s founder, Cyril Drouin, is a former CEO at Publicis.
        </p>
        <blockquote class="pull-quote pull-quote--inline" data-reveal>
          <p class="pull-quote__text">
            After twenty years going back and forth between Western and Chinese digital
            ecosystems, one thing is obvious. You cannot brief your way to cultural relevance.
            You have to hire it.
          </p>
          <footer class="pull-quote__by">Cyril Drouin, Founder, hubStudio</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ===== S6: Who we work with ===== -->
  <section class="section audiences">
    <div class="container">
      <header class="audiences__head">
        <p class="eyebrow accent-eyebrow" data-reveal>Who we work with</p>
        <h2 class="headline h2" data-reveal>
          Built for teams that ship at <span class="accent">scale</span>
        </h2>
      </header>
      <ul class="audiences__grid">
        {
          audiences.map((a, i) => (
            <li class="aud" data-reveal style={`--i:${i % 3}`}>
              <span class="aud__icon" set:html={audienceIcons[i]} />
              <h3 class="aud__name">{a.name}</h3>
              <p class="aud__desc">{a.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== S7: How the pipeline works ===== -->
  <section class="pipeline">
    <div class="container">
      <header class="pipeline__head">
        <p class="eyebrow pipeline__eyebrow" data-reveal>How the work moves</p>
        <h2 class="pipeline__title" data-reveal>
          How the <span class="accent">pipeline</span> works
        </h2>
        <p class="pipeline__intro" data-reveal>
          Five stages. Each one has a named owner, and each one ends with something you can look
          at.
        </p>
      </header>
      <ul class="flow">
        {
          pipeline.map((stage, i) => (
            <li class="stage" data-reveal style={`--i:${i % 3}`}>
              <span class="stage__mark" aria-hidden="true" />
              <div class="stage__body">
                <h3 class="stage__name">{stage.name}</h3>
                <p class="stage__desc">{stage.desc}</p>
              </div>
              <span class="stage__meta">{stage.meta}</span>
            </li>
          ))
        }
      </ul>
      <p class="pipeline__close" data-reveal>
        Working inside the hubStudio app? Then each version also passes through Validation, where
        your approvers sign off on one thread.
      </p>
    </div>
  </section>

  <!-- ===== S8: Why AIGC changes the economics ===== -->
  <section class="section economics">
    <div class="container economics__inner">
      <div class="economics__lead-col">
        <p class="eyebrow accent-eyebrow" data-reveal>The new economics</p>
        <h2 class="headline h2 economics__head" data-reveal>
          Why AIGC changes the <span class="accent">economics</span> of content
        </h2>
        <p class="economics__p" data-reveal>
          Anyone who has budgeted a shoot knows the line items: props, talent fees, location
          rentals, crew. On more and more of our briefs, those lines shrink. On some, they go
          away. The money goes into GPUs, trained models, and the people who direct them instead.
        </p>
      </div>
      <div class="economics__side">
        <p class="economics__p" data-reveal>
          That changes what you can afford to make, because each platform now wants its own cut,
          and each market its own version. A plan built around one big shoot a quarter can’t keep
          up. More output only helps if someone keeps it on-brand.
        </p>
        <p class="economics__p" data-reveal>
          In practice, that buys room. You can test a hundred concepts instead of five, or try a
          bold idea without betting a shoot on it. Each market can get its own version that
          respects local habits, not a translated headline on a Western picture. Nobody rents
          props or keeps a crew on standby, and what you learn from one round of assets shapes
          the next. The brand still has to be recognizable at the end of all that.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== S9: Our AIGC services ===== -->
  <section class="section services">
    <div class="container">
      <header class="services__head">
        <p class="eyebrow accent-eyebrow" data-reveal>What we make</p>
        <h2 class="headline h2" data-reveal>
          Our AIGC <span class="accent">services</span>
        </h2>
      </header>
      <div class="services__grid">
        {
          services.map((svc, i) => (
            <article class="svc" data-reveal style={`--i:${i}`}>
              <div class="svc__media">
                <img src={svc.img} alt={svc.alt} width={svc.w} height={svc.h} loading="lazy" />
              </div>
              <div class="svc__body">
                <h3 class="svc__name">{svc.name}</h3>
                <p class="svc__lead">{svc.lead}</p>
                <p class="svc__detail">{svc.detail}</p>
                <a class="svc__link" href={svc.href}>
                  {svc.cta}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M5 12h13M12 5l7 7-7 7"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <a class="services__all" href="/work" data-reveal>
        See the finished work <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- ===== S10: Inside the hubStudio app ===== -->
  <section class="section inapp">
    <div class="container inapp__grid">
