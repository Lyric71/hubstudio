---
/**
 * The studio hub  ·  /studio
 *
 * The Studio pillar of the site: what the studio is, the two studio ways to
 * work (Studio + app, Studio only) inside the shared WaysToWork band, the
 * twenty service lines grouped six ways (each group carries an anchor id, and
 * each line links to its /services/design/* page), how a project runs, who
 * works on it, proof from src/data/case-studies.ts, the platforms we produce
 * for, an FAQ and the closing DualCta with the studio door first.
 *
 * Replaces the old /services index (/services now 301s here). Copy comes from
 * the content-quality-us deck `studio` (final.md). No ordinal numerals in any
 * card, step or repeated block; sequence is carried by order alone.
 */
import Layout from '../../layouts/Layout.astro';
import WaysToWork from '../../components/WaysToWork.astro';
import DualCta from '../../components/DualCta.astro';
import InsightsLayer from '../../components/InsightsLayer.astro';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';
import { caseStudies } from '../../data/case-studies';

type Service = { name: string; href: string; img: string; alt: string; desc: string };
type Category = { id: string; title: string; blurb: string; intro: string; services: Service[] };

const categories: Category[] = [
  {
    id: 'content-social',
    title: 'Content & Social',
    blurb: 'The assets that ship every week.',
    intro:
      'This is work with a calendar attached. Social posts, ad creative, short video, and email run on the same clock: something has to go out this week, in the right format, for a feed that punishes anything recycled. Brands call us when their team makes good work but not enough of it.',
    services: [
      {
        name: 'Social Media',
        href: '/services/design/social-media',
        img: '/Images/sm-hero.jpg',
        alt: 'A content creator in a sunlit Shanghai loft holding a vertical smartphone close to her face.',
        desc: 'Posts, carousels, and stories made for each feed.',
      },
      {
        name: 'Ad Creative',
        href: '/services/design/ad-creative',
        img: '/Images/ac-hero.jpg',
        alt: 'Overhead view of a creative workspace with a phone showing a paused vertical-video ad.',
        desc: 'Ads built in variants, so you can test and keep the winners.',
      },
      {
        name: 'Short Video',
        href: '/services/design/short-video',
        img: '/Images/sv-hero.jpg',
        alt: 'A short-video creator filming on a tripod-mounted phone in a warm-lit Shanghai studio.',
        desc: 'Vertical video for TikTok, Reels, and Douyin.',
      },
      {
        name: 'Email Design',
        href: '/services/design/email-design',
        img: '/Images/emd-p4-build.jpg',
        alt: 'A laptop showing an HTML email code editor beside a live email preview.',
        desc: 'Campaigns and lifecycle emails, designed and coded.',
      },
    ],
  },
  {
    id: 'video-motion',
    title: 'Video & Motion',
    blurb: 'Moving images, long and short.',
    intro:
      'Film work, from a scripted brand piece to an ident that has to read in half a second. Much of it is hybrid: a real plate finished with generated elements, or a generated sequence graded like a shoot. A director signs off on every cut.',
    services: [
      {
        name: 'Video Production',
        href: '/services/design/video-production',
        img: '/Images/vp-hero.jpg',
        alt: 'A director of photography behind a cinema camera on a darkened studio set.',
        desc: 'Script to final cut, shot on set, generated, or both.',
      },
      {
        name: 'Motion Design',
        href: '/services/design/motion-design',
        img: '/Images/md-ident.jpg',
        alt: 'A frosted glass fragrance bottle wrapped in drifting incense smoke under a warm sidelight.',
        desc: 'Idents, explainers, and motion graphics.',
      },
    ],
  },
  {
    id: 'commerce-web',
    title: 'Commerce & Web',
    blurb: 'Everything that sells or hosts.',
    intro:
      'Content with a conversion rate attached: product visuals, storefronts, site pages, and print. Catalog scale is the usual reason brands call. Think a few hundred products that have to look identical on a marketplace listing and in a paid ad. We set up the rules before we make the pictures.',
    services: [
      {
        name: 'eCommerce',
        href: '/services/design/ecommerce',
        img: '/Images/ecom-hero.jpg',
        alt: 'A single matte white ceramic skincare bottle on a soft warm beige paper backdrop.',
        desc: 'Product visuals for listings, storefronts, and ads.',
      },
      {
        name: 'Website Design',
        href: '/services/design/website-design',
        img: '/Images/wd-hero.jpg',
        alt: 'A 16-inch laptop on a warm walnut desk in a sunlit studio.',
        desc: 'Pages designed for every screen size.',
      },
      {
        name: 'Print Design',
        href: '/services/design/print-design',
        img: '/Images/print-hero.jpg',
        alt: 'A hardcover monograph and a bound editorial catalog open on a plaster worktable.',
        desc: 'Press-ready catalogs, brochures, and editorial.',
      },
    ],
  },
  {
    id: 'strategy-direction',
    title: 'Strategy & Direction',
    blurb: 'The thinking before the pixels.',
    intro:
      'The work that decides what gets made, from where a brand sits in its market down to the frames a film will be built from. Anyone can now produce a thousand variations overnight. Picking the right one, and being able to say why, is the hard part.',
    services: [
      {
        name: 'Marketing Strategy',
        href: '/services/design/marketing-strategy',
        img: '/Images/ms-hero.jpg',
        alt: 'A marketing strategist working at a long oak table in a Shanghai studio.',
        desc: 'The plan behind the content, market by market.',
      },
      {
        name: 'Creative Strategy',
        href: '/services/design/creative-strategy',
        img: '/Images/cs-hero.jpg',
        alt: 'A strategy wall in a Shanghai studio pinned with a printed positioning statement.',
        desc: 'One idea that every asset ties back to.',
      },
      {
        name: 'Concept Creation',
        href: '/services/design/concept-creation',
        img: '/Images/cc-hero.jpg',
        alt: 'A creative director reviewing printed campaign key-visual mockups pinned to a wall.',
        desc: 'The campaign idea, locked before production starts.',
      },
      {
        name: 'Storyboard',
        href: '/services/design/storyboard',
        img: '/Images/sb-hero.jpg',
