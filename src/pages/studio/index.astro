        desc: 'Logos, systems, and guidelines built to scale.',
      },
      {
        name: 'Illustration Design',
        href: '/services/design/illustration-design',
        img: '/Images/illustration-hero.jpg',
        alt: 'An illustrator’s worktable with a graphics tablet showing an editorial illustration.',
        desc: 'Custom illustration drawn in your brand’s style.',
      },
      {
        name: 'Packaging & Merch Design',
        href: '/services/design/packaging-merch-design',
        img: '/Images/packaging-merch-aurele.jpg',
        alt: 'A serum bottle and carton styled as one art-directed shot on a plaster ledge.',
        desc: 'Packaging and merchandise, from dieline to shelf.',
      },
    ],
  },
  {
    id: 'sales-communications',
    title: 'Sales & Communications',
    blurb: 'Decks, documents, and news.',
    intro:
      'The documents a business is judged on when it isn’t in the room, like the investor deck or the announcement that either gets picked up or doesn’t. Usually the content exists somewhere. What’s missing is the structure and the design.',
    services: [
      {
        name: 'Presentation Design',
        href: '/services/design/presentation-design',
        img: '/Images/presentation-design-hero.jpg',
        alt: 'An open laptop showing a clean deck slide with a minimalist growth chart.',
        desc: 'Sales and board decks with a clear argument.',
      },
      {
        name: 'Pitch Deck',
        href: '/services/design/pitch-deck',
        img: '/Images/pitch-hero.jpg',
        alt: 'A founder pitching to two investors in a quiet meeting room.',
        desc: 'Investor and client pitches, story first.',
      },
      {
        name: 'Ebook and Digital Reports',
        href: '/services/design/ebook-digital-reports',
        img: '/Images/edr-hero.jpg',
        alt: 'A hardcover bound annual report lying open on a warm walnut desk.',
        desc: 'Long-form reports and guides, laid out to be read.',
      },
      {
        name: 'Press Release',
        href: '/services/design/press-release',
        img: '/Images/pr-hero.jpg',
        alt: 'A journalist reading a printed multi-page press release at a sunlit newsroom desk.',
        desc: 'Announcements written and designed for editors.',
      },
    ],
