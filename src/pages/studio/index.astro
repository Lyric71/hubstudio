  .studio-page {
    --shadow-sheet: 0 -30px 64px -36px rgba(10, 10, 20, 0.42);
    --shadow-sheet-dark: 0 -36px 80px -34px rgba(0, 0, 0, 0.65);
    --shadow-card: 0 2px 6px rgba(10, 10, 20, 0.04),
      0 14px 30px -12px rgba(10, 10, 20, 0.12);
    --shadow-card-hi: 0 8px 20px rgba(10, 10, 20, 0.08),
      0 36px 64px -24px rgba(10, 10, 20, 0.28);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    position: relative;
    overflow-x: clip;
  }

  /* Scroll progress bar */
  .scrollbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .scrollbar__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--pillar-create), #ff9a5c, var(--pillar-publish));
  }

  /* Floating Section Quick-Dock */
  .st-dock {
    position: fixed;
    left: 50%;
    bottom: 22px;
    transform: translate(-50%, 140%);
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.88);
    border: 1px solid rgba(240, 237, 233, 0.18);
    backdrop-filter: blur(14px);
    box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.45s var(--ease),
      opacity 0.35s ease;
    max-width: calc(100vw - 24px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .st-dock::-webkit-scrollbar {
    display: none;
  }
  .st-dock.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }
  .st-dock__pill {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: rgba(240, 237, 233, 0.74);
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .st-dock__pill:hover,
  .st-dock__pill.is-active {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .st-dock__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .st-dock__pill--create .st-dock__dot {
    background: var(--pillar-create);
  }
  .st-dock__pill--publish .st-dock__dot {
    background: #60a5fa;
  }
  .st-dock__cta {
    flex: none;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--brand-orange-cta);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: transform 0.2s ease;
  }
  .st-dock__cta:hover {
    transform: translateY(-2px);
  }

  /* Reveal motion */
  [data-reveal] {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.75s var(--ease),
      transform 0.75s var(--ease);
    transition-delay: calc(var(--i, 0) * 85ms);
    will-change: opacity, transform;
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* 3D Tilt & Pointer Glow */
  [data-tilt] {
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.35s var(--ease);
  }

  /* Sheets */
  .sheet {
    position: relative;
    border-radius: clamp(28px, 3.6vw, 60px) clamp(28px, 3.6vw, 60px) 0 0;
    margin-top: clamp(-60px, -4.6vw, -40px);
  }
  .sheet--first {
    z-index: 2;
  }
  .sheet--light {
    background: var(--bg-white);
    box-shadow: var(--shadow-sheet);
  }
  .sheet--cream {
    background: var(--bg-cream);
    box-shadow: var(--shadow-sheet);
  }
  .sheet--ink {
    background: var(--bg-ink);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-sheet-dark);
    overflow: hidden;
  }
  .sheet--navy {
    background: var(--brand-navy-deep);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-sheet-dark);
    overflow: hidden;
  }
  .section {
    padding-block: clamp(96px, 11vw, 164px);
  }
  .sheet__grain {
    position: absolute;
    inset: 0;
    opacity: 0.42;
    pointer-events: none;
  }
  .sheet .container {
    position: relative;
    z-index: 1;
  }
  [id] {
    scroll-margin-top: calc(var(--nav-h) + 28px);
  }

  /* Pointer spotlight on dark sections */
  .sheet--navy::before,
  .st-hero::before {
    content: '';
    position: absolute;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    left: var(--sx, 50%);
    top: var(--sy, 30%);
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(233, 78, 27, 0.16), transparent 64%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }
  .sheet--navy[data-lit]::before,
  .st-hero[data-lit]::before {
    opacity: 1;
  }

  /* Section Headers */
  .s-head {
    max-width: 720px;
    margin-bottom: clamp(44px, 5.5vw, 76px);
    display: grid;
    gap: 16px;
  }
  .s-head--row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
  }
  .s-head--row .eyebrow {
    margin-bottom: 12px;
  }
  .s-head--row .s-head__intro {
    max-width: 44ch;
    padding-bottom: 4px;
  }
  .s-head__intro {
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
    max-width: 60ch;
  }
  .s-head--dark .headline {
    color: #fff;
  }
  .s-head--dark .s-head__intro {
    color: rgba(240, 237, 233, 0.78);
  }
  .eyebrow--orange {
    color: var(--brand-orange);
  }
  .eyebrow--publish {
    color: #60a5fa;
  }
  .headline .accent,
  .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--brand-orange);
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--brand-orange-cta);
  }
  .arrow-link--publish {
    color: var(--pillar-publish);
  }
  .arrow-link--light {
    color: var(--text-on-dark);
  }
  .arrow {
    display: inline-block;
    transition: transform 220ms var(--ease);
  }
  .arrow-link:hover .arrow {
    transform: translateX(6px);
  }

  /* ============================================================
     S1 · Dark Cinematic Hero
  ============================================================ */
  .st-hero {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: var(--bg-ink);
    color: var(--text-on-dark);
    margin-top: calc(-1 * var(--nav-h));
    padding-top: calc(var(--nav-h) + clamp(36px, 5vw, 72px));
    padding-bottom: clamp(104px, 10vw, 156px);
  }
  .st-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .st-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.48;
  }
  .st-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(76px);
    opacity: 0.44;
  }
  .st-hero__orb--create {
    width: 580px;
    height: 580px;
    left: -140px;
    top: -120px;
    background: radial-gradient(circle, rgba(233, 78, 27, 0.52), transparent 68%);
  }
  .st-hero__orb--publish {
    width: 620px;
    height: 620px;
    right: -140px;
    bottom: -140px;
    background: radial-gradient(circle, rgba(63, 111, 224, 0.56), transparent 68%);
  }
  .st-hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 30%, transparent 90%);
  }

  .st-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(44px, 5vw, 68px);
  }
  .st-hero__main {
    display: grid;
    gap: clamp(36px, 4.5vw, 56px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .st-hero__main {
      grid-template-columns: 1.04fr 0.96fr;
    }
  }

  .st-crumbs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.62);
  }
  .st-crumbs a:hover {
    color: var(--brand-orange);
  }
  .st-hero__eyebrow {
    margin-bottom: 16px;
  }
  .st-hero__title {
    margin: 0;
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    font-size: clamp(42px, 5.6vw, 76px);
  }
  .st-hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .st-hero__title .line > span {
    display: block;
    animation: heroLine 0.95s cubic-bezier(0.16, 0.84, 0.3, 1) both;
  }
  .st-hero__title .line:nth-child(1) > span {
    animation-delay: 0.12s;
  }
  .st-hero__title .line:nth-child(2) > span {
    animation-delay: 0.24s;
  }
  .st-hero__title .line:nth-child(3) > span {
    animation-delay: 0.36s;
  }
  @keyframes heroLine {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }

  .st-hero__lead {
    margin-top: 22px;
    font-size: var(--type-body);
    line-height: 1.64;
    color: rgba(240, 237, 233, 0.84);
    max-width: 56ch;
  }
  .st-hero__actions {
    margin-top: 30px;
    display: grid;
    gap: 14px;
  }
  .st-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .st-hero__alt {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.68);
  }
  .st-hero__alt a {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .st-hero__alt a:hover {
    color: var(--brand-orange);
  }

  /* Hero Right Stage */
  .st-hero__stage {
    position: relative;
    display: grid;
    gap: 16px;
  }
  .st-hero__frame {
    position: relative;
    margin: 0;
    border-radius: clamp(22px, 2.4vw, 32px);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 32px 72px -28px rgba(0, 0, 0, 0.75);
  }
  .st-hero__frame img {
    width: 100%;
    height: 116%;
    object-fit: cover;
    object-position: 30% 50%;
    will-change: transform;
  }
  .st-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(14, 22, 51, 0.78) 100%);
  }
  .st-hero__badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }
  .st-hero__badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
  }

  /* Hero Interactive Dual-Pillar Cards */
  .st-hero__pillars {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 560px) {
    .st-hero__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .st-hpil {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s var(--ease);
  }
  .st-hpil::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    background: radial-gradient(
      240px circle at var(--mx, 50%) var(--my, 50%),
      var(--hpil-glow, rgba(233, 78, 27, 0.25)),
      transparent 70%
    );
  }
  .st-hpil:hover::before {
    opacity: 1;
  }
  .st-hpil--create {
    --hpil-c: var(--pillar-create);
    --hpil-glow: rgba(233, 78, 27, 0.26);
    border-top: 3px solid var(--pillar-create);
  }
  .st-hpil--publish {
    --hpil-c: #60a5fa;
    --hpil-glow: rgba(96, 165, 250, 0.26);
    border-top: 3px solid #60a5fa;
  }
  .st-hpil:hover {
    border-color: var(--hpil-c);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.65);
  }
  .st-hpil__top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .st-hpil__kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hpil-c);
  }
  .st-hpil__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hpil-c);
  }
  .st-hpil__pill {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(240, 237, 233, 0.82);
  }
  .st-hpil__title {
    position: relative;
    z-index: 1;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .st-hpil__desc {
    position: relative;
    z-index: 1;
    font-size: var(--type-body);
    line-height: 1.52;
    color: rgba(240, 237, 233, 0.76);
  }
  .st-hpil__cta {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--hpil-c);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Hero Bottom SLA Stats Ribbon */
  .st-hero__stats {
    display: grid;
    gap: 18px;
    padding-top: clamp(28px, 3.5vw, 44px);
    border-top: 1px solid rgba(240, 237, 233, 0.14);
  }
  @media (min-width: 640px) {
    .st-hero__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .st-hero__stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }
  }
  .st-hstat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .st-hstat__val {
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .st-hstat__val i {
    font-style: normal;
    color: var(--brand-orange);
    margin-left: 2px;
  }
  .st-hstat__val--word {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .st-hstat__lbl {
    font-size: var(--type-small);
    line-height: 1.45;
    color: rgba(240, 237, 233, 0.74);
  }

  /* ============================================================
     S2 · Two-Pillar Architecture Explorer
  ============================================================ */
  .pil-arch {
    display: grid;
    gap: var(--gap-card);
  }
  @media (min-width: 960px) {
    .pil-arch {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pil-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: clamp(28px, 3.4vw, 44px);
    border-radius: var(--radius-card);
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    border-top: 5px solid var(--pil-color, var(--pillar-create));
    box-shadow: var(--shadow-card);
  }
  .pil-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 50%),
      var(--pil-glow, rgba(233, 78, 27, 0.12)),
      transparent 70%
    );
  }
  .pil-card:hover::before {
    opacity: 1;
  }
  .pil-card--create {
    --pil-color: var(--pillar-create);
    --pil-glow: rgba(233, 78, 27, 0.12);
  }
  .pil-card--publish {
    --pil-color: var(--pillar-publish);
    --pil-glow: rgba(63, 111, 224, 0.12);
  }
  .pil-card__head {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 16px;
  }
  .pil-card__badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .pil-card__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pil-color);
  }
  .pil-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pil-color);
  }
  .pil-card__count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pil-card__title-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .pil-card__icon {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    color: var(--text-ink);
  }
  .pil-card__icon svg {
    width: 28px;
    height: 28px;
  }
  .pil-card__icon .ic-accent {
    fill: var(--pil-color);
  }
  .pil-card__title {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .pil-card__body {
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
  }
  .pil-card__groups {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--line-strong);
  }
  .pil-card__sublabel {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pil-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pil-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  .pil-pill:hover {
    background: var(--pil-color);
    border-color: var(--pil-color);
    color: #fff;
    transform: translateY(-2px);
  }
  .pil-pill__arr {
    font-size: 12px;
    opacity: 0.65;
    transition: transform 0.2s ease;
  }
  .pil-pill:hover .pil-pill__arr {
    opacity: 1;
    transform: translateX(3px);
  }
  .pil-card__foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line-hairline);
  }
  .pil-card__sec-link {
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-mute);
  }
  .pil-card__sec-link:hover {
    color: var(--text-ink);
  }

  /* Connected Shared Foundation Bar */
  .pil-bridge {
    margin-top: 24px;
    padding: 24px 30px;
    border-radius: 24px;
    background: var(--bg-ink);
    color: var(--text-on-dark);
    border-top: 3px solid var(--pillar-library);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    box-shadow: var(--shadow-card);
  }
  .pil-bridge__left {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    max-width: 68ch;
  }
  .pil-bridge__dot {
    flex: none;
    margin-top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pillar-library);
    box-shadow: 0 0 12px var(--pillar-library);
  }
  .pil-bridge__title {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: #fff;
  }
  .pil-bridge__text {
    margin-top: 4px;
    font-size: var(--type-body);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.78);
  }
  .pil-bridge .btn--secondary {
    color: #fff;
    border-color: rgba(240, 237, 233, 0.32);
  }

  /* ============================================================
     S3 · Pillar 1: Creative Assets Studio Deck
  ============================================================ */
  .ca-toolbar {
    position: sticky;
    top: calc(var(--nav-h) + 12px);
    z-index: 20;
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }
  .ca-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 7px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--line-strong);
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 32px -16px rgba(10, 10, 20, 0.18);
  }
  @media (max-width: 959.98px) {
    .ca-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: 20px;
      scrollbar-width: none;
    }
    .ca-tabs::-webkit-scrollbar {
      display: none;
    }
  }
  .ca-tab {
    flex: 1;
    min-width: max-content;
    appearance: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-mute);
    transition:
      background-color 0.22s ease,
      color 0.22s ease,
      box-shadow 0.22s ease;
  }
  .ca-tab:hover {
    color: var(--text-ink);
    background: rgba(10, 10, 20, 0.04);
  }
  .ca-tab__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
  }
  .ca-tab__badge {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 99px;
    background: rgba(10, 10, 20, 0.07);
    color: inherit;
  }
  .ca-tab.is-on {
    background: var(--bg-ink);
    color: #fff;
    box-shadow: 0 8px 20px -8px rgba(10, 10, 20, 0.45);
  }
  .ca-tab.is-on .ca-tab__dot {
    background: var(--pillar-create);
    opacity: 1;
  }
  .ca-tab.is-on .ca-tab__badge {
    background: rgba(255, 255, 255, 0.16);
  }

  .ca-groups {
    display: grid;
    gap: clamp(56px, 7vw, 96px);
  }
  .ca-cat[hidden] {
    display: none;
  }
  .ca-cat__banner {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 20px;
    padding: clamp(24px, 3vw, 36px);
    margin-bottom: 24px;
    border-radius: 24px;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-left: 4px solid var(--pillar-create);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 900px) {
    .ca-cat__banner {
      grid-template-columns: 0.95fr 1.05fr;
      align-items: end;
      gap: 48px;
    }
  }
  .ca-cat__eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .ca-cat__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pillar-create);
  }
  .ca-cat__craft {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--bg-cream);
    color: var(--text-mute);
  }
  .ca-cat__title {
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .ca-cat__blurb {
    margin-top: 6px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--text-mute);
  }
  .ca-cat__intro {
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-ink);
  }

  .ca-grid {
    display: grid;
    gap: var(--gap-card);
  }
  @media (min-width: 640px) {
    .ca-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .ca-grid--n3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ca-grid--n4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ca-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  .ca-card:hover {
    transform: translateY(-6px);
    border-color: rgba(233, 78, 27, 0.45);
    box-shadow: var(--shadow-card-hi);
  }
  .ca-card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-cream);
  }
  .ca-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .ca-card:hover .ca-card__media img {
    transform: scale(1.06);
  }
  .ca-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 20, 0.28) 0%, transparent 45%);
  }
  .ca-card__tag {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.8);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ca-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
  }
  .ca-card__name {
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.22;
  }
  .ca-card__desc {
    font-size: var(--type-body);
    line-height: 1.56;
    color: var(--text-mute);
  }
  .ca-card__cta {
    margin-top: auto;
    padding-top: 12px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange-cta);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ca-card:hover .ca-card__cta .arrow {
    transform: translateX(5px);
  }

  .ca-aside {
    margin-top: clamp(48px, 6vw, 72px);
    padding: 26px 32px;
    border-radius: 24px;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 32px;
  }
  .ca-aside__text {
    font-size: var(--type-body);
    line-height: 1.6;
    max-width: 60ch;
  }
  .ca-aside__text a {
    color: var(--brand-orange-cta);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============================================================
     S4 · Pillar 2: Social Networks Command Studio
  ============================================================ */
  .soc-studio {
    --soc-scroll: 0;
  }
  .soc-ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .soc-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(84px);
    opacity: 0.42;
    will-change: transform;
  }
  .soc-orb--a {
    width: 580px;
    height: 580px;
    top: -120px;
    right: -80px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.58), transparent 68%);
    transform: translate3d(0, calc(var(--soc-scroll) * 160px), 0);
  }
  .soc-orb--b {
    width: 520px;
    height: 520px;
    bottom: -140px;
    left: -100px;
    background: radial-gradient(circle, rgba(233, 78, 27, 0.36), transparent 68%);
    transform: translate3d(0, calc(var(--soc-scroll) * -140px), 0);
  }
  .soc-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 35%, transparent 100%);
  }

  /* Scroll-reactive workflow pipeline bar */
  .soc-flow {
    position: relative;
    margin-bottom: clamp(32px, 4vw, 48px);
    padding: 20px 24px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
  }
  .soc-flow__rail {
    position: relative;
    height: 3px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.1);
    margin-bottom: 18px;
    overflow: hidden;
  }
  .soc-flow__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(calc(0.25 + var(--soc-scroll) * 0.75));
    background: linear-gradient(90deg, #60a5fa, var(--brand-orange), #34d399);
    transition: transform 0.25s ease-out;
  }
  .soc-flow__steps {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 780px) {
    .soc-flow__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .soc-step {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .soc-step:hover,
  .soc-step.is-lit {
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(96, 165, 250, 0.45);
    transform: translateY(-2px);
  }
  .soc-step__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    margin-bottom: 4px;
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }
  .soc-step:hover .soc-step__dot,
  .soc-step.is-lit .soc-step__dot {
    background: #60a5fa;
    box-shadow: 0 0 12px #60a5fa;
  }
  .soc-step__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #93c5fd;
  }
  .soc-step__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-on-dark);
  }

  /* Track Switcher Bar */
  .soc-bar {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .soc-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 7px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
  }
  @media (max-width: 859.98px) {
    .soc-tabs__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: 20px;
      scrollbar-width: none;
    }
    .soc-tabs__list::-webkit-scrollbar {
      display: none;
    }
  }
  .soc-tab {
    flex: 1;
    min-width: max-content;
    appearance: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 20px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: 14px;
    font-weight: 600;
    color: rgba(240, 237, 233, 0.72);
    transition:
      background-color 0.22s ease,
      color 0.22s ease,
      box-shadow 0.22s ease;
  }
  .soc-tab:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
  .soc-tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
  }
  .soc-tab.is-active {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(37, 99, 235, 0.65);
  }
  .soc-tab.is-active .soc-tab__dot {
    background: #93c5fd;
    opacity: 1;
    box-shadow: 0 0 8px #93c5fd;
  }

  .soc-tracks {
    display: grid;
    gap: clamp(64px, 8vw, 108px);
  }
  .soc-track-sec[hidden] {
    display: none;
  }

  /* Track Stage (Copy left + Interactive AppShot right) */
  .soc-stage {
    display: grid;
    gap: clamp(28px, 3.6vw, 44px);
    padding: clamp(24px, 3.4vw, 42px);
    margin-bottom: 24px;
    border-radius: clamp(22px, 2.4vw, 32px);
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(37, 99, 235, 0.22), transparent 60%),
      rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    align-items: start;
  }
  @media (min-width: 980px) {
    .soc-stage {
      grid-template-columns: 0.92fr 1.08fr;
    }
  }
  .soc-stage__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .soc-stage__tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 99px;
    background: rgba(59, 130, 246, 0.2);
    border: 1px solid rgba(96, 165, 250, 0.4);
    color: #93c5fd;
  }
  .soc-stage__title {
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: #fff;
  }
  .soc-stage__blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.3;
    color: #93c5fd;
  }
  .soc-stage__intro {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.82);
  }
  .soc-highlights {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .soc-hi {
    padding: 13px 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .soc-hi__title {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }
  .soc-hi__text {
    font-size: var(--type-body);
    line-height: 1.5;
    color: rgba(240, 237, 233, 0.74);
  }

  .soc-stage__media {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .soc-ui-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .soc-ch {
    appearance: none;
    cursor: pointer;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(240, 237, 233, 0.8);
    font-size: 13px;
    font-weight: 600;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .soc-ch:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .soc-ch.is-on {
    background: #3b82f6;
    border-color: #60a5fa;
    color: #fff;
    box-shadow: 0 6px 18px -4px rgba(59, 130, 246, 0.6);
  }
  .soc-shot[hidden] {
    display: none;
  }

  /* 4 Social Service Cards per Track */
  .soc-cards {
    display: grid;
    gap: var(--gap-card);
  }
  @media (min-width: 640px) {
    .soc-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .soc-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .soc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .soc-card:hover {
    transform: translateY(-6px);
    border-color: #60a5fa;
    box-shadow: 0 24px 48px -20px rgba(37, 99, 235, 0.45);
  }
  .soc-card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .soc-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .soc-card:hover .soc-card__media img {
    transform: scale(1.06);
  }
  .soc-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 22, 51, 0.35) 0%, transparent 50%);
  }
  .soc-card__badge {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: 4px 10px;
    border-radius: 99px;
    background: rgba(14, 22, 51, 0.85);
    border: 1px solid rgba(96, 165, 250, 0.4);
    backdrop-filter: blur(6px);
    color: #93c5fd;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .soc-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }
  .soc-card__name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.24;
    color: #fff;
  }
  .soc-card__desc {
    font-size: var(--type-body);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.76);
  }
  .soc-card__cta {
    margin-top: auto;
    padding-top: 12px;
    font-size: var(--type-small);
    font-weight: 600;
    color: #60a5fa;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .soc-card:hover .soc-card__cta .arrow {
    transform: translateX(5px);
  }

  /* ============================================================
     S5 · Interactive Platform Ecosystem Matrix
  ============================================================ */
  .plat-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 32px;
  }
  .plat-filters {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 6px;
    border-radius: var(--radius-pill);
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
  }
  .plat-flt {
    appearance: none;
    cursor: pointer;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
