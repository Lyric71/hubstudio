];

const facts = [
  'A producer reads your brief within one business day.',
  'A written proposal follows within 48 hours.',
  'The provenance of every asset is recorded.',
  'Priced per asset, per project, or on retainer.',
];

/* How a studio project runs. Titled steps, no numerals: order carries it. */
const steps = [
  {
    title: 'Brief',
    text: 'You tell us what you need, where it will run, and by when. A producer reads it within one business day.',
  },
  {
    title: 'Proposal',
    text: 'Within 48 hours you get a written proposal with the approach, deliverables, timeline, and price. We price per asset, per project, or on retainer.',
  },
  {
    title: 'Production',
    text: 'An art director leads. The team shoots, generates, or does both, depending on the asset.',
  },
  {
    title: 'Review',
    text: 'You comment on the work. With Studio + app, each version goes to your approvers in the app’s Validation.',
  },
  {
    title: 'Delivery',
    text: 'You get finished files in the formats each channel needs, with the provenance of each asset recorded.',
  },
];

const proofSlugs = ['iflytek-anypin', 'mexicash', 'camper', '1834-gin'];
const proof = proofSlugs
  .map((slug) => caseStudies.find((c) => c.slug === slug))
  .filter((c): c is (typeof caseStudies)[number] => Boolean(c));

const platformsWest = [
  { name: 'Meta', href: '/solutions/platforms/meta' },
  { name: 'TikTok', href: '/solutions/platforms/tiktok' },
  { name: 'LinkedIn', href: '/solutions/platforms/linkedin' },
  { name: 'Amazon', href: '/solutions/platforms/amazon' },
  { name: 'Shopify', href: '/solutions/platforms/shopify' },
  { name: 'Brand website', href: '/solutions/platforms/brand-website' },
  { name: 'Ecommerce website', href: '/solutions/platforms/ecommerce-website' },
];
const platformsChina = [
  { name: 'WeChat', href: '/solutions/platforms/wechat' },
  { name: 'Douyin', href: '/solutions/platforms/douyin' },
  { name: 'RedNote', href: '/solutions/platforms/rednote' },
  { name: 'Weibo', href: '/solutions/platforms/weibo' },
  { name: 'Tmall', href: '/solutions/platforms/tmall' },
  { name: 'JD', href: '/solutions/platforms/jd' },
];

/* FAQ: `a` is plain text for the JSON-LD; `html` adds the in-page links. */
const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: 'How much does a studio project cost?',
    a: 'It depends on the work, and we quote after reading your brief. There are three ways to price it. Per asset suits a defined list of deliverables. Per project suits a campaign or a launch. A retainer suits content you need every month. The written proposal arrives within 48 hours. We don’t publish rates, but the pricing page explains each model.',
    html: 'It depends on the work, and we quote after reading your brief. There are three ways to price it. Per asset suits a defined list of deliverables. Per project suits a campaign or a launch. A retainer suits content you need every month. The written proposal arrives within 48 hours. We don’t publish rates, but <a href="/pricing">the pricing page</a> explains each model.',
  },
  {
    q: 'What should a brief include?',
    a: 'What you need, where it will run, the deadline, and any brand material you have: guidelines, past work, product shots. A short brief is fine. The producer will ask for what’s missing.',
  },
  {
    q: 'Do I need a hubStudio account?',
    a: 'Not for Studio only: you send a brief and receive files. For Studio + app, your people get client logins in our workspace, or you add our creatives to your own hubStudio team.',
    html: 'Not for Studio only: you send a brief and receive files. For <a href="/studio/with-the-app">Studio + app</a>, your people get client logins in our workspace, or you add our creatives to your own hubStudio team.',
  },
  {
    q: 'How long does a project take?',
    a: 'That depends on the scope, and the proposal gives you a date for each deliverable. For a sense of pace, the Mexicash campaign went from brief to five platforms in five days.',
    html: 'That depends on the scope, and the proposal gives you a date for each deliverable. For a sense of pace, <a href="/work/mexicash">the Mexicash campaign</a> went from brief to five platforms in five days.',
  },
  {
    q: 'Is the work shot or generated?',
    a: 'Both. We decide asset by asset. Some assets are shot, some are generated, and most mix the two.',
  },
  {
    q: 'What do you record about each asset?',
    a: 'Its provenance. For every asset we deliver, we record how it was made and what went into it.',
  },
  {
    q: 'Can the studio make content for Chinese platforms?',
    a: 'Yes. We produce for WeChat, Douyin, RedNote, Weibo, Tmall, and JD. The app doesn’t publish there, so we deliver files ready to post.',
  },
  {
    q: 'Can we move from the studio to the app later?',
    a: 'Yes. You can start with the studio and make more of the work yourself in the app over time, or go the other way.',
    html: 'Yes. You can start with the studio and make more of the work yourself <a href="/app">in the app</a> over time, or go the other way.',
  },
  {
    q: 'Do you work with agencies?',
    a: 'Yes. Agencies brief the studio like any other client. With Studio + app, we can work inside your agency’s own hubStudio team, and your clients can approve the work there with client logins.',
  },
];

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/studio`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Studio', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* The studio as a ProfessionalService. No price range, by policy. */
const studioSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${pageUrl}#studio`,
  name: 'hubStudio',
  url: pageUrl,
  description:
    'The hubStudio studio: senior art directors and AIGC specialists who make images, video, and social content from a brief, across twenty service lines, inside the hubStudio app or outside it.',
  image: `${SITE}/Images/studio-hero.webp`,
  parentOrganization: { '@id': `${SITE}/#organization` },
  founder: { '@id': `${SITE}/#cyril-drouin` },
  address: { '@type': 'PostalAddress', addressLocality: 'Hong Kong', addressCountry: 'HK' },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'hubStudio creative services',
    itemListElement: categories.map((cat) => ({
      '@type': 'OfferCatalog',
      name: cat.title,
      itemListElement: cat.services.map((svc) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: svc.name,
          description: svc.desc,
          url: `${SITE}${svc.href}`,
          provider: { '@id': `${SITE}/#organization` },
        },
      })),
    })),
  },
};
---

<Layout
  title="AI creative studio: images, video, social | hubStudio"
  description="Senior art directors and AIGC specialists make your images, video, and social content across twenty service lines, in the hubStudio app or outside it."
  image="/Images/studio-hero.webp"
  preloadImage="/Images/studio-hero.webp"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(studioSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ===== Hero ===== -->
  <section class="st-hero">
    <figure class="st-hero__media">
      <img
        src="/Images/studio-hero.webp"
        alt="Two hubStudio art directors at a wall of pinned proofs; one circles a sneaker print in red pencil beside the notes “crop tighter” and “lift shadows.”"
        width="2000"
        height="1333"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
    <div class="container st-hero__inner">
      <div class="st-hero__copy">
        <nav class="st-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Studio</span>
        </nav>
        <span class="eyebrow st-hero__eyebrow">The studio</span>
        <h1 class="headline h1 st-hero__title">
          Send the brief. Our <span class="accent">studio</span> makes the work.
        </h1>
        <p class="lead st-hero__lead">
          Our art directors and AIGC specialists make the images, video, and social content,
          and hand it back finished. We can work inside the hubStudio app, where you approve
          each version, or we can leave the app out and just send you the files.
        </p>
        <div class="st-hero__cta">
          <a class="btn btn--primary" href={`${BRIEF_URL}?way=studio`}>Send a brief</a>
          <a class="btn btn--secondary" href="#services">See the twenty services</a>
        </div>
        <p class="st-hero__alt">
          Prefer to make it yourself? <a href={APP_SIGNUP} rel="noopener">Create your account</a>
        </p>
        <ul class="st-hero__meta">
          <li>Senior art directors on every brief</li>
          <li>Hong Kong, Shanghai, Changsha, the Philippines, and Paris</li>
          <li>Founded by Cyril Drouin, former CEO at Publicis</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== How the studio works ===== -->
  <section class="st-sheet st-sheet--white st-how">
    <div class="container st-how__grid">
      <div class="st-how__copy">
        <span class="eyebrow">How we work</span>
        <h2 class="headline h2 reveal st-how__title">
          A senior art director on every <span class="accent">brief</span>.
        </h2>
        <p class="st-p">
          Every project is led by a senior art director. Under them, AIGC specialists run the
          production on brand-trained models and GPU pipelines that the studio team operates
          itself. We train on the brand because a general model gets a product almost right,
          and almost right is what a brand manager sends back.
        </p>
        <p class="st-p">
          The first thing most clients ask is whether the work is shot or made with AI.
          Usually it’s both: some assets are shot, some are generated, and most combine the
          two. We make that call asset by asset, based on what the picture needs, not on a
          house style.
        </p>
        <p class="st-p">
          The studio is headquartered in Hong Kong, with studios in Shanghai and Changsha, a
          team in the Philippines, and an office in Paris. Cyril Drouin, former CEO at
          Publicis, founded it.
        </p>
        <a class="st-arrow" href="/studio/ai-excellence">
          How we use AI <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <aside class="st-facts" aria-label="Studio facts">
        <span class="eyebrow">What to expect</span>
        <ul class="st-facts__list">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <!-- ===== Ways to work (shared band) ===== -->
  <div class="st-ways">
    <WaysToWork tone="cream" highlight="studio-app" />
  </div>

  <!-- ===== The two studio ways, explained ===== -->
  <section class="st-sheet st-sheet--white st-two">
    <div class="container">
      <header class="st-head">
        <span class="eyebrow">Two ways to hire us</span>
        <h2 class="headline h2 reveal">
          What changes between the two studio <span class="accent">ways</span>
        </h2>
        <p class="st-head__lead">
          Both get you the same studio and the same art directors. The difference is where you
          see the work and what stays on record.
        </p>
      </header>
      <div class="st-two__grid">
        <article class="st-way st-way--hi">
          <span class="st-way__tag"><span class="st-dot" aria-hidden="true"></span>Managed</span>
          <h3 class="st-way__name">Studio + app</h3>
          <p class="st-way__text">
            You see the work in hubStudio, one approval thread per piece. Your people either get
            client logins in our workspace, or you add our creatives to your own team. Every
            version, v1, v2, and on, stays on that thread, and nothing on it can be deleted. You
            see the finished work. Our prompts, engines, and costs stay on our side.
          </p>
          <a class="st-arrow" href="/studio/with-the-app">
            How Studio + app works <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
        <article class="st-way">
          <span class="st-way__tag"><span class="st-dot" aria-hidden="true"></span>Full service</span>
          <h3 class="st-way__name">Studio only</h3>
          <p class="st-way__text">
            Your producer sends each round for your comments and runs the job from the first
            call to delivery. Nobody on your side needs an account or has to learn any software.
            You get finished files in the formats each channel needs.
          </p>
          <a class="st-arrow" href={`${BRIEF_URL}?way=studio`}>
            Send a brief <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== Services catalog ===== -->
  <section class="st-sheet st-sheet--cream st-svc" id="services">
    <div class="container">
      <header class="st-head">
        <span class="eyebrow">Services</span>
        <h2 class="headline h2 reveal">
          Twenty service lines, one <span class="accent">studio</span>.
        </h2>
        <p class="st-head__lead">
          The same art directors run every line. A brand identity, its packaging, and next
          month’s social calendar can all come from one team, and you only brief your brand once.
        </p>
        <nav class="st-jump" aria-label="Service groups">
          {
            categories.map((cat) => (
              <a class="st-jump__link" href={`#${cat.id}`}>
                {cat.title}
              </a>
            ))
          }
        </nav>
      </header>

      {
        categories.map((cat) => (
          <section class="st-cat" id={cat.id} aria-labelledby={`${cat.id}-title`}>
            <header class="st-cat__head">
              <h3 class="st-cat__title" id={`${cat.id}-title`}>
                {cat.title}
              </h3>
              <p class="st-cat__blurb">{cat.blurb}</p>
              <p class="st-cat__intro">{cat.intro}</p>
            </header>
            <div class="st-grid">
              {cat.services.map((svc) => (
                <a class="st-card" href={svc.href}>
                  <div class="st-card__media">
                    <img src={svc.img} alt={svc.alt} loading="lazy" decoding="async" />
                  </div>
                  <div class="st-card__body">
                    <h4 class="st-card__name">{svc.name}</h4>
                    <p class="st-card__desc">{svc.desc}</p>
                    <span class="st-card__cta">
                      View service <span aria-hidden="true">&rarr;</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }

      <p class="st-svc__aside">
        Can’t tell which line fits? Describe the problem in <a href={`${BRIEF_URL}?way=studio`}>your brief</a>.
        Sorting it into the right service is the producer’s job, not yours.
      </p>
    </div>
  </section>

  <!-- ===== How a studio project runs ===== -->
  <section class="st-sheet st-sheet--ink st-run grain">
    <div class="container">
      <header class="st-head st-head--dark">
        <span class="eyebrow">How it runs</span>
        <h2 class="headline h2 reveal">From brief to <span class="accent">delivery</span></h2>
        <p class="st-head__lead">
          Here is what happens after you send it. A social calendar and an annual report need
          different people, but the steps are the same.
        </p>
      </header>
      <ul class="st-steps">
        {
          steps.map((s, i) => (
            <li class="st-step reveal" style={`--i:${i}`}>
              <span class="st-step__mark" aria-hidden="true" />
              <h3 class="st-step__title">{s.title}</h3>
              <p class="st-step__text">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

