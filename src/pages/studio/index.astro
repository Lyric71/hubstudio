<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- 1. Scroll-reveal observer ------------------------------- */
  const reveals = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('in'));
  }

  /* ---- 2. Count-up SLA numbers --------------------------------- */
  const counts = document.querySelectorAll<HTMLElement>('.count');
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const runCount = (el: HTMLElement) => {
    const target = Number(el.dataset.to || '0');
    if (RM) {
      el.textContent = String(target);
      return;
    }
    const dur = 1400;
    const start = performance.now();
    const step = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      el.textContent = String(Math.round(easeOut(p) * target));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (counts.length && 'IntersectionObserver' in window) {
    const cio = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runCount(entry.target as HTMLElement);
            cio.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );
    counts.forEach((el) => cio.observe(el));
  }

  /* ---- 3. Scroll engine: progress bar, parallax, floating dock & social pipeline ---- */
  const fill = document.querySelector<HTMLElement>('.scrollbar__fill');
  const parallax = document.querySelectorAll<HTMLElement>('[data-parallax]');
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const dockLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-dock-link]'));
  const socCommand = document.querySelector<HTMLElement>('[data-soc-command]');
  const socSteps = socCommand ? Array.from(socCommand.querySelectorAll<HTMLElement>('[data-soc-step]')) : [];

  let ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    const vh = window.innerHeight;
    const max = document.documentElement.scrollHeight - vh;
    if (fill) fill.style.transform = `scaleX(${max > 0 ? y / max : 0})`;

    /* Floating dock visibility & active section spy */
    if (dock) {
      const showDock = y > vh * 0.65 && y < max - 380;
      dock.classList.toggle('is-visible', showDock);
    }
    if (dockLinks.length) {
      const ids = ['services', 'social-networks', 'setups', 'how-it-runs', 'work'];
      let activeId = ids[0];
      for (const id of ids) {
        const sec = document.getElementById(id);
        if (sec && sec.getBoundingClientRect().top <= vh * 0.42) {
          activeId = id;
        }
      }
      dockLinks.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.dockLink === activeId);
      });
    }

    /* Parallax images */
    if (!RM) {
      parallax.forEach((img) => {
        const speed = Number(img.dataset.speed || '0.08');
        const rect = img.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < vh) {
          const offset = (rect.top + rect.height / 2 - vh / 2) / vh;
          img.style.transform = `translate3d(0, ${offset * -speed * 180}px, 0)`;
        }
      });
    }

    /* Social networks scroll-reactive workflow bar & orbs */
    if (socCommand) {
      const r = socCommand.getBoundingClientRect();
      const total = r.height + vh * 0.4;
      const raw = (vh * 0.8 - r.top) / total;
      const p = Math.max(0, Math.min(1, raw));
      socCommand.style.setProperty('--soc-scroll', p.toFixed(3));
      if (socSteps.length) {
        const activeCount = Math.max(1, Math.ceil(p * socSteps.length));
        socSteps.forEach((st, idx) => st.classList.toggle('is-lit', idx < activeCount));
      }
    }

    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true },
  );
  onScroll();

  /* ---- 4. 3D pointer tilt & pointer-tracked glow ---------------- */
  if (!RM && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const MAX = 4.5;
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        el.style.transition = 'none';
        el.style.setProperty('--ry', `${(px - 0.5) * MAX * 2}deg`);
        el.style.setProperty('--rx', `${(0.5 - py) * MAX * 2}deg`);
      });
      el.addEventListener('pointerleave', () => {
        el.style.transition = '';
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
      });
    });

    /* Magnetic hero buttons */
    document.querySelectorAll<HTMLElement>('.st-mag').forEach((btn) => {
      btn.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect();
        const mx = e.clientX - r.left - r.width / 2;
        const my = e.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${mx * 0.24}px, ${my * 0.3}px)`;
      });
      btn.addEventListener('pointerleave', () => {
        btn.style.transform = '';
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--sx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--sy', `${((e.clientY - r.top) / r.height) * 100}%`);
      el.setAttribute('data-lit', '');
    });
    el.addEventListener('pointerleave', () => el.removeAttribute('data-lit'));
  });

  /* ---- 5. Creative Assets Interactive Category Filter ----------- */
  const caDeck = document.querySelector<HTMLElement>('[data-creative-deck]');
  if (caDeck) {
    const caBtns = Array.from(caDeck.querySelectorAll<HTMLButtonElement>('[data-ca-filter]'));
    const caGroups = Array.from(caDeck.querySelectorAll<HTMLElement>('[data-ca-group]'));

    const setCaFilter = (id: string) => {
      caBtns.forEach((btn) => {
        const on = btn.dataset.caFilter === id;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      caGroups.forEach((grp) => {
        const show = id === 'all' || grp.dataset.caGroup === id;
        grp.hidden = !show;
      });
    };

    caBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        setCaFilter(btn.dataset.caFilter || 'all');
      });
    });

    /* Ensure jumping to a category pill reveals all or that category cleanly */
    document.querySelectorAll<HTMLAnchorElement>('[data-jump-cat]').forEach((link) => {
      link.addEventListener('click', () => {
        setCaFilter('all');
      });
    });
  }

  /* ---- 6. Social Networks Command Studio: Track Filter & AppShot Stage ---- */
  if (socCommand) {
    const socTabs = Array.from(socCommand.querySelectorAll<HTMLButtonElement>('[data-soc-filter]'));
    const socGroups = Array.from(socCommand.querySelectorAll<HTMLElement>('[data-soc-group]'));

    const setSocFilter = (id: string) => {
      socTabs.forEach((btn) => {
        const on = btn.dataset.socFilter === id;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      socGroups.forEach((grp) => {
        const show = id === 'all' || grp.dataset.socGroup === id;
        grp.hidden = !show;
      });
    };

    socTabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        setSocFilter(btn.dataset.socFilter || 'all');
      });
    });

    /* AppShot switcher inside each social track stage */
    socGroups.forEach((grp) => {
      const shotBtns = Array.from(grp.querySelectorAll<HTMLButtonElement>('[data-soc-shot-btn]'));
      const shots = Array.from(grp.querySelectorAll<HTMLElement>('[data-soc-shot]'));
      const warm = (el: HTMLElement | undefined) => {
        const img = el?.querySelector('img');
        if (img && img.loading === 'lazy') img.loading = 'eager';
      };
      shotBtns.forEach((btn, idx) => {
        btn.addEventListener('pointerenter', () => warm(shots[idx]));
        btn.addEventListener('click', () => {
          shotBtns.forEach((b, bi) => b.classList.toggle('is-on', bi === idx));
          shots.forEach((s, si) => {
            const on = si === idx;
            s.classList.toggle('is-on', on);
            s.hidden = !on;
          });
          warm(shots[idx]);
        });
      });
    });
  }

  /* ---- 7. Interactive Platform Ecosystem Matrix ----------------- */
  const platSec = document.querySelector<HTMLElement>('[data-plat-matrix]');
  if (platSec) {
    const fltBtns = Array.from(platSec.querySelectorAll<HTMLButtonElement>('[data-plat-filter]'));
    const cards = Array.from(platSec.querySelectorAll<HTMLElement>('.plat-card'));
    fltBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.platFilter || 'all';
        fltBtns.forEach((b) => b.classList.toggle('is-on', b === btn));
        cards.forEach((c) => {
          const match =
            filter === 'all' ||
            c.dataset.platRegion === filter ||
            c.dataset.platMode === filter;
          c.hidden = !match;
        });
      });
    });
  }

  /* ---- 8. Interactive Workspace Setup Switcher ------------------ */
  const setupSec = document.querySelector<HTMLElement>('[data-setup-switcher]');
  if (setupSec) {
    const btns = Array.from(setupSec.querySelectorAll<HTMLButtonElement>('[data-setup-btn]'));
    const panes = Array.from(setupSec.querySelectorAll<HTMLElement>('[data-setup-pane]'));
    const activateSetup = (idx: number, focus = false) => {
      btns.forEach((b, i) => {
        const on = i === idx;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      panes.forEach((p, i) => {
        const on = i === idx;
        p.classList.toggle('is-on', on);
        p.hidden = !on;
        if (on) {
          const img = p.querySelector('img');
          if (img && img.loading === 'lazy') img.loading = 'eager';
        }
      });
    };
    btns.forEach((b, i) => {
      b.addEventListener('click', () => activateSetup(i));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          activateSetup((i + 1) % btns.length, true);
        }
      });
    });
  }

  /* ---- 9. Interactive 5-Stage Pipeline -------------------------- */
  const pipeSec = document.querySelector<HTMLElement>('[data-pipeline-sec]');
  if (pipeSec) {
    const btns = Array.from(pipeSec.querySelectorAll<HTMLButtonElement>('[data-pipe-btn]'));
    const panes = Array.from(pipeSec.querySelectorAll<HTMLElement>('[data-pipe-pane]'));
    const pipeBox = pipeSec.querySelector<HTMLElement>('.pipe-box');
    const activateStage = (idx: number, focus = false) => {
      btns.forEach((b, i) => {
        const on = i === idx;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      panes.forEach((p, i) => {
        const on = i === idx;
        p.classList.toggle('is-on', on);
        p.hidden = !on;
      });
      if (pipeBox) {
        pipeBox.style.setProperty('--pipe-progress', ((idx + 1) / btns.length).toFixed(2));
      }
    };
    btns.forEach((b, i) => {
      b.addEventListener('click', () => activateStage(i));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          activateStage((i + 1) % btns.length, true);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          activateStage((i - 1 + btns.length) % btns.length, true);
        }
      });
    });
  }

  /* ---- 10. Interactive FAQ Topic Filter ------------------------- */
  const faqSec = document.querySelector<HTMLElement>('[data-faq-sec]');
  if (faqSec) {
    const flts = Array.from(faqSec.querySelectorAll<HTMLButtonElement>('[data-faq-filter]'));
    const items = Array.from(faqSec.querySelectorAll<HTMLElement>('[data-faq-topic]'));
    flts.forEach((btn) => {
      btn.addEventListener('click', () => {
        const topic = btn.dataset.faqFilter || 'all';
        flts.forEach((b) => b.classList.toggle('is-on', b === btn));
        items.forEach((item) => {
          item.hidden = !(topic === 'all' || item.dataset.faqTopic === topic);
        });
      });
    });
  }
</script>
