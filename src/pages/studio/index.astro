    formats: 'Brand pages · Super Topic campaigns · Multi-image launch visuals',
  },
  {
    name: 'Tmall',
    href: '/solutions/platforms/tmall',
    region: 'china',
    mode: 'studio-ops',
    badge: 'China commerce',
    formats: 'Flagship store design · Long-scroll PDPs · Festival campaigns',
  },
  {
    name: 'JD',
    href: '/solutions/platforms/jd',
    region: 'china',
    mode: 'studio-ops',
    badge: 'China commerce',
    formats: 'Spec-driven product pages · Tech & appliance visuals · Hero banners',
  },
];

/* FAQ: `a` is plain text for the JSON-LD; `html` adds the in-page links; `topic` powers the JS filter. */
const faqs: { q: string; a: string; html?: string; topic: 'creative' | 'social' | 'app' }[] = [
  {
    topic: 'app',
    q: 'How do your creative and social services connect with the hubStudio app?',
    a: 'The app is the core, and our services are the added value on top of it. Across both pillars, Creative assets and Social networks, our team works inside hubStudio with you. We either work in our own workspace and give your people free client logins for Client space and Validation, or join your own hubStudio team as members.',
    html: 'The app is the core, and our services are the added value on top of it. Across both pillars, Creative assets and Social networks, our team works inside hubStudio with you. We either work in our own workspace and give your people free client logins for Client space and Validation, or join <a href="/studio/with-the-app">your own hubStudio team</a> as members.',
  },
  {
    topic: 'app',
    q: 'How much does a studio or social engagement cost?',
    a: 'It depends on the work, and we quote after reading your brief. There are three ways to price it. Per asset suits a defined list of deliverables. Per project suits a campaign or a launch. A retainer suits creative assets and social networks you need every month. The written proposal arrives within 48 hours. We don’t publish rates, but the pricing page explains each model.',
    html: 'It depends on the work, and we quote after reading your brief. There are three ways to price it. Per asset suits a defined list of deliverables. Per project suits a campaign or a launch. A retainer suits creative assets and social networks you need every month. The written proposal arrives within 48 hours. We don’t publish rates, but <a href="/pricing">the pricing page</a> explains each model.',
  },
  {
    topic: 'social',
    q: 'Can your team run our social networks and paid ads end to end?',
    a: 'Yes. Under our Social networks pillar, our strategists, editors, and media buyers manage your pages, write and produce weekly posts, carousels, and short video, run executive ghostwriting and employee advocacy programs, and manage paid social campaigns billed straight to your ad accounts.',
  },
  {
    topic: 'app',
    q: 'What should a brief include?',
    a: 'What you need across creative assets or social networks, where it will run, the deadline, and any brand material you have: guidelines, past work, product shots. A short brief is fine. A producer reads it within one business day and asks for what’s missing.',
  },
  {
    topic: 'creative',
    q: 'How long does a project take?',
    a: 'That depends on the scope, and the proposal gives you a date for each deliverable. For a sense of pace, the Mexicash campaign went from brief to five platforms in five days.',
    html: 'That depends on the scope, and the proposal gives you a date for each deliverable. For a sense of pace, <a href="/work/mexicash">the Mexicash campaign</a> went from brief to five platforms in five days.',
  },
  {
    topic: 'creative',
    q: 'Is the creative work shot or generated with AI?',
    a: 'Both. We decide asset by asset. Some assets are shot on set, some are generated on brand-trained models and studio GPU pipelines, and most combine the two.',
    html: 'Both. We decide asset by asset. Some assets are shot on set, some are generated on <a href="/studio/ai-excellence">brand-trained models and studio GPU pipelines</a>, and most combine the two.',
  },
  {
    topic: 'creative',
    q: 'What do you record about each asset?',
    a: 'Its provenance and its approval history. For every asset we deliver, we record how it was made and what went into it, and every version approved in Validation stays on a permanent thread.',
  },
  {
    topic: 'social',
    q: 'How do you handle Chinese social networks and marketplaces?',
    a: 'We produce native content and run campaigns for WeChat, Douyin, RedNote, Weibo, Tmall, and JD from our Shanghai, Changsha, and Hong Kong teams. The hubStudio app publishes directly to Western networks; for Chinese platforms, you validate the work in the app and our team delivers files ready to post or operates your local channels.',
  },
  {
    topic: 'app',
    q: 'Can we move work between your team and our own team in the app?',
    a: 'Yes. You can start with our team running production and social inside hubStudio and take more of the daily work in-house over time, or use the app on your own and bring us in for launches, brand systems, and paid campaigns.',
    html: 'Yes. You can start with our team running production and social inside <a href="/app">hubStudio</a> and take more of the daily work in-house over time, or use the app on your own and bring us in for launches, brand systems, and paid campaigns.',
  },
];

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/studio`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const studioSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${pageUrl}#studio`,
  name: 'hubStudio',
  url: pageUrl,
  description:
    'hubStudio services across two pillars: Creative assets (twenty studio service lines for text, images, and video) and Social networks (twelve service lines for content, paid social, and advocacy across Western and Chinese platforms), delivered and validated inside the hubStudio app.',
  image: `${SITE}/Images/studio-hero.webp`,
  parentOrganization: { '@id': `${SITE}/#organization` },
  founder: { '@id': `${SITE}/#cyril-drouin` },
  address: { '@type': 'PostalAddress', addressLocality: 'Hong Kong', addressCountry: 'HK' },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'hubStudio creative assets and social network services',
    itemListElement: allCategories.map((cat) => ({
      '@type': 'OfferCatalog',
      name: cat.title,
      itemListElement: cat.services.map((svc) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: svc.name,
          description: svc.desc,
          url: `${SITE}${svc.href}`,
          provider: { '@id': `${SITE}/#organization` },
        },
      })),
    })),
  },
};
---

<Layout
  heroOverlay
  title="Creative assets & social network services in the app | hubStudio"
  description="Work with our senior art directors, AIGC specialists, and social managers inside hubStudio across two pillars: twenty creative asset lines and twelve social network services."
  image="/Images/studio-hero.webp"
  preloadImage="/Images/studio-hero.webp"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(studioSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Fixed scroll progress bar -->
  <div class="scrollbar" aria-hidden="true"><span class="scrollbar__fill"></span></div>

  <!-- Floating interactive section quick-dock (reveals on scroll) -->
  <nav class="st-dock" id="st-dock" aria-label="Services quick navigation" data-dock>
    <a class="st-dock__pill st-dock__pill--create is-active" href="#services" data-dock-link="services">
      <span class="st-dock__dot" aria-hidden="true"></span>
      <span>Pillar · Creative assets</span>
    </a>
    <a class="st-dock__pill st-dock__pill--publish" href="#social-networks" data-dock-link="social-networks">
      <span class="st-dock__dot" aria-hidden="true"></span>
      <span>Pillar · Social networks</span>
    </a>
    <a class="st-dock__pill" href="#setups" data-dock-link="setups">
      <span>In the app</span>
    </a>
    <a class="st-dock__pill" href="#how-it-runs" data-dock-link="how-it-runs">
      <span>How it runs</span>
    </a>
    <a class="st-dock__pill" href="#work" data-dock-link="work">
      <span>Case studies</span>
    </a>
    <a class="st-dock__cta" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</a>
  </nav>

  <div class="studio-page">
    <!-- ==========================================================
         S1 · Dark Cinematic Hero: Both Pillars + Interactive Cards
    ========================================================== -->
    <section class="st-hero" data-spot>
      <div class="st-hero__bg" aria-hidden="true">
        <div class="grain st-hero__grain"></div>
        <div class="st-hero__orb st-hero__orb--create"></div>
        <div class="st-hero__orb st-hero__orb--publish"></div>
        <div class="st-hero__grid-bg"></div>
      </div>

      <div class="container st-hero__inner">
        <div class="st-hero__main">
          <div class="st-hero__copy">
            <nav class="st-crumbs" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">Studio &amp; Services</span>
            </nav>

            <span class="eyebrow eyebrow--orange st-hero__eyebrow">
              Our services · Added value on the app
            </span>

            <h1 class="st-hero__title">
              <span class="line"><span>Creative assets and</span></span>
              <span class="line"><span>social networks, built</span></span>
              <span class="line"><span>with <em class="accent">us</em> in the app.</span></span>
            </h1>

            <p class="st-hero__lead">
              The hubStudio app is the core. Bring our senior art directors, AIGC specialists, and
              social managers into your workspace across two complementary pillars: we produce your
              text, images, and video, and we run your social presence across Western and Chinese
              networks while you validate every piece on one thread.
            </p>

            <div class="st-hero__actions">
              <div class="st-hero__cta">
                <a class="btn btn--primary st-mag" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</a>
                <a class="btn btn--on-dark st-mag" href={APP_SIGNUP} target="_blank" rel="noopener">
                  Create your account
                </a>
              </div>
              <p class="st-hero__alt">
                Already on hubStudio? <a href={APP_SIGNIN} target="_blank" rel="noopener">Sign in</a>
                <span aria-hidden="true">·</span>
                <a href="/studio/with-the-app">How we work together in the app</a>
              </p>
            </div>
          </div>

          <!-- Right visual stage: Layered editorial photo + interactive dual-pillar cards -->
          <div class="st-hero__stage">
            <figure class="st-hero__frame" data-tilt>
              <img
                src="/Images/studio-hero.webp"
                alt="Two hubStudio art directors at a wall of pinned proofs; one circles a sneaker print in red pencil beside the notes “crop tighter” and “lift shadows.”"
                width="2000"
                height="1333"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-parallax
                data-speed="0.08"
              />
              <div class="st-hero__scrim" aria-hidden="true"></div>
              <figcaption class="st-hero__badge">
                <span class="st-hero__badge-dot" aria-hidden="true"></span>
                <span>Hong Kong · Shanghai · Changsha · Philippines · Paris</span>
              </figcaption>
            </figure>

            <!-- Floating Interactive Dual-Pillar Cards -->
            <div class="st-hero__pillars">
              <a
                class="st-hpil st-hpil--create"
                href="#services"
                data-glow
                data-tilt
              >
                <div class="st-hpil__top">
                  <span class="st-hpil__kicker">
                    <span class="st-hpil__dot" aria-hidden="true"></span>
                    Pillar · Creative assets
                  </span>
                  <span class="st-hpil__pill">Six studio groups</span>
                </div>
                <p class="st-hpil__title">Text, images &amp; video</p>
                <p class="st-hpil__desc">
                  Campaigns, video &amp; motion, eCommerce catalogs, strategy, brand systems, and decks.
                </p>
                <span class="st-hpil__cta">
                  Explore creative lines <span class="arrow" aria-hidden="true">&rarr;</span>
                </span>
              </a>

              <a
                class="st-hpil st-hpil--publish"
                href="#social-networks"
                data-glow
                data-tilt
              >
                <div class="st-hpil__top">
                  <span class="st-hpil__kicker">
                    <span class="st-hpil__dot" aria-hidden="true"></span>
                    Pillar · Social networks
                  </span>
                  <span class="st-hpil__pill">Three social tracks</span>
                </div>
                <p class="st-hpil__title">Posts, paid ads &amp; advocacy</p>
                <p class="st-hpil__desc">
                  Page management, weekly content, full-funnel ads, and executive voices across West &amp; China.
                </p>
                <span class="st-hpil__cta">
                  Explore social lines <span class="arrow" aria-hidden="true">&rarr;</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom SLA & Fact Ribbon -->
        <div class="st-hero__stats" data-reveal>
          <div class="st-hstat">
            <span class="st-hstat__val st-hstat__val--word">One day</span>
            <span class="st-hstat__lbl">For a senior producer to read your brief</span>
          </div>
          <div class="st-hstat">
            <span class="st-hstat__val"><span class="count" data-to="48">48</span><i>h</i></span>
            <span class="st-hstat__lbl">To a written proposal with deliverables and dates</span>
          </div>
          <div class="st-hstat">
            <span class="st-hstat__val"><span class="count" data-to="32">32</span></span>
            <span class="st-hstat__lbl">Service lines across Creative assets and Social networks</span>
          </div>
          <div class="st-hstat">
            <span class="st-hstat__val st-hstat__val--word">Per asset</span>
            <span class="st-hstat__lbl">Provenance &amp; permanent approval thread in Validation</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S2 · Two-Pillar Architecture Explorer
    ========================================================== -->
    <section class="sheet sheet--light sheet--first section" id="pillars">
      <div class="container">
        <header class="s-head s-head--row">
          <div>
            <span class="eyebrow" data-reveal>Two complementary pillars</span>
            <h2 class="headline h2" data-reveal>
              Built around what you make and where it <span class="accent">ships</span>.
            </h2>
          </div>
          <p class="s-head__intro" data-reveal>
            Most brands don’t need a disconnected design shop and a separate social agency. Our team
            covers both pillars inside the same hubStudio workspace, founded by Cyril Drouin, former
            CEO at Publicis.
          </p>
        </header>

        <!-- Interactive Dual-Pillar Command Grid -->
        <div class="pil-arch">
          <!-- Pillar 1 Card: Creative Assets -->
          <article class="pil-card pil-card--create" data-reveal data-glow data-tilt style="--i:0">
            <div class="pil-card__head">
              <div class="pil-card__badge-row">
                <span class="pil-card__tag">
                  <span class="pil-card__dot" aria-hidden="true"></span>
                  Services · Creative assets
                </span>
                <span class="pil-card__count">Six groups · Twenty lines</span>
              </div>
              <div class="pil-card__title-row">
                <span class="pil-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="4" y="4" width="16" height="16" rx="4.5" />
                    <rect x="12" y="12" width="16" height="16" rx="4.5" />
                    <circle class="ic-accent" cx="20" cy="20" r="3.2" stroke="none" />
                  </svg>
                </span>
                <h3 class="pil-card__title">Text, images, and video</h3>
              </div>
              <p class="pil-card__body">
                Senior art directors lead every brief, backed by designers, retouchers, motion
                artists, writers, and AIGC specialists running brand-trained models and studio GPU
                pipelines. Some assets are shot on set, some are generated, and most combine both.
              </p>
            </div>

            <div class="pil-card__groups">
              <span class="pil-card__sublabel">Jump to a creative group</span>
              <div class="pil-card__pills">
                {
                  creativeCategories.map((cat) => (
                    <a class="pil-pill" href={`#${cat.id}`} data-jump-cat={cat.id}>
                      <span>{cat.title}</span>
                      <span class="pil-pill__arr" aria-hidden="true">&rarr;</span>
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="pil-card__foot">
              <a class="arrow-link" href="#services">
                Explore all twenty creative service lines <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
              <a class="pil-card__sec-link" href="/studio/ai-excellence">How we use AI &rarr;</a>
            </div>
          </article>

          <!-- Pillar 2 Card: Social Networks -->
          <article class="pil-card pil-card--publish" data-reveal data-glow data-tilt style="--i:1">
            <div class="pil-card__head">
              <div class="pil-card__badge-row">
                <span class="pil-card__tag">
                  <span class="pil-card__dot" aria-hidden="true"></span>
                  Services · Social networks
                </span>
                <span class="pil-card__count">Three tracks · Twelve lines</span>
              </div>
              <div class="pil-card__title-row">
                <span class="pil-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <circle cx="9" cy="16" r="4.5" />
                    <circle cx="23" cy="8.5" r="4.5" />
                    <circle cx="23" cy="23.5" r="4.5" />
                    <path d="M13 13.8 19 10.6M13 18.2l6 3.2" stroke-linecap="round" />
                    <circle class="ic-accent" cx="9" cy="16" r="2.4" stroke="none" />
                  </svg>
                </span>
                <h3 class="pil-card__title">Posts, publishing, paid social, and advocacy</h3>
              </div>
              <p class="pil-card__body">
                Social strategists, editors, community managers, and media buyers run your presence
                inside hubStudio across Western networks (LinkedIn, Instagram, Facebook, TikTok, X,
                YouTube) and Chinese networks (WeChat, RedNote, Douyin, Weibo).
              </p>
            </div>

            <div class="pil-card__groups">
              <span class="pil-card__sublabel">Jump to a social track</span>
              <div class="pil-card__pills">
                {
                  socialTracks.map((tr, idx) => (
                    <a class="pil-pill pil-pill--publish" href={`#${tr.id}`} data-jump-soc={idx}>
                      <span>{tr.shortName}</span>
                      <span class="pil-pill__arr" aria-hidden="true">&rarr;</span>
                    </a>
                  ))
                }
                <a class="pil-pill pil-pill--publish" href="#platforms">
                  <span>West &amp; China platforms</span>
                  <span class="pil-pill__arr" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>

            <div class="pil-card__foot">
              <a class="arrow-link arrow-link--publish" href="#social-networks">
                Explore all twelve social service lines <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
              <a class="pil-card__sec-link" href="/app/publish">See publishing in the app &rarr;</a>
            </div>
          </article>
        </div>

        <!-- Connected Shared Foundation Bar (Library, Validation, Client Space) -->
        <div class="pil-bridge" data-reveal>
          <div class="pil-bridge__left">
            <span class="pil-bridge__dot" aria-hidden="true"></span>
            <div>
              <strong class="pil-bridge__title">One shared workspace underneath both pillars</strong>
              <p class="pil-bridge__text">
                Every creative asset and every social post we make lands in hubStudio’s Campaigns,
                Assets Library, and Validation, so your team reviews and signs off in one place.
              </p>
            </div>
          </div>
          <a class="btn btn--secondary" href="/studio/with-the-app">How we work in the app</a>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S3 · Pillar 1: Creative Assets Interactive Studio Deck
    ========================================================== -->
    <section class="sheet sheet--cream section" id="services" data-creative-deck>
      <div class="container" id="creative-assets">
        <header class="s-head s-head--row">
          <div>
            <span class="eyebrow eyebrow--orange" data-reveal>
              Pillar · Creative assets · 20 service lines
            </span>
            <h2 class="headline h2" data-reveal>
              Twenty creative service lines, one <span class="accent">studio</span>.
            </h2>
          </div>
          <p class="s-head__intro" data-reveal>
            The same senior art directors run every line. A brand identity, its packaging, an
            eCommerce catalog, and next month’s campaign film all come from one team, and you only
            brief your brand once.
          </p>
        </header>

        <!-- Interactive Category Filter & Jump Bar -->
        <div class="ca-toolbar" data-reveal>
          <div class="ca-tabs" role="tablist" aria-label="Filter creative service groups">
            <button
              type="button"
              class="ca-tab is-on"
              role="tab"
              aria-selected="true"
              data-ca-filter="all"
            >
              <span class="ca-tab__dot" aria-hidden="true"></span>
              <span>All creative groups</span>
            </button>
            {
              creativeCategories.map((cat) => (
                <button
                  type="button"
                  class="ca-tab"
                  role="tab"
                  aria-selected="false"
                  data-ca-filter={cat.id}
                >
                  <span class="ca-tab__dot" aria-hidden="true" />
                  <span>{cat.title}</span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Category Groups (all rendered in DOM for SEO & anchors; interactive filter highlights/isolates) -->
        <div class="ca-groups">
          {
            creativeCategories.map((cat) => (
              <section
                class="ca-cat"
                id={cat.id}
                data-ca-group={cat.id}
                aria-labelledby={`${cat.id}-title`}
              >
                <div class="ca-cat__banner" data-glow>
                  <div class="ca-cat__main">
                    <div class="ca-cat__eyebrow-row">
                      <span class="ca-cat__kicker">Creative assets · {cat.title}</span>
                      <span class="ca-cat__craft">{cat.craft}</span>
                    </div>
                    <h3 class="ca-cat__title" id={`${cat.id}-title`}>
                      {cat.title}
                    </h3>
                    <p class="ca-cat__blurb">{cat.blurb}</p>
                  </div>
                  <p class="ca-cat__intro">{cat.intro}</p>
                </div>

                <div class:list={['ca-grid', `ca-grid--n${cat.services.length}`]}>
                  {cat.services.map((svc, si) => (
                    <a
                      class="ca-card"
                      href={svc.href}
                      data-tilt
                      data-glow
                      data-reveal
                      style={`--i:${si % 4}`}
                    >
                      <div class="ca-card__media">
                        <img src={svc.img} alt={svc.alt} loading="lazy" decoding="async" />
                        <div class="ca-card__scrim" aria-hidden="true" />
                        <span class="ca-card__tag">{svc.tag}</span>
                      </div>
                      <div class="ca-card__body">
                        <h4 class="ca-card__name">{svc.name}</h4>
                        <p class="ca-card__desc">{svc.desc}</p>
                        <span class="ca-card__cta">
                          Explore service <span class="arrow" aria-hidden="true">&rarr;</span>
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <div class="ca-aside" data-reveal>
          <p class="ca-aside__text">
            Can’t tell which creative line fits? Describe what you need in
            <a href={`${BRIEF_URL}?way=studio-app`}>your brief</a>. Sorting a project across the
            right specialists is the producer’s job, not yours.
          </p>
          <a class="btn btn--primary" href={`${BRIEF_URL}?way=studio-app`}>Send a creative brief</a>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S4 · Pillar 2: Social Networks Interactive Command Studio
    ========================================================== -->
    <section
      class="sheet sheet--ink section soc-studio"
      id="social-networks"
      data-spot
