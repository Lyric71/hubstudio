  .st-qa__sign::after {
    content: '';
    position: absolute;
    background: var(--brand-orange);
    border-radius: 2px;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .st-qa__sign::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .st-qa__sign::after {
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .st-qa[open] .st-qa__sign::after {
    transform: translateX(-50%) scaleY(0);
  }
  .st-qa__a {
    padding: 0 26px 24px;
  }
  .st-qa__a p {
