---
/**
 * Partners  ·  /partners
 *
 * One partner program integrated into the hubStudio app. Partners earn a share
 * of all business they bring us (usually 10%, or higher by agreement) across
 * both app credits and services.
 *
 * No ordinal numerals in any card or repeated block. Body copy at
 * var(--type-body).
 */
import Layout from '../layouts/Layout.astro';
import AppShot from '../components/AppShot.astro';
import Button from '../components/Button.astro';
import DualCta from '../components/DualCta.astro';
import { appShots } from '../data/app-shots';
import { BRIEF_URL, HELP_URL } from '../lib/links';

const SITE = 'https://www.hubstudio.ai';
const PARTNER_BRIEF = `${BRIEF_URL}?way=partner`;

const earnStreams = [
  {
    tone: 'orange',
    chip: 'In the app',
    name: 'App credits',
    body: 'You earn your share whenever the teams and users you bring buy credits or top up their balance, less any refund.',
  },
  {
    tone: 'ink',
    chip: 'With our team',
    name: 'Creative and social services',
    body: 'You earn the same share when a customer you brought hires our team for creative production or social network services, including renewals.',
  },
];

/* The three pages of the Partner menu in the app (help: partners.md). */
const appPages = [
  {
    name: 'Users',
    body: 'Create a customer team, add its people, and set its admin. Everyone gets an email to choose a password.',
  },
  {
    name: 'Invitations',
    body: 'Invite a prospect in your own words. When they sign up through your link, the account is linked to you.',
  },
  {
    name: 'Commissions',
    body: 'Track your rate, every team and user you brought, what they paid us, and what you earned.',
  },
];

const faqs = [
  {
    q: 'What percentage do partners earn?',
    a: 'Usually 10% of everything your accounts pay us, or higher when we agree on larger volume. Each account locks in the rate in force the day it opens.',
  },
  {
    q: 'Do I earn on both app credits and services?',
    a: 'Yes. Your rate applies to credit purchases and automatic top-ups in the app, and to creative production and social services run by our team.',
  },
  {
    q: 'Do I have to pitch or manage the work?',
    a: 'No. Customers use the app on their own, and when they hire our team for services, we handle the proposal, production, and delivery.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Partners', item: `${SITE}/partners` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Partner with hubStudio | Earn on app and services"
  description="One partner program built into the hubStudio app. Bring customers and earn a share of everything they pay us, usually 10% or more, on app and services."
  preloadImage="/Images/partner-program-hero.webp"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ===== Hero ===== -->
  <section class="pt-hero">
    <div class="container pt-hero__grid">
      <div class="pt-hero__copy">
        <span class="eyebrow">Partners</span>
        <h1 class="headline h1 reveal pt-hero__title">
          One partner program, built into the <span class="accent">app</span>.
        </h1>
        <p class="lead pt-hero__lead">
          Bring us a customer and we share a percentage of everything they pay
          us, usually 10% and sometimes higher, on both app credits and
          services.
        </p>
        <div class="pt-hero__cta">
          <Button variant="primary" href={PARTNER_BRIEF}>Become a partner</Button>
          <Button variant="secondary" href="#in-the-app">See it in the app</Button>
        </div>
      </div>
      <figure class="pt-hero__visual">
        <img
          src="/Images/partner-program-hero.webp"
          alt="Orange and navy cubes branching out into a network."
          width="1408"
          height="768"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ===== How you earn ===== -->
  <section class="pt-sheet pt-sheet--white">
    <div class="container">
      <header class="pt-head">
        <span class="eyebrow">How it works</span>
        <h2 class="headline h2 reveal">
          Earn on everything your accounts <span class="accent">pay</span>.
        </h2>
        <p class="pt-p">
          No tiers and no quotas. Every customer you bring is linked to your
          account at a fixed rate, usually 10% or higher by agreement.
        </p>
      </header>

      <div class="pt-tracks">
        {
          earnStreams.map((s) => (
            <article class:list={['pt-track', `pt-track--${s.tone}`, 'grain']}>
              <span class="pt-track__chip">{s.chip}</span>
              <h3 class="pt-track__name">{s.name}</h3>
              <p class="pt-track__body">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Inside the app ===== -->
  <section class="pt-sheet pt-sheet--ink pt-anchor pt-app grain" id="in-the-app">
    <div class="container">
      <header class="pt-head">
        <span class="eyebrow pt-app__eyebrow">Inside the app</span>
        <h2 class="headline h2 reveal pt-app__title">
          Run your accounts from the <span class="accent">Partner</span> menu.
        </h2>
        <p class="pt-p pt-p--dark">
          Partners get a Partner menu at the top of the hubStudio sidebar with
          three pages.
        </p>
      </header>

      <div class="pt-app__shot">
        <AppShot
          shot={appShots.partnerCommissions}
          path="/partner/commissions"
          dark
          caption="The Commissions page in hubStudio: your rate, the teams and users you brought, what they paid, and what you earned."
        />
      </div>

      <div class="pt-app__pages">
        {
          appPages.map((page) => (
            <article class="pt-app__page">
              <h3 class="pt-app__name">{page.name}</h3>
              <p class="pt-p pt-p--dark">{page.body}</p>
            </article>
          ))
        }
      </div>
      <p class="pt-app__help">
        Already a partner?
        <a class="pt-arrow" href={`${HELP_URL}/partners`}>
          Read the Partner guide <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ===== Questions ===== -->
  <section class="pt-sheet pt-sheet--white">
    <div class="container pt-faq">
      <header class="pt-head">
        <span class="eyebrow">Questions</span>
        <h2 class="headline h2 reveal">Common <span class="accent">questions</span>.</h2>
      </header>
      <div class="pt-faq__list">
        {
          faqs.map((f) => (
            <article class="pt-faq__item">
              <h3 class="pt-faq__q">{f.q}</h3>
              <p class="pt-p">{f.a}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <DualCta tone="ink" />
</Layout>

<style>
  /* ---- Shared ------------------------------------------------- */
  .pt-p {
    margin-top: 16px;
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
    max-width: 62ch;
  }
  .pt-p--dark {
    color: rgba(240, 237, 233, 0.8);
  }
  .pt-arrow {
    font-size: var(--type-small);
    font-weight: 600;
    color: #ff8a5c;
  }
  .pt-arrow span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .pt-arrow:hover span {
    transform: translateX(6px);
  }
  .pt-head {
    display: grid;
    gap: 14px;
    max-width: 780px;
    margin-bottom: 48px;
  }
  .pt-head .pt-p {
    margin-top: 0;
  }
  .pt-anchor {
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }

  /* Sheet stacking */
  .pt-sheet {
    position: relative;
    margin-top: -48px;
    border-radius: clamp(28px, 3.6vw, 60px) clamp(28px, 3.6vw, 60px) 0 0;
    box-shadow: 0 -30px 64px -36px rgba(10, 10, 20, 0.42);
    padding-block: clamp(96px, 11vw, 160px);
  }
  .pt-sheet--white {
    background: var(--bg-white);
  }
  .pt-sheet--ink {
    background:
      radial-gradient(90% 70% at 0% 0%, rgba(233, 78, 27, 0.22) 0%, rgba(14, 22, 51, 0) 60%),
      var(--bg-ink);
    color: var(--text-on-dark);
    overflow: hidden;
  }

  /* ---- Hero --------------------------------------------------- */
  .pt-hero {
    background: var(--bg-cream);
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(96px, 11vw, 150px);
  }
  .pt-hero__grid {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .pt-hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
  }
  .pt-hero__title {
    margin-top: 18px;
    font-size: clamp(40px, 5vw, 72px);
  }
  .pt-hero__title .accent {
    color: var(--brand-orange);
  }
  .pt-hero__lead {
    margin-top: 22px;
    max-width: 54ch;
  }
  .pt-hero__cta {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pt-hero__visual {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 1408 / 768;
    box-shadow: var(--shadow-card);
  }
  .pt-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- Earn streams ------------------------------------------- */
  .pt-tracks {
    display: grid;
    gap: var(--gap-card);
  }
  @media (min-width: 820px) {
    .pt-tracks {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pt-track {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(30px, 3.4vw, 44px);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .pt-track--orange {
    background: var(--brand-orange-cta);
    color: #fff;
  }
  .pt-track--ink {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .pt-track__chip {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }
  .pt-track__name {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }
  .pt-track__body {
    font-size: var(--type-body);
    line-height: 1.6;
    opacity: 0.92;
  }

  /* ---- Inside the app (ink) ----------------------------------- */
  .pt-app__eyebrow {
    color: var(--brand-orange);
  }
  .pt-app__title {
    color: #fff;
  }
  .pt-app__title .accent {
    color: var(--brand-orange);
  }
  .pt-app__shot {
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }
  .pt-app__pages {
    display: grid;
    gap: var(--gap-card);
  }
  @media (min-width: 900px) {
    .pt-app__pages {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pt-app__page {
    padding: 30px;
    border: 1px solid rgba(240, 237, 233, 0.16);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.03);
  }
  .pt-app__name {
    font-size: var(--type-h4);
    font-weight: 600;
    color: #fff;
  }
  .pt-app__page .pt-p {
    margin-top: 10px;
  }
  .pt-app__help {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: var(--type-body);
    color: rgba(240, 237, 233, 0.8);
  }

  /* ---- FAQ ---------------------------------------------------- */
  .pt-faq__list {
    display: grid;
    gap: 0;
    max-width: 860px;
  }
  .pt-faq__item {
    padding: 26px 0;
    border-top: 1px solid var(--line-strong);
  }
  .pt-faq__item:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .pt-faq__q {
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .pt-faq__item .pt-p {
    margin-top: 10px;
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>
