---
/**
 * /app/library: the Assets Library. Its tools have a page each since
 * 2 October 2026, when every tool became a menu entry of its own in the app:
 * /app/image-tools (Image editor, Image anonymizer) and /app/video-tools
 * (Video editor, Shorts autopilot). This page links to both.
 *
 * Facts come from src/content/help/assets-library.md and history.md; button
 * and panel names are quoted from there. Campaigns (8 October 2026) are read
 * from the app: reporting-site src/lib/campaigns.ts, pages/campaigns,
 * scripts/campaignsPanel.ts and scripts/libraryFolderPicker.ts (a campaign
 * offered where a post's brief picks a library folder). Every picture is a real capture from
 * src/data/app-shots.ts. Layout and styles: src/styles/app-page.css.
 *
 * Copy: content-quality-us deck, scratchpad cq/app-library/final.md.
 * No ordinal numerals in any repeated block.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import AppShot from '../../components/AppShot.astro';
import DualCta from '../../components/DualCta.astro';
import { appShots } from '../../data/app-shots';
import { APP_SIGNUP, BRIEF_URL } from '../../lib/links';
import '../../styles/app-page.css';

const SITE = 'https://www.hubstudio.ai';

const nextLinks = [
  { lead: 'Make the pictures and clips', name: 'Create', href: '/app/create' },
  { lead: 'Post them', name: 'Publish', href: '/app/publish' },
  { lead: 'Get them approved', name: 'Review', href: '/app/review' },
];

const faqs = [
  {
    q: 'What does storing files cost?',
    a: 'The team pays a small daily charge for the space its files take, and a small charge when a file is downloaded, both from the team balance. Each charge is listed on the usage page in the app. Delete what you don’t need and the charge drops the next day. There’s no subscription and no seat fee; the team tops up a prepaid balance and pays as it goes.',
  },
  {
    q: 'How large can a file be?',
    a: 'Up to 50 MB per file. The Video editor and Shorts autopilot open videos up to 2 GB from your computer; what they save to the library is the finished MP4.',
  },
  {
    q: 'Do the tools cost anything?',
    a: 'The Image editor, the Image anonymizer and the Video editor are free and run in your browser. Two things are paid, each with its price shown before you start: the fast captions of the Video editor, and a Shorts autopilot run. A file you save to the library is stored like any other.',
  },
  {
    q: 'Does a campaign copy our files?',
    a: 'No. A campaign only points at files in the library, so a file can sit in several campaigns and takes no extra space. Deleting a campaign leaves every file where it was.',
  },
  {
    q: 'Can our clients see the library?',
    a: 'No. A client login doesn’t see the Assets Library. What you make for a client reaches them in their Client space.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'App', item: `${SITE}/app` },
    { '@type': 'ListItem', position: 3, name: 'Library', item: `${SITE}/app/library` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Assets Library: your team’s files in folders | hubStudio"
  description="Every render and upload of your team in one library, with folders, tags, versions and search, and the image and video tools one click away."
  preloadImage={appShots.library.src}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="apg-page">

  <!-- ===== Hero ===== -->
  <section class="apg-hero">
    <div class="container apg-hero__grid">
      <div class="apg-hero__copy">
        <nav class="apg-crumbs" aria-label="Breadcrumb">
          <a href="/app">The app</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Library</span>
        </nav>
        <h1 class="headline h1 apg-hero__title">
          From render to ready file, in the same <span class="accent">app</span>.
        </h1>
        <p class="lead apg-hero__lead">
          The Assets Library keeps every file your team makes or uploads, in folders you choose,
          with tags, versions and one search. A picture opens in the Image editor and a video in
          the Video editor straight from its row, and what you save comes back next to the
          original.
        </p>
        <div class="apg-hero__cta">
          <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
          <Button variant="secondary" href={`${BRIEF_URL}?way=studio-app`}>Send a brief</Button>
          <a class="apg-arrow" href="/app">See the whole app <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="apg-hero__shot">
        <AppShot
          shot={appShots.library}
          path="/files"
          eager
          caption="The Assets Library: every file of the team, in folders, searchable and tagged."
        />
      </div>
    </div>
  </section>

  <!-- ===== The library ===== -->
  <section class="apg-sheet apg-sheet--white" id="assets-library">
    <div class="container">
      <header class="apg-head">
        <span class="eyebrow">Assets Library</span>
        <h2 class="headline h2 reveal">The team’s files, in folders you <span class="accent">choose</span>.</h2>
      </header>
      <div class="apg-cols">
        <p class="apg-p">
          Every render your team makes lands in the library on its own. So does every file you
          upload, whether it’s a reference frame in the video studio or a picture for a post.
          Anyone on the team can see what the others added, so nobody has to ask where last week’s
          packshot went.
        </p>
        <p class="apg-p">
          You sort it into folders, drag a file onto a folder to move it, and tag it with your own
          words: “spring launch,” “approved,” a client’s name. Search reads file names, prompts,
          texts and tags across the whole library. Filters narrow it by type, date, tag or who
          added it. Tick several files and you can move or tag them in one go. Deleting works the
          same way. Each file’s Actions menu covers the rest: view it, download it, open it in the
          editor, upload a new version, rename it or move it.
        </p>
      </div>

      <div class="apg-rules">
        <div class="apg-rules__copy">
          <p class="apg-p">
            Two rules worth knowing. Only the person who added a file can delete it. That means a
            folder holding a teammate’s files can’t be deleted by you, and deleting any folder
            takes everything inside with it. And only files you upload take versions: upload a
            newer one and the old one moves under Versions. Renders don’t. Each file can weigh up
            to 50 MB.
          </p>
          <p class="apg-p">
            If you’ve used History, the renders here will look familiar. History lists them with
            the prompt, engine and cost of each; the library files them with your uploads, in your
            folders.
          </p>
          <a class="apg-arrow" href="/help/assets-library">
            The Assets Library in detail <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <AppShot
          shot={appShots.libraryActions}
          path="/files"
          caption="The Actions menu: view, download, edit, version, tag, rename, move."
        />
      </div>
    </div>
  </section>

  <!-- ===== Campaigns ===== -->
  <section class="apg-sheet apg-sheet--cream" id="campaigns">
    <div class="container">
      <header class="apg-head">
        <span class="eyebrow">Campaigns</span>
        <h2 class="headline h2 reveal">Every file of one launch, under one <span class="accent">name</span>.</h2>
      </header>
      <div class="apg-cols">
        <p class="apg-p">
          A spring launch leaves files all over the app: renders from the Image studio, a clip
          from the Video studio, the posts for each network, the client’s brief in a folder of
          uploads. A campaign gathers them under one name and a short brief, whichever studio made
          them. Add files from the campaign’s page, or pick Add to a campaign in a file’s Actions
          menu, for one file or for several ticked at once.
        </p>
        <p class="apg-p">
          Nothing is copied. A campaign points at files in the library, so a newer version stays
          in it and a deleted file drops out on its own. When you write a post, pick the campaign
          where you’d pick a library folder. Before it writes, the AI reads the brief, a line for
          every picture and clip with its prompt, and the text of the documents.
        </p>
      </div>
      <a class="apg-arrow apg-library__campaigns" href="/app/campaigns">
        Campaigns in detail <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- ===== The tools ===== -->
  <section class="apg-sheet apg-sheet--white" id="tools">
    <div class="container">
      <header class="apg-head">
        <span class="eyebrow">Its tools</span>
        <h2 class="headline h2 reveal">Open a file, then work on it <span class="accent">here</span>.</h2>
        <p class="apg-p">
          Each file’s Actions menu opens the tool it needs. A picture goes to the Image editor, a
          video to the Video editor, and a long video to Shorts autopilot. Each tool also has its
          own entry in the app’s menu, with the Image anonymizer beside them. They run in your
          browser, and what you save lands back in the library, next to the original.
        </p>
      </header>
      <div class="apg-next__grid apg-next__grid--two">
        <a class="apg-next__card" href="/app/image-tools">
          <span class="apg-next__lead">The Image editor and the Image anonymizer</span>
          <span class="apg-next__name">Image tools <span aria-hidden="true">&rarr;</span></span>
        </a>
        <a class="apg-next__card" href="/app/video-tools">
          <span class="apg-next__lead">The Video editor and Shorts autopilot</span>
          <span class="apg-next__name">Video tools <span aria-hidden="true">&rarr;</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== The rest of the app ===== -->
  <section class="apg-next">
    <div class="container">
      <h2 class="apg-next__label">Where the files come from, and where they go</h2>
      <div class="apg-next__grid">
        {
          nextLinks.map((l) => (
            <a class="apg-next__card" href={l.href}>
              <span class="apg-next__lead">{l.lead}</span>
              <span class="apg-next__name">
                {l.name} <span aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="apg-faq" id="faq">
    <div class="container apg-faq__grid">
      <header class="apg-faq__head">
        <span class="eyebrow">Questions</span>
        <h2 class="headline h2 reveal">What people ask about the <span class="accent">library</span>.</h2>
        <p class="apg-updated">Updated October 2026</p>
      </header>
      <div class="apg-faq__list">
        {
          faqs.map((f) => (
            <details class="apg-qa">
              <summary>
                <h3 class="apg-qa__q">{f.q}</h3>
                <span class="apg-qa__icon" aria-hidden="true" />
              </summary>
              <p class="apg-qa__a">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  </div>

  <DualCta />
</Layout>


<style>
  /* The link to /app/campaigns, under the two columns of the Campaigns section. */
  .apg-library__campaigns {
    margin-top: clamp(28px, 3vw, 40px);
  }
</style>

<script>
  /* Fade-in on scroll, matching the other hub pages. */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>
