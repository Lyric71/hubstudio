    padding-top: calc(var(--nav-h) + 72px);
    padding-bottom: 56px;
  }
  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    align-self: flex-start;
    padding: 8px 16px 8px 12px;
    border-radius: var(--radius-pill);
    background: rgba(240, 237, 233, 0.08);
    border: 1px solid rgba(240, 237, 233, 0.16);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.86);
  }
  .ping {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-orange);
    flex: none;
  }
  .ping::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--brand-orange);
    animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    75%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .hero__title {
    margin-top: 24px;
    max-width: 16ch;
    color: #fff;
    font-size: var(--type-h1);
    line-height: var(--lh-display);
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__title .line > span {
    display: block;
  }
  .hero__lead {
    margin-top: 26px;
    max-width: 60ch;
    color: rgba(240, 237, 233, 0.86);
  }
  .hero__cta {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__strip {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 22px;
    border-top: 1px solid rgba(240, 237, 233, 0.16);
  }
  .hero__strip-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
  }
  .marquee {
    display: flex;
    gap: 0;
    overflow: hidden;
    flex: 1;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    flex: none;
    gap: 48px;
    padding-right: 48px;
    animation: marquee 26s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__track li {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgba(240, 237, 233, 0.62);
    white-space: nowrap;
  }
  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }
  .hero__scroll {
    position: absolute;
    right: var(--container-pad-mobile);
    bottom: 116px;
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.6);
  }
  @media (min-width: 1024px) {
    .hero__scroll {
      display: flex;
      right: var(--container-pad-desktop);
    }
  }
  .hero__scroll-line {
    width: 1px;
    height: 54px;
    background: rgba(240, 237, 233, 0.28);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand-orange);
    animation: scrollcue 2s ease-in-out infinite;
  }
  @keyframes scrollcue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  /* Hero load stagger */
  .hero__chip,
  .hero__lead,
  .hero__cta,
  .hero__strip {
    opacity: 0;
    animation: heroFade 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .hero__chip {
    animation-delay: 0.1s;
  }
  .hero__title .line:nth-child(1) > span {
    animation: heroLine 0.95s cubic-bezier(0.16, 0.84, 0.3, 1) 0.22s both;
  }
  .hero__title .line:nth-child(2) > span {
    animation: heroLine 0.95s cubic-bezier(0.16, 0.84, 0.3, 1) 0.34s both;
  }
  .hero__title .line:nth-child(3) > span {
    animation: heroLine 0.95s cubic-bezier(0.16, 0.84, 0.3, 1) 0.46s both;
  }
  .hero__lead {
    animation-delay: 0.62s;
  }
  .hero__cta {
    animation-delay: 0.74s;
  }
  .hero__strip {
    animation-delay: 0.86s;
  }
  @keyframes heroLine {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__chip,
    .hero__lead,
    .hero__cta,
    .hero__strip,
    .hero__title .line > span {
      opacity: 1;
      animation: none;
      transform: none;
    }
    .marquee__track,
    .ping::after,
    .hero__scroll-line::after {
      animation: none;
    }
  }

  /* ============================================================
     S2  What we produce, bento
  ============================================================ */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-card);
  }
  @media (min-width: 620px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile--wide {
      grid-column: span 2;
    }
  }
  @media (min-width: 960px) {
    .bento {
      grid-template-columns: repeat(12, 1fr);
    }
    .tile--w7 {
      grid-column: span 7;
    }
    .tile--w5 {
      grid-column: span 5;
    }
    .tile--w6 {
      grid-column: span 6;
    }
  }

  .tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 244px;
    padding: 32px;
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 280ms ease-out;
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transition: opacity 320ms ease-out;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 0%),
      rgba(233, 78, 27, 0.22),
      transparent 70%
    );
  }
  .tile:hover {
    transform: translateY(-6px);
  }
  .tile:hover::before {
    opacity: 1;
  }
  .bento:has(.tile:hover) .tile:not(:hover) {
    opacity: 0.64;
  }
  .tile--white {
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card);
  }
  .tile--white:hover {
    box-shadow: 0 20px 44px rgba(10, 10, 20, 0.13);
  }
  .tile--cream {
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
  }
  .tile--ink {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .tile--orange {
    background: var(--brand-orange);
    color: #fff;
  }
  .tile__icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    flex: none;
    background: rgba(10, 10, 20, 0.05);
  }
  .tile--ink .tile__icon,
  .tile--orange .tile__icon {
    background: rgba(255, 255, 255, 0.12);
  }
  .tile__icon svg {
    width: 32px;
    height: 32px;
    overflow: visible;
  }
  .tile__icon .ic-accent {
    fill: var(--brand-orange);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile--orange .tile__icon .ic-accent {
    fill: #fff;
  }
  .tile__icon .ic-fill {
    fill: var(--bg-white);
  }
  .tile--cream .tile__icon .ic-fill {
    fill: var(--bg-cream);
  }
  .tile--ink .tile__icon .ic-fill {
    fill: var(--bg-ink);
  }
  .tile:hover .tile__icon .ic-accent {
    transform: scale(1.32);
  }
  .tile__body {
    flex: 1;
  }
  .tile__name {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .tile__summary {
    margin-top: 12px;
    font-size: var(--type-body);
    line-height: 1.6;
    max-width: 42ch;
    color: var(--text-mute);
  }
  .tile--ink .tile__summary,
  .tile--orange .tile__summary {
    color: rgba(240, 237, 233, 0.82);
  }
  .tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .tile--orange .tile__cta {
    color: #fff;
  }
  .tile:hover .tile__cta .arrow {
    transform: translateX(5px);
  }

  /* ============================================================
     S3  Who we are
  ============================================================ */
  .who__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 920px) {
    .who__grid {
      grid-template-columns: 1.06fr 0.94fr;
