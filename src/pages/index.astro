    letter-spacing: -0.02em;
    line-height: 1.22;
  }
  .who__statement .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .who__body {
    font-size: var(--type-body);
    line-height: 1.66;
