---
/**
 * Home (`/`): full rebuild from hubstudio-homepage-content.md.
 *
 * S1  Hero, full-bleed video, staggered load, marquee trust strip.
 * S2  What we produce, asymmetric bento of six categories.
 * S3  Who we are, editorial split with animated counters.
 * S4  Who we work with, interactive tabbed audience selector.
 * S5  Consulting and Training, two-up split cards.
 * S6  How to engage, three-ways panel on a dark band.
 * S7  Selected work, offset case-study grid.
 * S8  What we believe, dark word-reveal statement.
 * S9  Insights, latest four articles pulled from data.
 * S10 Closing CTA, dark.
 *
 * Motion: scroll progress bar, scroll-reveal stagger, hero parallax,
 * count-up stats, pointer-tracked card glow, pointer spotlight on dark
 * bands, tab crossfade, word-by-word reveal. All gated on
 * prefers-reduced-motion.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { caseStudies } from '../data/case-studies';
import { insights } from '../data/insights';

const clients = ['Nescafe', 'Marriott', 'Bobbi Brown', 'HiSense', 'Shiseido', 'Camper'];

/* S2: six service categories, mapped to the /services section anchors. */
const categories = [
  {
    id: 'content-social',
    name: 'Content & Social',
    summary: 'The assets that ship weekly. Social posts, ad creative, short video, email.',
    span: 'w7',
    tone: 'ink',
    icon: 'content',
  },
  {
    id: 'video-motion',
    name: 'Video & Motion',
    summary: 'Moving image, long and short. Scripted, shot, edited, animated.',
    span: 'w5',
    tone: 'white',
    icon: 'video',
  },
  {
    id: 'commerce-web',
    name: 'Commerce & Web',
    summary: 'Everything that sells or hosts the brand. Ecommerce visuals, websites, print.',
    span: 'w5',
    tone: 'white',
    icon: 'commerce',
  },
  {
    id: 'strategy-direction',
    name: 'Strategy & Direction',
    summary: 'The thinking before the pixels. Marketing and creative strategy, concept, storyboard.',
    span: 'w7',
    tone: 'orange',
    icon: 'strategy',
  },
  {
    id: 'brand-identity',
    name: 'Brand Identity',
    summary: 'The system everything else flows from. Logos, illustration, packaging and merch.',
    span: 'w6',
    tone: 'white',
    icon: 'brand',
  },
  {
    id: 'sales-communications',
    name: 'Sales & Communications',
    summary: 'Decks, docs, news. Presentations, pitch decks, reports, press releases.',
    span: 'w6',
    tone: 'cream',
    icon: 'sales',
  },
];

/* S4: the four audiences, each a tab panel. */
const audiences = [
  {
    id: 'brands',
    name: 'Brands',
    tagline: 'AIGC built around the brand.',
    body: 'Industry-trained models, custom training on your visual DNA, and multi-market output. The same line shows up in fifty places and reads native in every one.',
    chips: ['Industry-trained models', 'Visual-DNA training', 'Multi-market output'],
    href: '/solutions/brands',
    img: '/Images/brands-hero.jpg',
    alt: 'A brand marketing team reviewing a wall of multi-market campaign visuals in a sunlit studio.',
  },
  {
    id: 'agencies',
    name: 'Agencies',
    tagline: 'Your invisible production team.',
    body: 'You own the client, the strategy, and the creative direction. We handle visuals, video, and adaptations at AIGC speed, delivered under your name.',
    chips: ['White-label delivery', 'Visuals and video', 'AIGC speed'],
    href: '/solutions/agencies',
    img: '/Images/agencies-hero.jpg',
    alt: 'An agency creative director directing a project from a laptop in a busy open studio.',
  },
  {
    id: 'retailers',
    name: 'Retailers',
    tagline: 'Every product, every market.',
    body: 'Thousands of brand-correct assets a month across categories, channels, and seasons. Every touchpoint covered, without breaking the calendar.',
    chips: ['Thousands a month', 'Every channel', 'Every season'],
    href: '/solutions/retailers',
    img: '/Images/retailers-hero.jpg',
    alt: 'A retail content team managing a large catalog of product visuals across multiple screens.',
  },
  {
    id: 'manufacturers',
    name: 'Manufacturers',
    tagline: 'Product reality, made sellable.',
    body: 'From the spec sheet to the marketplace tile, the trade-show booth to the launch reel, product reality is turned into content the channel can sell. All on one production line.',
    chips: ['Spec sheet to tile', 'Booth to launch reel', 'One production line'],
    href: '/solutions/manufacturers',
    img: '/Images/manufacturers-hero.jpg',
    alt: 'A manufacturing product shown as polished marketing content beside its technical reference.',
  },
];

/* S5: consulting and training. */
const programs = [
  {
    kind: 'Consulting',
    title: 'Architect the studio inside your business.',
    body: 'Infrastructure, integration, governance, and team development, run by senior leads from our active production practice. From pilot to operating capability, with a roadmap that survives the next model release.',
    href: '/solutions/consulting',
    img: '/Images/cs-strategy-room.jpg',
    alt: 'A strategy room where senior leads map out an AIGC studio build on a printed wall plan.',
  },
  {
    kind: 'Training',
    title: 'Past prompt demos, into production muscle.',
    body: 'Cohorts learn inside the studio, on real briefs, with the engineers and creative directors who ship hubStudio work every week. Beginner and advanced modules, English and Mandarin, customized by industry.',
    href: '/solutions/training',
    img: '/Images/training-hero.jpg',
    alt: 'A training cohort working through a live brief alongside hubStudio engineers and creative directors.',
  },
];

/* S6: the three ways to work. Middle model is visually featured. */
const ways = [
  {
    name: 'Asset-Based',
    tagline: 'Pay for what you ship.',
    body: 'You send the brief, we produce the work. Volume formats with MOQs, plus per-project items quoted on scope. Some of it we generate, some we shoot, and plenty of briefs land in between.',
    facts: ['Volume formats', 'No lock-in'],
    href: '/pricing#asset-based',
    featured: false,
  },
  {
    name: 'Project-Based',
    tagline: 'Built for your next launch.',
    body: 'We assemble the team around your brief: creative director, art director, AIGC engineer, copywriter, producer. One quote, one schedule, one invoice.',
    facts: ['First review in two weeks', 'Full delivery in four'],
    href: '/pricing#project-based',
    featured: true,
  },
  {
    name: 'Subscription',
    tagline: 'Your studio on retainer.',
    body: 'A fixed monthly cost, and a team that gets faster the longer it works with you, because it stops relearning your brand on every job. Mix and match across every service line.',
    facts: ['Three, six or twelve-month terms', 'Every service line'],
    href: '/pricing#subscription',
    featured: false,
  },
];

/* S7: four selected case studies, image and alt sourced from data. */
const pick = (slug: string) => caseStudies.find((c) => c.slug === slug)!;
const cases = [
  { name: 'HiSense', tag: 'Consumer tech', line: 'Product visuals across every channel and format', slug: 'hisense' },
  { name: 'Shiseido RQ PYOLOGY', tag: 'Beauty', line: 'Clinical credibility and luxury appeal, in one frame', slug: 'shiseido-rq-pyology' },
  { name: 'age20', tag: 'Beauty', line: 'Skincare campaign content, generated and shot', slug: 'age20' },
  { name: 'Premium SUV', tag: 'Automotive', line: 'A global automotive launch, market by market', slug: 'premium-suv' },
].map((c) => {
  const d = pick(c.slug);
  return { ...c, img: d.hero.src, alt: d.hero.alt };
});

/* S9: latest four insights. */
const latestInsights = insights.slice(0, 4);

/* S8: the belief headline, split for word-by-word reveal. */
const beliefWords = ['Creative', 'intelligence', 'is', 'the', 'only', 'thing', 'left', 'that'];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'hubStudio',
  url: 'https://hubstudio.ai',
  description:
    'A production house that pairs real studio craft with deep AIGC expertise, run out of China, with creative direction on top.',
};
---

<Layout
  heroOverlay
  title="hubStudio | A production house built for what content has become"
  description="Real studio craft, deep AIGC expertise, and creative direction on top. Send the brief or run the platform. The work ships in days and looks like your brand."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- Scroll progress -->
  <div class="scrollbar" aria-hidden="true"><span class="scrollbar__fill"></span></div>

  <!-- ============================================================
       S1  Hero
  ============================================================ -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <video
        class="hero__video"
        id="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        tabindex="-1"
        poster="/Video/home-hero-poster.webp"
      >
        <source src="/Video/home-hero.webm" type="video/webm" />
        <source src="/Video/home-hero.mp4" type="video/mp4" />
      </video>
      <div class="hero__scrim"></div>
      <div class="grain hero__grain"></div>
      <div class="hero__glow"></div>
    </div>

    <div class="container hero__inner">
      <span class="hero__chip">
        <span class="ping" aria-hidden="true"></span>
        Producing across sixteen markets
      </span>

      <h1 class="headline hero__title">
        <span class="line"><span>A production house</span></span>
        <span class="line"><span>built for what content</span></span>
        <span class="line"><span>has <em class="accent">become</em>.</span></span>
      </h1>

      <p class="lead hero__lead">
        We pair real studio craft with deep AIGC expertise, run out of China where the
        production economics still work, and put creative direction on top of both. Send
        the brief, or run the platform yourself. Either way, the work ships in days and
        looks like it belongs to your brand.
      </p>

      <div class="hero__cta">
        <Button variant="primary" href="/contact">Talk to us</Button>
        <Button variant="on-dark" href="/work">See real brand work</Button>
      </div>
    </div>

    <div class="hero__strip" aria-label="Trusted by leading brands">
      <span class="hero__strip-label">Trusted by</span>
      <div class="marquee">
        <ul class="marquee__track">
          {clients.map((name) => <li>{name}</li>)}
        </ul>
        <ul class="marquee__track" aria-hidden="true">
          {clients.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </div>

    <a class="hero__scroll" href="#produce" aria-label="Scroll to what we produce">
      <span>Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ============================================================
       S2  What we produce
  ============================================================ -->
  <section class="section produce" id="produce">
    <div class="container">
      <header class="s-head">
        <span class="eyebrow" data-reveal>Services</span>
        <h2 class="headline h2" data-reveal>
          Twenty service lines, <span class="accent">one studio</span>.
        </h2>
        <p class="s-head__intro" data-reveal>
          From a single social post to a full campaign system, every format your brand
          reaches for, produced and finalized in days. Six categories, twenty service
          lines, one team running them on shared brand rules.
        </p>
      </header>

      <div class="bento">
        {
          categories.map((cat, i) => (
            <a
              class={`tile tile--${cat.span} tile--${cat.tone}`}
              href={`/services#${cat.id}`}
              data-reveal
              data-glow
              style={`--i:${i}`}
            >
              <span class="tile__icon" aria-hidden="true">
                {cat.icon === 'content' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="4" y="4" width="16" height="16" rx="4.5" />
                    <rect class="ic-fill" x="12" y="12" width="16" height="16" rx="4.5" stroke="none" />
                    <rect x="12" y="12" width="16" height="16" rx="4.5" />
                    <circle class="ic-accent" cx="20" cy="20" r="3" stroke="none" />
                  </svg>
                )}
                {cat.icon === 'video' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="6" width="21" height="20" rx="5.5" />
                    <path class="ic-accent" d="M11.5 12.2 18.7 16 11.5 19.8Z" stroke="none" />
                    <path d="M27 11h3M27 16h4M27 21h3" stroke-linecap="round" />
                  </svg>
                )}
                {cat.icon === 'commerce' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="5" width="26" height="22" rx="4.5" />
                    <path d="M3 11.5h26" />
                    <circle cx="7" cy="8.2" r="1.1" fill="currentColor" stroke="none" />
                    <rect class="ic-accent" x="12" y="16" width="11" height="7.5" rx="2.5" stroke="none" />
                  </svg>
                )}
                {cat.icon === 'strategy' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <circle cx="16" cy="16" r="11.5" />
                    <path d="M16 2.5v5M16 24.5v5M2.5 16h5M24.5 16h5" stroke-linecap="round" />
                    <circle class="ic-accent" cx="16" cy="16" r="3.6" stroke="none" />
                  </svg>
                )}
                {cat.icon === 'brand' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <circle cx="16" cy="16" r="12" />
                    <rect x="8.5" y="8.5" width="15" height="15" rx="2.5" transform="rotate(45 16 16)" />
                    <circle class="ic-accent" cx="16" cy="16" r="3.1" stroke="none" />
                  </svg>
                )}
                {cat.icon === 'sales' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="6" width="26" height="17.5" rx="3.5" />
                    <path d="M16 23.5v4.5M11 28h10" stroke-linecap="round" />
                    <path d="M8.5 11.5h8" stroke-linecap="round" opacity="0.55" />
                    <circle class="ic-accent" cx="21.5" cy="15" r="3.4" stroke="none" />
                  </svg>
                )}
              </span>
              <div class="tile__body">
                <h3 class="tile__name">{cat.name}</h3>
                <p class="tile__summary">{cat.summary}</p>
              </div>
              <span class="tile__cta">
                Explore <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       S3  Who we are
  ============================================================ -->
  <section class="section who" id="studio">
    <div class="container">
      <div class="who__grid">
        <div class="who__text">
          <span class="eyebrow" data-reveal>Who we are</span>
          <p class="who__statement" data-reveal>
            The studios shipping hundreds of assets a month for global brands now were
            not built for that volume. <span class="accent">We were.</span>
          </p>
          <p class="who__body" data-reveal>
            hubStudio is a full production house, headquartered between Hong Kong and
            Shenzhen, with creative talent embedded in sixteen markets. We shoot, we
            direct, we retouch, we edit, the same way a traditional studio does. What
            sits on top is a generation layer most studios have not built yet:
            dedicated GPU infrastructure, brand-trained models, and pipelines our team
            runs every day.
          </p>
          <p class="who__body" data-reveal>
            That mix is where the economics change. A blended team in China, on hybrid
            pipelines that decide per asset whether to shoot it or generate it, brings
            the cost of a finalized asset down by half or more without trading off what
            lands on the page. The savings are real, and we pass them through.
          </p>
        </div>

        <figure class="who__figure" data-reveal>
          <div class="who__media" data-parallax>
            <img
              src="/Images/who-we-are-office.webp"
              alt="The hubStudio production floor in China, a working studio of editors, directors and AIGC engineers."
              width="1280"
              height="1600"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="who__cap">Hong Kong / Shenzhen, the production floor</figcaption>
        </figure>
      </div>

      <div class="counters" data-reveal>
        <div class="counter">
          <span class="counter__num"><span class="count" data-to="16">0</span></span>
          <span class="counter__label">Markets with creative talent embedded on the ground</span>
        </div>
        <div class="counter">
          <span class="counter__num"><span class="count" data-to="50">0</span><i>%</i></span>
          <span class="counter__label">Typical cut in the cost of a finalized asset</span>
        </div>
        <div class="counter">
          <span class="counter__num counter__num--word">Days</span>
          <span class="counter__label">From brief to delivery, not weeks</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S4  Who we work with
  ============================================================ -->
  <section class="section solutions" id="solutions">
    <div class="container">
      <header class="s-head">
        <span class="eyebrow" data-reveal>Solutions</span>
        <h2 class="headline h2" data-reveal>
          Built around how your brand <span class="accent">sells</span>.
        </h2>
        <p class="s-head__intro" data-reveal>
          The content problem looks different depending on where you sit. A brand fights
          for relevance across markets. An agency needs invisible capacity. A retailer
          ships thousands of assets a season. A manufacturer turns product reality into
          something the channel can sell. The engagement is shaped for the side you are on.
        </p>
      </header>

      <div class="tabs" data-reveal>
        <div class="tabs__list" role="tablist" aria-label="Who we work with">
          {
            audiences.map((a, i) => (
              <button
                class="tab"
                role="tab"
                id={`tab-${a.id}`}
                aria-controls={`panel-${a.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? '0' : '-1'}
              >
                <span class="tab__dot" aria-hidden="true"></span>
                {a.name}
              </button>
            ))
          }
        </div>

        <div class="tabs__panels">
          {
            audiences.map((a, i) => (
              <div
                class={`panel${i === 0 ? ' is-active' : ''}`}
                id={`panel-${a.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${a.id}`}
                hidden={i !== 0}
              >
                <div class="panel__media">
                  <img
                    src={a.img}
                    alt={a.alt}
                    width="1120"
                    height="1280"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="panel__badge">{a.name}</span>
                </div>
                <div class="panel__body">
                  <p class="panel__tagline">{a.tagline}</p>
                  <p class="panel__text">{a.body}</p>
                  <ul class="panel__chips">
                    {a.chips.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                  <a class="arrow-link" href={a.href}>
                    Explore {a.name} <span class="arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S5  Consulting and Training
  ============================================================ -->
  <section class="section build" id="consulting">
    <div class="container">
      <header class="s-head">
        <span class="eyebrow" data-reveal>Consulting</span>
        <h2 class="headline h2" data-reveal>
          Or build the studio inside your <span class="accent">own walls</span>.
        </h2>
        <p class="s-head__intro" data-reveal>
          Not every brand needs the production lane. Some need help standing up their own
          AIGC operation, training the team to run it, and writing the governance that
          keeps it brand-safe at scale. We do that work too, taught and led by the same
          people running our production floor every day.
        </p>
      </header>

      <div class="programs">
        {
          programs.map((p, i) => (
            <a class="program" href={p.href} data-reveal data-glow style={`--i:${i}`}>
              <div class="program__media">
                <img
                  src={p.img}
                  alt={p.alt}
                  width="1200"
                  height="820"
                  loading="lazy"
                  decoding="async"
                />
                <span class="program__kind">{p.kind}</span>
              </div>
              <div class="program__body">
                <h3 class="program__title">{p.title}</h3>
                <p class="program__text">{p.body}</p>
                <span class="arrow-link">
                  Explore {p.kind} <span class="arrow" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       S6  How to engage
  ============================================================ -->
  <section class="engage section-dark" id="engage" data-spot>
    <div class="grain engage__grain" aria-hidden="true"></div>
    <div class="container">
      <header class="s-head s-head--dark">
        <span class="eyebrow eyebrow--orange" data-reveal>How to engage</span>
        <h2 class="headline h2" data-reveal>
          Three ways to work with us. <span class="accent">One studio</span>.
        </h2>
        <p class="s-head__intro" data-reveal>
          Some brands need a steady drip of content. Others need everything at once for a
          launch. Pick the model that matches how your team really works, not how a studio
          would prefer to bill you.
        </p>
      </header>

      <div class="ways">
        {
          ways.map((w, i) => (
            <a
              class={`way${w.featured ? ' way--featured' : ''}`}
              href={w.href}
              data-reveal
              data-glow
              style={`--i:${i}`}
            >
              {w.featured && <span class="way__flag">Built for launches</span>}
              <span class="way__name">{w.name}</span>
              <span class="way__tagline">{w.tagline}</span>
              <p class="way__body">{w.body}</p>
              <ul class="way__facts">
                {w.facts.map((f) => (
                  <li>
                    <span class="way__tick" aria-hidden="true">
                      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2.5 6.4 5 9l4.5-6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <span class="way__cta">
                See {w.name} <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="engage__compare" data-reveal>
        <a class="arrow-link arrow-link--light" href="/pricing#matrix">
          Compare all three side by side <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S7  Selected work
  ============================================================ -->
  <section class="section work" id="work">
    <div class="container">
      <header class="s-head">
        <span class="eyebrow" data-reveal>Selected work</span>
        <h2 class="headline h2" data-reveal>Real brand <span class="accent">work</span>.</h2>
        <p class="s-head__intro" data-reveal>
          A sample of what we have shipped recently across beauty, automotive, consumer
          tech, and retail.
        </p>
      </header>

      <div class="work-grid">
        {
          cases.map((c, i) => (
            <a class="study" href={`/work/${c.slug}`} data-reveal style={`--i:${i % 2}`}>
              <div class="study__media">
                <img
                  src={c.img}
                  alt={c.alt}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
                <span class="study__tag">{c.tag}</span>
              </div>
              <div class="study__body">
                <h3 class="study__client">{c.name}</h3>
                <p class="study__line">{c.line}</p>
                <span class="study__cta">
                  See the work <span class="arrow" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="work__more" data-reveal>
        <Button variant="secondary" href="/work">See all case studies</Button>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S8  What we believe
  ============================================================ -->
  <section class="believe section-dark" data-spot>
    <div class="grain believe__grain" aria-hidden="true"></div>
    <div class="container believe__inner">
      <span class="eyebrow eyebrow--orange" data-reveal>What we believe</span>
      <h2 class="believe__title" data-words>
        {
          beliefWords.map((w, i) => (
            <span class="bw" style={`--wi:${i}`}>
              <span>{w}</span>
            </span>
          ))
        }
        <span class="bw" style={`--wi:${beliefWords.length}`}>
          <span class="accent">matters</span>.
        </span>
      </h2>
      <div class="believe__copy">
        <p data-reveal>
          Culture cannot be briefed. Speed is the new craft. Anyone can generate a
          passable image now, so the work that counts is the direction behind it.
        </p>
        <p data-reveal>
          We hire creatives from the cultures our clients sell into. No translation
          layer, no briefing the brief.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S9  Insights
  ============================================================ -->
  <section class="section insights" id="insights">
    <div class="container">
      <header class="s-head">
        <span class="eyebrow" data-reveal>Resources</span>
        <h2 class="headline h2" data-reveal>Worth <span class="accent">reading</span>.</h2>
        <p class="s-head__intro" data-reveal>
          Practitioner notes on AI-native content, written by the people running the
          pipelines.
        </p>
      </header>

      <div class="ins-grid">
        {
          latestInsights.map((post, i) => (
            <a
              class="ins"
              href={`/resources/insights/${post.slug}`}
              data-reveal
              style={`--i:${i}`}
            >
              <div class="ins__media">
                <img
                  src={post.image}
                  alt={post.imageAlt}
                  width="1600"
                  height="1067"
                  loading="lazy"
                  decoding="async"
                />
                <span class={`ins__tag ins__tag--${post.tone}`}>{post.category}</span>
              </div>
              <div class="ins__body">
                <h3 class="ins__title">{post.title}</h3>
                <p class="ins__deck">{post.deck}</p>
                <p class="ins__meta">
                  <span>{post.author}</span>
                  <span class="ins__dot" aria-hidden="true"></span>
                  <span>{post.readingTime}</span>
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="work__more" data-reveal>
        <Button variant="secondary" href="/resources/insights">Read all insights</Button>
      </div>
    </div>
  </section>

  <!-- ============================================================
       S10  Closing CTA
  ============================================================ -->
  <section class="closing section-dark" data-spot>
    <div class="grain closing__grain" aria-hidden="true"></div>
    <div class="container closing__inner">
      <svg class="closing__cube" viewBox="0 0 32 35" aria-hidden="true">
        <path d="M16 4 28 11 16 18 4 11Z" fill="var(--brand-orange)" />
        <path d="M4 11 16 18 16 31 4 24Z" fill="var(--brand-navy)" />
        <path d="M28 11 16 18 16 31 28 24Z" fill="var(--brand-navy-deep)" />
      </svg>
      <span class="eyebrow eyebrow--orange" data-reveal>Get started</span>
      <h2 class="headline h2 closing__head" data-reveal>
        The production house brands choose when the old way
        <span class="accent">stops working</span>.
      </h2>
      <div class="closing__cta" data-reveal>
        <Button variant="primary" href="/contact">Talk to us</Button>
      </div>
      <a class="closing__mail" href="mailto:hello@hubstudio.ai" data-reveal>
        hello@hubstudio.ai
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ============================================================
     Shared
  ============================================================ */
  [data-reveal] {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
    will-change: opacity, transform;
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }

  [id] {
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }

  .section-dark {
    position: relative;
    background: var(--bg-ink);
    color: var(--text-on-dark);
    overflow: hidden;
  }

  .eyebrow--orange {
    color: var(--brand-orange);
  }

  /* Section header */
  .s-head {
    max-width: 720px;
    margin-bottom: clamp(48px, 6vw, 80px);
    display: grid;
    gap: 18px;
  }
  .s-head .h2 {
    margin-top: 2px;
  }
  .s-head__intro {
    font-size: var(--type-lead);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 60ch;
  }
  .s-head--dark .s-head__intro {
    color: rgba(240, 237, 233, 0.74);
  }

  /* Arrow link */
  .arrow-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .arrow-link--light {
    color: var(--text-on-dark);
  }
  .arrow .arrow,
  .arrow-link .arrow,
  .tile__cta .arrow,
  .study__cta .arrow,
  .way__cta .arrow {
    display: inline-block;
    transition: transform 200ms ease-out;
  }
  .arrow-link:hover .arrow {
    transform: translateX(5px);
  }

  /* Scroll progress */
  .scrollbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    background: transparent;
    pointer-events: none;
  }
  .scrollbar__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--brand-orange), #ff8a4c);
  }

  /* ============================================================
     S1  Hero
  ============================================================ */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(660px, 96vh, 1040px);
    overflow: hidden;
    background: var(--bg-ink);
    color: var(--text-on-dark);
    margin-top: -64px;
  }
  @media (min-width: 1024px) {
    .hero {
      margin-top: calc(-1 * var(--nav-h));
    }
  }
  .hero__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: -8%;
    height: 116%;
    z-index: 0;
    background: var(--bg-ink) url('/Video/home-hero-poster.webp') center / cover no-repeat;
    will-change: transform;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8, 12, 28, 0.95) 0%,
        rgba(8, 12, 28, 0.62) 48%,
        rgba(8, 12, 28, 0.2) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 12, 28, 0.66) 0%,
        rgba(8, 12, 28, 0.1) 30%,
        rgba(8, 12, 28, 0.86) 100%
      );
  }
