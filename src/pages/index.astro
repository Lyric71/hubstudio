/* The tallest landscape capture of a module (smallest width / height) sets
   its stage height on desktop; portrait captures are capped in width. */
const stageRatio = (m: Module) =>
  Math.min(
    ...m.features.map((f) => f.shot.width / f.shot.height).filter((r) => r >= 1),
  );

/* The makers in Explore, as plain text. No logos. */
