  </div>

  <!-- ==========================================================
       Closing: both doors (shared component)
  ========================================================== -->
  <DualCta />
</Layout>

<style>
  /* ============================================================
     Shared primitives
  ============================================================ */
  .home {
    --shadow-sheet: 0 -30px 64px -36px rgba(10, 10, 20, 0.42);
    --shadow-sheet-dark: 0 -36px 80px -34px rgba(0, 0, 0, 0.62);
    --shadow-card: 0 2px 6px rgba(10, 10, 20, 0.04),
      0 14px 30px -12px rgba(10, 10, 20, 0.12);
    --shadow-card-hi: 0 6px 14px rgba(10, 10, 20, 0.08),
      0 36px 64px -24px rgba(10, 10, 20, 0.28);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    position: relative;
    /* Decorative bleeds (who__accent) sit in cream sheets
       that are not clipped; on narrow screens they push past the viewport
       gutter. clip kills the horizontal scroll without becoming a scroll
       container, so the sticky who__figure still resolves against the page. */
    overflow-x: clip;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: calc(var(--i, 0) * 95ms);
    will-change: opacity, transform;
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Sheet stacking: each section overlaps the previous for layered depth */
  .sheet {
    position: relative;
    border-radius: clamp(28px, 3.6vw, 60px) clamp(28px, 3.6vw, 60px) 0 0;
    margin-top: clamp(-60px, -4.6vw, -40px);
  }
  .sheet--first {
    z-index: 2;
  }
  .sheet--first.section {
    padding-top: clamp(56px, 5.5vw, 96px);
  }
  .sheet--light {
    background: var(--bg-white);
    box-shadow: var(--shadow-sheet);
  }
  .sheet--cream {
    background: var(--bg-cream);
    box-shadow: var(--shadow-sheet);
  }
  .sheet--ink {
    background: var(--bg-ink);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-sheet-dark);
    overflow: hidden;
  }
  .sheet--navy {
    background: var(--brand-navy-deep);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-sheet-dark);
    overflow: hidden;
  }
  .section {
    padding-block: clamp(96px, 11vw, 168px);
  }
  .sheet__grain {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    pointer-events: none;
  }
  .sheet .container {
    position: relative;
    z-index: 1;
  }
  [id] {
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  /* Section header */
  .s-head {
    max-width: 720px;
    margin-bottom: clamp(48px, 6vw, 84px);
    display: grid;
    gap: 18px;
  }
  .s-head--row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
  }
  .s-head--row .eyebrow {
    margin-bottom: 14px;
  }
  .s-head--row .s-head__intro {
    max-width: 38ch;
    padding-bottom: 6px;
  }
  .s-head__intro {
    font-size: var(--type-lead);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 60ch;
  }
  .s-head--dark .s-head__intro {
    color: rgba(240, 237, 233, 0.74);
  }
  .eyebrow--orange {
    color: var(--brand-orange);
  }
  .headline .accent,
  .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
  }

  .block-more {
    margin-top: clamp(48px, 6vw, 80px);
    text-align: center;
  }

  /* Arrow link */
  .arrow-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .arrow-link--light {
    color: var(--text-on-dark);
  }
  .arrow {
    display: inline-block;
    transition: transform 220ms var(--ease);
  }
  .arrow-link:hover .arrow {
    transform: translateX(6px);
  }

  /* Scroll progress */
  .scrollbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .scrollbar__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--brand-orange), #ff9a5c);
  }

  /* ============================================================
     Hero: headline, both doors, and a real capture of the app
  ============================================================ */
  .hero {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: var(--bg-ink);
    color: var(--text-on-dark);
    margin-top: -64px;
    padding-bottom: clamp(100px, 9vw, 150px);
  }
  @media (min-width: 1024px) {
    .hero {
      margin-top: calc(-1 * var(--nav-h));
    }
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(90% 70% at 88% 0%, rgba(30, 58, 138, 0.5), transparent 62%),
      var(--bg-ink);
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.5;
  }
  /* One warm light source, low behind the capture. */
  .hero__glow {
    position: absolute;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    left: 50%;
    bottom: -30%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(233, 78, 27, 0.34), transparent 62%);
    filter: blur(24px);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-h) + clamp(40px, 6vw, 84px));
  }
  .hero__top {
    display: grid;
    gap: clamp(24px, 3vw, 36px);
  }
  .hero__eyebrow {
    margin-bottom: 20px;
  }
  .hero__title {
    margin: 0;
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    font-size: clamp(40px, 6.2vw, 84px);
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__title .line > span {
    display: block;
  }
  .hero__title .accent {
    color: var(--brand-orange);
  }
  .hero__side {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 960px) {
    .hero__side {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 56px;
    }
  }
  .hero__lead {
    max-width: 54ch;
    font-size: var(--type-lead);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.86);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__micro {
    margin-top: 14px;
    font-size: var(--type-small);
    line-height: 1.5;
    color: rgba(240, 237, 233, 0.66);
  }
  .hero__micro a {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero__micro a:hover {
    color: var(--brand-orange);
  }
  .hero__shot {
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* Hero load stagger */
  .hero__eyebrow,
  .hero__lead,
  .hero__actions,
  .hero__shot {
    opacity: 0;
    animation: heroFade 0.95s var(--ease) forwards;
  }
  .hero__eyebrow {
    animation-delay: 0.12s;
  }
  .hero__title .line:nth-child(1) > span {
    animation: heroLine 1s cubic-bezier(0.16, 0.84, 0.3, 1) 0.24s both;
  }
  .hero__title .line:nth-child(2) > span {
    animation: heroLine 1s cubic-bezier(0.16, 0.84, 0.3, 1) 0.36s both;
  }
  .hero__title .line:nth-child(3) > span {
    animation: heroLine 1s cubic-bezier(0.16, 0.84, 0.3, 1) 0.48s both;
  }
  .hero__lead {
    animation-delay: 0.62s;
  }
  .hero__actions {
    animation-delay: 0.72s;
  }
  .hero__shot {
    animation-delay: 0.84s;
  }
  @keyframes heroLine {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__lead,
    .hero__actions,
    .hero__shot,
    .hero__title .line > span {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }

  /* ============================================================
     The app in four stages
  ============================================================ */
  .stages {
    display: grid;
    gap: clamp(18px, 2.2vw, 28px);
  }
  @media (min-width: 900px) {
    .stages {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .stage {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: clamp(22px, 2.4vw, 32px);
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
    transition:
      opacity 0.8s var(--ease),
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }
  .stage:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hi);
  }
  .stage__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(28px, 3vw, 40px) clamp(26px, 3vw, 40px) 0;
  }
  .stage__title {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .stage__body {
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
    max-width: 58ch;
  }
  /* The capture rises from the bottom edge of the card and is cut by it,
     so four screens of different shapes sit on one baseline. */
  .stage__peek {
    margin-top: auto;
    height: clamp(250px, 25vw, 350px);
    padding: clamp(26px, 3vw, 36px) clamp(22px, 3vw, 40px) 0;
    overflow: hidden;
    background: linear-gradient(180deg, transparent, rgba(233, 78, 27, 0.07));
  }
  .stage__peek :global(.appshot) {
    transition: transform 0.5s var(--ease);
  }
  .stage:hover .stage__peek :global(.appshot) {
    transform: translateY(-10px);
  }
  .stage__peek--narrow {
    display: flex;
    justify-content: center;
  }
  .stage__peek--narrow :global(.appshot) {
    width: min(300px, 78%);
  }
  .app__foot {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 28px;
    border-top: 1px solid var(--line-hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .app__aside {
    max-width: 52ch;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .app__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .app__links .arrow-link {
    align-self: center;
  }

  /* ============================================================
     Engines: the makers as plain type, no logos
  ============================================================ */
  .engines {
    display: grid;
    gap: clamp(40px, 6vw, 88px);
  }
  @media (min-width: 960px) {
    .engines {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
    }
  }
  .engines__text {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .engines__body {
    max-width: 58ch;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .makers {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 6px;
    padding: clamp(30px, 3.6vw, 48px);
    border-radius: clamp(22px, 2.4vw, 32px);
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card);
  }
  .maker {
    font-size: clamp(26px, 3vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--text-ink);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease),
      color 0.2s ease;
  }
  .maker::after {
    content: '/';
    margin: 0 0.3em;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .maker:last-child::after {
    content: none;
  }
  .maker:hover {
    color: var(--brand-orange);
  }

  /* ============================================================
     Studio services, bento
  ============================================================ */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 1.6vw, 22px);
    perspective: 1400px;
  }
  @media (min-width: 620px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile--w7 {
      grid-column: span 2;
    }
  }
  @media (min-width: 980px) {
    .bento {
      grid-template-columns: repeat(12, 1fr);
    }
    .tile--w7 {
      grid-column: span 7;
    }
    .tile--w5 {
      grid-column: span 5;
    }
    .tile--w6 {
      grid-column: span 6;
    }
  }

  .tile {
    --rx: 0deg;
    --ry: 0deg;
    --lift: 0px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 260px;
    padding: clamp(26px, 2.6vw, 38px);
    border-radius: clamp(20px, 2vw, 30px);
    overflow: hidden;
    transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry))
      translateY(var(--lift));
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 0%),
      rgba(233, 78, 27, 0.26),
      transparent 68%
    );
  }
  .tile:hover {
    --lift: -6px;
  }
  .tile:hover::before {
    opacity: 1;
  }
  .bento:has(.tile:hover) .tile:not(:hover) {
    opacity: 0.62;
  }
  .tile--white {
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card);
  }
  .tile--white:hover {
    box-shadow: var(--shadow-card-hi);
  }
  .tile--cream {
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
  }
  .tile--cream:hover {
    box-shadow: var(--shadow-card-hi);
  }
  .tile--ink {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(30, 58, 138, 0.5), transparent 60%),
      var(--bg-ink);
    color: var(--text-on-dark);
  }
  .tile--orange {
    background:
      radial-gradient(120% 140% at 0% 100%, rgba(255, 255, 255, 0.22), transparent 55%),
      var(--brand-orange);
    color: #fff;
  }
  .tile__ghost {
    position: absolute;
    right: -10px;
    bottom: -24px;
    width: 168px;
    height: 168px;
    z-index: 0;
    opacity: 0.07;
    pointer-events: none;
    transition: transform 0.5s var(--ease), opacity 0.4s ease;
  }
  .tile--ink .tile__ghost,
  .tile--orange .tile__ghost {
    opacity: 0.14;
  }
  .tile__ghost svg {
    width: 100%;
    height: 100%;
  }
  .tile:hover .tile__ghost {
    transform: rotate(-12deg) scale(1.12);
    opacity: 0.13;
  }
  .tile--ink:hover .tile__ghost,
  .tile--orange:hover .tile__ghost {
    opacity: 0.2;
  }
  .tile__icon {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    flex: none;
    background: rgba(10, 10, 20, 0.05);
  }
  .tile--ink .tile__icon,
  .tile--orange .tile__icon {
    background: rgba(255, 255, 255, 0.12);
  }
  .tile__icon svg {
    width: 32px;
    height: 32px;
    overflow: visible;
  }
  .tile__icon .ic-accent {
    fill: var(--brand-orange);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.36s var(--ease);
  }
  .tile--orange .tile__icon .ic-accent {
    fill: #fff;
  }
  .tile__icon .ic-fill {
    fill: var(--bg-white);
  }
  .tile--cream .tile__icon .ic-fill {
    fill: var(--bg-cream);
  }
  .tile--ink .tile__icon .ic-fill {
    fill: var(--bg-ink);
  }
  .tile:hover .tile__icon .ic-accent {
    transform: scale(1.34);
  }
  .tile__body {
    position: relative;
    z-index: 1;
    flex: 1;
  }
  .tile__name {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .tile__summary {
    margin-top: 13px;
    font-size: var(--type-body);
    line-height: 1.6;
    max-width: 42ch;
    color: var(--text-mute);
  }
  .tile--ink .tile__summary,
  .tile--orange .tile__summary {
    color: rgba(240, 237, 233, 0.82);
  }

  /* Service lines inside each bento tile: the links to /services/design/*. */
  .tile__lines {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tile__lines a {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.55);
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--text-ink);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .tile__lines a:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
  }
  .tile--ink .tile__lines a,
  .tile--orange .tile__lines a {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }
  .tile--ink .tile__lines a:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
  }
  .tile--orange .tile__lines a:hover {
    background: #fff;
    border-color: #fff;
    color: var(--brand-orange);
  }

  /* Studio block additions */
  .who__media img {
    object-position: 10% 50%;
  }
  .who__proof {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-ink);
  }
  .who__proof a {
    margin-left: 4px;
    font-weight: 600;
    color: var(--brand-orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .who__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .who__cta .arrow-link {
    align-self: center;
  }

  /* ============================================================
     Studio + app
  ============================================================ */
  .sheet--navy::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    left: var(--sx, 50%);
    top: var(--sy, 30%);
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(233, 78, 27, 0.16), transparent 62%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }
  .sheet--navy[data-lit]::before {
    opacity: 1;
  }
  .sa {
    display: grid;
    gap: clamp(44px, 6vw, 80px);
  }
  @media (min-width: 1000px) {
    .sa {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .sa__text {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .sa__title {
    color: #fff;
  }
  .sa__title .accent {
    color: var(--brand-orange);
  }
  .sa__body {
    max-width: 58ch;
    font-size: var(--type-body);
    line-height: 1.66;
    color: rgba(240, 237, 233, 0.78);
  }
  .sa__visual {
    position: relative;
  }
  .sa__photo {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: clamp(20px, 2.4vw, 32px);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .sa__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The client's view laid over the photo's lower edge: the producer works,
     the client sees only the finished work. */
  .sa__shot {
    position: relative;
    width: 94%;
    margin: -12% 0 0 auto;
  }
  @media (min-width: 1000px) {
    .sa__shot {
      width: 104%;
      margin-right: -8%;
    }
  }

  /* Audience tabs sit on a cream sheet here: lift the track to white. */
  .sheet--cream .tabs__list {
    background: var(--bg-white);
  }
  .for__aside {
    margin-top: 28px;
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .for__aside a {
    font-weight: 600;
    color: var(--brand-orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============================================================
     Pricing: how paying works, no amounts
  ============================================================ */
  .pay__updated {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pay {
    display: grid;
    gap: clamp(18px, 2.2vw, 28px);
  }
  @media (min-width: 900px) {
    .pay {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pay__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(30px, 3.4vw, 48px);
    border-radius: clamp(22px, 2.4vw, 32px);
  }
  .pay__card--app {
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(30, 58, 138, 0.5), transparent 60%),
      var(--bg-ink);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-card-hi);
  }
  .pay__card--studio {
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
  }
  .pay__title {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  .pay__text {
    font-size: var(--type-body);
    line-height: 1.64;
    color: var(--text-mute);
  }
  .pay__card--app .pay__text {
    color: rgba(240, 237, 233, 0.8);
  }
  .pay__cta {
    margin-top: auto;
    padding-top: 10px;
  }
  .pay__more {
    align-self: center;
  }

  /* ============================================================
     The studio
  ============================================================ */
  .who {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 960px) {
    .who {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 72px;
      align-items: start;
    }
  }
  .who__figure {
    position: relative;
    margin: 0;
  }
  @media (min-width: 960px) {
    .who__figure {
      position: sticky;
      top: calc(var(--nav-h) + 40px);
    }
  }
  .who__accent {
    position: absolute;
    inset: 28px -28px -28px 28px;
    border-radius: clamp(20px, 2.4vw, 32px);
    background: var(--brand-orange);
    z-index: 0;
  }
  .who__media {
    position: relative;
    z-index: 1;
    border-radius: clamp(20px, 2.4vw, 32px);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-cream);
    box-shadow: var(--shadow-card-hi);
  }
  .who__media img {
    width: 100%;
    height: 122%;
    object-fit: cover;
    will-change: transform;
  }
  .who__cap {
    position: absolute;
    z-index: 2;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.82);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .who__cap-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .who__text {
    display: grid;
    gap: 24px;
  }
  .who__statement {
    font-size: clamp(27px, 3.3vw, 44px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.18;
  }
  .who__statement .accent {
    color: var(--brand-orange);
  }
  .who__body {
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .who__stats {
    margin-top: 14px;
    display: grid;
    gap: 4px;
  }
  .who-stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 8px 22px;
    padding: 26px 0;
    border-top: 1px solid var(--line-strong);
  }
  .who-stat:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .who-stat__num {
    display: flex;
    align-items: baseline;
    font-size: clamp(44px, 5vw, 68px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .who-stat__num i {
    font-style: normal;
    color: var(--brand-orange);
  }
  .who-stat__num--word {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .who-stat__label {
    grid-column: 2;
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--text-mute);
    max-width: 30ch;
  }

  /* ============================================================
     Who it's for, tabs
  ============================================================ */
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 7px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    margin-bottom: 28px;
    background: var(--bg-cream);
  }
  /* Below the md breakpoint the four tabs cannot share one row without an
     unbalanced 3+1 wrap, so swipe them horizontally instead. At >=768px they
     fit one row and the pill / flex-wrap layout above takes over. */
  @media (max-width: 767.98px) {
    .tabs__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: 20px;
      scrollbar-width: none;
    }
    .tabs__list::-webkit-scrollbar {
      display: none;
    }
  }
  .tab {
    flex: 1;
    min-width: max-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 24px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: var(--type-button);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-mute);
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }
  .tab:hover {
    color: var(--text-ink);
  }
  .tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
    transition: opacity 220ms ease;
  }
  .tab[aria-selected='true'] {
    background: var(--bg-ink);
    color: #fff;
    box-shadow: 0 8px 20px -8px rgba(10, 10, 20, 0.5);
  }
  .tab[aria-selected='true'] .tab__dot {
    background: var(--brand-orange);
    opacity: 1;
  }

  .panel[hidden] {
    display: none;
  }
  .panel {
    display: grid;
    border-radius: clamp(22px, 2.4vw, 34px);
    overflow: hidden;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card-hi);
  }
  @media (min-width: 820px) {
    .panel {
      grid-template-columns: 0.82fr 1.18fr;
    }
  }
  .panel__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-cream);
  }
  @media (min-width: 820px) {
    .panel__media {
      aspect-ratio: auto;
    }
  }
  .panel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .panel__badge {
    position: absolute;
    left: 18px;
    top: 18px;
    padding: 8px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.82);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .panel__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(30px, 4vw, 58px);
  }
  .panel__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(25px, 2.8vw, 38px);
    line-height: 1.16;
    letter-spacing: -0.01em;
  }
  .panel__text {
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .panel__body .arrow-link {
    margin-top: 4px;
  }
  .panel.is-active .panel__media img {
    animation: panelMedia 0.75s var(--ease) both;
  }
  .panel.is-active .panel__body > * {
    animation: panelRise 0.62s var(--ease) both;
  }
