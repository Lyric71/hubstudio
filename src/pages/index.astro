<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- Scroll-reveal -------------------------------------------- */
  const reveals = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -7% 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('in'));
  }

  /* ---- Word-by-word headline ----------------------------------- */
  const wordBlock = document.querySelector('[data-words]');
  if (wordBlock) {
    if ('IntersectionObserver' in window) {
      const wio = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              wio.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.34 },
      );
      wio.observe(wordBlock);
    } else {
      wordBlock.classList.add('in');
    }
  }

  /* ---- Count-up stats ------------------------------------------ */
  const counts = document.querySelectorAll<HTMLElement>('.count');
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const runCount = (el: HTMLElement) => {
    const target = Number(el.dataset.to || '0');
    if (RM) {
      el.textContent = String(target);
      return;
    }
    const dur = 1700;
    const start = performance.now();
    const step = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      el.textContent = String(Math.round(easeOut(p) * target));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (counts.length && 'IntersectionObserver' in window) {
    const cio = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runCount(entry.target as HTMLElement);
            cio.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.7 },
    );
    counts.forEach((el) => cio.observe(el));
  } else {
    counts.forEach((el) => (el.textContent = el.dataset.to || '0'));
  }

  /* ---- Scroll engine: progress, parallax ----------------------- */
  const fill = document.querySelector<HTMLElement>('.scrollbar__fill');
  const parallax = document.querySelectorAll<HTMLElement>('[data-parallax]');
  let ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    const vh = window.innerHeight;
    const max = document.documentElement.scrollHeight - vh;
    if (fill) fill.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
    if (!RM) {
      parallax.forEach((img) => {
        const speed = Number(img.dataset.speed || '0.1');
        const rect = img.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < vh) {
          const offset = (rect.top + rect.height / 2 - vh / 2) / vh;
          img.style.transform = `translate3d(0, ${offset * -speed * 200}px, 0)`;
        }
      });
    }
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    },
    { passive: true },
  );
  onScroll();

  /* ---- 3D pointer tilt ----------------------------------------- */
  if (!RM && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const MAX = 6;
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        el.style.transition = 'none';
        el.style.setProperty('--ry', `${(px - 0.5) * MAX * 2}deg`);
        el.style.setProperty('--rx', `${(0.5 - py) * MAX * 2}deg`);
        el.style.setProperty('--mx', `${px * 100}%`);
        el.style.setProperty('--my', `${py * 100}%`);
      });
      el.addEventListener('pointerleave', () => {
        el.style.transition = '';
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
      });
    });
  }

  /* ---- Pointer-tracked glow ------------------------------------ */
  document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });

  /* ---- Pointer spotlight on dark bands ------------------------- */
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--sx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--sy', `${((e.clientY - r.top) / r.height) * 100}%`);
      el.setAttribute('data-lit', '');
    });
    el.addEventListener('pointerleave', () => el.removeAttribute('data-lit'));
  });

  /* ---- Magnetic buttons ---------------------------------------- */
  if (!RM && window.matchMedia('(pointer: fine)').matches) {
    document
      .querySelectorAll<HTMLElement>('.hero__cta .btn')
      .forEach((btn) => {
        btn.addEventListener('pointermove', (e) => {
          const r = btn.getBoundingClientRect();
          const mx = e.clientX - r.left - r.width / 2;
          const my = e.clientY - r.top - r.height / 2;
          btn.style.transform = `translate(${mx * 0.28}px, ${my * 0.34}px)`;
        });
        btn.addEventListener('pointerleave', () => {
          btn.style.transform = '';
        });
      });
  }

  /* ---- Audience tabs ------------------------------------------- */
  const tabList = document.querySelector('.tabs__list');
  if (tabList) {
    const tabs = Array.from(tabList.querySelectorAll<HTMLButtonElement>('.tab'));
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('.tabs__panels .panel'),
    );
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel, i) => {
        panel.classList.remove('is-active');
        panel.hidden = i !== index;
      });
      const active = panels[index];
      if (active) {
        void active.offsetWidth;
        active.classList.add('is-active');
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          activate((i + 1) % tabs.length, true);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          activate((i - 1 + tabs.length) % tabs.length, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          activate(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          activate(tabs.length - 1, true);
        }
      });
    });
  }

  /* ---- App tour: modules, then features ------------------------- */
  /* Without this script every module and feature stays stacked with its
     capture. With it, the modules become tabs, each feature name becomes a
     button, and only the picked feature shows its body and its screen. */
  const tour = document.querySelector<HTMLElement>('[data-tour]');
  const tourList = tour?.querySelector<HTMLElement>('.tour__tabs');
  if (tour && tourList) {
    const modTabs = Array.from(tourList.querySelectorAll<HTMLButtonElement>('.tour__tab'));
    const mods = Array.from(tour.querySelectorAll<HTMLElement>('.mod'));

    /* A screen that is not shown is display:none, so its lazy image waits.
       Hovering a feature starts its download a beat before the click. */
    const warm = (shot: HTMLElement | null) => {
      const img = shot?.querySelector('img');
      if (img && img.loading === 'lazy') img.loading = 'eager';
    };

    mods.forEach((mod, mi) => {
      mod.setAttribute('role', 'tabpanel');
      mod.setAttribute('aria-labelledby', modTabs[mi]?.id ?? '');

      const feats = Array.from(mod.querySelectorAll<HTMLElement>('.feat'));
      const shots = feats.map((f) => f.querySelector<HTMLElement>('.feat__shot'));
      const timers = new Map<HTMLElement, number>();

      const btns = feats.map((feat, i) => {
        const name = feat.querySelector<HTMLElement>('.feat__name')!;
        const more = feat.querySelector<HTMLElement>('.feat__more');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'feat__btn';
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-controls', [more?.id, shots[i]?.id].filter(Boolean).join(' '));
        btn.append(...Array.from(name.childNodes));
        name.append(btn);
        return btn;
      });

      const pick = (index: number, focus = false, user = true) => {
        feats.forEach((feat, i) => {
          const on = i === index;
          const shot = shots[i];
          const wasOn = feat.classList.contains('is-on');
          feat.classList.toggle('is-on', on);
          btns[i].setAttribute('aria-pressed', on ? 'true' : 'false');
          if (!shot) return;
          const t = timers.get(shot);
          if (t) window.clearTimeout(t);
          shot.classList.remove('is-leaving');
          /* The outgoing screen fades out over the incoming one. */
          if (wasOn && !on && !RM) {
            shot.classList.add('is-leaving');
            timers.set(
              shot,
              window.setTimeout(() => shot.classList.remove('is-leaving'), 380),
            );
          }
        });
        if (user) warm(shots[index]);
        if (focus) btns[index].focus();
      };

      btns.forEach((btn, i) => {
        btn.addEventListener('click', () => pick(i));
        btn.addEventListener('pointerenter', () => warm(shots[i]));
        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            pick((i + 1) % btns.length, true);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            pick((i - 1 + btns.length) % btns.length, true);
          }
        });
      });

      pick(0, false, false);
    });

    const show = (index: number, focus = false) => {
      modTabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected) {
          /* Keep the picked chip in view inside its own scroller. */
          const left = tab.offsetLeft - (tourList.clientWidth - tab.offsetWidth) / 2;
          tourList.scrollTo({ left, behavior: RM ? 'auto' : 'smooth' });
          if (focus) tab.focus();
        }
      });
      mods.forEach((mod, i) => {
        mod.classList.remove('is-active');
        mod.hidden = i !== index;
      });
      const active = mods[index];
      if (active) {
        void active.offsetWidth;
        active.classList.add('is-active');
      }
    };

    modTabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('pointerenter', () =>
        warm(mods[i]?.querySelector<HTMLElement>('.feat.is-on .feat__shot') ?? null),
      );
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          show((i + 1) % modTabs.length, true);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          show((i - 1 + modTabs.length) % modTabs.length, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          show(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          show(modTabs.length - 1, true);
        }
      });
    });

    tourList.hidden = false;
    tour.classList.add('is-live');
    show(0);
  }
</script>
