  @media (min-width: 720px) {
    .counters {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .counter {
    padding: 40px 32px;
    border-bottom: 1px solid var(--line-hairline);
  }
  .counter:last-child {
    border-bottom: none;
  }
  @media (min-width: 720px) {
    .counter {
      border-bottom: none;
      border-right: 1px solid var(--line-hairline);
    }
    .counter:last-child {
      border-right: none;
    }
  }
  .counter__num {
    display: flex;
    align-items: baseline;
    font-size: clamp(48px, 5.6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .counter__num i {
    font-style: normal;
    color: var(--brand-orange);
  }
  .counter__num--word {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .counter__label {
    display: block;
    margin-top: 14px;
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--text-mute);
    max-width: 26ch;
  }

  /* ============================================================
     S4  Who we work with, tabs
  ============================================================ */
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    margin-bottom: 28px;
  }
  @media (max-width: 559px) {
    .tabs__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: 18px;
      scrollbar-width: none;
    }
    .tabs__list::-webkit-scrollbar {
      display: none;
    }
  }
  .tab {
    flex: 1;
    min-width: max-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 22px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: var(--type-button);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-mute);
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out;
  }
  .tab:hover {
    color: var(--text-ink);
  }
  .tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
    transition: opacity 200ms ease-out;
  }
  .tab[aria-selected='true'] {
    background: var(--bg-ink);
    color: #fff;
  }
  .tab[aria-selected='true'] .tab__dot {
    background: var(--brand-orange);
    opacity: 1;
  }

  .panel[hidden] {
    display: none;
