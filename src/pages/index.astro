                    stroke-width="7"
                    stroke-linecap="round"
                  />
                </svg>
              </span><span class="believe__stop">.</span>
            </span>
          </span>
        </h2>

        <div class="believe__list">
          {
            beliefs.map((b, i) => (
              <div class="belief" data-reveal style={`--i:${i}`}>
                <span class="belief__line" aria-hidden="true" />
