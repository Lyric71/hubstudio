              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================================
         Insights: the four newest entries, lead plus grid
    ========================================================== -->
    <section class="sheet sheet--cream section" id="insights">
      <div class="container">
        <header class="s-head s-head--row">
          <div>
            <span class="eyebrow" data-reveal>Resources</span>
            <h2 class="headline h2" data-reveal>Worth <span class="accent">reading</span>.</h2>
          </div>
          <p class="s-head__intro" data-reveal>
            Notes from the people who do the work, on what AI content takes in practice.
