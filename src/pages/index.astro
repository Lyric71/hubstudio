---
/**
 * Home (`/`): cinematic editorial rebuild from hubstudio-homepage-content.md.
 *
 * Design system layered on top of the global tokens:
 *  - Sheet stacking: every section is a rounded panel that overlaps the
 *    previous one, so the page reads as depth, not flat bands.
 *  - Scroll engine: progress bar, hero scale/parallax, [data-parallax]
 *    layers, [data-reveal] staggered reveals, count-up, kinetic type.
 *  - Tactile components: 3D pointer tilt, magnetic buttons, pointer glow,
 *    tabbed audience switcher. All gated on prefers-reduced-motion.
 *
 * S1 Hero . S2 Produce (bento) . S3 Who we are (sticky) .
 * S4 Solutions (tabs) . S5 Consulting + Training (feature rows) .
 * S6 How to engage (dark) . S7 Selected work . S8 Believe (manifesto) .
 * S9 Insights . S10 Closing.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { caseStudies } from '../data/case-studies';
import { insights } from '../data/insights';

/* S2: six service categories, mapped to the /services section anchors. */
const categories = [
  {
    id: 'content-social',
    name: 'Content & Social',
    summary: 'The assets that ship weekly. Social posts, ad creative, short video, email.',
    span: 'w7',
    tone: 'ink',
    icon: 'content',
  },
  {
    id: 'video-motion',
    name: 'Video & Motion',
    summary: 'Moving image, long and short. Scripted, shot, edited, animated.',
    span: 'w5',
    tone: 'white',
    icon: 'video',
  },
  {
    id: 'commerce-web',
    name: 'Commerce & Web',
    summary: 'Everything that sells or hosts the brand. Ecommerce visuals, websites, print.',
    span: 'w5',
    tone: 'white',
    icon: 'commerce',
  },
  {
    id: 'strategy-direction',
    name: 'Strategy & Direction',
    summary: 'The thinking before the pixels. Marketing and creative strategy, concept, storyboard.',
    span: 'w7',
    tone: 'orange',
    icon: 'strategy',
  },
  {
    id: 'brand-identity',
    name: 'Brand Identity',
    summary: 'The system everything else flows from. Logos, illustration, packaging and merch.',
    span: 'w6',
    tone: 'white',
    icon: 'brand',
  },
  {
    id: 'sales-communications',
    name: 'Sales & Communications',
    summary: 'Decks, docs, news. Presentations, pitch decks, reports, press releases.',
    span: 'w6',
    tone: 'cream',
    icon: 'sales',
  },
];

/* S4: the four audiences, each a tab panel. */
const audiences = [
  {
    id: 'brands',
    name: 'Brands',
    tagline: 'AIGC built around the brand.',
    body: 'Industry-trained models, custom training on your visual DNA, and multi-market output. The same line shows up in fifty places and reads native in every one.',
    chips: ['Industry-trained models', 'Visual-DNA training', 'Multi-market output'],
    href: '/solutions/brands',
    img: '/Images/brands-hero.jpg',
    alt: 'A brand marketing team reviewing a wall of multi-market campaign visuals in a sunlit studio.',
  },
  {
    id: 'agencies',
    name: 'Agencies',
    tagline: 'Your invisible production team.',
    body: 'You own the client, the strategy, and the creative direction. We handle visuals, video, and adaptations at AIGC speed, delivered under your name.',
    chips: ['White-label delivery', 'Visuals and video', 'AIGC speed'],
    href: '/solutions/agencies',
    img: '/Images/agencies-hero.jpg',
    alt: 'An agency creative director directing a project from a laptop in a busy open studio.',
  },
  {
    id: 'retailers',
    name: 'Retailers',
    tagline: 'Every product, every market.',
    body: 'Thousands of brand-correct assets a month across categories, channels, and seasons. Every touchpoint covered, without breaking the calendar.',
    chips: ['Thousands a month', 'Every channel', 'Every season'],
    href: '/solutions/retailers',
    img: '/Images/retailers-hero.jpg',
    alt: 'A retail content team managing a large catalog of product visuals across multiple screens.',
  },
  {
    id: 'manufacturers',
    name: 'Manufacturers',
    tagline: 'Product reality, made sellable.',
    body: 'From the spec sheet to the marketplace tile, the trade-show booth to the launch reel, product reality is turned into content the channel can sell. All on one production line.',
    chips: ['Spec sheet to tile', 'Booth to launch reel', 'One production line'],
    href: '/solutions/manufacturers',
    img: '/Images/manufacturers-hero.jpg',
    alt: 'A manufacturing product shown as polished marketing content beside its technical reference.',
  },
];

/* S5: consulting and training, alternating editorial feature rows. */
const programs = [
  {
    kind: 'Consulting',
    title: 'Architect the studio inside your business.',
    body: 'Infrastructure, integration, governance, and team development, run by senior leads from our active production practice. From pilot to operating capability, with a roadmap that survives the next model release.',
    points: ['Infrastructure and integration', 'Governance at scale', 'Pilot to operating capability'],
    href: '/solutions/consulting',
    img: '/Images/cs-strategy-room.jpg',
    alt: 'A strategy room where senior leads map out an AIGC studio build on a printed wall plan.',
    accent: 'orange',
  },
  {
    kind: 'Training',
    title: 'Past prompt demos, into production muscle.',
    body: 'Cohorts learn inside the studio, on real briefs, with the engineers and creative directors who ship hubStudio work every week. Beginner and advanced modules, English and Mandarin, customized by industry.',
    points: ['Real briefs, live studio', 'Beginner and advanced modules', 'English and Mandarin'],
    href: '/solutions/training',
    img: '/Images/cyril-masterclass-AIGC.jpg',
    alt: 'Cyril Drouin presenting a masterclass on AIGC and creative production.',
    accent: 'navy',
  },
];

/* S6: the three ways to work. Middle model is visually featured. */
const ways = [
  {
    name: 'Asset-Based',
    tagline: 'Pay for what you ship.',
    body: 'You send the brief, we produce the work. Volume formats with MOQs, plus per-project items quoted on scope. Some of it we generate, some we shoot, and plenty of briefs land in between.',
    facts: ['Volume formats', 'No lock-in'],
    href: '/pricing#asset-based',
    featured: false,
  },
  {
    name: 'Project-Based',
    tagline: 'Built for your next launch.',
    body: 'We assemble the team around your brief: creative director, art director, AIGC engineer, copywriter, producer. One quote, one schedule, one invoice.',
    facts: ['First review in two weeks', 'Full delivery in four'],
    href: '/pricing#project-based',
    featured: true,
  },
  {
    name: 'Subscription',
    tagline: 'Your studio on retainer.',
    body: 'A fixed monthly cost, and a team that gets faster the longer it works with you, because it stops relearning your brand on every job. Mix and match across every service line.',
    facts: ['Three, six or twelve-month terms', 'Every service line'],
    href: '/pricing#subscription',
    featured: false,
  },
];

/* S7: four selected case studies, image and alt sourced from data. */
const pick = (slug: string) => caseStudies.find((c) => c.slug === slug)!;
const cases = [
  { name: 'HiSense', tag: 'Consumer tech', line: 'Product visuals across every channel and format', slug: 'hisense' },
  { name: 'Shiseido RQ PYOLOGY', tag: 'Beauty', line: 'Clinical credibility and luxury appeal, in one frame', slug: 'shiseido-rq-pyology' },
  { name: 'age20', tag: 'Beauty', line: 'Skincare campaign content, generated and shot', slug: 'age20' },
  { name: 'Premium SUV', tag: 'Automotive', line: 'A global automotive launch, market by market', slug: 'premium-suv' },
].map((c) => {
  const d = pick(c.slug);
  return { ...c, img: d.hero.src, alt: d.hero.alt };
});

/* S9: latest insights. */
const [leadInsight, ...restInsights] = insights.slice(0, 4);

/* S8: belief headline split for kinetic reveal, plus the manifesto lines. */
const beliefWords = ['Creative', 'intelligence', 'is', 'the', 'only', 'thing', 'left', 'that'];
const beliefs = [
  'Culture cannot be briefed.',
  'Speed is the new craft.',
  'Anyone can generate a passable image now, so the work that counts is the direction behind it.',
  'We hire creatives from the cultures our clients sell into. No translation layer, no briefing the brief.',
];

---

<Layout
  heroOverlay
  title="hubStudio | AI-Native Content Production House"
  description="Real studio craft, deep AIGC expertise, and creative direction on top. Send the brief or run the platform. The work ships in days and looks like your brand."
  preloadImage="/Video/home-hero-poster.webp"
>
  <div class="scrollbar" aria-hidden="true"><span class="scrollbar__fill"></span></div>

  <div class="home">
    <!-- ==========================================================
         S1  Hero
    ========================================================== -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true">
        <video
          class="hero__video"
          id="hero-video"
          width="1920"
          height="1080"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          tabindex="-1"
          poster="/Video/home-hero-poster.webp"
        >
          <source src="/Video/home-hero.webm" type="video/webm" />
          <source src="/Video/home-hero.mp4" type="video/mp4" />
        </video>
        <div class="hero__scrim"></div>
        <div class="grain hero__grain"></div>
        <div class="hero__glow"></div>
      </div>

      <div class="container hero__inner">
        <div class="hero__content">
          <h1 class="hero__title">
            <span class="line"><span>A production house</span></span>
            <span class="line"><span>built for what content</span></span>
            <span class="line"><span>has <em class="accent">become</em>.</span></span>
          </h1>

          <p class="hero__lead">
            We pair real studio craft with deep AIGC expertise, run out of China where the
            production economics still work, and put creative direction on top of both.
            Send the brief, or run the platform yourself. Either way, the work ships in
            days and looks like it belongs to your brand.
          </p>

          <div class="hero__cta">
            <Button variant="primary" href="/contact">Talk to us</Button>
            <Button variant="on-dark" href="/work">See real brand work</Button>
          </div>
        </div>
      </div>

      <a class="hero__scroll" href="#produce" aria-label="Scroll to what we produce">
        <span>Scroll</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- ==========================================================
         S2  What we produce
    ========================================================== -->
    <section class="sheet sheet--light sheet--first section" id="produce">
      <div class="container">
        <header class="s-head">
          <span class="eyebrow" data-reveal>Services</span>
          <h2 class="headline h2" data-reveal>
            Twenty service lines, <span class="accent">one studio</span>.
          </h2>
          <p class="s-head__intro" data-reveal>
            From a single social post to a full campaign system, every format your brand
            reaches for, produced and finalized in days. Six categories, twenty service
            lines, one team running them on shared brand rules.
          </p>
        </header>

        <div class="bento">
          {
            categories.map((cat, i) => (
              <a
                class={`tile tile--${cat.span} tile--${cat.tone}`}
                href={`/services#${cat.id}`}
                data-reveal
                data-tilt
                style={`--i:${i}`}
              >
                <span class="tile__ghost" aria-hidden="true">
                  {cat.icon === 'content' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="4" y="4" width="16" height="16" rx="4.5" />
                      <rect x="12" y="12" width="16" height="16" rx="4.5" />
                    </svg>
                  )}
                  {cat.icon === 'video' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="6" width="21" height="20" rx="5.5" />
                      <path d="M11.5 12.2 18.7 16 11.5 19.8Z" />
                    </svg>
                  )}
                  {cat.icon === 'commerce' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="5" width="26" height="22" rx="4.5" />
                      <path d="M3 11.5h26" />
                    </svg>
                  )}
                  {cat.icon === 'strategy' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <circle cx="16" cy="16" r="11.5" />
                      <circle cx="16" cy="16" r="4" />
                    </svg>
                  )}
                  {cat.icon === 'brand' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <circle cx="16" cy="16" r="12" />
                      <rect x="8.5" y="8.5" width="15" height="15" rx="2.5" transform="rotate(45 16 16)" />
                    </svg>
                  )}
                  {cat.icon === 'sales' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="6" width="26" height="17.5" rx="3.5" />
                      <path d="M16 23.5v4.5" />
                    </svg>
                  )}
                </span>

                <span class="tile__icon" aria-hidden="true">
                  {cat.icon === 'content' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="4" y="4" width="16" height="16" rx="4.5" />
                      <rect class="ic-fill" x="12" y="12" width="16" height="16" rx="4.5" stroke="none" />
                      <rect x="12" y="12" width="16" height="16" rx="4.5" />
                      <circle class="ic-accent" cx="20" cy="20" r="3" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'video' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="3" y="6" width="21" height="20" rx="5.5" />
                      <path class="ic-accent" d="M11.5 12.2 18.7 16 11.5 19.8Z" stroke="none" />
                      <path d="M27 11h3M27 16h4M27 21h3" stroke-linecap="round" />
                    </svg>
                  )}
                  {cat.icon === 'commerce' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="3" y="5" width="26" height="22" rx="4.5" />
                      <path d="M3 11.5h26" />
                      <circle cx="7" cy="8.2" r="1.1" fill="currentColor" stroke="none" />
                      <rect class="ic-accent" x="12" y="16" width="11" height="7.5" rx="2.5" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'strategy' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <circle cx="16" cy="16" r="11.5" />
                      <path d="M16 2.5v5M16 24.5v5M2.5 16h5M24.5 16h5" stroke-linecap="round" />
                      <circle class="ic-accent" cx="16" cy="16" r="3.6" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'brand' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <circle cx="16" cy="16" r="12" />
                      <rect x="8.5" y="8.5" width="15" height="15" rx="2.5" transform="rotate(45 16 16)" />
                      <circle class="ic-accent" cx="16" cy="16" r="3.1" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'sales' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="3" y="6" width="26" height="17.5" rx="3.5" />
                      <path d="M16 23.5v4.5M11 28h10" stroke-linecap="round" />
                      <path d="M8.5 11.5h8" stroke-linecap="round" opacity="0.55" />
                      <circle class="ic-accent" cx="21.5" cy="15" r="3.4" stroke="none" />
                    </svg>
                  )}
                </span>

                <div class="tile__body">
                  <h3 class="tile__name">{cat.name}</h3>
                  <p class="tile__summary">{cat.summary}</p>
                </div>
                <span class="tile__cta">
                  Explore <span class="arrow" aria-hidden="true">&rarr;</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S3  Who we are
    ========================================================== -->
    <section class="sheet sheet--cream section" id="studio">
      <div class="container who">
        <figure class="who__figure">
          <div class="who__accent" aria-hidden="true"></div>
          <div class="who__media">
            <img
              src="/Images/who-we-are-office.webp"
              alt="The hubStudio production floor in China, a working studio of editors, directors and AIGC engineers."
              width="1280"
              height="1560"
              loading="lazy"
              decoding="async"
              data-parallax
              data-speed="0.12"
            />
          </div>
          <figcaption class="who__cap">
            <span class="who__cap-dot" aria-hidden="true"></span>
            Shanghai / Changsha / Hong Kong / Philippines
          </figcaption>
        </figure>

        <div class="who__text">
          <span class="eyebrow" data-reveal>Who we are</span>
          <p class="who__statement" data-reveal>
            The studios shipping hundreds of assets a month for global brands now were
            not built for that volume. <span class="accent">We were.</span>
          </p>
          <p class="who__body" data-reveal>
            hubStudio is a full production house, headquartered in Hong Kong with
            studios in Shanghai, Changsha, and the Philippines. We shoot, we direct,
            we retouch, we edit, the same way a traditional studio does. What sits on top is a generation layer most
            studios have not built yet:
            dedicated GPU infrastructure, brand-trained models, and pipelines our team
            runs every day.
          </p>
          <p class="who__body" data-reveal>
            That mix is where the economics change. A blended team in China, on hybrid
            pipelines that decide per asset whether to shoot it or generate it, brings
            the cost of a finalized asset down by half or more without trading off what
            lands on the page. The savings are real, and we pass them through.
          </p>

          <div class="who__stats">
            <div class="who-stat" data-reveal style="--i:0">
              <span class="who-stat__num"><span class="count" data-to="50">0</span><i>%</i></span>
              <span class="who-stat__bar" aria-hidden="true"></span>
              <span class="who-stat__label">Typical cut in the cost of a finalized asset</span>
            </div>
            <div class="who-stat" data-reveal style="--i:1">
              <span class="who-stat__num who-stat__num--word">Days</span>
              <span class="who-stat__bar" aria-hidden="true"></span>
              <span class="who-stat__label">From brief to delivery, not weeks</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S4  Who we work with
    ========================================================== -->
    <section class="sheet sheet--light section" id="solutions">
      <div class="container">
        <header class="s-head">
          <span class="eyebrow" data-reveal>Solutions</span>
          <h2 class="headline h2" data-reveal>
            Built around how your brand <span class="accent">sells</span>.
          </h2>
          <p class="s-head__intro" data-reveal>
            The content problem looks different depending on where you sit. A brand fights
            for relevance across markets. An agency needs invisible capacity. A retailer
            ships thousands of assets a season. A manufacturer turns product reality into
            something the channel can sell. The engagement is shaped for the side you are on.
          </p>
        </header>

        <div class="tabs" data-reveal>
          <div class="tabs__list" role="tablist" aria-label="Who we work with">
            {
              audiences.map((a, i) => (
                <button
                  class="tab"
                  role="tab"
                  id={`tab-${a.id}`}
                  aria-controls={`panel-${a.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                >
                  <span class="tab__dot" aria-hidden="true"></span>
                  {a.name}
                </button>
              ))
            }
          </div>

          <div class="tabs__panels">
            {
              audiences.map((a, i) => (
                <div
                  class={`panel${i === 0 ? ' is-active' : ''}`}
                  id={`panel-${a.id}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${a.id}`}
                  hidden={i !== 0}
                >
                  <div class="panel__media">
                    <img
                      src={a.img}
                      alt={a.alt}
                      width="1120"
                      height="1280"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="panel__badge">{a.name}</span>
                  </div>
                  <div class="panel__body">
                    <p class="panel__tagline">{a.tagline}</p>
                    <p class="panel__text">{a.body}</p>
                    <ul class="panel__chips">
                      {a.chips.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                    <a class="arrow-link" href={a.href}>
                      Explore {a.name} <span class="arrow" aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S5  Consulting and Training
    ========================================================== -->
    <section class="sheet sheet--cream section" id="consulting">
      <div class="container">
        <header class="s-head">
          <span class="eyebrow" data-reveal>Consulting</span>
          <h2 class="headline h2" data-reveal>
            Or build the studio inside your <span class="accent">own walls</span>.
          </h2>
          <p class="s-head__intro" data-reveal>
            Not every brand needs the production lane. Some need help standing up their own
            AIGC operation, training the team to run it, and writing the governance that
            keeps it brand-safe at scale. We do that work too, taught and led by the same
            people running our production floor every day.
          </p>
        </header>

        <div class="features">
          {
            programs.map((p) => (
              <article class={`feature feature--${p.accent}`} data-reveal>
                <div class="feature__visual">
                  <div class="feature__shape" aria-hidden="true"></div>
                  <div class="feature__media">
                    <img
                      src={p.img}
                      alt={p.alt}
                      width="1280"
                      height="1040"
                      loading="lazy"
                      decoding="async"
                      data-parallax
                      data-speed="0.1"
                    />
                  </div>
                  <span class="feature__kind">{p.kind}</span>
                </div>
                <div class="feature__panel">
                  <span class="feature__eyebrow">{p.kind}</span>
                  <h3 class="feature__title">{p.title}</h3>
                  <p class="feature__text">{p.body}</p>
                  <ul class="feature__points">
                    {p.points.map((pt) => (
                      <li>
                        <span class="feature__tick" aria-hidden="true">
                          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M2.5 6.4 5 9l4.5-6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                        {pt}
                      </li>
                    ))}
                  </ul>
                  <a class="arrow-link" href={p.href}>
                    Explore {p.kind} <span class="arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S6  How to engage
    ========================================================== -->
    <section class="sheet sheet--navy section" id="engage" data-spot>
      <div class="grain sheet__grain" aria-hidden="true"></div>
      <div class="container">
        <header class="s-head s-head--dark">
          <span class="eyebrow eyebrow--orange" data-reveal>How to engage</span>
          <h2 class="headline h2" data-reveal>
            Three ways to work with us. <span class="accent">One studio</span>.
          </h2>
          <p class="s-head__intro" data-reveal>
            Some brands need a steady drip of content. Others need everything at once for a
            launch. Pick the model that matches how your team really works, not how a studio
            would prefer to bill you.
          </p>
        </header>

        <div class="ways">
          {
            ways.map((w, i) => (
              <a
                class={`way${w.featured ? ' way--featured' : ''}`}
                href={w.href}
                data-reveal
                data-glow
                style={`--i:${i}`}
              >
                {w.featured && <span class="way__flag">Built for launches</span>}
                <span class="way__name">{w.name}</span>
                <span class="way__tagline">{w.tagline}</span>
                <p class="way__body">{w.body}</p>
                <ul class="way__facts">
                  {w.facts.map((f) => (
                    <li>
                      <span class="way__tick" aria-hidden="true">
                        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M2.5 6.4 5 9l4.5-6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                      {f}
                    </li>
                  ))}
                </ul>
                <span class="way__cta">
                  See {w.name} <span class="arrow" aria-hidden="true">&rarr;</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="engage__compare" data-reveal>
          <a class="arrow-link arrow-link--light" href="/pricing#matrix">
            Compare all three side by side <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S7  Selected work
    ========================================================== -->
    <section class="sheet sheet--light section" id="work">
      <div class="container">
        <header class="s-head s-head--row">
          <div>
            <span class="eyebrow" data-reveal>Selected work</span>
            <h2 class="headline h2" data-reveal>Real brand <span class="accent">work</span>.</h2>
          </div>
          <p class="s-head__intro" data-reveal>
            A sample of what we have shipped recently across beauty, automotive, consumer
            tech, and retail.
          </p>
        </header>

        <div class="work-grid">
          {
            cases.map((c, i) => (
              <a
                class={`study study--${i % 2 === 0 ? 'a' : 'b'}`}
                href={`/work/${c.slug}`}
                data-reveal
                style={`--i:${i % 2}`}
              >
                <div class="study__media">
                  <img
                    src={c.img}
                    alt={c.alt}
                    width="1280"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="study__scrim" aria-hidden="true"></div>
                </div>
                <div class="study__overlay">
                  <span class="study__tag">{c.tag}</span>
                  <h3 class="study__client">{c.name}</h3>
                  <p class="study__line">{c.line}</p>
                  <span class="study__cta">
                    See the work <span class="arrow" aria-hidden="true">&rarr;</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="block-more" data-reveal>
          <Button variant="secondary" href="/work">See all case studies</Button>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S8  What we believe
    ========================================================== -->
    <section class="sheet sheet--ink believe">
      <div class="grain sheet__grain" aria-hidden="true"></div>
      <div class="believe__field" aria-hidden="true">
        <span class="believe__orb believe__orb--a"></span>
        <span class="believe__orb believe__orb--b"></span>
      </div>
      <div class="container believe__inner">
        <div class="believe__top" data-reveal>
          <span class="eyebrow eyebrow--orange">What we believe</span>
          <span class="believe__rule" aria-hidden="true"></span>
          <span class="believe__tag">The hubStudio manifesto</span>
        </div>

        <h2 class="believe__title" data-words>
          {
            beliefWords.map((w, i) => (
              <Fragment>
                <span class="bw" style={`--wi:${i}`}>
                  <span>{w}</span>
                </span>{' '}
              </Fragment>
            ))
          }
          <span class="bw bw--key" style={`--wi:${beliefWords.length}`}>
            <span>
              <span class="believe__key">
                <em class="accent">matters</em>
                <svg
                  class="believe__ul"
                  viewBox="0 0 320 26"
                  fill="none"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path
                    d="M5 15 C 64 5, 132 23, 198 12 C 248 4, 286 11, 315 16"
                    stroke="currentColor"
                    stroke-width="7"
                    stroke-linecap="round"
                  />
                </svg>
              </span><span class="believe__stop">.</span>
            </span>
          </span>
        </h2>

        <div class="believe__list">
          {
            beliefs.map((b, i) => (
              <div class="belief" data-reveal style={`--i:${i}`}>
                <span class="belief__line" aria-hidden="true"></span>
                <p class="belief__text">{b}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S9  Insights
    ========================================================== -->
    <section class="sheet sheet--cream section" id="insights">
      <div class="container">
        <header class="s-head s-head--row">
          <div>
            <span class="eyebrow" data-reveal>Resources</span>
            <h2 class="headline h2" data-reveal>Worth <span class="accent">reading</span>.</h2>
          </div>
          <p class="s-head__intro" data-reveal>
            Practitioner notes on AI-native content, written by the people running the
            pipelines.
          </p>
        </header>

        <a class="lead-ins" href={`/resources/insights/${leadInsight.slug}`} data-reveal>
          <div class="lead-ins__media">
            <img
              src={leadInsight.image}
              alt={leadInsight.imageAlt}
              width="1600"
              height="1067"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="lead-ins__body">
            <span class={`ins__tag ins__tag--${leadInsight.tone}`}>
              <span class="ins__tag-flag">Latest</span>{leadInsight.category}
            </span>
            <h3 class="lead-ins__title">{leadInsight.title}</h3>
            <p class="lead-ins__deck">{leadInsight.deck}</p>
            <p class="ins__meta">
              <span>{leadInsight.author}</span>
              <span class="ins__dot" aria-hidden="true"></span>
              <time datetime={leadInsight.dateISO}>{leadInsight.date}</time>
              <span class="ins__dot" aria-hidden="true"></span>
              <span>{leadInsight.readingTime}</span>
            </p>
            <span class="arrow-link">
              Read insight <span class="arrow" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>

        <div class="ins-grid">
          {
            restInsights.map((post, i) => (
              <a
                class="ins"
                href={`/resources/insights/${post.slug}`}
                data-reveal
                style={`--i:${i}`}
              >
                <div class="ins__media">
                  <img
                    src={post.image}
                    alt={post.imageAlt}
                    width="1600"
                    height="1067"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class={`ins__tag ins__tag--${post.tone}`}>{post.category}</span>
                </div>
                <div class="ins__body">
                  <h3 class="ins__title">{post.title}</h3>
                  <p class="ins__deck">{post.deck}</p>
                  <p class="ins__meta">
                    <span>{post.readingTime}</span>
                  </p>
                </div>
              </a>
            ))
          }
        </div>

        <div class="block-more" data-reveal>
          <Button variant="secondary" href="/resources/insights">Read all insights</Button>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         S10  Closing CTA
    ========================================================== -->
    <section class="sheet sheet--ink closing" data-spot>
      <div class="grain sheet__grain" aria-hidden="true"></div>
      <div class="closing__glow" aria-hidden="true"></div>
      <div class="container closing__inner">
        <svg class="closing__cube" viewBox="0 0 32 35" aria-hidden="true">
          <path d="M16 4 28 11 16 18 4 11Z" fill="var(--brand-orange)" />
          <path d="M4 11 16 18 16 31 4 24Z" fill="var(--brand-navy)" />
          <path d="M28 11 16 18 16 31 28 24Z" fill="var(--brand-navy-deep)" />
        </svg>
        <span class="eyebrow eyebrow--orange" data-reveal>Get started</span>
        <h2 class="headline closing__head" data-reveal>
          The production house brands choose when the old way
          <span class="accent">stops working</span>.
        </h2>
        <div class="closing__cta" data-reveal>
          <Button variant="primary" href="/contact">Talk to us</Button>
        </div>
        <a class="closing__mail" href="mailto:hello@hubstudio.ai" data-reveal>
          hello@hubstudio.ai
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ============================================================
     Shared primitives
  ============================================================ */
  .home {
    --shadow-sheet: 0 -30px 64px -36px rgba(10, 10, 20, 0.42);
    --shadow-sheet-dark: 0 -36px 80px -34px rgba(0, 0, 0, 0.62);
    --shadow-card: 0 2px 6px rgba(10, 10, 20, 0.04),
      0 14px 30px -12px rgba(10, 10, 20, 0.12);
    --shadow-card-hi: 0 6px 14px rgba(10, 10, 20, 0.08),
      0 36px 64px -24px rgba(10, 10, 20, 0.28);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    position: relative;
    /* Decorative bleeds (who__accent, feature__shape) sit in cream sheets
       that are not clipped; on narrow screens they push past the viewport
       gutter. clip kills the horizontal scroll without becoming a scroll
       container, so the sticky who__figure still resolves against the page. */
    overflow-x: clip;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: calc(var(--i, 0) * 95ms);
    will-change: opacity, transform;
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Sheet stacking: each section overlaps the previous for layered depth */
  .sheet {
    position: relative;
    border-radius: clamp(28px, 3.6vw, 60px) clamp(28px, 3.6vw, 60px) 0 0;
    margin-top: clamp(-60px, -4.6vw, -40px);
  }
  .sheet--first {
    z-index: 2;
  }
  .sheet--first.section {
    padding-top: clamp(56px, 5.5vw, 96px);
  }
  .sheet--light {
    background: var(--bg-white);
    box-shadow: var(--shadow-sheet);
  }
  .sheet--cream {
    background: var(--bg-cream);
    box-shadow: var(--shadow-sheet);
  }
  .sheet--ink {
    background: var(--bg-ink);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-sheet-dark);
    overflow: hidden;
  }
  .sheet--navy {
    background: var(--brand-navy-deep);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-sheet-dark);
    overflow: hidden;
  }
  .section {
    padding-block: clamp(96px, 11vw, 168px);
  }
  .sheet__grain {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    pointer-events: none;
  }
  .sheet .container {
    position: relative;
    z-index: 1;
  }
  [id] {
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  /* Section header */
  .s-head {
    max-width: 720px;
    margin-bottom: clamp(48px, 6vw, 84px);
    display: grid;
    gap: 18px;
  }
  .s-head--row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
  }
  .s-head--row .eyebrow {
    margin-bottom: 14px;
  }
  .s-head--row .s-head__intro {
    max-width: 38ch;
    padding-bottom: 6px;
  }
  .s-head__intro {
    font-size: var(--type-lead);
    line-height: 1.6;
    color: var(--text-mute);
    max-width: 60ch;
  }
  .s-head--dark .s-head__intro {
    color: rgba(240, 237, 233, 0.74);
  }
  .eyebrow--orange {
    color: var(--brand-orange);
  }
  .headline .accent,
  .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
  }

  .block-more {
    margin-top: clamp(48px, 6vw, 80px);
    text-align: center;
  }

  /* Arrow link */
  .arrow-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .arrow-link--light {
    color: var(--text-on-dark);
  }
  .arrow {
    display: inline-block;
    transition: transform 220ms var(--ease);
  }
  .arrow-link:hover .arrow {
    transform: translateX(6px);
  }

  /* Scroll progress */
  .scrollbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .scrollbar__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--brand-orange), #ff9a5c);
  }

  /* ============================================================
     S1  Hero
  ============================================================ */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(620px, 95vh, 1080px);
    min-height: clamp(620px, 95svh, 1080px);
    overflow: hidden;
    background: var(--bg-ink);
    color: var(--text-on-dark);
    margin-top: -64px;
    padding-bottom: 48px;
  }
  @media (min-width: 1024px) {
    .hero {
      margin-top: calc(-1 * var(--nav-h));
    }
  }
  .hero__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100%;
    z-index: 0;
    background: var(--bg-ink) url('/Video/home-hero-poster.webp') center / cover no-repeat;
    will-change: transform;
    transform-origin: 50% 40%;
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        92deg,
        rgba(8, 12, 28, 0.96) 0%,
        rgba(8, 12, 28, 0.62) 48%,
        rgba(8, 12, 28, 0.18) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 12, 28, 0.7) 0%,
        rgba(8, 12, 28, 0.08) 32%,
        rgba(8, 12, 28, 0.92) 100%
      );
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.5;
  }
  .hero__glow {
    position: absolute;
    width: 64vw;
    height: 64vw;
    max-width: 760px;
    max-height: 760px;
    right: -12%;
    bottom: -24%;
    background: radial-gradient(circle, rgba(233, 78, 27, 0.46), transparent 62%);
    filter: blur(24px);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 16px);
    padding-bottom: 40px;
  }
  .hero__content {
    max-width: 1040px;
    will-change: transform, opacity;
  }
  .hero__title {
    margin: 0;
    max-width: 21ch;
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    font-size: clamp(40px, 6.3vw, 86px);
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__title .line > span {
    display: block;
  }
  .hero__title .accent {
    color: var(--brand-orange);
  }
  .hero__lead {
    margin-top: 20px;
    max-width: 58ch;
    font-size: var(--type-lead);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.86);
  }
  .hero__cta {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__scroll {
    position: absolute;
    right: var(--container-pad-desktop);
    bottom: 84px;
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.6);
  }
  @media (min-width: 1024px) {
    .hero__scroll {
      display: flex;
    }
  }
  .hero__scroll-line {
    width: 1px;
    height: 56px;
    background: rgba(240, 237, 233, 0.26);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand-orange);
    animation: scrollcue 2s ease-in-out infinite;
  }
  @keyframes scrollcue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  /* Hero load stagger */
  .hero__lead,
  .hero__cta {
    opacity: 0;
    animation: heroFade 0.95s var(--ease) forwards;
  }
  .hero__title .line:nth-child(1) > span {
    animation: heroLine 1s cubic-bezier(0.16, 0.84, 0.3, 1) 0.24s both;
  }
  .hero__title .line:nth-child(2) > span {
    animation: heroLine 1s cubic-bezier(0.16, 0.84, 0.3, 1) 0.36s both;
  }
  .hero__title .line:nth-child(3) > span {
    animation: heroLine 1s cubic-bezier(0.16, 0.84, 0.3, 1) 0.48s both;
  }
  .hero__lead {
    animation-delay: 0.66s;
  }
  .hero__cta {
    animation-delay: 0.78s;
  }
  @keyframes heroLine {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__lead,
    .hero__cta,
    .hero__title .line > span {
      opacity: 1;
      animation: none;
      transform: none;
    }
    .ping::after,
    .hero__scroll-line::after {
      animation: none;
    }
  }

  /* ============================================================
     S2  What we produce, bento
  ============================================================ */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 1.6vw, 22px);
    perspective: 1400px;
  }
  @media (min-width: 620px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile--w7 {
      grid-column: span 2;
    }
  }
  @media (min-width: 980px) {
    .bento {
      grid-template-columns: repeat(12, 1fr);
    }
    .tile--w7 {
      grid-column: span 7;
    }
    .tile--w5 {
      grid-column: span 5;
    }
    .tile--w6 {
      grid-column: span 6;
    }
  }

  .tile {
    --rx: 0deg;
    --ry: 0deg;
    --lift: 0px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 260px;
    padding: clamp(26px, 2.6vw, 38px);
    border-radius: clamp(20px, 2vw, 30px);
    overflow: hidden;
    transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry))
      translateY(var(--lift));
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 0%),
      rgba(233, 78, 27, 0.26),
      transparent 68%
    );
  }
  .tile:hover {
    --lift: -6px;
  }
  .tile:hover::before {
    opacity: 1;
  }
  .bento:has(.tile:hover) .tile:not(:hover) {
    opacity: 0.62;
  }
  .tile--white {
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card);
  }
  .tile--white:hover {
    box-shadow: var(--shadow-card-hi);
  }
  .tile--cream {
    background: var(--bg-cream);
    border: 1px solid var(--line-strong);
  }
  .tile--cream:hover {
    box-shadow: var(--shadow-card-hi);
  }
  .tile--ink {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(30, 58, 138, 0.5), transparent 60%),
      var(--bg-ink);
    color: var(--text-on-dark);
  }
  .tile--orange {
    background:
      radial-gradient(120% 140% at 0% 100%, rgba(255, 255, 255, 0.22), transparent 55%),
      var(--brand-orange);
    color: #fff;
  }
  .tile__ghost {
    position: absolute;
    right: -10px;
    bottom: -24px;
    width: 168px;
    height: 168px;
    z-index: 0;
    opacity: 0.07;
    pointer-events: none;
    transition: transform 0.5s var(--ease), opacity 0.4s ease;
  }
  .tile--ink .tile__ghost,
  .tile--orange .tile__ghost {
    opacity: 0.14;
  }
  .tile__ghost svg {
    width: 100%;
    height: 100%;
  }
  .tile:hover .tile__ghost {
    transform: rotate(-12deg) scale(1.12);
    opacity: 0.13;
  }
  .tile--ink:hover .tile__ghost,
  .tile--orange:hover .tile__ghost {
    opacity: 0.2;
  }
  .tile__icon {
    position: relative;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    flex: none;
    background: rgba(10, 10, 20, 0.05);
  }
  .tile--ink .tile__icon,
  .tile--orange .tile__icon {
    background: rgba(255, 255, 255, 0.12);
  }
  .tile__icon svg {
    width: 32px;
    height: 32px;
    overflow: visible;
  }
  .tile__icon .ic-accent {
    fill: var(--brand-orange);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.36s var(--ease);
  }
  .tile--orange .tile__icon .ic-accent {
    fill: #fff;
  }
  .tile__icon .ic-fill {
    fill: var(--bg-white);
  }
  .tile--cream .tile__icon .ic-fill {
    fill: var(--bg-cream);
  }
  .tile--ink .tile__icon .ic-fill {
    fill: var(--bg-ink);
  }
  .tile:hover .tile__icon .ic-accent {
    transform: scale(1.34);
  }
  .tile__body {
    position: relative;
    z-index: 1;
    flex: 1;
  }
  .tile__name {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .tile__summary {
    margin-top: 13px;
    font-size: var(--type-body);
    line-height: 1.6;
    max-width: 42ch;
    color: var(--text-mute);
  }
  .tile--ink .tile__summary,
  .tile--orange .tile__summary {
    color: rgba(240, 237, 233, 0.82);
  }
  .tile__cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .tile--orange .tile__cta {
    color: #fff;
  }
  .tile:hover .tile__cta .arrow {
    transform: translateX(6px);
  }

  /* ============================================================
     S3  Who we are
  ============================================================ */
  .who {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 960px) {
    .who {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 72px;
      align-items: start;
    }
  }
  .who__figure {
    position: relative;
    margin: 0;
  }
  @media (min-width: 960px) {
    .who__figure {
      position: sticky;
      top: calc(var(--nav-h) + 40px);
    }
  }
  .who__accent {
    position: absolute;
    inset: 28px -28px -28px 28px;
    border-radius: clamp(20px, 2.4vw, 32px);
    background: var(--brand-orange);
    z-index: 0;
  }
  .who__media {
    position: relative;
    z-index: 1;
    border-radius: clamp(20px, 2.4vw, 32px);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-cream);
    box-shadow: var(--shadow-card-hi);
  }
  .who__media img {
    width: 100%;
    height: 122%;
    object-fit: cover;
    will-change: transform;
  }
  .who__cap {
    position: absolute;
    z-index: 2;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.82);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .who__cap-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .who__text {
    display: grid;
    gap: 24px;
  }
  .who__statement {
    font-size: clamp(27px, 3.3vw, 44px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.18;
  }
  .who__statement .accent {
    color: var(--brand-orange);
  }
  .who__body {
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .who__stats {
    margin-top: 14px;
    display: grid;
    gap: 4px;
  }
  .who-stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 8px 22px;
    padding: 26px 0;
    border-top: 1px solid var(--line-strong);
  }
  .who-stat:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .who-stat__num {
    display: flex;
    align-items: baseline;
    font-size: clamp(44px, 5vw, 68px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .who-stat__num i {
    font-style: normal;
    color: var(--brand-orange);
  }
  .who-stat__num--word {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }
  .who-stat__bar {
    grid-row: 1 / 3;
    grid-column: 1;
    align-self: stretch;
    width: 0;
    margin-top: 6px;
    height: calc(100% - 12px);
    display: none;
  }
  .who-stat__label {
    grid-column: 2;
    font-size: var(--type-small);
    line-height: 1.5;
    color: var(--text-mute);
    max-width: 30ch;
  }

  /* ============================================================
     S4  Who we work with, tabs
  ============================================================ */
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 7px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    margin-bottom: 28px;
    background: var(--bg-cream);
  }
  /* Below the md breakpoint the four tabs cannot share one row without an
     unbalanced 3+1 wrap, so swipe them horizontally instead. At >=768px they
     fit one row and the pill / flex-wrap layout above takes over. */
  @media (max-width: 767.98px) {
    .tabs__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      border-radius: 20px;
      scrollbar-width: none;
    }
    .tabs__list::-webkit-scrollbar {
      display: none;
    }
  }
  .tab {
    flex: 1;
    min-width: max-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 24px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: var(--type-button);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-mute);
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }
  .tab:hover {
    color: var(--text-ink);
  }
  .tab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
    transition: opacity 220ms ease;
  }
  .tab[aria-selected='true'] {
    background: var(--bg-ink);
    color: #fff;
    box-shadow: 0 8px 20px -8px rgba(10, 10, 20, 0.5);
  }
  .tab[aria-selected='true'] .tab__dot {
    background: var(--brand-orange);
    opacity: 1;
  }

  .panel[hidden] {
    display: none;
  }
  .panel {
    display: grid;
    border-radius: clamp(22px, 2.4vw, 34px);
    overflow: hidden;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card-hi);
  }
  @media (min-width: 820px) {
    .panel {
      grid-template-columns: 0.82fr 1.18fr;
    }
  }
  .panel__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-cream);
  }
  @media (min-width: 820px) {
    .panel__media {
      aspect-ratio: auto;
    }
  }
  .panel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .panel__badge {
    position: absolute;
    left: 18px;
    top: 18px;
    padding: 8px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.82);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .panel__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(30px, 4vw, 58px);
  }
  .panel__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(25px, 2.8vw, 38px);
    line-height: 1.16;
    letter-spacing: -0.01em;
  }
  .panel__text {
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .panel__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .panel__chips li {
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: var(--bg-cream);
    border: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-ink);
  }
  .panel__body .arrow-link {
    margin-top: 4px;
  }
  .panel.is-active .panel__media img {
    animation: panelMedia 0.75s var(--ease) both;
  }
  .panel.is-active .panel__body > * {
    animation: panelRise 0.62s var(--ease) both;
  }
  .panel.is-active .panel__body > *:nth-child(1) {
    animation-delay: 0.08s;
  }
  .panel.is-active .panel__body > *:nth-child(2) {
    animation-delay: 0.15s;
  }
  .panel.is-active .panel__body > *:nth-child(3) {
    animation-delay: 0.22s;
  }
  .panel.is-active .panel__body > *:nth-child(4) {
    animation-delay: 0.29s;
  }
  @keyframes panelMedia {
    from {
      clip-path: inset(0 100% 0 0);
      transform: scale(1.08);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: scale(1);
    }
  }
  @keyframes panelRise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel.is-active .panel__media img,
    .panel.is-active .panel__body > * {
      animation: none;
    }
  }

  /* ============================================================
     S5  Consulting and Training, editorial feature rows
  ============================================================ */
  .features {
    display: grid;
    gap: clamp(72px, 9vw, 152px);
  }
  .feature {
    position: relative;
    display: grid;
    gap: 0;
  }
  @media (min-width: 880px) {
    .feature {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .feature:nth-child(even) .feature__visual {
      order: 2;
    }
  }
  .feature__visual {
    position: relative;
    isolation: isolate;
  }
  .feature__shape {
    position: absolute;
    z-index: 0;
    width: 58%;
    height: 64%;
    border-radius: clamp(20px, 2.4vw, 32px);
  }
  .feature--orange .feature__shape {
    right: -6%;
    top: -8%;
    background: var(--brand-orange);
  }
  .feature--navy .feature__shape {
    left: -6%;
    bottom: -8%;
    background: var(--brand-navy);
  }
  .feature__media {
    position: relative;
    z-index: 1;
    border-radius: clamp(20px, 2.4vw, 34px);
    overflow: hidden;
    aspect-ratio: 5 / 4;
    background: var(--bg-cream);
    box-shadow: var(--shadow-card-hi);
  }
  .feature__media img {
    width: 100%;
    height: 116%;
    object-fit: cover;
    will-change: transform;
  }
  .feature__kind {
    position: absolute;
    z-index: 2;
    left: 18px;
    top: 18px;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    background: var(--brand-orange);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .feature--navy .feature__kind {
    background: var(--brand-navy);
  }
  .feature__panel {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(30px, 3.4vw, 48px);
    border-radius: clamp(20px, 2.4vw, 32px);
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-card-hi);
  }
  @media (min-width: 880px) {
    .feature__panel {
      margin: 0;
    }
    .feature:nth-child(odd) .feature__panel {
      margin-left: -72px;
    }
    .feature:nth-child(even) .feature__panel {
      margin-right: -72px;
    }
    /* Even feature: the panel overlaps the visual's left edge, so anchor
       the badge to the right so it never sits under the panel. */
    .feature:nth-child(even) .feature__kind {
      left: auto;
      right: 18px;
    }
  }
  @media (max-width: 879px) {
    .feature__panel {
      margin: -56px 16px 0;
    }
  }
  .feature__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .feature--navy .feature__eyebrow {
    color: var(--brand-navy);
  }
  .feature__title {
    font-size: clamp(26px, 2.9vw, 40px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  .feature__text {
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .feature__points {
    display: grid;
    gap: 11px;
    margin-top: 2px;
    padding-top: 18px;
    border-top: 1px solid var(--line-hairline);
  }
  .feature__points li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--text-ink);
  }
  .feature__tick {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 50%;
    background: rgba(233, 78, 27, 0.12);
    color: var(--brand-orange);
  }
  .feature--navy .feature__tick {
    background: rgba(30, 58, 138, 0.12);
    color: var(--brand-navy);
  }
  .feature__tick svg {
    width: 12px;
    height: 12px;
  }
  .feature__panel .arrow-link {
    margin-top: 8px;
  }

  /* ============================================================
     S6  How to engage
  ============================================================ */
  .sheet--navy::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    left: var(--sx, 50%);
    top: var(--sy, 30%);
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(233, 78, 27, 0.16), transparent 62%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }
  .sheet--navy[data-lit]::before {
    opacity: 1;
  }
  .ways {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
  }
  @media (min-width: 900px) {
    .ways {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }
  .way {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(28px, 2.8vw, 38px);
    border-radius: clamp(20px, 2vw, 28px);
    background: linear-gradient(
      180deg,
      rgba(240, 237, 233, 0.075),
      rgba(240, 237, 233, 0.025)
    );
    border: 1px solid rgba(240, 237, 233, 0.13);
    transition:
      transform 0.34s var(--ease),
      border-color 0.34s ease,
      box-shadow 0.34s ease;
  }
  .way::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    border-radius: inherit;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 0%),
      rgba(233, 78, 27, 0.22),
      transparent 72%
    );
  }
  .way:hover {
    transform: translateY(-8px);
    border-color: rgba(233, 78, 27, 0.5);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
  }
  .way:hover::before {
    opacity: 1;
  }
  @media (min-width: 900px) {
    .way--featured {
      transform: translateY(-22px);
    }
    .way--featured:hover {
      transform: translateY(-30px);
    }
  }
  .way--featured {
    background: linear-gradient(
      180deg,
      rgba(233, 78, 27, 0.2),
      rgba(233, 78, 27, 0.04)
    );
    border-color: rgba(233, 78, 27, 0.44);
    box-shadow: 0 30px 70px -34px rgba(233, 78, 27, 0.6);
  }
  .way__flag {
    align-self: flex-start;
    padding: 6px 13px;
    border-radius: var(--radius-pill);
    background: var(--brand-orange);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .way__name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .way__tagline {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: #fff;
  }
  .way__body {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.74);
  }
  .way__facts {
    display: grid;
    gap: 10px;
    margin-top: 4px;
    padding-top: 18px;
    border-top: 1px solid rgba(240, 237, 233, 0.14);
  }
  .way__facts li {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.9);
  }
  .way__tick {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 50%;
    background: rgba(233, 78, 27, 0.2);
    color: var(--brand-orange);
  }
  .way__tick svg {
    width: 11px;
    height: 11px;
  }
  .way__cta {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: #fff;
  }
  .way:hover .way__cta .arrow {
    transform: translateX(6px);
  }
  .engage__compare {
    margin-top: 48px;
    text-align: center;
  }
  .engage__compare .arrow-link {
    align-self: center;
  }

  /* ============================================================
     S7  Selected work
  ============================================================ */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(18px, 2.2vw, 32px);
  }
  @media (min-width: 720px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .study {
      margin-top: calc(var(--i, 0) * 64px);
    }
  }
  .study {
    position: relative;
    display: block;
    border-radius: clamp(20px, 2.2vw, 30px);
    overflow: hidden;
    background: var(--bg-ink);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s ease;
  }
  .study:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-card-hi);
  }
  .study__media {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }
  .study__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .study:hover .study__media img {
    transform: scale(1.07);
  }
  .study__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 12, 28, 0) 38%,
      rgba(8, 12, 28, 0.52) 68%,
      rgba(8, 12, 28, 0.92) 100%
    );
  }
  .study__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(24px, 3vw, 38px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #fff;
  }
  .study__tag {
    align-self: flex-start;
    padding: 7px 13px;
    margin-bottom: 4px;
    border-radius: var(--radius-pill);
    background: rgba(240, 237, 233, 0.16);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .study__client {
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .study__line {
    font-size: var(--type-body);
    line-height: 1.5;
    color: rgba(240, 237, 233, 0.84);
    max-width: 36ch;
  }
  .study__cta {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: #fff;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition:
      max-height 0.4s var(--ease),
      opacity 0.4s ease,
      transform 0.4s var(--ease);
  }
  .study:hover .study__cta,
  .study:focus-visible .study__cta {
    max-height: 40px;
    opacity: 1;
    transform: none;
  }
  .study:hover .study__cta .arrow {
    transform: translateX(6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .study__cta {
      max-height: 40px;
      opacity: 1;
      transform: none;
    }
  }

  /* ============================================================
     S8  What we believe
  ============================================================ */
  .believe {
    padding-block: clamp(108px, 13vw, 196px);
  }
  .believe__field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .believe__field::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(240, 237, 233, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 237, 233, 0.045) 1px, transparent 1px);
    background-size: 66px 66px;
    -webkit-mask-image: radial-gradient(ellipse 72% 64% at 26% 30%, #000, transparent 78%);
