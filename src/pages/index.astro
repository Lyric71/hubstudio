            />
          </div>
          <div class="lead-ins__body">
            <span class={`ins__tag ins__tag--${leadInsight.tone}`}>
              <span class="ins__tag-flag">Latest</span>{leadInsight.category}
            </span>
            <h3 class="lead-ins__title">{leadInsight.title}</h3>
