import { APP_URL, APP_SIGNUP, APP_SIGNIN, BRIEF_URL, HELP_URL } from '../lib/links';

const SITE = 'https://www.hubstudio.ai';

/*
 * The app tour: the modules as the /app pages split them, and every feature
 * of each module with its own real capture. A feature opens on a hook (the
 * moment it answers, in the reader's words or as a situation), then its name,
 * then two plain sentences. Every fact is taken from the /app page the module
 * links to, which is itself quoted from the help center. Without JavaScript
 * the modules and features render stacked; the script turns them into a
 * module switcher and a feature list beside one framed screen.
 */
type Feature = {
  id: string;
  hook: string;
  name: string;
  body: string;
  shot: Shot;
  path: string;
  /** Caption override, for captures that show an empty state. */
  caption?: string;
};
type Module = {
  id: string;
  name: string;
  lede: string;
  link: { label: string; href: string };
  features: Feature[];
};

