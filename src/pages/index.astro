---
/**
 * Home (`/`): both offers on one page, the hubStudio app first and the studio
 * a close second (hubstudio-positioning.md). Copy from the content-quality-us
 * deck (cq/home/final.md).
 *
 * Design system layered on top of the global tokens:
 *  - Sheet stacking: every section is a rounded panel that overlaps the
 *    previous one, so the page reads as depth, not flat bands.
 *  - Scroll engine: progress bar, [data-parallax] layers, [data-reveal]
 *    staggered reveals, count-up, kinetic manifesto headline.
 *  - Tactile components: 3D pointer tilt, magnetic buttons, pointer glow,
 *    tabbed audience switcher. All gated on prefers-reduced-motion.
 *
 * Hero (app capture) . The app (four stages) . Engines . Ways to work .
 * The studio . Services (bento) . Studio + app . Selected work .
 * Who it's for (tabs) . Pricing . Manifesto . Insights . Closing (DualCta).
 *
 * Insights: the first four entries of src/data/insights.ts, lead plus grid,
 * never a hard-coded slug (CLAUDE.md, Insights distribution).
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import AppShot from '../components/AppShot.astro';
import WaysToWork from '../components/WaysToWork.astro';
import DualCta from '../components/DualCta.astro';
import { appShots } from '../data/app-shots';
import { caseStudies } from '../data/case-studies';
import { insights } from '../data/insights';
import { APP_URL, APP_SIGNUP, APP_SIGNIN, BRIEF_URL, HELP_URL } from '../lib/links';

const SITE = 'https://www.hubstudio.ai';

/* The app in four stages. Order carries the sequence; no numerals. */
const stages = [
  {
    title: 'Make images and video',
    body: 'Pick an engine in Explore and it opens in the right studio. The Image studio turns text into pictures, edits up to four source pictures and upscales, up to 4K. The Video studio starts from text, from a start frame or from references, and can generate the sound too.',
    link: { label: 'How making works', href: '/app/create' },
    shot: appShots.videoStudio,
    path: '/content/video',
    narrow: false,
  },
  {
    title: 'Keep and polish the files',
    body: 'Every render lands in History with its prompt and engine. The Assets Library holds the team’s files in folders, with tags and versions. The Image editor crops a picture to each network’s format and fixes its light and color, and you can put text or a logo on top. The Video editor cuts a clip into a Reel or a TikTok, and Shorts autopilot turns a long video into shorts. The editors run in your browser and are free to use.',
    link: { label: 'See the image and video tools', href: '/app/image-tools' },
    shot: appShots.editorCrop,
    path: '/files/tools/image-editor',
    narrow: false,
  },
  {
    title: 'Post to five networks',
    body: 'Write the post yourself or give a brief to Draft with AI. Add pictures or a carousel, then publish it now or schedule it, to as many as 20 accounts in one go. hubStudio posts to LinkedIn, Instagram, Facebook, X and TikTok (in Beta).',
    link: { label: 'How publishing works', href: '/app/publish' },
    shot: appShots.linkedin,
    path: '/social/linkedin/posts',
    narrow: false,
  },
  {
    title: 'Send it for approval, then deliver',
    body: 'Send an image, a video or a post to a teammate or a client in Validation. They approve it or send it back with a comment, and every version stays on one thread. Each client gets logins and a Client space that shows only the work made for it.',
    link: { label: 'How approval works', href: '/app/review' },
    shot: appShots.validationSend,
    path: '/validation',
    narrow: true,
  },
];

/* The makers in Explore, as plain text. No logos. */
const makers = [
  'OpenAI',
  'Google',
  'Black Forest Labs',
  'ByteDance',
  'Kling',
  'Alibaba',
  'xAI',
  'MiniMax',
  'Meta',
];

/* Six service groups, each listing its /services/design/* lines. */
const categories = [
  {
    name: 'Content and social',
    summary: 'The assets that ship every week.',
    span: 'w7',
    tone: 'ink',
    icon: 'content',
    lines: [
      { name: 'Social media', href: '/services/design/social-media' },
      { name: 'Ad creative', href: '/services/design/ad-creative' },
      { name: 'Short video', href: '/services/design/short-video' },
      { name: 'Email design', href: '/services/design/email-design' },
    ],
  },
  {
    name: 'Video and motion',
    summary: 'Film and animation, long and short.',
    span: 'w5',
    tone: 'white',
    icon: 'video',
    lines: [
      { name: 'Video production', href: '/services/design/video-production' },
      { name: 'Motion design', href: '/services/design/motion-design' },
    ],
  },
  {
    name: 'Commerce and web',
    summary: 'The pages and prints that sell the product.',
    span: 'w5',
    tone: 'white',
    icon: 'commerce',
    lines: [
      { name: 'eCommerce', href: '/services/design/ecommerce' },
      { name: 'Website design', href: '/services/design/website-design' },
      { name: 'Print design', href: '/services/design/print-design' },
    ],
  },
  {
    name: 'Strategy and direction',
    summary: 'The thinking before anything gets made.',
    span: 'w7',
    tone: 'orange',
    icon: 'strategy',
    lines: [
      { name: 'Marketing strategy', href: '/services/design/marketing-strategy' },
      { name: 'Creative strategy', href: '/services/design/creative-strategy' },
      { name: 'Concept creation', href: '/services/design/concept-creation' },
      { name: 'Storyboard', href: '/services/design/storyboard' },
    ],
  },
  {
    name: 'Brand identity',
    summary: 'The system the rest comes from.',
    span: 'w6',
    tone: 'white',
    icon: 'brand',
    lines: [
      { name: 'Brand identity', href: '/services/design/brand-identity' },
      { name: 'Illustration design', href: '/services/design/illustration-design' },
      { name: 'Packaging and merch design', href: '/services/design/packaging-merch-design' },
    ],
  },
  {
    name: 'Sales and communications',
    summary: 'Decks, reports and news.',
    span: 'w6',
    tone: 'cream',
    icon: 'sales',
    lines: [
      { name: 'Presentation design', href: '/services/design/presentation-design' },
      { name: 'Pitch deck', href: '/services/design/pitch-deck' },
      { name: 'Ebooks and digital reports', href: '/services/design/ebook-digital-reports' },
      { name: 'Press release', href: '/services/design/press-release' },
    ],
  },
];

/* The four audiences, each a tab panel that speaks to both offers. */
const audiences = [
  {
    id: 'brands',
    name: 'Brands',
    tagline: 'Your team in the app, the studio on the big jobs.',
    body: 'Your marketers make the weekly posts in the app and publish them to five networks from one place, paying as they go. For a campaign or a launch, hand the brief to the studio. An art director runs it, using the studio’s brand-trained models where they help.',
    href: '/solutions/brands',
    img: '/Images/brands-hero.jpg',
    alt: 'A brand marketing team reviewing a wall of multi-market campaign visuals in a sunlit studio.',
  },
  {
    id: 'agencies',
    name: 'Agencies',
    tagline: 'More hands, and you keep the client.',
    body: 'Give your creatives the app. Add each client, give its people a login, and they approve in their Client space. Or pass the overflow to our studio while you keep the client, the strategy and the creative lead.',
    href: '/solutions/agencies',
    img: '/Images/agencies-hero.jpg',
    alt: 'An agency creative director directing a project from a laptop in a busy open studio.',
  },
  {
    id: 'retailers',
    name: 'Retailers',
    tagline: 'Every product, every season.',
    body: 'Retail teams tend to run the volume work in the app: packshots, lifestyle scenes, crops for each network and posts scheduled weeks ahead. When a season needs a shoot, a full catalog or marketplace pages, the studio produces it and hands back finished files.',
    href: '/solutions/retailers',
    img: '/Images/retailers-hero.jpg',
    alt: 'A retail content team managing a large catalog of product visuals across multiple screens.',
  },
  {
    id: 'manufacturers',
    name: 'Manufacturers',
    tagline: 'Product reality, made sellable.',
    body: 'Product marketers can turn a product photo into clean visuals and a launch post in the app. The Image anonymizer clears camera and location data out of a file before it ships. For launch films, trade-show material and marketplace pages, the studio works from your spec sheet and sends back the finished work.',
    href: '/solutions/manufacturers',
    img: '/Images/manufacturers-hero.jpg',
    alt: 'A manufacturing product shown as polished marketing content beside its technical reference.',
  },
];

/* Four selected case studies, image and alt sourced from data. */
const pick = (slug: string) => caseStudies.find((c) => c.slug === slug)!;
const cases = [
  { name: 'HiSense', tag: 'Consumer tech', line: 'Product visuals across every channel and format', slug: 'hisense' },
  { name: 'Shiseido RQ PYOLOGY', tag: 'Beauty', line: 'Clinical credibility and luxury appeal, in one frame', slug: 'shiseido-rq-pyology' },
  { name: 'age20', tag: 'Beauty', line: 'Skincare campaign content, generated and shot', slug: 'age20' },
  { name: 'Premium SUV', tag: 'Automotive', line: 'A global automotive launch, market by market', slug: 'premium-suv' },
].map((c) => {
  const d = pick(c.slug);
  return { ...c, img: d.hero.src, alt: d.hero.alt };
});

/* Insights: the four newest entries, lead plus grid. */
const [leadInsight, ...restInsights] = insights.slice(0, 4);

/* Manifesto: headline split for the kinetic reveal, plus the lines. */
const beliefWords = ['Creative', 'intelligence', 'is', 'the', 'only', 'thing', 'left', 'that'];
const beliefs = [
  'Culture can’t be briefed.',
  'Speed counts, but only when the work still looks like the brand.',
  'Anyone can generate a passable image. What counts is the direction behind it.',
  'The engines should be open to your team as much as to ours.',
];

const pageTitle = 'hubStudio: AI image and video app, plus a creative studio';
const pageDescription =
  'Make AI images, video and social posts in the hubStudio app, with engines from OpenAI, Google and more. Or send a brief and our studio makes them for you.';

const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${SITE}/#webpage`,
      url: SITE,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
      mainEntity: { '@id': `${SITE}/#app` },
      breadcrumb: { '@id': `${SITE}/#breadcrumb` },
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE}/#breadcrumb`,
      itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE }],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE}/#app`,
      name: 'hubStudio',
      url: APP_URL,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Web browser',
      description:
        'A web app to make images and video with the AI engines of several makers, edit them, turn them into posts, get them approved, and publish them to LinkedIn, Instagram, Facebook, X and TikTok.',
      publisher: { '@id': `${SITE}/#organization` },
    },
  ],
};
---

<Layout
  heroOverlay
  title={pageTitle}
  description={pageDescription}
  preloadImage={appShots.exploreApp.src}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(homeSchema)} />

  <div class="scrollbar" aria-hidden="true"><span class="scrollbar__fill"></span></div>

  <div class="home">
    <!-- ==========================================================
         Hero: both offers in one line, the app first
    ========================================================== -->
    <section class="hero">
      <div class="hero__bg" aria-hidden="true">
        <div class="grain hero__grain"></div>
        <div class="hero__glow"></div>
      </div>

      <div class="container hero__inner">
        <div class="hero__top">
          <div class="hero__head">
            <span class="eyebrow eyebrow--orange hero__eyebrow">The hubStudio app and studio</span>
            <h1 class="hero__title">
              <span class="line"><span>Make images and video</span></span>
              <span class="line"><span>in our app, or let our</span></span>
              <span class="line"><span><em class="accent">studio</em> make them.</span></span>
            </h1>
          </div>

          <div class="hero__side">
            <p class="hero__lead">
              hubStudio makes images, video and social posts with AI. Your team can make them
              in the app and take them all the way to a published post. Or you send a brief and
              our art directors make them for you, inside the app or out.
            </p>
            <div class="hero__actions">
              <div class="hero__cta">
                <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
                <Button variant="on-dark" href={BRIEF_URL}>Send a brief</Button>
              </div>
              <p class="hero__micro">
                Creating an account costs nothing. Already on hubStudio?
                <a href={APP_SIGNIN} rel="noopener">Sign in</a>
              </p>
            </div>
          </div>
        </div>

        <div class="hero__shot">
          <AppShot
            shot={appShots.exploreApp}
            path="/explore"
            caption="Explore is where you land after signing in: every engine on one page, the menu down the left."
            eager
            dark
          />
        </div>
      </div>
    </section>

    <!-- ==========================================================
         The app in brief
    ========================================================== -->
    <section class="sheet sheet--light sheet--first section" id="app">
      <div class="container">
        <header class="s-head">
          <span class="eyebrow" data-reveal>The hubStudio app</span>
          <h2 class="headline h2" data-reveal>
            One app, from the first prompt to the <span class="accent">published</span> post.
          </h2>
          <p class="s-head__intro" data-reveal>
            hubStudio is a web app for people and teams who make their own content. You pick an
            engine, check the price and run it. The result stays with your team, and you finish
            the job in the same app.
          </p>
        </header>

        <div class="stages">
          {
            stages.map((s, i) => (
              <article class="stage" data-reveal style={`--i:${i % 2}`}>
                <div class="stage__text">
                  <h3 class="stage__title">{s.title}</h3>
                  <p class="stage__body">{s.body}</p>
                  <a class="arrow-link" href={s.link.href}>
                    {s.link.label} <span class="arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
                <div class:list={['stage__peek', s.narrow && 'stage__peek--narrow']}>
                  <AppShot shot={s.shot} path={s.path} />
                </div>
              </article>
            ))
          }
        </div>

        <div class="app__foot" data-reveal>
          <p class="app__aside">
            You don’t need all four. Making images and downloading them is a perfectly good way
            to use it.
          </p>
          <div class="app__links">
            <a class="arrow-link" href="/app">
              Tour the app <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="arrow-link" href={HELP_URL}>
              Read the help center <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
            <Button variant="primary" href={APP_SIGNUP}>Create your account</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         The engines
    ========================================================== -->
    <section class="sheet sheet--cream section" id="engines">
      <div class="container engines">
        <div class="engines__text">
          <span class="eyebrow" data-reveal>Engines</span>
          <h2 class="headline h2" data-reveal>
            The engines you’ve heard of, side by <span class="accent">side</span>.
          </h2>
          <p class="engines__body" data-reveal>
            No single engine wins every job. Some are good at readable text inside a picture;
            others do better with skin and fabric, or with camera moves. Explore puts them next
            to each other so you can choose per run. Our creatives pick from the same list when
            they work in the app on a Studio + app job.
          </p>
          <p class="engines__body" data-reveal>
            That means ChatGPT Image 2 from OpenAI, Nano Banana and Veo from Google, FLUX from
            Black Forest Labs, Seedream and Seedance from ByteDance, the Kling video engines, Wan
            from Alibaba, and more as they ship.
          </p>
          <a class="arrow-link" href="/app/engines" data-reveal>
            See every engine by maker <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <ul class="makers" aria-label="Makers whose engines are in hubStudio">
          {
            makers.map((m, i) => (
              <li class="maker" data-reveal style={`--i:${i % 3}`}>
                {m}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ==========================================================
         Three ways to work (shared, locked copy)
    ========================================================== -->
    <WaysToWork tone="ink" highlight="app" />

    <!-- ==========================================================
         The studio
    ========================================================== -->
    <section class="sheet sheet--cream section" id="studio">
      <div class="container who">
        <figure class="who__figure">
          <div class="who__accent" aria-hidden="true"></div>
          <div class="who__media">
            <img
              src="/Images/studio-hero.webp"
              alt="Two hubStudio art directors mark up printed proofs pinned to a studio wall, one circling a sneaker shot with a red pencil next to the note “crop tighter”."
              width="2000"
              height="1333"
              loading="lazy"
              decoding="async"
              data-parallax
              data-speed="0.12"
            />
          </div>
          <figcaption class="who__cap">
            <span class="who__cap-dot" aria-hidden="true"></span>
            Hong Kong / Shanghai / Changsha / Philippines / Paris
          </figcaption>
        </figure>

        <div class="who__text">
          <span class="eyebrow" data-reveal>The hubStudio studio</span>
          <h2 class="who__statement" data-reveal>
            When the job needs a studio, ours makes it <span class="accent">for you</span>.
          </h2>
          <p class="who__body" data-reveal>
            The studio is the human side of hubStudio: senior art directors, designers,
            retouchers, motion designers, writers and AIGC specialists, working across twenty
            service lines. An art director leads every brief. Some assets get shot and some get
            generated. Most mix the two, and we decide asset by asset.
          </p>
          <p class="who__body" data-reveal>
            We’re headquartered in Hong Kong, with studios in Shanghai and Changsha, a team in
            the Philippines and an office in Paris. Cyril Drouin, a former CEO at Publicis,
            founded the company. The studio team runs brand-trained models on GPU pipelines it
            manages, and records how each asset was made.
          </p>

          <div class="who__stats">
            <div class="who-stat" data-reveal style="--i:0">
              <span class="who-stat__num who-stat__num--word">One</span>
              <span class="who-stat__label">Business day for a producer to read your brief</span>
            </div>
            <div class="who-stat" data-reveal style="--i:1">
              <span class="who-stat__num"><span class="count" data-to="48">48</span></span>
              <span class="who-stat__label">Hours for a written proposal</span>
            </div>
          </div>

          <p class="who__proof" data-reveal>
            Recent studio clients include HiSense, Shiseido, Camper and iFlytek.
            <a href="/work">See the work</a>
          </p>

          <div class="who__cta" data-reveal>
            <Button variant="primary" href={`${BRIEF_URL}?way=studio`}>Send a brief</Button>
            <a class="arrow-link" href="/studio">
              Meet the studio <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         Studio services (bento)
    ========================================================== -->
    <section class="sheet sheet--light section" id="services">
      <div class="container">
        <header class="s-head">
          <span class="eyebrow" data-reveal>Studio services</span>
          <h2 class="headline h2" data-reveal>
            Twenty service lines, <span class="accent">one studio</span>.
          </h2>
          <p class="s-head__intro" data-reveal>
            From one social post to a full campaign system. The twenty service lines fall into
            six groups, and one team runs them all on the same brand rules.
          </p>
        </header>

        <div class="bento">
          {
            categories.map((cat, i) => (
              <div
                class={`tile tile--${cat.span} tile--${cat.tone}`}
                data-reveal
                data-tilt
                style={`--i:${i}`}
              >
                <span class="tile__ghost" aria-hidden="true">
                  {cat.icon === 'content' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="4" y="4" width="16" height="16" rx="4.5" />
                      <rect x="12" y="12" width="16" height="16" rx="4.5" />
                    </svg>
                  )}
                  {cat.icon === 'video' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="6" width="21" height="20" rx="5.5" />
                      <path d="M11.5 12.2 18.7 16 11.5 19.8Z" />
                    </svg>
                  )}
                  {cat.icon === 'commerce' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="5" width="26" height="22" rx="4.5" />
                      <path d="M3 11.5h26" />
                    </svg>
                  )}
                  {cat.icon === 'strategy' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <circle cx="16" cy="16" r="11.5" />
                      <circle cx="16" cy="16" r="4" />
                    </svg>
                  )}
                  {cat.icon === 'brand' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <circle cx="16" cy="16" r="12" />
                      <rect x="8.5" y="8.5" width="15" height="15" rx="2.5" transform="rotate(45 16 16)" />
                    </svg>
                  )}
                  {cat.icon === 'sales' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="3" y="6" width="26" height="17.5" rx="3.5" />
                      <path d="M16 23.5v4.5" />
                    </svg>
                  )}
                </span>

                <span class="tile__icon" aria-hidden="true">
                  {cat.icon === 'content' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="4" y="4" width="16" height="16" rx="4.5" />
                      <rect class="ic-fill" x="12" y="12" width="16" height="16" rx="4.5" stroke="none" />
                      <rect x="12" y="12" width="16" height="16" rx="4.5" />
                      <circle class="ic-accent" cx="20" cy="20" r="3" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'video' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="3" y="6" width="21" height="20" rx="5.5" />
                      <path class="ic-accent" d="M11.5 12.2 18.7 16 11.5 19.8Z" stroke="none" />
                      <path d="M27 11h3M27 16h4M27 21h3" stroke-linecap="round" />
                    </svg>
                  )}
                  {cat.icon === 'commerce' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="3" y="5" width="26" height="22" rx="4.5" />
                      <path d="M3 11.5h26" />
                      <circle cx="7" cy="8.2" r="1.1" fill="currentColor" stroke="none" />
                      <rect class="ic-accent" x="12" y="16" width="11" height="7.5" rx="2.5" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'strategy' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <circle cx="16" cy="16" r="11.5" />
                      <path d="M16 2.5v5M16 24.5v5M2.5 16h5M24.5 16h5" stroke-linecap="round" />
                      <circle class="ic-accent" cx="16" cy="16" r="3.6" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'brand' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <circle cx="16" cy="16" r="12" />
                      <rect x="8.5" y="8.5" width="15" height="15" rx="2.5" transform="rotate(45 16 16)" />
                      <circle class="ic-accent" cx="16" cy="16" r="3.1" stroke="none" />
                    </svg>
                  )}
                  {cat.icon === 'sales' && (
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="3" y="6" width="26" height="17.5" rx="3.5" />
                      <path d="M16 23.5v4.5M11 28h10" stroke-linecap="round" />
                      <path d="M8.5 11.5h8" stroke-linecap="round" opacity="0.55" />
                      <circle class="ic-accent" cx="21.5" cy="15" r="3.4" stroke="none" />
                    </svg>
                  )}
                </span>

                <div class="tile__body">
                  <h3 class="tile__name">{cat.name}</h3>
                  <p class="tile__summary">{cat.summary}</p>
