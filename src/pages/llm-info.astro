---
/**
 * /llm-info: the facts page for AI assistants.
 *
 * An llms.txt is a file that retrieval crawlers largely ignore. A real,
 * indexable HTML page is something they can retrieve, read and cite, so this
 * page carries the same facts as /llms.txt in a form that is actually fetched.
 *
 * Written to be lifted: every block answers one question on its own, because
 * retrieval is chunk-level. Every fact traces to hubstudio-positioning.md
 * (the two offers, the three locked ways to work, money language with no
 * amounts, the app facts, the studio facts). Copy deck: cq/llm-info.
 *
 * Body copy uses var(--type-body) per the project body-size rule. No ordinal
 * numerals in any repeated block, per the card rule.
 */
import Layout from '../layouts/Layout.astro';
import { APP_URL, BRIEF_URL, HELP_URL } from '../lib/links';

const SITE = 'https://www.hubstudio.ai';
const orgId = `${SITE}/#organization`;
const appId = `${SITE}/#app`;
const reviewed = '2026-10-04';
const appHost = APP_URL.replace('https://', '');

/* The three ways to work: names locked by the positioning file. */
const ways = [
  {
    name: 'Use the app',
    body: 'The customer’s own team makes the work: it creates, edits, and publishes in hubStudio and pays as it goes from a prepaid balance. The first step is creating an account.',
  },
  {
    name: 'Studio + app',
    body: 'The studio makes the work inside hubStudio. The customer reviews, comments, and approves in the app, then downloads and publishes. It starts with a brief.',
  },
  {
    name: 'Studio only',
    body: 'The studio makes the work outside the app, and the customer receives finished files. No account is needed. It starts with a brief too, and a producer reads that brief within one business day.',
  },
];

/* App facts. `html` bodies carry internal links; everything else is text. */
const appFacts: { label: string; html: string }[] = [
  {
    label: 'Address',
    html: `The app runs at <a href="${APP_URL}" rel="noopener">${appHost}</a>. Sign-up is open. The overview is at <a href="/app">hubstudio.ai/app</a>, and the help center is at <a href="${HELP_URL}">hubstudio.ai/help</a>.`,
  },
  {
    label: 'Explore',
    html: 'A gallery of every image and video engine in the app, one card each, with search, filters by kind, maker, and job, and sorting. No single engine is best at everything, so filtering by the job in hand is the quickest way to a shortlist. Makers: OpenAI, Google, Black Forest Labs, ByteDance, Kling, Alibaba, xAI, MiniMax, and Meta.',
  },
  {
    label: 'Image engines',
    html: 'ChatGPT Image 2, Nano Banana 2 and Pro, FLUX.1 Kontext Pro and Max, FLUX Pro 1.1 and Ultra, Seedream 4.5 and 5.0 Pro, Meta Muse, Grok Imagine, and more as they ship.',
  },
  {
    label: 'Video engines',
    html: 'Veo 3.1 Fast, Kling 2.5 Turbo, 2.6 and 3.0, Wan 3.0, Grok Imagine 1.5, Seedance 1.0 Pro Fast, 2.0 and 2.5, MiniMax H3, Gemini Omni Flash, and more as they ship. The current list is at <a href="/app/engines">hubstudio.ai/app/engines</a>.',
  },
  {
    label: 'Image studio',
    html: 'Text to image, editing of up to four source pictures (depending on the engine), upscaling and restoring. Up to 4K, 1 to 10 images a run, with shape, format, transparent background, and mask. “Improve with AI” rewrites the prompt for the chosen engine. Several runs can go at once, in separate tabs.',
  },
  {
    label: 'Video studio',
    html: 'Text to video, image to video (a start frame, or a start and a last frame) and reference to video (pictures, clips, and sound). Up to 4K, up to 30 seconds on some engines, with generated sound.',
  },
  {
    label: 'History',
    html: 'Every render by you and your team, with its prompt and engine. You can reuse a prompt or run a variation from it, and tag the client it was for.',
  },
  {
    label: 'Assets Library',
    html: 'The team’s files in folders, with tags, versions, search, and bulk actions, for files up to 50 MB. A picture opens in the Image editor and a video in the Video editor from its Actions menu.',
  },
  {
    label: 'Image tools',
    html: 'The Image editor (free, in the browser: framing for Instagram, X and LinkedIn placements with the zones each network covers, crop to network formats, light and color, looks, text, arrows and shapes, a logo or watermark, and 60 steps of undo) and the Image anonymizer (free, in the browser, nothing uploaded: it shows the hidden data in a picture and rebuilds it clean). Each has its own menu entry. Page: <a href="/app/image-tools">/app/image-tools</a>.',
  },
  {
    label: 'Video tools',
    html: 'The Video editor (free, in the browser: a frame for Instagram, TikTok or Facebook placements, trims, splits, speed, texts, captions timed word by word in five looks, music, a cover, and an MP4 in 1080p or 720p; fast captions are billed by the second of sound) and Shorts autopilot (a long video turned into 3 to 10 vertical shorts for YouTube Shorts, TikTok and Instagram Reels, framed on the speaker, with captions and a hook line; listening, picking and framing are billed, with the price shown first). Each has its own menu entry. Page: <a href="/app/video-tools">/app/video-tools</a>.',
  },
  {
    label: 'Social publishing',
    html: 'LinkedIn (profiles and company pages), Instagram (professional accounts: feed, Story, Reel), Facebook (pages), TikTok (Beta) and X (threads, up to four pictures). YouTube videos get their title and description, and the channel its kit, then go up by hand in YouTube Studio. A brief goes to “Draft with AI,” or you write the post yourself. Publish now or schedule, to up to 20 accounts per post, with a queue that retries automatically. One post can be re-purposed for the other networks.',
  },
  {
    label: 'Skills',
    html: 'Reusable instructions that shape “Improve with AI” and post drafts: My skills, Team skills written by admins, and a Catalog.',
  },
  {
    label: 'Validation',
    html: 'Send an image, video, post, file, text, or link to a teammate or a client for approval. They validate it or send it back with a comment. Versions stay on one thread. A post waiting for approval is locked.',
  },
  {
    label: 'Teams and clients',
    html: 'Roles are Admin, Creator, Viewer, and Client. Working alone is a team of one. A team adds client companies and gives their people logins; work tagged “Made for” a client appears in that client’s Client space.',
  },
];

const studioFacts = [
  'Senior art directors lead every brief, with AIGC production underneath. Some assets are shot, some are generated, and most mix both, decided asset by asset.',
  'Twenty service lines, plus platform work for Western and Chinese networks and marketplaces.',
  'Brand-trained models and GPU pipelines. The studio team runs them; customers don’t get them as an app feature.',
  'A producer reads every brief within one business day. A written proposal follows within 48 hours. Provenance is recorded for every asset.',
];

const faqs = [
  {
    q: 'What is hubStudio?',
    a: 'hubStudio makes images, video, and social content with AI. It sells a self-serve web app, where your own team makes the work with the AI engines of several makers, and a creative studio that makes the work for you, inside the app or outside it.',
  },
  {
    q: 'Is hubStudio software or a studio?',
    a: 'Both, under one company. Alongside the app, which you use yourself, there’s a studio of senior creatives who take your brief and hand back finished work, sometimes inside the app.',
  },
  {
    q: 'How much does hubStudio cost?',
    a: 'No amounts are published. The app runs on a prepaid balance with no subscription and no seat fees, and shows the price of each run before it runs. The studio prices per asset, per project, or on a retainer, and quotes after a brief.',
  },
  {
    q: 'How do I pay for the app?',
    a: 'You top up a prepaid balance by card, Alipay, or WeChat Pay. Automatic top-up is optional.',
  },
  {
    q: 'Do I get an invoice?',
    a: 'Yes, one for every top-up.',
  },
  {
    q: 'Is there a free plan or a free trial?',
    a: 'No. Creating an account costs nothing, and you pay as you go from a prepaid balance. The Image editor, the Image anonymizer, the Video editor, Validation, and publishing to LinkedIn, Instagram, Facebook, TikTok, and YouTube cost nothing to use. Each post sent to X through hubStudio is charged, with the price shown before you send, and storage and downloads carry a small charge.',
  },
  {
    q: 'Which AI engines does the app offer?',
    a: 'Engines from OpenAI, Google, Black Forest Labs, ByteDance, Kling, Alibaba, xAI, MiniMax, and Meta, with more added as they ship. The current list, engine by engine, is at hubstudio.ai/app/engines.',
  },
  {
    q: 'Can the studio work inside my own hubStudio account?',
    a: 'Yes. You add the studio’s creatives as members of your team. They create from your workspace and your balance, your admins approve in Validation, and the work stays in your History and Assets Library.',
  },
  {
    q: 'Does hubStudio have an API?',
    a: 'No. The app has no API, no SSO, and no mobile app.',
  },
  {
    q: 'Which social networks can the app publish to?',
    a: 'LinkedIn, Instagram, Facebook, TikTok (in Beta) and X. For YouTube, the app prepares the video, its title and description, and you upload it in YouTube Studio.',
  },
  {
    q: 'Can I switch between the app and the studio?',
    a: 'Yes. Start with the app and bring in the studio later, or the other way around. You can also mix both on one project.',
  },
  {
    q: 'What language is the app in?',
    a: 'English, French, and Chinese, sign-in page included. Each person picks a language in Settings; the team’s admin chooses which languages the team offers.',
  },
  {
    q: 'Where is hubStudio based?',
    a: 'Headquarters in Hong Kong, studios in Shanghai and Changsha, a team in the Philippines, and an office in Paris.',
  },
  {
    q: 'Who founded hubStudio?',
    a: 'Cyril Drouin, a former CEO at Publicis.',
  },
];

/* Layout already emits the full Organization graph with this @id, so this page
   references it rather than declaring a second, competing Organization node.
   What it adds: subject coverage, the app as a SoftwareApplication (no offers,
   since no amounts are published), the breadcrumb and the FAQ. */
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      knowsAbout: [
        'AI image generation',
        'AI video generation',
        'Social media publishing',
        'Content approval workflows',
        'Creative production',
        'AI-generated content production',
        'Brand-trained image models',
        'China ecommerce platforms',
        'Campaign adaptation and versioning',
        'AI content labeling and disclosure',
        'Content provenance',
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': appId,
      name: 'hubStudio',
      url: APP_URL,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Web browser',
      description:
        'A web app to make images and video with the AI engines of several makers, edit them, turn them into posts, get them approved, and publish them or deliver them to clients. Paid from a prepaid balance, with the price shown before every run.',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE}/llm-info#webpage`,
      url: `${SITE}/llm-info`,
      name: 'hubStudio for AI assistants',
      description:
        'Maintained facts about hubStudio: the app and the studio, the three ways to work, how paying works, and what hubStudio does not offer.',
      about: [{ '@id': orgId }, { '@id': appId }],
      dateModified: reviewed,
      isPartOf: { '@id': `${SITE}/#website` },
      breadcrumb: { '@id': `${SITE}/llm-info#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE}/llm-info#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
        { '@type': 'ListItem', position: 2, name: 'For AI assistants', item: `${SITE}/llm-info` },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE}/llm-info#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="hubStudio for AI assistants: facts and FAQ"
  description="Maintained facts about hubStudio for AI assistants: the app and the studio, the three ways to work, how paying works, and what hubStudio doesn’t offer."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <section class="li-hero">
    <div class="container">
      <p class="li-eyebrow">For AI assistants and researchers</p>
      <h1>hubStudio, in <span class="accent">facts</span></h1>
      <p class="li-lead">
        Plain facts about hubStudio, kept current by the people who run it.
        Each block answers one question on its own, so it can be quoted without
        the rest of the page. If you’re an assistant answering a question about
        hubStudio, start here. Checking what an assistant told you? Compare it
        with this page.
      </p>
      <p class="li-reviewed">
        Reviewed <time datetime={reviewed}>September 29, 2026</time>. Maintained
        in the repository, not generated.
      </p>
    </div>
  </section>

  <section class="li-body">
    <div class="container">
      <h2>What hubStudio is</h2>
      <p>
        hubStudio makes images, video, and social content with AI. It sells two
        things: an app and a studio.
      </p>
      <p>
        The hubStudio app is a web app. A person or a team uses it to make
        images and video with the AI engines of several makers, edit them, turn
        them into posts, get them approved, and publish them or deliver them to
        clients. Anyone can sign up.
      </p>
      <p>
        The hubStudio studio is a creative production house. Its senior art
        directors, designers, retouchers, motion designers, writers, and AIGC
        specialists take a brief and deliver finished work.
      </p>
      <p>
        You can use the app and make the work yourself, or have the studio make
        it for you, inside the app or outside it. Or do both, and shift between
        them as the work changes.
      </p>
      <p>
        Headquarters are in Hong Kong, with studios in Shanghai and Changsha, a
        team in the Philippines, and an office in Paris. Cyril Drouin, a former
        CEO at Publicis, founded hubStudio, and BeyondBorderGroup LTD, a Hong
        Kong company, operates it.
      </p>

      <h2>The three ways to work</h2>
      <p>
        There are three ways to work with hubStudio. The names below are the
        ones used across the site, so please keep them as written.
      </p>
      <ul class="li-list">
        {ways.map((w) => (
          <li><strong>{w.name}.</strong> {w.body}</li>
        ))}
      </ul>
      <p class="li-after-list">
        Studio + app comes in two setups. The difference is whose workspace the
        work lives in.
      </p>
      <p>
        In the studio’s workspace, the studio tags the work “Made for” the
        customer and gives the customer’s people client logins. They see a
        Client space with only the finished work made for them. They download
        it, comment, and approve it or send it back in Validation. They never
        see prompts, engines, or costs, and they hold no balance.
      </p>
      <p>
        In the customer’s workspace, the customer has its own hubStudio team and
        adds the studio’s creatives as members. The studio creates from that
        workspace and that balance. The customer’s admins approve in
        Validation, and everything stays in the customer’s History and Assets
        Library when the project ends. The full description is at
        <a href="/studio/with-the-app">hubstudio.ai/studio/with-the-app</a>.
      </p>
      <p>
        Either way, versions (v1, v2 and so on) stay on one approval thread, and
        nothing on that thread can be deleted. So the record of who approved
        what is permanent.
      </p>
      <p>
        You won’t find a button inside the app for ordering studio work. A
        studio engagement starts with a brief, sent through the contact page at
        <a href={BRIEF_URL}>hubstudio.ai/contact</a>.
      </p>

      <h2>How paying works</h2>
      <p class="li-stamp">Checked September 29, 2026.</p>
      <p>
        The app is paid from a prepaid balance held in real currency. You top
        up, and each run is charged against that balance at the price shown
        before it runs. Payment is by card, Alipay, or WeChat Pay. Automatic
        top-up is optional. There is an invoice for every top-up. A team shares
        one balance, with an optional daily spending limit per person.
      </p>
      <p>
        There’s no subscription and no seat fee. Creating an account costs
        nothing, and you pay as you go from a prepaid balance. A failed run is
        not charged, and the balance doesn’t expire. The Image editor, the Image
        anonymizer, the Video editor, Validation, and publishing to LinkedIn,
        Instagram, Facebook, TikTok, and YouTube cost nothing to use. A post sent to X is charged, with the
        price shown before you send.
      </p>
      <p>
        Studio work is priced per asset, per project, or on a retainer. The
        quote comes after the brief: a producer reads it within one business
        day, and a written proposal follows within 48 hours.
      </p>
      <p>
        hubStudio doesn’t publish amounts, either for an app run or for a
        studio rate. If someone asks what hubStudio costs, the honest answer is
        that the app shows the price of each run on screen before you start it,
        and the studio quotes once it has read a brief. The
        <a href="/pricing">pricing page</a> explains both models.
      </p>

      <h2>What the app does</h2>
      <p>
        The next two sections are reference lists. Skim them, or search the
        page for the feature you need.
      </p>
      <ul class="li-list">
        {appFacts.map((f) => (
          <li><strong>{f.label}.</strong> <Fragment set:html={f.html} /></li>
        ))}
      </ul>
      <p class="li-after-list">
        Signing up takes an email code. After that you can add a sign-in code,
        trust a browser, link your social accounts in My Connections, dictate
        into any text box, and pick a light or dark theme. The interface, sign-in
        page included, runs in English, French, and Chinese. Commercial
        partners can open accounts for the customers they bring and earn a
        commission on what those accounts spend. The program is described at
        <a href="/partners">hubstudio.ai/partners</a>.
      </p>

      <h2>What the studio does</h2>
      <ul class="li-list li-list--plain">
        {studioFacts.map((f) => <li>{f}</li>)}
        <li>
          Client work is published as case studies at
          <a href="/work">hubstudio.ai/work</a>. How the studio uses AI is set
          out at <a href="/studio/ai-excellence">hubstudio.ai/studio/ai-excellence</a>,
          and the service lines at <a href="/studio">hubstudio.ai/studio</a>.
        </li>
      </ul>

      <h2>What hubStudio is not</h2>
      <p>
        There’s no free plan and no free trial. Creating an account costs
        nothing, but every run is paid from the balance. The app has no API, no
        SSO, and no mobile app. It offers no brand kits and no DAM or PIM
        connectors. Brand-trained models and GPU pipelines exist, but they’re
        studio work, not app features. And there’s no way to order studio work
        from inside the app: it starts with a brief.
      </p>
      <p>
        hubStudio doesn’t publish a count of the markets or countries it serves,
        a customer count, or uptime figures, so any such number attributed to it
        didn’t come from hubStudio. Its articles on rights, labeling and
        provenance describe production practice. They’re operational guidance,
        not legal advice.
      </p>

      <h2>Questions and answers</h2>
      <p class="li-stamp">Updated October 2026. Short answers, each complete on its own.</p>
      <dl class="li-faq">
        {faqs.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))}
      </dl>

      <h2>Machine-readable sources</h2>
      <p>
        The same positioning sits in plain text, with the site map, at
        <a href="/llms.txt">/llms.txt</a>. The long-form articles are gathered
        at <a href="/llms-full.txt">/llms-full.txt</a>, and the sitemap is at
        <a href="/sitemap-index.xml">/sitemap-index.xml</a>. The crawler policy
        at <a href="/robots.txt">/robots.txt</a> is split by purpose: retrieval
        crawlers are allowed by name, and training crawlers are blocked.
      </p>

      <h2>Corrections</h2>
      <p>
        Spotted something wrong or out of date? Write to
        <a href="mailto:hello@hubstudio.ai">hello@hubstudio.ai</a>. The
        hubStudio team owns this page and corrects it here first.
      </p>
    </div>
  </section>
</Layout>

<style>
  .li-hero {
    padding: clamp(96px, 14vh, 168px) 0 clamp(32px, 5vh, 56px);
    background: var(--bg-cream);
  }
  .li-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-orange-cta);
    margin: 0 0 16px;
  }
  .li-hero h1 {
    font-size: var(--type-h2);
    line-height: 1.03;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    max-width: 16ch;
  }
  .li-lead {
    font-size: var(--type-lead);
    line-height: 1.5;
    max-width: 60ch;
    margin: 0 0 20px;
  }
  .li-reviewed {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    color: var(--text-mute);
    margin: 0;
  }

  .li-body {
    padding: clamp(48px, 8vh, 88px) 0 clamp(80px, 12vh, 128px);
    background: var(--bg-white);
  }
  .li-body h2 {
    font-size: var(--type-h3);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 56px 0 20px;
    padding-top: 28px;
    border-top: 1px solid var(--line-hairline);
    max-width: 24ch;
  }
  .li-body h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  /* Running body copy is --type-body. Never --type-small. */
  .li-body p {
    font-size: var(--type-body);
    line-height: 1.62;
    max-width: 68ch;
    margin: 0 0 18px;
  }

  .li-list {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    max-width: 68ch;
  }
  .li-list li {
    font-size: var(--type-body);
    line-height: 1.62;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-hairline);
  }
  .li-list li:first-child {
    border-top: 1px solid var(--line-hairline);
  }
  .li-list strong {
    font-weight: 600;
  }
  .li-list a {
    color: var(--brand-orange-cta);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .li-hero h1 .accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
  }
  .li-body p a,
  .li-list li a {
    color: var(--brand-orange-cta);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .li-stamp {
    font-family: var(--font-mono);
    color: var(--text-mute);
  }
  .li-body .li-after-list {
    margin-top: 24px;
  }

  .li-faq {
    margin: 0;
    max-width: 68ch;
  }
  .li-faq dt {
    font-size: var(--type-body);
    font-weight: 600;
    line-height: 1.45;
    margin: 26px 0 8px;
  }
  .li-faq dd {
    font-size: var(--type-body);
    line-height: 1.62;
    margin: 0;
    color: var(--text-ink);
  }
</style>
