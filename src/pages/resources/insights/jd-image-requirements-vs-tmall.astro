          <th scope="col">Sources agreeing</th>
          <th scope="col">Confidence</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Main image floor</th>
          <td>800 by 800 pixels</td>
          <td>One page gives another figure</td>
          <td>9 of 10</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Aspect ratio</th>
          <td>1:1</td>
          <td>No conflicting value found</td>
          <td>6 of 6</td>
          <td>consensus</td>
        </tr>
        <tr>
