        </tr>
        <tr>
          <th scope="row">White-background image slot</th>
          <td>First in the carousel</td>
          <td>No contradicting page</td>
          <td>5 of 5</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Main image file cap</th>
          <td>1MB</td>
          <td>500KB to 1MB</td>
          <td>4 of 6</td>
          <td>contested</td>
        </tr>
        <tr>
          <th scope="row">Desktop detail page width</th>
          <td>790 pixels</td>
