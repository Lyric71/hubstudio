const faq = [
  {
    "q": "Do China's AI labeling rules apply to a foreign brand?",
    "a": "They attach to content published through services operating in mainland China, not to the nationality of the advertiser. If you publish generated content on a Chinese platform, the declaration duty in Article 10 is engaged regardless of where your team sits. Whether your agency or your studio shares that duty depends on the role each actually plays, which is a question for counsel."
