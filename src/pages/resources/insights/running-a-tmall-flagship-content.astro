          <td>Practice</td>
        </tr>
        <tr>
          <th scope="row">Offer, price and shipping details</th>
          <td>Checked for each cycle and year</td>
          <td>Reported sign-up and listing rules differ by cycle and year</td>
          <td>Derived</td>
        </tr>
