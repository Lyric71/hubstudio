<script>
  /* Kind switch, reveal, spotlight, provider filter and column sort (the
     filter and the sort as in the app). */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- Text / Image / Video ---------------------------------------- */
  const switchWrap = document.querySelector<HTMLElement>('[data-mb-switch]');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.mb-switch__tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-mb-panel]'));
  const thumb = document.querySelector<HTMLElement>('.mb-switch__thumb');
  const kinds = tabs.map((t) => t.dataset.kind ?? '');

  const placeThumb = () => {
    const on = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (!on || !thumb) return;
    thumb.style.setProperty('--x', `${on.offsetLeft}px`);
    thumb.style.setProperty('--w', `${on.offsetWidth}px`);
  };

  const select = (kind: string, opts: { focus?: boolean; hash?: boolean } = {}) => {
    if (!kinds.includes(kind)) kind = kinds[0];
    tabs.forEach((t) => {
      const on = t.dataset.kind === kind;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && opts.focus) t.focus();
    });
    panels.forEach((p) => {
      p.hidden = p.dataset.mbPanel !== kind;
    });
    placeThumb();
    if (opts.hash) {
      // The hash makes the tab linkable (#image); replaceState keeps the page still.
      const url = kind === kinds[0] ? location.pathname + location.search : `#${kind}`;
      history.replaceState(null, '', url);
    }
  };

  if (switchWrap && tabs.length > 1) {
    switchWrap.hidden = false;
    const fromHash = location.hash.slice(1);
    select(kinds.includes(fromHash) ? fromHash : kinds[0]);
    // Placed again once the fonts settle the tab widths; no slide on that move.
    thumb?.classList.add('is-still');
    requestAnimationFrame(() => {
      placeThumb();
      requestAnimationFrame(() => thumb?.classList.remove('is-still'));
    });
    document.fonts?.ready.then(placeThumb);
    window.addEventListener('resize', placeThumb);

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.kind ?? '', { hash: true }));
      t.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')
          j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(tabs[j].dataset.kind ?? '', { focus: true, hash: true });
      });
    });
    window.addEventListener('hashchange', () => {
      const k = location.hash.slice(1);
      if (kinds.includes(k)) select(k);
    });
  }

  /* ---- Reveal (threshold 0) and spotlight ---------------------------- */
  const io =
    'IntersectionObserver' in window && !reduced
      ? new IntersectionObserver(
          (entries) => {
            for (const e of entries)
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                e.target.classList.remove('mb-hidden');
                io?.unobserve(e.target);
              }
          },
          { threshold: 0 },
        )
      : null;
  for (const el of document.querySelectorAll<HTMLElement>('[data-mb-reveal]')) {
    // Only what sits below the fold of the visible panel waits for the scroll.
    if (io && !el.closest('[hidden]') && el.getBoundingClientRect().top > window.innerHeight) {
      el.classList.add('mb-hidden');
      io.observe(el);
    }
  }

  if (!reduced) {
    for (const card of document.querySelectorAll<HTMLElement>('[data-mb-spot]')) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  }

  /* ---- Provider filter and sort, one table per panel ----------------- */
  const collator = new Intl.Collator(document.documentElement.lang || 'en', {
    sensitivity: 'base',
    numeric: true,
  });
  for (const panel of panels) {
    const table = panel.querySelector<HTMLTableElement>('[data-mb-table]');
    const body = table?.tBodies[0];
    if (!table || !body) continue;

    panel
      .querySelector<HTMLSelectElement>('[data-mb-provider]')
      ?.addEventListener('change', (e) => {
        const p = (e.target as HTMLSelectElement).value;
        for (const tr of body.rows) tr.hidden = !!p && tr.dataset.provider !== p;
      });

    for (const btn of table.querySelectorAll<HTMLButtonElement>('[data-mb-sort]')) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.mbSort!;
        const numeric = btn.hasAttribute('data-mb-num');
        // A score sorts strongest first, a price level cheapest first, a name
        // A to Z; a second click turns the order round.
        const natural = numeric && !btn.hasAttribute('data-mb-asc') ? 'descending' : 'ascending';
        const was = btn.getAttribute('aria-sort');
        const dir = was ? (was === 'ascending' ? 'descending' : 'ascending') : natural;
        for (const b of table.querySelectorAll('[data-mb-sort]')) b.removeAttribute('aria-sort');
        btn.setAttribute('aria-sort', dir);
        const attr = key === 'label' || key === 'level' ? key : `s-${key}`;
        const rows = [...body.rows];
        const byName = (a: HTMLElement, b: HTMLElement) =>
          collator.compare(a.dataset.label ?? '', b.dataset.label ?? '');
        rows.sort((a, b) => {
          const x = a.getAttribute(`data-${attr}`) ?? '';
          const y = b.getAttribute(`data-${attr}`) ?? '';
          if (!numeric)
            return dir === 'ascending' ? collator.compare(x, y) : collator.compare(y, x);
          // A model with no figure always goes last.
          if (x === '' && y === '') return byName(a, b);
          if (x === '') return 1;
          if (y === '') return -1;
          return (
            (dir === 'ascending' ? Number(x) - Number(y) : Number(y) - Number(x)) || byName(a, b)
          );
        });
        body.append(...rows);
      });
    }
  }
</script>
