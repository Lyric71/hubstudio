---
/**
 * AI model benchmarks  ·  /resources/insights/ai-model-benchmarks
 *
 * The public twin of the app's Model benchmarks page (Settings > Model
 * benchmarks in the hubStudio app): same sections in the same order, in the
 * site's skin, with a Text / Image / Video switch on top. Per kind: the three
 * choices (Quick, Balanced, Best, text only) as hue cards, the scores card
 * (provider filter, sortable table) and What the benchmarks measure. Unlike
 * the app page it shows no cost of any kind: only the relative price level,
 * $ to $$$$ (per image for image models, per clip for video models).
 *
 * Every figure, name, date and count comes from src/data/model-benchmarks.json,
 * which the app generates and a script refreshes twice a month: never edit
 * that file by hand and never copy a figure from it into this page. A model
 * or a benchmark without `kind` counts as text. A kind with models but no
 * benchmark yet lists its models with their price level and says the public
 * scores are being collected; a kind with neither has no tab.
 *
 * Translation: the English copy goes through the dictionaries like any page.
 * What the JSON carries (model and benchmark names, makers, figures, dates,
 * and the benchmark wording it already ships in French and Chinese) is rendered here
 * in the page's language and marked data-no-i18n, so a refresh of the file
 * never leaves a sentence untranslated.
 *
 * House rules: hubStudio is the only product named; no amount of money, no
 * per-run price, no markup and no tier code; no em dash and no spaced hyphen
 * in any language (a missing figure is a dash drawn in CSS, not a character).
 */
import Layout from '../../../layouts/Layout.astro';
import DualCta from '../../../components/DualCta.astro';
import raw from '../../../data/model-benchmarks.json';

type Lang = 'en' | 'fr' | 'zh';
type Kind = 'text' | 'image' | 'video';
interface Bench {
  key: string;
  name: string;
  measures: string;
  unit: string;
  higherIsBetter: boolean;
  sourceName: string;
  sourceUrl: string;
  asOf: string;
  note?: string;
  kind?: string;
  i18n?: {
    measures?: Partial<Record<'fr' | 'zh', string>>;
    note?: Partial<Record<'fr' | 'zh', string>>;
  };
}
interface Score {
  value: number;
  sourceUrl: string;
  vendor?: boolean;
}
interface Model {
  id: string;
  label: string;
  provider: string;
  level?: number | null;
  web?: boolean;
  vision?: boolean;
  kind?: string;
  scores?: Record<string, Score | undefined>;
}
interface Data {
  collectedOn: string;
  benchmarks: Bench[];
  tiers: { tier: string; model: string }[];
  models: Model[];
}
const data = raw as unknown as Data;

const SITE = 'https://www.hubstudio.ai';
const PATH = '/resources/insights/ai-model-benchmarks';
const locale: Lang = Astro.locals.locale ?? 'en';

/* ---- Formatting, in the page's language ------------------------------ */
const NUM_LOCALE = { en: 'en-US', fr: 'fr-FR', zh: 'zh-CN' }[locale];
const decimals = (v: number) => {
  const s = String(v);
  const i = s.indexOf('.');
  return i < 0 ? 0 : Math.min(2, s.length - i - 1);
};
const NBSP = String.fromCharCode(0xa0);
const NNBSP = new RegExp(String.fromCharCode(0x202f), 'g');
/**
 * A figure written for the locale. Arena ratings (elo, or a score of 200 and
 * more) are whole numbers in one block (1424), as the leaderboards print
 * them; every other figure keeps the decimals the JSON gives (57.6, 8.2).
 * Seconds carry their unit: 8.2 s, 8,2 s, 8.2 秒.
 */
function fmtValue(v: number, unit: string): string {
  const rating = unit === 'elo' || (unit === 'score' && v >= 200);
  const d = rating ? 0 : decimals(v);
  const s = new Intl.NumberFormat(NUM_LOCALE, {
    minimumFractionDigits: d,
    maximumFractionDigits: d,
    useGrouping: !rating,
  })
    .format(rating ? Math.round(v) : v)
    .replace(NNBSP, NBSP);
  if (unit === '%') return s + (locale === 'fr' ? `${NBSP}%` : '%');
  if (unit === 's') return s + (locale === 'zh' ? ' 秒' : `${NBSP}s`);
  return s;
}
/** 8 October 2026 · 8 octobre 2026 (1er for the first) · 2026 年 10 月 8 日 */
function fmtDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  if (locale === 'zh') return `${y} 年 ${m} 月 ${d} 日`;
  const month = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : 'en-GB', {
    month: 'long',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(y, m - 1, d)));
  return `${locale === 'fr' && d === 1 ? '1er' : d} ${month} ${y}`;
}
/** Benchmark wording the JSON already ships in French and Chinese. */
const localized = (en: string | undefined, tr?: Partial<Record<'fr' | 'zh', string>>) =>
  locale === 'en' ? (en ?? '') : tr?.[locale] || en || '';
/** "Kling 3.0 (KlingAI)" -> "Kling 3.0": the maker is shown on its own line. */
const display = (label: string) => label.replace(/\s*\([^()]*\)\s*$/, '') || label;

const kindOf = (k: string | undefined): Kind => (k === 'image' || k === 'video' ? k : 'text');

/* ---- Benchmarks and models ------------------------------------------- */
const allBenchmarks = data.benchmarks;
const allModels = data.models.map((m) => ({ ...m, scores: m.scores ?? {} }));

/** Best value of each column: the bar of every cell is drawn against it. */
const best = new Map<string, number>();
for (const b of allBenchmarks) {
  const vals = allModels
    .map((m) => m.scores[b.key]?.value)
    .filter((v): v is number => typeof v === 'number' && Number.isFinite(v));
  if (vals.length) best.set(b.key, b.higherIsBetter ? Math.max(...vals) : Math.min(...vals));
}
/** Bar width in percent of the column's best value (4 at least, so it shows). */
function barPct(b: Bench, v: number): number {
  const top = best.get(b.key);
  if (top === undefined || v <= 0 || top <= 0) return 0;
  const share = b.higherIsBetter ? v / top : top / v;
  return Math.max(4, Math.min(100, Math.round(share * 100)));
}

/* ---- The three choices (text) ----------------------------------------- */
const TIERS = [
  {
    tier: 'quick',
    label: 'Quick',
    blurb: 'Fast and cheap, for drafts and short posts',
    hue: 160,
    icon: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  },
  {
    tier: 'balanced',
    label: 'Balanced',
    blurb: 'Good quality at a fair cost, for most work',
    hue: 210,
    icon: '<path d="M12 3v18M5 7h14M5 7l-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z"/>',
  },
  {
    tier: 'best',
    label: 'Best',
    blurb: 'The strongest, for important work and hard questions',
    hue: 285,
    icon: '<path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/>',
  },
] as const;
type Tier = (typeof TIERS)[number];
const byId = new Map(allModels.map((m) => [m.id, m]));
const tierOf = new Map<string, Tier>();
const choices = TIERS.map((t) => {
  const id = data.tiers.find((x) => x.tier === t.tier)?.model;
  const model = id ? byId.get(id) : undefined;
  if (model && !tierOf.has(model.id)) tierOf.set(model.id, t);
  return { ...t, model };
});

/* ---- One panel per kind ---------------------------------------------- */
/* Every English sentence a panel shows, written out whole for the dictionaries. */
const KIND_COPY = {
  text: {
    tab: 'Text',
    title: 'Text model scores',
    desc: 'The text models you can pick in hubStudio. Click a column to sort by it.',
    level:
      'The price level, from $ to $$$$, says how expensive a text model is next to the others. It is a relative level, not a price.',
    collecting:
      'Public scores for the text models are being collected. Until they are published here, each model is listed with its price level.',
  },
  image: {
    tab: 'Image',
    title: 'Image model scores',
    desc: 'The image models you can pick in hubStudio. Click a column to sort by it.',
    level:
      'The price level, from $ to $$$$, says how expensive one image is with a model, next to the other image models. It is a relative level, not a price.',
    collecting:
      'Public scores for the image models are being collected. Until they are published here, each model is listed with its price level.',
  },
  video: {
    tab: 'Video',
    title: 'Video model scores',
    desc: 'The video models you can pick in hubStudio. Click a column to sort by it.',
    level:
      'The price level, from $ to $$$$, says how expensive one clip is with a model, next to the other video models. It is a relative level, not a price.',
    collecting:
      'Public scores for the video models are being collected. Until they are published here, each model is listed with its price level.',
  },
} as const;

const panels = (['text', 'image', 'video'] as const)
  .map((kind) => {
    const benchmarks = allBenchmarks.filter((b) => kindOf(b.kind) === kind);
    const first = benchmarks[0];
    /** Strongest first on the kind's headline benchmark; no figure last, by name. */
    const strength = (m: Model & { scores: Record<string, Score | undefined> }) => {
      const v = first ? m.scores[first.key]?.value : undefined;
      if (typeof v !== 'number') return null;
      return first!.higherIsBetter ? v : -v;
    };
    const rows = allModels
      .filter((m) => kindOf(m.kind) === kind)
      .sort((a, z) => {
        const x = strength(a);
        const y = strength(z);
        if (x !== null && y !== null)
          return y - x || display(a.label).localeCompare(display(z.label));
        if (x !== null) return -1;
        if (y !== null) return 1;
        return display(a.label).localeCompare(display(z.label));
      });
    return {
      kind,
      copy: KIND_COPY[kind],
      benchmarks,
      first,
      rows,
      providers: [...new Set(rows.map((r) => r.provider))],
      tiers:
        kind === 'text' ? choices.filter((c) => c.model && kindOf(c.model.kind) === 'text') : [],
    };
  })
  // A kind with neither models nor benchmarks has no tab; text always has one.
  .filter((p) => p.kind === 'text' || p.rows.length > 0 || p.benchmarks.length > 0);

const PRICE_LABEL: Record<number, string> = {
  1: 'Price level 1 of 4',
  2: 'Price level 2 of 4',
  3: 'Price level 3 of 4',
  4: 'Price level 4 of 4',
};

/* ---- SEO ---------------------------------------------------------------- */
const title = 'AI model benchmarks: how the models compare | hubStudio';
const description =
  'The AI models in hubStudio, scored on public benchmarks. Each figure links to the page it was read on, and the scores are updated twice a month.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: `${SITE}/resources` },
    { '@type': 'ListItem', position: 3, name: 'Insights', item: `${SITE}/resources/insights` },
    { '@type': 'ListItem', position: 4, name: 'AI model benchmarks', item: `${SITE}${PATH}` },
  ],
};
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${SITE}${PATH}#dataset`,
  name: 'AI model benchmarks',
  description:
    'Scores of the AI models in hubStudio on public benchmarks, read from public leaderboards and, where no independent figure exists, from the model maker’s own launch post. Each figure links to the page it was read on.',
  url: `${SITE}${PATH}`,
  inLanguage: 'en',
  dateModified: data.collectedOn,
  isAccessibleForFree: true,
  creator: { '@id': `${SITE}/#organization` },
  publisher: { '@id': `${SITE}/#organization` },
  variableMeasured: allBenchmarks.map((b) => b.name),
  isBasedOn: [...new Set(allBenchmarks.map((b) => b.sourceUrl))],
};
---

<Layout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(dataset)} />
  <div class="mb">
    <!-- ===== Hero ===== -->
    <section class="mb-hero">
      <div class="container">
        <span class="eyebrow">AI model benchmarks</span>
        <h1 class="headline h1 mb-hero__title">
          How the AI models <span class="accent">compare</span>.
        </h1>
        <p class="lead mb-hero__lead">
          The AI models you can pick in hubStudio, scored on public, independent benchmarks, with
          every figure linked to the page it was read on. For text, every model list opens on three
          choices, Quick, Balanced and Best, so you never have to know the models by name: this page
          shows what stands behind them.
        </p>
        <ul class="mb-facts">
          <li class="mb-fact">
            <span class="mb-fact__dot" aria-hidden="true"></span>
            <span>
              Scores read on{' '}
              <time datetime={data.collectedOn} data-no-i18n>
                {fmtDate(data.collectedOn)}
              </time>
            </span>
          </li>
          <li class="mb-fact">
            <span>
              <span data-no-i18n>{allModels.length}</span> models
            </span>
          </li>
          <li class="mb-fact">
            <span>
              <span data-no-i18n>{allBenchmarks.length}</span> benchmarks
            </span>
          </li>
        </ul>
      </div>
    </section>

    <div class="container mb-page" data-mb-kinds>
      <!-- ===== Text / Image / Video (shown by the script; without it every panel shows) ===== -->
      {panels.length > 1 && (
        <div class="mb-switch-wrap" data-mb-switch hidden>
          <div class="mb-switch" role="tablist" aria-label="Model type">
            <span class="mb-switch__thumb" aria-hidden="true" />
            {panels.map((p, i) => (
              <button
                type="button"
                role="tab"
                class="mb-switch__tab"
                id={`mb-tab-${p.kind}`}
                aria-controls={`mb-panel-${p.kind}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-kind={p.kind}
              >
                {p.copy.tab}
              </button>
            ))}
          </div>
        </div>
      )}

      {panels.map((p) => (
        <div
          class="mb-panel"
          id={`mb-panel-${p.kind}`}
          data-mb-panel={p.kind}
          role={panels.length > 1 ? 'tabpanel' : undefined}
          aria-labelledby={panels.length > 1 ? `mb-tab-${p.kind}` : undefined}
        >
          {/* ===== The three choices (text only) ===== */}
          {p.tiers.length > 0 && (
            <section class="mb-tiers" data-mb-reveal aria-label="The three choices">
              {p.tiers.map((c) => (
                <article class="mb-tier" style={`--mb-hue: ${c.hue}`} data-mb-spot>
                  <span class="mb-tier__icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={c.icon}
                    />
                  </span>
                  <h2 class="mb-kicker">{c.label}</h2>
                  <p class="mb-tier__blurb">{c.blurb}</p>
                  <p class="mb-tier__model">
                    Runs on <strong data-no-i18n>{display(c.model!.label)}</strong>
                  </p>
                  {c.model!.level ? (
                    <p
                      class="mb-level mb-level--tier"
                      role="img"
                      aria-label={PRICE_LABEL[c.model!.level]}
                      title="Price level"
                    >
                      <span class="mb-level__on" data-no-i18n>
                        {'$'.repeat(c.model!.level)}
                      </span>
                      <span class="mb-level__off" data-no-i18n>
                        {'$'.repeat(Math.max(0, 4 - c.model!.level))}
                      </span>
                    </p>
                  ) : null}
                </article>
              ))}
            </section>
          )}

          {/* ===== The table ===== */}
          <section class="mb-card" data-mb-reveal>
            <header class="mb-card__head">
              <div>
                <h2 class="mb-card__title">{p.copy.title}</h2>
                <p class="mb-card__desc">{p.copy.desc}</p>
              </div>
              {p.providers.length > 1 && (
                <label class="mb-filter">
                  <span>Provider</span>
                  <select data-mb-provider data-i18n-options>
                    <option value="">Every provider</option>
                    {p.providers.map((pr) => (
                      <option value={pr} data-no-i18n>
                        {pr}
                      </option>
                    ))}
                  </select>
                </label>
              )}
            </header>

            {/* Always in the page, hidden while the kind has benchmarks: the
                extract then keeps its translation for the day a refresh
                leaves a kind without any (as en-empty on /app/engines). */}
            <p class="mb-collecting" hidden={p.benchmarks.length > 0}>
              {p.copy.collecting}
            </p>

            {p.rows.length > 0 && (
              <div
                class="mb-scroll"
                tabindex="0"
                role="region"
                aria-labelledby={`mb-caption-${p.kind}`}
              >
                <table
                  class:list={['mb-table', p.benchmarks.length === 0 && 'mb-table--plain']}
                  data-mb-table
                >
                  <caption class="sr-only" id={`mb-caption-${p.kind}`}>
                    {p.copy.title}
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col" class="mb-th--model">
                        <button type="button" data-mb-sort="label">
                          Model
                        </button>
                      </th>
                      <th scope="col" title="How expensive the model is next to the others">
                        <button type="button" data-mb-sort="level" data-mb-num data-mb-asc>
                          Price level
                        </button>
                      </th>
                      {p.benchmarks.map((b) => (
                        <th scope="col">
                          <button
                            type="button"
                            data-mb-sort={b.key}
                            data-mb-num
                            data-mb-asc={b.higherIsBetter ? undefined : ''}
                            aria-sort={
                              b === p.first
                                ? b.higherIsBetter
                                  ? 'descending'
                                  : 'ascending'
                                : undefined
                            }
                          >
                            <span data-no-i18n>{b.name}</span>
                          </button>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {p.rows.map((r) => {
                      const t = p.kind === 'text' ? tierOf.get(r.id) : undefined;
                      return (
                        <tr
                          data-provider={r.provider}
                          data-label={display(r.label)}
                          data-level={r.level ?? ''}
                          {...Object.fromEntries(
                            p.benchmarks.map((b) => [
                              `data-s-${b.key}`,
                              r.scores[b.key]?.value ?? '',
                            ]),
                          )}
                        >
                          <th scope="row" class="mb-model">
                            <span class="mb-model__name" data-no-i18n>
                              {display(r.label)}
                            </span>
                            <span class="mb-model__meta">
                              <span data-no-i18n>{r.provider}</span>
                              {t && <span class={`mb-chip mb-chip--${t.tier}`}>{t.label}</span>}
                              {r.web && (
                                <span
                                  class="mb-cap"
                                  role="img"
                                  title="Searches the web"
                                  aria-label="Searches the web"
                                >
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    aria-hidden="true"
                                  >
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
                                  </svg>
                                </span>
                              )}
                              {r.vision && p.kind === 'text' && (
                                <span
                                  class="mb-cap"
                                  role="img"
                                  title="Reads images"
                                  aria-label="Reads images"
                                >
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <rect x="3" y="4" width="18" height="16" rx="2" />
                                    <circle cx="9" cy="10" r="1.6" />
                                    <path d="m21 16-5-5-9 9" />
                                  </svg>
                                </span>
                              )}
                            </span>
                          </th>
                          <td class="mb-level-cell">
                            {r.level ? (
                              <span class="mb-level" role="img" aria-label={PRICE_LABEL[r.level]}>
                                <span class="mb-level__on" data-no-i18n>
                                  {'$'.repeat(r.level)}
                                </span>
                                <span class="mb-level__off" data-no-i18n>
                                  {'$'.repeat(Math.max(0, 4 - r.level))}
                                </span>
                              </span>
                            ) : (
                              <span class="mb-none">
                                <span class="mb-dash" />
                                <span class="sr-only">No price level</span>
                              </span>
                            )}
                          </td>
                          {p.benchmarks.map((b) => {
                            const s = r.scores[b.key];
                            if (!s) {
                              return (
                                <td class="mb-none">
                                  <span
                                    class="mb-dash"
                                    title="No public figure; we never estimate one"
                                  />
                                  <span class="sr-only">No public figure</span>
                                </td>
                              );
                            }
                            return (
                              <td>
                                <a
                                  href={s.sourceUrl}
                                  target="_blank"
                                  rel="noopener"
                                  class="mb-score"
                                >
                                  <span
                                    class="mb-score__bar"
                                    style={`--w: ${barPct(b, s.value)}%`}
                                    aria-hidden="true"
                                  />
                                  <span class="mb-score__v" data-no-i18n>
                                    {fmtValue(s.value, b.unit)}
                                  </span>
                                  {s.vendor && (
                                    <span class="mb-vendor" title="Reported by the model’s maker" />
                                  )}
                                </a>
                              </td>
                            );
                          })}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}

            <ul class="mb-legend">
              <li>
                <span class="mb-legend__mark" aria-hidden="true">
                  <span class="mb-level__on">$$</span>
                  <span class="mb-level__off">$$</span>
                </span>
                <span>{p.copy.level}</span>
              </li>
              {p.benchmarks.length > 0 && (
                <li>
                  <span class="mb-legend__mark" aria-hidden="true">
                    <span class="mb-vendor mb-vendor--demo" />
                  </span>
                  <span>
                    Reported by the model’s maker, used only where no independent figure exists.
                  </span>
                </li>
              )}
              {p.benchmarks.length > 0 && (
                <li>
                  <span class="mb-legend__mark" aria-hidden="true">
                    <span class="mb-dash" />
                  </span>
                  <span>No public figure for that model: we never estimate one.</span>
                </li>
              )}
            </ul>
          </section>

          {/* ===== What each benchmark measures (a kind without one yet has no card:
                 its scores card already says the scores are being collected) ===== */}
          {p.benchmarks.length > 0 && (
            <section class="mb-card" data-mb-reveal>
              <header class="mb-card__head">
                <div>
                  <h2 class="mb-card__title">What the benchmarks measure</h2>
                  {p.kind === 'text' && (
                    <p class="mb-card__desc">
                      A high score on one test does not make a model better at everything. For
                      marketing copy, look first at the overall index and the arena, where people
                      vote for the answers they prefer.
                    </p>
                  )}
                </div>
              </header>
              <dl class="mb-sources">
                {p.benchmarks.map((b) => (
                  <div class="mb-source">
                    <dt data-no-i18n>{b.name}</dt>
                    <dd>
                      <p data-no-i18n>{localized(b.measures, b.i18n?.measures)}</p>
                      <p class="mb-source__from">
                        <a href={b.sourceUrl} target="_blank" rel="noopener" data-no-i18n>
                          {b.sourceName}
                        </a>
                        {b.note && (
                          <span data-no-i18n>
                            {' · '}
                            {localized(b.note, b.i18n?.note)}
                          </span>
                        )}
                      </p>
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
        </div>
      ))}
    </div>

    <DualCta
      eyebrow="Next step"
      pre="Put the three choices to "
      accent="work"
      post="."
      text="Create your account and open any text feature: the model list starts on Quick, Balanced and Best. Creating an account costs nothing, and you pay only for what you run."
    />
  </div>
</Layout>

