        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Dash cam web page</th>
          <td>A stock night photo with number plates added, read as footage from the cameras sold</td>
          <td>UK advertising regulator, 5 June 2024</td>
        </tr>
        <tr>
          <th scope="row">Portable cooler display ad</th>
          <td>"Cool Any Room in Seconds," with no evidence supplied</td>
          <td>UK advertising regulator, 26 November 2025</td>
        </tr>
        <tr>
          <th scope="row">Robot toy ad</th>
          <td>Footage appearing to show real or AI-generated puppies implied a highly realistic toy</td>
          <td>UK advertising regulator, 25 March 2026</td>
        </tr>
        <tr>
          <th scope="row">Televised shaving demonstration</th>
          <td>Plexiglass in place of sandpaper, undisclosed, presented as proof viewers could see</td>
          <td>US Supreme Court, 5 April 1965</td>
        </tr>
      </tbody>
    </table>
