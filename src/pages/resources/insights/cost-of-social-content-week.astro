    <table>
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col">The week</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Posts</th>
          <td>10, captions written</td>
        </tr>
        <tr>
          <th scope="row">Networks</th>
          <td>4: LinkedIn, Instagram, Facebook, TikTok</td>
        </tr>
        <tr>
          <th scope="row">Still visuals</th>
          <td>8 posts with a designed picture or carousel</td>
        </tr>
        <tr>
