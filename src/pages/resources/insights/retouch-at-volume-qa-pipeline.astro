        </tr>
        <tr>
          <th scope="row">3,201 to 10,000</th>
          <td>L</td>
          <td>200 checked, accept 5, reject 6</td>
          <td>200 checked, accept 10, reject 11</td>
          <td>200 checked, accept 14, reject 15</td>
        </tr>
        <tr>
          <th scope="row">10,001 to 35,000</th>
          <td>M</td>
          <td>315 checked, accept 7, reject 8</td>
