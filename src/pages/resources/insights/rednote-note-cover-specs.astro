          <th scope="col">Most published value</th>
          <th scope="col">Spread across sources</th>
          <th scope="col">Sources agreeing</th>
          <th scope="col">Confidence</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Default cover ratio</th>
          <td>3:4 vertical</td>
          <td>1:1 and 4:3 named as alternates, never as default</td>
          <td>14 of 14</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Cover size at 3:4</th>
          <td>1080 by 1440</td>
          <td>A 1242-pixel-wide variant on three sources</td>
          <td>13</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Square alternate</th>
          <td>1080 by 1080</td>
          <td>Unanimous where a square size is given</td>
          <td>7</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Landscape alternate</th>
