          <th scope="col">Spread across sources</th>
          <th scope="col">Sources agreeing</th>
          <th scope="col">Confidence</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Sign band, total height</th>
          <td>150 pixels</td>
          <td>Split 120 and 30 on most, 130 and 20 on one</td>
          <td>5 of 5</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Store sign height</th>
          <td>120 pixels</td>
          <td>None beyond the split above</td>
          <td>4 of 5</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Store sign width, standard</th>
          <td>950 pixels</td>
          <td>None</td>
          <td>6 of 6</td>
          <td>consensus</td>
        </tr>
        <tr>
          <th scope="row">Store sign width, Tmall</th>
          <td>990 pixels</td>
          <td>No source newer than 2023</td>
          <td>3 of 3</td>
          <td>contested</td>
        </tr>
        <tr>
          <th scope="row">Full-width sign background</th>
          <td>1920 by 150</td>
