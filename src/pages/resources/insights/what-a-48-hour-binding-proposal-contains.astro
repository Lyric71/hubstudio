    <table>
      <thead>
        <tr>
          <th scope="col">Document</th>
          <th scope="col">What it commits the supplier to</th>
          <th scope="col">How the price can move</th>
          <th scope="col">When a buyer should want it</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Binding proposal or firm bid</th>
          <td>The price for the scope it names</td>
          <td>Only through an approved change to that scope</td>
          <td>The deliverables can be specified now</td>
        </tr>
        <tr>
          <th scope="row">Estimate or cost-plus</th>
          <td>A forecast, with actual costs billed</td>
          <td>With actual costs, up to any agreed ceiling</td>
          <td>Scope depends on something still unknown</td>
        </tr>
        <tr>
          <th scope="row">Time and materials</th>
          <td>Hourly rates plus actual materials</td>
