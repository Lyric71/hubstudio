  }
  .model:hover .model__accent { transform: scaleX(1); }
  .model--chatgpt-image-2 { --ma: #0a0a14; }
  .model--nano-banana-2 { --ma: #f5b301; }
  .model--kling { --ma: #ff7a1a; }
