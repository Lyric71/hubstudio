  }

  /* ============================================================
     Scroll reveal
     ============================================================ */
  .reveal {
    opacity: 0;
    transform: translateY(26px);
  }
  .reveal.is-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 620ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 620ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 100ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .hero__eyebrow-dot,
    .hero__cue-dot {
      animation: none !important;
    }
    .progress__bar { transition: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- Reading progress bar ------------------------------------ */
  const bar = document.getElementById('progress-bar');
  const onScrollProgress = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const pct = max > 0 ? (doc.scrollTop / max) * 100 : 0;
    if (bar) bar.style.width = `${pct}%`;
  };
  onScrollProgress();
  window.addEventListener('scroll', onScrollProgress, { passive: true });

  /* ---- Scroll reveal ------------------------------------------- */
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window && !reduceMotion) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }

  /* ---- Count-up stats ------------------------------------------ */
  const nums = document.querySelectorAll<HTMLElement>('.stat__num');
  if ('IntersectionObserver' in window && !reduceMotion) {
    nums.forEach((el) => (el.textContent = '0'));
    const countIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          countIO.unobserve(el);
          const target = Number(el.dataset.countTo || '0');
          const start = performance.now();
          const dur = 1100;
          const tick = (now: number) => {
            const t = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = String(Math.round(eased * target));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.6 },
    );
    nums.forEach((el) => countIO.observe(el));
  }

  /* ---- Hero parallax ------------------------------------------- */
  const heroImg = document.querySelector<HTMLElement>('.hero__img');
  const heroFrame = document.querySelector<HTMLElement>('.hero__frame');
  if (heroImg && heroFrame && !reduceMotion) {
    let ticking = false;
    const parallax = () => {
      const y = window.scrollY;
      heroImg.style.transform = `translate3d(0, ${y * 0.06}px, 0) scale(1.06)`;
      heroFrame.style.transform = `translate3d(0, ${y * -0.02}px, 0)`;
      ticking = false;
    };
    parallax();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(parallax);
          ticking = true;
        }
      },
      { passive: true },
    );
  }

  /* ---- Sticky toolbar shadow ----------------------------------- */
  const glBar = document.getElementById('gl-bar');
  if (glBar) {
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;height:1px;width:1px;';
    glBar.parentElement?.insertBefore(sentinel, glBar);
    new IntersectionObserver(
      ([e]) => glBar.classList.toggle('is-stuck', !e.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }

  /* ---- A-Z scroll-spy ------------------------------------------ */
  const azLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.gl-az__link').forEach((link) => {
    const letter = link.dataset.letter;
    if (letter) azLinks.set(letter.toLowerCase(), link);
  });
  const letterSections = Array.from(document.querySelectorAll<HTMLElement>('.gl-letter'));
  if ('IntersectionObserver' in window && letterSections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = azLinks.get(entry.target.id);
          if (link && entry.isIntersecting) {
            azLinks.forEach((l) => l.classList.remove('is-active'));
            link.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-200px 0px -64% 0px', threshold: 0 },
    );
    letterSections.forEach((section) => spy.observe(section));
  }

  /* ---- Live glossary filter ------------------------------------ */
  const search = document.getElementById('gl-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('gl-clear');
  const countEl = document.getElementById('gl-count');
  const emptyEl = document.getElementById('gl-empty');
  const terms = Array.from(document.querySelectorAll<HTMLElement>('.gl-term'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.gl-letter'));
  const total = terms.length;

  const applyFilter = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let shown = 0;
    terms.forEach((term) => {
      const hit = q === '' || (term.dataset.search || '').includes(q);
      term.classList.toggle('is-hidden', !hit);
      if (hit) shown += 1;
    });
    groups.forEach((group) => {
      const visible = group.querySelectorAll('.gl-term:not(.is-hidden)').length > 0;
      group.classList.toggle('is-hidden', !visible);
      const link = azLinks.get(group.id);
      if (link) link.classList.toggle('is-disabled', !visible);
    });
    if (countEl) countEl.textContent = q ? `${shown} of ${total}` : `${total} terms`;
    if (emptyEl) emptyEl.hidden = shown > 0;
    if (clearBtn) clearBtn.hidden = q === '';
  };

  search?.addEventListener('input', applyFilter);
  clearBtn?.addEventListener('click', () => {
    if (search) {
      search.value = '';
      search.focus();
    }
    applyFilter();
  });
</script>
