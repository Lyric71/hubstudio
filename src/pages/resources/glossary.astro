              <span class="model__accent" aria-hidden="true"></span>
              <div class="model__head">
                <span class="model__logo" aria-hidden="true">{model.name.charAt(0)}</span>
                <div>
                  <h4 class="model__name">{model.name}</h4>
                  <p class="model__meta">{model.meta}</p>
                </div>
              </div>
              {model.body.map((p) => (
                <p class="model__p">{p}</p>
              ))}
            </article>
          ))}
        </div>
      </div>

      <div class="models__group">
        <h3 class="models__group-head"><span>Video models</span></h3>
        <div class="models__grid">
          {videoModels.map((model, i) => (
            <article
              class={`model card model--${model.id} reveal`}
              id={model.id}
              style={`--i:${i}`}
