/* ---- Schema ------------------------------------------------------ */
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const termSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'The hubStudio AIGC Glossary',
  description:
    'Plain-English definitions of 30+ AI content terms every brand team should know in 2026.',
  url,
  hasDefinedTerm: glossary.flatMap((g) =>
    g.entries.map((e) => ({
      '@type': 'DefinedTerm',
      name: e.term,
      description: stripHtml(e.body.find((b) => b.p)?.p ?? '').slice(0, 320),
      url: `${url}#${e.id}`,
      inDefinedTermSet: url,
    })),
  ),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Resources', item: `${SITE}/resources` },
    { '@type': 'ListItem', position: 2, name: 'Glossary', item: url },
  ],
};
