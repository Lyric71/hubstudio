          <div class="stat">
            <span class="stat__num" data-count-to={termCount}>{termCount}</span>
            <span class="stat__label">Terms defined</span>
          </div>
          <div class="stat">
            <span class="stat__num" data-count-to="4">4</span>
            <span class="stat__label">Models for 2026</span>
          </div>
          <div class="stat">
            <span class="stat__num" data-count-to="9">9</span>
            <span class="stat__label">Minute read</span>
          </div>
        </div>
        <p class="hero__meta hero-in">
          Last reviewed: May 19, 2026. Next review: August 2026.
