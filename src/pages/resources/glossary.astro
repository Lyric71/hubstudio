/**
 * The hubStudio AIGC Glossary (`/resources/glossary`).
 * Plain-English definitions of AI content terms for brand teams.
 * Sections: Hero · Why this glossary exists · Glossary explorer (live filter
 * + A-Z) · Models · A note for marketers · Closing CTA.
 *
 * Glossary entries are data-driven: each `body` block is either
 * `{ p }` (paragraph, may carry inline <strong> labels and <a> cross-links,
 * rendered with set:html) or `{ quote, cite }` (pull quote).
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const SITE = 'https://hubstudio.ai';
const url = `${SITE}/resources/glossary`;

/* ---- Glossary, grouped by letter --------------------------------- */
type Block = { p?: string; quote?: string; cite?: string };
type Entry = { id: string; term: string; body: Block[] };
type LetterGroup = { letter: string; intro?: string; entries: Entry[] };

const glossary: LetterGroup[] = [
  {
    letter: 'A',
    entries: [
      {
