  }
  @media (max-width: 560px) {
    .note { padding: 38px 28px; }
  }
  .note__quote {
    position: absolute;
    top: 14px;
    right: 30px;
    font-family: var(--font-serif);
    font-size: 140px;
    line-height: 1;
    color: rgba(233, 78, 27, 0.12);
    pointer-events: none;
  }
  .note__eyebrow {
    color: var(--brand-orange);
  }
  .note__lead {
    position: relative;
    margin-top: 18px;
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-ink);
  }
  .note__p {
    margin-top: 16px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }

  /* ============================================================
     Closing CTA
     ============================================================ */
  .cta-sec {
    padding-block: 32px 88px;
  }
  .cta {
    position: relative;
    max-width: 960px;
    margin-inline: auto;
    padding: 60px 48px;
    border-radius: var(--radius-card);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 18px;
    overflow: hidden;
    background: linear-gradient(140deg, var(--brand-orange), var(--brand-orange-deep));
    color: #fff;
    box-shadow: 0 34px 70px -26px rgba(233, 78, 27, 0.6);
  }
  @media (max-width: 560px) {
    .cta { padding: 44px 26px; }
  }
  .cta__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(380px 240px at 16% 0%, rgba(255, 255, 255, 0.3), transparent 70%),
      radial-gradient(420px 300px at 100% 100%, rgba(14, 22, 51, 0.34), transparent 70%);
  }
  .cta > :not(.cta__glow) { position: relative; }
  .cta__eyebrow {
    color: rgba(255, 255, 255, 0.78);
  }
  .cta__head {
    max-width: 18ch;
  }
  .cta__head .accent { color: #fff; }
  .cta__line {
    max-width: 52ch;
