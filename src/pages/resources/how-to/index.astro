---
/**
 * /resources/how-to: the How-to guides index.
 * Hero + featured lead guide + card grid. All entries from
 * src/data/howtos.ts (newest first). No ordinal numerals on cards.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import { howtos } from '../../../data/howtos';

const [featured, ...rest] = howtos;

const SITE = 'https://www.hubstudio.ai';
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'hubStudio How-to Guides',
  description:
    'Practical, step by step guides for AI-native content production: image editing, decks, AI search, and the systems behind them.',
  url: `${SITE}/resources/how-to`,
  // Article, not HowTo: Google retired HowTo rich results in 2023. Matches the
  // type each guide emits from HowtoLayout.astro.
  hasPart: howtos.map((h) => ({
    '@type': 'Article',
    name: h.title,
    description: h.metaDescription,
    datePublished: h.dateISO,
    author: { '@type': 'Person', name: h.author },
    url: `${SITE}/resources/how-to/${h.slug}`,
  })),
};
---

<Layout
  title="How-to Guides: AI Content Production | hubStudio"
  description="Practical, step by step guides for AI-native content production. Image editing with Nano Banana Pro, decks with NotebookLM, and content systems for AI search."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <!-- ===== Hero ===== -->
  <section class="section hero">
    <div class="container hero__inner">
      <span class="eyebrow">Resources &middot; How-to</span>
      <h1 class="headline h1 reveal hero__title">
        Practical guides for an <span class="accent">AI-native</span> content team.
      </h1>
      <p class="lead hero__lead">
        Working how-to for the tools and workflows shaping content production right now.
        Each guide is built from real client work, with the prompts, QA checks, and
        brand-safe shipping layer that turn a model into a method.
      </p>
    </div>
  </section>

  <!-- ===== Featured lead ===== -->
  <section class="section--tight">
    <div class="container">
      <a class={`feat card card--white feat--${featured.tone}`} href={`/resources/how-to/${featured.slug}`}>
        <img
          class="feat__img"
          src={featured.image}
          alt={featured.imageAlt}
          width="2000"
          height="1333"
          loading="eager"
        />
        <div class="feat__body">
          <span class="chip feat__tag">
            <span class="feat__flag">Latest</span>{featured.category}
          </span>
          <h2 class="headline h2 feat__title">{featured.title}</h2>
          <p class="lead feat__deck">{featured.deck}</p>
          <p class="feat__meta">
            <span>{featured.author}</span>
            <span class="feat__dot" aria-hidden="true"></span>
            <time datetime={featured.dateISO}>{featured.date}</time>
            <span class="feat__dot" aria-hidden="true"></span>
            <span>{featured.readingTime}</span>
          </p>
          <span class="feat__cta">Read guide &rarr;</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===== Grid ===== -->
  <section class="section--grid">
    <div class="container">
      <header class="grid-head">
        <span class="eyebrow">The collection</span>
        <h2 class="headline h3">More how-to.</h2>
      </header>
      <div class="grid">
        {
          rest.map((item) => (
            <a class="icard card card--white" href={`/resources/how-to/${item.slug}`}>
              <img
                class="icard__img"
                src={item.image}
                alt={item.imageAlt}
                width="2000"
                height="1333"
                loading="lazy"
              />
              <span class="icard__body">
                <span class={`chip icard__tag icard__tag--${item.tone}`}>{item.category}</span>
                <h3 class="icard__title">{item.title}</h3>
                <p class="icard__deck">{item.deck}</p>
                <p class="icard__meta">
                  <time datetime={item.dateISO}>{item.date}</time>
                  <span class="icard__dot" aria-hidden="true"></span>
                  <span>{item.readingTime}</span>
                </p>
                <span class="icard__more">Read guide &rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Closing CTA ===== -->
  <section class="closing">
    <div class="container closing__inner">
      <span class="eyebrow">From guide to production</span>
      <h2 class="headline h2 reveal closing__head">
        Want this <span class="accent">running for your brand</span>?
      </h2>
      <p class="closing__text">
        hubStudio sets up the lane end-to-end: source pack design, prompt libraries, brand
        templates, QA rules, and the production workflows that make AI content work at scale.
      </p>
      <Button variant="primary" href="/contact">Talk to us</Button>
      <p class="closing__line">hello@hubstudio.ai</p>
    </div>
  </section>
</Layout>

<script>
  /* Reveal headlines on scroll (§10: headlines only). */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>

<style>
  .section--tight {
    padding-block: 0;
  }
  .section--grid {
    padding-block: 72px 112px;
  }

  /* ---- Hero ---- */
  .hero {
    padding-bottom: 56px;
  }
  .hero__inner {
    max-width: 880px;
  }
  .hero__title {
    margin-top: 20px;
  }
  .hero__lead {
    margin-top: 24px;
    max-width: 62ch;
  }

  /* ---- Featured lead ---- */
  .feat {
    display: block;
    border-left: 3px solid var(--brand-orange);
    transition: transform 200ms ease-out;
  }
  .feat--navy {
    border-left-color: var(--brand-navy);
  }
  .feat:hover {
    transform: translateY(-4px);
  }
  .feat__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .feat__body {
    padding: 44px;
  }
  @media (max-width: 600px) {
    .feat__body {
      padding: 32px 24px;
    }
  }
  @media (min-width: 860px) {
    .feat {
      display: grid;
      grid-template-columns: 0.92fr 1.08fr;
      align-items: stretch;
    }
    .feat__img {
      height: 100%;
      aspect-ratio: auto;
    }
    .feat__body {
      padding: 52px;
      align-self: center;
    }
  }
  .feat__tag {
    gap: 10px;
    background: rgba(233, 78, 27, 0.1);
    color: var(--brand-orange);
  }
  .feat__flag {
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .feat__title {
    margin-top: 20px;
    font-size: clamp(28px, 3.6vw, 44px);
  }
  .feat__deck {
    margin-top: 16px;
    max-width: 56ch;
  }
  .feat__meta,
  .icard__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-mute);
  }
  .feat__meta {
    margin-top: 22px;
  }
  .feat__dot,
  .icard__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .feat__cta {
    display: inline-block;
    margin-top: 22px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }

  /* ---- Grid ---- */
  .grid-head {
    display: grid;
    gap: 10px;
    margin-bottom: 36px;
  }
  .grid {
    display: grid;
    gap: var(--gap-card);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .icard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 30px;
    transition: transform 200ms ease-out;
  }
  .icard:hover {
    transform: translateY(-4px);
  }
  .icard__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 8px;
  }
  .icard__tag--orange {
    background: rgba(233, 78, 27, 0.1);
    color: var(--brand-orange);
  }
  .icard__tag--navy {
    background: rgba(30, 58, 138, 0.1);
    color: var(--brand-navy);
  }
  .icard__title {
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .icard__deck {
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .icard__meta {
    font-size: 11px;
  }
  .icard__more {
    margin-top: auto;
    padding-top: 6px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }

  /* ---- Closing CTA ---- */
  .closing {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .closing__inner {
    text-align: center;
    padding-block: var(--section-pad-y-mobile);
    display: grid;
    justify-items: center;
    gap: 20px;
  }
  @media (min-width: 768px) {
    .closing__inner {
      padding-block: var(--section-pad-y-desktop);
    }
  }
  .closing .eyebrow {
    color: rgba(240, 237, 233, 0.6);
  }
  .closing__head {
    max-width: 22ch;
  }
  .closing__text {
    max-width: 58ch;
    font-size: var(--type-small);
    line-height: 1.6;
    color: rgba(240, 237, 233, 0.78);
  }
  .closing__line {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.55);
  }
</style>
