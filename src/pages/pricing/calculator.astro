  }

  .pc-disclaimer {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 20px;
    background: #fdf4ee;
    border: 1px solid var(--brand-orange);
    border-radius: var(--radius-card);
    padding: 16px 20px;
  }
  .pc-disclaimer-mark {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-orange-deep);
    padding-top: 2px;
    flex: none;
  }
  .pc-disclaimer p {
    font-size: var(--type-body);
    line-height: 1.6;
  }

  .pc-actions {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
  }

  /* --- Good to know --- */
  .pc-know {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 800px) {
    .pc-know {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 48px;
    }
  }
  .pc-know-h {
    font-size: var(--type-body);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .pc-know-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pc-know-item {
    position: relative;
    padding-left: 18px;
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
  }
  .pc-know-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
