  }

  /* --- Print: the quotation, nothing else --- */
  @media print {
    .pc-shell {
      padding-top: 24px;
      background: #fff;
    }
    .pc-actions {
      display: none;
    }
    .pc-option:not([data-selected='true']),
    .pc-tr[data-ignored='true'] {
      display: none;
    }
    .pc-table,
    .pc-option {
      break-inside: avoid;
      box-shadow: none;
    }
    .pc-input {
      border: none;
      padding-left: 0;
      background-image: none;
    }
  }
</style>

<script>
  /**
   * The UI layer: read the controls, hand them to the pricing core, write the
   * numbers back. All money math lives in src/lib/pricing, never here, so the
   * browser and the server can never disagree about a price.
   *
   * The grid is the one piece of real UI state: it grows with the image count
   * and keeps rows that fall past it, so shrinking an order and growing it again
   * does not throw away what the client typed.
   */
  import {
    COMPLEXITIES,
    ORDER_ADDONS,
    PER_IMAGE_ADDONS,
    PRICING,
    type PricingConfig,
  } from '../../lib/pricing/config';
  import {
    computeQuote,
    convert,
    emptyOrderAddons,
    emptyRow,
    type ImageRow,
    type QuoteInputs,
  } from '../../lib/pricing/quote';
  import {
    VIDEO_ADDONS,
    VIDEO_PRICING,
    type MasterFormat,
    type VideoPricingConfig,
  } from '../../lib/pricing/video-config';
  import {
    computeVideoQuote,
    emptyVideoAddOns,
    type VideoQuoteInputs,
  } from '../../lib/pricing/video-quote';
  import {
    DEFAULT_CURRENCY,
    formatMoney,
    formatMultiplier,
    formatUnit,
    isCurrency,
    type Currency,
  } from '../../lib/pricing/format';

  /**
   * The rates the server priced with: defaults, plus saved settings, plus the
   * live exchange rate. Parsed from the page rather than imported, so the client
   * uses the same numbers the server just used instead of the compiled-in
   * defaults. If the element is missing or unreadable, fall back to the defaults,
   * because a working calculator beats a blank one.
   */
  function readConfigs(): { image: PricingConfig; video: VideoPricingConfig } {
    const el = document.querySelector<HTMLScriptElement>('#pc-config');
    if (!el?.textContent) return { image: PRICING, video: VIDEO_PRICING };
    try {
      const parsed = JSON.parse(el.textContent) as {
        image: PricingConfig;
        video: VideoPricingConfig;
      };
      return { image: parsed.image ?? PRICING, video: parsed.video ?? VIDEO_PRICING };
    } catch {
      return { image: PRICING, video: VIDEO_PRICING };
    }
  }

  const CONFIG = readConfigs();

  const tool = document.querySelector<HTMLElement>('.pc-tool');
  if (tool) {
    const imagesInput = document.querySelector<HTMLInputElement>('#pc-images');
    const deliverySelect = document.querySelector<HTMLSelectElement>('#pc-delivery');
    const amSelect = document.querySelector<HTMLSelectElement>('#pc-am');
    const currencySelect = document.querySelector<HTMLSelectElement>('#pc-currency');
    const gridBody = document.querySelector<HTMLElement>('[data-grid-body]');
    const productionNote = document.querySelector<HTMLElement>('[data-production-note]');

    /** The one currency every price on the page is displayed in. */
    function readCurrency(): Currency {
      return isCurrency(currencySelect?.value) ? currencySelect.value : DEFAULT_CURRENCY;
    }

    /** How many images the client has asked for, floored at the MOQ. */
    function imageCount(): number {
      const moq = CONFIG.image.minimumImages;
      const n = Math.floor(Number(imagesInput?.value));
      return Number.isFinite(n) && n >= moq ? n : moq;
    }

    /** One grid row, built to the same shape the server renders. */
    function buildRow(index: number): HTMLElement {
      const row = document.createElement('div');
      row.className = 'pc-tr';
      row.setAttribute('role', 'row');
      row.dataset.row = String(index);

      const name = document.createElement('span');
      name.className = 'pc-td pc-td--name';
      name.setAttribute('role', 'cell');
      name.innerHTML = `<span class="pc-addon-name">Image ${index + 1}</span>`;
      row.appendChild(name);

      const complexityCell = document.createElement('span');
      complexityCell.className = 'pc-td';
      complexityCell.setAttribute('role', 'cell');
      complexityCell.dataset.head = 'Complexity';
      const select = document.createElement('select');
      select.className = 'pc-input pc-select pc-select--sm';
      select.dataset.cell = `${index}.complexity`;
      select.setAttribute('aria-label', `Image ${index + 1}, complexity`);
      for (const level of COMPLEXITIES) {
        const option = document.createElement('option');
        option.value = level.id;
        option.textContent = `${level.id} (${formatMultiplier(level.multiplier)})`;
        select.appendChild(option);
      }
      complexityCell.appendChild(select);
      row.appendChild(complexityCell);

      for (const addon of PER_IMAGE_ADDONS) {
        const cell = document.createElement('span');
        cell.className = 'pc-td pc-num';
        cell.setAttribute('role', 'cell');
        cell.dataset.head = addon.label;
        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'pc-input pc-input--qty';
        input.min = '0';
        input.step = '1';
        input.value = '0';
        input.dataset.cell = `${index}.${addon.id}`;
        input.setAttribute('aria-label', `Image ${index + 1}, ${addon.label}`);
        cell.appendChild(input);
        row.appendChild(cell);
      }

      for (const [key, head] of [
        ['production', 'Production'],
        ['rowaddons', 'Add-ons'],
      ] as const) {
        const cell = document.createElement('span');
        cell.className = 'pc-td pc-num pc-td--line';
        cell.setAttribute('role', 'cell');
        cell.dataset.head = head;
        cell.dataset[key] = String(index);
        cell.textContent = '-';
        row.appendChild(cell);
      }

      return row;
    }

    /** Grow the grid to cover the image count. Rows are never deleted: one that
     *  falls past the count is greyed out and excluded, but keeps its values. */
    function syncRows(): void {
      if (!gridBody) return;
      const needed = imageCount();
      for (let i = gridBody.querySelectorAll('[data-row]').length; i < needed; i++) {
        gridBody.appendChild(buildRow(i));
      }
      gridBody.querySelectorAll<HTMLElement>('[data-row]').forEach((row, i) => {
        const ignored = i >= needed;
        row.dataset.ignored = String(ignored);
        row
          .querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')
          .forEach((field) => (field.disabled = ignored));
      });
    }

    /** Current control state, clamped by the core on every read. */
    function readInputs(): QuoteInputs {
      const perImage: ImageRow[] = [];
      document
        .querySelectorAll<HTMLElement>('[data-grid-body] [data-row]')
        .forEach((row, i) => {
          const values = emptyRow();
          const complexity = row.querySelector<HTMLSelectElement>(
            `[data-cell="${i}.complexity"]`,
          );
          values.complexity = (complexity?.value ?? 'Low') as ImageRow['complexity'];
          for (const addon of PER_IMAGE_ADDONS) {
            const input = row.querySelector<HTMLInputElement>(
              `[data-cell="${i}.${addon.id}"]`,
            );
            values[addon.id] = Number(input?.value ?? 0);
          }
          perImage.push(values);
        });

      const orderAddons = emptyOrderAddons();
      for (const addon of ORDER_ADDONS) {
        const input = document.querySelector<HTMLInputElement>(
          `[data-order="${addon.id}"]`,
        );
        orderAddons[addon.id] = Number(input?.value ?? 0);
      }

      return {
        numberOfImages: Number(imagesInput?.value ?? CONFIG.image.minimumImages),
        deliveryOption: deliverySelect?.value === 'B' ? 'B' : 'A',
        perImage,
        orderAddons,
        dedicatedAccountManager: amSelect?.value === 'yes',
      };
    }

    function render(): void {
      syncRows();
      const quote = computeQuote(readInputs(), CONFIG.image);
      const currency = readCurrency();
      renderVideo(currency);
      const money = {
        imageProduction: quote.imageProduction,
        optionalAddOns: quote.optionalAddOns,
        productShot: quote.productShot,
        retouch: quote.retouch,
        postProduction: quote.postProduction,
        accountManagerUplift: quote.accountManagerUplift,
        total: quote.total,
        basePerImageA: quote.basePerImage.A,
        basePerImageB: quote.basePerImage.B,
        designerHour: convert(CONFIG.image.designerHour, CONFIG.image),
      };

      document.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
        const value = money[(el.dataset.out ?? '') as keyof typeof money];
        if (value) el.textContent = formatMoney(value, currency);
      });

      for (const line of quote.imageLines) {
        const production = document.querySelector<HTMLElement>(
          `[data-production="${line.index}"]`,
        );
        if (production) production.textContent = formatMoney(line.production, currency);
        const addOns = document.querySelector<HTMLElement>(
          `[data-rowaddons="${line.index}"]`,
        );
        if (addOns) addOns.textContent = formatMoney(line.addOns, currency);
      }

      for (const line of quote.orderLines) {
        const unit = document.querySelector<HTMLElement>(`[data-unit="${line.spec.id}"]`);
        if (unit) unit.textContent = formatUnit(line.unit, currency, line.onRequest);
        const cell = document.querySelector<HTMLElement>(
          `[data-orderline="${line.spec.id}"]`,
        );
        if (cell) {
          cell.textContent = line.onRequest
            ? 'On request'
            : formatMoney(line.line, currency);
        }
      }

      // Column headers name the currency they are showing.
      document.querySelectorAll<HTMLElement>('[data-currency-label]').forEach((el) => {
        el.textContent = currency;
      });

      // The chosen option colors its card and explains the production line.
      const selected = quote.inputs.deliveryOption;
      document.querySelectorAll<HTMLElement>('.pc-option').forEach((card) => {
        card.dataset.selected = String(card.dataset.option === selected);
      });
      if (productionNote) {
        const n = quote.inputs.numberOfImages;
        const images = n === 1 ? '1 image' : `${n} images`;
        productionNote.textContent = `${images}, Option ${selected}, each priced at its own complexity`;
      }

      // A rejected value (below the MOQ, a negative quantity) is corrected in
      // place, so what the client sees is always what was priced.
      if (imagesInput && Number(imagesInput.value) !== quote.inputs.numberOfImages) {
        imagesInput.value = String(quote.inputs.numberOfImages);
      }
      document
        .querySelectorAll<HTMLInputElement>('[data-cell], [data-order]')
        .forEach((input) => {
          if (input.type === 'number' && input.value !== '' && Number(input.value) < 0) {
            input.value = '0';
          }
        });
    }

    /* --- Product video ---------------------------------------------------- */

    const videosInput = document.querySelector<HTMLInputElement>('#pv-videos');
    const lengthInput = document.querySelector<HTMLInputElement>('#pv-length');
    const vComplexity = document.querySelector<HTMLSelectElement>('#pv-complexity');
    const vFormat = document.querySelector<HTMLSelectElement>('#pv-format');

    /** Video control state, clamped by the video core on every read. */
    function readVideoInputs(): VideoQuoteInputs {
      const addOns = emptyVideoAddOns();
      for (const addon of VIDEO_ADDONS) {
        const input = document.querySelector<HTMLInputElement>(
          `[data-vaddon="${addon.id}"]`,
        );
        addOns[addon.id] = Number(input?.value ?? 0);
      }
      return {
        numberOfVideos: Number(videosInput?.value ?? 1),
        videoLengthSeconds: Number(
          lengthInput?.value ?? CONFIG.video.defaultLengthSeconds,
        ),
        complexity: (vComplexity?.value ?? 'Low') as VideoQuoteInputs['complexity'],
        masterFormat: (vFormat?.value ?? '16:9') as MasterFormat,
        addOns,
      };
    }

    /** Write one text node by its data-vout-text key. */
    function setText(key: string, value: string): void {
      const el = document.querySelector<HTMLElement>(`[data-vout-text="${key}"]`);
      if (el) el.textContent = value;
    }

    function renderVideo(currency: Currency): void {
      if (!videosInput) return;
      const quote = computeVideoQuote(readVideoInputs(), CONFIG.video);
      const money = {
        creativeSubtotal: quote.creativeSubtotal,
        productionSubtotal: quote.productionSubtotal,
        basePerVideo: quote.basePerVideo,
        adjustedPerVideo: quote.adjustedPerVideo,
        videoProduction: quote.videoProduction,
        addOnsTotal: quote.addOnsTotal,
        total: quote.total,
      };

      document.querySelectorAll<HTMLElement>('[data-vout]').forEach((el) => {
        const value = money[(el.dataset.vout ?? '') as keyof typeof money];
        if (value) el.textContent = formatMoney(value, currency);
      });

      // The itemized lines: each carries its own label, its own explanation of
      // how it was arrived at, and its amount.
      const parts = [
        ['creative', quote.creativeLines],
        ['production', quote.productionLines],
      ] as const;
      for (const [part, lines] of parts) {
        lines.forEach((line, i) => {
          const amount = document.querySelector<HTMLElement>(
            `[data-vitem="${part}.${i}"]`,
          );
          if (amount) amount.textContent = formatMoney(line.amount, currency);
          const detail = document.querySelector<HTMLElement>(
            `[data-vdetail="${part}.${i}"]`,
          );
          if (detail) detail.textContent = line.detail;
          const label = document.querySelector<HTMLElement>(
            `[data-vlabel="${part}.${i}"]`,
          );
          if (label) label.textContent = line.label;
        });
      }

      for (const line of quote.addOnLines) {
        const unit = document.querySelector<HTMLElement>(`[data-vunit="${line.spec.id}"]`);
        if (unit) unit.textContent = formatMoney(line.unit, currency);
        const cell = document.querySelector<HTMLElement>(`[data-vline="${line.spec.id}"]`);
        if (cell) cell.textContent = formatMoney(line.line, currency);
      }

      // The derived structure: how many shots the length just bought.
      const seconds = quote.inputs.videoLengthSeconds;
      const videos = quote.inputs.numberOfVideos;
      setText('length', `${seconds} seconds`);
      setText('sequences', String(quote.sequences));
      setText(
        'sequencesNote',
        `${seconds} seconds divided by ${CONFIG.video.averageSecondsPerSequence}, rounded up`,
      );
      setText(
        'complexityNote',
        `${quote.inputs.complexity}, ${formatMultiplier(quote.complexityMultiplier)}`,
      );
      setText(
        'videosNote',
        `${videos === 1 ? '1 video' : `${videos} videos`}, at the price above`,
      );

      // Rejected values are corrected in place, so what is shown is what was
      // priced.
      if (Number(videosInput.value) !== videos) videosInput.value = String(videos);
      if (lengthInput && Number(lengthInput.value) !== seconds) {
        lengthInput.value = String(seconds);
      }
      document
        .querySelectorAll<HTMLInputElement>('[data-vaddon]')
        .forEach((input) => {
          if (input.value !== '' && Number(input.value) < 0) input.value = '0';
        });
    }

    // Tabs: both panels are server-rendered, so switching is a visibility flip.
    // Nothing is recomputed and nothing is refetched.
    const tabs = document.querySelectorAll<HTMLButtonElement>('.pc-tab');
    const panels = document.querySelectorAll<HTMLElement>('.pc-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) =>
          t.setAttribute('aria-selected', String(t.dataset.tab === target)),
        );
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== target;
        });
      });
    });

    tool.addEventListener('input', render);
    tool.addEventListener('change', render);
    document
      .querySelector<HTMLButtonElement>('[data-print]')
      ?.addEventListener('click', () => window.print());

    render();
  }
</script>
