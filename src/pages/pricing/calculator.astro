---
/**
 * Product image quotation calculator (`/pricing/calculator`).
 *
 * Hidden and password-gated: not in the nav, not in the sitemap, noindexed,
 * disallowed in robots.txt. Server-rendered on demand so the gate is real
 * (signed httpOnly cookie via /api/pricing/login); the rest of the site stays
 * static.
 *
 * The money lives in src/lib/pricing. The same pure module computes the quote
 * here on the server (so the page is correct on first paint and without JS) and
 * again in the browser on every keystroke. Nothing is persisted: no quote ever
 * leaves the visitor's machine.
 *
 * Internal cost mechanics (labor hours, hourly rates, token cost) are never
 * rendered. Client prices only.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { isAuthed } from '../../lib/pricing-gate';
import {
  ADDONS,
  DELIVERY_OPTIONS,
  INCLUDED,
  PRICING,
  TERMS,
} from '../../lib/pricing/config';
import { DEFAULT_INPUTS, computeQuote } from '../../lib/pricing/quote';
import {
  CURRENCIES,
  DEFAULT_CURRENCY,
  formatDate,
  formatMoney,
  formatUnit,
  formatUplift,
} from '../../lib/pricing/format';

const authed = await isAuthed(Astro.request);
const loginError = Astro.url.searchParams.get('error') === '1';

// First paint (and the no-JS fallback) shows a real quote, not empty cells.
const quote = computeQuote(DEFAULT_INPUTS);
const today = formatDate(new Date());
const uplift = formatUplift(PRICING.accountManagerUpliftPct);

/** The quotation summary, in the order the client reads it. */
const summaryRows = [
  { id: 'imageProduction', label: 'Image production' },
  { id: 'addons', label: 'Optional add-ons' },
  { id: 'subtotal', label: 'Subtotal' },
  { id: 'accountManagerUplift', label: `Dedicated account manager (${uplift})` },
  { id: 'total', label: 'Total', emphasis: true },
  { id: 'perImage', label: 'Price per finished image' },
] as const;

/** Money by key, so the server render and the browser share one lookup. */
const money = {
  imageProduction: quote.imageProduction,
  addons: quote.addons,
  subtotal: quote.subtotal,
  accountManagerUplift: quote.accountManagerUplift,
  total: quote.total,
  perImage: quote.perImage,
  optionA: quote.optionTotals.A,
  optionB: quote.optionTotals.B,
};

/** Good to know: the assumptions and limits, in plain language. */
const goodToKnow = [
  {
    heading: 'How we make your pictures',
    points: [
      'We make nice pictures of your product shown in fun places and scenes.',
      'First we show you 10 different scene ideas. You pick the one you like best.',
      'Then we put your product into that scene and make it look good.',
      'We tidy up each picture up to 3 times, until it looks right.',
    ],
  },
  {
    heading: 'Two ways to show your product (you choose one)',
    points: [
      'Way A: create the scene and product together with AI. Faster and cheaper. Small details may not be perfect, so the product can look a little different from real life.',
      'Way B: create the scenes first, then place your real product in by hand. The product looks exactly right, but we can only use the exact angle and quality of the photos you send, so scene ideas are simpler. This part is very important.',
    ],
  },
  {
    heading: 'What we need from you',
    points: [
      'Clear, good-quality photos of your product. Dark or blurry photos make good pictures hard.',
      'Tell us what you like when you pick your scene, so we get it right the first time.',
    ],
  },
  {
    heading: "What's included and what costs extra",
    points: [
      'Included every time: 10 scene ideas, 1 finished picture in 1 size, 3 rounds of fixes.',
      'Extra scenes, extra fixes, or extra sizes each cost a little more.',
      'We talk by chat, in English or Chinese. Phone calls plus a dedicated helper add 30%.',
    ],
  },
  {
    heading: 'Honest limits',
    points: [
      'We are creative but not magic. With Way A the product is not a perfect copy; with Way B scenes are simpler.',
      'Your brand and big idea (logos, brand rules, creative direction) come from you.',
      'One product per picture.',
    ],
  },
  {
    heading: 'Money and rules',
    points: [
      'Prices are shown in three currencies: CNY, USD, EUR.',
      'Prices are good for 30 days. Taxes are not included.',
      'To start, you pay half. You pay the other half when your pictures are finished.',
    ],
  },
];
---

<Layout
  title="Product image quotation"
  description="Private quotation tool for hubStudio AIGC product imagery."
  noindex
>
  <section class="pc-shell">
    <div class="container">
      {
        !authed ? (
          <div class="pc-gate">
            <p class="pc-eyebrow">Private</p>
            <h1 class="pc-title">Quotation tool</h1>
            <p class="pc-lead">
              This page is restricted. Enter the access password to build a
              quotation.
            </p>
            <form class="pc-login" method="POST" action="/api/pricing/login">
              <label class="pc-field">
                <span class="pc-label">Password</span>
                <input
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  required
                  autofocus
                  class="pc-input"
                />
              </label>
              {loginError && (
                <p class="pc-error" role="alert">
                  Wrong password. Try again.
                </p>
              )}
              <button type="submit" class="pc-btn">
                Enter
              </button>
            </form>
          </div>
        ) : (
          <div class="pc-tool">
            {/* --- Header --- */}
            <header class="pc-head">
              <div>
                <p class="pc-eyebrow">hubStudio</p>
                <h1 class="pc-title">Product image quotation</h1>
                <p class="pc-lead">
                  Choose how many images you need and how your product goes into
                  the scene. The price updates as you go, in three currencies.
                </p>
              </div>
              <dl class="pc-meta">
                <div class="pc-meta-row">
                  <dt>Date</dt>
                  <dd class="pc-meta-value">{today}</dd>
                </div>
                <div class="pc-meta-row">
                  <dt>Valid for</dt>
                  <dd class="pc-meta-value">{TERMS.validityDays} days</dd>
                </div>
              </dl>
            </header>

            {/* --- Standard scope: what every image already buys, read first. --- */}
            <section class="pc-block" aria-labelledby="pc-h-included">
              <h2 class="pc-block-h" id="pc-h-included">What's included</h2>
              <div class="pc-callout">
                <p class="pc-callout-h">Every price is per finished image</p>
                <p class="pc-callout-p">
                  One final, retouched, delivery-ready picture. Not a draft, not a
                  generation attempt. Every finished image already includes
                  everything below, at no extra cost.
                </p>
              </div>
              <ul class="pc-included">
                {INCLUDED.map((item) => (
                  <li class="pc-included-item">{item}</li>
                ))}
              </ul>
            </section>

            {/* --- Selections --- */}
            <section class="pc-block" aria-labelledby="pc-h-selections">
              <h2 class="pc-block-h" id="pc-h-selections">Your selections</h2>

              <div class="pc-count">
                <label class="pc-label" for="pc-images">
                  How many finished images do you need?
                </label>
                <input
                  type="number"
                  class="pc-input pc-input--count"
                  id="pc-images"
                  name="numberOfImages"
                  min="1"
                  step="1"
                  value={DEFAULT_INPUTS.numberOfImages}
                />
              </div>

              <fieldset class="pc-options">
                <legend class="pc-label">
                  How should your product go into the scene?
                </legend>
                <div class="pc-options-grid">
                  {DELIVERY_OPTIONS.map((option) => (
                    <label
                      class="pc-option"
                      data-option={option.id}
                      data-selected={String(option.id === DEFAULT_INPUTS.deliveryOption)}
                    >
                      <input
                        type="radio"
                        name="deliveryOption"
                        value={option.id}
                        checked={option.id === DEFAULT_INPUTS.deliveryOption}
                        class="pc-radio"
                      />
                      <span class="pc-option-body">
                        <span class="pc-option-name">{option.name}</span>
                        <span class="pc-option-text">{option.summary}</span>
                        <span class="pc-option-caveat">{option.caveat}</span>
                        <span class="pc-option-total">
                          <span class="pc-option-total-label">Total for this option</span>
                          <span
                            class="pc-option-total-value"
                            data-out={`option${option.id}`}
                          >
                            {formatMoney(
                              option.id === 'A' ? money.optionA : money.optionB,
                              DEFAULT_CURRENCY,
                            )}
                          </span>
                          <span class="pc-option-total-alt" data-alt={`option${option.id}`}>
                            {CURRENCIES.filter((c) => c !== DEFAULT_CURRENCY)
                              .map((c) =>
                                formatMoney(
                                  option.id === 'A' ? money.optionA : money.optionB,
                                  c,
                                ),
                              )
                              .join(' / ')}
                          </span>
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </section>

            {/* --- Add-ons --- */}
            <section class="pc-block" aria-labelledby="pc-h-addons">
              <h2 class="pc-block-h" id="pc-h-addons">Optional add-ons</h2>
              <div class="pc-table" role="table" aria-label="Optional add-ons">
                <div class="pc-tr pc-tr--head" role="row">
                  <span class="pc-th" role="columnheader">Add-on</span>
                  <span class="pc-th pc-num" role="columnheader">
                    Unit price (<span data-currency-label>{DEFAULT_CURRENCY}</span>)
                  </span>
                  <span class="pc-th pc-num" role="columnheader">Quantity</span>
                  <span class="pc-th pc-num" role="columnheader">
                    Line total (<span data-currency-label>{DEFAULT_CURRENCY}</span>)
                  </span>
                </div>
                {ADDONS.map((addon) => {
                  const line = quote.addonLines.find((l) => l.spec.id === addon.id)!;
                  return (
                    <div class="pc-tr" role="row">
                      <span class="pc-td pc-td--name" role="cell">
                        <span class="pc-addon-name">{addon.label}</span>
                        <span class="pc-addon-note">{addon.note}</span>
                        {addon.perImage && (
                          <span class="pc-addon-scale">Charged for every image</span>
                        )}
                      </span>
                      <span
                        class="pc-td pc-num"
                        role="cell"
                        data-head="Unit price"
                        data-unit={addon.id}
                      >
                        {formatUnit(line.unit, DEFAULT_CURRENCY, line.onRequest)}
                      </span>
                      <span class="pc-td pc-num" role="cell" data-head="Quantity">
                        <input
                          type="number"
                          class="pc-input pc-input--qty"
                          name={addon.id}
                          data-addon={addon.id}
                          min="0"
                          step="1"
                          value="0"
                          aria-label={`${addon.label}, quantity in ${addon.unit}`}
                        />
                      </span>
                      <span
                        class="pc-td pc-num pc-td--line"
                        role="cell"
                        data-head="Line total"
                        data-line={addon.id}
                      >
                        {line.onRequest
                          ? 'On request'
                          : formatMoney(line.line, DEFAULT_CURRENCY)}
                      </span>
                    </div>
                  );
                })}
              </div>

              <label class="pc-toggle">
                <input type="checkbox" id="pc-am" name="dedicatedAccountManager" />
                <span class="pc-toggle-body">
                  <span class="pc-toggle-name">
                    Dedicated account manager ({uplift} of subtotal)
                  </span>
                  <span class="pc-toggle-note">
                    Phone calls and a named contact who runs the project for you,
                    instead of chat only.
                  </span>
                </span>
              </label>
            </section>

            {/* --- Quotation --- */}
            <section class="pc-block pc-block--quote" aria-labelledby="pc-h-quote">
              <div class="pc-quote-head">
                <h2 class="pc-block-h pc-block-h--flush" id="pc-h-quote">
                  Your quotation
                </h2>
                <fieldset class="pc-currency">
                  <legend class="pc-currency-legend">Currency</legend>
                  <div class="pc-seg">
                    {CURRENCIES.map((currency) => (
                      <label
                        class="pc-seg-btn"
                        data-selected={String(currency === DEFAULT_CURRENCY)}
                      >
                        <input
                          type="radio"
                          name="currency"
                          value={currency}
                          checked={currency === DEFAULT_CURRENCY}
                        />
                        <span>{currency}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              </div>
              <div class="pc-disclaimer" role="note">
                <span class="pc-disclaimer-mark" aria-hidden="true">Note</span>
                <p>
                  For reference only. This estimate is not contractual and does
                  not constitute an offer. Final pricing is confirmed in a signed
                  quotation once the brief and the product photos are reviewed.
                </p>
              </div>
              <div class="pc-table pc-table--quote" role="table" aria-label="Your quotation">
                <div class="pc-tr pc-tr--head" role="row">
                  <span class="pc-th" role="columnheader">Line</span>
                  <span class="pc-th pc-num" role="columnheader" data-currency-label>
                    {DEFAULT_CURRENCY}
                  </span>
                </div>
                {summaryRows.map((row) => (
                  <div
                    class="pc-tr"
                    role="row"
                    data-emphasis={'emphasis' in row && row.emphasis ? 'true' : undefined}
                  >
                    <span class="pc-td pc-td--name" role="cell">
                      {row.id === 'imageProduction' ? (
                        <>
                          <span class="pc-addon-name">{row.label}</span>
                          <span class="pc-addon-note" data-option-label>
                            Option A, AI scene and product together
                          </span>
                        </>
                      ) : (
                        <span class="pc-addon-name">{row.label}</span>
                      )}
                    </span>
                    <span
                      class="pc-td pc-num"
                      role="cell"
                      data-head="Amount"
                      data-out={row.id}
                    >
                      {formatMoney(money[row.id], DEFAULT_CURRENCY)}
                    </span>
                  </div>
                ))}
              </div>
              <p class="pc-base-note">
                CNY is the base currency. USD and EUR are conversions at the
                current rate and can move with it.
              </p>
              <div class="pc-actions">
                <button type="button" class="pc-btn pc-btn--sm" data-print>
                  Print or save as PDF
                </button>
              </div>
            </section>

            {/* --- Good to know --- */}
            <section class="pc-block" aria-labelledby="pc-h-know">
              <h2 class="pc-block-h" id="pc-h-know">Good to know</h2>
              <div class="pc-know">
                {goodToKnow.map((group) => (
                  <div class="pc-know-group">
                    <h3 class="pc-know-h">{group.heading}</h3>
                    <ul class="pc-know-list">
                      {group.points.map((point) => (
                        <li class="pc-know-item">{point}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>

            <footer class="pc-foot">
              <p>
                Prices are shown in the currency you select above. Quotation valid
                for {TERMS.validityDays} days. Prices exclude applicable taxes.{' '}
                {TERMS.depositPct}% deposit to begin production.
              </p>
              <p>
                This page is an indicative estimate for reference only. It is not
                a contract, not an offer, and creates no commitment on either
                side. Only a signed quotation is binding.
              </p>
            </footer>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .pc-shell {
    padding: calc(var(--nav-h) + 64px) 0 var(--section-pad-y-mobile);
    background: var(--bg-cream);
    min-height: 80vh;
  }
  @media (min-width: 768px) {
    .pc-shell {
      padding-bottom: var(--section-pad-y-desktop);
    }
  }

  .pc-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
    margin-bottom: 12px;
  }
  .pc-title {
    font-family: var(--font-serif);
    font-size: var(--type-h1);
    line-height: var(--lh-display);
    margin-bottom: 16px;
  }
  .pc-lead {
    font-size: var(--type-lead);
    color: var(--text-mute);
    max-width: 52ch;
  }

  /* --- Login gate --- */
  .pc-gate {
    max-width: 440px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }
  .pc-gate .pc-lead {
    margin: 0 auto 28px;
  }
  .pc-login {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .pc-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pc-label {
    font-size: var(--type-small);
    color: var(--text-mute);
  }
  .pc-error {
    color: var(--brand-orange-deep);
    font-size: var(--type-small);
  }

  /* --- Controls --- */
  .pc-input {
    width: 100%;
    font: inherit;
    font-size: var(--type-body);
    color: var(--text-ink);
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: 12px 16px;
  }
  .pc-input:focus-visible {
    outline: 2px solid var(--brand-orange);
    outline-offset: 1px;
    border-color: transparent;
  }
  .pc-input--count {
    max-width: 160px;
    font-family: var(--font-mono);
  }
  .pc-input--qty {
    width: 84px;
    padding: 8px 10px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    border-radius: 10px;
  }
  .pc-btn {
    align-self: flex-start;
    background: var(--brand-orange);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: 14px 28px;
    font-size: var(--type-button);
    font-weight: 600;
    transition: background 0.18s ease;
  }
  .pc-btn:hover {
    background: var(--brand-orange-deep);
  }
  .pc-btn--sm {
    padding: 10px 22px;
    font-size: var(--type-small);
  }

  /* --- Head --- */
  .pc-head {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 32px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line-hairline);
  }
  @media (min-width: 900px) {
    .pc-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 48px;
    }
  }
  .pc-meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 260px;
  }
  .pc-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .pc-meta dt {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pc-meta-value {
    font-size: var(--type-small);
    font-family: var(--font-mono);
  }

  /* --- Blocks --- */
  .pc-block {
    margin-top: 56px;
  }
  .pc-block-h {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-hairline);
  }

  /* The one thing a client must not misread: what a price actually buys. */
  .pc-callout {
    background: var(--bg-white);
    border: 2px solid var(--brand-orange);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    margin-bottom: 28px;
  }
  .pc-callout-h {
    font-family: var(--font-serif);
    font-size: var(--type-h3);
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .pc-callout-p {
    font-size: var(--type-body);
    line-height: 1.62;
    max-width: 68ch;
  }

  /* --- Currency switch --- */
  .pc-quote-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-hairline);
  }
  .pc-block-h--flush {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .pc-currency {
    display: flex;
    align-items: center;
    gap: 12px;
    border: none;
    padding: 0;
    margin: 0;
  }
  .pc-currency-legend {
    float: left;
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding: 0 12px 0 0;
    line-height: 30px;
  }
  .pc-seg {
    display: flex;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 3px;
  }
  .pc-seg-btn {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.06em;
    color: var(--text-mute);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }
  .pc-seg-btn input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .pc-seg-btn:hover {
    color: var(--text-ink);
  }
  .pc-seg-btn[data-selected='true'] {
    background: var(--brand-orange);
    color: #fff;
  }
  .pc-seg-btn:focus-within {
    outline: 2px solid var(--brand-orange);
    outline-offset: 2px;
  }
  .pc-base-note {
    margin-top: 12px;
    font-size: var(--type-small);
    color: var(--text-mute);
  }

  .pc-count {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }

  /* --- Delivery options --- */
  .pc-options {
    border: none;
    padding: 0;
    margin: 0;
  }
  .pc-options-grid {
    display: grid;
    gap: 20px;
    margin-top: 12px;
  }
  .pc-option {
    /* Four rows: name, summary, caveat, price. On desktop the cards borrow the
       parent's rows (subgrid), so a title that wraps to two lines pushes both
       cards' rows down together and every line stays level across the pair. */
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 8px;
    position: relative;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    padding: 24px 24px 24px 52px;
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }
  @media (min-width: 800px) {
    .pc-options-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto auto auto auto;
      column-gap: 20px;
      row-gap: 8px;
    }
    .pc-option {
      grid-row: span 4;
      grid-template-rows: subgrid;
    }
  }
  /* Option A reads cool, Option B reads warm, so the two never blur together. */
  .pc-option[data-option='A'][data-selected='true'] {
    border-color: #4a72ad;
    background: #f2f6fc;
  }
  .pc-option[data-option='B'][data-selected='true'] {
    border-color: var(--brand-orange);
    background: #fdf4ee;
  }
  .pc-radio {
    /* Lifted out of the row flow so it cannot stretch or shift the rows it
       sits beside; it simply marks the card's first line. */
    position: absolute;
    left: 24px;
    top: 30px;
    accent-color: var(--brand-orange);
  }
  .pc-option[data-option='A'] .pc-radio {
    accent-color: #4a72ad;
  }
  /* The body is not a box of its own: its children are the card's grid rows. */
  .pc-option-body {
    display: contents;
  }
  .pc-option-name {
    font-family: var(--font-serif);
    font-size: var(--type-h3);
    line-height: 1.15;
  }
  .pc-option-text {
    font-size: var(--type-body);
    line-height: 1.62;
  }
  .pc-option-caveat {
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
  }
  .pc-option-total {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-self: end;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line-hairline);
  }
  .pc-option-total-label {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pc-option-total-value {
    font-family: var(--font-mono);
    font-size: var(--type-h3);
  }
  .pc-option-total-alt {
    display: flex;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    color: var(--text-mute);
  }

  /* --- Included --- */
  .pc-included {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 800px) {
    .pc-included {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 40px;
    }
  }
  .pc-included-item {
    position: relative;
    padding-left: 22px;
    font-size: var(--type-body);
    line-height: 1.62;
  }
  .pc-included-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-orange);
  }

  /* --- Tables --- */
  .pc-table {
    display: flex;
    flex-direction: column;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .pc-tr {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 20px;
    border-top: 1px solid var(--line-hairline);
  }
  .pc-tr:first-child {
    border-top: none;
  }
  .pc-tr--head {
    display: none;
  }
  @media (min-width: 900px) {
    .pc-tr {
      grid-template-columns: minmax(0, 1fr) repeat(3, minmax(140px, max-content));
      align-items: center;
      gap: 16px;
    }
    .pc-table--quote .pc-tr {
      /* One money column, wide enough to hold the emphasized total on one line. */
      grid-template-columns: minmax(0, 1fr) minmax(160px, max-content);
    }
    .pc-tr--head {
      display: grid;
      background: var(--bg-cream);
      padding-top: 14px;
      padding-bottom: 14px;
    }
  }
  .pc-th {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pc-td {
    font-size: var(--type-small);
  }
  .pc-num {
    font-family: var(--font-mono);
    /* An amount never breaks across lines: "CNY" and its figure stay together. */
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .pc-num {
      text-align: right;
      justify-self: end;
    }
  }
  /* On narrow screens each cell carries its own label, so the row still reads. */
  @media (max-width: 899px) {
    .pc-td[data-head]::before {
      content: attr(data-head);
      display: inline-block;
      min-width: 118px;
      font-size: var(--type-eyebrow);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-mute);
    }
    .pc-td--name {
      margin-bottom: 6px;
    }
  }
  .pc-td--name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pc-addon-name {
    font-size: var(--type-body);
    font-weight: 600;
    line-height: 1.4;
  }
  .pc-addon-note {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .pc-addon-scale {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .pc-td--line {
    font-weight: 600;
  }
  .pc-tr[data-emphasis='true'] {
    background: var(--bg-cream);
  }
  .pc-tr[data-emphasis='true'] .pc-addon-name,
  .pc-tr[data-emphasis='true'] .pc-td {
    font-size: var(--type-h3);
    font-weight: 600;
  }
  .pc-tr[data-emphasis='true'] .pc-td {
    font-family: var(--font-mono);
  }

  .pc-disclaimer {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 20px;
    background: #fdf4ee;
    border: 1px solid var(--brand-orange);
    border-radius: var(--radius-card);
    padding: 16px 20px;
  }
  .pc-disclaimer-mark {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-orange-deep);
    padding-top: 2px;
    flex: none;
  }
  .pc-disclaimer p {
    font-size: var(--type-body);
    line-height: 1.6;
  }

  /* --- Account manager toggle --- */
  .pc-toggle {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 20px;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    padding: 20px;
    cursor: pointer;
  }
  .pc-toggle input {
    margin-top: 3px;
    accent-color: var(--brand-orange);
    flex: none;
  }
  .pc-toggle-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pc-toggle-name {
    font-size: var(--type-body);
    font-weight: 600;
  }
  .pc-toggle-note {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }

  .pc-actions {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
  }

  /* --- Good to know --- */
  .pc-know {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 800px) {
    .pc-know {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 48px;
    }
  }
  .pc-know-h {
    font-size: var(--type-body);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .pc-know-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pc-know-item {
    position: relative;
    padding-left: 18px;
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
  }
  .pc-know-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .pc-foot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line-hairline);
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--type-small);
    color: var(--text-mute);
    line-height: 1.6;
  }

  /* --- Print: the quotation, nothing else --- */
  @media print {
    .pc-shell {
      padding-top: 24px;
      background: #fff;
    }
    .pc-actions,
    .pc-radio,
    .pc-toggle input {
      display: none;
    }
    .pc-option:not([data-selected='true']) {
      display: none;
    }
    .pc-table,
    .pc-option,
    .pc-toggle {
      break-inside: avoid;
      box-shadow: none;
    }
    .pc-input {
      border: none;
      padding-left: 0;
    }
  }
</style>

<script>
  /**
   * The UI layer: read the controls, hand them to the pricing core, write the
   * numbers back. All money math lives in src/lib/pricing, never here, so the
   * browser and the server can never disagree about a price.
   */
  import { ADDONS, DELIVERY_OPTIONS } from '../../lib/pricing/config';
  import { computeQuote, type QuoteInputs } from '../../lib/pricing/quote';
  import {
    CURRENCIES,
    DEFAULT_CURRENCY,
    formatMoney,
    formatUnit,
    isCurrency,
    type Currency,
  } from '../../lib/pricing/format';

  const form = document.querySelector<HTMLElement>('.pc-tool');
  if (form) {
    const imagesInput = document.querySelector<HTMLInputElement>('#pc-images');
    const amInput = document.querySelector<HTMLInputElement>('#pc-am');
    const optionLabel = document.querySelector<HTMLElement>('[data-option-label]');

    /** Current control state, clamped by the core on every read. */
    function readInputs(): QuoteInputs {
      const addons = {} as QuoteInputs['addons'];
      for (const addon of ADDONS) {
        const el = document.querySelector<HTMLInputElement>(
          `[data-addon="${addon.id}"]`,
        );
        addons[addon.id] = Number(el?.value ?? 0);
      }
      const checked = document.querySelector<HTMLInputElement>(
        'input[name="deliveryOption"]:checked',
      );
      return {
        numberOfImages: Number(imagesInput?.value ?? 1),
        deliveryOption: checked?.value === 'B' ? 'B' : 'A',
        addons,
        dedicatedAccountManager: Boolean(amInput?.checked),
      };
    }

    /** The currency every price on the page is displayed in. */
    function readCurrency(): Currency {
      const checked = document.querySelector<HTMLInputElement>(
        'input[name="currency"]:checked',
      );
      return isCurrency(checked?.value) ? checked.value : DEFAULT_CURRENCY;
    }

    function render(): void {
      const quote = computeQuote(readInputs());
      const currency = readCurrency();
      const money = {
        imageProduction: quote.imageProduction,
        addons: quote.addons,
        subtotal: quote.subtotal,
        accountManagerUplift: quote.accountManagerUplift,
        total: quote.total,
        perImage: quote.perImage,
        optionA: quote.optionTotals.A,
        optionB: quote.optionTotals.B,
      };

      document.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
        const value = money[(el.dataset.out ?? '') as keyof typeof money];
        if (value) el.textContent = formatMoney(value, currency);
      });

      // Under each option total, the same figure in the two other currencies.
      document.querySelectorAll<HTMLElement>('[data-alt]').forEach((el) => {
        const value = money[(el.dataset.alt ?? '') as keyof typeof money];
        if (value) {
          el.textContent = CURRENCIES.filter((c) => c !== currency)
            .map((c) => formatMoney(value, c))
            .join(' / ');
        }
      });

      for (const line of quote.addonLines) {
        const unitCell = document.querySelector<HTMLElement>(
          `[data-unit="${line.spec.id}"]`,
        );
        if (unitCell) {
          unitCell.textContent = formatUnit(line.unit, currency, line.onRequest);
        }
        const cell = document.querySelector<HTMLElement>(
          `[data-line="${line.spec.id}"]`,
        );
        if (cell) {
          cell.textContent = line.onRequest
            ? 'On request'
            : formatMoney(line.line, currency);
        }
      }

      // Column headers name the currency they are showing.
      document.querySelectorAll<HTMLElement>('[data-currency-label]').forEach((el) => {
        el.textContent = currency;
      });
      document.querySelectorAll<HTMLElement>('.pc-seg-btn').forEach((btn) => {
        const input = btn.querySelector<HTMLInputElement>('input');
        btn.dataset.selected = String(input?.value === currency);
      });

      // The chosen option colors its card and names itself on the quotation.
      const selected = quote.inputs.deliveryOption;
      document.querySelectorAll<HTMLElement>('.pc-option').forEach((card) => {
        card.dataset.selected = String(card.dataset.option === selected);
      });
      const spec = DELIVERY_OPTIONS.find((o) => o.id === selected);
      if (optionLabel && spec) {
        optionLabel.textContent = `Option ${spec.id}, ${spec.name}`;
      }

      // A rejected value (0 images, a negative quantity) is corrected in place,
      // so what the client sees is always what was priced.
      if (imagesInput && Number(imagesInput.value) !== quote.inputs.numberOfImages) {
        imagesInput.value = String(quote.inputs.numberOfImages);
      }
      for (const addon of ADDONS) {
        const el = document.querySelector<HTMLInputElement>(
          `[data-addon="${addon.id}"]`,
        );
        const clamped = quote.inputs.addons[addon.id];
        if (el && el.value !== '' && Number(el.value) !== clamped) {
          el.value = String(clamped);
        }
      }
    }

    form.addEventListener('input', render);
    form.addEventListener('change', render);
    document
      .querySelector<HTMLButtonElement>('[data-print]')
      ?.addEventListener('click', () => window.print());

    render();
  }
</script>
