---
/**
 * AIGC product-image quotation calculator (`/pricing/calculator`).
 *
 * Hidden and password-gated: not in the nav, not in the sitemap, noindexed,
 * disallowed in robots.txt. Server-rendered on demand so the gate is real
 * (signed httpOnly cookie via /api/pricing/login); the rest of the site stays
 * static.
 *
 * The money lives in src/lib/pricing, a pure core with no DOM. It computes the
 * quote here on the server (so the page is correct on first paint and without
 * JavaScript) and again in the browser on every change. This file is the thin UI
 * layer over it: it holds no rate, no multiplier, and no formula.
 *
 * Rates come from src/lib/pricing/settings.ts: the defaults in code, plus
 * whatever /pricing/calculator/settings has overridden, plus a live exchange rate
 * refreshed on load. The resolved config is shipped to the browser with the page
 * so client-side math uses the identical numbers the server just used.
 *
 * Two tabs: product image and product video, each its own pure core.
 *
 * Nothing is persisted. Client prices only: labor hours, hourly rates, and token
 * costs never reach the page.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { isAuthed } from '../../lib/pricing-gate';
import {
  CLIENT_PROVIDES,
  COMPLEXITIES,
  DELIVERY_OPTIONS,
  INCLUDED,
  PER_IMAGE_ADDONS,
  TERMS,
} from '../../lib/pricing/config';
import {
  MASTER_FORMATS,
  VIDEO_CLIENT_PROVIDES,
  VIDEO_COMPLEXITIES,
  VIDEO_INCLUDED,
  VIDEO_LIMITATIONS,
} from '../../lib/pricing/video-config';
import { DEFAULT_INPUTS, computeQuote, convert } from '../../lib/pricing/quote';
import {
  DEFAULT_VIDEO_INPUTS,
  computeVideoQuote,
} from '../../lib/pricing/video-quote';
import { loadPricingConfigs } from '../../lib/pricing/settings';
import {
  CURRENCIES,
  CURRENCY_NAME,
  DEFAULT_CURRENCY,
  formatDate,
  formatMoney,
  formatMultiplier,
  formatUnit,
  formatUplift,
} from '../../lib/pricing/format';

const authed = await isAuthed(Astro.request);
const loginError = Astro.url.searchParams.get('error') === '1';

// Defaults, plus saved overrides, plus a live exchange rate (refreshed here, on
// page load). Both cores take a config, so this is the only place rates enter.
const { image: imageConfig, video: videoConfig } = await loadPricingConfigs();

// First paint (and the no-JS fallback) shows a real quote, not empty cells.
const quote = computeQuote(DEFAULT_INPUTS, imageConfig);
const videoQuote = computeVideoQuote(DEFAULT_VIDEO_INPUTS, videoConfig);
const today = formatDate(new Date());
const uplift = formatUplift(imageConfig.accountManagerUpliftPct);
const moq = imageConfig.minimumImages;
const hourUnit = convert(imageConfig.designerHour, imageConfig);

/** The video quotation, itemized the way the client reads it. */
const videoSummary = [
  { id: 'videoProduction', label: 'Video production' },
  { id: 'addOnsTotal', label: 'Optional add-ons' },
  { id: 'total', label: 'Total', emphasis: true },
] as const;

const videoMoney = {
  creativeSubtotal: videoQuote.creativeSubtotal,
  productionSubtotal: videoQuote.productionSubtotal,
  basePerVideo: videoQuote.basePerVideo,
  adjustedPerVideo: videoQuote.adjustedPerVideo,
  videoProduction: videoQuote.videoProduction,
  addOnsTotal: videoQuote.addOnsTotal,
  total: videoQuote.total,
};

/** The quotation, in the order the client reads it. */
const summaryRows = [
  { id: 'imageProduction', label: 'Image production' },
  { id: 'optionalAddOns', label: 'Optional add-ons' },
  { id: 'productShot', label: 'Product shot / pack shot' },
  { id: 'retouch', label: 'Extra retouch rounds' },
  { id: 'postProduction', label: 'Post-production options' },
  { id: 'accountManagerUplift', label: `Dedicated account manager (${uplift})` },
  { id: 'total', label: 'Total', emphasis: true },
] as const;

/** Money by key, so the server render and the browser share one lookup. */
const money = {
  imageProduction: quote.imageProduction,
  optionalAddOns: quote.optionalAddOns,
  productShot: quote.productShot,
  retouch: quote.retouch,
  postProduction: quote.postProduction,
  accountManagerUplift: quote.accountManagerUplift,
  total: quote.total,
};

/** Order-level options, split into the two panels they belong in. */
const serviceLines = quote.orderLines.filter((l) => l.spec.group !== 'postProduction');
const postLines = quote.orderLines.filter((l) => l.spec.group === 'postProduction');

/** Good to know: the assumptions and limits, in plain language. */
const goodToKnow = [
  {
    heading: 'How we make your pictures',
    points: [
      'We show you scene ideas and you pick one for each picture.',
      'Then we put your product into that scene and make it look right.',
      'Every picture gets 3 rounds of fixes, included.',
      'Background changes, shadows, and reflections are part of that work. They are not extras.',
    ],
  },
  {
    heading: 'Two ways to show your product (you choose one)',
    points: [
      'Option A: the scene and the product are made together by AI. Fast, and the scene can be anything. Small details may not be perfect, so the product can look a little different from real life.',
      'Option B: the scene is made first, then your real product is placed in by hand. The product looks exactly right, but we can only use the angle and quality of the photos you send.',
    ],
  },
  {
    heading: 'What complexity means',
    points: [
      'Complexity is about the scene, never about the product.',
      'A white or graphic background is Low. A believable everyday place (office, parking, hallway) is Medium. Night light, weather, hands touching the product, or several products together is High.',
      'A different size of the same picture is not complexity. It is a resize of one master, and it is an add-on.',
    ],
  },
  {
    heading: 'How the price works',
    points: [
      `The price is per picture. There is no setup fee and no project fee, so ${moq} pictures cost five times one picture.`,
      `We start at ${moq} pictures. That is the smallest order we take.`,
      'Complexity multiplies the price of that one picture: Medium is one and a half times Low, High is twice Low.',
      'Extra sizes, higher resolutions, and 3D angles are chosen picture by picture, so you pay only for what you ask for.',
      'Extra rounds of fixes are counted once for the whole order, not for each picture.',
    ],
  },
  {
    heading: 'Honest limits',
    points: [
      'We are creative but not magic. With Option A the product is not a perfect copy; with Option B scenes are simpler.',
      'Your brand and big idea (logos, brand rules, creative direction) come from you.',
      'Pictures are made at up to 2K. Higher resolutions are an add-on, and very high ones may need a tailor-made quote.',
      CLIENT_PROVIDES,
    ],
  },
  {
    heading: 'Money and rules',
    points: [
      'Prices are shown in three currencies. CNY is the real price; USD and EUR follow the exchange rate and can move with it.',
      `Prices are good for ${TERMS.validityDays} days. Taxes are not included.`,
      'To start, you pay half. You pay the other half when your pictures are finished.',
    ],
  },
];
---

<Layout
  title="Product image and video quotation"
  description="Private quotation tool for hubStudio AIGC product imagery and video."
  noindex
>
  <section class="pc-shell">
    <div class="container">
      {
        !authed ? (
          <div class="pc-gate">
            <p class="pc-eyebrow">Private</p>
            <h1 class="pc-title">Quotation tool</h1>
            <p class="pc-lead">
              This page is restricted. Enter the access password to build a
              quotation.
            </p>
            <form class="pc-login" method="POST" action="/api/pricing/login">
              <label class="pc-field">
                <span class="pc-label">Password</span>
                <input
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  required
                  autofocus
                  class="pc-input"
                />
              </label>
              {loginError && (
                <p class="pc-error" role="alert">
                  Wrong password. Try again.
                </p>
              )}
              <button type="submit" class="pc-btn">
                Enter
              </button>
            </form>
          </div>
        ) : (
          <div class="pc-tool">
            {/* --- Header --- */}
            <header class="pc-head">
              <div>
                <p class="pc-eyebrow">hubStudio</p>
                <h1 class="pc-title">Product image and video quotation</h1>
                <p class="pc-lead">
                  A quotation engine for AI-generated product imagery and product
                  video. Pick a tab, build your order, and the price updates as
                  you go.
                </p>
              </div>
              <div class="pc-head-side">
                {/* Sets the currency for every price on the page, so it sits
                    above the first one the client reads. */}
                <label class="pc-currency">
                  <span class="pc-label">Currency</span>
                  <select class="pc-input pc-select pc-select--sm" id="pc-currency">
                    {CURRENCIES.map((currency) => (
                      <option value={currency} selected={currency === DEFAULT_CURRENCY}>
                        {currency}, {CURRENCY_NAME[currency]}
                      </option>
                    ))}
                  </select>
                </label>
                <dl class="pc-meta">
                  <div class="pc-meta-row">
                    <dt>Date</dt>
                    <dd class="pc-meta-value">{today}</dd>
                  </div>
                  <div class="pc-meta-row">
                    <dt>Valid for</dt>
                    <dd class="pc-meta-value">{TERMS.validityDays} days</dd>
                  </div>
                </dl>
              </div>
            </header>

            <div class="pc-tabs" role="tablist" aria-label="Quotation type">
              <button
                type="button"
                class="pc-tab"
                id="pc-tab-image"
                role="tab"
                aria-selected="true"
                aria-controls="pc-panel-image"
                data-tab="image"
              >
                Product Image
              </button>
              <button
                type="button"
                class="pc-tab"
                id="pc-tab-video"
                role="tab"
                aria-selected="false"
                aria-controls="pc-panel-video"
                data-tab="video"
              >
                Product Video
              </button>
            </div>

            <div
              class="pc-panel"
              id="pc-panel-image"
              role="tabpanel"
              aria-labelledby="pc-tab-image"
              data-panel="image"
            >
            {/* --- Standard scope, read before any price. --- */}
            <section class="pc-block" aria-labelledby="pc-h-included">
              <h2 class="pc-block-h" id="pc-h-included">What's included</h2>
              <div class="pc-callout">
                <p class="pc-callout-h">Every price is per finished image</p>
                <p class="pc-callout-p">
                  One final, retouched, delivery-ready picture. There is no setup
                  fee and no project fee: the order total is the sum of the images
                  you order. Every image already includes everything below, at no
                  extra charge.
                </p>
              </div>
              <ul class="pc-included">
                {INCLUDED.map((item) => (
                  <li class="pc-included-item">{item}</li>
                ))}
              </ul>
              <p class="pc-note">{CLIENT_PROVIDES}</p>
            </section>

            {/* --- Selections: choice fields only, no free typing. --- */}
            <section class="pc-block" aria-labelledby="pc-h-selections">
              <h2 class="pc-block-h" id="pc-h-selections">Your selections</h2>
              <div class="pc-fields">
                <label class="pc-field">
                  <span class="pc-label">Number of images</span>
                  <input
                    type="number"
                    class="pc-input pc-input--count"
                    id="pc-images"
                    name="numberOfImages"
                    min={moq}
                    step="1"
                    value={DEFAULT_INPUTS.numberOfImages}
                  />
                  <span class="pc-hint">Minimum order: {moq} images.</span>
                </label>

                <label class="pc-field">
                  <span class="pc-label">Delivery option</span>
                  <select class="pc-input pc-select" id="pc-delivery" name="deliveryOption">
                    {DELIVERY_OPTIONS.map((option) => (
                      <option
                        value={option.id}
                        selected={option.id === DEFAULT_INPUTS.deliveryOption}
                      >
                        Option {option.id}: {option.name}
                      </option>
                    ))}
                  </select>
                  <span class="pc-hint">How your product gets into the scene.</span>
                </label>

                <label class="pc-field">
                  <span class="pc-label">Dedicated account manager</span>
                  <select class="pc-input pc-select" id="pc-am" name="dedicatedAccountManager">
                    <option value="no" selected>No</option>
                    <option value="yes">Yes</option>
                  </select>
                  <span class="pc-hint">
                    Phone support and a named contact. Adds {uplift} of the subtotal.
                  </span>
                </label>
              </div>
            </section>

            {/* --- Delivery option comparison (price per image) --- */}
            <section class="pc-block" aria-labelledby="pc-h-delivery">
              <h2 class="pc-block-h" id="pc-h-delivery">Delivery options, price per image</h2>
              <div class="pc-options-grid">
                {DELIVERY_OPTIONS.map((option) => (
                  <article
                    class="pc-option"
                    data-option={option.id}
                    data-selected={String(option.id === DEFAULT_INPUTS.deliveryOption)}
                  >
                    <h3 class="pc-option-name">
                      Option {option.id}: {option.name}
                    </h3>
                    <p class="pc-option-text">{option.summary}</p>
                    <p class="pc-option-caveat">{option.caveat}</p>
                    <p class="pc-option-total">
                      <span class="pc-option-total-label">Price per image, Low complexity</span>
                      <span
                        class="pc-option-total-value"
                        data-out={`basePerImage${option.id}`}
                      >
                        {formatMoney(quote.basePerImage[option.id], DEFAULT_CURRENCY)}
                      </span>
                    </p>
                  </article>
                ))}
              </div>
              <p class="pc-note">
                These are the Low-complexity base rates. The actual price of an
                image rises with the complexity you give it below.
              </p>
            </section>

            {/* --- Per-image grid --- */}
            <section class="pc-block" aria-labelledby="pc-h-grid">
              <h2 class="pc-block-h" id="pc-h-grid">Image by image</h2>
              <p class="pc-note pc-note--lead">
                One row per image. Complexity is scored by the scene, never by the
                product, and it multiplies that image's production price. Add-ons
                are chosen per image and cost{' '}
                <span data-out="designerHour">{formatMoney(hourUnit, DEFAULT_CURRENCY)}</span>{' '}
                each.
                Rows past your image count are greyed out and cost nothing.
              </p>

              <ul class="pc-legend">
                {COMPLEXITIES.map((level) => (
                  <li class="pc-legend-item">
                    <span class="pc-legend-name">
                      {level.id} ({formatMultiplier(level.multiplier)})
                    </span>
                    <span class="pc-legend-note">{level.note}</span>
                  </li>
                ))}
              </ul>

              <div class="pc-table pc-table--grid" role="table" aria-label="Image by image">
                <div class="pc-tr pc-tr--head" role="row">
                  <span class="pc-th" role="columnheader">Image</span>
                  <span class="pc-th" role="columnheader">Complexity</span>
                  {PER_IMAGE_ADDONS.map((addon) => (
                    <span class="pc-th pc-num" role="columnheader">{addon.label}</span>
                  ))}
                  <span class="pc-th pc-num" role="columnheader">Production</span>
                  <span class="pc-th pc-num" role="columnheader">Add-ons</span>
                </div>

                <div data-grid-body>
                  {quote.imageLines.map((line) => (
                    <div class="pc-tr" role="row" data-row={line.index}>
                      <span class="pc-td pc-td--name" role="cell">
                        <span class="pc-addon-name">Image {line.index + 1}</span>
                      </span>
                      <span class="pc-td" role="cell" data-head="Complexity">
                        <select
                          class="pc-input pc-select pc-select--sm"
                          data-cell={`${line.index}.complexity`}
                          aria-label={`Image ${line.index + 1}, complexity`}
                        >
                          {COMPLEXITIES.map((level) => (
                            <option
                              value={level.id}
                              selected={level.id === line.row.complexity}
                            >
                              {level.id} ({formatMultiplier(level.multiplier)})
                            </option>
                          ))}
                        </select>
                      </span>
                      {PER_IMAGE_ADDONS.map((addon) => (
                        <span class="pc-td pc-num" role="cell" data-head={addon.label}>
                          <input
                            type="number"
                            class="pc-input pc-input--qty"
                            min="0"
                            step="1"
                            value={line.row[addon.id]}
                            data-cell={`${line.index}.${addon.id}`}
                            aria-label={`Image ${line.index + 1}, ${addon.label}`}
                          />
                        </span>
                      ))}
                      <span
                        class="pc-td pc-num pc-td--line"
                        role="cell"
                        data-head="Production"
                        data-production={line.index}
                      >
                        {formatMoney(line.production, DEFAULT_CURRENCY)}
                      </span>
                      <span
                        class="pc-td pc-num pc-td--line"
                        role="cell"
                        data-head="Add-ons"
                        data-rowaddons={line.index}
                      >
                        {formatMoney(line.addOns, DEFAULT_CURRENCY)}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              <ul class="pc-legend">
                {PER_IMAGE_ADDONS.map((addon) => (
                  <li class="pc-legend-item">
                    <span class="pc-legend-name">{addon.label}</span>
                    <span class="pc-legend-note">{addon.note}</span>
                  </li>
                ))}
              </ul>
            </section>

            {/* --- Order-level options --- */}
            <section class="pc-block" aria-labelledby="pc-h-order">
              <h2 class="pc-block-h" id="pc-h-order">Options for the whole order</h2>
              <p class="pc-note pc-note--lead">
                Counted once for the order, never per image.
              </p>
              <div class="pc-table" role="table" aria-label="Order-level options">
                <div class="pc-tr pc-tr--head" role="row">
                  <span class="pc-th" role="columnheader">Option</span>
                  <span class="pc-th pc-num" role="columnheader">
                    Unit price (<span data-currency-label>{DEFAULT_CURRENCY}</span>)
                  </span>
                  <span class="pc-th pc-num" role="columnheader">Quantity</span>
                  <span class="pc-th pc-num" role="columnheader">Line total</span>
                </div>
                {serviceLines.map((line) => (
                  <div class="pc-tr" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">{line.spec.label}</span>
                      <span class="pc-addon-note">{line.spec.note}</span>
                    </span>
                    <span
                      class="pc-td pc-num"
                      role="cell"
                      data-head="Unit price"
                      data-unit={line.spec.id}
                    >
                      {formatUnit(line.unit, DEFAULT_CURRENCY, line.onRequest)}
                    </span>
                    <span class="pc-td pc-num" role="cell" data-head="Quantity">
                      <input
                        type="number"
                        class="pc-input pc-input--qty"
                        min="0"
                        step="1"
                        value={line.quantity}
                        data-order={line.spec.id}
                        aria-label={`${line.spec.label}, quantity in ${line.spec.unit}`}
                      />
                    </span>
                    <span
                      class="pc-td pc-num pc-td--line"
                      role="cell"
                      data-head="Line total"
                      data-orderline={line.spec.id}
                    >
                      {line.onRequest
                        ? 'On request'
                        : formatMoney(line.line, DEFAULT_CURRENCY)}
                    </span>
                  </div>
                ))}
              </div>
            </section>

            {/* --- Post-production --- */}
            <section class="pc-block" aria-labelledby="pc-h-post">
              <h2 class="pc-block-h" id="pc-h-post">Post-production options</h2>
              <p class="pc-note pc-note--lead">
                One designer hour each, {formatMoney(hourUnit, 'CNY')}. Background
                changes and shadow or reflection work are not listed here: they are
                part of standard retouch and already included.
              </p>
              <div class="pc-table" role="table" aria-label="Post-production options">
                <div class="pc-tr pc-tr--head" role="row">
                  <span class="pc-th" role="columnheader">Option</span>
                  <span class="pc-th pc-num" role="columnheader">
                    Unit price (<span data-currency-label>{DEFAULT_CURRENCY}</span>)
                  </span>
                  <span class="pc-th pc-num" role="columnheader">Quantity</span>
                  <span class="pc-th pc-num" role="columnheader">Line total</span>
                </div>
                {postLines.map((line) => (
                  <div class="pc-tr" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">{line.spec.label}</span>
                      <span class="pc-addon-note">{line.spec.note}</span>
                    </span>
                    <span
                      class="pc-td pc-num"
                      role="cell"
                      data-head="Unit price"
                      data-unit={line.spec.id}
                    >
                      {formatUnit(line.unit, DEFAULT_CURRENCY, line.onRequest)}
                    </span>
                    <span class="pc-td pc-num" role="cell" data-head="Quantity">
                      <input
                        type="number"
                        class="pc-input pc-input--qty"
                        min="0"
                        step="1"
                        value={line.quantity}
                        data-order={line.spec.id}
                        aria-label={`${line.spec.label}, quantity in ${line.spec.unit}`}
                      />
                    </span>
                    <span
                      class="pc-td pc-num pc-td--line"
                      role="cell"
                      data-head="Line total"
                      data-orderline={line.spec.id}
                    >
                      {line.onRequest
                        ? 'On request'
                        : formatMoney(line.line, DEFAULT_CURRENCY)}
                    </span>
                  </div>
                ))}
              </div>
            </section>

            {/* --- Quotation --- */}
            <section class="pc-block pc-block--quote" aria-labelledby="pc-h-quote">
              <h2 class="pc-block-h" id="pc-h-quote">Your quotation</h2>
              <div class="pc-disclaimer" role="note">
                <span class="pc-disclaimer-mark" aria-hidden="true">Note</span>
                <p>
                  For reference only. This estimate is not contractual and does
                  not constitute an offer. Final pricing is confirmed in a signed
                  quotation once the brief and the product photos are reviewed.
                </p>
              </div>
              <div class="pc-table pc-table--quote" role="table" aria-label="Your quotation">
                <div class="pc-tr pc-tr--head" role="row">
                  <span class="pc-th" role="columnheader">Line</span>
                  <span class="pc-th pc-num" role="columnheader" data-currency-label>
                    {DEFAULT_CURRENCY}
                  </span>
                </div>
                {summaryRows.map((row) => (
                  <div
                    class="pc-tr"
                    role="row"
                    data-emphasis={'emphasis' in row && row.emphasis ? 'true' : undefined}
                  >
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">{row.label}</span>
                      {row.id === 'imageProduction' && (
                        <span class="pc-addon-note" data-production-note />
                      )}
                    </span>
                    <span
                      class="pc-td pc-num"
                      role="cell"
                      data-head="Amount"
                      data-out={row.id}
                    >
                      {formatMoney(money[row.id], DEFAULT_CURRENCY)}
                    </span>
                  </div>
                ))}
              </div>
              <p class="pc-note">
                CNY is canonical: it is the price we actually charge. USD and EUR
                are converted from it at the current rate and can move with it.
              </p>
              <div class="pc-actions">
                <button type="button" class="pc-btn pc-btn--sm" data-print>
                  Print or save as PDF
                </button>
              </div>
            </section>

            {/* --- Good to know --- */}
            <section class="pc-block" aria-labelledby="pc-h-know">
              <h2 class="pc-block-h" id="pc-h-know">Good to know</h2>
              <div class="pc-know">
                {goodToKnow.map((group) => (
                  <div class="pc-know-group">
                    <h3 class="pc-know-h">{group.heading}</h3>
                    <ul class="pc-know-list">
                      {group.points.map((point) => (
                        <li class="pc-know-item">{point}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>

            <footer class="pc-foot">
              <p>
                All prices in CNY (base), with USD and EUR converted at current
                rates. Quotation valid for {TERMS.validityDays} days. Prices
                exclude applicable taxes. {TERMS.depositPct}% deposit to begin
                production.
              </p>
              <p>
                This page is an indicative estimate for reference only. It is not
                a contract, not an offer, and creates no commitment on either
                side. Only a signed quotation is binding.
              </p>
            </footer>
            </div>

            <div
              class="pc-panel"
              id="pc-panel-video"
              role="tabpanel"
              aria-labelledby="pc-tab-video"
              data-panel="video"
              hidden
            >
              {/* --- What a video is --- */}
              <section class="pc-block" aria-labelledby="pc-h-vincluded">
                <h2 class="pc-block-h" id="pc-h-vincluded">What's included</h2>
                <div class="pc-callout">
                  <p class="pc-callout-h">Length drives the price</p>
                  <p class="pc-callout-p">
                    A video is a sequence of shots. Every{' '}
                    {videoConfig.averageSecondsPerSequence} seconds of finished
                    film is one shot, and each shot is generated, keyframed, and
                    composited. The creative work (the brief, the treatment, the
                    storyboard) is charged once per video and does not grow with
                    length. Everything below is included at no extra charge.
                  </p>
                </div>
                <ul class="pc-included">
                  {VIDEO_INCLUDED.map((item) => (
                    <li class="pc-included-item">{item}</li>
                  ))}
                </ul>
                <p class="pc-note">{VIDEO_CLIENT_PROVIDES}</p>
              </section>

              {/* --- Selections --- */}
              <section class="pc-block" aria-labelledby="pc-h-vselections">
                <h2 class="pc-block-h" id="pc-h-vselections">Your selections</h2>
                <div class="pc-fields">
                  <label class="pc-field">
                    <span class="pc-label">Number of videos</span>
                    <input
                      type="number"
                      class="pc-input pc-input--count"
                      id="pv-videos"
                      min="1"
                      step="1"
                      value={DEFAULT_VIDEO_INPUTS.numberOfVideos}
                    />
                  </label>

                  <label class="pc-field">
                    <span class="pc-label">Video length (seconds)</span>
                    <input
                      type="number"
                      class="pc-input pc-input--count"
                      id="pv-length"
                      min="1"
                      step="1"
                      value={DEFAULT_VIDEO_INPUTS.videoLengthSeconds}
                    />
                    <span class="pc-hint">
                      The primary driver: length becomes shots.
                    </span>
                  </label>

                  <label class="pc-field">
                    <span class="pc-label">Complexity</span>
                    <select class="pc-input pc-select" id="pv-complexity">
                      {VIDEO_COMPLEXITIES.map((level) => (
                        <option
                          value={level.id}
                          selected={level.id === DEFAULT_VIDEO_INPUTS.complexity}
                        >
                          {level.id} ({formatMultiplier(
                            videoConfig.complexityMultiplier[level.id],
                          )})
                        </option>
                      ))}
                    </select>
                    <span class="pc-hint">Scored by the scene, not the product.</span>
                  </label>

                  <label class="pc-field">
                    <span class="pc-label">Master format</span>
                    <select class="pc-input pc-select" id="pv-format">
                      {MASTER_FORMATS.map((format) => (
                        <option
                          value={format.id}
                          selected={format.id === DEFAULT_VIDEO_INPUTS.masterFormat}
                        >
                          {format.id}
                        </option>
                      ))}
                    </select>
                    <span class="pc-hint">
                      One master is included. This choice has no price impact.
                    </span>
                  </label>
                </div>

                {/* Complexity guide: what each level buys, and what it costs. */}
                <div class="pc-guide">
                  {VIDEO_COMPLEXITIES.map((level) => (
                    <div class="pc-guide-item" data-tone={level.tone}>
                      <p class="pc-guide-h">
                        {level.id}
                        <span class="pc-guide-mult">
                          {formatMultiplier(videoConfig.complexityMultiplier[level.id])}
                        </span>
                      </p>
                      <p class="pc-guide-note">{level.note}</p>
                    </div>
                  ))}
                </div>
                <p class="pc-note">
                  Complexity multiplies the base price of one video (creative plus
                  production). It never touches the add-ons, and it is not the
                  number of videos.
                </p>
              </section>

              {/* --- Derived structure --- */}
              <section class="pc-block" aria-labelledby="pc-h-vstructure">
                <h2 class="pc-block-h" id="pc-h-vstructure">Video structure</h2>
                <div class="pc-stats">
                  <div class="pc-stat">
                    <span class="pc-stat-label">Length</span>
                    <span class="pc-stat-value" data-vout-text="length">
                      {videoQuote.inputs.videoLengthSeconds} seconds
                    </span>
                  </div>
                  <div class="pc-stat">
                    <span class="pc-stat-label">Sequences (shots)</span>
                    <span class="pc-stat-value" data-vout-text="sequences">
                      {videoQuote.sequences}
                    </span>
                    <span class="pc-stat-note" data-vout-text="sequencesNote">
                      {videoQuote.inputs.videoLengthSeconds} seconds divided by{' '}
                      {videoConfig.averageSecondsPerSequence}, rounded up
                    </span>
                  </div>
                  <div class="pc-stat">
                    <span class="pc-stat-label">Keyframes per shot</span>
                    <span class="pc-stat-value">
                      {videoConfig.engine.keyframesPerSequence}
                    </span>
                    <span class="pc-stat-note">A start frame and an end frame</span>
                  </div>
                  <div class="pc-stat">
                    <span class="pc-stat-label">Revision rounds</span>
                    <span class="pc-stat-value">
                      {videoConfig.engine.includedRevisionRounds}
                    </span>
                    <span class="pc-stat-note">Included in the price</span>
                  </div>
                </div>
              </section>

              {/* --- Add-ons --- */}
              <section class="pc-block" aria-labelledby="pc-h-vaddons">
                <h2 class="pc-block-h" id="pc-h-vaddons">Optional add-ons</h2>
                <p class="pc-note pc-note--lead">
                  Explicit quantities: an add-on is never multiplied by the
                  complexity or by the number of videos. You buy what you type.
                </p>
                <div class="pc-table" role="table" aria-label="Video add-ons">
                  <div class="pc-tr pc-tr--head" role="row">
                    <span class="pc-th" role="columnheader">Add-on</span>
                    <span class="pc-th pc-num" role="columnheader">
                      Unit price (<span data-currency-label>{DEFAULT_CURRENCY}</span>)
                    </span>
                    <span class="pc-th pc-num" role="columnheader">Quantity</span>
                    <span class="pc-th pc-num" role="columnheader">Line total</span>
                  </div>
                  {videoQuote.addOnLines.map((line) => (
                    <div class="pc-tr" role="row">
                      <span class="pc-td pc-td--name" role="cell">
                        <span class="pc-addon-name">{line.spec.label}</span>
                        <span class="pc-addon-note">{line.spec.note}</span>
                        {line.spec.derived && (
                          <span class="pc-addon-scale">Moves with the video length</span>
                        )}
                      </span>
                      <span
                        class="pc-td pc-num"
                        role="cell"
                        data-head="Unit price"
                        data-vunit={line.spec.id}
                      >
                        {formatMoney(line.unit, DEFAULT_CURRENCY)}
                      </span>
                      <span class="pc-td pc-num" role="cell" data-head="Quantity">
                        <input
                          type="number"
                          class="pc-input pc-input--qty"
                          min="0"
                          step="1"
                          value={line.quantity}
                          data-vaddon={line.spec.id}
                          aria-label={`${line.spec.label}, quantity in ${line.spec.unit}`}
                        />
                      </span>
                      <span
                        class="pc-td pc-num pc-td--line"
                        role="cell"
                        data-head="Line total"
                        data-vline={line.spec.id}
                      >
                        {formatMoney(line.line, DEFAULT_CURRENCY)}
                      </span>
                    </div>
                  ))}
                </div>
              </section>

              {/* --- Quotation --- */}
              <section class="pc-block" aria-labelledby="pc-h-vquote">
                <h2 class="pc-block-h" id="pc-h-vquote">Your quotation</h2>
                <div class="pc-disclaimer" role="note">
                  <span class="pc-disclaimer-mark" aria-hidden="true">Note</span>
                  <p>
                    For reference only. This estimate is not contractual and does
                    not constitute an offer. Final pricing is confirmed in a signed
                    quotation once the brief and the references are reviewed.
                  </p>
                </div>

                <div class="pc-table pc-table--quote" role="table" aria-label="Video quotation">
                  <div class="pc-tr pc-tr--head" role="row">
                    <span class="pc-th" role="columnheader">Line</span>
                    <span class="pc-th pc-num" role="columnheader" data-currency-label>
                      {DEFAULT_CURRENCY}
                    </span>
                  </div>

                  <div class="pc-tr pc-tr--section" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">Creative</span>
                      <span class="pc-addon-note">
                        Charged once per video. It does not grow with length.
                      </span>
                    </span>
                    <span class="pc-td pc-num" role="cell" />
                  </div>
                  {videoQuote.creativeLines.map((line, i) => (
                    <div class="pc-tr pc-tr--item" role="row">
                      <span class="pc-td pc-td--name" role="cell">
                        <span class="pc-item-name">{line.label}</span>
                        <span class="pc-addon-note" data-vdetail={`creative.${i}`}>
                          {line.detail}
                        </span>
                      </span>
                      <span
                        class="pc-td pc-num"
                        role="cell"
                        data-head="Amount"
                        data-vitem={`creative.${i}`}
                      >
                        {formatMoney(line.amount, DEFAULT_CURRENCY)}
                      </span>
                    </div>
                  ))}
                  <div class="pc-tr pc-tr--sub" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">Creative subtotal</span>
                    </span>
                    <span
                      class="pc-td pc-num pc-td--line"
                      role="cell"
                      data-head="Amount"
                      data-vout="creativeSubtotal"
                    >
                      {formatMoney(videoQuote.creativeSubtotal, DEFAULT_CURRENCY)}
                    </span>
                  </div>

                  <div class="pc-tr pc-tr--section" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">Production</span>
                      <span class="pc-addon-note">
                        The per-shot work scales with the shot count.
                      </span>
                    </span>
                    <span class="pc-td pc-num" role="cell" />
                  </div>
                  {videoQuote.productionLines.map((line, i) => (
                    <div class="pc-tr pc-tr--item" role="row">
                      <span class="pc-td pc-td--name" role="cell">
                        <span class="pc-item-name" data-vlabel={`production.${i}`}>
                          {line.label}
                        </span>
                        <span class="pc-addon-note" data-vdetail={`production.${i}`}>
                          {line.detail}
                        </span>
                      </span>
                      <span
                        class="pc-td pc-num"
                        role="cell"
                        data-head="Amount"
                        data-vitem={`production.${i}`}
                      >
                        {formatMoney(line.amount, DEFAULT_CURRENCY)}
                      </span>
                    </div>
                  ))}
                  <div class="pc-tr pc-tr--sub" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-addon-name">Production subtotal</span>
                    </span>
                    <span
                      class="pc-td pc-num pc-td--line"
                      role="cell"
                      data-head="Amount"
                      data-vout="productionSubtotal"
                    >
                      {formatMoney(videoQuote.productionSubtotal, DEFAULT_CURRENCY)}
                    </span>
                  </div>

                  <div class="pc-tr pc-tr--item" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-item-name">Base price per video</span>
                      <span class="pc-addon-note">Creative plus production</span>
                    </span>
                    <span
                      class="pc-td pc-num"
                      role="cell"
                      data-head="Amount"
                      data-vout="basePerVideo"
                    >
                      {formatMoney(videoQuote.basePerVideo, DEFAULT_CURRENCY)}
                    </span>
                  </div>
                  <div class="pc-tr pc-tr--item" role="row">
                    <span class="pc-td pc-td--name" role="cell">
                      <span class="pc-item-name">Price per video, at your complexity</span>
                      <span class="pc-addon-note" data-vout-text="complexityNote">
                        {videoQuote.inputs.complexity},{' '}
                        {formatMultiplier(videoQuote.complexityMultiplier)}
                      </span>
                    </span>
                    <span
                      class="pc-td pc-num"
                      role="cell"
                      data-head="Amount"
                      data-vout="adjustedPerVideo"
                    >
                      {formatMoney(videoQuote.adjustedPerVideo, DEFAULT_CURRENCY)}
                    </span>
                  </div>

                  {videoSummary.map((row) => (
                    <div
                      class="pc-tr"
                      role="row"
                      data-emphasis={'emphasis' in row && row.emphasis ? 'true' : undefined}
                    >
                      <span class="pc-td pc-td--name" role="cell">
                        <span class="pc-addon-name">{row.label}</span>
                        {row.id === 'videoProduction' && (
                          <span class="pc-addon-note" data-vout-text="videosNote">
                            {videoQuote.inputs.numberOfVideos} video, at the price
                            above
                          </span>
                        )}
                      </span>
                      <span
                        class="pc-td pc-num"
                        role="cell"
                        data-head="Amount"
                        data-vout={row.id}
                      >
                        {formatMoney(videoMoney[row.id], DEFAULT_CURRENCY)}
                      </span>
                    </div>
                  ))}
                </div>

                <p class="pc-note">
                  CNY is canonical: it is the price we actually charge. USD and EUR
                  are converted from it at the current rate and can move with it.
                </p>
                <div class="pc-actions">
                  <button type="button" class="pc-btn pc-btn--sm" data-print>
                    Print or save as PDF
                  </button>
                </div>
              </section>

              {/* --- Remarks and limitations --- */}
              <section class="pc-block" aria-labelledby="pc-h-vlimits">
                <h2 class="pc-block-h" id="pc-h-vlimits">Remarks and limitations</h2>
                <p class="pc-note pc-note--lead">
                  Said plainly and said early, because these are the things that
                  disappoint a client who learns them late.
                </p>
                <ul class="pc-know-list pc-limits">
                  {VIDEO_LIMITATIONS.map((limit) => (
                    <li class="pc-know-item">{limit}</li>
                  ))}
                </ul>
              </section>

              {/* --- Good to know --- */}
              <section class="pc-block" aria-labelledby="pc-h-vknow">
                <h2 class="pc-block-h" id="pc-h-vknow">Good to know</h2>
                <div class="pc-know">
                  <div class="pc-know-group">
                    <h3 class="pc-know-h">How we make your film</h3>
                    <ul class="pc-know-list">
                      <li class="pc-know-item">
                        We turn your product into a short film, built shot by shot,
                        then cut together with music, on-screen text, and subtitles.
                      </li>
                      <li class="pc-know-item">
                        First we agree the idea and the storyboard. Then we make each
                        shot, then we edit them into one film.
                      </li>
                      <li class="pc-know-item">
                        You get two rounds of changes on the edit, the text, and the
                        timing.
                      </li>
                    </ul>
                  </div>
                  <div class="pc-know-group">
                    <h3 class="pc-know-h">Why length matters so much</h3>
                    <ul class="pc-know-list">
                      <li class="pc-know-item">
                        Every {videoConfig.averageSecondsPerSequence} seconds is one
                        shot, and every shot has to be generated and finished. A film
                        twice as long has twice the shots.
                      </li>
                      <li class="pc-know-item">
                        The thinking part (brief, treatment, storyboard) is charged
                        once. It costs the same whether the film is 15 seconds or 60.
                      </li>
                    </ul>
                  </div>
                  <div class="pc-know-group">
                    <h3 class="pc-know-h">Other sizes and other cuts</h3>
                    <ul class="pc-know-list">
                      <li class="pc-know-item">
                        One master is included in the shape you choose. A vertical or
                        square version can be cropped from it cheaply, but going wide
                        to tall loses a lot of the picture.
                      </li>
                      <li class="pc-know-item">
                        When cropping would cut too much away, we make the other shape
                        again from scratch. That costs a full production pass.
                      </li>
                    </ul>
                  </div>
                  <div class="pc-know-group">
                    <h3 class="pc-know-h">Money and rules</h3>
                    <ul class="pc-know-list">
                      <li class="pc-know-item">
                        Prices are good for {TERMS.validityDays} days. Taxes are not
                        included.
                      </li>
                      <li class="pc-know-item">
                        To start, you pay half. You pay the other half when the film
                        is finished.
                      </li>
                      <li class="pc-know-item">
                        CNY is the real price. USD and EUR follow the exchange rate.
                      </li>
                    </ul>
                  </div>
                </div>
              </section>

              <footer class="pc-foot">
                <p>
                  All prices in CNY (base), with USD and EUR converted at current
                  rates. Quotation valid for {TERMS.validityDays} days. Prices
                  exclude applicable taxes. {TERMS.depositPct}% deposit to begin
                  production.
                </p>
                <p>
                  This page is an indicative estimate for reference only. It is not
                  a contract, not an offer, and creates no commitment on either
                  side. Only a signed quotation is binding.
                </p>
              </footer>
            </div>

            {/* The exact rates the server just priced with, handed to the browser
                so client-side recalculation cannot drift from the server render.
                Behind the gate, like every other number on this page. */}
            <script
              type="application/json"
              id="pc-config"
              is:inline
              set:html={JSON.stringify({ image: imageConfig, video: videoConfig })}
            />
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .pc-shell {
    padding: calc(var(--nav-h) + 64px) 0 var(--section-pad-y-mobile);
    background: var(--bg-cream);
    min-height: 80vh;
  }
  @media (min-width: 768px) {
    .pc-shell {
      padding-bottom: var(--section-pad-y-desktop);
    }
  }

  .pc-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
    margin-bottom: 12px;
  }
  .pc-title {
    font-family: var(--font-serif);
    font-size: var(--type-h1);
    line-height: var(--lh-display);
    margin-bottom: 16px;
  }
  .pc-lead {
    font-size: var(--type-lead);
    color: var(--text-mute);
    max-width: 54ch;
  }

  /* --- Login gate --- */
  .pc-gate {
    max-width: 440px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }
  .pc-gate .pc-lead {
    margin: 0 auto 28px;
  }
  .pc-login {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .pc-error {
    color: var(--brand-orange-deep);
    font-size: var(--type-small);
  }

  /* --- Controls --- */
  .pc-fields {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 800px) {
    .pc-fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
  .pc-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pc-label {
    font-size: var(--type-small);
    color: var(--text-mute);
  }
  .pc-hint {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.06em;
    color: var(--text-mute);
    line-height: 1.5;
  }
  .pc-input {
    width: 100%;
    font: inherit;
    font-size: var(--type-body);
    color: var(--text-ink);
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: 12px 16px;
  }
  .pc-input:focus-visible {
    outline: 2px solid var(--brand-orange);
    outline-offset: 1px;
    border-color: transparent;
  }
  .pc-select {
    cursor: pointer;
    appearance: none;
    /* A caret drawn in the box, so the control reads as a dropdown on every
       platform without shipping an icon file. */
    background-image: linear-gradient(45deg, transparent 50%, var(--text-mute) 50%),
      linear-gradient(135deg, var(--text-mute) 50%, transparent 50%);
    background-position:
      calc(100% - 19px) calc(50% + 1px),
      calc(100% - 14px) calc(50% + 1px);
    background-size:
      5px 5px,
      5px 5px;
    background-repeat: no-repeat;
    padding-right: 40px;
  }
  .pc-select--sm {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    padding: 8px 34px 8px 12px;
    border-radius: 10px;
    background-position:
      calc(100% - 16px) calc(50% + 1px),
      calc(100% - 11px) calc(50% + 1px);
    min-width: 118px;
  }
  .pc-input--count {
    font-family: var(--font-mono);
  }
  .pc-input--qty {
    width: 78px;
    padding: 8px 10px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    border-radius: 10px;
  }
  .pc-input:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pc-btn {
    align-self: flex-start;
    background: var(--brand-orange);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: 14px 28px;
    font-size: var(--type-button);
    font-weight: 600;
    transition: background 0.18s ease;
  }
  .pc-btn:hover {
    background: var(--brand-orange-deep);
  }
  .pc-btn--sm {
    padding: 10px 22px;
    font-size: var(--type-small);
  }

  /* --- Head --- */
  .pc-head {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line-hairline);
  }
  @media (min-width: 900px) {
    .pc-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 48px;
    }
  }
  .pc-meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 240px;
    width: 100%;
  }
  .pc-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .pc-meta dt {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pc-meta-value {
    font-size: var(--type-small);
    font-family: var(--font-mono);
  }

  /* --- Tabs --- */
  .pc-tabs {
    display: flex;
    gap: 28px;
    margin-top: 40px;
    border-bottom: 1px solid var(--line-hairline);
  }
  .pc-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 12px 2px;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.06em;
    color: var(--text-mute);
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .pc-tab:hover {
    color: var(--text-ink);
  }
  .pc-tab[aria-selected='true'] {
    color: var(--brand-orange);
    border-bottom-color: var(--brand-orange);
  }
  .pc-tab:focus-visible {
    outline: 2px solid var(--brand-orange);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .pc-panel[hidden] {
    display: none;
  }

  /* --- Blocks --- */
  .pc-block {
    margin-top: 56px;
  }
  .pc-block-h {
    font-family: var(--font-mono);
