  }
  .pc-table > .pc-tr:first-child,
  [data-grid-body] .pc-tr:first-child {
    border-top: none;
  }
  .pc-tr--head {
    display: none;
  }
  @media (min-width: 900px) {
    .pc-tr {
      grid-template-columns:
        minmax(0, 1fr) minmax(130px, max-content) minmax(90px, max-content)
        minmax(130px, max-content);
      align-items: center;
      gap: 16px;
    }
    .pc-table--grid .pc-tr {
      grid-template-columns:
        minmax(0, 1fr) minmax(130px, max-content) repeat(3, minmax(90px, max-content))
        repeat(2, minmax(110px, max-content));
      padding: 12px 20px;
    }
    .pc-table--quote .pc-tr {
      /* One money column, wide enough to hold the emphasized total on one line. */
      grid-template-columns: minmax(0, 1fr) minmax(170px, max-content);
    }
    .pc-tr--head {
      display: grid;
      background: var(--bg-cream);
      padding-top: 14px;
      padding-bottom: 14px;
    }
  }
  .pc-th {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pc-td {
    font-size: var(--type-small);
  }
  .pc-num {
    font-family: var(--font-mono);
    /* An amount never breaks across lines: the symbol and its figure stay together. */
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .pc-num {
      text-align: right;
      justify-self: end;
    }
  }
  /* On narrow screens each cell carries its own label, so the row still reads. */
  @media (max-width: 899px) {
    .pc-td[data-head]::before {
      content: attr(data-head);
      display: inline-block;
      min-width: 130px;
      font-size: var(--type-eyebrow);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-mute);
    }
    .pc-td--name {
      margin-bottom: 6px;
    }
  }
  .pc-td--name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pc-addon-name {
    font-size: var(--type-body);
    font-weight: 600;
    line-height: 1.4;
  }
  .pc-addon-note {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .pc-td--line {
    font-weight: 600;
  }

  /* A row past the image count: visible, so nothing typed is lost, but plainly
     out of the quote. */
  .pc-tr[data-ignored='true'] {
    opacity: 0.42;
  }

  .pc-legend {
    display: grid;
    gap: 12px;
    margin: 0 0 20px;
  }
  @media (min-width: 800px) {
    .pc-legend {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .pc-legend:last-child {
    margin: 18px 0 0;
  }
  .pc-legend-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pc-legend-name {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .pc-legend-note {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--text-mute);
  }

  .pc-tr[data-emphasis='true'] {
    background: var(--bg-cream);
  }
  .pc-tr[data-emphasis='true'] .pc-addon-name,
  .pc-tr[data-emphasis='true'] .pc-td {
    font-size: var(--type-h3);
    font-weight: 600;
  }
  .pc-tr[data-emphasis='true'] .pc-td {
