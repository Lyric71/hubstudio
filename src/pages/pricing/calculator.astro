    height: 6px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .pc-foot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line-hairline);
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--type-small);
    color: var(--text-mute);
    line-height: 1.6;
  }

  /* --- Print: the quotation, nothing else --- */
  @media print {
    .pc-shell {
      padding-top: 24px;
      background: #fff;
    }
    .pc-actions {
      display: none;
    }
    .pc-option:not([data-selected='true']),
    .pc-tr[data-ignored='true'] {
      display: none;
    }
    .pc-table,
    .pc-option {
      break-inside: avoid;
      box-shadow: none;
    }
    .pc-input {
      border: none;
      padding-left: 0;
      background-image: none;
    }
  }
</style>

<script>
  /**
   * The UI layer: read the controls, hand them to the pricing core, write the
   * numbers back. All money math lives in src/lib/pricing, never here, so the
   * browser and the server can never disagree about a price.
   *
   * The grid is the one piece of real UI state: it grows with the image count
   * and keeps rows that fall past it, so shrinking an order and growing it again
   * does not throw away what the client typed.
   */
  import {
    COMPLEXITIES,
    ORDER_ADDONS,
    PER_IMAGE_ADDONS,
    PRICING,
  } from '../../lib/pricing/config';
  import {
    computeQuote,
    emptyOrderAddons,
    emptyRow,
    type ImageRow,
    type QuoteInputs,
  } from '../../lib/pricing/quote';
  import {
    DEFAULT_CURRENCY,
    formatMoney,
    formatMultiplier,
    formatUnit,
    isCurrency,
    type Currency,
  } from '../../lib/pricing/format';
  import { convert } from '../../lib/pricing/quote';

  const tool = document.querySelector<HTMLElement>('.pc-tool');
  if (tool) {
    const imagesInput = document.querySelector<HTMLInputElement>('#pc-images');
    const deliverySelect = document.querySelector<HTMLSelectElement>('#pc-delivery');
    const amSelect = document.querySelector<HTMLSelectElement>('#pc-am');
    const currencySelect = document.querySelector<HTMLSelectElement>('#pc-currency');
    const gridBody = document.querySelector<HTMLElement>('[data-grid-body]');
    const productionNote = document.querySelector<HTMLElement>('[data-production-note]');

    /** The one currency every price on the page is displayed in. */
    function readCurrency(): Currency {
      return isCurrency(currencySelect?.value) ? currencySelect.value : DEFAULT_CURRENCY;
    }

    /** How many images the client has asked for, floored at the MOQ. */
    function imageCount(): number {
      const n = Math.floor(Number(imagesInput?.value));
      return Number.isFinite(n) && n >= PRICING.minimumImages ? n : PRICING.minimumImages;
    }

    /** One grid row, built to the same shape the server renders. */
    function buildRow(index: number): HTMLElement {
      const row = document.createElement('div');
      row.className = 'pc-tr';
      row.setAttribute('role', 'row');
      row.dataset.row = String(index);

      const name = document.createElement('span');
      name.className = 'pc-td pc-td--name';
      name.setAttribute('role', 'cell');
      name.innerHTML = `<span class="pc-addon-name">Image ${index + 1}</span>`;
      row.appendChild(name);

      const complexityCell = document.createElement('span');
      complexityCell.className = 'pc-td';
      complexityCell.setAttribute('role', 'cell');
      complexityCell.dataset.head = 'Complexity';
      const select = document.createElement('select');
      select.className = 'pc-input pc-select pc-select--sm';
      select.dataset.cell = `${index}.complexity`;
      select.setAttribute('aria-label', `Image ${index + 1}, complexity`);
      for (const level of COMPLEXITIES) {
        const option = document.createElement('option');
        option.value = level.id;
        option.textContent = `${level.id} (${formatMultiplier(level.multiplier)})`;
        select.appendChild(option);
      }
      complexityCell.appendChild(select);
      row.appendChild(complexityCell);

      for (const addon of PER_IMAGE_ADDONS) {
        const cell = document.createElement('span');
        cell.className = 'pc-td pc-num';
        cell.setAttribute('role', 'cell');
        cell.dataset.head = addon.label;
        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'pc-input pc-input--qty';
        input.min = '0';
        input.step = '1';
        input.value = '0';
        input.dataset.cell = `${index}.${addon.id}`;
        input.setAttribute('aria-label', `Image ${index + 1}, ${addon.label}`);
        cell.appendChild(input);
        row.appendChild(cell);
      }

      for (const [key, head] of [
        ['production', 'Production'],
        ['rowaddons', 'Add-ons'],
      ] as const) {
        const cell = document.createElement('span');
        cell.className = 'pc-td pc-num pc-td--line';
        cell.setAttribute('role', 'cell');
        cell.dataset.head = head;
        cell.dataset[key] = String(index);
        cell.textContent = '-';
        row.appendChild(cell);
      }

      return row;
    }

    /** Grow the grid to cover the image count. Rows are never deleted: one that
     *  falls past the count is greyed out and excluded, but keeps its values. */
    function syncRows(): void {
      if (!gridBody) return;
      const needed = imageCount();
      for (let i = gridBody.querySelectorAll('[data-row]').length; i < needed; i++) {
        gridBody.appendChild(buildRow(i));
      }
      gridBody.querySelectorAll<HTMLElement>('[data-row]').forEach((row, i) => {
        const ignored = i >= needed;
        row.dataset.ignored = String(ignored);
        row
          .querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')
          .forEach((field) => (field.disabled = ignored));
      });
    }

    /** Current control state, clamped by the core on every read. */
    function readInputs(): QuoteInputs {
      const perImage: ImageRow[] = [];
      document
        .querySelectorAll<HTMLElement>('[data-grid-body] [data-row]')
        .forEach((row, i) => {
          const values = emptyRow();
          const complexity = row.querySelector<HTMLSelectElement>(
            `[data-cell="${i}.complexity"]`,
          );
          values.complexity = (complexity?.value ?? 'Low') as ImageRow['complexity'];
          for (const addon of PER_IMAGE_ADDONS) {
            const input = row.querySelector<HTMLInputElement>(
              `[data-cell="${i}.${addon.id}"]`,
            );
            values[addon.id] = Number(input?.value ?? 0);
          }
          perImage.push(values);
        });

      const orderAddons = emptyOrderAddons();
      for (const addon of ORDER_ADDONS) {
        const input = document.querySelector<HTMLInputElement>(
          `[data-order="${addon.id}"]`,
        );
        orderAddons[addon.id] = Number(input?.value ?? 0);
      }

      return {
        numberOfImages: Number(imagesInput?.value ?? PRICING.minimumImages),
        deliveryOption: deliverySelect?.value === 'B' ? 'B' : 'A',
        perImage,
        orderAddons,
        dedicatedAccountManager: amSelect?.value === 'yes',
      };
    }

    function render(): void {
      syncRows();
      const quote = computeQuote(readInputs());
      const currency = readCurrency();
      const money = {
        imageProduction: quote.imageProduction,
        optionalAddOns: quote.optionalAddOns,
        productShot: quote.productShot,
        retouch: quote.retouch,
        postProduction: quote.postProduction,
        accountManagerUplift: quote.accountManagerUplift,
        total: quote.total,
        basePerImageA: quote.basePerImage.A,
        basePerImageB: quote.basePerImage.B,
        designerHour: convert(PRICING.designerHour),
      };

      document.querySelectorAll<HTMLElement>('[data-out]').forEach((el) => {
        const value = money[(el.dataset.out ?? '') as keyof typeof money];
        if (value) el.textContent = formatMoney(value, currency);
      });

      for (const line of quote.imageLines) {
        const production = document.querySelector<HTMLElement>(
          `[data-production="${line.index}"]`,
        );
        if (production) production.textContent = formatMoney(line.production, currency);
        const addOns = document.querySelector<HTMLElement>(
          `[data-rowaddons="${line.index}"]`,
        );
        if (addOns) addOns.textContent = formatMoney(line.addOns, currency);
      }

      for (const line of quote.orderLines) {
        const unit = document.querySelector<HTMLElement>(`[data-unit="${line.spec.id}"]`);
        if (unit) unit.textContent = formatUnit(line.unit, currency, line.onRequest);
        const cell = document.querySelector<HTMLElement>(
          `[data-orderline="${line.spec.id}"]`,
        );
        if (cell) {
          cell.textContent = line.onRequest
            ? 'On request'
            : formatMoney(line.line, currency);
        }
      }

      // Column headers name the currency they are showing.
      document.querySelectorAll<HTMLElement>('[data-currency-label]').forEach((el) => {
        el.textContent = currency;
      });

      // The chosen option colors its card and explains the production line.
      const selected = quote.inputs.deliveryOption;
      document.querySelectorAll<HTMLElement>('.pc-option').forEach((card) => {
        card.dataset.selected = String(card.dataset.option === selected);
      });
      if (productionNote) {
        const n = quote.inputs.numberOfImages;
        const images = n === 1 ? '1 image' : `${n} images`;
        productionNote.textContent = `${images}, Option ${selected}, each priced at its own complexity`;
      }

      // A rejected value (below the MOQ, a negative quantity) is corrected in
      // place, so what the client sees is always what was priced.
      if (imagesInput && Number(imagesInput.value) !== quote.inputs.numberOfImages) {
        imagesInput.value = String(quote.inputs.numberOfImages);
      }
      document
        .querySelectorAll<HTMLInputElement>('[data-cell], [data-order]')
        .forEach((input) => {
          if (input.type === 'number' && input.value !== '' && Number(input.value) < 0) {
            input.value = '0';
          }
        });
    }

    tool.addEventListener('input', render);
    tool.addEventListener('change', render);
    document
      .querySelector<HTMLButtonElement>('[data-print]')
      ?.addEventListener('click', () => window.print());

    render();
  }
</script>
