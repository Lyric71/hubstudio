---
/**
 * Social Media Content  ·  /services/design/social-media
 *
 * Art direction inherited from packaging-merch-design: a "pressroom"
 * editorial frame (crop marks, calibration colour bar, mono figure
 * labels) wraps social content samples and process imagery. The brief
 * is the feed: ship more, ship faster, ship to two platform cultures
 * at once (Meta and TikTok in the West, Xiaohongshu and Douyin in
 * China).
 *
 * Copy from hubstudio-social-page.md. Process step numerals are
 * intentionally dropped per the project's permanent "no numbers in
 * cards / step lists" rule. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio campaign samples, each with an invented brand mark. */
const samples = [
  {
    src: '/Images/sm-sample-nora.jpg',
    brand: 'Nora',
    kind: 'Beauty / TikTok',
    alt: 'A woman applying a clear serum from a frosted glass bottle, captured as a frame from a vertical beauty short video.',
  },
  {
    src: '/Images/sm-sample-pavo.jpg',
    brand: 'Pavo',
    kind: 'FMCG / creator-led',
    alt: 'A man laughing while pouring oat milk into a terracotta cereal bowl in a sunlit kitchen, frame from a creator-shot short video.',
  },
  {
    src: '/Images/sm-sample-volt.jpg',
    brand: 'Volt',
    kind: 'Consumer tech / AI UGC',
    alt: 'A woman holding a matte black wireless earbud case at eye level under one directional studio light.',
  },
  {
    src: '/Images/sm-sample-maris.jpg',
    brand: 'Maris',
    kind: 'Luxury / Reels',
    alt: 'A model in a cream wool coat walking past a sunlit travertine wall at golden hour.',
  },
  {
    src: '/Images/sm-sample-renxi.jpg',
    brand: 'Renxi',
    kind: 'Beauty / Douyin livestream',
    alt: 'A young woman host gesturing toward a skincare bottle on a pink livestream set with ring lights and phone tripods.',
  },
  {
    src: '/Images/sm-sample-alta.jpg',
    brand: 'Alta',
    kind: 'Automotive / cross-platform',
    alt: 'A dark midnight blue sedan on a wide concrete plaza at dusk, lit by ambient sunset.',
  },
];

/* Calibration colour bar, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-program averages, drawn from the source quote across roughly
   60 social engagements over 18 months. */
const stats = [
  { from: 0, to: 10, suffix: 'x', label: 'Variant output per month', note: 'Same brief, no new headcount' },
  { from: 0, to: 65, suffix: '%', label: 'Lower cost per asset', note: 'On recent campaigns' },
  { from: 0, to: 3, suffix: 'x', label: 'Average ROAS lift', note: 'Against client baselines' },
];

/* Two macro coverage lanes. The source names six sub-services, listed
   below as chips inside the two natural buckets: paid scale on one side,
   creator and livestream trust on the other. */
const coverage = [
  {
    label: 'Brand-led, paid and AI',
    heading: 'Always-on creative for paid social.',
    image: '/Images/sm-cover-paid.jpg',
    alt: 'A smartphone leaning against printed paid ad posters on a warm plaster ledge, an example of paid social work.',
    body: [
      "Paid social and ad creative for Meta, TikTok, Google, Ocean Engine and Alimama. Image, carousel, video, UGC-style and creator-style cuts, built native to each platform. Produced in the variant counts the algorithms now require, tagged for analysis, replaced on a cadence that beats fatigue.",
      "Short-form video at scale: vertical builds recut from one shoot or one render into 6, 15 and 30-second versions with hook variants and on-screen text per market. AI UGC and synthetic spokespeople for cheap concept testing, human versions commissioned once a concept proves out.",
    ],
    tags: [
      'Meta & TikTok ads', 'Google & YouTube',
      'Ocean Engine', 'Short-form video',
      'AI UGC', 'Hook variants', 'Always-on retainer',
      'Cross-market localization',
    ],
  },
  {
    label: 'Creator, organic and livestream',
    heading: 'Trust assets built for the algorithm.',
    image: '/Images/sm-cover-creator.jpg',
    alt: 'A content creator on a sunlit balcony holding her phone in selfie mode at golden hour.',
    lead: 'Real creators briefed as performance assets, not media buys.',
    body: [
      "Organic social across Instagram, TikTok, LinkedIn, X, YouTube Shorts, Xiaohongshu, Douyin, WeChat and Bilibili. Stills, carousels, animated posts and short videos, briefed native to each platform rather than adapted from a TV spot.",
      "Creator and KOC programs in and out of China. Casting, scripting, multi-camera production, content rights. Merchant-led livestream rooms on Douyin and Taobao, where store-operated streams now drive close to 70% of livestream gross merchandise value. Influencer content for TikTok, Instagram, Xiaohongshu and YouTube.",
    ],
    tags: [
      'Instagram & TikTok', 'LinkedIn & X',
      'Xiaohongshu', 'Douyin & Bilibili',
      'WeChat', 'KOC seeding', 'Livestream rooms',
      'Influencer & rights',
    ],
  },
];

/* Native-platform footprint, the social analogue of the packaging
   factory credentials block. */
const platforms = ['Xiaohongshu (RedNote)', 'Douyin & Taobao Live', 'WeChat & Bilibili', 'Tmall Mei Li'];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   own framing ("the first two steps are where it's won") sets the tier. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and audit.',
    body: 'Brand assets, current library, ad account data, platform priorities, market list. We pull what already worked and what already fatigued.',
    image: '/Images/sm-p1-brief.jpg',
    alt: 'A worktable covered with printed social feed screenshots, a smartphone and a notebook with handwritten notes.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction. The call that decides the campaign.',
    body: 'Senior art directors and copywriters set angles, hooks, visual system and talent direction. This is the step that turns a variant pile into a campaign.',
    image: '/Images/sm-p2-direction.jpg',
    alt: 'A senior creative director in front of a wall of pinned printed ad frames, pointing at one.',
  },
  {
    short: 'AI training',
    tier: 'The rest is execution',
    title: 'AI training and exploration.',
    body: 'Brand-trained models on your existing assets. Dozens of variants in parallel, in days not weeks.',
    image: '/Images/sm-p3-ai.jpg',
    alt: 'A designer monitor showing a grid of twelve AI-generated vertical social ad variants in different colour treatments.',
  },
  {
    short: 'Production',
    tier: 'The rest is execution',
    title: 'Production and refinement.',
    body: 'Studio shoots and creator briefs where the work calls for them. AI render passes where it does not. Senior post on every asset before it ships, never auto-output.',
    image: '/Images/sm-p4-production.jpg',
    alt: 'A model adjusting her hair while a stylist tucks a collar on a real photo shoot, softbox on a stand in frame.',
  },
  {
    short: 'Distribution',
    tier: 'The rest is execution',
    title: 'Distribution and performance feedback.',
    body: 'Files delivered into the ad manager, the social tool, the livestream room. Performance data piped back inside seven days for the next round.',
    image: '/Images/sm-p5-distribution.jpg',
    alt: 'A marketer desk at dusk with a laptop showing a media planning dashboard and a notebook with handwritten KPI numbers.',
  },
];

const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* Old workflow phases for the variant-volume math block. */
const oldPhases = [
  { label: 'Concepting', dur: 'Two weeks', span: 2 },
  { label: 'Shoot & production', dur: 'Three weeks', span: 3 },
  { label: 'Post & market adapt', dur: 'Three weeks', span: 3 },
];

/* FAQ: source order preserved, copy lightly tightened for web. */
const faqs = [
  {
    q: 'How fast can you ship?',
    a: "Two weeks from a signed brief to first batch of variants. On an always-on retainer that loop tightens up: new variants ship weekly, and performance feedback closes inside about seven days.",
  },
  {
    q: 'How many variants per month do we actually need?',
    a: "This is the question we get most, and the honest answer is, it depends. At lower spend levels, 15 to 25 net-new variants a month is usually plenty. At higher spend, plan for 40 to 80. Brands in the top spend bracket on Meta and TikTok are now running 200 or more per month, which is roughly the volume that quietly breaks most internal teams. If you are not sure where you sit on this curve, the first batch we ship usually answers the question.",
  },
  {
    q: 'What does a project cost?',
    a: 'Project-based pricing for one-off campaigns. Monthly retainer for always-on programs. We give you a firm number after the first call, once the brief and the platform list are clear.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three, and most projects wrap inside two. Beyond round three we move to hourly, but in practice this rarely comes up.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Every project is led by a senior creative director or art director, most from agency backgrounds (Publicis, Ogilvy, WPP, BBDO). AI specialists handle the variant volume side of things. Performance analysts close the loop with your ad accounts. There are no junior teams running a brief on their own.',
  },
  {
    q: 'Will the output look like us, or like the AI?',
    a: "Like you. We train the models on your existing assets so the output stays inside your visual system. If you do not have a documented system, we build one as the work moves forward and hand it over.",
  },
  {
    q: 'Can you produce real human content as well as AI?',
    a: "Yes. Studio shoots, real creators, livestream rooms. For most brands the answer is some kind of hybrid: AI for cheap concept testing and variant scale, humans for the assets that have to carry the brand and earn audience trust. We try not to push AI into places where it does not help yet.",
  },
  {
    q: 'Do you work with influencers and creators?',
    a: 'Yes, and we treat them as performance assets, not just media. Casting, briefing, scripting, on-set direction, content rights, usage terms, the whole package. Real creators inside and outside China. We handle merchant livestream production for Douyin and Taobao, plus creator content for TikTok, Instagram, Xiaohongshu, YouTube and LinkedIn.',
  },
  {
    q: 'Can you handle China and Western markets in one engagement?',
    a: 'Yes. We treat them as separate creative briefs rather than translation lanes, which is the mistake most cross-border campaigns make. Cross-cultural creative teams and local market direction on both sides, with native platform expertise across Meta, TikTok and Google in the West and ByteDance, Alibaba and Tencent in China.',
  },
  {
    q: 'Do you build for Xiaohongshu specifically?',
    a: "Yes. The platform has its own algorithm, its own engagement weighting and its own content culture, so we brief, shoot and seed for it directly with the KOC layer the platform actually trusts. We do not try to repurpose Instagram content into Xiaohongshu posts, because it shows.",
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. For the legal side in full, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you plug into our existing ad accounts and tools?',
    a: 'Yes. We deliver into Meta Ads Manager, TikTok Ads Manager, Google Ads, Ocean Engine and Alimama. Performance data feeds back into the creative loop so the next batch is built off real numbers and not opinions.',
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one campaign brief. Inside two weeks you get a creative direction document, 15 to 20 variants and a production estimate. No retainer, no commitment. The work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Social Media Content Production | hubStudio"
  description="Brand-trained AI, creator-led production and livestream studios for paid social at the volume Meta and TikTok now demand. In and out of China."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Social Media Content
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Social Media</span></span>
            <span class="line"><span class="line__i">Content</span></span>
            <span class="line"><span class="line__i serif">at Scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Brief it. Make it. Refresh it. <em>Weekly.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              The feed wants more, and it wants it faster than your team
              can ship. Meta's Andromeda rebuild dropped the effective
              lifespan of a paid ad from six weeks to two.
            </p>
            <p>
              We brief, make and refresh paid and organic content at the
              volume Meta and TikTok now require. Senior creative
              direction, brand-trained AI, real creators in and out of
              China. One team.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai & global <span>/</span> Paid, organic, creator, livestream
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/sm-hero.jpg"
          alt="A content creator in a sunlit Shanghai loft holding a vertical smartphone close to her face, recording a short video."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Nora</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Why our cross-border<br /><span class="serif">roots</span> matter.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              A performance lead at a mid-size beauty brand sent us a
              question in March: how many TikTok variants would she need
              to hold her ROAS through Q2? Around forty net-new a month,
              mixed creator and brand, refreshed every two weeks. Her
              in-house team was shipping eight.
            </p>
            <p class="r" style="--d:.16s">
              That gap is the new market. For twenty years, through
              Beyond Border Group, we ran eCommerce storefronts and
              social programs across Meta, TikTok, Xiaohongshu, Douyin
              and WeChat. We brief, make and refresh content that holds
              up in a feed, on a paid placement, and in a livestream
              room.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Clients have included <strong>HiSense</strong>,
              <strong>Camper</strong> and <strong>age20</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/sm-roots.jpg"
              alt="Hands holding a vertical smartphone scrolling a social feed at a sunlit cafe table."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The two-week ad lifespan</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Averages across roughly 60 social engagements over the last
            18 months: ten times the variant output, sixty-five percent
            lower cost per asset, and a two to three times ROAS lift
            against client baselines.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Six lanes, one <span class="serif">brand voice</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            A Reels hook and a Douyin livestream do not share a craft.
            One has to land in a second and a half. The other holds an
            audience for three hours and converts on impulse. We staff
            them differently.
          </p>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Frames from recent social engagements: TikTok testing
            programs, always-on Xiaohongshu, AI UGC across nine markets,
            luxury Reels, Douyin livestream and cross-platform
            automotive. Every image is authored work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · CHINA (the social analogue of sourcing) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/sm-china-main.jpg"
                alt="A brand livestream studio set in Shanghai with a softbox, phone tripods and a pink LED back wall."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/sm-china-inset.jpg"
              alt="A young Chinese KOC content creator holding a tube of cleanser to camera in a sunlit apartment."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">~70%</span>
            <span class="source__stat-cap">Douyin GMV from store-operated rooms</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The China question</p>
          <h2 class="dh r" style="--d:.05s">
            Xiaohongshu does not<br />reward what <span class="serif">Instagram</span> rewards.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Most foreign brands run China social as a translation lane
            on top of a Western brief. The results are usually flat.
          </p>
          <p class="source__p r" style="--d:.16s">
            Xiaohongshu ranks posts on a CES algorithm that weights
            follows highest, then comments, shares, saves, with likes a
            distant fifth. Posts have to be at least 60% original to
            qualify for broader distribution. Polished editorial
            campaigns tend to flop here. Real photographs, KOC reviews
            and routine-led content do not.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              platforms.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Douyin has tilted hard toward merchant-led livestream rooms
            over the last 18 months. Brand-operated stores now drive
            close to 70% of Douyin's livestream gross merchandise value,
            in a market once dominated by celebrity hosts. Our Shanghai
            producers run merchant rooms for skincare and small
            appliance brands, brief KOC seeding programs, and build the
            local-context content sets that make Tmall conversion show
            up at all.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Need only the Western side? Or only China? Either works. We
            scope to where the budget is going.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Volume is the floor.<br />The eye is the <span class="serif">ceiling</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          AI made variant production almost free, which broke the market
          in a useful way. The studios still winning social work are the
          ones whose creative direction is strong enough that AI
          amplifies it instead of substituting for it.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            Eight variants a month<br />was the old <span class="serif">ceiling</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with a Q3 paid-social plan across Meta and
            TikTok in four markets. The same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Eight per month</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief an agency, two weeks for concepts,
                three for the shoot, three for post and market
                adaptation. Eight weeks per batch, and the team can ship
                six to eight variants a month at best. The algorithm
                wants forty.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Forty to eighty</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Weekly batches</span>
                  <span class="vs__seg-dur">Refresh every seven days</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: brand-trained AI generates the first batch
                of forty variants in days. Live creators briefed in
                parallel. Performance data closes the loop inside seven
                days, so the next batch is built off what already
                worked. Forty to eighty net-new variants a month, no new
                headcount.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Monthly to <span class="serif">weekly</span>.
            </h3>
            <p class="hub__text">
              For brands running always-on paid social at scale, we
              deploy hub4You, our custom AI agent setup trained on your
              own brand system. It generates on-brand social variants on
              demand and connects directly to Meta Ads Manager, TikTok
              Ads Manager, Ocean Engine and your DAM, so the output
              lands where your team already works. That is the gap
              between refreshing creative monthly and refreshing it
              weekly.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4fashion.jpg"
                alt="The hub4You platform generating on-brand social variants from a model and a background."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Thirteen questions,<br />before the first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here,
            put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">campaign</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us one social brief. Inside two weeks you get a creative
          direction document, fifteen to twenty variants and a
          production estimate. No retainer, no commitment. Whatever we
          produce is yours either way.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
