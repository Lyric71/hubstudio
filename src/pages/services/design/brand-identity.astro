  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
