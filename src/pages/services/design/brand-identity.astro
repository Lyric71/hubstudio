---
/**
 * Brand Identity  ·  /services/design/brand-identity
 *
 * Mirrors /services/design/packaging-merch-design: same "Pressroom"
 * art direction (crop marks, calibration colour bar, mono figure labels)
 * adapted to identity work. Copy from brand-identity-page.md, with
 * structure folded into the existing nine-section layout. Process step
 * numerals dropped per the no-numbers rule.
 *
 * Imagery lives in /public/Images with the bi- prefix.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Six invented sample identities, one per category named in the brief. */
const samples = [
  {
    src: '/Images/bi-sample-lumera.jpg',
    brand: 'Lumera',
    kind: 'Beauty global refresh',
    alt: 'Sand-toned printed wordmark card for Lumera beside a frosted bottle and an ivory carton, all carrying the same mark.',
  },
  {
    src: '/Images/bi-sample-norden.jpg',
    brand: 'Norden',
    kind: 'FMCG sub-brand system',
    alt: 'Three printed identity cards for Norden Home, Norden Garden and Norden Kids sharing the same monogram device.',
  },
  {
    src: '/Images/bi-sample-calverra.jpg',
    brand: 'Calverra',
    kind: 'Luxury hospitality',
    alt: 'A folded ecru linen card embossed with the Calverra wordmark on a dark walnut hotel desk beside a brass keycard sleeve.',
  },
  {
    src: '/Images/bi-sample-halix.jpg',
    brand: 'Halix',
    kind: 'Consumer tech B2B',
    alt: 'A cool-grey Halix brand book opened to a monogram spread beside an anodized aluminium device on a studio table.',
  },
  {
    src: '/Images/bi-sample-mireille.jpg',
    brand: 'Mireille',
    kind: 'Fashion DTC launch',
    alt: 'A Mireille lookbook spread, a folded ivory garment-bag tag and an oxblood fabric swatch on a worktable.',
  },
  {
    src: '/Images/bi-sample-sael.jpg',
    brand: 'Sael',
    kind: 'Beverage, four markets',
    alt: 'Four aluminium cans in a row carrying the Sael wordmark in four secondary palette tones, on travertine.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Results stats, taken from brand-identity-page.md. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'Creative approval rate', note: 'Up from 22% before' },
  { from: 0, to: 60, suffix: '%', label: 'Lower content cost', note: 'On recent rollouts' },
  { from: 0, to: 7, suffix: 'x', label: 'Asset output', note: 'No new hires' },
];

/* Two coverage lanes. The seven lanes in the source brief group into the
   visual system and everything that surrounds it (words, guidelines,
   rollout). Keeping the two-feature layout means the lanes have to
   group, not list. */
const coverage = [
  {
    fig: 'B',
    label: 'Visual system',
    heading: 'The system, not the logo alone.',
    image: '/Images/bi-cover-system.jpg',
    alt: 'An overhead studio still life of a brand identity visual system: wordmark sheet, colour swatches, type specimen and monogram card.',
    body: [
      'Logo system, colour, typography, imagery and motion as one coordinated brand. Primary mark, secondary marks, lockups and a monogram for small applications, built for 16 pixels in a browser tab and 16 feet on an OOH bulletin. Motion-ready masters so the mark behaves on video, app loaders and social.',
      'Colour in HEX, RGB, CMYK and Pantone, coated and uncoated, contrast-tested for WCAG AA. Typography with hierarchy from H1 to caption, licensing covering the markets you ship into, and fallback stacks for the channels licensing cannot reach (email, certain ad networks, some Chinese platforms).',
    ],
    tags: [
      'Logo system', 'Monogram', 'Lockups', 'Motion-ready',
      'Colour tokens', 'Pantone', 'Type pairing', 'Licensing',
      'Iconography', 'Imagery direction',
    ],
  },
  {
    fig: 'C',
    label: 'Voice, names and the working layer',
    heading: 'Verbal identity, guidelines and rollout.',
    image: '/Images/bi-cover-words.jpg',
    alt: 'A printed brand book opened to a verbal-identity spread on a warm worktable, with a small colour chip book at the edge.',
    lead: 'A book nobody opens is not a system.',
    body: [
      'Brand name, tagline, voice principles, vocabulary do\'s and don\'ts, messaging pillars, copy examples. For brands shipping into China, we run the Chinese naming brief in-house. Phonetic and semantic fit, dialect screening (Cantonese can carry meanings Mandarin does not), and the trademark search at CNIPA, the Chinese trademark office, that catches the names that look great until your IP counsel reads them.',
      'Around 95% of companies have brand guidelines. The number with a working brand system people actually use is much smaller. So guidelines ship as two things. The reference document, yes, the PDF brand book your CMO can present to the board. And the working layer underneath: a Figma library with logo lockups, colour tokens and type styles set up as components, plus templates for the formats your team ships every week.',
    ],
    tags: [
      'Brand naming', 'Chinese naming', 'CNIPA search', 'Voice principles',
      'Messaging pillars', 'Figma library', 'Tokens', 'Templates',
      'Brand book', 'Trained image model',
    ],
  },
];

/* Rollout credentials, named in the production-handover copy. */
const credentials = ['Figma library', 'Frontify', 'Bynder', 'Lingo'];

/* Process steps. The "where it is won / the rest is execution" tiers
   come from the source's own framing of creative direction as the
   step that matters most. Numerals dropped per the no-numbers rule. */
const processSteps = [
  {
    short: 'Strategy',
    tier: 'Where it is won',
    title: 'Strategy and audit.',
    body: 'Positioning, audience, competitive landscape, personality, plus a clear-eyed audit of whatever identity exists already.',
    image: '/Images/bi-p1-brief.jpg',
    alt: 'A strategy session table with a printed audit grid, a positioning matrix marked up in pencil, tear sheets and colour chips.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction. The step that matters most.',
    body: 'Art directors set two or three distinct directions. Each comes with logo system, colour, type and imagery worked through enough that you are choosing between strategies, not moodboards.',
    image: '/Images/bi-p2-direction.jpg',
    alt: 'Two distinct identity direction boards leaning side by side against a plaster wall, a hand pointing at the left one.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration in context.',
    body: 'Hundreds of applications generated in parallel: packaging mockups, website hero, OOH at distance, social grid, retail signage, motion. You see the identity in real environments before anything locks.',
    image: '/Images/bi-p3-aigc.jpg',
    alt: 'A flat contact-sheet grid of nine printed variations of the same wordmark applied across nine real-world contexts.',
  },
  {
    short: 'Refinement',
    tier: 'The rest is execution',
    title: 'Refinement and system build.',
    body: 'Logo refinement, type pairing finalised, colour tested for accessibility and print, master files, Figma library, brand book.',
    image: '/Images/bi-p4-refine.jpg',
    alt: 'A refined printed wordmark on a worktable beside a colour-token sheet, a type-pairing specimen and a loupe magnifier.',
  },
  {
    short: 'Rollout kit',
    tier: 'The rest is execution',
    title: 'Rollout kit.',
    body: 'Templates for the formats your team ships every week, plus, if needed, a brand-trained image model so the visual direction holds as you scale.',
    image: '/Images/bi-p5-adapt.jpg',
    alt: 'A flat-lay of brand rollout assets: social templates, product page module, deck cover, email header card, carrier bag.',
  },
];

/* The old agency timeline, in the source: 6 to 12 months is enterprise
   consultancy work; 8 to 16 weeks is the agency mid-tier. Charting the
   mid-tier comparison because it matches the brief most readers run. */
const oldPhases = [
  { label: 'Strategy', dur: 'Four weeks', span: 4 },
  { label: 'Direction', dur: 'Five weeks', span: 5 },
  { label: 'System & guidelines', dur: 'Seven weeks', span: 7 },
];

/* FAQ: source has 16 questions, condensed to 10 to match the layout. */
const faqs = [
  {
    q: 'How long does a brand identity project take?',
    a: 'Six to ten weeks for a full identity from strategy to delivered system. Three to four weeks for a focused refresh. Faster on a sub-brand extension. Most agencies quote eight to sixteen weeks for the same scope, and global consultancies routinely run six to twelve months on enterprise rebrands. The compression is real, but it comes from AI making the production fast, not from skipping the thinking.',
  },
  {
    q: 'How does this compare to a traditional branding agency?',
    a: 'Different model. Heritage consultancies sell deep, partner-led engagements that often run two quarters or more. The output is excellent and the price reflects it. We sell faster, more production-heavy work: art-director-led creative direction plus AI-driven exploration and rollout that traditional studios cannot match without doubling headcount. If you want a brand book that wins design awards and you have nine months, hire one of them. If you want a system that ships, plus a team that can produce six months of campaign assets through it, we are a better fit.',
  },
  {
    q: 'Who shouldn\'t hire us?',
    a: 'Three situations. A one-week logo for an internal project is over-engineered for us. A category-defining transformation that needs six months of stakeholder workshops and CEO-level positioning work probably needs a strategy consultancy instead. And if AI in the creative process is a non-starter for your team, we will not be a fit, because AI sits in our production layer.',
  },
  {
    q: 'Do we get the source files?',
    a: 'Yes. Every editable master file (Figma, Illustrator, InDesign, the brand-trained image model) gets handed over at the end of the project. There is no licensing trap where you would lose access if you stopped working with us. The system is yours.',
  },
  {
    q: 'What if we already have a brand book we want to evolve, not replace?',
    a: 'That is most of our work, actually. Full rebrand is the smaller share of identity projects we run, and the rebrands that sever continuity of equity are the ones that tend to fail. More often it is a refresh: tighter logo system, modernised type, evolved colour, new imagery direction, and a brand book someone will actually open. Evolution usually beats starting over.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Art directors from 4A agency backgrounds (Publicis, Ogilvy, WPP) lead creative direction. AI specialists handle the production scale. Strategy is run by people who have done brand work for the markets we are building for, not by junior teams reading a template. No outsourced hands on creative direction.',
  },
  {
    q: 'Will the identity look like us, or like an AI made it?',
    a: 'Like you. The AI handles volume. Art directors handle direction. The brand-trained image model is fine-tuned on the chosen visual direction, so output stays inside your system, and the work that lands in front of your customer was approved by a human who has been at this for more than a decade. AI sameness is a real issue in the market. The only defence is creative direction strong enough that the model amplifies your point of view instead of replacing it with whatever the model defaults to.',
  },
  {
    q: 'Can you handle a multi-market identity, including Chinese?',
    a: 'Yes. We brief Chinese naming in-house: phonetic, semantic, dialect screening, cultural fit, plus the CNIPA trademark search to catch the names already squatted on. This matters more than most foreign brands realise. Trademark squatters watch Xiaohongshu and Weibo for consumer-coined Chinese names of foreign brands and will register them faster than the brand can. We also build identity systems that flex across Western and CJK visual conventions without splitting in two.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables, including the brand-trained image model. We document which models touched which assets so your legal team has a clear record. For the full position on copyright and AI, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Do you build adaptive or motion-ready logo systems?',
    a: 'Yes, and we increasingly default to it. Static-only marks are outdated for any brand shipping into app icons, video, AR layers or social-first contexts. We deliver responsive logo behaviour (full mark, simplified, icon, motion) plus the rules that govern when each appears.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/services/design/brand-identity`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Brand Identity',
  description:
    'Brand identity systems built to scale: logo systems, color, typography, guidelines and rollout kits that hold together across every market and channel.',
  serviceType: 'Brand identity design',
  url: pageUrl,
  provider: { '@type': 'Organization', name: 'hubStudio', url: SITE },
  areaServed: 'Worldwide',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE}/services` },
    { '@type': 'ListItem', position: 3, name: 'Brand Identity', item: pageUrl },
  ],
};
---

<Layout
  title="AI-Native Brand Identity Design | hubStudio"
  description="AI-native brand identity built by art directors. Logo systems, colour, typography, guidelines and rollout kits that hold up across every market."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Brand Identity
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Brand</span></span>
            <span class="line"><span class="line__i serif">Identity</span></span>
            <span class="line"><span class="line__i">Design.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            One system. Every market. <em>Every channel.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most growth-stage brands already have a brand book. 184 pages,
              and almost nobody has opened it past page twelve. The PDF is
              not the system.
            </p>
            <p>
              We ship the working layer too. Art directors from 4A backgrounds
              run the direction. Brand-trained image models keep rollout
              inside the system. One sign-off, faster to market.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Identity + optional rollout
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/bi-hero.jpg"
          alt="A printed brand identity board on a warm plaster ledge: ink wordmark, three colour swatches, type card and an embossed business card."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Identity board</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              The economics moved.<br /><span class="serif">The bar</span> moved with them.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Two things broke at once. Production got fast and cheap for
              everybody. The generative AI design market topped a billion
              dollars in 2025, on a 31% annual growth curve through 2030. And
              the standard for recognition got harder, because identities now
              have to hold across feeds, app icons, AR layers, motion intros
              and AI-generated context, all in seconds.
            </p>
            <p class="r" style="--d:.16s">
              Companies that brought AI into identity work in 2025 reported
              design timelines down 40 to 60% and fewer revision rounds. The
              flip side, which we see in pitches almost every week now: when
              everyone uses the same base models, outputs converge.
              Designers call it AI sameness. The only defence is direction
              strong enough that the model amplifies your point of view
              instead of replacing it.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Identity work delivered for brands shipping across the
              <strong>US</strong>, <strong>EU</strong>, <strong>UK</strong>,
              <strong>Middle East</strong>, <strong>China</strong> and the
              rest of APAC.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/bi-roots.jpg"
              alt="One coordinated brand identity carried across a brand book, business card, mug, carton and a website hero on a phone."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">One identity, every surface</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across roughly thirty identity engagements in the last two years,
            clients reported creative approval rates lifted from 22% to 78%,
            content costs down 60%, and asset output 7x without a single new
            hire.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">brand system</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Identity studies and photoreal mockups, generated and finished in
            the studio. Every frame is authored work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · ROLLOUT (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/bi-production.jpg"
                alt="A designer at a monitor reviewing a brand identity layout, another designer pinning a printed proof to a fabric board behind them."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/bi-inspect.jpg"
              alt="Two hands reviewing a printed brand book proof: one holds a loupe over a wordmark, the other a pencil margin note."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">6&ndash;10 wks</span>
            <span class="source__stat-cap">Strategy to delivered system</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need the rollout too?<br />We can <span class="serif">produce</span> it.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients use the identity work as the
            foundation and roll it out through their existing studio or
            agency network. The brand book and Figma library are built to be
            picked up by another team on day one.
          </p>
          <p class="source__p r" style="--d:.16s">
            If you would rather we run production alongside the creative, we
            do that too. Packaging artwork, website assets, social templates,
            ad creative, retail collateral, presentation systems, coordinated
            through one team using the same brand-trained models that built
            the identity. The advantage is consistency. The same art
            director who approved the imagery direction is still on the work
            six months in, instead of a new freelancer trying to
            reverse-engineer the brand from the PDF.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Brand systems delivered into a Figma library by default, or
            handed off into Frontify, Bynder, Lingo or whichever DAM the
            client already uses. The trade-off is real: running production
            with us means depending on us for the rollout, which some
            clients prefer to avoid for resilience reasons. Both setups
            work.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Source files (Figma, Illustrator, InDesign, the trained image
            model) are yours on day one either way.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative direction first.<br />Production scale <span class="serif">second</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          AI made the production side fast for everybody. Picking the visual
          direction that is actually worth scaling is the part still hard,
          and where most of our hiring budget goes.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A growth-stage client lands with a full identity brief: strategy,
            logo system, colour, type, imagery and a working brand book. The
            same scope, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The agency workflow</span>
              <span class="vs__total">Sixteen weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Mid-tier agency timeline: four weeks for strategy and audit,
                five for direction, then seven on system, guidelines and
                first-round rollout. Three rounds of revision, partner time
                billed at full rate, junior teams running production.
                Heritage consultancies stretch the same scope across six to
                twelve months.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Six to ten weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Strategy to delivered system</span>
                  <span class="vs__seg-dur">Six to ten weeks</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Two or three directions worked through enough to choose
                between strategies, not moodboards. Hundreds of applications
                generated in parallel so you see the identity in real
                environments before anything locks. Refinement, master files,
                Figma library and rollout kit, art-director-led the whole
                way.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send us your<br />identity <span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Two strategic directions and a priced proposal inside two weeks. No
          retainer, no commitment, and whatever we produce is yours.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
