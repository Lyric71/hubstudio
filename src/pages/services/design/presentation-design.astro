---
/**
 * Presentation Design  ·  /services/design/presentation-design
 *
 * Same art direction as Packaging & Merchandise Design (the "Pressroom"
 * layout): print-production language framing editorial typography and a
 * studio-authored proof sheet. Copy is the v2 brief for presentation design:
 * sales decks, investor pitches, keynotes and QBRs, written in the studio's
 * editorial voice (Publicis-era anecdote, Shiseido font story, Storydoc /
 * Gartner / Templafy data, three industry shifts).
 *
 * Process step numerals are intentionally dropped per the repo's no-numbers
 * rule. Shift cards likewise carry no ordinal labels: tool names only. All
 * imagery sits in /public/Images and is presentation-design context (slide
 * decks, presenters, boardrooms, multi-market variants).
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio sample decks, each with an invented brand mark and a deck type. */
const samples = [
  {
    src: '/Images/pd-deck-nimbus.jpg',
    brand: 'Nimbus',
    kind: 'SaaS Series B investor deck',
    alt: 'Open laptop on a sunlit desk showing a clean Nimbus investor deck title slide with a single data visualization.',
  },
  {
    src: '/Images/pd-deck-ferran.jpg',
    brand: 'Ferran',
    kind: 'Industrial OEM sales enablement',
    alt: 'A sales engineer in a daylit factory holding a rugged tablet with a Ferran sales slide and a technical diagram.',
  },
  {
    src: '/Images/pd-deck-tako.jpg',
    brand: 'Tako',
    kind: 'QSR franchise QBR',
    alt: 'A franchise owner reviewing a Tako quarterly business review slide on a tablet at the counter of a small restaurant.',
  },
  {
    src: '/Images/pd-deck-verge.jpg',
    brand: 'Verge',
    kind: 'Luxury watch keynote',
    alt: 'Dark keynote hall with a single LED wall showing a Verge watch hero slide and a presenter silhouette at the edge.',
  },
  {
    src: '/Images/pd-deck-lumeo.jpg',
    brand: 'Lumeo',
    kind: 'Fintech all-hands',
    alt: 'A Lumeo all-hands meeting room with employees facing a projected quarterly results slide on the front wall.',
  },
  {
    src: '/Images/pd-deck-helia.jpg',
    brand: 'Helia',
    kind: 'Pharma sales kit, EMEA',
    alt: 'A pharmaceutical sales rep in a clinical lobby reviewing a Helia product slide on a tablet held in her lap.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-project results, drawn from the source quote. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'First-round approval', note: 'Up from 22% on rushed builds' },
  { from: 0, to: 60, suffix: '%', label: 'Lower deck cost', note: 'Versus per-slide agency rates' },
  { from: 0, to: 7, suffix: 'x', label: 'More variants shipped', note: 'Same brand integrity' },
];

/* The two coverage lanes. Pitch decks are theater. Programs are reference. */
const coverage = [
  {
    fig: 'B',
    label: 'Pitch decks',
    heading: 'Pitch decks built for the room.',
    image: '/Images/pd-pitch.jpg',
    alt: 'A dark slate laptop on a travertine surface showing a clean pitch deck title slide in deep navy with a warm orange accent.',
    lead: 'Theater. Sales decks, investor pitches, keynote stage decks.',
    body: [
      "Sales pitch decks built on the Pyramid Principle: lead with the answer, three supporting points, evidence on demand. Most land between ten and fourteen slides. That is not doctrine about length, that is where the data on completion rates sits.",
      "Investor decks are the work most founders dread, and not without reason. Seed through Series C have different demands, the financial slides need actual scrutiny rather than rubber-stamping, and there is usually a CFO involved by the second round. NDAs signed before the brief if you want them.",
      "Keynote stage decks for sixteen-foot LED walls: presenter pacing, full-bleed photography, one idea per slide. We design for the back of the room, not the front of the laptop.",
    ],
    tags: [
      'Sales pitch decks', 'Investor decks', 'Seed to Series C',
      'Keynote stage decks', 'Pyramid order', 'Action titles',
      'Full-bleed photography', 'Presenter pacing',
    ],
  },
  {
    fig: 'C',
    label: 'Programs',
    heading: 'Programs that hold up under daily use.',
    image: '/Images/pd-programs.jpg',
    alt: 'Top-down view of a laptop, two tablets and a printed deck booklet on a walnut desk, each showing a different slide layout in a consistent palette.',
    lead: 'Reference. Sales enablement libraries, board decks, QBRs.',
    body: [
      "Sales enablement libraries are the long tail of the business. Battlecards, persona one-pagers, objection decks, QBR templates that reps actually open. The hard part is not the design, it is governance: who edits what, how variables get locked, where the master file lives, and what happens when a product team updates pricing without telling marketing.",
      "Board decks and QBRs with linked Excel tables, footnoted assumptions, and an executive summary that lets a board member skip to slide four without losing the thread. Every slide ships on a master with proper placeholder hierarchy and theme fonts that survive Mac to PC.",
    ],
    tags: [
      'Sales enablement', 'Battlecards', 'QBR templates',
      'Persona one-pagers', 'Objection decks', 'Board decks',
      'Linked Excel charts', 'Footnoted assumptions',
    ],
  },
];

/* Localization credentials. */
const credentials = ['Editable .pptx & .key', 'RTL ready', 'In-region transcreation', 'NDA in place'];

/* Process steps. Numerals dropped per the no-numbers rule; the source says
   the narrative locks before any slide is designed, so brief + narrative are
   the won-tier and the rest is execution. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and discovery.',
    body: 'Audience, decision needed in the room, biggest objection, brand guidelines, existing deck library. A forty-five minute call and a shared Drive folder.',
    image: '/Images/pd-p1-brief.jpg',
    alt: 'An open notebook, a fountain pen and a printed agenda sheet on a warm walnut desk under late afternoon window light.',
  },
  {
    short: 'Narrative',
    tier: 'Where it is won',
    title: 'Narrative lock. The step that matters most.',
    body: 'A senior art director and a senior copywriter write the action-title outline with the client lead. One title per slide, complete sentences, Pyramid order. No design starts until the outline is signed off.',
    image: '/Images/pd-p2-narrative.jpg',
    alt: 'A whiteboard covered in handwritten action titles in marker, organized as a slide outline with arrows and short notes, photographed at an angle in studio daylight.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration.',
    body: 'Three to five visual directions generated in parallel using Midjourney, custom LoRAs and Beautiful.ai. The client picks one from a short PDF, not from a live tool.',
    image: '/Images/pd-p3-aigc.jpg',
    alt: 'A wide studio monitor displaying a grid of nine slide layout variations of the same title slide.',
  },
  {
    short: 'Production',
    tier: 'The rest is execution',
    title: 'Production and QA.',
    body: 'Senior designer builds the master in the chosen direction. Charts linked back to source data. Fonts embedded properly. Cross-platform QA runs on a Mac, a Windows machine and at least one mobile preview before anything goes out.',
    image: '/Images/pd-p4-production.jpg',
    alt: 'A designer at a workstation with two studio monitors, a slide deck in progress on one and a linked Excel sheet on the other.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation at scale.',
    body: 'Multi-language versions plus market variants. Aspect-ratio swaps for the stage cut, the print version and the social cutdown. Edge-case slides to cover the sales team\'s awkward outliers.',
    image: '/Images/pd-p5-adapt.jpg',
    alt: 'Four printed deck proof sheets and two tablets arranged in a soft fan on a warm walnut desk, each showing the same slide in a different language and aspect ratio.',
  },
];

/* Three real shifts from the last eighteen months. No ordinals: tool names
   carry the structure per the no-numbers rule. */
const shifts = [
  {
    tool: 'Microsoft Copilot',
    title: 'Narrative Builder went mainstream.',
    body: 'Microsoft shipped Narrative Builder inside PowerPoint Copilot in late 2024 and rolled it broadly into enterprise tenants through 2025. It generates an outline from a Word brief, then populates layouts using imagery from the client\'s SharePoint asset library. Templafy, which works alongside it, has reported investor-deck build cycles dropping sharply on accounts running both tools together.',
  },
  {
    tool: 'Gamma 3.0',
    title: 'Variant generation got cheap, and obvious.',
    body: 'Gamma launched 3.0 in September 2025 and repositioned itself from "AI slides" to a full visual storytelling platform. The headline feature, Gamma Agent, is an AI design partner that restyles decks through natural-language prompts. Enterprise adoption followed, then the reviews started catching up: Capterra has it at 3.7, Trustpilot at 2.0. The pattern is consistent: output starts to look the same after the third or fourth deck. Which is exactly the problem dedicated design still solves.',
  },
  {
    tool: 'Beautiful.ai + Claude',
    title: 'Iteration replaced one-shot generation.',
    body: 'Beautiful.ai integrated Anthropic\'s Claude models last year and rebuilt its Create with AI workflow around iterative refinement: low-fidelity outline first, lock the structure, then commit to design. The shift matters because it admits something the first generation of these tools got wrong. Nobody nails the deck on the first try, and the value sits in the second pass or the third.',
  },
];

/* FAQ: wording adapted from the v2 source with the studio's editorial voice
   intact (Publicis anecdote, "we will be honest", "what if the deck doesn't
   land"). */
const faqs = [
  {
    q: 'How long does a project take?',
    a: "A ten to twenty-slide deck is five working days from signed brief. Multi-market sales enablement libraries with 80+ slides and language variants run two to three weeks. Same-day rush is possible on smaller decks. We will be honest about whether it is realistic before we quote.",
  },
  {
    q: 'What does it cost?',
    a: "It depends on scope, format range and language coverage, which is the honest answer though we know it is not the satisfying one. We do not price per slide because the narrative work does not scale that way, and we do not publish a rate card because no two briefs cost the same. After a forty-five minute call we send a firm quote built from the actual brief, not from a template. If the budget does not fit, we say so quickly rather than waste your time on the back and forth.",
  },
  {
    q: 'How many revisions are included?',
    a: 'Three rounds in the standard project quote. Most decks close in two because the narrative locks before any slide is designed. Beyond three rounds we quote hourly, and we flag when a project is heading that way before the bill arrives.',
  },
  {
    q: 'What do I need to send to get started?',
    a: "Brand guidelines, your master template if you have one, two or three recent decks you have shipped, the audience for the pitch and the decision you need them to make in the room. If brand guidelines do not exist, we work from your website and recent ad creative, and we build a system as part of the first project.",
  },
  {
    q: 'Who actually does the work?',
    a: 'A senior art director with 12+ years of agency or in-house experience leads every brief and writes the outline themselves. Production designers build under their direction. AIGC engineers handle imagery and the LoRA training when the project needs it. No junior teams running the brief alone, no offshore production farms. The briefs that go sideways always go sideways at the same point: when the senior leaves and the junior takes over. We do not staff that way.',
  },
  {
    q: 'Will the work look like us, or like you?',
    a: "Like you. We train on your brand assets at the start of the engagement, and the master template gets locked before slide design begins. If you do not have a strong brand system, we build one as part of the first project and hand the master file over so your internal team stays on brand after we are done.",
  },
  {
    q: 'What about copyright on AI work?',
    a: 'You own the deliverables outright. We use commercially safe models (Midjourney Pro, Flux Pro, custom-trained LoRAs on your assets), and the generation workflow is documented in a one-pager that travels with the file in case legal asks. Our Copyright and AI guide covers the current state in detail.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle a multi-market campaign, or just one deck?',
    a: "Both. The smallest engagement is a single twelve-slide pitch deck. The biggest we have run was a sales enablement library across fourteen EMEA markets with localized imagery, properly transcreated copy and four aspect-ratio variants per slide. The language work happens in-region, not in a single translation pass.",
  },
  {
    q: 'Editable files, or just PDFs?',
    a: 'Editable .pptx and .key files, with master slides, layout variants, embedded fonts and linked data sources where charts pull from Excel or Sheets. PDFs only if you specifically request export-only delivery. Your team can edit on the first pass.',
  },
  {
    q: 'Where are you based?',
    a: 'Production teams in Shanghai and the Philippines, with senior creative leads in Paris and Hong Kong. The overlap between those four locations means there is working coverage across roughly fourteen hours of every weekday. We ship into around thirty-five markets, and where languages need cultural review (not just translation) we bring in-region reviewers rather than rely on a single linguist.',
  },
  {
    q: "What if the deck doesn't land?",
    a: "Three rounds of revisions are in scope, so if the first direction misses we still have room to course correct. Beyond that, if the pitch lands flat, the file is yours regardless. We would rather hear the feedback and learn from it than walk away with the kill fee.",
  },
  {
    q: 'What if we already have a template we want to keep?',
    a: "Fine. We build on your master, match the system and step back. We can audit the existing template and flag what is broken if you want, but we do not push rewrites unless that is the actual problem you are solving.",
  },
  {
    q: 'Can we start small?',
    a: 'Yes. Send one deck brief. Five working days later you get the finished deck and an estimate for the next one. No retainer, no commitment, and if it does not land you keep the file anyway.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="AI-Native Presentation Design | hubStudio"
  description="AI-native presentation design for sales decks, investor pitches, and keynotes. Senior leads, editable PowerPoint and Keynote, 35+ markets."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Presentation
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Presentation</span></span>
            <span class="line"><span class="line__i serif">Design.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Built for the room. <em>In every language.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Friday afternoon. The biggest renewal of the quarter pitches
              Monday. The deck is the same template recycled for three
              years, forty-six slides, two about the prospect. The team is
              on its third emergency rebuild this month. The renewal gets
              pitched on the old deck anyway. It does not close.
            </p>
            <p>
              We hear that story most months. So we run presentation design
              as a production line, not a craft hobby. Senior designers own
              the narrative, AI handles the volume, and the brand system
              holds up when six people edit the same deck at once, which
              they will.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> PowerPoint &amp; Keynote, 35+ markets
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/presentation-design-hero.jpg"
          alt="An open laptop on a warm walnut desk showing a single clean deck slide with a minimalist growth chart, lit by afternoon window light."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Nimbus</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              The room hasn't<br /><span class="serif">gone away</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Buyers do most of their research before talking to a sales rep.
              The meeting still happens though, and the deck still walks into
              the buying committee.
            </p>
            <p class="r" style="--d:.16s">
              Storydoc found that 82% of viewers who get through the first
              three slides finish the deck, and personalized decks get shared
              internally 2.3 times more often than generic ones. Gartner has
              the average B2B decision running through six to ten
              stakeholders. Your champion almost never signs.
            </p>
            <p class="r" style="--d:.2s">
              The deck is what walks into the room after your call is over,
              and it either sells the meeting you just had or undoes it. We
              have sat through win-loss reviews where a deal got marked down
              to "price" when the actual reason was that the competitor's
              deck made them look like the safer hire. That cost shows up
              nowhere on the scoreboard.
            </p>
            <p class="why__clients r" style="--d:.26s">
              Coverage so far: <strong>SaaS</strong>, <strong>industrial OEM</strong>,
              <strong>QSR</strong>, <strong>luxury</strong>, <strong>fintech</strong>
              and <strong>pharma</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/pd-room.jpg"
              alt="A corporate boardroom from the side, four people watching a deck on a wall-mounted screen at the end of the long oak table."
              width="1600"
              height="900"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The room still wins</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across the deck work we have shipped over the last eighteen
            months, the projects where clients tracked outcomes show a
            consistent pattern: first-round approval rose from 22% to 78%,
            deck cost fell 60% versus per-slide agency rates, and we shipped
            seven times more variants per quarter without losing brand
            integrity.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">brand system</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            A twelve-slide investor pitch and a ninety-slide training library
            share almost nothing in their craft. One is theater. The other is
            a reference document. We staff each lane with designers who have
            done it before.
          </p>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Studio decks for invented brands across the six categories we
            ship most. Every frame is authored work, not a stock pull, and
            every slide is editable on the original master.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · LOCALIZATION ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/pd-localized.jpg"
                alt="A laptop, two tablets and printed proofs on a walnut desk showing the same deck slide laid out in different languages."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/pd-localized-inset.jpg"
              alt="Hands holding a tablet showing a localized slide in a non-Latin script."
              width="600"
              height="600"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">35+ mkts</span>
            <span class="source__stat-cap">Editable files in every language we ship</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Built-in capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it in fourteen markets?<br />Same <span class="serif">team</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Most brands run language work through a separate translation
            agency. Three weeks, two contracts, a deck that no longer reads
            like the brand by the time the local sales team gets it.
          </p>
          <p class="source__p r" style="--d:.16s">
            We run the language work in-house. Mandarin, Japanese, Korean,
            Arabic, right-to-left layouts. In-region writers, not a single
            translation pass. The deck reads like it was authored in the
            market. Layouts and fonts rebuild for character width and reading
            order without breaking the master.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            The biggest engagement we have run is a sales enablement library
            across fourteen EMEA markets with localized imagery, properly
            transcreated copy and four aspect-ratio variants per slide. The
            smallest is a single twelve-slide pitch deck.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already have a translation partner, no problem. We hand
            over editable masters and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Narrative is where<br />it's <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          The technical side of slide-making is cheap now. Building a
          narrative that survives twelve stakeholders and three rounds of
          legal is the part that is still hard, and it is where we spend most
          of our hiring budget. Most agencies treat a deck like a deliverable
          and brief Monday, draft Friday in brand colors. Then forty-seven
          edits come back, somewhere around edit thirty the narrative spine
          breaks, and what ships is a mess. We invert that whole thing.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THREE SHIFTS / hub4You ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>What changed</p>
          <h2 class="dh r" style="--d:.05s">
            Three shifts that<br />changed <span class="serif">deck design</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            The deck-design business has changed more in 2024 and 2025 than
            it did in the previous decade. Three shifts in particular shape
            what we charge for now, and where the work actually adds value.
          </p>
        </header>

        <div class="shifts">
          {
            shifts.map((s, i) => (
              <article class="shift r" style={`--d:${i * 0.08}s`}>
                <span class="shift__tag">{s.tool}</span>
                <h3 class="shift__title">{s.title}</h3>
                <p class="shift__body">{s.body}</p>
              </article>
            ))
          }
        </div>

        <figure class="pullquote r" style="--d:.2s">
          <blockquote>
            The fastest I could create a solid PowerPoint for a client was
            five days. Now it is cut in half.
          </blockquote>
          <figcaption>
            <span class="pullquote__cite">Templafy customer testimonial</span>
            <span class="pullquote__src">AI Pitch Deck whitepaper, 2025</span>
          </figcaption>
        </figure>

        <p class="shifts__close r" style="--d:.24s">
          The tools shortened production. They did not shorten the thinking.
          That is what we still sell.
        </p>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Quarterly to <span class="serif">weekly</span>.
            </h3>
            <p class="hub__text">
              For brands running a deep sales enablement library, we deploy
              hub4You, our custom AI agent setup trained on your own brand
              system and master template. It generates on-brand slide
              variants and market localizations on demand, and connects
              directly to your DAM and PIM so the output lands where your
              team already works. That is the gap between updating decks
              quarterly and updating them weekly.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4presentation.jpg"
                alt="The hub4You platform generating on-brand slide variants from a master deck and a language list."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us a presentation job. Inside five working days you get a
          finished deck in editable PowerPoint and Keynote, with the source
          files and the linked data. No retainer. No commitment. Whatever we
          produce is yours.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
    display: grid;
    gap: 18px;
  }
  .band--split {
    max-width: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .band--split {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 18px 60px;
    }
    .band--split > div {
      display: grid;
      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .band__note--light {
    color: rgba(240, 237, 233, 0.76);
  }

  /* Calibration colour bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }
  .cbar--end {
    margin-top: clamp(60px, 8vw, 110px);
  }

  /* ===================== S1 · Hero ===================== */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__panel {
