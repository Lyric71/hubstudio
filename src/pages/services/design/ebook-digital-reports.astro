---
/**
 * Ebooks & Digital Reports  ·  /services/design/ebook-digital-reports
 *
 * Art direction: "Editorial proof." The page reads like a publisher's
 * register sheet. Crop marks, a calibration colour bar, mono figure
 * labels and dashed rules frame editorial typography and the studio's
 * own report and whitepaper photography.
 *
 * Copy from ebooks-digital-reports-page.md. Process step numerals are
 * intentionally dropped: the project's permanent "no numbers in cards /
 * step lists" rule overrides the source numbering. All imagery sits in
 * /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio report photography, each with an invented brand mark. */
const samples = [
  {
    src: '/Images/edr-sample-aldenmar.jpg',
    brand: 'Aldenmar',
    kind: 'State-of-industry report',
    alt: 'Hardback industry research report with a forest-green linen cover and a gold-foiled Aldenmar wordmark, on charcoal stone.',
  },
  {
    src: '/Images/edr-sample-maru.jpg',
    brand: 'Maru',
    kind: 'Pharma whitepaper series',
    alt: 'Three slim cream softcover pharma whitepapers stacked under a small Maru wordmark, on pale grey linen.',
  },
  {
    src: '/Images/edr-sample-verdant.jpg',
    brand: 'Verdant Ridge',
    kind: 'CSRD impact report',
    alt: 'Thick kraft-cover sustainability report letterpressed with a Verdant Ridge wordmark and a small leaf glyph, on weathered oak.',
  },
  {
    src: '/Images/edr-sample-polaria.jpg',
    brand: 'Polaria Group',
    kind: 'Investor annual review',
    alt: 'Black linen-bound annual review with a silver-foiled Polaria Group wordmark, on a dark walnut conference table.',
  },
  {
    src: '/Images/edr-sample-nyloft.jpg',
    brand: 'Nyloft',
    kind: 'Consumer trends study',
    alt: 'Coral-orange softcover consumer trends study printed with a black Nyloft wordmark, beside an open spread of data charts.',
  },
  {
    src: '/Images/edr-sample-halberd.jpg',
    brand: 'Halberd',
    kind: 'Sales enablement trilogy',
    alt: 'Three navy linen sales enablement ebooks printed with a white Halberd wordmark, fanned out on matte black.',
  },
];

/* Calibration colour bar: a publisher's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Engagement and economics from the source quote. */
const stats = [
  { from: 0, to: 6.8, suffix: '%', label: 'Gated conversion rate', note: 'Against a 4.7% B2B benchmark' },
  { from: 0, to: 62, suffix: '%', label: 'Lower production cost', note: 'On recurring report programs' },
  { from: 0, to: 3, suffix: 'x', label: 'Faster to publish', note: 'Versus a traditional editorial agency' },
];

/* The two coverage lanes. Tag rows surface formats named in the prose. */
const coverage = [
  {
    fig: 'B',
    label: 'Thought leadership',
    heading: 'What we cover on thought leadership.',
    image: '/Images/edr-feature-thought.jpg',
    alt: 'An open softcover whitepaper on linen, showing a serif headline and a single hero chart.',
    body: [
      'Ebooks, lead-gen guides, whitepapers, research reports, industry and trend studies. The formats that earn the gated download and start the buying conversation. NetLine puts ebooks at 53% of B2B content registrations; whitepapers convert downloads to leads at roughly 7%, against 3% for webinars. We design every page around that read.',
      'You get an editorial system, not a template. Thesis per chapter, hero data viz per spread, a sample spread inside week one. The same direction extends into LinkedIn carousels, executive summary one-pagers and the email sequence that follows the download.',
    ],
    tags: [
      'Ebooks', 'Lead-gen guides', 'Whitepapers', 'Research reports',
      'Industry studies', 'Trend reports', 'Executive summaries',
      'Social cutdowns', 'Landing pages',
    ],
  },
  {
    fig: 'C',
    label: 'Corporate & enablement',
    heading: 'What we cover on corporate and enablement.',
    image: '/Images/edr-feature-corp.jpg',
    alt: 'A navy linen annual report and a closed pitch deck on a polished concrete table in late afternoon light.',
    lead: 'The reports your board, your investors and your sales team rely on.',
    body: [
      'Annual and ESG reports, investor presentations, pitch decks, sales enablement and onboarding ebooks. 94% of Russell 1000 companies now publish on sustainability; the EU Omnibus I narrowed CSRD scope but kept the disclosure stakes high. We build to ESRS, ISSB and the relevant local framework, with citation discipline and an accessible PDF by default.',
      'Investor decks built the MBB way: action titles, charts that read in ten seconds, alignment grids across sixty slides. Sales enablement and onboarding work get the same editorial standard as the flagship report, not template fill.',
    ],
    tags: [
      'Annual reports', 'ESG & CSRD', 'Investor presentations',
      'Pitch decks', 'Sales playbooks', 'Battle cards', 'Onboarding ebooks',
      'Board materials', 'Pre-IPO reporting',
    ],
  },
];

/* Distribution and analytics: format options surfaced as credentials. */
const credentials = ['WCAG 2.1 AA', 'PDF/UA', 'HubSpot', 'Marketo', 'Salesforce'];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   own "first two steps are where it's won" sets each step's tier. */
const processSteps = [
  {
    short: 'Brief & data',
    tier: 'Where it is won',
    title: 'Brief, thesis and data audit.',
    body: 'Format, distribution plan, framework requirements (CSRD, ESRS, ISSB where relevant), citation check.',
    image: '/Images/edr-p1-brief.jpg',
    alt: 'A senior editor at a wooden worktable spreading out research printouts, data sheets and a draft brief beside a bound report.',
  },
  {
    short: 'Editorial direction',
    tier: 'Where it is won',
    title: 'Editorial direction. The step that matters most.',
    body: 'Thesis, chapter structure and cover concept locked before design begins. This is the call that decides whether the report carries the buying committee or stalls on page three.',
    image: '/Images/edr-p2-direction.jpg',
    alt: 'A senior editor studies a single sample spread mocked up on a studio wall, showing the thesis and one hero chart.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration.',
    body: 'Dozens of cover and spread directions in parallel, mocked photoreal in context.',
    image: '/Images/edr-p3-aigc.jpg',
    alt: 'A designer arranging a grid of dozens of cover and spread direction proofs across a daylit worktable.',
  },
  {
    short: 'Refinement',
    tier: 'The rest is execution',
    title: 'Refinement and prepress.',
    body: 'Typography, accessibility tagging, alt text, PAC verification.',
    image: '/Images/edr-p4-refine.jpg',
    alt: 'A designer\'s monitor showing an InDesign layout with accessibility tagging panels open beside a printed PAC verification sheet.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation at scale.',
    body: 'Market variants, language localization, executive summary, social cutdowns.',
    image: '/Images/edr-p5-adapt.jpg',
    alt: 'One report shown in three language editions and a smaller executive summary, lined up on a daylit table.',
  },
];

/* The process splits into two tiers: the steps where the project is won, and
   the steps that are execution. Each renders in its own block below. */
const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* The old agency timeline, split into the phases the copy names. */
const oldPhases = [
  { label: 'Research synthesis', dur: 'Four weeks', span: 4 },
  { label: 'Editorial drafts', dur: 'Four weeks', span: 4 },
  { label: 'Design & production', dur: 'Four weeks', span: 4 },
];

/* FAQ: wording aligned with the source MD; one answer links to the
   Copyright guide. */
const faqs = [
  {
    q: 'How long does an ebook or report take?',
    a: 'Two weeks for a 20 to 40 page ebook from brief to final files. Three to four weeks for a 60 to 100 page report. Four to six weeks for a full annual or ESG report with framework alignment. Faster on extensions of an existing series. You see a sample spread inside week one regardless of format.',
  },
  {
    q: 'How does engagement work?',
    a: 'Project-based for one-off ebooks, whitepapers and reports. Monthly retainer for ongoing report programs or quarterly research series. Three rounds of revisions sit inside the standard scope, and we rarely need more once the editorial direction is locked at step two of the process.',
  },
  {
    q: 'How do you measure success?',
    a: 'On the marketing-ops side: gated landing page conversion rate, download-to-read rate, page-by-page engagement heatmap, MQL-to-SQL conversion on leads sourced from the asset, time-on-page in the flipbook. On the editorial side: completion rate. The Jellybooks benchmark for non-fiction long-form considers anything above 50% very good, and 25 to 50% solid.',
  },
  {
    q: 'What do I need to send to get started?',
    a: 'Brand guidelines if you have them. The thesis or research question if it is clear, or the raw research if it is not yet. Final or near-final copy, or a draft we can edit. Source data for any charts, in spreadsheet form. Citation list. CEO or executive foreword copy if it applies. Reference reports you like or want to avoid. If brand guidelines do not exist, we work from what does and flag the gaps.',
  },
  {
    q: 'How do you handle confidentiality and NDAs?',
    a: 'Standard. We sign your NDA before the first working session and route all draft files through a permissioned workspace, not email. For listed companies and material non-public information, the protocol tightens: named-only access, redacted draft circulation outside the core team, and no AI training on the underlying data. The studio has worked under those rules on investor relations and pre-IPO reporting.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior editors from consulting and publishing backgrounds lead every project. Art directors with editorial design experience handle layout and visual identity. Data visualization specialists handle charts. AI specialists handle the production volume. No junior teams running the brief alone.',
  },
  {
    q: 'Will the report look like us, or like you?',
    a: 'Like you. We train our AI on your existing brand assets and prior reports, so the output stays inside your visual system rather than ours. For brands without a documented system, we build one as we go and hand it over with the files. The system is yours to keep regardless of whether you continue with us.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models, document the workflow, and editorial illustration generated with Firefly carries Adobe Content Credentials when the brief calls for it. For the legal side in full, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle a full report program, or just one report?',
    a: 'Both. Some clients come to us for one flagship annual report. Others come with a quarterly research series across three languages, plus the executive summary, the LinkedIn carousels, and the sales enablement extracts. The workflow scales either way.',
  },
  {
    q: 'Do you deliver interactive flipbooks, accessible PDF, or print-ready files?',
    a: 'All three, depending on the brief. The default is a WCAG 2.1 AA accessible PDF plus an interactive HTML5 flipbook for the digital launch. We add a print-ready CMYK version when the report doubles as an investor or board document. The flipbook ships with page-by-page engagement analytics, optional embedded lead capture, and a clean CRM handoff.',
  },
  {
    q: 'Where are you based, and can you handle China specifically?',
    a: 'Our production team is based in Shanghai, and we produce reports for clients shipping into the US, EU, UK, Middle East and APAC. For China specifically, we handle ICP-licensed hosting, WeChat-native distribution through Official Accounts and Mini Programs, Baidu indexing, and the editorial localization that matters for regulated industries.',
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one brief. Inside two weeks you get three editorial directions and a sample spread. No retainer, no commitment, the work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Ebook & Report Design | AI-Native | hubStudio"
  description="Editorial-grade ebook, whitepaper and report design for B2B brands. Senior editors lead, data viz built in, accessible PDF and flipbook, two weeks."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Ebooks &amp; Digital Reports
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Ebooks &amp;</span></span>
            <span class="line"><span class="line__i serif">Digital</span></span>
            <span class="line"><span class="line__i">Reports.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Editorial reports your buying committee <em>actually finishes</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most studios design first, edit second. We work the other way.
              Thesis before layout. Chapter logic before typography.
            </p>
            <p>
              Senior editors with consulting and publishing backgrounds lead
              every project, with data viz treated as the spine, not decoration.
              Accessible PDF and interactive flipbook by default.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Editorial design + analytics
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/edr-hero.jpg"
          alt="Hardcover bound annual report lying open on a warm walnut desk, showing typeset columns and a single clean data chart."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Polaria Group</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Why our publishing<br /><span class="serif">roots</span> matter.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              A mid-market software firm spent four months on a sixty-four-page
              state-of-the-industry report. Fourteen hundred respondents, a
              thesis a year in the making. Then the analytics came back: median
              read time, forty-seven seconds. Charts unreadable below 200% zoom
              on the mobile devices where 61% of opens happened.
            </p>
            <p class="r" style="--d:.16s">
              We hear some version of that most months. NetLine puts the
              average B2B buyer at 47.7 hours between requesting content and
              opening it. So we work backwards from the reading experience.
              Thesis first, chapter logic second, design third.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Past work has landed in <strong>the US</strong>,
              <strong>the EU</strong>, <strong>the UK</strong>,
              <strong>the Middle East</strong> and <strong>APAC</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/edr-roots.jpg"
              alt="A professional at a sunlit cafe window seat reading a PDF report on their smartphone."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The forty-seven-second test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            73% of B2B decision-makers say an organization's thought leadership
            is a more trustworthy basis for assessing its capabilities than its
            marketing materials.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            One editorial system,<br /><span class="serif">every</span> long-form format.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Covers and spreads from recent report and ebook engagements,
            generated and finished in the studio. Every frame is authored work,
            not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · DISTRIBUTION (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/edr-flipbook.jpg"
                alt="A laptop on a daylit desk showing an interactive HTML5 flipbook of a report with a faint engagement heatmap overlay."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/edr-inspect.jpg"
              alt="Two hands reviewing a printed proof of a research report, with a red editing pen resting on a chart."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">+52%</span>
            <span class="source__stat-cap">MQL to SQL versus static PDF</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it distributed too?<br />We can <span class="serif">flipbook</span> it.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients come to us for the editorial
            and design. But if you also want to ship it as an interactive
            asset, we can pick it up from there.
          </p>
          <p class="source__p r" style="--d:.16s">
            We package the report as an interactive HTML5 flipbook with
            embedded lead capture, page-by-page engagement heatmaps, and a
            clean handoff into HubSpot, Marketo or Salesforce. Interactive
            gated assessments now convert MQL to SQL at rates 52% higher than
            static PDF downloads. Accessibility is built in by default: WCAG
            2.1 AA, tagged structure, PDF/UA verified before delivery.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            For clients shipping into China, we run a WeChat-native variant
            with Official Account articles, Mini Program gating and
            ICP-licensed hosting. Editorial localization is handled in-region
            where regulatory framing or sensitive financial copy demands it.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already own the distribution stack, no problem. We deliver
            the accessible PDF and the print-ready CMYK file and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Editorial direction is<br />the <span class="serif">spine</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Most studios sell process. We sell the editorial call. AI made the
          technical side cheap and fast for everyone. It did not replace the
          eye that picks which thesis is actually worth a hundred pages.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with a sixty-four-page state-of-the-industry report,
            fourteen hundred respondents, sixty charts, three regional editions.
            The same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Twelve weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief an editorial agency, four weeks for
                research synthesis, four for editorial drafts, four for design
                and production. Twelve weeks, three or four rounds, and a tired
                team that never quite gets to the executive summary.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Two weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to first draft</span>
                  <span class="vs__seg-dur">Two weeks</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: editorial direction locked in week one, sample
                spread on the table by day five. Cover and spread variants
                explored photoreal in parallel. Language editions and
                executive cutdowns generated from the same master, not
                rebuilt from scratch. Accessibility tagging baked into the
                source file, not retrofitted at the end.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Twelve questions,<br /><span class="serif">answered</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before the first call. If yours is not here,
            put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          See it on your<br />own <span class="serif">thesis</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us a brief. Inside two weeks you get three editorial directions
          and a sample spread. No retainer, no commitment. The work is yours
          to keep either way, and if you decide to go elsewhere it gives you
          a sharper brief to hand to the next studio.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
