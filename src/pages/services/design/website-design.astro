        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Twenty-two weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
