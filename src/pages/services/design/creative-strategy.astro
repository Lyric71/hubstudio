---
/**
 * Creative Strategy  ·  /services/design/creative-strategy
 *
 * Mirrors /services/design/packaging-merch-design and
 * /services/design/brand-identity: same "Pressroom" art direction (crop
 * marks, calibration colour bar, mono figure labels) adapted to strategy
 * work. Copy from creative-strategy-page.md, folded into the existing
 * nine-section layout. Process step numerals dropped per the no-numbers
 * rule. Pricing softened per the no-pricing-on-site rule.
 *
 * Imagery lives in /public/Images with the cs- prefix.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Six invented sample strategy specimens, one per category named in
   the source studio-samples list. */
const samples = [
  {
    src: '/Images/cs-sample-aldair.jpg',
    brand: 'Aldair',
    kind: 'FMCG positioning platform',
    alt: 'A printed Aldair positioning statement card with a category map and three colour chips, on a warm worktable.',
  },
  {
    src: '/Images/cs-sample-norven.jpg',
    brand: 'Norven',
    kind: 'Beverage messaging architecture',
    alt: 'A folded Norven messaging house diagram, value props, proof points and a tagline bank, photographed flat.',
  },
  {
    src: '/Images/cs-sample-pelora.jpg',
    brand: 'Pelora',
    kind: 'Beauty voice and codes',
    alt: 'Three Pelora voice-principle cards beside printed colour swatches and a typography specimen, on a sand stoneware tray.',
  },
  {
    src: '/Images/cs-sample-mereth.jpg',
    brand: 'Mereth',
    kind: 'Consumer tech prompt system',
    alt: 'A printed Mereth prompt library card stack with a labelled reference pack and exclusion list, on a studio table.',
  },
  {
    src: '/Images/cs-sample-astrel.jpg',
    brand: 'Astrel',
    kind: 'Fashion campaign platform',
    alt: 'A printed Astrel campaign platform board with key visual frames and territory headlines, leaned against a plaster wall.',
  },
  {
    src: '/Images/cs-sample-vellen.jpg',
    brand: 'Vellen',
    kind: 'Hospitality content strategy',
    alt: 'A Vellen content strategy spread on a worktable, channel matrix, content pillars and editorial calendar laid out.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Results stats, from the source's 30-engagement Q1 2024–Q1 2026 cohort. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'Creative approval rate', note: 'Up from 22% baseline' },
  { from: 1, to: 3, suffix: 'x', label: 'Brief-to-asset cycle', note: 'On follow-on production' },
  { from: 0, to: 60, suffix: '%', label: 'Lower content cost', note: 'On platform-built campaigns' },
];

/* Two coverage lanes. The seven lanes in the source brief group into the
   brand foundation (positioning, codes, messaging, voice) and the working
   layer AI tools actually consume (prompts, campaign platforms, content
   frameworks). Keeping the two-feature layout means the lanes have to
   group, not list. */
const coverage = [
  {
    fig: 'B',
    label: 'Foundation',
    heading: 'The brand AI needs to recognise.',
    image: '/Images/cs-cover-foundation.jpg',
    alt: 'A studio still life of strategic foundation artifacts: positioning statement card, distinctive code swatches, voice principles printed flat.',
    body: [
      'Brand positioning, distinctive brand codes, messaging architecture, voice and tone. Statement, narrative, competitive and whitespace map, plus the category entry points (the 7W framework researchers at Ehrenberg-Bass keep being right about). The three to five sensory assets your category recognises before the logo lands. A messaging house with value props, proof points, an elevator pitch, taglines, and a working lexicon of words to use and words to ban.',
      'Voice principles, register by channel, sample sentences for the formats you ship most. Tight enough that a prompt holds the voice across a 200-asset rollout without drifting into the category average.',
    ],
    tags: [
      'Positioning', 'Category entry points', 'Distinctive codes',
      'Messaging house', 'Value props', 'Voice principles',
      'Register by channel', 'Lexicon', 'Tagline bank', 'Competitive map',
    ],
  },
  {
    fig: 'C',
    label: 'The working layer',
    heading: 'Briefs, prompts and rollout, codified.',
    image: '/Images/cs-cover-prompts.jpg',
    alt: 'A printed prompt library, a reference pack and an exclusion list spread across a warm worktable beside a typography card.',
    lead: 'A brand expressed in instructions a model can follow, not in adjectives a human has to interpret.',
    body: [
      'Campaign platforms and big ideas. Territories, key visuals, hero concepts, storyboards, headline banks, hooks and CTAs. Three platform routes per brief, because the route that wins the room on day one usually is not the route that performs in market. Prompt systems and AI usage strategy: a documented prompt library with positives, negatives and seeds. Reference packs, exclusion lists, and a LoRA brief when a fine-tune is justified (often it is not).',
      'Content strategy and frameworks: goals, KPIs, personas, customer journeys (including the discover-validate-buy pattern across Xiaohongshu, Douyin and WeChat for China-bound brands), content pillars, channel matrix, editorial calendar, measurement plan, governance checklist.',
    ],
    tags: [
      'Campaign platforms', 'Big ideas', 'Storyboards', 'Headline banks',
      'Prompt library', 'Reference packs', 'Exclusion lists', 'LoRA briefs',
      'Content pillars', 'China journeys',
    ],
  },
];

/* Execution credentials, named in the production-handover copy. */
const credentials = ['Figma library', 'Miro boards', 'Midjourney models', 'ComfyUI rigs'];

/* Process steps. The "where it is won / the rest is execution" tiers come
   from the source's own framing of strategic direction as the step that
   matters most. Numerals dropped per the no-numbers rule. */
const processSteps = [
  {
    short: 'Discovery',
    tier: 'Where it is won',
    title: 'Discovery and audit.',
    body: 'Existing brand, category, audience, competitors and whitespace. Plus a clear-eyed audit of the brand guidelines, sales decks and customer voice you already have.',
    image: '/Images/cs-p1-discovery.jpg',
    alt: 'A workshop wall covered in printed competitor pages, a positioning matrix marked up in pencil and a column of category notes.',
  },
  {
    short: 'Strategic direction',
    tier: 'Where it is won',
    title: 'Strategic direction. The step that matters most.',
    body: 'Senior strategists set two or three distinct platform routes. Each comes with positioning, distinctive codes, messaging and voice worked through enough that you are choosing between strategies, not moodboards.',
    image: '/Images/cs-p2-direction.jpg',
    alt: 'A strategist presenting three platform direction boards pinned to a plaster wall, hand pointing at one route.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration in context.',
    body: 'The chosen direction tested against real outputs: the prompt library generates campaign variants, voice samples and channel adaptations in parallel. You see how the strategy holds across a hundred assets before any of it locks.',
    image: '/Images/cs-p3-aigc.jpg',
    alt: 'A contact-sheet grid of nine prompt variations on one campaign concept printed and pinned across a fabric board.',
  },
  {
    short: 'Codification',
    tier: 'The rest is execution',
    title: 'Codification and system build.',
    body: 'Messaging house, voice guide, distinctive codes documentation, prompt library with positives, negatives and seeds. Reference packs and exclusion lists. A LoRA brief when fine-tuning earns its keep.',
    image: '/Images/cs-p4-refine.jpg',
    alt: 'A printed brand platform book open at the messaging house spread, beside a stack of prompt library cards on a worktable.',
  },
  {
    short: 'Rollout kit',
    tier: 'The rest is execution',
    title: 'Rollout kit and handover.',
    body: 'Templates for the formats your team ships every week, content frameworks, channel matrix, governance checklist. Briefable artifacts a human team can use, and prompt structures an AI stack can hold.',
    image: '/Images/cs-p5-adapt.jpg',
    alt: 'A flat-lay of strategy rollout assets: voice cards, channel matrix, editorial calendar, prompt library cards and a content pillars sheet.',
  },
];

/* The old consultancy timeline, set against our four-to-six week platform
   build. The source FAQ contrasts heritage consultancies that run on
   quarters with our workflow that runs on weeks. */
const oldPhases = [
  { label: 'Discovery', dur: 'Four weeks', span: 4 },
  { label: 'Direction', dur: 'Five weeks', span: 5 },
  { label: 'Codification', dur: 'Seven weeks', span: 7 },
];

/* FAQ: source has 16 questions, condensed to 10 to match the layout.
   Pricing FAQ kept but softened (no figures), per the no-pricing rule. */
const faqs = [
  {
    q: 'How long does an engagement take?',
    a: 'Two weeks for a focused brief such as a positioning refresh or a single campaign platform. Four to six weeks for a full brand platform with messaging, voice, distinctive codes and a prompt library. Faster on extensions of an existing system. Heritage consultancies routinely stretch the same scope across two quarters; the compression here is real, but it comes from AI making the production fast, not from skipping the thinking.',
  },
  {
    q: 'How does pricing work?',
    a: 'Project-based for one-off work, monthly retainer for ongoing brand stewardship, quarterly advance billing for retainers. We quote firm after the first call once the brief and scope are clear. The number depends on market count, language count, format breadth and how much existing material we work from. We will tell you upfront and we will tell you what is driving it.',
  },
  {
    q: 'How are you different from a traditional brand consultancy?',
    a: 'Three things. We ship strategy that survives into AI production tools, the kind of work most consultancies still do not write for. Our strategists have run accounts on agency floors, not only in slide decks, so the platform briefs production rather than winning an award for itself. And we work on weeks, not quarters. That is the timeline mid-market budgets actually allow.',
  },
  {
    q: 'How are you different from WPP Open, Adobe Firefly Foundry or Canva Grow?',
    a: 'Those are platforms. We are a studio. The holdco platforms work well if you are already inside the managed-service model and have the budget for it, and Canva Grow sits closer to SMB territory. We work with mid-market and enterprise marketing teams who need someone to write the strategy that goes into whichever platform they are on, or to run the platform on their behalf. We do not really care which tool you are using on the production layer.',
  },
  {
    q: 'What do I need to send to get started?',
    a: 'Current brand guidelines if you have them. Recent campaign work. Three to five competitors you want to differentiate from. Sales decks or messaging your team uses today. Customer research, NPS verbatims or reviews if available. If formal brand guidelines do not exist, we work from what does and flag the gaps.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Strategists with agency planning backgrounds lead every engagement. Creative directors join for platform work. AI specialists translate the strategy into prompt systems, brand-trained models and exclusion lists. No junior teams running the brief alone.',
  },
  {
    q: 'Will the strategy work for our AI production tools, or just for humans?',
    a: 'Both. The output is built as briefable artifacts a human team can use, and as prompt structures, reference libraries, LoRA briefs and exclusion lists that AI tools can hold. You can hand the platform to Hogarth, to your in-house studio, to us, or to a competitor of ours, and the brand will still hold.',
  },
  {
    q: 'Can you work alongside our existing brand agency?',
    a: 'Yes. Some clients keep their brand agency for big-idea above-the-line work and bring us in for the AI production layer. We sit alongside, briefed off the same platform. We have also worked the other way around, writing the platform for the brand agency to execute.',
  },
  {
    q: 'Do you write strategy for the China market specifically?',
    a: 'Yes. Our team is based in Shanghai and runs daily across Xiaohongshu, Douyin and WeChat. The platform we ship for a China-bound brand accounts for the discover-validate-buy pattern (Douyin creates desire, Xiaohongshu validates, WeChat closes), the seeding model (zhong cao), KOL-KOC tiering, and the 2026 compliance climate around AI disclosure. We have watched too many Western brands translate a global platform literally and lose six months.',
  },
  {
    q: 'What about IP on the strategy work?',
    a: 'You own the deliverables. The platform, the messaging house, the voice guide, the distinctive codes documentation, the prompt library, the LoRA briefs. All yours. We document the workflow so your team can keep using it without us. Brand-trained models we build for you stay with you. For the full position on copyright and AI, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Creative Strategy Services | AI-Native | hubStudio"
  description="Creative strategy built for the AI production era. Positioning, distinctive codes, messaging, prompt systems that hold the brand across 1,000 assets."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Creative Strategy
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Creative</span></span>
            <span class="line"><span class="line__i serif">Strategy</span></span>
            <span class="line"><span class="line__i">Platforms.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            A brand AI can scale <em>without flattening.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Friday afternoon. The studio just shipped 600 social posts.
              Every channel covered, every asset technically on-brand. The
              CMO pulls up six and asks her to name the brand without the
              logo. She cannot.
            </p>
            <p>
              The AI did not fail in that meeting. Nobody wrote the brand
              into the machine before they hit generate. We do that part:
              positioning, distinctive codes, messaging, prompt systems
              that hold across a thousand outputs.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Strategy + AI production layer
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/cs-hero.jpg"
          alt="A strategy wall in a Shanghai studio: printed positioning statement, three platform direction boards and pencil-marked competitor pages pinned across plaster."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Strategy wall</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              The prompt is the brief.<br /><span class="serif">Fuzzy brands</span> get fuzzy outputs.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              hubStudio was founded by the former CEO of Publicis Commerce
              and Performance Marketing for China and North Asia. We get a
              version of the same call most months. It is usually from
              someone who already paid a consultancy for a brand book and
              assumed the book would hold. It does not.
            </p>
            <p class="r" style="--d:.16s">
              Brand books are written for humans to interpret, but
              generative models do not read that way. They take
              instructions, and the instructions go vague the moment a
              junior team starts prompting against guidelines written in
              adjectives. Write a fuzzy brand and you get fuzzy outputs at
              industrial volume, which is one of the faster ways a category
              can converge into sameness.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Studio samples include <strong>HiSense</strong>,
              <strong>Camper</strong>, <strong>age20s</strong> and
              <strong>Shiseido RQ PYOLOGY</strong>. Plus FMCG, beverage and B2B
              software platforms covered under NDA.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/cs-roots.jpg"
              alt="A wide view of a Shanghai strategy room: three strategists at a long table, a wall of pinned positioning maps and a printed prompt library spread out."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The strategy room, Shanghai</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across roughly thirty strategy engagements run between Q1 2024
            and Q1 2026, clients reported creative approval rates lifted
            from 22% to 78%, the brief-to-asset cycle 3x faster on
            follow-on production, and content costs down 60% on campaigns
            built off the platform.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Seven lanes, one <span class="serif">operating system</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Strategy artifacts and platform specimens, authored in the
            studio. Brands are anonymised; the work is real.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · EXECUTION (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/cs-strategy-room.jpg"
                alt="Two strategists at a long studio table working through a printed prompt library, a third pinning a campaign platform board behind them."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/cs-strategy-inset.jpg"
              alt="Two hands annotating a printed messaging house with a pencil, a colour chip book at the edge of the frame."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">4&ndash;6 wks</span>
            <span class="source__stat-cap">Brief to delivered platform</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need execution too?<br />We can <span class="serif">produce</span> it.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients use the strategy work as the
            foundation and roll it out through their existing agency or
            in-house studio. The brand platform, prompt library and
            messaging house are built to be picked up by another team on
            day one.
          </p>
          <p class="source__p r" style="--d:.16s">
            If you would rather we run the production alongside the
            strategy, we do that too. Images, video, post and adaptation
            across markets, coordinated through one team using the same
            prompt systems and brand-trained models that built the
            platform. The advantage is consistency. The same strategist who
            approved the voice and codes is still on the work six months
            in, instead of a new freelancer trying to reverse-engineer the
            brand from the PDF.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            We work in Miro and Figma for the strategy artifacts, with
            custom-trained brand models on Midjourney, Stable Diffusion and
            ComfyUI for visual development. Tencent Hunyuan and Alibaba Wan
            are in rotation for China-bound work, where the Chinese models
            tend to render Mandarin signage and East-Asian faces with fewer
            post-production fixes.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Source files, the brand platform, prompt libraries and any
            brand-trained models are yours either way.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Strategic direction first.<br />Production scale <span class="serif">second</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          AI rewards brands that already know who they are. It punishes the
          ones hoping technology will sort that out. So we do the
          unglamorous work first, then translate it into a working layer
          your tools can hold.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A mid-market brand lands with a full platform brief: positioning,
            distinctive codes, messaging, voice, prompt library, content
            framework. The same scope, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The consultancy workflow</span>
              <span class="vs__total">Sixteen weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Mid-tier consultancy timeline: four weeks for discovery and
                audit, five for direction, then seven on codification and
                guidelines. Three rounds of revision, partner time billed at
                full rate, junior teams running the work. Heritage
                consultancies stretch the same scope across two quarters or
                more.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Four to six weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to delivered platform</span>
                  <span class="vs__seg-dur">Four to six weeks</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Two or three platform routes worked through enough to choose
                between strategies, not moodboards. The prompt library
                generates campaign variants in parallel so you see the
                strategy holding across a hundred assets before any of it
                locks. Codification, master files, prompt library, content
                framework, strategist-led the whole way.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here,
            put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a<br />real <span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us the brief. Two weeks later you get three platform
          directions, a written rationale, and a sample prompt library
          showing how the strategy would survive into AI production. No
          retainer, no commitment. Whatever we produce is yours.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
