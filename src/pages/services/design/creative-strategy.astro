      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .band__note--light {
    color: rgba(240, 237, 233, 0.76);
  }

  /* Calibration colour bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }
  .cbar--end {
    margin-top: clamp(60px, 8vw, 110px);
  }

  /* ===================== S1 · Hero ===================== */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__panel {
