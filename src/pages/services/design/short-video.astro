---
/**
 * Short Video Content  ·  /services/design/short-video
 *
 * Layout twin of /services/design/packaging-merch-design. The visual frame
 * stays identical: crop marks, calibration colour bar, mono figure labels,
 * editorial typography. The subject swaps from packaging proofs to short-form
 * video production. Copy is adapted from short-video-content-page.md and
 * follows the project's permanent rules (no numerals inside cards or step
 * lists, no em-dash, body copy at --type-body).
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio short-video samples, each with an invented brand mark for the
   contact-sheet grid. */
const samples = [
  {
    src: '/Images/sv-sample-luxe.jpg',
    brand: 'Lume',
    kind: 'Beauty TikTok variants',
    alt: 'A vertical smartphone on a marble counter playing a glossy beauty short-video ad.',
  },
  {
    src: '/Images/sv-sample-vital.jpg',
    brand: 'Vita',
    kind: 'DTC supplement Reels',
    alt: 'A smartphone in a hand showing a supplement brand Reels ad on a kitchen counter at sunrise.',
  },
  {
    src: '/Images/sv-sample-stay.jpg',
    brand: 'Halden',
    kind: 'Xiaohongshu KOC seeding',
    alt: 'A young creator on a boutique hotel terrace filming herself with a vertical phone at golden hour.',
  },
  {
    src: '/Images/sv-sample-drive.jpg',
    brand: 'Marque',
    kind: 'Automotive Douyin',
    alt: 'A modern crossover SUV in a dim warehouse with a vertical phone on a tripod in the foreground.',
  },
  {
    src: '/Images/sv-sample-table.jpg',
    brand: 'Pour',
    kind: 'F&B always-on UGC',
    alt: 'Overhead shot of a creator pouring sparkling water with a phone on a clamp filming the pour.',
  },
  {
    src: '/Images/sv-sample-founder.jpg',
    brand: 'Norra',
    kind: 'Founder explainer',
    alt: 'A founder seated on a stool in a warm studio talking to a vertical phone on a tripod.',
  },
];

/* Calibration colour bar: a printer's strip, kept as the editorial divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-project results, drawn from short-video-content-page.md. */
const stats = [
  { from: 8, to: 125, suffix: '+', label: 'Weekly variants in flight', note: 'Up from a baseline of 8' },
  { from: 0, to: 70, suffix: '%', label: 'Lower cost per finished asset', note: 'Across recent engagements' },
  { from: 0, to: 10, suffix: 'x', label: 'Edit output', note: 'Without a single new hire' },
];

/* Two lanes of coverage. Eight formats from the brief collapse into the lane
   they actually live in for a media plan: paid creative on one side,
   always-on cultural work on the other. */
const coverage = [
  {
    fig: 'B',
    label: 'Paid performance',
    heading: 'What we cover on paid creative.',
    image: '/Images/sv-coverage-paid.jpg',
    alt: 'Several vertical smartphones on a production stand showing variant frames of a beauty short-video ad.',
    body: [
      "Platform-native paid ads across TikTok, Reels, Shorts, Douyin, Xiaohongshu and Bilibili. Hook-first edits, captions burned in, Spark Ads whitelisting on as a default. Performance creative at scale means hook splits, CTA splits, length variants at 6, 15, 30 and 60 seconds. Meta itself recommends four to ten versions per test, refreshed every two to three weeks: most teams can't ship at that cadence.",
      "UGC-style for founder explainers, testimonials, demos and the unboxing format that keeps converting on Meta despite being declared dead about once a year. AI presenters cover the variant volume creator workflows can't match. Real creators handle the moments where trust is the whole point. The line we won't cross is undisclosed synthetic UGC.",
    ],
    tags: [
      'TikTok', 'Reels', 'Shorts', 'Douyin', 'Xiaohongshu',
      'Spark Ads', 'UGC-style', 'Hook splits', 'CTA splits', 'Length variants',
    ],
  },
  {
    fig: 'C',
    label: 'Always-on & cultural',
    heading: 'What we cover on always-on.',
    image: '/Images/sv-coverage-organic.jpg',
    alt: 'Hands of a creator demonstrating a skincare product with a vertical phone capturing the demo in window light.',
    lead: 'Calendar work most brands underestimate until the feed has gone quiet.',
    body: [
      "Brand films get the slowest treatment in the studio: cinematic vignettes cut down without losing the idea. Educational and how-to is what Bilibili and Xiaohongshu reward most, with numbered steps lifting retention 34% when the numbering doesn't feel listy. Always-on social ships within 48 hours of a trend breaking.",
      "Live commerce and short drama didn't exist three years ago. China's short drama market hit RMB 63.4B by mid-2025 and is projected at RMB 100B by 2027 (Media Partners Asia). Helena Rubinstein's broadcast drama lifted brand awareness from 26.1% to 79.3% during the run. We handle the full stack from one brief, warm-up clips through to store-livestream funnel.",
    ],
    tags: [
      'Educational', 'How-to', 'Brand films',
      'Short drama', 'Live commerce', 'Always-on social',
      'KOC seeding', 'Trend response', 'Calendar work', 'Bilibili',
    ],
  },
];

/* Paid-media platforms named in the FAQ. The optional distribution add-on
   mirrors packaging's optional sourcing capability. */
const adPlatforms = [
  'TikTok Ads Manager',
  'Meta Ads',
  'YouTube Ads',
  'Douyin Qianchuan',
  'Xiaohongshu Juguang',
];

/* Five-step process from the FAQ. Numerals dropped per the no-numbers rule.
   The first two steps are tiered as "where it's won". */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and creative spec.',
    body: 'Audience, platform mix, hook hypotheses, performance baseline.',
    image: '/Images/sv-p1-brief.jpg',
    alt: 'A creative director’s worktable with vertical-format storyboards, tear-sheets and a phone showing reference clips.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction. The step that matters most.',
    body: 'Senior creative directors set the hook territory and the structural concept. This is where a feed stops scrolling, and where a brand earns a second three seconds.',
    image: '/Images/sv-p2-direction.jpg',
    alt: 'A senior creative director discussing a vertical phone playback with an editor in a dim warm-lit suite.',
  },
  {
    short: 'AIGC exploration',
    tier: 'The rest is execution',
    title: 'AIGC exploration.',
    body: 'Models matched to shot type. Kling for motion, Hailuo for physics, Sora for narrative, Veo for photoreal audio, Wan when fifty variants must feel like one campaign.',
    image: '/Images/sv-p3-aigc.jpg',
    alt: 'A monitor showing a grid of AI-generated short-video variants for the same campaign.',
  },
  {
    short: 'Refinement',
    tier: 'The rest is execution',
    title: 'Refinement and platform prep.',
    body: 'Safe-zone audit, captions, sound mix, cover frames, provenance metadata, a fine-grain pass so the file survives platform compression cleanly.',
    image: '/Images/sv-p4-refine.jpg',
    alt: 'Hands on a Wacom tablet refining a frame of a vertical video on a calibrated editing monitor.',
  },
  {
    short: 'Scale',
    tier: 'The rest is execution',
    title: 'Variant scale and weekly iteration.',
    body: 'Localized cuts by market and platform, weekly iteration on what is winning the auction, retainer cadence once the system is built.',
    image: '/Images/sv-p5-adapt.jpg',
    alt: 'A row of vertical phones on a production rail playing platform-localized variants of the same campaign.',
  },
];

const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* Old agency timeline for 200 variants across four markets. */
const oldPhases = [
  { label: 'Concepts', dur: 'Two weeks', span: 2 },
  { label: 'Shoots', dur: 'Three weeks', span: 3 },
  { label: 'Editing variants', dur: 'Three weeks', span: 3 },
];

/* FAQ, verbatim from the source brief. The cost answer keeps relative
   language only, per the project rule on pricing. */
const faqs = [
  {
    q: 'How much does this cost?',
    a: "Clients on the work we've shipped over the last two years are landing at roughly 70% lower cost per finished asset than they were spending before. Beyond that, we won't quote a number on a webpage because we'd be lying if we did. A one-week single-platform batch sits at a different order of magnitude from a 200-variant always-on program across six markets. Single-platform pilot batches generally cost less than a single traditional shoot day. Multi-market always-on programs run at retainer scale comparable to mid-sized agency relationships. We quote firm after the first call.",
  },
  {
    q: 'How long does a short-video project take?',
    a: 'One week for a first batch on a single platform. Two to three weeks for a multi-platform launch with localized variants. Faster on an extension of an existing creative system. Always-on programs ship weekly once the system is built.',
  },
  {
    q: 'When can you start?',
    a: 'Most engagements kick off within a week of the signed brief. Always-on programs that need a custom brand-model layer take a little longer, figure two to three weeks for the training, then a weekly cadence after.',
  },
  {
    q: 'How is project work quoted?',
    a: 'Project-based for one-off batches. Monthly retainer for always-on volume. Quarterly advance billing for retainer clients. The first-call conversation establishes scope and gets us to a firm number inside a day or two.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three per concept. Most projects close inside two. Variant work is iterative by design and runs on the retainer rather than the project quote.',
  },
  {
    q: "What's your process, in five steps?",
    a: 'Brief and creative spec. Creative direction (the step that matters most). AI exploration with model selection mapped to shot type. Refinement and platform prep including safe-zone audit, captions, provenance metadata and grain pass. Variant scale and weekly iteration based on what is winning the auction.',
  },
  {
    q: "Where don't you fit?",
    a: "If you need a one-off hero film with no follow-up, we're not the cheapest option in town. If your in-house team handles the variant grind and you just want a single hand on keyboards, same. We're built for volume, for always-on programs, for work that has to translate across five markets and three platforms. Single-asset jobs we'll quote. You should know upfront we're rarely the lowest bidder on those.",
  },
  {
    q: 'Do you also run paid media?',
    a: "Optional. Most clients hand assets to their existing media team. If you don't have one, we run distribution across TikTok Ads Manager, Meta, YouTube, Douyin Qianchuan and Xiaohongshu Juguang. Setup in week one, optimization weekly, full reporting monthly.",
  },
  {
    q: 'What do I need to send to get started?',
    a: 'Brand guidelines if you have them. Product details, hero footage, photography, claims you can substantiate, regulatory copy by market. Platform list and target placements. Reference creative you like or want to avoid. Past campaign data if it exists.',
  },
  {
    q: 'Who actually does the work?',
    a: "Creative directors from platform-native shops lead every project. Editors and motion designers with social-first backgrounds handle the cut. AI specialists handle production volume. Color, audio cleanup and platform prep run by people who've shipped on the platform. No junior teams running the brief alone.",
  },
  {
    q: "Will the work look like us, or like everyone else's AI?",
    a: 'Like you. We train our models on your existing brand assets so the output stays inside your visual system. The biggest risk in AI-led creative is sameness, and we treat avoiding it as the core of the job. The post-production craft we run on every cut, from shot match through grain pass, is what separates work that holds up at scale from work that telegraphs the model it came from.',
  },
  {
    q: 'Can you do real-creator UGC too, or only AI?',
    a: 'Both. Some campaigns need AI presenters for speed and scale across markets. Others need real creators for trust signals and platform credibility. Spark Ads whitelisting is default on most TikTok accounts we run. For Xiaohongshu we work the KOC seeding model rather than chasing top-tier KOLs.',
  },
  {
    q: 'What about AI disclosure rules and the EU AI Act?',
    a: "We handle them. China's CAC Labeling Rules took effect September 1, 2025 with non-compliant content removed inside 90 minutes. The EU AI Act's Article 50 transparency provisions become fully applicable August 2, 2026, with penalties up to 6% of global annual turnover. California's SB 942 lands in the same window. We embed C2PA Content Credentials, apply SynthID where the model supports it, configure platform-level AI toggles by default, and deliver compliance documentation with the handover.",
  },
  {
    q: 'Can you handle Douyin and Xiaohongshu, or only Western platforms?',
    a: "Both. Our production team is based in Shanghai, which means Douyin, Xiaohongshu, Kuaishou and Bilibili are first-language platforms for us. For beauty and cosmetics brands working into China, we also handle copy review against CSAR (China's Cosmetic Supervision and Administration Regulation) on efficacy claims, since non-compliant content gets removed inside 90 minutes.",
  },
  {
    q: 'What about the artifacts AI video models still produce?',
    a: 'We work around them. Current models ship with warped hands, identity drift, product labels that morph mid-rotation, "rubber world" physics, fine-detail flicker. We match the model to the shot type so we are not asking a cinematic model to do physics work, and we run a refinement pass before delivery. Brands that ship raw model output without that pass are the ones writing the "AI slop" press cycle a year later.',
  },
  {
    q: 'Do you deliver final platform-ready files, or just edits?',
    a: "Platform-ready. Native aspect ratios, captions burned in, sound mixed for in-app playback, cover frames optimized, file naming and metadata matched to the media team's account structure, provenance credentials embedded, light grain pass applied so the file survives platform compression cleanly.",
  },
  {
    q: 'Where are you based, and where can you deliver?',
    a: "Production team in Shanghai, creative direction split between Shanghai and partner networks in Europe and North America. We've delivered short-form video into the US, EU, UK, Middle East, Latin America and APAC. Local-language work is staffed in-region where regulatory copy or cultural codes demand it.",
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one brief. Inside one week you get five hook directions cut against your actual product and target platform. No retainer, no commitment. The work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Short Video Production at Scale | hubStudio"
  description="AI-native short video studio for brands at scale: TikTok, Reels, Shorts, Douyin, Xiaohongshu. Senior creative leads, hook-tested edits weekly."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Short Video Content
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Short Video</span></span>
            <span class="line"><span class="line__i serif">Content</span></span>
            <span class="line"><span class="line__i">at scale.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Vertical edits that survive the first <em>three seconds</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A DTC beauty brand needs forty TikTok variants by Friday for a
              Meta Advantage+ test. Two creators flake, the in-house editor is
              tied up on a website refresh, and by Wednesday three videos have
              been approved instead of forty. Launch slips two weeks.
            </p>
            <p>
              We hear some version of that most months. Creative volume tends
              to be the first thing we talk about now.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Six platforms covered
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/sv-hero.jpg"
          alt="A short-video creator filming a vertical phone on a tripod in a warm-lit Shanghai studio."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Vertical first</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Why our platform<br /><span class="serif">roots</span> matter.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              A scroll session lasts ninety seconds, broken into clips that
              earn or lose the next swipe in three. Short-form carries the
              whole sale: no salesperson, no second chance, just the hook.
            </p>
            <p class="r" style="--d:.16s">
              That's the market our team came up in. hub Studio is the
              AI-native content studio inside Beyond Border Group, founded by
              Cyril Vidal, former CEO of Publicis Commerce for China and North
              Asia. We deliver short-form video for HiSense, Camper, Age20,
              Shiseido RQ PYOLOGY across TikTok, Reels, Shorts, Douyin,
              Xiaohongshu and Bilibili.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Roughly fifty short-video engagements over two years, by our own
              count. The numbers below are averages.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/sv-roots.jpg"
              alt="A hand holding a vertical phone showing a TikTok-style feed in mid-afternoon café light."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The three-second test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Variants in flight pushed from a baseline of eight to 125, cost per
            finished asset down 70%, and edit output up 10x without a single
            new hire.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Every platform, one <span class="serif">creative system</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Vertical frames generated, edited and finished in the studio. Every
            shot is authored work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · OPTIONAL MEDIA ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/sv-platforms-main.jpg"
                alt="A short-video control room with monitors showing vertical feeds across TikTok, Douyin and Xiaohongshu."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/sv-platforms-inset.jpg"
              alt="Hands editing a vertical video timeline on a tablet in warm window light."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">Week 1</span>
            <span class="source__stat-cap">Distribution live, first variants pushing</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it distributed too?<br />We can <span class="serif">run media</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients hand assets to their existing
            media team. If you don't have one, we run distribution end to end.
          </p>
          <p class="source__p r" style="--d:.16s">
            Setup in week one. Optimization on a weekly cadence, with hook and
            audience splits running against your performance baseline. Full
            reporting monthly, on the platforms where the auction actually is.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              adPlatforms.map((p) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {p}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Spark Ads whitelisting on TikTok by default. KOC seeding model on
            Xiaohongshu rather than top-tier KOL spend. AI disclosure handled
            against China's CAC labeling rules, the EU AI Act's Article 50, and
            California's SB 942, with C2PA credentials and SynthID applied
            where the model supports them.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already have a media partner, no problem. We hand over the
            files and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative is where<br />it is <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Most studios sell process. We sell the creative call. AI made the
          technical side cheap and fast for everyone. It didn't replace the eye
          that picks which hook is actually worth scaling.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A brand lands with 200 short-video variants for a Q3 launch across
            four markets. The same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Eight weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief an agency, two weeks for concepts, three
                weeks for shoots across four markets, another three for editing
                variants. Eight weeks, three rounds, and creative that lands
                already a quarter behind the trend cycle.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Five days</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Hooks to variants</span>
                  <span class="vs__seg-dur">One week</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: hook directions cut and tested in days. Variants
                generated in parallel rather than sequentially. Localized cuts
                by market and platform without rebuilding every edit. Weekly
                iteration against what is winning the auction, not a
                three-month launch and pray cycle.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Quarterly to <span class="serif">weekly</span>.
            </h3>
            <p class="hub__text">
              For brands running hundreds of variants a week, we deploy hub4You,
              our custom AI agent setup trained on your own brand system. It
              generates on-brand hook and CTA variants on demand, and connects
              directly to your DAM and ad accounts so the output lands where
              your media team already works. That's the gap between launching
              quarterly and launching weekly.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4fashion.jpg"
                alt="The hub4You platform generating on-brand short-video variants from a model and a background."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put it
            in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          One brief. One week. Five hook directions cut against your actual
          product and target platform, plus a production estimate against your
          scope. The work is yours whether you decide to keep working with us
          or not.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
