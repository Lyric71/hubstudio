---
/**
 * Pitch Deck Design  ·  /services/design/pitch-deck
 *
 * Mirrors /services/design/packaging-merch-design and
 * /services/design/creative-strategy: same "Pressroom" art direction (crop
 * marks, calibration colour bar, mono figure labels) adapted to pitch-deck
 * work. Copy from pitch-deck-page.md.
 *
 * The page lives alongside /services/design/presentation-design, which
 * covers the broader presentation system (QBRs, keynotes, all-hands). This
 * one is narrower: investor decks, sales decks, enterprise / RFP, M&A,
 * board, regional. Images live in /public/Images with a pitch- prefix to
 * keep both image namespaces clean.
 *
 * Process step numerals dropped per the no-numbers rule.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Six invented sample pitch decks, one per category named in the source
   studio-samples list. Each maps to a real engagement pattern: Series B,
   sales enablement, retail buyer pitch, board update, RFP response, M&A. */
const samples = [
  {
    src: '/Images/pitch-sample-veridon.jpg',
    brand: 'Veridon',
    kind: 'Series B investor deck',
    alt: 'Open laptop on a quiet desk showing a Veridon investor deck title slide with a single chart and warm window light.',
  },
  {
    src: '/Images/pitch-sample-marlow.jpg',
    brand: 'Marlow',
    kind: 'B2B SaaS sales deck',
    alt: 'A printed Marlow sales deck open at the ROI math spread, on a worktable beside a pen and a coffee cup.',
  },
  {
    src: '/Images/pitch-sample-pellune.jpg',
    brand: 'Pellune',
    kind: 'Retail-buyer pitch deck',
    alt: 'A Pellune retail-buyer pitch deck on a marble counter beside a sample beauty product, daylight through a tall window.',
  },
  {
    src: '/Images/pitch-sample-ostran.jpg',
    brand: 'Ostran',
    kind: 'OEM RFP response',
    alt: 'A bound Ostran RFP response booklet open at a technical capability spread, on a metal worktable in a daylit warehouse.',
  },
  {
    src: '/Images/pitch-sample-halver.jpg',
    brand: 'Halver',
    kind: 'Series C board deck',
    alt: 'A Halver board-update deck on a tablet on a long conference table, two hardcopy summaries fanned beside it.',
  },
  {
    src: '/Images/pitch-sample-niven.jpg',
    brand: 'Niven',
    kind: 'Hospitality expansion memo',
    alt: 'A Niven hospitality expansion memo open at a market-map spread, on a wood desk in a soft-lit hotel office.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Results stats, drawn from the source quote: averages across about 60
   engagements over the last two years. */
const stats = [
  { from: 0, to: 78, suffix: '%', label: 'First-round approval', note: 'Across ~60 engagements' },
  { from: 1, to: 2, suffix: '.4x', label: 'Second-meeting rate', note: 'On rebuilt investor decks' },
  { from: 0, to: 8, suffix: ' days', label: 'Median turnaround', note: 'Brief to investor-ready' },
];

/* Two coverage lanes. The source lists five formats (investor, sales,
   enterprise / RFP, partnership / M&A, board). They group cleanly into the
   founder-facing investor lane and the committee-facing sales / enterprise
   / corp-dev lane. Keeping the two-feature layout means the lanes group
   rather than list. */
const coverage = [
  {
    fig: 'B',
    label: 'Investor',
    heading: 'Decks built for the partner meeting.',
    image: '/Images/pitch-cover-investor.jpg',
    alt: 'A printed Series B investor deck open at the "Why now" spread on a warm worktable beside a brief sheet and a pencil.',
    lead: 'Pre-seed through Series C and later. Cold-email versions, full-meeting versions, diligence-grade appendices.',
    body: [
      'Cold-email versions under 10 slides for the inbox. Full-meeting versions at 12 to 14 for the room. Deep-dive variants with appendices for the partner who took your meeting and now has to defend you to the rest of the firm. We build the variants as one system because most growth-stage founders end up maintaining three or four versions of the same deck, and rebuilding each one from scratch is what burns the time.',
      'Story first, slides later. The first three days go to why now, why this team and why this problem, in language a generalist partner can repeat from memory to colleagues who never met you. The 30% of decks that turn into a meeting tend to get passed around the firm before that meeting happens, so the deck has to make sense without you in the room.',
    ],
    tags: [
      'Pre-seed to Series C', 'Cold-email versions', 'Full-meeting decks',
      'Diligence appendices', 'Why-now framing', 'Team narrative',
      'Traction charts', 'Partner-pass-around',
    ],
  },
  {
    fig: 'C',
    label: 'Sales · Enterprise · RFP',
    heading: 'Decks built for the committee.',
    image: '/Images/pitch-cover-sales.jpg',
    alt: 'A printed enterprise sales deck open at an ROI math spread on a long conference table, beside a tablet showing the same slide.',
    lead: 'The deck is the artifact a buying committee shares internally. We build for the version that travels.',
    body: [
      'Sales decks at eighteen to thirty slides depending on cycle length, built for the rep in the room rather than the founder telling the origin story. The job is to give the champion inside the buyer\'s organization what they need to sell the deal to twelve other people you will never meet. ROI math, a competitive matrix, customer proof, implementation timeline, and pricing logic where it helps.',
      'Enterprise and RFP decks where Loopio\'s 2026 data has teams averaging 39 hours on each response. Most of those hours go into restructuring content that already exists somewhere in the company. We do that work so the document survives past page three. M&A and corp-dev decks for sophisticated audiences with zero tolerance for fluff. Board, internal, and regional expansion decks for readers who already know the business: less polish, more density.',
    ],
    tags: [
      'B2B sales decks', 'Enterprise pursuits', 'RFP responses',
      'ROI math', 'Competitive matrix', 'M&A memos',
      'Board updates', 'Regional expansion',
    ],
  },
];

/* Tools and stack named in the source's "What we use" paragraph. Acts as
   the credential row in the craft section. */
const credentials = ['Figma + Keynote', 'D3 + Recharts', 'Brand-trained models', 'Storydoc & custom web'];

/* Process steps. The source names five; the "won / execution" tiers come
   from the source's own framing ("the first three days go to story, before
   a designer touches a slide"). Numerals dropped per the no-numbers rule. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and discovery.',
    body: 'A 60-minute call. Audience, story spine, slide list, the partner or buyer profile, the meeting you are walking into.',
    image: '/Images/pitch-p1-brief.jpg',
    alt: 'A founder on a discovery call at a quiet desk, an open notebook and a printed brief sheet beside the laptop in warm window light.',
  },
  {
    short: 'Story architecture',
    tier: 'Where it is won',
    title: 'Story architecture. The step that matters most.',
    body: 'Headlines written for every slide before a single layout exists. The document the partner remembers. About a third of the slides usually do not survive this pass.',
    image: '/Images/pitch-p2-narrative.jpg',
    alt: 'A studio wall covered in printed slide headline cards in a vertical column, a strategist pointing at one with a pencil.',
  },
  {
    short: 'Design exploration',
    tier: 'The rest is execution',
    title: 'Design exploration in parallel.',
    body: 'Two visual directions worked through with three to five hero slides each. The client picks one from a short PDF, not from a live tool, and we lock the system.',
    image: '/Images/pitch-p3-aigc.jpg',
    alt: 'A grid of two pitch-deck visual directions printed and pinned across a fabric board, each with three hero slides.',
  },
  {
    short: 'Full build',
    tier: 'The rest is execution',
    title: 'Full build with real data.',
    body: 'All slides, real charts pulled from the source data, speaker notes where helpful, dark-mode variant for live presentation, light variant for the leave-behind.',
    image: '/Images/pitch-p4-production.jpg',
    alt: 'A designer at a workstation with two monitors, a Figma file with the pitch deck on one and a linked Excel chart on the other.',
  },
  {
    short: 'Polish',
    tier: 'The rest is execution',
    title: 'Polish, variants and handover.',
    body: 'Three rounds of revisions in the quote, most projects close inside two. Aspect-ratio swaps, market variants, PowerPoint export for procurement, scrollytelling web version when the deck has to live as a link.',
    image: '/Images/pitch-p5-adapt.jpg',
    alt: 'A flat-lay of four pitch-deck variants on a worktable: a laptop, a printed booklet, a tablet and a phone, each showing the same hero slide in different formats.',
  },
];

/* The old agency timeline, set against our two-week standard track. The
   source has the consumer-tech founder rebuild compressed to "eight working
   days", and the FAQ contrasts the standard two weeks with an express
   one-week track. */
const oldPhases = [
  { label: 'Story', dur: 'Two weeks', span: 2 },
  { label: 'Design', dur: 'Three weeks', span: 3 },
  { label: 'Revisions', dur: 'One week', span: 1 },
];

/* FAQ: source has thirteen questions, kept ten to match the layout. Pricing
   FAQ kept but softened (no figures) per the no-pricing rule. */
const faqs = [
  {
    q: 'How long does a deck take?',
    a: 'Two weeks from brief to final files on a standard 15-to-20-slide investor or sales deck. One week on the express track, which uses the same team and same process, just compressed (we will tell you on the first call if your timeline is realistic). Three weeks for enterprise or RFP work over 30 slides. Faster when we are extending an existing system you have already invested in.',
  },
  {
    q: 'How much does it cost?',
    a: 'We do not publish a rate card because scope ranges too widely. A single investor deck for a Series A founder is a different engagement than a quarterly board deck system for a growth-stage company with regional variants. We sit in the middle of the market: more than a freelancer on Upwork, less than a Tier-1 agency. We quote firm after the first call once the scope is clear, and we will tell you in the same call whether what you need is something we should be doing or something a template could handle.',
  },
  {
    q: 'Do you work on project or retainer?',
    a: 'Both. Project-based for one-off decks. Monthly retainer for ongoing volume, which is what most growth-stage companies move to once they are running multiple decks, regional variants, and sales enablement in parallel.',
  },
  {
    q: 'Do you write the content or just design it?',
    a: 'Both, and we recommend you let us. The story is where most decks fail. Treating writing and design as separate engagements is how you end up with slides that look polished and say nothing. We rewrite headlines, body copy, captions and speaker notes alongside the design. If you have a copywriter you would rather use, we work to their text.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three. Most projects close inside two. Beyond round three we quote hourly, but it is rare on pitch work because the story is locked in week one.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Art directors with agency backgrounds (Publicis, Ogilvy, WPP, and similar) lead the story and design. AI specialists handle the production volume on custom imagery, chart variants and slide adaptation. A copywriter joins for content-heavy work. No junior teams running the brief alone.',
  },
  {
    q: 'Will it look like an AI deck?',
    a: 'No. We use AI to speed up production. We do not use it to generate the deck. Story, visual direction, what stays and what gets cut: people do that work. The first thing a partner notices about an AI deck is the pattern, and a lot of what we do is design against it.',
  },
  {
    q: 'What formats do you deliver?',
    a: 'Editable Figma or Keynote master, PDF for sharing, PowerPoint on request because procurement teams often demand it. Light and dark mode versions when the deck will be presented live. Speaker notes optional. For decks that need to live as a sharable web link with per-slide analytics, we build a scrollytelling version on Storydoc or as a custom build.',
  },
  {
    q: 'Can you handle multiple versions of the same deck?',
    a: 'Yes, and it is one of the biggest reasons clients move to retainer. Investor-by-investor variants for a fundraising round, market-by-market localization for APAC, EMEA or the Americas, buyer-by-buyer personalization for enterprise sales, industry vertical cuts for cross-sector campaigns. We build the master so variants take hours, not days.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Pitch Deck Design Services, AI-Native | hubStudio"
  description="Pitch decks built for how investors actually read. Story, design, and content in one engagement. Art-director led. Two-week first draft."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Pitch Deck Design
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Pitch Decks</span></span>
            <span class="line"><span class="line__i serif">Built to</span></span>
            <span class="line"><span class="line__i">Close the Room.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Story, design and content from <em>one team.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A consumer-tech founder called us six days before her Series B
              partner meeting. Forty-two slides. The problem statement was
              on slide eleven. She had booked 18 first meetings that quarter
              and not one had come back.
            </p>
            <p>
              We rebuilt it in eight working days. Her next partner meeting
              opened a term sheet. We have run the order that way ever
              since: story first, slides later.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Art-director led <span>/</span> Two-week first draft
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/pitch-hero.jpg"
          alt="A founder pitching to two investors in a quiet meeting room, a laptop deck open on the table beside a printed leave-behind."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Series B partner meeting</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The math you face</p>
            <h2 class="dh r" style="--d:.05s">
              Three minutes,<br /><span class="serif">forty-four</span> seconds.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              That is what the average investor gives your deck on the first
              pass. The figure comes from Dropbox DocSend’s analysis of more
              than a million sessions. Storydoc’s 2026 set locates the real
              gate at slide three: 82% of investors who clear slide three
              finish the deck, and 31% are gone inside the first ten seconds.
            </p>
            <p class="r" style="--d:.16s">
              Sales decks are no easier. Forrester puts the average B2B
              purchase at 13 internal stakeholders plus 9 outside
              participants. The deck is often the only artifact a buying
              committee shares internally, so we build for the version that
              travels.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Past clients have included <strong>HiSense</strong>,
              <strong>Camper</strong>, <strong>Age20</strong> and
              <strong>Shiseido</strong>. Operating from Hong Kong under
              Beyond Border Group.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/pitch-roots.jpg"
              alt="An investor at a desk reviewing a printed pitch deck, coffee cup beside it, half-frame on the slide and half on her face."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The three-minute first pass</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Averages across about 60 engagements over the last two years,
            not single-project highs. First-round approval, second-meeting
            conversion on rebuilt decks, and the median brief-to-investor-
            ready turnaround.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            One service. Every<br />pitch <span class="serif">context</span> that matters.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Pitch-deck artifacts and specimens, authored in the studio.
            Brands are anonymised; the engagements are real.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · CRAFT (THE STORY IS WHERE IT'S WON) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/pitch-room.jpg"
                alt="An art director at a long studio table working through a printed slide outline, a second screen behind showing a Figma deck file."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/pitch-room-inset.jpg"
              alt="Two hands annotating a printed pitch-deck slide with a red pencil, a colour chip book at the edge of the frame."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">8 days</span>
            <span class="source__stat-cap">Median brief to investor-ready</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The craft</p>
          <h2 class="dh r" style="--d:.05s">
            AI made the slides cheap.<br />The <span class="serif">story</span> is where it is still won.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Any founder with a credit card can spin up a deck in Gamma in
            forty minutes. The output looks fine. It also looks like every
            other deck the partner read this morning.
          </p>
          <p class="source__p r" style="--d:.16s">
            The patterns give themselves away inside a few slides. Stock
            photos lifted from the first page of Unsplash. Six bullets on a
            slide that should hold one idea. TAM numbers pulled from a
            research report the founder cannot defend if you ask one
            follow-up. Section headers that read like template fill-ins.
            Five Gamma layouts on rotation across every deck in the inbox
            this week.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            We work the order backwards. The first three days go to story,
            before a designer touches a slide. Why now. Why this team. Why
            this problem, in language a generalist partner can repeat from
            memory. That work sets the slide order, the headlines, and what
            gets cut. About a third of slides usually do not survive the
            pass.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If your deck is strong and you just want a polish, we will quote
            it. But we charge for the story work whether you need it or not.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Five steps. Two weeks.<br />Three <span class="serif">rounds</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          The story is built before any layout exists. By the time a slide
          is designed, it already knows the room it is walking into and the
          partner it has to outlast.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A founder lands six days before a Series B partner meeting.
            Forty-two slides, the problem statement on slide eleven. The
            same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The agency workflow</span>
              <span class="vs__total">Six weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Agency timeline on a standard 15-to-20-slide investor deck:
                two weeks of story workshops, three weeks of design, a week
                of revisions. Partner time billed at full rate, three
                rounds, junior teams running the work. The deck you needed
                Tuesday lands the following month.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Two weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to investor-ready</span>
                  <span class="vs__seg-dur">Two weeks</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Story locks in the first three days. Two visual directions
                worked through with three to five hero slides each. Full
                build with real data, dark-mode variant, speaker notes,
                PowerPoint export. Express track compresses it to one week
                when the meeting is next Tuesday: same team, same process.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Decks that <span class="serif">scale</span>.
            </h3>
            <p class="hub__text">
              For sales teams maintaining investor-by-investor variants,
              market-by-market localization, and buyer-by-buyer
              personalization, we deploy hub4You: our custom AI agent setup
              trained on the master deck. It generates on-brand variants on
              demand inside your story spine and visual system, and connects
              directly to your CRM and DAM so the output lands where your
              team already works. That is the gap between updating one deck
              a quarter and shipping a variant for every meeting.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4fashion.jpg"
                alt="The hub4You platform generating on-brand deck variants from a stored master and a partner profile."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things clients ask before we start. If yours is not here,
            put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on the deck<br />you are using <span class="serif">now</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us your current deck and the meeting you are preparing for.
          Inside one week you get a story diagnosis, a rewrite plan, and
          two redesigned hero slides. No retainer, no commitment. Whatever
          we produce is yours to keep, even if you walk.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
