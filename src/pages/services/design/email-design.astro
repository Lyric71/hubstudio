---
/**
 * Email Design  ·  /services/design/email-design
 *
 * Sibling to /services/design/packaging-merch-design and print-design. Same
 * "Pressroom" art direction (crop marks, calibration colour bar, mono figure
 * labels) since the language of prepress also reads as the language of
 * render-testing: matrix, swatches, proofs. Copy adapted from
 * hubstudio-email-page.md.
 *
 * Process step numerals are intentionally dropped per the project's permanent
 * "no numbers in cards / step lists" rule. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio samples, each with an invented brand mark spanning the format list
   called out in the source brief. */
const samples = [
  {
    src: '/Images/email-sample-maven.jpg',
    brand: 'Maven',
    kind: 'Beauty welcome series',
    alt: 'iPhone on a sandstone slab showing the first email of the Maven beauty welcome series, a soft bottle still life above the wordmark.',
  },
  {
    src: '/Images/email-sample-solano.jpg',
    brand: 'Solano',
    kind: 'FMCG abandoned cart',
    alt: 'iPhone in hand showing a Solano abandoned-cart email, a single coral-red product image and two side-by-side CTA buttons.',
  },
  {
    src: '/Images/email-sample-lirien.jpg',
    brand: 'Lirien',
    kind: 'Hospitality newsletter',
    alt: 'iPad propped against art books showing a Lirien hospitality newsletter, a serif wordmark and a single architectural courtyard photograph.',
  },
  {
    src: '/Images/email-sample-veld.jpg',
    brand: 'Veld',
    kind: 'SaaS onboarding',
    alt: 'MacBook showing a Veld SaaS onboarding email with a line-art illustration, a three-step list and a single coral CTA button.',
  },
  {
    src: '/Images/email-sample-polaris.jpg',
    brand: 'Polaris Bio',
    kind: 'Pharma transactional',
    alt: 'iPhone on folded white cotton showing a Polaris Bio order confirmation, a restrained navy header and a short order summary.',
  },
  {
    src: '/Images/email-sample-bevra.jpg',
    brand: 'Bevra',
    kind: 'Beverage, multi-market',
    alt: 'Three iPhones laid flat showing the same Bevra Black Friday email in English, French and Simplified Chinese.',
  },
];

/* Calibration colour bar: a printer's strip used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Engagement-level stats lifted from the source. */
const stats = [
  { from: 31, to: 82, suffix: '%', label: 'First-pass render rate', note: 'Up from a 31% baseline' },
  { from: 0, to: 58, suffix: '%', label: 'Lower production cost', note: 'On multi-market programs' },
  { from: 0, to: 8, suffix: 'x', label: 'Template variants per hour', note: 'Without a single new hire' },
];

/* Two lanes, with every named email format from the source surfaced as
   chips. The six lanes the source lists collapse into these two by tempo:
   programmatic sends that hit an inbox vs. the systems and interactive
   builds behind them. */
const coverage = [
  {
    fig: 'B',
    label: 'Templates & lifecycle',
    heading: 'Every send, one design rhythm.',
    image: '/Images/email-cover-templates.jpg',
    alt: 'An iPhone and an open MacBook side by side, both screens showing the same editorial newsletter email at desktop and mobile crops.',
    body: [
      'Campaign templates for product launches, sale announcements, seasonal heroes, partnership co-sends and event invites. Lifecycle sets running welcome, cart, browse, post-purchase, replenishment, winback and sunset. Newsletters and long-form editorial that get read, not skimmed. Transactional templates, the most opened email a brand sends and almost never the best designed.',
    ],
    tags: [
      'Campaigns', 'Welcome', 'Cart & browse', 'Post-purchase',
      'Replenishment', 'Newsletters', 'Editorial', 'Transactional',
    ],
  },
  {
    fig: 'C',
    label: 'Systems & interactive',
    heading: 'The library behind the program.',
    image: '/Images/email-cover-systems.jpg',
    alt: 'A 27-inch iMac showing an email design system library, a tidy grid of nine reusable modules in muted brand colours.',
    lead: 'Modular components your marketing team can assemble without touching code.',
    body: [
      'Design systems with header variants, hero blocks, product cards, CTA styles, footers and dark-mode tokens, tested across every component and handed over with documentation. Interactive and kinetic builds covering AMP forms, polls, carousels, accordions, hover states and animated frames, with graceful fallbacks for the clients that do not support them.',
    ],
    tags: [
      'Modular libraries', 'Header & hero variants', 'Product cards',
      'CTA styles', 'Dark-mode tokens', 'AMP forms', 'Kinetic carousels',
      'Animated frames',
    ],
  },
];

/* Render-side credentials for the optional ESP-integration section. */
const credentials = ['Litmus', 'Email on Acid', 'WCAG 2.2 AA', 'NDA in place'];

/* Process steps. Numerals dropped per the no-numbers rule. The source itself
   calls out which steps are where the work is won, vs. execution. */
const processSteps = [
  {
    short: 'Brief & spec',
    tier: 'Where it is won',
    title: 'Brief and render spec.',
    body: 'Format list, ESP, target inbox matrix, dark-mode behavior, accessibility level, brand guidelines, regulatory copy by market, fallback strategy. Locked before the first sketch.',
    image: '/Images/emd-p1-brief.jpg',
    alt: 'Top-down view of a worktable: a printed render-test grid, an open notebook with brief notes, a metal pen, and three printed mobile-email mockups.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction.',
    body: 'Senior designers set the grid, the type hierarchy, the module rhythm and the hero treatment the rest of the system earns its way around.',
    image: '/Images/emd-p2-direction.jpg',
    alt: 'A senior email art director leaning over a worktable covered in printed email-layout proofs, marking a single proof with a pencil.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration.',
    body: 'Eight to twelve directions in parallel. Photoreal mockups in the inbox environments they will actually live in, not on a Figma artboard.',
    image: '/Images/emd-p3-aigc.jpg',
    alt: 'A studio wall pinned with a tidy grid of twenty printed paper email mockup variations of the same newsletter.',
  },
  {
    short: 'Build & QA',
    tier: 'The rest is execution',
    title: 'Build and QA.',
    body: 'Hand-coded or MJML-built HTML, Litmus-tested across the full client matrix, accessibility-validated against WCAG 2.2 AA. We do not release until rendering is clean in dark mode on iOS, Gmail web and the new Outlook at minimum.',
    image: '/Images/emd-p4-build.jpg',
    alt: 'A MacBook screen split between a dark-themed HTML email code editor on the left and a live email preview on the right, an iPhone beside it in dark mode.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation at scale.',
    body: 'Market variants, language localization, format extensions. EN to FR or DE expands 15 to 30 percent; ZH, KR, JP contracts. No reflowing every template.',
    image: '/Images/emd-p5-adapt.jpg',
    alt: 'A row of five iPhones laid flat side by side, each screen showing the same newsletter email in English, French, German, Chinese and Japanese.',
  },
];

const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* Three documented shifts in AI for email design over the last eighteen
   months, laid out as press-wire dispatches. The numerals are content (real
   percentages and multipliers) not decorative ordinals, so the no-numbers
   rule does not fire. */
const shifts = [
  {
    year: '2025',
    src: 'Klaviyo · K:AI Composer',
    stat: 'In-ESP',
    statCap: 'Generative agent',
    head: 'The production floor moves into the ESP.',
    body: "Klaviyo shipped K:AI Composer in 2025, a generative agent built into the email editor. Feed it a brief and a voice guide, it returns complete on-brand templates: subject lines, copy, layout, imagery, CTA. For brands without a design team, the production floor now lives inside the ESP.",
  },
  {
    year: '2025',
    src: 'Email Love · Figma AI Studio',
    stat: '~50%',
    statCap: 'Shorter production',
    head: 'Figma to MJML in one click.',
    body: 'Email Love launched its AI Studio plugin for Figma in late 2025, syncing a brand\'s existing design system with an AI that generates complete responsive templates from a text brief, then exports production-ready MJML to Salesforce, Braze, Iterable, Klaviyo or HubSpot. Teams using it have reported cutting production time by roughly half.',
  },
  {
    year: '2025',
    src: 'Email Markup Consortium',
    stat: '60.66%',
    statCap: 'Still critical-fail',
    head: 'Accessibility moves, slowly.',
    body: 'The Email Markup Consortium\'s 2025 Accessibility Report found emails with critical accessibility issues dropped from 66.68% in 2024 to 60.66% in 2025, mostly because frameworks like MJML responded to public benchmarking by improving their generated code defaults. A six-point drop in a year matters, especially in the EU.',
  },
];

/* FAQ: trimmed to five questions, answers tightened. The legal answer keeps
   its link to the Copyright and AI guide. */
const faqs = [
  {
    q: 'How long does an email design project take?',
    a: 'About a week for a standard campaign template. Two to three weeks for a full lifecycle set. Three to four for a modular system with documentation. Extensions of an existing system come back inside 48 hours.',
  },
  {
    q: 'Who does the work?',
    a: 'Senior email designers from agency backgrounds (Wunderman, Epsilon, Ogilvy One, Razorfish) lead. AI specialists handle production volume. HTML by developers who have shipped at scale. QA by people who actually open the email on every device.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. Full detail in our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle a full multi-market program, or just one template?',
    a: 'Both. Some clients come for one welcome email. Others come with a campaign across fourteen markets, eleven languages and 200 SKU variants, all due in three weeks. The workflow handles both ends.',
  },
  {
    q: 'Can we start small?',
    a: 'Yes. One brief, one week, two layout directions and a render test report. No retainer, no commitment, the work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Email Design Services | AI-Native | hubStudio"
  description="Hand-coded, render-tested HTML email design across every format: campaigns, lifecycle, newsletters, design systems. Senior leads, every market."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Email
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Email</span></span>
            <span class="line"><span class="line__i serif">Design.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Hand-coded HTML for <em>every inbox</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A 12-module campaign signs off in Figma on a Wednesday. The hero
              image disappears in Outlook 365 because the background tag fell
              off in the export. Nobody catches it until the brand director
              opens it on her own phone.
            </p>
            <p>
              So render testing comes first, not last.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Design + optional ESP integration
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/email-hero.jpg"
          alt="A new iPhone on a stack of cream notebooks on a sunlit walnut desk, screen showing an editorial fashion-brand newsletter email."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Maven</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it earns the budget</p>
            <h2 class="dh r" style="--d:.05s">
              In a crowded<br />inbox, <span class="serif">design</span> opens.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Roughly 376 billion emails get sent every day in 2025. Half of
              opens happen on mobile, and 75% of subscribers delete a message
              that does not render on their phone.
            </p>
            <p class="r" style="--d:.16s">
              Since 28 June 2025 the European Accessibility Act has made
              WCAG 2.1 AA legally mandatory for any brand selling to EU
              consumers, with fines reaching one hundred thousand euros in
              Germany.
            </p>
            <p class="why__clients r" style="--d:.22s">
              <strong>60.66% of marketing emails still contain critical
              accessibility issues</strong>. Most failures trace back to colour
              contrast, missing alt text and broken heading structure.
              <span class="why__src">Email Markup Consortium, 2025.</span>
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/email-roots.jpg"
              alt="A person at a sunlit cafe table holding an iPhone, screen showing a beautifully designed newsletter email with a magazine-style hero image."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The lunchtime open</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across roughly 35 engagements over the last two years: first-pass
            rendering up from 31% to 82%, production cost down 58%, template
            variants per design hour 8x. No new hires.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Every format, one <span class="serif">design system</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            A two-line transactional receipt and a 14-module editorial
            newsletter share almost nothing in their craft. We staff each
            format with people who have done it before, all working off one
            design system.
          </p>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Authored work, never a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · OPTIONAL ESP INTEGRATION ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/emd-esp.jpg"
                alt="A designer at a walnut desk with hands on a MacBook keyboard and a second vertical monitor showing an ESP dashboard with email templates listed."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/emd-p4-build.jpg"
              alt="A MacBook screen split between an HTML email code editor on the left and a live email preview on the right."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">50+ ESPs</span>
            <span class="source__stat-cap">Klaviyo, Braze, Customer.io, HubSpot and the rest</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it loaded into<br />your ESP too?<br />We can <span class="serif">handle</span> that.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Optional. Most clients hand the HTML to their own CRM team.
          </p>
          <p class="source__p r" style="--d:.16s">
            If you do not have one, we integrate templates directly into
            Klaviyo, Braze, Customer.io, HubSpot, Iterable, Salesforce
            Marketing Cloud, Mailchimp, Sendgrid or any of the fifty-plus ESPs
            we work with, including platform-specific scripting in Liquid,
            AMPscript and HubL.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Already have a CRM team handling integration? We deliver
            matched-spec HTML and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative is where<br />it's <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          AI made the technical side cheap and fast for everyone. Picking the
          layout actually worth shipping is the part that is still hard, and
          where we spend most of our hiring budget.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps win it. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THREE SHIFTS ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Where it's going</p>
          <h2 class="dh r" style="--d:.05s">
            How AI rewrote<br />email <span class="serif">design</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            Three real shifts from the last eighteen months. The economics of
            email design moved sharply, fast.
          </p>
        </header>

        <div class="wire">
          {
            shifts.map((s, i) => (
              <article class="wire__item r" style={`--d:${i * 0.06}s`}>
                <header class="wire__meta">
                  <span class="wire__tick" aria-hidden="true"></span>
                  <span class="wire__filed">Filed {s.year}</span>
                  <span class="wire__sep">/</span>
                  <span class="wire__src">{s.src}</span>
                </header>
                <div class="wire__body">
                  <div class="wire__figure">
                    <span class="wire__stat">{s.stat}</span>
                    <span class="wire__cap">{s.statCap}</span>
                  </div>
                  <div class="wire__copy">
                    <h3 class="wire__head">{s.head}</h3>
                    <p class="wire__p">{s.body}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <aside class="risk r" style="--d:.05s">
          <p class="risk__lede">The risk is real.</p>
          <p class="risk__body">
            Same models, same Figma plugins, converging outputs. Marketing
            Brew called it the homogenization risk in its 2025 coverage. The
            studios still winning email work are the ones whose creative
            direction is strong enough that AI amplifies it, instead of
            standing in for it.
          </p>
        </aside>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Five questions,<br /><span class="serif">answered</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What brands ask before the first call.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us an email job. Inside one week: two layout directions and a
          render test report. No retainer, no commitment. Yours to keep, even
          if you walk.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
    display: grid;
    gap: 18px;
  }
  .band--split {
    max-width: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .band--split {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 18px 60px;
    }
    .band--split > div {
      display: grid;
      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .band__note--light {
    color: rgba(240, 237, 233, 0.76);
  }

  /* Calibration colour bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }
  .cbar--end {
    margin-top: clamp(60px, 8vw, 110px);
  }

  /* ===================== S1 · Hero ===================== */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
