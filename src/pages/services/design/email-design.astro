  }
  .creds {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .cred {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
