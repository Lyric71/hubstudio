  .end__reg {
    position: absolute;
    width: clamp(300px, 36vw, 560px);
    top: -16%;
    right: -9%;
    color: rgba(240, 237, 233, 0.05);
    pointer-events: none;
  }
  .end__inner {
    position: relative;
    display: grid;
    justify-items: start;
