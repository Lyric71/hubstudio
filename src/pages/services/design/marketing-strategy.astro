---
/**
 * Marketing Strategy  ·  /services/design/marketing-strategy
 *
 * Mirrors /services/design/packaging-merch-design and
 * /services/design/creative-strategy: same "Pressroom" art direction
 * (crop marks, calibration colour bar, mono figure labels) adapted to
 * marketing strategy work. Copy from marketing-strategy-page.md, folded
 * into the existing nine-section layout. Process step numerals dropped
 * per the no-numbers rule. Pricing softened per the no-pricing rule.
 *
 * Imagery lives in /public/Images with the ms- prefix.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Six invented sample brands, one per category named in the source
   studio-samples line: FMCG launch into Indonesia and Vietnam, luxury
   beauty across DACH, consumer tech entry in China, premium spirits
   across four markets, retail private label GTM, B2B SaaS sprint. */
const samples = [
  {
    src: '/Images/ms-sample-aldair.jpg',
    brand: 'Aldair',
    kind: 'FMCG launch, Indonesia + Vietnam',
    alt: 'A printed Aldair multi-market launch plan open to a five-market launch calendar, beside three ICP cards and a swatch row.',
  },
  {
    src: '/Images/ms-sample-norven.jpg',
    brand: 'Norven',
    kind: 'Luxury beauty, DACH',
    alt: 'A Norven positioning brief on a plaster surface, open at a DACH category whitespace map beside two velour swatch cards.',
  },
  {
    src: '/Images/ms-sample-pelora.jpg',
    brand: 'Pelora',
    kind: 'Consumer tech, China entry',
    alt: 'A Pelora China GTM artifact showing a Douyin, Xiaohongshu and WeChat journey map beside a folded smartphone mock.',
  },
  {
    src: '/Images/ms-sample-mereth.jpg',
    brand: 'Mereth',
    kind: 'Premium spirits, four markets',
    alt: 'A Mereth four-market launch sequence on dark stone, with a stacked-bar channel mix chart and three hook variants.',
  },
  {
    src: '/Images/ms-sample-astrel.jpg',
    brand: 'Astrel',
    kind: 'Retail private label GTM',
    alt: 'An Astrel retail playbook on a sand stoneware tray, open at a channel matrix beside a SKU range card.',
  },
  {
    src: '/Images/ms-sample-vellen.jpg',
    brand: 'Vellen',
    kind: 'B2B SaaS positioning sprint',
    alt: 'A Vellen B2B SaaS positioning brief on a worktable, open at a seven-column category entry points chart.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Results stats, from the source's roughly thirty engagements over two
   years. Numbers chosen to match the three datapoints the source itself
   names (3-week first plan, 6x variants tested, 30 engagements). */
const stats = [
  { from: 0, to: 3, suffix: 'wks', label: 'First plan delivered', note: 'Vs 12 to 16 week baseline' },
  { from: 0, to: 6, suffix: 'x', label: 'Creative variants tested', note: 'Before any launch decision' },
  { from: 0, to: 30, suffix: '', label: 'Strategy engagements', note: 'Across two years' },
];

/* Two coverage lanes. The source brief breaks into roughly six lanes
   (market research, ICP, positioning, Share of Model, GTM plan, launch
   creative). Grouped into two for the two-feature layout: the strategic
   thinking lane, and the distinctive Share of Model and AEO lane the
   source itself sets apart with its own pulled quote. */
const coverage = [
  {
    fig: 'B',
    label: 'Research and strategy',
    heading: 'The thinking, pressure-tested before launch.',
    image: '/Images/ms-cover-research.jpg',
    alt: 'Studio flat-lay of marketing strategy research: a competitor teardown booklet, a market segmentation chart, three ICP behavioral persona cards, a share-of-voice bar chart.',
    body: [
      'Market and category research: competitor mapping, share of voice, desk research, social listening across Western and Chinese platforms, sales calls, reviews. ICP work rebuilt from behavioral signal, not a panel-of-six from five years ago. Synthetic respondent panels pressure-check variants before any live testing.',
      'Positioning is the slowest part on purpose. Frame, promise, supporting proof, and the line that survives translation into five languages. AI generates the variants in parallel. The call on which one ships stays human.',
    ],
    tags: [
      'Market research', 'Category mapping', 'Competitor teardown',
      'ICP rebuild', 'Synthetic panels', 'Positioning frame',
      'Voice and proof', 'Whitespace map', 'Social listening',
      'Review mining',
    ],
  },
  {
    fig: 'C',
    label: 'Share of Model, AEO and GTM',
    heading: 'The lane most strategy decks still skip.',
    image: '/Images/ms-cover-aeo.jpg',
    alt: 'A studio flat-lay of an AEO audit: a printed brand citation ranking across five LLM platforms, a sentiment heatmap, and a laptop showing an AI search result page.',
    lead: 'Share of Model measures how often, prominently and favorably brands appear in AI-generated responses. The same brand can command nearly a quarter of mentions on one model and almost none on another.',
    body: [
      'We audit citation frequency, position and sentiment across ChatGPT, Perplexity, Gemini, Claude and AI Overviews, then benchmark against your direct competitors. Brand mentions on Reddit, niche YouTube and LinkedIn carry roughly three times the AI-visibility weight of classic backlinks. That changes where you spend.',
      'Findings feed the go-to-market plan: launch sequence, channel mix, paid and organic split, a 90-day rollout with KPIs. Every engagement closes with a launch creative pack: three to five message variants rendered as ad creative, hero blocks, social posts and subject lines, ready for an existing team to ship.',
    ],
    tags: [
      'AEO audit', 'ChatGPT', 'Perplexity', 'Gemini', 'AI Overviews',
      'Citation frequency', 'Position and sentiment', 'GTM plan',
      'Channel mix', 'Launch creative pack',
    ],
  },
];

/* Activation credentials, named in the launch-and-channels copy. */
const credentials = ['Paid media', 'Organic and SEO', 'Influencer and KOL', 'Partnerships'];

/* Process steps. The source itself frames strategic direction as the
   step that matters most, which sets the "where it is won" tier.
   Numerals dropped per the no-numbers rule. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and immersion.',
    body: 'Objective, geos, current positioning, sales data, the brand book if it exists. A CRM extract if you can share it. Thin data is fine, we flag the gaps.',
    image: '/Images/ms-p1-brief.jpg',
    alt: 'A marketing strategist at a worktable taking notes in a paper notebook beside a printed client brief and a laptop showing a sales dashboard.',
  },
  {
    short: 'Research synthesis',
    tier: 'Where it is won',
    title: 'Research synthesis. The step that matters most.',
    body: 'Competitor teardown, Share of Model audit, social listening, review mining, ICP rebuild. Work that used to fill three months of senior strategist time now fills three or four days, which is what makes the next step possible.',
    image: '/Images/ms-p2-research.jpg',
    alt: 'A strategist annotating a competitor share-of-voice chart on a laptop while three AEO citation printouts are pinned to a plaster wall behind.',
  },
  {
    short: 'Strategic direction',
    tier: 'The rest is execution',
    title: 'Three strategic directions in parallel.',
    body: 'Three positioning routes, each rooted in a category insight, with frame, promise, supporting proof and a working tagline. You choose between strategies, not moodboards.',
    image: '/Images/ms-p3-direction.jpg',
    alt: 'A senior strategist standing in front of three pinned positioning direction boards on a plaster wall, hand pointing at the middle board.',
  },
  {
    short: 'Pressure test',
    tier: 'The rest is execution',
    title: 'Pressure test against panels and creative.',
    body: 'Each direction tested against synthetic respondent panels for comparative work, then rendered as actual creative so you see how the strategy lands as an ad, not as an adjective.',
    image: '/Images/ms-p4-pressuretest.jpg',
    alt: 'A printed synthetic panel scorecard beside a fabric board showing six campaign creative variants, three of them tagged with coloured stickers.',
  },
  {
    short: 'GTM plan',
    tier: 'The rest is execution',
    title: 'GTM plan and launch pack.',
    body: 'Final positioning, channel mix, a 90-day sequence with KPIs, and a launch creative pack ready to ship: three to five message variants rendered as ad creative, hero blocks, social posts and subject lines.',
    image: '/Images/ms-p5-gtm.jpg',
    alt: 'A printed 90-day go-to-market plan booklet open at a channel sequence calendar, beside a KPI dashboard sheet and a stack of launch creative variant cards.',
  },
];

/* The old consultancy timeline, set against our three-week first plan.
   The source FAQ contrasts heritage agencies that run on quarters with
   our workflow that runs on weeks. */
const oldPhases = [
  { label: 'Research', dur: 'Five weeks', span: 5 },
  { label: 'Positioning', dur: 'Five weeks', span: 5 },
  { label: 'GTM plan', dur: 'Four weeks', span: 4 },
];

/* FAQ: source has thirteen questions; the layout supports any number. */
const faqs = [
  {
    q: 'How long does a strategy project take?',
    a: 'Three weeks for a first plan and creative pack on a single market. Four to six weeks for multi-market or multi-product. Faster on extensions of an existing brand. Industry benchmark for agency brand strategy is twelve to sixteen weeks.',
  },
  {
    q: 'What does it cost?',
    a: 'We quote project-based after the first call, once the brief and market list are clear. Pricing scales with markets, languages and asset volume. Retainer arrangements work for clients running multiple engagements per quarter.',
  },
  {
    q: 'How fast can we start?',
    a: 'First call within 48 hours of you sending the brief. Discovery begins the same week if there is a kickoff slot. We sign NDAs as standard before any data leaves your side.',
  },
  {
    q: 'How is this different from a traditional brand consultancy?',
    a: 'A few things. Research is AI-led, which means the strategist spends time on judgment instead of data gathering. Every direction gets pressure-tested with real creative and synthetic panels before final selection, not after the campaign launches. And we ship the launch creative as part of the engagement rather than as a separate scope. The deck-only model is wasteful, especially now that AI has made the analytical work cheap.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three. Most projects wrap inside two because the pressure-test step kicks the obvious objections out early. Round three is usually about fine-tuning a tagline or swapping one channel weighting in the 90-day plan.',
  },
  {
    q: 'What do I need to send to get started?',
    a: 'Business objective, target markets, timeline. Brand guidelines if you have them. Sales data, prior research, customer feedback, support tickets. Competitor list. Current positioning and what is or is not working. CRM extract is gold. Thin data is fine, we flag the gaps.',
  },
  {
    q: 'Who does the work?',
    a: 'Senior strategists with agency backgrounds (Publicis, Ogilvy, WPP) lead every engagement. AI specialists handle research synthesis and asset generation. The recommendation is always written by a named human. Creative talent for the launch pack comes from the client target culture.',
  },
  {
    q: 'How do you handle the Share of Model and AEO side?',
    a: 'A baseline audit across ChatGPT, Perplexity, Gemini, Claude and AI Overviews. How often your brand appears against category prompts, in what position, with what sentiment. We benchmark against your direct competitors. The findings shape the channel mix and the content architecture. Most brands discover their SEO authority does not translate cleanly to LLM citation.',
  },
  {
    q: 'Can you really validate with synthetic respondents?',
    a: 'For comparative work, yes. Which claim wins. Which price point maximizes intent. Which positioning resonates. The rank order tends to hold up against later human validation, which is the part most clients are surprised by. Synthetic work is weak on revenue forecasting and market sizing, and it gets unreliable in categories with thin model training data. We adjust the methodology where we know the bias is showing.',
  },
  {
    q: 'Will the strategy actually be ours, or a recycled framework?',
    a: 'Yours. Frameworks are standard, inputs are not. We train our research on your category, your data, your competitive set.',
  },
  {
    q: 'Can you handle a multi-market launch, or just one market?',
    a: 'Both. Some clients come for one repositioning in one geography. Others come with a launch across five markets, three languages, four product lines. AI handles the localization volume that used to need twenty strategists. We staff creative talent from each target culture.',
  },
  {
    q: 'Do you deliver the creative assets, or just the plan?',
    a: 'Both. Every engagement includes a launch creative pack. Full campaign production is optional and scoped separately.',
  },
  {
    q: 'Where are you based, and how do timezones work?',
    a: 'Shanghai. We staff senior strategists and creative talent from clients target cultures, so the people on your brief sit closer to your market. Day-to-day operations work to your timezone. Standing weekly calls and async docs cover the rest. We have delivered strategy into the US, EU, UK, Middle East and APAC.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/services/design/marketing-strategy`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Marketing Strategy',
  description:
    'AI-native marketing and go-to-market strategy: research, positioning, ICP definition and AI-search plans, shipped with the launch creative needed to test them.',
  serviceType: 'Marketing and go-to-market strategy',
  url: pageUrl,
  provider: { '@type': 'Organization', name: 'hubStudio', url: SITE },
  areaServed: 'Worldwide',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE}/services` },
    { '@type': 'ListItem', position: 3, name: 'Marketing Strategy', item: pageUrl },
  ],
};
---

<Layout
  title="Marketing Strategy Services | AI-Native | hubStudio"
  description="AI-native marketing and go-to-market strategy. Research, positioning, ICP and AI-search plans, with launch creative, delivered in weeks not quarters."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Strategy service
            <span class="kicker__sep">/</span> Marketing Strategy
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Marketing</span></span>
            <span class="line"><span class="line__i serif">Strategy.</span></span>
            <span class="line"><span class="line__i">Tested early.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            From market signal to launch, <em>with the assets to test it.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A client called last September. CPG brand, five-market
              launch the following spring. Briefed her agency in March.
              Four months later: a 60-slide deck. Good work. Nobody had
              tested a hook with a real buyer, and by then half of Q4
              was booked.
            </p>
            <p>
              The deck-only engagement is not on offer here. We close
              the loop in the same engagement: research, strategy,
              creative pressure test, GTM plan, launch pack. Weeks, not
              quarters.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Strategy + launch creative
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/ms-hero.jpg"
          alt="A marketing strategist at a long oak worktable in a Shanghai studio, surrounded by printed market reports, ICP cards and a laptop showing a share-of-voice chart."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Strategy floor</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              AI made research<br />a week of work.<br /><span class="serif">Everything else</span> changed with it.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              hubStudio was founded by the former CEO of Publicis
              Commerce for China and North Asia (2019 to 2023) to
              rebuild the strategy loop. The old loop was research,
              strategy, creative, launch, learn. The learn step
              happened in market, six months too late.
            </p>
            <p class="r" style="--d:.16s">
              Desk research, competitor teardown, sentiment analysis,
              ICP refresh. Work that filled three months of senior
              strategist time now fills three days, sometimes four if
              the category is messy. The real shift is not speed.
              Strategy can be tested empirically before launch, in the
              same engagement that produced it.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Studio samples include <strong>FMCG launches</strong>,
              <strong>luxury beauty</strong>, <strong>premium spirits</strong>,
              <strong>consumer tech</strong> and <strong>B2B SaaS</strong>
              positioning sprints. Most under NDA.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/ms-roots.jpg"
              alt="A Shanghai marketing strategy room: three strategists around a long worktable, surrounded by printed market data and pinned positioning maps."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The strategy room, Shanghai</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across roughly thirty strategy engagements over two years,
            first plans land in three weeks against a twelve-to-sixteen
            week industry baseline. Six creative variants tested before
            any launch decision, and a measurably higher hit rate once
            positioning is pressure-tested upfront.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            One engagement, the <span class="serif">whole plan</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Strategy artifacts and launch specimens, authored in the
            studio. Brands are anonymised; the work is real.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · ACTIVATION (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/ms-activation.jpg"
                alt="Two marketing activation specialists at a long worktable with two laptops showing a paid-media dashboard and a launch calendar, behind them a wall of pinned campaign creatives."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/ms-activation-inset.jpg"
              alt="Two hands annotating a printed launch calendar grid with a pencil on a warm oak surface."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">2&ndash;4 wks</span>
            <span class="source__stat-cap">Plan approval to first campaign live</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need the campaign<br />built too? We can <span class="serif">run</span> it.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Optional. Most clients activate with their existing team.
            The strategy, GTM plan and launch creative pack are built
            to be picked up by another agency or in-house studio on
            day one.
          </p>
          <p class="source__p r" style="--d:.16s">
            If you would rather we run activation alongside, we do
            that too. Paid media, organic and SEO, influencer and KOL,
            partnerships and trade, coordinated through one team using
            the same audience work and brand-trained models that built
            the platform. Plan approval to first campaign live in two
            to four weeks.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Social listening across Western and Chinese platforms. AEO
            tracking across ChatGPT, Perplexity, Gemini, Claude and AI
            Overviews. We also watch Tencent Hunyuan and Alibaba Qwen
            because the Chinese models are catching up faster than
            most Western marketers realize.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            The strategy, GTM plan, prompt systems and any brand-trained
            models are yours either way.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Research first.<br />The rest follows <span class="serif">faster</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          The gap between AI adoption and AI impact is a strategy gap,
          not a tooling gap. So we do the unglamorous work upfront,
          then move quickly because the research is already pressure
          tested.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A CPG brand lands with a five-market launch brief, three
            languages, four product lines, a Q3 GTM. The same scope,
            run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The agency workflow</span>
              <span class="vs__total">Fourteen weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Mid-tier agency timeline: five weeks for research and
                ICP work, five for positioning rounds, four for the GTM
                plan. Three rounds of revision, partner time billed at
                full rate, junior teams running the work. Heritage
                consultancies stretch the same scope across two quarters
                or more.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Three weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">First plan and creative pack</span>
                  <span class="vs__seg-dur">Three weeks</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Three positioning directions worked through in parallel.
                Synthetic respondent panels pressure-test before any
                live spend. Each direction rendered as actual creative
                so the room is choosing between strategies, not
                moodboards. GTM plan, channel mix and launch creative
                pack land in the same engagement.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Thirteen questions,<br /><span class="serif">answered</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not
            here, put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a<br />real <span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us a launch or repositioning brief. Inside three weeks
          you get a strategic direction, a 90-day plan and the launch
          creative pack. No retainer attached, no commitment to keep
          working with us. Whatever we deliver in those three weeks is
          yours regardless.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
    display: grid;
    gap: 18px;
  }
  .band--split {
    max-width: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .band--split {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 18px 60px;
    }
    .band--split > div {
      display: grid;
      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .band__note--light {
    color: rgba(240, 237, 233, 0.76);
  }

  /* Calibration colour bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }
  .cbar--end {
    margin-top: clamp(60px, 8vw, 110px);
  }

  /* ===================== S1 · Hero ===================== */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__panel {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px);
    overflow: clip;
  }
  .hero__reg {
    position: absolute;
    width: clamp(240px, 28vw, 420px);
    right: -12%;
    bottom: -14%;
    color: rgba(240, 237, 233, 0.055);
    pointer-events: none;
  }
  .hero__panel-in {
    position: relative;
    width: 100%;
    max-width: 600px;
  }
  .hero__title {
    margin-top: 24px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(46px, 6.6vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding: 0.22em 0.14em;
    margin: -0.22em -0.14em;
  }
  .hero__title .line__i {
    display: block;
    transform: translateY(145%);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero__title .line:nth-child(1) .line__i {
    transition-delay: 0.12s;
  }
  .hero__title .line:nth-child(2) .line__i {
    transition-delay: 0.22s;
  }
  .hero__title .line:nth-child(3) .line__i {
    transition-delay: 0.32s;
  }
  .hero.in .hero__title .line__i {
    transform: translateY(0);
  }
  .hero__title .serif {
    font-size: 1.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line__i {
      transform: none;
    }
  }
  .hero__tag {
    margin-top: 26px;
    font-size: clamp(18px, 1.5vw, 23px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__tag em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .hero__lead {
    margin-top: 20px;
    display: grid;
    gap: 13px;
    max-width: 46ch;
  }
  .hero__lead p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.74);
  }
  .hero__cta {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero__meta {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1.5px dashed rgba(240, 237, 233, 0.2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
  }
  .hero__meta span {
    color: var(--brand-orange);
  }
  .hero__visual {
    position: relative;
    overflow: hidden;
    min-height: 58vh;
  }
  @media (min-width: 900px) {
    .hero__visual {
      min-height: auto;
    }
  }
  .hero__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero.in .hero__visual img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual img {
      transform: none;
    }
  }
  .hero__chip {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.78);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }
  .hero__chip span {
    color: var(--brand-orange);
  }

  /* ===================== S2 · Why ===================== */
  .why {
    background: var(--ink);
    color: var(--text-on-dark);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .why__top {
    display: grid;
    gap: 30px;
  }
  @media (min-width: 900px) {
    .why__top {
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: start;
    }
  }
  .why__head .dh {
    margin-top: 18px;
  }
  .why__text {
    display: grid;
    gap: 16px;
    align-content: start;
    padding-top: 6px;
  }
  .why__text p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.78);
  }
  .why__clients {
    color: rgba(240, 237, 233, 0.6) !important;
  }
  .why__clients strong {
    color: var(--text-on-dark);
    font-weight: 600;
  }
  .why__shot {
    margin-top: clamp(40px, 5vw, 72px);
  }
  .why__shot .crop__inner {
    aspect-ratio: 16 / 8;
  }
  .why__shot .fig {
    color: rgba(240, 237, 233, 0.5);
  }

  /* Stats */
  .stats {
    margin-top: clamp(48px, 6vw, 84px);
    border-top: 1.5px dashed rgba(240, 237, 233, 0.22);
    padding-top: clamp(36px, 4vw, 56px);
  }
  .stats__quote {
    max-width: 60ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(19px, 1.9vw, 25px);
    line-height: 1.42;
    color: var(--text-on-dark);
  }
  .stats__grid {
    margin-top: 40px;
    display: grid;
    gap: 30px;
  }
  @media (min-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .stat {
    display: grid;
    gap: 5px;
    padding-top: 24px;
    border-top: 1.5px solid rgba(240, 237, 233, 0.16);
  }
  .stat__num {
    font-size: clamp(56px, 7vw, 96px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--brand-orange);
  }
  .stat__label {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 600;
  }
  .stat__note {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.55);
  }

  /* ===================== S3 · Cover ===================== */
  .cover {
    background: var(--paper);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .feature {
    display: grid;
    gap: 36px;
    align-items: center;
    padding-block: clamp(40px, 5vw, 72px);
    border-top: 1.5px dashed var(--line-strong);
  }
  .feature:last-child {
    border-bottom: 1.5px dashed var(--line-strong);
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
    }
    .feature--rev .feature__media {
      order: 2;
    }
  }
  .feature__media .crop__inner {
    aspect-ratio: 5 / 4;
  }
  .feature__idx {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .feature__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .feature__body .dh {
    margin-top: 16px;
  }
  .feature__lead {
    margin-top: 14px;
    font-size: var(--type-lead);
    line-height: 1.42;
    color: var(--text-ink);
    font-weight: 500;
  }
  .feature__p {
    margin-top: 14px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .feature__scope {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .chips {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 500;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .chip:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
  }

  /* ===================== S4 · Proof sheet ===================== */
  .proof {
    background: var(--bg-white);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .sheet {
    display: grid;
    gap: clamp(22px, 3vw, 40px);
  }
  @media (min-width: 720px) {
    .sheet {
      grid-template-columns: repeat(3, 1fr);
    }
    .sheet .shot:nth-child(3n + 2) {
      margin-top: 60px;
    }
    .sheet .shot:nth-child(3n) {
      margin-top: 30px;
    }
  }
  .shot .crop__inner {
    aspect-ratio: 1 / 1;
