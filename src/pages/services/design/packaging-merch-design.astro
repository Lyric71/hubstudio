    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }
  .hero__chip span {
    color: var(--brand-orange);
  }

  /* ===================== S2 · Why ===================== */
  .why {
    background: var(--ink);
    color: var(--text-on-dark);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .why__top {
    display: grid;
    gap: 30px;
  }
  @media (min-width: 900px) {
    .why__top {
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: start;
    }
  }
  .why__head .dh {
    margin-top: 18px;
  }
  .why__text {
    display: grid;
    gap: 16px;
