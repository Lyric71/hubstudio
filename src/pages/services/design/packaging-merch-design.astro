      grid-template-columns: 0.82fr 1.18fr;
      gap: 44px;
      align-items: center;
    }
  }
  .wf__row--old {
    background: var(--bg-cream);
    border: 1px solid var(--line-hairline);
  }
  .wf__row--new {
    background: var(--bg-ink);
    color: var(--text-on-dark);
    box-shadow: 0 34px 70px -34px rgba(10, 16, 40, 0.6);
  }
  .wf__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wf__tag::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .wf__tag--old {
    color: var(--text-mute);
  }
  .wf__tag--new {
    color: var(--brand-orange);
  }
  .wf__total {
    display: block;
    margin-top: 12px;
