  }
  .feature__p {
    margin-top: 14px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .feature__scope {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
