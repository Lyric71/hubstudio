  .accordion {
    display: grid;
  }
  .acc-row {
    border-top: 1px solid var(--line-strong);
  }
  .acc-row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .acc-row__q {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    background: transparent;
    border: none;
    text-align: left;
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-ink);
    transition: color 160ms ease-out;
  }
  .acc-row__q:hover {
    color: var(--brand-orange);
  }
  .acc-row__icon {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 3px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background-color 200ms ease-out, border-color 200ms ease-out;
  }
  .acc-row__q[aria-expanded='true'] .acc-row__icon {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
  }
  .acc-row__icon span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), background-color 200ms ease-out;
  }
  .acc-row__icon span:last-child {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .acc-row__q[aria-expanded='true'] .acc-row__icon span {
    background: #fff;
  }
  .acc-row__q[aria-expanded='true'] .acc-row__icon span:last-child {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .acc-row__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms ease-in-out;
  }
  .acc-row__q[aria-expanded='true'] + .acc-row__a {
    grid-template-rows: 1fr;
  }
  .acc-row__a-inner {
    overflow: hidden;
  }
  .acc-row__a-inner p {
    padding-bottom: 24px;
    max-width: 62ch;
    font-size: var(--type-small);
    line-height: 1.65;
    color: var(--text-mute);
  }
  .acc-row__link {
    color: var(--brand-orange);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ============================================================
     S9  Closing CTA
     ============================================================ */
  .closing {
    position: relative;
    overflow: clip;
    color: var(--text-on-dark);
    background:
      radial-gradient(46% 60% at 86% 0%, rgba(233, 78, 27, 0.32), transparent 66%),
      radial-gradient(50% 64% at 6% 100%, rgba(30, 58, 138, 0.46), transparent 70%),
      var(--bg-ink);
  }
  .closing__inner {
    position: relative;
    text-align: center;
    padding-block: var(--section-pad-y-mobile);
    display: grid;
    justify-items: center;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .closing__inner {
      padding-block: var(--section-pad-y-desktop);
    }
  }
  .closing .eyebrow {
    color: var(--brand-orange);
  }
  .closing__head {
    max-width: 18ch;
  }
  .closing__head .accent {
    color: var(--brand-orange);
  }
  .closing__p {
    max-width: 56ch;
    font-size: var(--type-lead);
    line-height: 1.5;
    color: rgba(240, 237, 233, 0.78);
  }
  .closing__line {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.55);
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---- Scroll progress bar ---- */
  const progress = document.querySelector<HTMLElement>('.scroll-progress__bar');
  if (progress) {
    const onScrollProgress = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      progress.style.transform = `scaleX(${max > 0 ? Math.min(1, doc.scrollTop / max) : 0})`;
    };
    onScrollProgress();
    window.addEventListener('scroll', onScrollProgress, { passive: true });
    window.addEventListener('resize', onScrollProgress);
  }

  /* ---- Reveal on scroll (staggered) ---- */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -7% 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }

  /* ---- Count-up stats ---- */
  const counters = Array.from(document.querySelectorAll<HTMLElement>('.stat__num'));
  if (counters.length) {
    const runCount = (el: HTMLElement) => {
      const from = Number(el.dataset.countFrom || 0);
      const to = Number(el.dataset.countTo || 0);
      const suffix = el.dataset.suffix || '';
      if (reduceMotion.matches) {
        el.textContent = `${to}${suffix}`;
        return;
      }
      const dur = 1500;
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = `${Math.round(from + (to - from) * eased)}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if ('IntersectionObserver' in window) {
      const co = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              runCount(entry.target as HTMLElement);
              co.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );
      counters.forEach((c) => co.observe(c));
    } else {
      counters.forEach(runCount);
    }
  }

  /* ---- Gentle parallax on framed images ---- */
  const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('.parallax'));
  if (parallaxEls.length && !reduceMotion.matches) {
    let ticking = false;
    const applyParallax = () => {
      const vh = window.innerHeight;
      parallaxEls.forEach((el) => {
        const frame = (el.closest('.pfx') as HTMLElement) || el;
        const r = frame.getBoundingClientRect();
        if (r.bottom < -120 || r.top > vh + 120) return;
        const offset = (r.top + r.height / 2 - vh / 2) / vh;
        el.style.transform = `translate3d(0, ${(-offset * 46).toFixed(1)}px, 0)`;
      });
      ticking = false;
    };
    const requestParallax = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(applyParallax);
      }
    };
    applyParallax();
    window.addEventListener('scroll', requestParallax, { passive: true });
    window.addEventListener('resize', requestParallax);
  }

  /* ---- Hero sample carousel ---- */
  const car = document.querySelector<HTMLElement>('.pcar');
  if (car) {
    const slides = Array.from(car.querySelectorAll<HTMLElement>('.pcar__slide'));
    const dots = Array.from(car.querySelectorAll<HTMLButtonElement>('.pcar__dot'));
    const prev = car.querySelector<HTMLButtonElement>('.pcar__nav--prev');
    const next = car.querySelector<HTMLButtonElement>('.pcar__nav--next');
    let index = 0;
    let timer: number | undefined;

    const render = () => {
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.dataset.active = String(active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.dataset.active = String(active);
        dot.setAttribute('aria-selected', String(active));
        const fill = dot.firstElementChild as HTMLElement | null;
        if (fill && active) {
          fill.style.animation = 'none';
          void fill.offsetWidth;
          fill.style.animation = '';
        }
      });
    };
    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      render();
    };
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
      car.dataset.paused = 'true';
    };
    const start = () => {
      if (reduceMotion.matches || slides.length < 2) return;
      stop();
      car.dataset.paused = 'false';
      timer = window.setInterval(() => go(index + 1), 3500);
    };

    prev?.addEventListener('click', () => { go(index - 1); start(); });
    next?.addEventListener('click', () => { go(index + 1); start(); });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => { go(i); start(); }),
    );
    car.addEventListener('pointerenter', stop);
    car.addEventListener('pointerleave', start);
    car.addEventListener('focusin', stop);
    car.addEventListener('focusout', start);

    render();
    start();
  }

  /* ---- S3 What we cover: tab switcher ---- */
  const cover = document.querySelector<HTMLElement>('.cover');
  if (cover) {
    const tabs = Array.from(cover.querySelectorAll<HTMLButtonElement>('.cover__tab'));
    const panels = Array.from(cover.querySelectorAll<HTMLElement>('.cover__panel'));
    const selectTab = (id: string) => {
      cover.dataset.active = id;
      tabs.forEach((t) =>
        t.setAttribute('aria-selected', String(t.dataset.tab === id)),
      );
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        p.dataset.active = String(on);
        p.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(tab.dataset.tab || ''));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' ? 1 : -1;
        const nextTab = tabs[(i + dir + tabs.length) % tabs.length];
        nextTab.focus();
        selectTab(nextTab.dataset.tab || '');
      });
    });
  }

  /* ---- S6 Process: horizontal timeline fill ---- */
  const ptl = document.querySelector<HTMLElement>('.ptl');
  if (ptl) {
    const fill = ptl.querySelector<HTMLElement>('.ptl__rail-fill');
    const tlSteps = Array.from(ptl.querySelectorAll<HTMLElement>('.ptl__step'));
    const isWide = window.matchMedia('(min-width: 861px)');
    let ticking = false;
    const updateTimeline = () => {
      ticking = false;
      if (!isWide.matches) {
        if (fill) fill.style.width = '100%';
        tlSteps.forEach((s) => (s.dataset.active = 'true'));
        return;
      }
      const vh = window.innerHeight;
      const r = ptl.getBoundingClientRect();
      const raw = (vh * 0.82 - r.top) / (r.height + vh * 0.3);
      const p = Math.max(0, Math.min(1, raw));
      if (fill) fill.style.width = `${(p * 100).toFixed(1)}%`;
      const reached = p * tlSteps.length;
      tlSteps.forEach((s, i) => {
        s.dataset.active = String(i < Math.max(1, Math.ceil(reached)));
      });
    };
    const requestTimeline = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateTimeline);
      }
    };
    updateTimeline();
    window.addEventListener('scroll', requestTimeline, { passive: true });
    window.addEventListener('resize', requestTimeline);
  }

  /* ---- S7 hub4You window: subtle pointer tilt ---- */
  const tiltEl = document.querySelector<HTMLElement>('[data-tilt]');
  if (tiltEl && !reduceMotion.matches && window.matchMedia('(pointer: fine)').matches) {
    const reset = () => {
      tiltEl.style.transform = 'perspective(1100px) rotateX(0deg) rotateY(0deg)';
    };
    tiltEl.addEventListener('pointermove', (e) => {
      const r = tiltEl.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tiltEl.style.transform = `perspective(1100px) rotateX(${(-y * 6).toFixed(2)}deg) rotateY(${(x * 8).toFixed(2)}deg)`;
    });
    tiltEl.addEventListener('pointerleave', reset);
    reset();
  }

  /* ---- FAQ accordion: one row open at a time ---- */
  const accRows = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc-row__q'));
  accRows.forEach((row) => {
    row.addEventListener('click', () => {
      const open = row.getAttribute('aria-expanded') === 'true';
      accRows.forEach((r) => r.setAttribute('aria-expanded', 'false'));
      row.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
