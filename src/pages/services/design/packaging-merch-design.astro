  /* Pinned mode: the stage sticks while steps advance with scroll. */
  .craft--pinned .seq {
    height: 480vh;
  }
  .craft--pinned .seq__stick {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
