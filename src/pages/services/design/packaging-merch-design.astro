    font-size: 16px;
    font-weight: 600;
  }
  .stat__note {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.55);
  }

  /* ===================== S3 · Cover ===================== */
  .cover {
    background: var(--paper);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .feature {
    display: grid;
    gap: 36px;
    align-items: center;
    padding-block: clamp(40px, 5vw, 72px);
