  .wf__p {
    margin-top: 14px;
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .wf__row--new .wf__p {
    color: rgba(240, 237, 233, 0.82);
  }
  .wf__bar {
    display: flex;
    gap: 4px;
    height: 92px;
  }
  .wf__seg {
    flex: var(--span, 1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;
    padding: 12px 14px;
    border-radius: 12px;
    color: #fff;
    overflow: hidden;
    transform: scaleX(0);
    transform-origin: left;
  }
  .wf__row.is-in .wf__seg {
    transform: scaleX(1);
    transition: transform 760ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(280ms + var(--i, 0) * 150ms);
  }
  .wf__row--old .wf__seg:nth-child(1) {
    background: #8d8980;
  }
  .wf__row--old .wf__seg:nth-child(2) {
    background: #a8a299;
  }
  .wf__row--old .wf__seg:nth-child(3) {
    background: #c2bcb1;
  }
  .wf__seg-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .wf__seg-weeks {
    font-family: var(--font-mono);
