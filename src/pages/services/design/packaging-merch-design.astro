    color: var(--text-mute);
  }
  .acc {
    display: grid;
  }
  .acc__row {
    border-top: 1.5px solid var(--ink);
  }
  .acc__row:last-child {
    border-bottom: 1.5px solid var(--ink);
  }
  .acc__q {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 16px;
    padding: 26px 0;
    background: transparent;
    border: none;
    text-align: left;
  }
  .acc__qmark {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-orange);
    padding-top: 3px;
  }
  .acc__qtext {
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-ink);
    transition: color 0.18s ease;
  }
  .acc__q:hover .acc__qtext {
    color: var(--brand-orange);
  }
  .acc__icon {
    position: relative;
    width: 22px;
    height: 22px;
    margin-top: 2px;
  }
  .acc__icon span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--text-ink);
    transform: translate(-50%, -50%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .acc__icon span:last-child {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .acc__q[aria-expanded='true'] .acc__icon span {
    background: var(--brand-orange);
  }
  .acc__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.32s ease;
  }
  .acc__q[aria-expanded='true'] + .acc__a {
    grid-template-rows: 1fr;
  }
  .acc__a-inner {
    overflow: hidden;
  }
  .acc__a-inner p {
    padding: 0 0 26px 41px;
    max-width: 64ch;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .acc__a-inner a {
