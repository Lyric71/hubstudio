  /* Horizontal timeline */
  .ptl {
    position: relative;
  }
  .ptl__rail {
    position: absolute;
    top: 9px;
    left: 10%;
    right: 10%;
    height: 3px;
    border-radius: 2px;
    background: var(--line-strong);
  }
  .ptl__rail-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 2px;
    background: var(--brand-orange);
  }
  .ptl__steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .ptl__step {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 22px;
    transition: opacity 360ms ease-out;
  }
  .ptl__node {
    justify-self: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 3px solid var(--line-strong);
    background: var(--bg-cream);
    position: relative;
    z-index: 1;
    transition:
      border-color 320ms ease-out,
      background-color 320ms ease-out,
      transform 320ms cubic-bezier(0.34, 1.4, 0.5, 1),
      box-shadow 320ms ease-out;
  }
  .ptl__step[data-active='true'] .ptl__node {
    border-color: var(--brand-orange);
    background: var(--brand-orange);
    transform: scale(1.3);
    box-shadow: 0 0 0 6px rgba(233, 78, 27, 0.16);
  }
  .ptl__card {
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: 18px;
    padding: 24px 22px 26px;
    box-shadow: var(--shadow-card);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 280ms ease-out;
  }
  .ptl__step[data-active='true'] .ptl__card {
    transform: translateY(-8px);
    box-shadow: 0 26px 46px -18px rgba(10, 10, 20, 0.26);
  }
  .ptl__phase {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .ptl__step[data-active='true'] .ptl__phase {
    color: var(--brand-orange);
  }
  .ptl__title {
    margin-top: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .ptl__text {
    margin-top: 9px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-mute);
  }
  @media (min-width: 861px) {
    .ptl__step {
      opacity: 0.46;
    }
    .ptl__step[data-active='true'] {
      opacity: 1;
    }
  }
  @media (max-width: 860px) {
    .ptl__rail {
      display: none;
    }
    .ptl__steps {
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 14px;
      margin-inline: calc(-1 * var(--container-pad-mobile));
      padding-inline: var(--container-pad-mobile);
    }
    .ptl__step {
      scroll-snap-align: center;
      grid-template-rows: none;
      gap: 0;
    }
    .ptl__node {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ptl__step {
      opacity: 1;
    }
  }

