  .source__inset img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  @media (max-width: 520px) {
    .source__inset {
      display: none;
    }
  }
  .source__stat {
    position: absolute;
    left: -10px;
    top: 36px;
    display: grid;
    gap: 3px;
    padding: 15px 19px;
    border-radius: 12px;
    background: var(--brand-orange);
    color: #fff;
    box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42);
