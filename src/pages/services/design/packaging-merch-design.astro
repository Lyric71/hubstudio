  }
  .vs__bar {
    display: flex;
    gap: 4px;
    height: 78px;
  }
  .vs__seg {
    flex: var(--span, 1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;
    padding: 11px 13px;
    border-radius: 9px;
    color: #fff;
    overflow: hidden;
    transform: scaleX(0);
    transform-origin: left;
  }
  .vs__row.in .vs__seg {
    transform: scaleX(1);
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.2s + var(--i, 0) * 0.13s);
  }
  .vs__row--old .vs__seg:nth-child(1) {
    background: #5b5f74;
  }
  .vs__row--old .vs__seg:nth-child(2) {
