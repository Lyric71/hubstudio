---
/**
 * Packaging & Merch Design service page
 * (`/services/design/packaging-merch-design`).
 * Copy from packaging-merch-page.md; hero + roots intros condensed on request.
 * S1 Hero (dark) · S2 eCommerce roots · S2b Results band · S3 What we cover
 * (tabbed) · S4 Sample marquee · S5 Optional sourcing · S6 Process timeline ·
 * S7 The new math · S8 FAQ · S9 Closing CTA.
 *
 * Process numerals (1-5 in the source) are dropped: the project's permanent
 * "no numbers in cards / step lists" rule overrides the source formatting.
 * Imagery generated with scripts/generate-image.mjs unless noted.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Authored packaging / merch samples, each with an invented brand mark.
   Drives both the hero carousel and the full-bleed marquee. */
const samples = [
  {
    src: '/Images/packaging-merch-aurele.jpg',
    brand: 'Aurele',
    kind: 'Skincare packaging',
    alt: 'Frosted glass serum bottle beside a sand-toned folding carton for the Aurele skincare line, on a warm plaster ledge.',
  },
  {
    src: '/Images/packaging-merch-vante.jpg',
    brand: 'Vante',
    kind: 'Luxury gift box',
    alt: 'Deep burgundy rigid gift box with a gold-foil Vante wordmark and a grosgrain ribbon, on a dark stone surface.',
  },
  {
    src: '/Images/packaging-merch-fernwell.jpg',
    brand: 'Fernwell',
    kind: 'Branded merchandise',
    alt: 'Canvas tote bag, stoneware mug and folded t-shirt screen-printed with the Fernwell wordmark, on a sunlit oak table.',
  },
  {
    src: '/Images/packaging-merch-mojo.jpg',
    brand: 'Mojo',
    kind: 'Beverage packaging',
    alt: 'Two coral-orange aluminium cans for the Mojo sparkling drink on a deep-navy surface under hard directional light.',
  },
  {
    src: '/Images/packaging-merch-kasa.jpg',
    brand: 'Kasa',
    kind: 'Cosmetics set',
    alt: 'Two aluminium tubes and a frosted jar printed with the Kasa wordmark, on a pale travertine surface in morning light.',
  },
  {
    src: '/Images/packaging-merch-luma.jpg',
    brand: 'Luma',
    kind: 'PR & influencer box',
    alt: 'Open kraft PR mailer with a printed belly-band reading Luma, holding three products in tissue paper on a concrete tabletop.',
  },
];

/* S2b: results, drawn from the recent-projects line. Counters animate up. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'Creative approval rate', note: 'Lifted from 22%' },
  { from: 0, to: 60, suffix: '%', label: 'Lower content cost', note: 'On recent projects' },
  { from: 0, to: 7, suffix: '×', label: 'Asset output', note: 'Without a single new hire' },
];

/* S3: the two coverage areas, shown as switchable panels. The tag rows
   surface phrases already named in the prose below them. */
const coverTabs = [
  {
    id: 'packaging',
    label: 'Packaging',
    heading: 'What we cover on packaging',
    image: '/Images/packaging-merch-vante.jpg',
    imageAlt: 'Burgundy luxury rigid gift box with a gold-foil wordmark, an example of packaging design.',
    body: [
      'Primary packaging for beauty, FMCG, beverage, electronics and luxury. Outer cartons that protect the product and the brand. Labels, dielines, print-ready files. Sustainable options with real material variants (not a green color swap). Limited editions, seasonal runs, full regulatory localization for ingredient lists, claims and barcodes by market.',
      'You get concept boards, photoreal mockups, and production files your supplier can run with on the first pass. No back-and-forth on missing bleeds at midnight before a print deadline.',
    ],
    tags: [
      'Beauty & FMCG',
      'Beverage',
      'Electronics',
      'Luxury',
      'Outer cartons',
      'Labels & dielines',
      'Print-ready files',
      'Sustainable variants',
      'Limited editions',
      'Regulatory localization',
    ],
  },
  {
    id: 'merchandise',
    label: 'Merchandise',
    heading: 'What we cover on merchandise',
    image: '/Images/packaging-merch-fernwell.jpg',
    imageAlt: 'Canvas tote, mug and folded t-shirt screen-printed with one wordmark, an example of branded merchandise.',
    lead: 'Branded merch designed to be kept, not tossed.',
    body: [
      'Apparel, drinkware, accessories, stationery, tech kit, trade show gear. Influencer mailers and PR boxes built for the unboxing moment. Retail displays, in-store activations, loyalty premiums, gift-with-purchase systems.',
      'Every piece is designed against your brand system and shown in context, so your team can approve it before a supplier quotes.',
    ],
    tags: [
      'Apparel',
      'Drinkware',
      'Accessories',
      'Stationery',
      'Tech kit',
      'Trade show gear',
      'PR & influencer boxes',
      'Retail displays',
      'In-store activations',
      'Loyalty premiums',
    ],
  },
];

/* S5: factory audit credentials, named in the sourcing copy. */
const credentials = ['BSCI', 'SEDEX', 'SA8000', 'NDA in place'];

/* S6: process steps, numerals removed per the no-numbers rule. */
const steps = [
  {
    title: 'Brief and brand immersion.',
    body: 'Visual codes, category context, consumer.',
  },
  {
    title: 'Creative direction. The step that matters most.',
    body: 'Senior creative directors set the territory and the structural concept. This is where a packaging line becomes ownable, and where merch goes from forgettable to collected.',
  },
  {
    title: 'AIGC exploration.',
    body: 'Dozens of directions in parallel, faster than traditional sketching.',
  },
  {
    title: 'Refinement and production.',
    body: 'Dielines, print files, mockups, supplier handover.',
  },
  {
    title: 'Adaptation at scale.',
    body: 'Market variants, SKU extensions, seasonal updates.',
  },
];

/* S7: the old agency timeline, broken into the phases the copy names. */
const oldPhases = [
  { label: 'Concepts', weeks: 'Six weeks', span: 6 },
  { label: 'Adaptations', weeks: 'Two weeks', span: 2 },
  { label: 'Production files', weeks: 'Two weeks', span: 2 },
];

/* S8: FAQ. Wording kept verbatim; one answer links to the Copyright guide. */
const faqs = [
  {
    q: 'How long does a packaging project take?',
    a: "Two to three weeks for design from brief to print-ready files. Faster if it's an SKU extension on an existing system. If you also need production, add 4 to 8 weeks for manufacturing and shipping.",
  },
  {
    q: 'What do I need to send you to get started?',
    a: "Product information, brand guidelines if you have them, a sense of the market, and any reference work you like or hate. If you don't have brand guidelines, we'll work from what exists and flag the gaps.",
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior creative directors from agency backgrounds lead every project. AIGC specialists handle the production volume. No junior teams running the brief.',
  },
  {
    q: 'Do you work in our brand language and visual system, or impose your own?',
    a: 'Yours. We train our AI setup on your existing brand assets, so the output stays inside your visual system, not ours.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle a full SKU range, or just hero packs?',
    a: 'Both. Our setup is built for volume. Some clients come for one hero pack, others come with 200 SKUs across four markets. The workflow scales.',
  },
  {
    q: 'Do you do dielines and print production files, or just concepts?',
    a: 'Full production files. Dielines, bleeds, color profiles, print specs. Your supplier can run with it on the first pass.',
  },
  {
    q: 'What if we already have a packaging supplier we want to keep using?',
    a: 'Fine. We deliver print-ready files and step back. Sourcing is optional, not required.',
  },
  {
    q: 'How does pricing work?',
    a: "Project-based for one-off work. Monthly retainer for ongoing volume. Quarterly advance billing for retainer clients. We'll quote after the first call.",
  },
  {
    q: 'Can we start small to see if it works?',
    a: "Yes. Send us one product. Inside two weeks you'll get three packaging directions and a sourcing estimate. No retainer, no commitment, the work is yours either way.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Packaging & Merchandise Design + China Sourcing"
  description="AI-powered packaging and merch design with direct sourcing from audited China factories. One team, one timeline. Built for brands shipping at scale."
  heroOverlay
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>

  <!-- ===== S1: Hero (dark) ===== -->
  <section class="hero grain">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="hero__kicker reveal" style="--i:0">
          <span class="hero__kicker-dot" aria-hidden="true"></span>
          Services · Design
        </span>
        <h1 class="headline h1 reveal hero__title" style="--i:1">
          Packaging &amp; <span class="accent">Merchandise</span> Design
        </h1>
        <p class="hero__tagline reveal" style="--i:2">
          Design it. Source it. Ship it. <span class="accent">One team.</span>
        </p>
        <p class="hero__p reveal" style="--i:3">
          Most brands hire a studio to design packaging, then chase factories
          through a broker. Two contracts, two layers of margin. We do both:
          senior creative directors run the design, our China team sources it
          through audited factories. One sign-off, faster to market.
        </p>
        <div class="hero__cta reveal" style="--i:4">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="hero__jump" href="#work">
            See sample work
            <span class="hero__jump-arrow" aria-hidden="true">&darr;</span>
          </a>
        </div>
        <ul class="hero__marks reveal" style="--i:5">
          <li>Senior creative directors lead</li>
          <li>Packaging and branded merch design</li>
          <li>From brief to print-ready in weeks</li>
        </ul>
      </div>

      <aside class="hero__media reveal" style="--i:3">
        <span class="hero__deck" aria-hidden="true"></span>
        <span class="hero__glow" aria-hidden="true"></span>
        <div
          class="pcar"
          aria-roledescription="carousel"
          aria-label="Packaging and merchandise samples"
        >
          <div class="pcar__viewport">
            {
              samples.map((s, i) => (
                <figure
                  class="pcar__slide"
                  data-slide={i}
                  data-active={i === 0 ? 'true' : 'false'}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${s.brand}, ${s.kind}`}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                >
                  <img
                    class="pcar__img"
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <figcaption class="pcar__cap">
                    <span class="pcar__brand">{s.brand}</span>
                    <span class="pcar__kind">{s.kind}</span>
                  </figcaption>
                </figure>
              ))
            }
            <button class="pcar__nav pcar__nav--prev" type="button" aria-label="Previous sample">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M10 2 4 8 10 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="pcar__nav pcar__nav--next" type="button" aria-label="Next sample">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6 2 12 8 6 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          <span class="pcar__tag" aria-hidden="true">Studio samples</span>
          <div class="pcar__dots" role="tablist" aria-label="Choose a sample">
            {
              samples.map((s, i) => (
                <button
                  class="pcar__dot"
                  type="button"
                  data-dot={i}
                  data-active={i === 0 ? 'true' : 'false'}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={`Show ${s.brand}`}
                >
                  <span class="pcar__dot-fill"></span>
                </button>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== S2: eCommerce roots ===== -->
  <section class="section roots">
    <div class="container roots__grid">
      <div class="roots__visual reveal">
        <div class="roots__frame pfx">
          <img
            class="roots__img parallax"
            src="/Images/pmd-roots.jpg"
            alt="A shopper at a sunlit cafe table holding a phone that shows a single skincare product."
            width="1408"
            height="768"
            loading="lazy"
          />
        </div>
        <span class="roots__float" aria-hidden="true">
          <span class="roots__float-num">0.5s</span>
          <span class="roots__float-cap">per product, on the feed</span>
        </span>
      </div>

      <div class="roots__copy">
        <span class="eyebrow roots__eyebrow reveal">Why it matters</span>
        <h2 class="headline h2 reveal roots__head">
          Why our eCommerce <span class="accent">roots</span> matter
        </h2>
        <p class="roots__p reveal">
          A shopper swipes an Amazon beauty category at lunch, half a second per
          product. Packaging carries the whole sale: no salesperson, no second
          chance.
        </p>
        <p class="roots__p reveal">
          That's the market our team came up in. For fifteen years, through
          Beyond Border Group, we ran eCommerce storefronts across Amazon,
          Tmall, JD and Douyin. We design packaging that holds up in a listing,
          on a shelf, and in an unboxing video.
        </p>
        <p class="roots__clients reveal">
          <span class="roots__clients-label">Clients have included</span>
          <span class="roots__client">HiSense</span>
          <span class="roots__client">Camper</span>
          <span class="roots__client">age20</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== S2b: Results band (overlapping) ===== -->
  <section class="resultband">
    <div class="container">
      <div class="results grain reveal">
        <div class="results__head">
          <span class="eyebrow results__eyebrow">The results</span>
          <p class="results__quote">
            Recent projects lifted creative approval rates from 22% to 78%, cut
            content costs by 60%, and pushed asset output 7x without adding a
            single hire.
          </p>
        </div>
        <div class="results__grid">
          {
            stats.map((s, i) => (
              <div class="stat" style={`--i:${i}`}>
                <span
                  class="stat__num"
                  data-count-from={s.from}
                  data-count-to={s.to}
                  data-suffix={s.suffix}
                >
                  {s.from}
                  {s.suffix}
                </span>
                <span class="stat__label">{s.label}</span>
                <span class="stat__note">{s.note}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== S3: What we cover (tabbed showcase) ===== -->
  <section class="section sec-cover">
    <div class="container">
      <header class="section-head section-head--left">
        <span class="eyebrow reveal">What we cover</span>
        <h2 class="headline h2 reveal">
          Two lanes, one <span class="accent">brand system</span>.
        </h2>
      </header>

      <div class="cover reveal" data-active="packaging">
        <div class="cover__tabs" role="tablist" aria-label="Coverage areas">
          <span class="cover__indicator" aria-hidden="true"></span>
          {
            coverTabs.map((tab, i) => (
              <button
                class="cover__tab"
                type="button"
                role="tab"
                id={`covtab-${tab.id}`}
                data-tab={tab.id}
                aria-controls={`covpanel-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {tab.label}
              </button>
            ))
          }
        </div>

        <div class="cover__stage">
          {
            coverTabs.map((tab, i) => (
              <article
                class="cover__panel"
                id={`covpanel-${tab.id}`}
                role="tabpanel"
                aria-labelledby={`covtab-${tab.id}`}
                data-panel={tab.id}
                data-active={i === 0 ? 'true' : 'false'}
                hidden={i !== 0}
              >
                <div class="cover__media">
                  <img
                    src={tab.image}
                    alt={tab.imageAlt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                  <span class="cover__badge">{tab.label}</span>
                </div>
                <div class="cover__text">
                  <h3 class="headline h3 cover__head">{tab.heading}</h3>
                  {tab.lead && <p class="cover__lead">{tab.lead}</p>}
                  {tab.body.map((para) => (
                    <p class="cover__p">{para}</p>
                  ))}
                  <p class="cover__tags-label">In scope</p>
                  <ul class="cover__tags">
                    {tab.tags.map((t, ti) => (
                      <li class="cover__chip" style={`--i:${ti}`}>
                        {t}
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== S4: Sample marquee ===== -->
  <section class="marquee-section" id="work">
    <div class="container">
      <header class="marquee-head">
        <span class="eyebrow reveal">Sample work</span>
        <p class="marquee-head__line reveal">
          Concepts and mockups, generated and finished in the studio.
        </p>
      </header>
    </div>
    <div class="marquee" aria-label="Packaging and merchandise samples">
      <div class="marquee__track">
        {
          [...samples, ...samples].map((s, i) => (
            <figure class="mq-card" aria-hidden={i >= samples.length ? 'true' : 'false'}>
              <img
                class="mq-card__img"
                src={s.src}
                alt={i >= samples.length ? '' : s.alt}
                width="1024"
                height="1024"
                loading="lazy"
              />
              <figcaption class="mq-card__cap">
                <span class="mq-card__brand">{s.brand}</span>
                <span class="mq-card__kind">{s.kind}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
    <div class="marquee marquee--rev" aria-hidden="true">
      <div class="marquee__track marquee__track--rev">
        {
          [...samples.slice().reverse(), ...samples.slice().reverse()].map((s) => (
            <figure class="mq-card mq-card--sm">
              <img
                class="mq-card__img"
                src={s.src}
                alt=""
                width="1024"
                height="1024"
                loading="lazy"
              />
              <figcaption class="mq-card__cap">
                <span class="mq-card__brand">{s.brand}</span>
                <span class="mq-card__kind">{s.kind}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== S5: Optional sourcing ===== -->
  <section class="section">
    <div class="container">
      <div class="source card card--navy grain reveal">
        <div class="source__grid">
          <div class="source__visual">
            <div class="source__frame pfx">
              <img
                class="source__img parallax"
                src="/Images/pmd-factory.jpg"
                alt="A worker on a packaging production line in a daylit factory, finished cartons and rolls of kraft board."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
            <div class="source__sub">
              <img
                src="/Images/pmd-inspect.jpg"
                alt="Hands inspecting a finished printed carton against a quality-control sheet on a workbench."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
            <div class="source__stat">
              <span class="source__stat-num">4&ndash;8 weeks</span>
              <span class="source__stat-cap">approved design to delivered units</span>
            </div>
          </div>

          <div class="source__body">
            <span class="eyebrow source__eyebrow reveal">Optional · Sourcing</span>
            <h2 class="headline h2 reveal source__head">
              Need it produced too? We can <span class="accent">source</span> it.
            </h2>
            <p class="source__intro reveal">
              This part is optional. Most clients come to us for the design. But
              if you also need someone to handle production, we can pick it up
              from there.
            </p>
            <p class="source__p reveal">
              We're based in Shanghai, which means we can plug straight into
              China's premium factory network. The suppliers we work with
              already produce for global brands across textiles, drinkware,
              accessories, tech and packaging materials. BSCI, SEDEX and SA8000
              documentation available by category. NDAs in place before a single
              factory sees the brief.
            </p>
            <ul class="creds reveal">
              {
                credentials.map((c, i) => (
                  <li class="cred" style={`--i:${i}`}>
                    <svg viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {c}
                  </li>
                ))
              }
            </ul>
            <p class="source__p reveal">
              MOQs negotiated per project, with small-batch runs available for
              PR and influencer work. Typical lead time runs 4 to 8 weeks from
              approved design to delivered units, depending on category and
              finish.
            </p>
            <p class="source__p source__p--quiet reveal">
              If you already have your own production partners, no problem. We
              hand over the files and step back.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== S6: Process timeline ===== -->
  <section class="section">
    <div class="container">
      <div class="proc__top">
        <div class="proc__intro">
          <span class="eyebrow reveal">Our process</span>
          <h2 class="headline h2 reveal proc__head">
            Our process: creative is where it's <span class="accent">won</span>.
          </h2>
          <p class="proc__lede reveal">
            Most studios sell process. We sell the creative call. AI made the
            technical side cheap and fast for everyone. It didn't replace the
            eye that picks which idea is actually worth scaling.
          </p>
          <p class="proc__note reveal">
            First two steps are where it's won or lost. The rest is execution.
          </p>
        </div>
        <div class="proc__shot reveal">
          <img
            src="/Images/hubstudio-shanghai-studio.webp"
            alt="Inside the hubStudio Shanghai studio: the team reviewing packaging dielines and layouts on screen."
            width="1024"
            height="1024"
            loading="lazy"
          />
          <span class="proc__shot-tag">Shanghai studio</span>
        </div>
      </div>

      <div class="ptl" data-count={steps.length}>
        <div class="ptl__rail" aria-hidden="true">
          <span class="ptl__rail-fill"></span>
        </div>
        <ol class="ptl__steps">
          {
            steps.map((step, i) => (
              <li class="ptl__step" data-step={i} data-active={i === 0 ? 'true' : 'false'}>
                <span class="ptl__node" aria-hidden="true"></span>
                <div class="ptl__card">
                  <span class="ptl__phase">{i < 2 ? 'Where it is won' : 'Execution'}</span>
                  <h3 class="ptl__title">{step.title}</h3>
                  <p class="ptl__text">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== S7: The new math ===== -->
  <section class="section math">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow reveal">The new math</span>
        <h2 class="headline h2 reveal">
          How AI changes the <span class="accent">math</span>.
        </h2>
        <p class="lead section-head__sub reveal">
          A client lands with 60 SKUs for a Q3 launch across four markets. The
          same brief, run two ways.
        </p>
      </header>

      <div class="wf">
        <article class="wf__row wf__row--old reveal">
          <div class="wf__side">
            <span class="wf__tag wf__tag--old">The old workflow</span>
            <span class="wf__total">Twelve weeks</span>
            <p class="wf__p">
              Old workflow: brief an agency, six weeks for concepts, two more
              for adaptations, another two for production files. Twelve weeks,
              three or four design rounds, and one tired team.
            </p>
