              height="1125"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== S8: FAQ ===== -->
  <section class="section faqs">
    <div class="container faqs__grid">
      <aside class="faqs__intro">
        <span class="eyebrow reveal">FAQ</span>
        <h2 class="headline h2 reveal faqs__head">
