---
/**
 * Packaging & Merchandise Design  ·  /services/design/packaging-merch-design
 *
 * Art direction: "Pressroom". The page is laid out like a packaging proof.
 * Print-production language (crop marks, a calibration colour bar, mono
 * figure labels, dieline rules) frames bold editorial typography and the
 * studio's own product photography.
 *
 * Copy from packaging-merch-page.md. Process step numerals are intentionally
 * dropped: the project's permanent "no numbers in cards / step lists" rule
 * overrides the source numbering. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio product photography, each with an invented brand mark. */
const samples = [
  {
    src: '/Images/packaging-merch-vante.jpg',
    brand: 'Vante',
    kind: 'Luxury gift box',
    alt: 'Deep burgundy rigid gift box with a gold-foil Vante wordmark and grosgrain ribbon, on dark stone.',
  },
  {
    src: '/Images/packaging-merch-aurele.jpg',
    brand: 'Aurele',
    kind: 'Skincare packaging',
    alt: 'Frosted glass serum bottle beside a sand-toned folding carton for the Aurele skincare line.',
  },
  {
    src: '/Images/packaging-merch-fernwell.jpg',
    brand: 'Fernwell',
    kind: 'Branded merchandise',
    alt: 'Canvas tote, stoneware mug and folded t-shirt screen-printed with the Fernwell wordmark.',
  },
  {
    src: '/Images/packaging-merch-mojo.jpg',
    brand: 'Mojo',
    kind: 'Beverage packaging',
    alt: 'Two coral-orange aluminium cans for the Mojo sparkling drink under hard directional light.',
  },
  {
    src: '/Images/packaging-merch-kasa.jpg',
    brand: 'Kasa',
    kind: 'Cosmetics set',
    alt: 'Two aluminium tubes and a frosted jar printed with the Kasa wordmark, on pale travertine.',
  },
  {
    src: '/Images/packaging-merch-luma.jpg',
    brand: 'Luma',
    kind: 'PR & influencer box',
    alt: 'Open kraft PR mailer with a printed belly-band reading Luma, holding three products in tissue.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-project results, drawn from the source quote. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'Creative approval rate', note: 'Up from 22% before' },
  { from: 0, to: 60, suffix: '%', label: 'Lower content cost', note: 'On recent projects' },
  { from: 0, to: 7, suffix: 'x', label: 'Asset output', note: 'Without a single new hire' },
];

/* The two coverage areas. Tag rows surface phrases named in the prose. */
const coverage = [
  {
    fig: 'B',
    label: 'Packaging',
    heading: 'What we cover on packaging',
    image: '/Images/packaging-merch-aurele.jpg',
    alt: 'Frosted serum bottle and folding carton for the Aurele line, an example of packaging design.',
    body: [
      'Primary packaging for beauty, FMCG, beverage, electronics and luxury. Outer cartons that protect the product and the brand. Labels, dielines, print-ready files. Sustainable options with real material variants (not a green color swap). Limited editions, seasonal runs, full regulatory localization for ingredient lists, claims and barcodes by market.',
      'You get concept boards, photoreal mockups, and production files your supplier can run with on the first pass. No back-and-forth on missing bleeds at midnight before a print deadline.',
    ],
    tags: [
      'Beauty & FMCG', 'Beverage', 'Electronics', 'Luxury', 'Outer cartons',
      'Labels & dielines', 'Print-ready files', 'Sustainable variants',
      'Limited editions', 'Regulatory localization',
    ],
  },
  {
    fig: 'C',
    label: 'Merchandise',
    heading: 'What we cover on merchandise',
    image: '/Images/packaging-merch-fernwell.jpg',
    alt: 'Canvas tote, mug and t-shirt under one wordmark, an example of branded merchandise.',
    lead: 'Branded merch designed to be kept, not tossed.',
    body: [
      'Apparel, drinkware, accessories, stationery, tech kit, trade show gear. Influencer mailers and PR boxes built for the unboxing moment. Retail displays, in-store activations, loyalty premiums, gift-with-purchase systems.',
      'Every piece is designed against your brand system and shown in context, so your team can approve it before a supplier quotes.',
    ],
    tags: [
      'Apparel', 'Drinkware', 'Accessories', 'Stationery', 'Tech kit',
      'Trade show gear', 'PR & influencer boxes', 'Retail displays',
      'In-store activations', 'Loyalty premiums',
    ],
  },
];

/* Factory audit credentials, named in the sourcing copy. */
const credentials = ['BSCI', 'SEDEX', 'SA8000', 'NDA in place'];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   own "first two steps are where it's won" sets each step's tier. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and brand immersion.',
    body: 'Visual codes, category context, consumer.',
    image: '/Images/pmd-p1-brief.jpg',
    alt: 'An Aurele serum bottle and kraft carton on a studio worktable beside tear-sheets, colour chips and brief notes.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction. The step that matters most.',
    body: 'Senior creative directors set the territory and the structural concept. This is where a packaging line becomes ownable, and where merch goes from forgettable to collected.',
    image: '/Images/pmd-p2-direction.jpg',
    alt: 'The Aurele serum bottle and carton styled as one art-directed hero shot on a warm plaster ledge.',
  },
  {
    short: 'AIGC exploration',
    tier: 'The rest is execution',
    title: 'AIGC exploration.',
    body: 'Dozens of directions in parallel, faster than traditional sketching.',
    image: '/Images/pmd-p3-aigc.jpg',
    alt: 'A grid of the same Aurele bottle and carton explored across many label colours, typefaces and finishes.',
  },
  {
    short: 'Refinement',
    tier: 'The rest is execution',
    title: 'Refinement and production.',
    body: 'Dielines, print files, mockups, supplier handover.',
    image: '/Images/pmd-p4-refine.jpg',
    alt: 'The Aurele kraft carton as an unfolded dieline with crop marks, beside the folded carton and the serum bottle.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation at scale.',
    body: 'Market variants, SKU extensions, seasonal updates.',
    image: '/Images/pmd-p5-adapt.jpg',
    alt: 'A row of Aurele bottles and cartons in several size and market variants on a travertine surface.',
  },
];

/* The process splits into two tiers: the steps where the project is won, and
   the steps that are execution. Each renders in its own block below. */
const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* The old agency timeline, split into the phases the copy names. */
const oldPhases = [
  { label: 'Concepts', dur: 'Six weeks', span: 6 },
  { label: 'Adaptations', dur: 'Two weeks', span: 2 },
  { label: 'Production files', dur: 'Two weeks', span: 2 },
];

/* FAQ: wording verbatim; one answer links to the Copyright guide. */
const faqs = [
  {
    q: 'How long does a packaging project take?',
    a: "Two to three weeks for design from brief to print-ready files. Faster if it's an SKU extension on an existing system. If you also need production, add 4 to 8 weeks for manufacturing and shipping.",
  },
  {
    q: 'What do I need to send you to get started?',
    a: "Product information, brand guidelines if you have them, a sense of the market, and any reference work you like or hate. If you don't have brand guidelines, we'll work from what exists and flag the gaps.",
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior creative directors from agency backgrounds lead every project. AIGC specialists handle the production volume. No junior teams running the brief.',
  },
  {
    q: 'Do you work in our brand language and visual system, or impose your own?',
    a: 'Yours. We train our AI setup on your existing brand assets, so the output stays inside your visual system, not ours.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle a full SKU range, or just hero packs?',
    a: 'Both. Our setup is built for volume. Some clients come for one hero pack, others come with 200 SKUs across four markets. The workflow scales.',
  },
  {
    q: 'Do you do dielines and print production files, or just concepts?',
    a: 'Full production files. Dielines, bleeds, color profiles, print specs. Your supplier can run with it on the first pass.',
  },
  {
    q: 'What if we already have a packaging supplier we want to keep using?',
    a: 'Fine. We deliver print-ready files and step back. Sourcing is optional, not required.',
  },
  {
    q: 'How does pricing work?',
    a: "Project-based for one-off work. Monthly retainer for ongoing volume. Quarterly advance billing for retainer clients. We'll quote after the first call.",
  },
  {
    q: 'Can we start small to see if it works?',
    a: "Yes. Send us one product. Inside two weeks you'll get three packaging directions and a sourcing estimate. No retainer, no commitment, the work is yours either way.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Packaging & Merchandise Design + China Sourcing | hubStudio"
  description="AI-powered packaging and merch design with direct sourcing from audited China factories. One team, one timeline. Built for brands shipping at scale."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Packaging &amp; Merchandise
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Packaging &amp;</span></span>
            <span class="line"><span class="line__i serif">Merchandise</span></span>
            <span class="line"><span class="line__i">Design.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Design it. Source it. Ship it. <em>One team.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most brands hire a studio to design packaging, then chase
              factories through a broker. Two contracts, two layers of margin.
            </p>
            <p>
              We do both. Senior creative directors run the design; our China
              team sources it through audited factories. One sign-off, faster
              to market.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Design + optional sourcing
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/packaging-merch-aurele.jpg"
          alt="Frosted glass serum bottle beside a sand-toned folding carton for the Aurele skincare line."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Aurele</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Why our eCommerce<br /><span class="serif">roots</span> matter.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              A shopper swipes an Amazon beauty category at lunch, half a second
              per product. Packaging carries the whole sale: no salesperson, no
              second chance.
            </p>
            <p class="r" style="--d:.16s">
              That's the market our team came up in. For twenty years, through
              Beyond Border Group, we ran eCommerce storefronts across Amazon,
              Tmall, JD and Douyin. We design packaging that holds up in a
              listing, on a shelf, and in an unboxing video.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Clients have included <strong>HiSense</strong>,
              <strong>Camper</strong> and <strong>age20</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/pmd-roots.jpg"
              alt="A shopper at a sunlit cafe table holding a phone showing a single skincare product."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The half-second test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Recent projects lifted creative approval rates from 22% to 78%, cut
            content costs by 60%, and pushed asset output 7x without adding a
            single hire.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">brand system</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} design</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Concepts and photoreal mockups, generated and finished in the
            studio. Every frame is authored work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · SOURCING (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/pmd-factory.jpg"
                alt="A worker on a packaging production line in a daylit factory, with finished cartons and kraft rolls."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/pmd-inspect.jpg"
              alt="Hands inspecting a finished printed carton against a quality-control sheet."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">4&ndash;8 wks</span>
            <span class="source__stat-cap">Approved design to delivered units</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it produced too?<br />We can <span class="serif">source</span> it.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients come to us for the design. But
            if you also need someone to handle production, we can pick it up
            from there.
          </p>
          <p class="source__p r" style="--d:.16s">
            We're based in Shanghai, which means we can plug straight into
            China's premium factory network. The suppliers we work with already
            produce for global brands across textiles, drinkware, accessories,
            tech and packaging materials. BSCI, SEDEX and SA8000 documentation
            available by category. NDAs in place before a single factory sees
            the brief.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            MOQs negotiated per project, with small-batch runs available for PR
            and influencer work. Typical lead time runs 4 to 8 weeks from
            approved design to delivered units, depending on category and
            finish.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already have your own production partners, no problem. We
            hand over the files and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative is where<br />it's <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Most studios sell process. We sell the creative call. AI made the
          technical side cheap and fast for everyone. It didn't replace the eye
          that picks which idea is actually worth scaling.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it's won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with 60 SKUs for a Q3 launch across four markets. The
            same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Twelve weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief an agency, six weeks for concepts, two more
                for adaptations, another two for production files. Twelve weeks,
                three or four design rounds, and one tired team.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">An afternoon</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Concept to mockup</span>
                  <span class="vs__seg-dur">One afternoon</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: dozens of concept directions in an afternoon.
                Photoreal mockups before a sample is ordered. SKU adaptation
                across markets without rebuilding every layout. Material and
                finish simulation (matte foil, embossed kraft, soft-touch)
                before a plate is cut.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put it
            in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          See it on your<br />own <span class="serif">product</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us a product. Inside two weeks, you'll get three packaging
          directions and a sourcing estimate. No retainer, no commitment.
          Whatever we produce is yours to keep, even if you walk.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
    display: grid;
    gap: 18px;
  }
  .band--split {
    max-width: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .band--split {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 18px 60px;
    }
    .band--split > div {
      display: grid;
      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }
  .band__note--light {
    color: rgba(240, 237, 233, 0.76);
  }

  /* Calibration colour bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }
  .cbar--end {
    margin-top: clamp(60px, 8vw, 110px);
  }

  /* ===================== S1 · Hero ===================== */
  /* Editorial split: ink copy panel + flush-right image. */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__panel {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px);
    overflow: clip;
  }
  .hero__reg {
    position: absolute;
    width: clamp(240px, 28vw, 420px);
    right: -12%;
    bottom: -14%;
    color: rgba(240, 237, 233, 0.055);
    pointer-events: none;
  }
  .hero__panel-in {
    position: relative;
    width: 100%;
    max-width: 600px;
  }
  .hero__title {
    margin-top: 24px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(46px, 6.6vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  /* Generous padding gives glyph ascenders / descenders room inside the
     reveal mask; the matching negative margin keeps the lines tight. */
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding: 0.22em 0.14em;
    margin: -0.22em -0.14em;
  }
  .hero__title .line__i {
    display: block;
    transform: translateY(145%);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero__title .line:nth-child(1) .line__i {
    transition-delay: 0.12s;
  }
  .hero__title .line:nth-child(2) .line__i {
    transition-delay: 0.22s;
  }
  .hero__title .line:nth-child(3) .line__i {
    transition-delay: 0.32s;
  }
  .hero.in .hero__title .line__i {
    transform: translateY(0);
  }
  .hero__title .serif {
    font-size: 1.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line__i {
      transform: none;
    }
  }
  .hero__tag {
    margin-top: 26px;
    font-size: clamp(18px, 1.5vw, 23px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__tag em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .hero__lead {
    margin-top: 20px;
    display: grid;
    gap: 13px;
    max-width: 46ch;
  }
  .hero__lead p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.74);
  }
  .hero__cta {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero__meta {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1.5px dashed rgba(240, 237, 233, 0.2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
  }
  .hero__meta span {
    color: var(--brand-orange);
  }
  .hero__visual {
    position: relative;
    overflow: hidden;
    min-height: 58vh;
  }
  @media (min-width: 900px) {
    .hero__visual {
      min-height: auto;
    }
  }
  .hero__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero.in .hero__visual img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual img {
      transform: none;
    }
  }
  .hero__chip {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    gap: 8px;
    padding: 9px 15px;
