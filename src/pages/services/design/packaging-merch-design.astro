  }
  .stats__grid {
    margin-top: 40px;
    display: grid;
    gap: 30px;
  }
  @media (min-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .stat {
