    }
  }
  .shot .crop__inner {
    aspect-ratio: 1 / 1;
  }
  .shot .crop__inner img {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shot:hover .crop__inner img {
    transform: scale(1.06);
  }
  .shot__cap {
    margin-top: 14px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--ink);
  }
  .shot__brand {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .shot__kind {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* ===================== S5 · Sourcing ===================== */
  .source {
    background: var(--navy);
    color: var(--text-on-dark);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .source__grid {
    display: grid;
    gap: 52px;
  }
  @media (min-width: 940px) {
    .source__grid {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 70px;
      align-items: center;
    }
  }
  .source__visual {
    position: relative;
  }
  .source__main .crop__inner {
    aspect-ratio: 5 / 4;
  }
  .source__inset {
    position: absolute;
    right: -14px;
    bottom: -34px;
    width: 42%;
    max-width: 200px;
    margin: 0;
