  /* ===================== S8 · FAQ ===================== */
  .faq {
    background: var(--paper);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .faq__grid {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 1000px) {
    .faq__grid {
      grid-template-columns: 0.78fr 1.22fr;
      gap: 72px;
      align-items: start;
    }
    .faq__intro {
      position: sticky;
      top: 96px;
    }
  }
  .faq__intro .dh {
    margin-top: 18px;
  }
  .faq__sub {
    margin-top: 18px;
    margin-bottom: 26px;
    font-size: var(--type-body);
