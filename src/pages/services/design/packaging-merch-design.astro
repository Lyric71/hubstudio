  .source__stat-num {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .source__stat-cap {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    max-width: 15ch;
    line-height: 1.4;
  }
  .source__body .dh {
    margin-top: 16px;
  }
  .source__lead {
    margin-top: 20px;
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-on-dark);
  }
  .source__p {
    margin-top: 15px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: rgba(240, 237, 233, 0.78);
  }
  .source__p--quiet {
    color: rgba(240, 237, 233, 0.55);
  }
  .creds {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .cred {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(240, 237, 233, 0.2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .cred:hover {
    border-color: var(--brand-orange);
    background: rgba(233, 78, 27, 0.16);
  }
  .cred svg {
    width: 13px;
    height: 13px;
    color: var(--brand-orange);
  }

  /* ===================== S6 · Process ===================== */
  .craft {
    background: var(--paper);
    padding-top: clamp(80px, 10vw, 150px);
  }
  .craft__intro {
    max-width: 780px;
    margin-bottom: clamp(36px, 5vw, 60px);
  }
  .craft__intro .kicker {
    color: var(--brand-orange);
  }
  .craft__intro .dh {
    margin-top: 16px;
  }
  .craft__lede {
    margin-top: 18px;
