    background: linear-gradient(135deg, var(--brand-orange), var(--brand-orange-deep));
  }
  .wf__rest {
    flex: 1;
    border-radius: 12px;
    border: 1px dashed rgba(240, 237, 233, 0.22);
  }
  @media (prefers-reduced-motion: reduce) {
    .wf__seg {
      transform: none;
    }
  }

