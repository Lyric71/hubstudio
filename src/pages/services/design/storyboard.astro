---
/**
 * Storyboard  ·  /services/design/storyboard
 *
 * Same art-direction system as /services/design/packaging-merch-design (the
 * "pressroom" layout): mono labels, dieline crop marks, a calibration colour
 * bar, editorial typography, alternating media features. Adapted for
 * pre-production: six format lanes instead of two, a "where AI breaks"
 * spread in place of the sourcing block, and a 2-3 week vs 3-5 day timeline.
 *
 * Copy from storyboard-page.md. Process step numerals are intentionally
 * dropped: the project's permanent "no numbers in cards / step lists" rule
 * overrides the source numbering. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Selected studio samples, each tied to a project type. */
const samples = [
  {
    src: '/Images/sb-sample-tv.jpg',
    brand: 'Veyra',
    kind: 'Beauty global TV spot',
    alt: 'A grid of pencil-and-ink storyboard panels for a beauty TV spot, pinned to a studio wall under afternoon window light.',
  },
  {
    src: '/Images/sb-sample-digital.jpg',
    brand: 'Pelt',
    kind: 'Social campaign, three ratios',
    alt: 'Three printed storyboard sheets reframing the same sneaker spot in vertical, square and widescreen, laid on a wooden desk.',
  },
  {
    src: '/Images/sb-sample-animation.jpg',
    brand: 'Norven',
    kind: 'Animated fintech explainer',
    alt: 'A grid of pencil keyframe poses for a 2D character animation pinned to a corkboard with in-between counts noted below.',
  },
  {
    src: '/Images/sb-sample-explainer.jpg',
    brand: 'Modra',
    kind: 'B2B product film',
    alt: 'A laptop on a studio desk showing a storyboard panel with a product UI mockup, voiceover script and script-to-frame timeline.',
  },
  {
    src: '/Images/sb-sample-branded.jpg',
    brand: 'Aldair',
    kind: 'Automotive anthem film',
    alt: 'A printed storyboard sequence on a wide table beside a top-down blocking diagram and a scene beat list.',
  },
  {
    src: '/Images/sb-sample-pitch.jpg',
    brand: 'Astrel',
    kind: 'Agency pitch board',
    alt: 'A pitch document open on a tabletop showing a single full-bleed storyboard hero frame next to a deck cover.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-project results, drawn from the source quote. */
const stats = [
  { from: 0, to: 5, suffix: ' days', label: 'First-cut delivery', note: 'On a 30-second spot' },
  { from: 0, to: 70, suffix: '%', label: 'Faster pre-production', note: 'Average across campaigns' },
  { from: 0, to: 6, suffix: ' markets', label: 'Average campaign reach', note: 'Last twelve months' },
];

/* Trust signals shown as a thin strip below the hero. */
const signals = [
  'Boards led by art directors with TV and broadcast credits',
  'Frames the director, DP and client read the same way',
  'Shot grammar, camera language, timing and audio on every panel',
  'Three to five days for a first cut on a 30-second spot',
];

/* Six format lanes. Each renders as a card in a 2-up / 3-up grid. */
const lanes = [
  {
    label: 'TV and broadcast',
    image: '/Images/sb-sample-tv.jpg',
    alt: 'A grid of storyboard panels for a beauty TV spot on a studio wall in afternoon window light.',
    lead: '15, 30 and 60-second spots, anthem films and full campaign systems with cutdowns.',
    body: 'Boards built to broadcast specs, with regulatory copy by market and talent guidelines locked into frame one.',
    tags: ['15s spots', '30s spots', '60s anthems', 'Cutdowns', 'Regulatory by market'],
  },
  {
    label: 'Digital and social',
    image: '/Images/sb-sample-digital.jpg',
    alt: 'Three storyboard sheets reframing one sneaker spot across vertical, square and widescreen ratios.',
    lead: 'The highest-volume lane we run. A single concept ships in every ratio the platform demands.',
    body: '9:16 vertical for TikTok and Reels, 1:1 square for in-feed, 16:9 for YouTube and CTV, 4:5 for the scroll. Each ratio gets reboarded, not just cropped.',
    tags: ['9:16 vertical', '1:1 square', '16:9 wide', '4:5 scroll', 'Reboarded, not cropped'],
  },
  {
    label: 'Animation and motion',
    image: '/Images/sb-sample-animation.jpg',
    alt: 'Pencil keyframe poses for a 2D character animation, pinned to a corkboard with in-between counts.',
    lead: 'Full-cel 2D and 3D animation, motion graphics, kinetic typography, explainer animations.',
    body: 'Boards in this lane carry keyframe poses, in-between counts, camera-move notation and pacing notes for the animatic.',
    tags: ['2D animation', '3D animation', 'Motion graphics', 'Kinetic type', 'Keyframe poses'],
  },
  {
    label: 'Explainer and product film',
    image: '/Images/sb-sample-explainer.jpg',
    alt: 'A laptop showing a product UI storyboard panel beside a voiceover script and a script-to-frame timeline.',
    lead: 'Where most B2B and SaaS work lives. Voiceover-driven, with UI screen states or product visualisation at the centre.',
    body: 'Boards carry script-to-frame sync down to the syllable, so the editor cuts to the word and not around it.',
    tags: ['B2B films', 'SaaS demos', 'UI screen states', 'Script-to-frame sync', 'VO timing'],
  },
  {
    label: 'Branded film and long-form',
    image: '/Images/sb-sample-branded.jpg',
    alt: 'A branded-film storyboard sequence on a wide table with a top-down blocking diagram and a scene beat list.',
    lead: 'Brands are buying actual short films now, not long commercials. We board them like short films.',
    body: 'Scene blocking diagrams, sequence beat maps, a director-treatment companion document, and a pitch-deck cut for the marketing team to share internally.',
    tags: ['Short film boards', 'Blocking diagrams', 'Beat maps', 'Director companion', 'Marketing cut'],
  },
  {
    label: 'Pitch boards',
    image: '/Images/sb-sample-pitch.jpg',
    alt: 'A pitch document open on a tabletop showing a single full-bleed storyboard hero frame.',
    lead: 'Shortest shelf life. Highest stakes for the agency. A board that does not sell in three frames loses the pitch.',
    body: 'Designed to read as a presentation document first, a production document second, with the production-quality version held in reserve for the win.',
    tags: ['Agency pitches', 'New business', 'Three-frame hook', 'Deck-ready', 'Production-ready'],
  },
];

/* Process steps. Numerals dropped per the no-numbers rule. The source's
   own "cinematic thinking is where it's won" sets the tier for each step. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and shoot spec.',
    body: 'Final script, format list, delivery duration, brand guidelines, talent rules, product reference, regulatory copy by market.',
    image: '/Images/sb-p1-brief.jpg',
    alt: 'A briefing table with open script pages, a brand guidelines binder and talent reference sheets under warm desk light.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction. The step that decides it.',
    body: 'Art directors set the shot grammar, the camera language, the visual hook, the cuts, the line of the scene.',
    image: '/Images/sb-p2-direction.jpg',
    alt: 'A senior art director at a studio desk drawing the hero shot on a blank storyboard sheet beside pinned reference photos.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration.',
    body: 'Dozens of frame directions in parallel, with character and product consistency locked through reference sheets.',
    image: '/Images/sb-p3-aigc.jpg',
    alt: 'A laptop showing a grid of AI-generated cinematic frame explorations for one spot, with reference sheets pinned behind.',
  },
  {
    short: 'Board build',
    tier: 'The rest is execution',
    title: 'Board build and refinement.',
    body: 'Frame-by-frame layout, timing in seconds and frames, camera-move notation, audio cues, ratio variants, shot list export.',
    image: '/Images/sb-p4-build.jpg',
    alt: 'A finished storyboard sheet with timing in seconds, camera-move arrows in red pencil and audio cues underlined.',
  },
  {
    short: 'Animatic',
    tier: 'The rest is execution',
    title: 'Optional animatic.',
    body: 'Timed sequence with rough VO and music, exported as video for director and client review.',
    image: '/Images/sb-p5-animatic.jpg',
    alt: 'A laptop showing an animatic timeline in a video editor with storyboard frames sequenced and a voiceover waveform below.',
  },
];

/* The old workflow vs ours, in the phases the copy names. */
const oldPhases = [
  { label: 'Treatment', dur: 'Half a week', span: 3 },
  { label: 'First-pass boards', dur: 'One week', span: 6 },
  { label: 'Revisions', dur: 'Half a week', span: 3 },
];

/* FAQ: twelve questions, verbatim from the source. */
const faqs = [
  {
    q: 'How long does a storyboard project take?',
    a: 'Three to five days for a first cut on a 30-second spot. One to two weeks for a multi-format campaign with cutdowns. Three to seven extra days if you need a full animatic. Faster on extensions of an existing system.',
  },
  {
    q: 'What does a project actually cost?',
    a: 'Project-based for one-off boards. Monthly retainer for ongoing volume, common for brands with rolling content calendars. Quarterly advance billing for retainer clients. We quote firm after the first call once the brief, formats and frame count are clear.',
  },
  {
    q: 'Why is this more expensive than a freelance storyboard artist?',
    a: "A freelancer quotes per frame on the work as drawn. Our setup includes creative direction from a senior art director, AI iteration that puts ten directions in front of you in the time it takes a freelance artist to draw one, character and product consistency tooling, animatic-ready file structure, and the handoff to the production company. For a single thumbnail, we are not the cheap option. For a campaign that has to ship across multiple formats and markets, the per-frame math usually works out in our favour.",
  },
  {
    q: 'How does this compare to using AI tools in-house?',
    a: 'If your team has a senior art director and a workflow that already handles character consistency, AI tools alone will get you most of the way. If you are new to the stack, the first three projects will look more like the consistency problems described above than like finished boards. Brands that hire us are usually past the point of running that experiment.',
  },
  {
    q: 'What do I need to send to get started?',
    a: "Final or near-final script. Brand guidelines if you have them. Talent guidelines and product reference. Delivery format list with durations and ratios. Production company contact if one is booked. Reference work you like, and work you want to avoid. If brand guidelines do not exist, we work from what does and flag the gaps in the first brief response.",
  },
  {
    q: 'Who actually does the work?',
    a: 'Art directors with TV and broadcast credits (Publicis, Ogilvy, WPP and named production-company alumni) lead every project. AI specialists handle the iteration volume. The senior on the brief stays on it from brief to final hand-off.',
  },
  {
    q: 'Will the boards look like our brand, or like AI?',
    a: 'Like your brand. We train on your existing assets, talent guides and product reference so the output stays inside your visual system, not a generic AI aesthetic.',
  },
  {
    q: 'Do you deliver animatics, or just static boards?',
    a: 'Both. Static boards are the standard deliverable. Animatics are an optional add-on when timing matters, which is most of the time for any spot under 30 seconds. Output formats include PDF for static boards and MP4 for animatics, plus source files on request.',
  },
  {
    q: 'What about copyright on AI-generated frames?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. Boards are reference for production, not the final film, so the legal questions are different from generative video. For the full picture, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you work with our existing production company?',
    a: 'Yes, and we prefer it. About two-thirds of our work plugs in alongside a production company the brand already has on retainer. We deliver boards, shot lists and animatics matched to their pipeline. Where we add the most value is the gap between the script and the production company first treatment, which is where most timelines slip.',
  },
  {
    q: 'Where are you based, and where can you deliver?',
    a: 'Our production team is based in Shanghai, with senior creative leads across Asia and Europe. We have delivered boards into the US, EU, UK, Middle East and APAC. Languages we have worked in include English, French, German, Spanish, Mandarin, Cantonese, Japanese, Korean and Arabic.',
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one script. Inside one week you get three frame directions on the opening sequence and a board estimate for the full spot. No retainer, no commitment, the work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Storyboard Services | AI-Native | hubStudio"
  description="Cinematic storyboards for TV, social, animation and branded film. Senior art directors lead. AI-paced iteration. Shoot-ready in days."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Services
            <span class="kicker__sep">/</span> Pre-production
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Story</span></span>
            <span class="line"><span class="line__i serif">Board.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Shoot-ready frames. Cinematic intent. <em>No surprises on set.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              The call comes Thursday afternoon, three days into a four-day
              shoot. The director says the board never showed the hero product
              in the wide. The cutdowns will not assemble. Six figures of crew
              time on the line because the board went to set with a missing
              beat.
            </p>
            <p>
              We hear some version of that story from new clients most
              quarters. The board, in our setup, is a working document that
              travels with the spot from brief to delivery.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Senior art directors lead
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/sb-hero.jpg"
          alt="A senior art director marking a pinned storyboard frame on a studio wall in warm afternoon light."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Pre-production</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S1b · TRUST SIGNALS ============ -->
    <section class="signals">
      <div class="shell">
        <ul class="signals__list">
          {signals.map((s) => (
            <li class="signals__item r">
              <span class="signals__tick"></span>{s}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ S2 · WHY / RESULTS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>The results</p>
            <h2 class="dh r" style="--d:.05s">
              Continuity is where<br /><span class="serif">boards die</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Most boards die in the gap between panels. The hero wears a red
              jacket in frame four and a blue one in frame six. The product
              label faces left in the wide, right in the close. None of it
              gets caught in review. All of it gets caught on set, around
              lunchtime, when the light is starting to go.
            </p>
            <p class="r" style="--d:.16s">
              We start from the opposite end. Character sheets, product
              reference and location plates locked before frame one. Shot
              grammar called out frame by frame in the vocabulary the DP
              recognises. Timing in seconds and frames on every panel.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Across roughly <strong>30 storyboard engagements</strong> in the
              last two years, clients have reported faster sign-off, fewer
              reshoots and stronger pitches.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/sb-roots.jpg"
              alt="A long studio wall covered in pinned storyboard panels with an art director reviewing a frame in afternoon light."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The review wall</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            On a 30-second spot we deliver a first cut in three to five days,
            against a two to three week traditional benchmark. Reshoots forced
            by missing shots on boards we delivered last year: zero.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Every format that gets shot, one <span class="serif">campaign system</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            A 30-second TV spot, a 6-second YouTube bumper and a 90-second
            anthem film share almost nothing in their pacing. We staff each
            format with art directors who have boarded it before, all working
            off one campaign system so the assets hold together when they land
            in market the same week. The work breaks into six lanes.
          </p>
        </header>

        <div class="lanes">
          {lanes.map((l, i) => (
            <article class="lane r" style={`--d:${(i % 3) * 0.08}s`}>
              <figure class="lane__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={l.image}
                    alt={l.alt}
                    width="1024"
                    height="820"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{l.label}</figcaption>
              </figure>
              <h3 class="lane__head">{l.label}</h3>
              <p class="lane__lead">{l.lead}</p>
              <p class="lane__body">{l.body}</p>
              <ul class="lane__tags">
                {l.tags.map((t) => <li class="chip chip--sm">{t}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <p class="cover__foot r">
          If your format is not on the list, ask. We have probably boarded it
          once.
        </p>
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Frames and ratio variants from recent boards, authored in the
            studio. Every panel is hand-finished work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · WHERE AI BREAKS ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/sb-ai-breaks.jpg"
                alt="A continuity comparison sheet pinned to a corkboard: inconsistent AI frames on the left, art-director-corrected frames with red notes on the right."
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/sb-ai-inset.jpg"
              alt="A hand making red ink margin notes on a printed storyboard panel to correct a continuity error."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 pass</span>
            <span class="source__stat-cap">Senior art-director review on every frame</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Where AI breaks</p>
          <h2 class="dh r" style="--d:.05s">
            Why boards generated by tools alone do not make it to <span class="serif">set</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Image models are probabilistic by design. Without a tight reference
            setup they drift between frames. Facial features morph. Hair
            changes colour. Product labels rotate on their own.
          </p>
          <p class="source__p r" style="--d:.16s">
            That is the failure mode you cannot ship to a director. Our setup
            answers it with locked character sheets before any frame gets
            generated, fixed reference packs per scene, seed control across the
            whole board, and a senior art-director hand-pass on every frame
            before it goes into a client deck.
          </p>
          <ul class="creds r" style="--d:.22s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Locked character sheets
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Fixed reference packs
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Seed control
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Art-director hand-pass
            </li>
          </ul>
          <p class="source__p r" style="--d:.26s">
            This is what we mean by AI-native rather than AI-only. The
            iteration runs on the model. The picks come from the art director.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Where we do not fit: one-off thumbnails for an internal review.
            Our setup pays off on full campaigns and multi-format ship lists,
            work that has to survive client review, legal review and three
            rounds of brand approval.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Cinematic thinking is<br />where it is <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          AI made the visual generation side cheap and fast for everyone.
          Picking the frame that actually sells the spot, and the cut that
          carries the story, is still the hard part.
        </p>
        <p class="craft__note r" style="--d:.16s">
          The first two steps are where it is won. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI rewrote<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A 30-second TV spot, run two ways. Same brief, same script, same
            ship list.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Two to three weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Brief an agency, wait a week for a treatment, another week for
                first-pass boards, a few more days for revisions. Two to three
                weeks before a frame is approved, three or four rounds of
                redraw, and a board that is dated by the time it lands on set.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Three to five days</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to first cut</span>
                  <span class="vs__seg-dur">Three to five days</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Dozens of frame directions explored in parallel on day one.
                Character and product consistency locked from reference sheets.
                Ratio variants reboarded from the same system, not cropped.
                Animatic on demand. Three rounds of revisions included.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Weekly briefs, not <span class="serif">quarterly</span>.
            </h3>
            <p class="hub__text">
              For brands running ongoing ad and content calendars, we deploy
              hub4You, our agent setup trained on your own brand system. It
              generates on-brand boards on demand, holds character and product
              consistency across the whole calendar, and connects to your DAM
              and shot-list pipeline so the output lands where your team and
              your production company already work.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/sb-hub.jpg"
                alt="The hub4You platform generating on-brand storyboard frames with character consistency from a brand-trained model."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <blockquote class="pull r">
          <p>
            Roughly 70% of production delays trace back to pre-production
            oversights, with storyboarding and shot-listing among the most
            cited weak points.
          </p>
          <footer>Independent film industry survey, cited across pre-production tooling reviews, 2025</footer>
        </blockquote>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Twelve questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put
            it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try it on a script</p>
        <h2 class="end__title r" style="--d:.05s">
          See it on your<br />own <span class="serif">script</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send a script. Inside one week you get three frame directions on the
          opening sequence and a board estimate for the full spot. No
          retainer, no commitment. Whatever we produce is yours to keep,
          regardless of where the conversation goes.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
