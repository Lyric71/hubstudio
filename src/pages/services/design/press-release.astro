---
/**
 * Press Releases  ·  /services/design/press-release
 *
 * Art direction shared with packaging-merch-design: an editorial proof
 * sheet. Crop marks, calibration colour bar, mono figure labels frame
 * bold typography and a printed-press / newsroom photography set.
 *
 * Copy adapted from press-release-page.md. Process step numerals are
 * intentionally dropped per the project's permanent "no numbers in
 * cards / step lists" rule. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio sample press kits, each with an invented brand mark. */
const samples = [
  {
    src: '/Images/pr-sample-axiom.jpg',
    brand: 'Axiom',
    kind: 'Tech Series B',
    alt: 'A navy printed cover sheet for the Axiom Series B announcement on a slate desk, with a matching folder and a brushed-steel pen.',
  },
  {
    src: '/Images/pr-sample-noria.jpg',
    brand: 'Noria',
    kind: 'Sustainability report',
    alt: 'A moss-green sustainability report cover for Noria on warm oat linen with a dried wheat sprig laid across the lower edge.',
  },
  {
    src: '/Images/pr-sample-helia.jpg',
    brand: 'Helia',
    kind: 'Beauty launch',
    alt: 'A blush ivory invitation for the Helia beauty category launch, beside an unlabelled sample bottle and a pressed magnolia petal.',
  },
  {
    src: '/Images/pr-sample-verge.jpg',
    brand: 'Verge',
    kind: 'SaaS partnership',
    alt: 'Two matte white press cover pages for a Verge B2B SaaS partnership announcement, overlapping at a diagonal on a slate desk.',
  },
  {
    src: '/Images/pr-sample-otho.jpg',
    brand: 'Otho',
    kind: 'Maison flagship',
    alt: 'A deep burgundy embossed folio for the Otho maison flagship opening, half open on dark walnut with a thin gold ribbon bookmark.',
  },
  {
    src: '/Images/pr-sample-pallia.jpg',
    brand: 'Pallia',
    kind: 'CE product launch',
    alt: 'A slate-grey product card for the Pallia consumer electronics launch on pale concrete, beside a folded press sheet and a neat cable loop.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-program results, drawn from the source averages. */
const stats = [
  { from: 35, to: 82, suffix: '%', label: 'First-pass approval', note: 'Up from a 35% baseline' },
  { from: 0, to: 70, suffix: '%', label: 'Lower content cost', note: 'On multi-market rollouts' },
  { from: 0, to: 8, suffix: 'x', label: 'Asset output', note: 'Same headcount' },
];

/* The two coverage areas. Tag rows surface phrases named in the prose. */
const coverage = [
  {
    fig: 'B',
    label: 'Releases',
    heading: 'What we cover on releases.',
    image: '/Images/pr-sample-axiom.jpg',
    alt: 'A navy Axiom Series B press cover on slate, an example of the release work we ship.',
    body: [
      'Product and category launches. Corporate and financial. Brand and campaign launches. Sustainability and ESG. Partnerships and deals. Crisis and reactive comms. Events and trade-show announcements. If your release type is not on the list, ask. We have probably done it.',
      'Every draft is written by a senior PR writer with agency or newsroom experience, and structured for both journalist pickup and AI citation on the same page. NewsArticle JSON-LD on the canonical newsroom version. Boilerplate aligned with your Wikidata entry. The first draft lands inside 48 hours on a standard release.',
    ],
    tags: [
      'Product launches', 'Corporate & financial', 'Brand campaigns',
      'Sustainability & ESG', 'Partnerships & deals', 'Crisis & reactive',
      'Events & trade shows', 'NewsArticle JSON-LD',
      'Wikidata-aligned boilerplate', '48-hour first draft',
    ],
  },
  {
    fig: 'C',
    label: 'Transcreation',
    heading: 'What we cover on transcreation.',
    image: '/Images/pr-p4-transcreate.jpg',
    alt: 'The same release printed in five languages, fanned across a wooden desk with a notebook of translation notes.',
    lead: 'A literal translation kills the story.',
    body: [
      'Writers draft in the target language from the source brief, not from the finished English release. A native French PR writer takes the French version. A native Mandarin writer takes the Mandarin. They work off the same fact sheet, the approved quotes, the brand voice notes, the embargo timing. The release lands in each market reading like it was written there. Product names, verified numbers and named attributions stay locked.',
      'English, French, German, Spanish, Italian, Portuguese, Dutch, Mandarin (Simplified and Traditional), Cantonese, Japanese, Korean, Thai, Vietnamese, Arabic, Turkish, and Hindi. Others on request.',
    ],
    tags: [
      'English', 'Français', 'Deutsch', 'Español', 'Italiano',
      'Português', '简体中文', '繁體中文', '日本語', '한국어',
      'العربية', 'हिन्दी',
    ],
  },
];

/* Wire and distribution partners, named in the distribution copy. */
const credentials = ['PR Newswire', 'Business Wire', 'GlobeNewswire', 'Cision', 'Xinhua', 'Reuters PR'];

/* Process steps. Numerals dropped per the no-numbers rule; "the news angle
   and the editorial direction are where it's won" sets each step's tier. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and news angle.',
    body: 'The news, the proof, the named quotes, the embargo, the markets, the legal clearances.',
    image: '/Images/pr-p1-brief.jpg',
    alt: 'A senior communications director at a sunlit oak desk laying out a fact sheet and brief notes beside a leather notebook.',
  },
  {
    short: 'Editorial direction',
    tier: 'Where it is won',
    title: 'Editorial direction. The step that matters most.',
    body: 'Senior writers set the angle, the lede, the quote ladder and the headline. AI does not decide what the news is. People with newsroom experience do.',
    image: '/Images/pr-p2-direction.jpg',
    alt: 'Two senior writers across a wide oak table mid-conversation, marked-up press release drafts spread between them.',
  },
  {
    short: 'AIGC drafting',
    tier: 'The rest is execution',
    title: 'AIGC drafting.',
    body: 'Dozens of angle and headline variants in an afternoon, faster than a single staff writer can sketch them.',
    image: '/Images/pr-p3-aigc.jpg',
    alt: 'The same press release cover printed in nine typographic variants laid out in a tidy grid, with an editor\'s red pencil pointing at one.',
  },
  {
    short: 'Transcreation',
    tier: 'The rest is execution',
    title: 'Transcreation at scale.',
    body: 'Market versions drafted in target language by native writers. NewsArticle JSON-LD applied. Quotes localized for cultural register, not translated word for word.',
    image: '/Images/pr-p4-transcreate.jpg',
    alt: 'The same release printed in five languages, fanned across a wooden desk beside a notebook of translation notes.',
  },
  {
    short: 'Distribution',
    tier: 'The rest is execution',
    title: 'Wire handover and adaptation.',
    body: 'Files matched to each wire\'s spec. Embargoed batches landed across markets inside a 60-minute window.',
    image: '/Images/pr-p5-distribute.jpg',
    alt: 'A stack of finished press release packets in matte ivory envelopes with wax seals at the corner, on a long wooden desk.',
  },
];

/* The process splits into two tiers: the steps where the project is won, and
   the steps that are execution. Each renders in its own block below. */
const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* The old agency timeline, split into the phases the copy names. */
const oldPhases = [
  { label: 'Drafting', dur: 'Three weeks', span: 3 },
  { label: 'Approvals', dur: 'Two weeks', span: 2 },
  { label: 'Translation', dur: 'Two weeks', span: 2 },
];

/* FAQ: wording from the source; one answer links to the GEO guide. */
const faqs = [
  {
    q: 'How long does a press release take?',
    a: '48 hours for a first draft on a standard release. Five working days for a multi-market rollout with transcreation into three or more languages. Same-day rush on breaking news, crisis communications or embargo shifts, billed at a rush rate. We have shipped recall notices in under three hours. We do not recommend that being the norm.',
  },
  {
    q: 'What does a project actually cost?',
    a: 'Engagements are either project-based for one-off releases or retainer-based for ongoing PR volume, typically two to eight releases a month. Retainers are billed quarterly in advance. Multi-market rollouts are quoted by language pair and complexity, not by word count. The variables that move the number most: language count, whether wire distribution is in scope, embargo complexity, and how much source material we have to research versus receive. We give a firm number after the first call.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three. Most releases close inside two. Beyond round three we quote hourly. Crisis work is handled differently, with faster cycles built into the retainer because round-counting does not work when the deadline is in 90 minutes.',
  },
  {
    q: 'What do I need to send to get started?',
    a: 'The news itself. A fact sheet with dates, numbers and named entities. Quotes from the people you want quoted, or a brief for us to draft and them to approve. Brand voice notes if they exist, or prior releases we can reverse-engineer from. Wire and newsroom URLs. Legal contacts who need to clear copy. Embargo timing and time zone. Must-mention list. Do-not-touch list. Boilerplate you want preserved.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior writers with agency or newsroom backgrounds lead every release. Native-language writers handle each market version. Editors with PR experience review before client handoff. No junior teams running the brief alone. No machine output going out unreviewed.',
  },
  {
    q: 'Will the release sound like us, or like a press release template?',
    a: 'Like you. We train models on your existing communications, study your prior releases and your CEO\'s actual interview quotes, and brief writers on your brand voice before they touch a draft. Brands without a documented voice get one built as we go and handed over with the files. We cut the clichés on every draft. That is about half the job.',
  },
  {
    q: 'How do you handle AI search optimization?',
    a: 'Built into the writing, not bolted on after. Headlines structured around the question a target user would actually type into ChatGPT or Perplexity. First paragraphs dense with named entities, dates, locations and numbers a model can extract. NewsArticle JSON-LD on the canonical newsroom version. Boilerplate aligned with your Wikidata entry. For the wider playbook, see our GEO and AI search guide.',
    link: { match: 'GEO and AI search guide', href: '/resources/geo-and-ai-search' },
  },
  {
    q: 'Can you handle a full multi-market campaign, or just one release?',
    a: 'Both. Some clients come for a single corporate announcement. Others run a quarterly release program across eight markets, four languages and three wire services with embargoes that have to land within a 60-minute window. The workflow scales either way.',
  },
  {
    q: 'Do you handle distribution, or just writing?',
    a: 'Writing and editorial by default. Wire distribution is optional. If you already work with a wire (PR Newswire, Business Wire, GlobeNewswire, Cision, Media OutReach, Xinhua, Yonhap, Kyodo, AFP, Reuters PR or a regional service) we deliver files matched to their spec and step back. If you do not, we set up distribution alongside the writing across the wires that fit your news and your markets.',
  },
  {
    q: 'Where are you based, and where can you deliver?',
    a: 'Editorial and production team in Shanghai, with senior writers in Paris, London, New York and Hong Kong. We have delivered into the US, EU, UK, China, Japan, Korea, Southeast Asia, the Middle East and Latin America. Local-language work is handled by writers in or from each market.',
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one release brief. Inside 48 hours you get a first draft in your source language and an outline for one localized market. No retainer, no commitment, the work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Press Release Services | AI-Native | hubStudio"
  description="Press releases written for journalists and AI search. Multilingual transcreation, wire-ready files, GEO-structured, every market you ship into."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Content service
            <span class="kicker__sep">/</span> Press Releases
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Press</span></span>
            <span class="line"><span class="line__i serif">Releases</span></span>
            <span class="line"><span class="line__i">that read as news.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Written for the journalist. <em>And the model.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A Series B goes live in New York at 8 a.m. By 9 a.m. the French
              version is still sitting in legal. The German one has a CEO quote
              nobody at the company would actually say out loud. Xinhua has
              translated the product name literally.
            </p>
            <p>
              We hear some version of that morning from new clients most
              quarters. So multilingual planning is the first thing we talk
              about now, not the last.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See studio samples
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Writing + optional wire distribution
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/pr-hero.jpg"
          alt="A journalist in a charcoal cardigan reading a printed multi-page press release at a sunlit newsroom desk."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio scene <span>/</span> Newsroom</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Written for two<br /><span class="serif">readers</span> now.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Most studios still write press releases the way they were written
              in 2014. Vague headlines. Ceremonial quotes. "Excited to announce"
              in the lede. Those releases get distributed, indexed, and then
              ignored by both the journalists they were aimed at and the answer
              engines that are now the second audience for everything.
            </p>
            <p class="r" style="--d:.16s">
              The shift since late 2024 is measurable. 82% of journalists report
              using at least one AI tool in their workflow (Muck Rack, State of
              Journalism 2026). Cision puts generative AI use among PR
              professionals at 91%.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Industry data drawn from <strong>Muck Rack</strong>,
              <strong>Cision</strong> and <strong>Reuters Institute</strong>,
              2026 cycles.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/pr-roots.jpg"
              alt="A working newsroom interior in late morning, three journalists at long oak desks with printed press releases between them."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The two-reader test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Roughly 60 multilingual release programs in the last two years.
            First-pass approval lifted from 35% to 82%, multi-market content
            costs cut by 70%, and asset output 8x without a single new hire.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">editorial voice</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Studio scenes of finished release work, captured in the studio.
            Brand names invented; every frame is authored, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · DISTRIBUTION (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/pr-newsroom.jpg"
                alt="A communications operations room: two staff at a long oak desk reviewing a stack of printed press release pages."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/pr-wire.jpg"
              alt="A pair of hands marking notes in red ink on a printed press release page."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48 hrs</span>
            <span class="source__stat-cap">First draft to wire-ready file</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it pushed to the wires?<br />We can <span class="serif">ship</span> it.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients come to us for the writing. But
            if you also need someone to handle distribution, we can pick it up
            from there.
          </p>
          <p class="source__p r" style="--d:.16s">
            We're based in Shanghai, with senior writers in Paris, London, New
            York and Hong Kong. We deliver files matched to your wire's spec:
            PR Newswire, Business Wire, GlobeNewswire, Cision, Media OutReach,
            Xinhua, Yonhap, Kyodo, AFP and Reuters PR. Local-language work is
            handled by writers in or from each market.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Embargoed batches landed across markets inside a 60-minute window.
            Same-day rush on breaking news, crisis communications or embargo
            shifts. We have shipped recall notices in under three hours.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already work with your own wire, no problem. We deliver
            wire-spec files and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          The angle is where<br />it's <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Most studios sell process. We sell the editorial call. AI made the
          translation and production side cheap and fast for everyone. It did
          not replace the eye that picks which angle a journalist will actually
          take.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it's won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with a multi-market launch across four languages and
            three wire services. The same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Seven weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief an agency, three weeks for the source
                draft, two more for legal and regional approvals, another two
                for per-market translation rounds. Seven weeks, four
                stakeholder cycles, and a CEO quote that nobody at the company
                would say out loud.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Five working days</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to wire-ready files</span>
                  <span class="vs__seg-dur">Five working days</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: first draft in 48 hours. Native-language versions
                drafted in parallel by writers in or from each market. NewsArticle
                JSON-LD applied on the canonical version. Embargo batches landed
                across markets inside a 60-minute window. Same-day rush on
                breaking news.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Quarterly to <span class="serif">weekly</span>.
            </h3>
            <p class="hub__text">
              For brands shipping news across markets on a recurring cadence, we
              deploy hub4You, our custom AI agent setup trained on your
              boilerplate, your CEO's actual voice, your approved quote library
              and your regional embargo patterns. It drafts first-pass release
              variants on demand and connects to your newsroom CMS and PR
              distribution stack so the output lands where your team already
              works. That's the gap between launching releases quarterly and
              launching them weekly.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4presentation.jpg"
                alt="The hub4You platform composing on-brand text content from a fact sheet and approved quote library."
                width="1360"
                height="768"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put it
            in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us one release brief. Inside 48 hours you get a first draft in
          your source language and an outline for one localized market. No
          retainer, no commitment. Whatever we produce is yours either way.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
