  }
  .hero__title .serif {
    font-size: 1.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line__i {
      transform: none;
    }
  }
  .hero__tag {
    margin-top: 26px;
    font-size: clamp(18px, 1.5vw, 23px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__tag em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .hero__lead {
    margin-top: 20px;
    display: grid;
    gap: 13px;
    max-width: 46ch;
  }
  .hero__lead p {
    font-size: var(--type-body);
