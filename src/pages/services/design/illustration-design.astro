---
/**
 * Illustration Design  ·  /services/design/illustration-design
 *
 * Sibling to /services/design/packaging-merch-design and /print-design.
 * Same "Pressroom" art direction (crop marks, calibration colour bar, mono
 * figure labels, dashed rules) carried over because illustration here is
 * still authored editorial work, finished and filed.
 *
 * Copy adapted from illustration-design-page.md. Process step numerals
 * dropped per the project's permanent "no numbers in cards / step lists"
 * rule. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio samples: six invented brand marks across the format range called
   out in the source (packaging character, editorial spot library, retail
   POS, mascot, hospitality map, pharma infographic). */
const samples = [
  {
    src: '/Images/illust-sample-juvera.jpg',
    brand: 'Juvera',
    kind: 'Beverage character system',
    alt: 'A glass juice bottle illustrated with a flat-vector sun character holding fruit, behind it a folded out-of-home poster of the same character.',
  },
  {
    src: '/Images/illust-sample-northrise.jpg',
    brand: 'Northrise',
    kind: 'SaaS editorial library',
    alt: 'A laptop displaying a Northrise editorial illustration of figures around an abstract data shape, beside a printed contact sheet of related spot illustrations.',
  },
  {
    src: '/Images/illust-sample-koto.jpg',
    brand: 'Koto',
    kind: 'Beauty retail point-of-sale',
    alt: 'A retail point-of-sale poster on travertine, carrying a hand-painted ink-and-watercolor lotus and a hand cupping a porcelain jar, with the Koto wordmark.',
  },
  {
    src: '/Images/illust-sample-fennel.jpg',
    brand: 'Fennel',
    kind: 'FMCG mascot system',
    alt: 'A cereal carton on a kitchen counter illustrated with a graphic-novel raccoon mascot raising a spoon, beside a sticker sheet of the same mascot.',
  },
  {
    src: '/Images/illust-sample-belvane.jpg',
    brand: 'Belvane',
    kind: 'Hospitality concierge artwork',
    alt: 'A leather concierge folder open on a walnut desk, the left page a hand-drawn watercolor map of a Mediterranean coastal town and the right page a serif key.',
  },
  {
    src: '/Images/illust-sample-vitalix.jpg',
    brand: 'Vitalix',
    kind: 'Pharma patient-journey',
    alt: 'A printed brochure spread on pale concrete carrying a flat-vector patient journey: five visit stages connected by a soft curving line.',
  },
];

/* Calibration colour bar: a printer's strip, kept as the studio's section
   divider across the design vertical. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Engagement-level stats, identical to the studio average across recent
   illustration work, per the source. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'Creative approval rate', note: 'Up from 22% before' },
  { from: 0, to: 60, suffix: '%', label: 'Lower content cost', note: 'On recent campaigns' },
  { from: 0, to: 7, suffix: 'x', label: 'Asset output', note: 'Without a single new hire' },
];

/* The eight illustration categories from the source collapse into two
   readable lanes by audience surface: brand-facing and product-facing.
   The tag rows below each lane surface every named category. */
const coverage = [
  {
    fig: 'B',
    label: 'Brand & commercial',
    heading: 'Brand-facing illustration that earns the buyer.',
    image: '/Images/illust-cover-brand.jpg',
    alt: 'An illustrated out-of-home poster pasted to a weathered concrete wall on a quiet side street, a cyclist passing in soft blur.',
    lead: 'The work that has to land on a wall, in a hand, on a shelf.',
    body: [
      'Editorial and content libraries, paid-social and out-of-home hero artwork, illustrated packaging, mascot systems and character rigs. One concept gets adapted across square, vertical, horizontal and outdoor crops; the focal weight rebuilt for each canvas so nothing drops out at the edges.',
      'Most briefs come in with forty drawings across six surfaces by next month. The system is built before the volume starts, so every piece reads as one hand.',
    ],
    tags: [
      'Editorial spots', 'Campaign heroes', 'Out-of-home', 'Paid social',
      'Packaging illustration', 'Mascot systems', 'Character rigs',
      'Retail point-of-sale', 'Print collateral',
    ],
  },
  {
    fig: 'C',
    label: 'Product, data & motion',
    heading: 'Inside the product, inside the feed.',
    image: '/Images/illust-cover-product.jpg',
    alt: 'A tablet on a wooden desk displaying a flat-vector app onboarding screen with an illustrated character, surrounded by printed reference sheets for error and empty states.',
    body: [
      'Empty states, onboarding sequences, error pages, feature illustrations for product surfaces. Patient journeys, supply chain maps, annual report visuals, comparison charts. Looping social spots, animated stickers, Lottie files for screens that move.',
      'Format constraints are tight (vector, scalable, palette-locked) and the asset count usually runs into the hundreds. The trained model layer keeps every piece inside the locked style.',
    ],
    tags: [
      'UI illustration', 'Empty states', 'Onboarding sequences',
      'Infographics', 'Data illustration', 'Annual reports',
      'Lottie & motion', 'Animated stickers', 'Conference & event',
    ],
  },
];

/* Tool stack chips for the "Style is the brief" section. Editorially
   honest about the model and node-graph choices behind the production
   layer; no rankings, no logos. */
const stack = ['ComfyUI graphs', 'Nano Banana', 'Seedream v4', 'Midjourney', 'Hunyuan & Qwen', 'Illustrator', 'Procreate', 'Photoshop'];

/* Process steps. Numerals dropped per the no-numbers rule. The source
   itself calls out the first two as where the work is won. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and visual world.',
    body: 'Audience, surfaces, brand mood, style references and exclusions, regulatory and accessibility constraints, deliverable count, market variants, timeline.',
    image: '/Images/illust-p1-brief.jpg',
    alt: 'A studio worktable scattered with a printed brief, magazine tear-sheets of illustrated covers, a color swatch fan and handwritten notes.',
  },
  {
    short: 'Style direction',
    tier: 'Where it is won',
    title: 'Style development. The step that matters most.',
    body: 'A senior illustrator builds three to five style directions. Real artworks against the brief, not mood boards. One is picked, or two are fused, and the visual system is locked.',
    image: '/Images/illust-p2-style.jpg',
    alt: 'Five printed illustration sheets on a long worktable, each rendering the same character in a different style: flat vector, grainy print, watercolor, graphic-novel ink, painterly digital.',
  },
  {
    short: 'System build',
    tier: 'The rest is execution',
    title: 'System build.',
    body: 'Palette, line weight, texture, composition logic, character or icon library, motion behavior where relevant. The spec that lets us produce at volume without drift.',
    image: '/Images/illust-p3-system.jpg',
    alt: 'A printed illustration style guide on a plaster surface: palette swatches, line-weight samples, character poses and emotion variants annotated in red marker.',
  },
  {
    short: 'AI production',
    tier: 'The rest is execution',
    title: 'AI-led production.',
    body: 'Hundreds of variants in parallel, all inside the locked system. Photoreal mockups in the world the work will live in, so you approve in context.',
    image: '/Images/illust-p4-production.jpg',
    alt: 'A grid of sixteen variant editorial illustrations of the same character, all in the same flat-vector style, on a wide studio monitor.',
  },
  {
    short: 'Finishing',
    tier: 'The rest is execution',
    title: 'Finishing and source files.',
    body: 'Vector and raster, layered source files, font outlines, color profiles, market variants. Ready for your brand-asset DAM on the first pass.',
    image: '/Images/illust-p5-finish.jpg',
    alt: 'A designer\'s monitor showing an illustration source file in a vector design app with layer and artboard panels, finished character artwork on the artboard.',
  },
];

const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* Three documented shifts in 2026: brands buying back illustration share.
   Press-wire pattern from the print-design sibling. The numerals are
   content (real percentages and counts), not decorative ordinals. */
const shifts = [
  {
    year: '2025',
    src: 'Burger King · packaging',
    stat: '70s',
    statCap: 'Diner illustration · Gen Z + millennials',
    head: 'Chunky illustration, on a fast-food carton.',
    body: 'Burger King leaned into chunky 70s diner illustration on packaging and cut through with both Gen Z and millennials. A category where every competitor still leans on flat photography.',
  },
  {
    year: '2025',
    src: 'Tesco Finest · tea range',
    stat: '1',
    statCap: 'Illustrator, the whole shelf',
    head: 'One hand, a whole tea range.',
    body: 'Tesco commissioned a single illustrator across its Finest tea range and turned a commodity into a premium experience. The wordmark stayed; the illustration sold it.',
  },
  {
    year: '2026',
    src: 'Visa · FIFA World Cup',
    stat: '48',
    statCap: 'Host cities, local artists',
    head: 'A global art collection, market by market.',
    body: 'Visa built its 2026 FIFA World Cup campaign around a Global Art Collection, with each host city illustrated by a local artist. Authored, not assembled.',
  },
];

/* Twelve questions from the source brief. The legal answer keeps its
   link to the Copyright and AI guide. */
const faqs = [
  {
    q: 'How long does an illustration project take?',
    a: 'Ten days for the first three style directions on a fresh brief. Two to three weeks for a full visual system build with the first batch of finished artwork. Faster on a brand we already have a trained model for. Rush is available when the calendar is tight.',
  },
  {
    q: 'What does a project cost?',
    a: 'Project-based for one-off systems. Monthly retainer for ongoing volume across editorial, social and campaign work. Quarterly advance billing for retainer clients. We quote firm after the first call once the brief and deliverable count are clear.',
  },
  {
    q: 'How will I know the work will not look like generic AI?',
    a: 'Two ways. First, the style direction is approved before any production starts, against real artworks, not mood boards. Second, the brand-trained model layer sits on top of the base systems and pulls everything toward your locked references. If the output starts drifting toward the generic AI aesthetic, we redo it on our time, not yours.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three. Most projects close inside two, because the style direction is locked in step two of the process. Beyond round three we quote hourly.',
  },
  {
    q: 'What do I need to send to get started?',
    a: 'Brand guidelines if you have them. Style references from inside and outside your category, both for what you like and what you want to avoid. Audience description. Surface list, where the work will live. Deliverable count, format and aspect ratios. Market variants, and any regulatory or accessibility constraints. If brand guidelines do not exist, we work from what does and flag the gaps.',
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior illustrators with agency backgrounds (Publicis, Ogilvy, WPP, plus illustration-only studios) own the style direction. AI specialists run the production volume against the locked system. No junior teams running the brief alone, no generic AI output shipped as finished work.',
  },
  {
    q: 'What rights do I get on the final artwork?',
    a: 'Full commercial rights, worldwide, in perpetuity, for any medium. Source files included. No additional licensing fees if you reuse the artwork in a different market, format or campaign later.',
  },
  {
    q: 'What about copyright on AI-assisted illustration?',
    a: 'You own the final deliverables. We use commercially safe model bases, layer brand-trained models on top, and document the workflow. Under current US, EU and UK guidance, human creative contribution (style direction, selection, editing, finishing) is what supports copyright eligibility, and that is structurally how the process is built. Full detail in our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'What happens if we cancel mid-project?',
    a: 'A kill fee covers the work completed up to the cancellation point, plus a share of the remaining scope depending on how far in we are. We document each stage so the calculation is transparent. Anything we have already shipped is yours to keep regardless.',
  },
  {
    q: 'Can you handle a full system across markets and surfaces, or just one piece?',
    a: 'Both, though the system is where we earn our keep. Some clients come for a single key visual. Others arrive with 400 editorial spots, 80 packaging illustrations, 12 OOH heroes and a mascot system, all in one consistent style across four markets. The workflow scales either way.',
  },
  {
    q: 'Will my illustration style be exclusive to my brand?',
    a: 'It will. The brand-trained model built for you is yours and is not used on other clients. The base models are shared (everyone in the industry uses them), but the trained layer on top, the prompt library, the seeds and the locked style references are exclusive. That is what makes the work read as yours.',
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one brief. Inside ten days you get three style directions and one finished piece in your preferred direction. No retainer, no commitment, the work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/services/design/illustration-design`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Illustration Design',
  description:
    'Custom illustration for brands at scale: editorial art, packaging, mascots and campaign work, built as one visual system with hundreds of usable variants.',
  serviceType: 'Illustration design',
  url: pageUrl,
  provider: { '@type': 'Organization', name: 'hubStudio', url: SITE },
  areaServed: 'Worldwide',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE}/services` },
    { '@type': 'ListItem', position: 3, name: 'Illustration Design', item: pageUrl },
  ],
};
---

<Layout
  title="Illustration Design Services | AI-Native | hubStudio"
  description="Custom illustration for brands at scale. Editorial, packaging, mascots, campaign art. Led by senior illustrators, AI-powered production, every market."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Illustration
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Illustration</span></span>
            <span class="line"><span class="line__i serif">Design.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            One visual system, <em>hundreds</em> of usable variants.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A skincare brand called us on a Tuesday, six days before a
              regional launch. The hero illustration their freelancer had sent
              over was beautiful and unusable. Wrong aspect ratios, no
              localized variant, no layered source files.
            </p>
            <p>
              We hear some version of that story most months. So the workflow
              is built to make that call unnecessary.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Illustration design
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/illustration-hero.jpg"
          alt="An illustrator's worktable in a sunlit studio: a graphics tablet displays a half-finished editorial illustration of a woman in a teal coat, beside a stack of printed colour variants and an open sketchbook."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Editorial</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why illustration earns its space</p>
            <h2 class="dh r" style="--d:.05s">
              When everything looks AI, the brand that looks <span class="serif">made</span> wins.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              The category shifted hard in the last eighteen months. Generic
              AI imagery flooded every feed, every brief, every other pitch
              deck. Audiences learned to scroll past it.
            </p>
            <p class="r" style="--d:.16s">
              The brands taking ground are the ones whose visual world reads
              as authored. AI made polish cheap, which made craft expensive
              again, which moved real money back toward custom artwork.
            </p>
            <p class="why__clients r" style="--d:.22s">
              <strong>40% of marketers now cite authenticity</strong> as a
              bigger concern with AI visuals than speed.
              <span class="why__src">Venngage, 2026 Design &amp; Marketing Trends Report.</span>
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/illust-roots.jpg"
              alt="A close shot of an illustrator's hand drawing in pencil on a half-finished editorial illustration, with worn studio tools at the edge of frame."
              width="1408"
              height="792"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The authored test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across roughly 35 illustration engagements in the last two years:
            approval up from 22% to 78%, content cost down 60%, output 7x,
            with no new hires.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Eight categories, one <span class="serif">visual system</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            The brief that lands is rarely "draw me one picture." It is
            usually forty drawings, six surfaces, three markets, by next
            month. The work is built around two lanes, with every named
            category surfaced as scope.
          </p>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">artwork</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Concepts and finished pieces, authored in the studio. Each
            sample shows a different lane: packaging character, editorial
            library, retail point-of-sale, mascot, hospitality map, pharma
            infographic.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · STYLE IS THE BRIEF ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/illust-style-main.jpg"
                alt="A studio wall pinned with four printed style-direction sheets for the same character, each in a different visual world."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/illust-style-inset.jpg"
              alt="A close shot of an illustrator's hand holding a stylus over a graphics tablet, drawing a stylized face in line."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">10 days</span>
            <span class="source__stat-cap">First three style directions on a fresh brief</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The craft</p>
          <h2 class="dh r" style="--d:.05s">
            Style is the brief.<br />Volume is the <span class="serif">engine</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The first artwork is not the deliverable, it is the spec. Once a
            senior illustrator nails the style, line weight, texture and
            character logic, that system generates the next two hundred
            pieces with everything still reading as one hand.
          </p>
          <p class="source__p r" style="--d:.16s">
            Style families on offer span flat vector, hand-drawn line,
            watercolor, gouache, painterly digital, comic and graphic novel,
            retro and printmaking, 3D stylized, paper-craft and collage, and
            editorial fine-line. Each brief is staffed with the illustrator
            whose hand the work calls for.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              stack.map((s) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {s}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            ComfyUI as the production backbone, locking a style through node
            graphs that run hundreds of variants without prompt drift. The
            model choice moves with the brief: Nano Banana for photoreal
            integration, Seedream for line work, Midjourney for painterly
            mood, the Chinese models for graphic Asian aesthetics. Tool is
            not the religion, the result is.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            The taste call upstream, the production economics downstream.
            That is the whole job.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative is where<br />it is <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          The shift AI brought to illustration is the one it brought to
          print and to photo. The technical floor collapsed. Anyone can
          generate a picture now. The bottleneck moved upstream, to taste
          and to the editorial call on which image is worth shipping.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · WHERE BUDGET MOVED ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Where budget moved</p>
          <h2 class="dh r" style="--d:.05s">
            Brands buying back<br /><span class="serif">illustration</span> share.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            Three documented commissions since 2025. The money moved
            sharply, fast, and toward the visual world that reads as
            authored.
          </p>
        </header>

        <div class="wire">
          {
            shifts.map((s, i) => (
              <article class="wire__item r" style={`--d:${i * 0.06}s`}>
                <header class="wire__meta">
                  <span class="wire__tick" aria-hidden="true"></span>
                  <span class="wire__filed">Filed {s.year}</span>
                  <span class="wire__sep">/</span>
                  <span class="wire__src">{s.src}</span>
                </header>
                <div class="wire__body">
                  <div class="wire__figure">
                    <span class="wire__stat">{s.stat}</span>
                    <span class="wire__cap">{s.statCap}</span>
                  </div>
                  <div class="wire__copy">
                    <h3 class="wire__head">{s.head}</h3>
                    <p class="wire__p">{s.body}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <aside class="risk r" style="--d:.05s">
          <p class="risk__lede">
            "As AI floods every channel with technically competent content,
            the scarcest creative asset becomes genuine distinctiveness."
          </p>
          <p class="risk__body">
            Apple VP of Marketing Communications, in the Adobe 2026
            Creative Trends report. Same observation, different chair: the
            studios still winning illustration work are the ones whose
            creative direction is strong enough that AI amplifies it,
            instead of standing in for it.
          </p>
        </aside>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Twelve questions,<br /><span class="serif">answered</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before the first call. If yours is not
            here, put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us an illustration brief. Inside ten days you get three
          style directions and one finished artwork. No retainer, no
          commitment. Whatever we produce is yours to keep regardless of
          whether you go ahead with us.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
