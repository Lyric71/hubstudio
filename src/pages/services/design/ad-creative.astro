---
/**
 * Ad Creative  ·  /services/design/ad-creative
 *
 * Art direction reuses the "Pressroom" template from
 * /services/design/packaging-merch-design: print-shop crop marks, calibration
 * colour bar, mono figure labels, editorial typography. The packaging proof
 * motif is repurposed here for ad-creative variants, which read like printed
 * storyboard cards rather than packaging sheets.
 *
 * Copy from ad-creative-page.md. Process step numerals are intentionally
 * dropped: the project's permanent "no numbers in cards / step lists" rule
 * overrides any source numbering. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Sample ad-creative case studies. Each tile is an invented brand mark,
   shown as a phone-format ad mockup rather than a packaging shot. */
const samples = [
  {
    src: '/Images/ac-sample-soren.jpg',
    brand: 'Soren',
    kind: 'Skincare carousel',
    alt: 'A smartphone propped on a plaster ledge showing a clean static Instagram carousel ad for Soren skincare.',
  },
  {
    src: '/Images/ac-sample-halo.jpg',
    brand: 'Halo',
    kind: 'Apparel UGC',
    alt: 'A hand holding a smartphone showing a paused short-form video ad: a young person in a taupe knit hoodie for Halo apparel.',
  },
  {
    src: '/Images/ac-sample-drift.jpg',
    brand: 'Drift',
    kind: 'Beverage hero',
    alt: 'A smartphone laid beside a chilled aluminium drink can on teal concrete, the screen showing a hero static for Drift.',
  },
  {
    src: '/Images/ac-sample-vesper.jpg',
    brand: 'Vesper',
    kind: 'Travel pin',
    alt: 'A smartphone propped against vintage travel guides showing a Pinterest pin-format ad for the Vesper travel app.',
  },
  {
    src: '/Images/ac-sample-kora.jpg',
    brand: 'Kora',
    kind: 'Tech hook frame',
    alt: 'A smartphone on a black slate beside a small chrome earbud case, the screen showing a paused short-form video for Kora.',
  },
  {
    src: '/Images/ac-sample-loop.jpg',
    brand: 'Loop',
    kind: 'Fitness static',
    alt: 'A smartphone on a folded gym towel beside a steel water bottle, screen showing a static habit-tracker ad for Loop.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Headline stats. Sources: the source quote (Segwise on Andromeda; TikTok
   Symphony floor); the source's own line on the fatigue window collapsing
   from six to eight weeks down to two or three. */
const stats = [
  { from: 8, to: 2, suffix: ' wks', label: 'Creative fatigue window', note: 'Was 6 to 8 weeks before Andromeda' },
  { from: 0, to: 20, suffix: '+', label: 'Entity-distinct ads / month', note: 'Threshold for higher Meta ROAS' },
  { from: 0, to: 15, suffix: '', label: 'Distinct assets / TikTok campaign', note: 'Symphony floor for distinct assets' },
];

/* The two coverage lanes, presented as featured articles. The five source
   lanes (statics, video, UGC, always-on, cross-border) collapse into two
   features that match the existing template's alternating layout. */
const coverage = [
  {
    label: 'Global platforms',
    heading: 'Every format the platforms ask for.',
    image: '/Images/ac-sample-halo.jpg',
    alt: 'A smartphone playing a paused short-form video ad for an apparel brand, an example of platform-native creative.',
    lead: "Performance creative for Meta, TikTok, Reels, Shorts, Pinterest, LinkedIn and Xiaohongshu, all in one shop.",
    body: [
      "Meta rewards entity-distinct concepts. TikTok rewards native, creator-coded work that doesn't read as an ad. A global campaign across these surfaces is really five different briefs.",
      "Statics for Meta single-image and carousel, Pinterest, LinkedIn. Short-form vertical for Reels, TikTok, Shorts, Douyin. UGC sourced from the markets you actually sell into, with real creators where the brief calls for them and AI talent where volume calls for it. Always-on refresh on a weekly or biweekly cadence.",
    ],
    tags: [
      'Static social', 'Carousel', 'Short-form video', 'UGC and creator-style',
      'AI talent', 'Pinterest', 'LinkedIn', 'Always-on refresh', 'Hook design',
      'Sound-on impact',
    ],
  },
  {
    label: 'Cross-border into China',
    heading: 'Douyin and Xiaohongshu, ran in-platform.',
    image: '/Images/ac-sample-soren.jpg',
    alt: 'A smartphone propped on a plaster ledge showing a clean static ad for a skincare brand, an example of cross-border creative.',
    lead: "Seeding notes that read as reviews. Short-drama product integration. The warm-up plus livestream structure that's standard practice in Greater China.",
    body: [
      "Brands launching or relaunching in mainland China need creative built for those platforms, not Meta ads cross-posted with Mandarin captions. Tone, pacing, hook design and disclosure conventions all sit differently.",
      "Our production team is based in Shanghai, which is where the in-platform fluency lives. We ship Xiaohongshu seeding notes, short-drama product integration, KOL casting briefs, and the warm-up plus livestream structure that brands use to launch a category.",
    ],
    tags: [
      'Xiaohongshu seeding', 'Short-drama integration', 'Livestream warm-up',
      'KOL casting briefs', 'Douyin native video', 'Bilibili content',
      'WeChat creative', 'Local talent', 'Regulatory copy', 'Mandarin hook copy',
    ],
  },
];

/* Quality signals for the craft section, replacing the source page's
   factory-audit credential row. */
const credentials = ['Concept territories', 'Entity-distinct', 'Hook-rate testing', 'Brand-safety review'];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   own "art directors leading every concept territory" line sets the
   tier for steps one and two. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and channel strategy.',
    body: 'Audience, offer, hook hypothesis, channel mix, KPI targets. Locked before a frame is built.',
    image: '/Images/ac-p1-brief.jpg',
    alt: 'An open notebook with hand-drawn audience-funnel diagrams beside two smartphones showing competitor ad screenshots.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Concept territories. The step that matters most.',
    body: 'Senior art directors set three to five concept territories per campaign, each carrying a hypothesis about audience, hook and offer. This is the lever the algorithm rewards.',
    image: '/Images/ac-p2-direction.jpg',
    alt: 'An art director arranging printed ad-creative storyboard cards into a single concept territory on a plaster wall.',
  },
  {
    short: 'Variant build',
    tier: 'The rest is execution',
    title: 'Variants engineered to be entity-distinct.',
    body: 'Fifteen to thirty executions per territory, each with a structurally distinct fingerprint so the algorithm reads it as its own ticket into retrieval.',
    image: '/Images/ac-p3-aigc.jpg',
    alt: 'A laptop screen showing a dense grid of generated ad-creative variants, the same model in many subtle styling variations.',
  },
  {
    short: 'Platform delivery',
    tier: 'The rest is execution',
    title: 'Platform-native delivery.',
    body: 'Statics, vertical video, UGC and creator-style cuts, sized and finished for Meta, TikTok, Reels, Shorts, Douyin and Xiaohongshu.',
    image: '/Images/ac-p4-launch.jpg',
    alt: 'Two smartphones on a deep navy desk showing a social-ads launch interface and a short-form-video upload screen.',
  },
  {
    short: 'Always-on refresh',
    tier: 'The rest is execution',
    title: 'Always-on testing and refresh.',
    body: 'Weekly or biweekly drops against a running test plan. Territories that hold get extended. Territories that break get retired and replaced from the brief.',
    image: '/Images/ac-p5-adapt.jpg',
    alt: 'A performance dashboard on a monitor beside a smartphone showing the next batch of three fresh ad creatives queued for launch.',
  },
];

/* The process splits into two tiers: the steps where the project is won, and
   the steps that are execution. */
const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* The old agency cycle named in the source's opening anecdote: four weeks
   for nine new concepts, quoted by an incumbent agency. */
const oldPhases = [
  { label: 'Brief', dur: 'One week', span: 1 },
  { label: 'Concepts', dur: 'Two weeks', span: 2 },
  { label: 'Production', dur: 'One week', span: 1 },
];

/* FAQ: wording adapted from the source. The pricing answer drops the dollar
   amounts to comply with the no-pricing-on-site rule. */
const faqs = [
  {
    q: 'How fast can you turn around a first batch?',
    a: "48 to 72 hours for first concept territories on a rush brief. Five to seven business days for a full launch batch on a standard brief, including statics, video cuts and platform-native variants. Always-on clients run on a weekly or biweekly drop schedule agreed in the retainer.",
  },
  {
    q: 'How do you measure whether the creative is working?',
    a: "We track at the territory level, not the variant level, because that's how the algorithm sees it. Hook rate and 6-second view rate on video. Thumb-stop and CTR on static. Then CPA and ROAS by territory once spend matures. A territory that holds CPA for two weeks gets extended. A territory that breaks gets retired and replaced from the brief. We don't promise specific performance numbers up front, the variables outside our control (offer, audience, landing page, attribution model) move them too much. We do promise the production cadence, the entity-distinct discipline, and the testing matrix.",
  },
  {
    q: 'What does a project actually cost?',
    a: "Project-based for one-off campaigns. Monthly retainer for always-on testing programs, billed quarterly in advance for retainer clients. The quote depends on channel mix, concept territory count and refresh cadence, which we lock after the first call. We share the full pricing once we understand the brief, because anything we quote before that is either too high or too low for the actual work.",
  },
  {
    q: 'How many concepts and variants do I get?',
    a: "Depends on the media spend level and the channel mix. A typical launch batch for a Meta-led campaign is three to five concept territories, with 20 to 40 statics and 6 to 12 video cuts per territory in the first drop. Always-on retainers usually ship dozens of entity-distinct creatives per month against a running test plan. We size the volume to what the algorithm is asking for at your spend level, not to a fixed package.",
  },
  {
    q: 'What do I need to send to get started?',
    a: "Brand guidelines if you have them. Product imagery, current best-performing ads, current losing ads, audience and offer notes, channel mix, media spend level, KPI targets. Access to your ad accounts if you want us to look at fatigue data directly. If brand guidelines don't exist, we build a working visual system in the first sprint and hand it over.",
  },
  {
    q: 'Who actually does the work?',
    a: "Art directors from agency backgrounds (think Publicis, Ogilvy, WPP) lead every concept territory. AI specialists handle production volume. Performance creative leads run the testing matrix. No junior teams running the brief alone. The creative direction layer is the single thing we won't compromise on, because it's where the AI slop risk lives.",
  },
  {
    q: 'Will the work look like us, or like AI?',
    a: "Like you. We train our models on your existing brand assets, much in the spirit of Coca-Cola's StyleID approach, so the output sits inside your visual system rather than the model's default look. For brands without a documented system, we build one in the first sprint and hand it over. Avoiding the trust penalty is the single most important judgment call on every project, and it sits with the art director, not the model.",
  },
  {
    q: 'What about brand safety and AI disclosure?',
    a: "Every batch passes a brand-safety review before delivery, covering on-brand consistency, factual claims if any, and platform compliance. Where talent likeness is involved we secure rights documentation. We use commercially safe generation models and keep the workflow logged, so if an AI disclosure is required (the IAB's January 2026 framework is voluntary but increasingly expected on regulated channels) we can supply the metadata.",
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: "You own the final deliverables. We use commercially safe models and document the workflow. For the legal side in full, see our Copyright and AI guide.",
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle multi-market and multi-language?',
    a: "Yes. Talent sourcing in the markets you sell into, voice-over and subtitle localization, regulatory copy variants by market, currency and offer logic. We've shipped campaigns across the US, EU, UK, Middle East, APAC and Greater China. Cross-border into Douyin and Xiaohongshu is a lane we run regularly for brands launching or relaunching in mainland China.",
  },
  {
    q: 'Do you do TikTok and Reels-native work, or just adapted Meta ads?',
    a: "Native. Vertical first, sound-on hook design, creator-coded scripts, the cadence the platform actually rewards. We benchmark hook rate and 6-second view rate against TikTok Creative Center category norms before a batch ships, and design each hook to clear the 30 percent hook rate floor. Cross-posting Meta ads to TikTok is a known way to underperform.",
  },
  {
    q: 'Where are you based, and can you deliver in our time zone?',
    a: "Our production team is based in Shanghai with creative direction distributed across Europe and Asia. Most clients run on a 24-hour build cycle with that setup. Brief at end of day, first output at start of next day in their time zone. For Greater China work this is also where the in-platform fluency lives.",
  },
  {
    q: 'What if we already have a creative agency we like?',
    a: "Fine. Many of our clients keep a brand agency for tentpole work and use us for the always-on performance creative the brand agency isn't built to staff at volume. We deliver into your naming convention and step back from the brand-strategy lane.",
  },
  {
    q: 'What happens to revisions or rejected concepts?',
    a: "Two rounds of revisions are included in the standard concept quote. Beyond that we quote hourly, but it's rare. Inside the always-on retainer, revisions roll into the next cycle since the workflow is iterative by design. Rejected concepts stay yours, and we keep the source files on our side for 12 months in case you want to revive a direction later.",
  },
  {
    q: 'Can we start small to see if it works?',
    a: "Yes. Send us one campaign brief. Inside one week you get a first concept batch and a refresh-cycle estimate sized to your media plan. No retainer, no commitment, the work is yours either way.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Ad Creative Services | AI-Native Studio | hubStudio"
  description="Performance ad creative built for Andromeda and Symphony. Statics, video, UGC, platform-native, sized to Meta, TikTok, Reels, Douyin and Xiaohongshu. Art directors leading."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Ad Creative
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Performance</span></span>
            <span class="line"><span class="line__i serif">creative,</span></span>
            <span class="line"><span class="line__i">tested.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            At the speed the new <em>algorithms</em> demand.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              A growth lead at a beauty brand called us in February. Her Meta
              CPA had doubled in nine days, and the four creatives she had
              launched the quarter on were burned.
            </p>
            <p>
              Her incumbent agency had quoted four weeks for nine new concepts.
              We had three concept territories in her inbox inside 48 hours.
              Under Andromeda and Symphony, that is the cycle the platforms
              now reward.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Art-directed at volume
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/ac-hero.jpg"
          alt="Overhead view of a hubStudio creative workspace: a phone showing a paused vertical-video ad, three printed storyboard cards and a graphite pencil on warm plaster."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Concept board</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Two platform shifts.<br /><span class="serif">One math</span> problem.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Meta's Andromeda retrieval system, rolled out by late 2025,
              enabled what Meta's engineering team described as a 10,000-fold
              increase in retrieval model complexity. The algorithm reads
              visuals, copy, emotional signals and offer type at the content
              level, then decides which audience to serve each creative to
              before the auction runs.
            </p>
            <p class="r" style="--d:.16s">
              Targeting, the way agencies used to build it, has stopped being
              the lever. The creative is. TikTok's Symphony stack added a
              second pressure wave: the platform recommends 10 to 15
              conceptually distinct assets per campaign as a floor.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Brands shipped this year include <strong>HiSense</strong>,
              <strong>Camper</strong> and <strong>Shiseido</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/ac-roots.jpg"
              alt="A young woman at a sunlit cafe table holding a phone showing a paused vertical-video beauty ad."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The half-second test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Brands testing 20 or more entity-distinct ads per month see
            significantly higher ROAS than brands testing under 10. One ad set
            holding 25 creatives outperforms five ad sets of five.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">creative direction</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">creative</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Static frames and short-form hook frames from recent ad-creative
            batches, photographed in the studio. Each is authored work, not
            a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · CRAFT ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/ac-craft.jpg"
                alt="An art director leaning over a long worktable of printed ad-creative variants, post-its and a laptop in a Shanghai design studio."
                width="1024"
                height="768"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/ac-craft-inset.jpg"
              alt="A hand pinning a small printed storyboard card to a fabric pinboard beside other ad concept cards."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">48&ndash;72 hrs</span>
            <span class="source__stat-cap">Brief to first concept territories</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The craft</p>
          <h2 class="dh r" style="--d:.05s">
            Direction is the lever.<br />Production is the <span class="serif">wheel</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            A model renders 500 product shots overnight. Knowing which 30 are
            worth running, why the rest will tank, and how the next batch
            should be different, is what art directors do. It is what we hire
            for.
          </p>
          <p class="source__p r" style="--d:.16s">
            We map the testing matrix before production starts. Three to five
            concept territories per campaign, each carrying a hypothesis about
            audience, hook and offer. Each ladders into 15 to 30 variants that
            share the hypothesis but vary on execution.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Algorithms see ads at a granularity human producers used to ignore.
            Two creatives that look different to a designer can land in the
            same Entity ID cluster and compete as one ad. Variants ship with
            structurally distinct fingerprints, so each one earns its own
            ticket into retrieval.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already keep a brand agency for tentpole work, no problem.
            We handle the always-on lane and step back from the brand-strategy
            seat.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative is where<br />it is <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Most studios sell process. We sell the creative call. AI made the
          technical side cheap and fast for everyone. It did not replace the
          eye that picks which hypothesis is worth scaling, and which one will
          fatigue inside a week.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">refresh</span> cycle.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A beauty brand calls in February. Meta CPA has doubled in nine
            days, the quarter's four creatives are burned. The same brief,
            quoted two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The agency quote</span>
              <span class="vs__total">Four weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                The incumbent quote: one week of brief and strategy, two weeks
                of concept development, one week of production. Four weeks to
                nine creatives. By the time they ship, the burn has moved on
                and the test plan is already stale.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our cycle</span>
              <span class="vs__total vs__total--new">48 hours</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">First concept territories</span>
                  <span class="vs__seg-dur">48 to 72 hours</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our cycle: first concept territories in the inbox inside 48
                hours. Dozens of entity-distinct variants per territory in the
                first drop. Photoreal mockups before a creator is booked.
                Refresh ships weekly, not quarterly.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            Fourteen questions brands ask before we start. If yours is not
            here, put it in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a<br />real <span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us one campaign brief. Inside a week you get a first concept
          batch and a refresh-cycle estimate sized to your media plan. No
          retainer, no commitment. Whatever we produce is yours to keep, even
          if you walk.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
