---
/**
 * Video Production  ·  /services/design/video-production
 *
 * Mirrors the "Pressroom" art direction of /services/design/packaging-merch-design.
 * Same primitives (crop marks, calibration colour bar, mono figure labels,
 * dashed dieline rules) used here as a film-production proof sheet rather
 * than a packaging proof. Print-shop language becomes set-and-screen
 * language: contact sheet, slate, timeline.
 *
 * Copy from video-production-page.md. Process step numerals dropped per the
 * project's permanent "no numbers in cards / step lists" rule. All imagery
 * sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio sample frames, each with an invented brand mark. */
const samples = [
  {
    src: '/Images/video-production-halcyra.jpg',
    brand: 'Halcyra',
    kind: 'Beauty hero film',
    alt: 'A close studio frame of a serum dropper releasing a golden bead, lit by one soft window source.',
  },
  {
    src: '/Images/video-production-marenne.jpg',
    brand: 'Marenne',
    kind: 'Fashion editorial',
    alt: 'A still of a model in a linen coat walking through a sunlit corridor, motion-blurred at the hips.',
  },
  {
    src: '/Images/video-production-solven.jpg',
    brand: 'Solven',
    kind: 'Footwear lifestyle',
    alt: 'A low-angle film still of a leather sneaker stepping onto a wet cobblestone street at dusk.',
  },
  {
    src: '/Images/video-production-orenza.jpg',
    brand: 'Orenza',
    kind: 'Spirits cinematic pour',
    alt: 'A cinematic macro of amber gin pouring over a single ice cube in a thick crystal tumbler.',
  },
  {
    src: '/Images/video-production-tervane.jpg',
    brand: 'Tervane',
    kind: 'Electronics demo',
    alt: 'A clean tabletop frame of a matte-black speaker on warm concrete, hand entering to press play.',
  },
  {
    src: '/Images/video-production-vellan.jpg',
    brand: 'Vellan',
    kind: 'Automotive campaign',
    alt: 'A low golden-hour still of a charcoal SUV on a coastal road, dust trailing behind the rear wheel.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-project results, adapted to video production economics. */
const stats = [
  { from: 0, to: 48, suffix: 'h', label: 'Brief to first cut', note: 'On short-form social and AIGC' },
  { from: 0, to: 40, suffix: '+', label: 'Languages with lip-sync', note: 'From one filmed master' },
  { from: 0, to: 60, suffix: '%', label: 'Lower cost-per-variation', note: 'Hybrid versus traditional reshoot' },
];

/* The three production modes. Tag rows surface phrases named in the prose. */
const coverage = [
  {
    fig: 'B',
    label: 'Studio',
    heading: 'Studio shooting.',
    image: '/Images/vp-studio.jpg',
    alt: 'A controlled beauty set: model on a sand backdrop under one large softbox, DOP framing on a cinema camera.',
    lead: 'The studio, the crew, and the room that knows your product.',
    body: [
      'A controlled studio is still the right answer for a big share of brand work. Beauty textures, fashion editorial, packshots, food and drink, dialogue spots, product hero films all do better on a fixed set with calibrated light and a crew that knows the room.',
      'In-house, end to end: director, DOP, gaffer and lighting, key grip, art director, stylist, prop master, hair and makeup, on-set DIT, editor and retoucher. Current-generation cinema cameras, full grip and lighting package, motion-control rig for product turntables. Same team storyboards, shoots and edits. No handoff, no quality drift.',
    ],
    tags: [
      'Product hero films', 'Packshots & 360 turntables', 'Beauty & skincare textures',
      'Macro & slow-motion', 'Fashion on talent', 'Food & beverage', 'Short-form social ads',
      'eCommerce demos', 'Spokesperson content', 'Voice-over & ADR',
    ],
  },
  {
    fig: 'C',
    label: 'Location',
    heading: 'Location shooting.',
    image: '/Images/vp-location.jpg',
    alt: 'A film crew on a coastal road at first light: camera on a dolly, gaffer setting a negative fill, talent waiting.',
    lead: 'Real places, real talent, real stories. We scout, we permit, we crew, we ship the masters.',
    body: [
      'When context is the message, no studio set replaces a real location. Travel and hospitality, automotive, large-format consumer goods, documentary, lifestyle, culture stories. The team handles the full chain: scouting, permits, casting, talent contracts, fixers and local crew, transport and logistics, insurance, weather backup plans, customs paperwork.',
      "We've shot across mainland China, Hong Kong, Southeast Asia, Europe and the Middle East. Our fixer network means we land in a market with people who already know the city, the rules and where the best light falls at five in the afternoon. Director and DOP fly with the production. Treatment and shot list locked before wheels up.",
    ],
    tags: [
      'Brand films & TVC', 'Travel & hospitality', 'Automotive', 'Large-format product',
      'Documentary & testimonial', 'Lifestyle & culture', 'Fashion editorial',
      'UGC with real talent', 'Multi-market shoots', 'Fixer network',
    ],
  },
  {
    fig: 'D',
    label: 'AIGC',
    heading: 'AIGC video production.',
    image: '/Images/vp-aigc.jpg',
    alt: 'A colourist at a multi-monitor workstation reviewing a grid of AI-generated video frames in a darkened suite.',
    lead: 'When the shot is impossible, the volume is too high, or the deadline is yesterday.',
    body: [
      "AIGC video has flipped the economics of brand production over the last eighteen months. Impossible environments. Brand ambassadors placed in cities they've never visited. Fifty-market localization with lip-sync in every language. Fifteen creative concepts A/B tested in a single week. Seasonal reshoots in days.",
      "Model-agnostic by design. Veo 3.1 for native 48kHz audio and cinematic brand work, Kling 3.0 for high-motion sequences and the longest extendable output window, Seedance 2.0 for phoneme-level lip-sync across eight-plus languages, Runway Gen-4.5 for granular camera control, Wan 2.6 and Hunyuan for open-source fine-tuning on private infrastructure, Hailuo and Pika for expressive social motion at speed. ComfyUI for LoRA training and structural guidance. The model choice is a creative decision per shot, not a vendor lock-in.",
    ],
    tags: [
      'TikTok, Reels & Shorts', 'Impossible environments', 'Multi-market lip-sync',
      'Long-to-short cutdowns', 'Talking-head & UGC', 'Synthetic talent',
      'Custom LoRA training', 'Seasonal variants', 'A/B creative testing', 'Platform reformatting',
    ],
  },
];

/* Brand-safety credentials, named in the data-sovereignty FAQ. */
const credentials = ['Private GPU infra', 'NDA & DPA', 'EU AI Act', 'Data sovereignty'];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   "the work is won in the first two steps" sets each step's tier. */
const processSteps = [
  {
    short: 'Discovery',
    tier: 'Where it is won',
    title: 'Discovery and brief.',
    body: 'One working session to lock the goal, audience, channels, brand truth and no-go zones. Output is a one-page strategic brief.',
    image: '/Images/vp-p1-discovery.jpg',
    alt: 'A creative director and a brand lead at a studio table covered in reference tear-sheets and a one-page brief.',
  },
  {
    short: 'Treatment',
    tier: 'Where it is won',
    title: 'Treatment and shooting board. The step that matters most.',
    body: 'Visual references locked, tone defined, shot list drafted, AIGC model selection made, talent and location options proposed. This is where a campaign becomes ownable.',
    image: '/Images/vp-p2-treatment.jpg',
    alt: 'A storyboard wall with frame-by-frame sketches, fabric swatches and a printed shot list pinned in sequence.',
  },
  {
    short: 'Pre-production',
    tier: 'The rest is execution',
    title: 'Pre-production.',
    body: 'Casting, scouting, custom LoRA training if AIGC is in scope, prop and set planning, scripting, legal clearances, permits, technical pre-light.',
    image: '/Images/vp-p3-prep.jpg',
    alt: 'A producer reviewing casting tapes on a laptop beside a callsheet, taped location stills and a permit folder.',
  },
  {
    short: 'Production',
    tier: 'The rest is execution',
    title: 'Production. Shoot day or AIGC sprint.',
    body: 'Director on set or directing the pipeline. Live colour reference, live client review, same-day rushes.',
    image: '/Images/vp-p4-production.jpg',
    alt: 'A director watching the live monitor on a film set, DOP behind the cinema camera, gaffer adjusting a flag.',
  },
  {
    short: 'Post & delivery',
    tier: 'The rest is execution',
    title: 'Post-production and delivery.',
    body: 'Edit, colour grade, sound design, music, voice-over, motion graphics, subtitles, multi-language adaptation, platform reformatting. Every format the campaign needs.',
    image: '/Images/vp-p5-post.jpg',
    alt: 'A colourist at a calibrated grading suite with a film frame on the main reference monitor and waveform scopes.',
  },
];

/* The process splits into two tiers: the steps where the project is won, and
   the steps that are execution. Each renders in its own block below. */
const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* The old multi-market shoot timeline, split into the phases the copy names. */
const oldPhases = [
  { label: 'Scout & permit', dur: 'Three weeks', span: 3 },
  { label: 'Shoot per market', dur: 'Six weeks', span: 6 },
  { label: 'Post & deliver', dur: 'Three weeks', span: 3 },
];

/* FAQ: wording adapted from the source; one answer links to the Copyright guide. */
const faqs = [
  {
    q: 'When should we shoot live versus generate with AIGC?',
    a: "Depends on the brief. Live shooting wins when the work needs real talent emotion, complex physical product interaction, documentary authenticity, or hero-tier brand storytelling where every frame is judged at broadcast standard. AIGC wins when the brief calls for impossible environments, multi-market scale, A/B creative testing at volume, or any production where cost-per-variation needs to approach zero. We have no bias either way: the studio earns the same margin on a live shoot day as on an AIGC sprint, which is why our recommendation stays honest.",
  },
  {
    q: 'Do you actually have a studio and a crew, or is hubStudio just an AI service in disguise?',
    a: 'Both, by design. Creative directors, art directors, DOPs, gaffers and lighting techs, key grips, stylists, prop masters, hair and makeup, retouchers, editors, colorists, sound designers, motion designers and AIGC engineers. We own the studio space, the camera and lighting package, the post-production suite and the GPU infrastructure that runs the AI pipeline. AIGC sits on top of a working production company, not in place of one.',
  },
  {
    q: 'Which AI video models are you actually using in 2026?',
    a: 'Google Veo 3.1 for native audio cinematic work and true 4K, Kuaishou Kling 3.0 for high-motion sequences and the longest extendable output window, ByteDance Seedance 2.0 for unified audio-video and phoneme-level lip-sync across multiple languages, Runway Gen-4.5 for granular camera control and reference-driven character consistency, Alibaba Wan 2.6 and Tencent Hunyuan for open-source fine-tuning on private infrastructure, MiniMax Hailuo and Pika for expressive social motion, ComfyUI for custom workflow design and LoRA training. Model selection is a creative call per shot.',
  },
  {
    q: 'How fast can you actually deliver?',
    a: 'Simple social cuts and AIGC spots, 24 to 72 hours from brief to first cut. Studio shoots, one to two weeks from brief to delivery on standard scope, including pre-production, shoot day and post. Location productions, two to four weeks including travel, scouting and post. Multi-language variations on an existing master, days rather than weeks once the hero version is signed off.',
  },
  {
    q: 'Can you handle long-form, TVC and hero brand films?',
    a: 'Yes. Long video origination is part of our scope. Narrative brand films, product launch hero spots, multi-market campaign cascades, documentary-style brand content and TVC-style 30 and 60 second commercials. The work is briefed shot by shot, priced against the storyboard and produced with the same creative discipline as feature commercial work.',
  },
  {
    q: 'How does multi-language and lip-sync adaptation work?',
    a: 'One of the strongest reasons clients move to a hybrid partner. We adapt an existing master into 40-plus language variations with frame-accurate lip-sync, native-quality voice-over and culturally adapted scripts. The current generation of audio-video models has effectively solved the phoneme-level sync problem that broke earlier AI lip-sync attempts. One shoot, every market, a fraction of the cost of reshooting per region.',
  },
  {
    q: 'How do you protect brand data, IP and the assets we share with you?',
    a: 'Everything runs on private infrastructure. Product shots, scripts, brand references, custom-trained LoRA models and master files stay on dedicated servers in your chosen geography, with hosting available in mainland China, Hong Kong, the EU or the US depending on your data sovereignty position. We do not use public consumer AI platforms for client work. Prompts are not stored on third-party servers. NDA and DPA are standard.',
  },
  {
    q: 'Who owns the final video and the AIGC training data?',
    a: 'You own all finished assets, all masters, all rushes from live shoots, and any LoRA or fine-tuned model trained on your IP. Commercial use rights for AIGC outputs are governed by the underlying model used for the shot, and we route client work exclusively through enterprise tiers that grant commercial use. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'What happens if we hate the first cut?',
    a: 'Revisions are part of the deal. Every project includes a defined number of revision rounds at the briefing stage, and we run a client review at every milestone so surprises are caught early. If the first cut misses the brief, we redo it. If the brief itself shifted mid-project, we scope the additional work transparently before a single billable hour is added.',
  },
  {
    q: 'Can you white-label this for an agency?',
    a: 'Yes. We run a significant share of our work under agency brands, with full white-label delivery, agency-grade communication and confidential collaboration. The end client never knows we exist. The agency owns the relationship, the creative strategy and the client communication. We deliver the production capability behind it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Brand Video Production: Studio, Location & AIGC"
  description="Brand video production at scale. Studio shoots, location shoots and AIGC video under one roof. Real crew, real cameras, AI speed."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Video Production
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Brand Video</span></span>
            <span class="line"><span class="line__i serif">Production.</span></span>
            <span class="line"><span class="line__i">Three Modes.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Studio. Location. AIGC. <em>One creative direction.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most studios sell you one model dressed up as a methodology. We
              run three. The brief picks which one fits.
            </p>
            <p>
              A beauty hero needs a controlled set. A travel campaign needs
              scouts and fixers. A fifty-market rollout needs an AIGC pipeline.
              Brands almost never need just one. We deliver all three without
              dropping a frame.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Send the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Hong Kong + Shanghai <span>/</span> Live + AIGC under one director
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/vp-hero.jpg"
          alt="A DOP behind a cinema camera on a darkened studio set, warm rim light catching the camera body."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Halcyra</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              Why our production<br /><span class="serif">roots</span> matter.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              A viewer scrolls a Reels feed at the bus stop. Two seconds per
              spot, audio off, thumb already moving. The opening frame carries
              the whole sale.
            </p>
            <p class="r" style="--d:.16s">
              That's the market our crew came up in. A working production
              company in Hong Kong, a second team in Shanghai, fixers across
              mainland China, Southeast Asia, Europe and the Middle East. We
              ship video that holds up on a vertical phone, a connected TV and
              a cinema screen.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Recent campaigns include work for <strong>Shiseido</strong>,
              <strong>Camper</strong>, <strong>HiSense</strong>,
              <strong>age20</strong> and <strong>Mexicash</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/vp-roots.jpg"
              alt="A wide editorial shot of a director and a colourist reviewing dailies on twin reference monitors in a darkened post suite."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The two-second test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            One filmed master, forty-plus markets with frame-accurate lip-sync,
            cost-per-variation cut by 60%, brief to first cut inside 48 hours
            on short-form work.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Three lanes, one <span class="serif">creative direction</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label} mode</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">frames</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Film and AIGC stills, captured and finished in the studio. Every
            frame is authored work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · HYBRID PRODUCTION ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/vp-hybrid-main.jpg"
                alt="A producer compositing a filmed product hero onto a generated city skyline on a wide reference monitor."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/vp-hybrid-inset.jpg"
              alt="A close-up of an editor's hands adjusting a colour-grading panel on a console."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1 shoot</span>
            <span class="source__stat-cap">Every market, every season, every cut</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Hybrid production</p>
          <h2 class="dh r" style="--d:.05s">
            SIRL plus <span class="serif">AIGC</span>.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            The strongest campaigns we ship in 2026 are rarely pure single-mode.
            They live in the hybrid zone, where live shooting captures what
            only a camera can capture and AIGC multiplies it across markets,
            formats and seasons.
          </p>
          <p class="source__p r" style="--d:.16s">
            Shoot the product hero in studio, then drop it into AIGC
            environments across a dozen markets. Film the brand ambassador once
            on location, then generate every regional variation, every seasonal
            reshoot, every platform cutdown without booking the talent again.
            The shoot day stays small. The output multiplies. The budget mostly
            does not have to.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Everything runs on private infrastructure with hosting in mainland
            China, Hong Kong, the EU or the US depending on your data
            sovereignty position. Custom-trained LoRA models stay your
            property and can be exported if you ever leave.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you only need one mode, that's also fine. We pick up where you
            need us and step back where you don't.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>How a project runs</p>
        <h2 class="dh r" style="--d:.05s">
          Same discipline,<br />every <span class="serif">mode</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Studio, location, AIGC and hybrid all follow the same process. The
          mode changes; the discipline stays the same. The work is won in the
          treatment, not on the shoot day.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with a single hero film and 40 market variants for a
            Q3 launch. The same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Twelve weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: scout each region, permit, fly the crew, shoot
                per market, post in series. Twelve weeks for the launch wave,
                then start again every time a market needs a refresh.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Days, not weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Hero shoot</span>
                  <span class="vs__seg-dur">One week</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: one hero shoot on the set or location that
                matters most. AIGC carries the 40 variants, lip-sync per
                language, platform cutdowns and seasonal reshoots. Brief to
                first cut in 48 hours on short-form, days on the full cascade.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Campaign to <span class="serif">cascade</span>.
            </h3>
            <p class="hub__text">
              For brands running constant video output, we deploy hub4You, our
              custom AI agent setup trained on your brand DNA, your sonic
              identity and your approved talent. It generates on-brand video
              variants on demand and routes them directly into your DAM, MAM
              and platform schedulers, so the cascade lands where your team
              already works.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4fashion.jpg"
                alt="The hub4You platform generating on-brand product visuals from a model and a background."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put it
            in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Send the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Send the brief.<br />Back in <span class="serif">48 hours</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          A production-mode recommendation, a scope outline, an indicative
          timeline, and a few free visuals or storyboard frames so you can see
          the thinking before any budget commits. No deck, no long sales pitch,
          just a working proposal.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Send the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
