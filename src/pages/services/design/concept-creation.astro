---
/**
 * Concept Creation  ·  /services/design/concept-creation
 *
 * Mirrors /services/design/packaging-merch-design and the rest of the
 * design-service set: same "Pressroom" art direction (crop marks,
 * calibration colour bar, mono figure labels) adapted for campaign concept
 * work. Copy from concept-creation-page.md, folded into the nine-section
 * layout. Process step numerals dropped per the no-numbers rule. The
 * sourcing slot from the packaging template is repurposed here as the
 * AI-sameness section, with the same navy / image / stat composition.
 *
 * Imagery lives in /public/Images with the cc- prefix.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Six invented sample briefs, one per category named in the source
   studio-samples list. Real client names stay withheld per the source. */
const samples = [
  {
    src: '/Images/cc-sample-marenne.jpg',
    brand: 'Marenne',
    kind: 'FMCG relaunch platform',
    alt: 'A printed Marenne campaign key visual leaned against a sand plaster wall, tight profile portrait with the wordmark set in a modern serif.',
  },
  {
    src: '/Images/cc-sample-halcyra.jpg',
    brand: 'Halcyra',
    kind: 'Luxury fragrance world',
    alt: 'A printed Halcyra fragrance campaign visual against a burgundy lacquered wall, close-up of a frosted glass bottle held in shadow.',
  },
  {
    src: '/Images/cc-sample-tervane.jpg',
    brand: 'Tervane',
    kind: 'Consumer tech product story',
    alt: 'A printed Tervane consumer tech campaign visual against pale concrete, single matte-black device on sand surface with the wordmark in modern sans.',
  },
  {
    src: '/Images/cc-sample-belisse.jpg',
    brand: 'Belisse',
    kind: 'Beauty seasonal territory',
    alt: 'A printed Belisse beauty seasonal campaign visual against a peach plaster wall, three-quarter portrait with negative space for the wordmark.',
  },
  {
    src: '/Images/cc-sample-solven.jpg',
    brand: 'Solven',
    kind: 'Beverage cross-market platform',
    alt: 'A printed Solven beverage campaign visual against chalky daylight, two bottles of pale herbal drink on a sand-toned table.',
  },
  {
    src: '/Images/cc-sample-orenza.jpg',
    brand: 'Orenza',
    kind: 'Fashion capsule narrative',
    alt: 'A printed Orenza fashion lookbook visual against a warm grey wall, full-length editorial of a model in a structured wool coat.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Results stats, from the source's 60-engagement Jan 2024 to Mar 2026
   cohort. Page reads each averaged against prior agency engagements on
   similar briefs. */
const stats = [
  { from: 0, to: 3, suffix: 'x', label: 'Creative routes per brief', note: 'Explored, not just sketched' },
  { from: 0, to: 70, suffix: '%', label: 'Less time to direction', note: 'Brief to approved route' },
  { from: 0, to: 5, suffix: ' days', label: 'To first visualized round', note: 'Photoreal, in context' },
];

/* Two coverage lanes. The five lanes in the source (territories, key
   visuals, mood films, tone of voice, campaign architecture) group into
   the creative call (territories + tone + architecture) and the
   visualization layer that proves the call (key visuals + mood films).
   Keeping the two-feature layout means the lanes have to group, not list. */
const coverage = [
  {
    fig: 'B',
    label: 'Creative direction',
    heading: 'Territory, voice and architecture.',
    image: '/Images/cc-cover-direction.jpg',
    alt: 'A studio worktable with three printed creative-territory cards pinned above it, tear-sheets and a key-visual mockup leaned to the right.',
    body: [
      "A concept is not a tagline on a slide. It is a creative platform a brand can live inside for two years, across forty assets and six markets. We open with three to five distinct creative territories, each grounded in a real consumer insight, with a proposition, positioning rationale and architecture for how the route travels.",
      'Tone of voice and copy direction sit alongside the territory. Headline territory, body voice, verbal system. Sample copy is written to prove the system holds before anyone starts production. Campaign architecture covers how the idea flexes from a 6-sheet to a 6-second TikTok, from a 200-page lookbook to a product page.',
    ],
    tags: [
      'Creative territories', 'Consumer insight', 'Proposition',
      'Tone of voice', 'Verbal system', 'Sample copy', 'Headline bank',
      'Campaign architecture', 'Hub and spoke', 'Multi-market',
    ],
  },
  {
    fig: 'C',
    label: 'Visualization',
    heading: 'Key visuals and mood films, in week one.',
    image: '/Images/cc-cover-visualization.jpg',
    alt: 'A monitor on a worktable showing a single photoreal hero key visual mid-review, beside printed references and color-graded test prints.',
    lead: 'Visualization moved to week one. By the time the deck lands in the boardroom, routes look like routes, not bullet points.',
    body: [
      'For each surviving route, we generate hero visuals at final composition. Photoreal, in market context, occasionally in a couple of executions. You see the concept the way a consumer would, not as a stock-photo placeholder under a tagline.',
      'Mood films sit beside the key visuals: twenty to forty second cuts built from AI-generated footage, with pacing, music, edit rhythm. Clients use them to pre-test internally before a production day is booked.',
    ],
    tags: [
      'Photoreal key visuals', 'In-market context', 'Hero film mockups',
      'Mood films', 'Pre-test internally', 'Production-ready references',
      'Brand-trained models', 'Final composition', 'Multiple executions',
    ],
  },
];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   own "judgment is the bottleneck" sets the tier for each step. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and brand immersion.',
    body: 'Business problem, audience, competitive landscape, brand codes.',
    image: '/Images/cc-p1-brief.jpg',
    alt: 'A studio worktable with a printed brief document, a competitive landscape map, a notebook open to audience notes, color chips and a coffee cup.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction. The step that matters most.',
    body: 'Senior creatives set the territory and the structural concept. This is where a campaign becomes ownable and where a route earns the right to scale.',
    image: '/Images/cc-p2-direction.jpg',
    alt: 'A senior creative director pinning a printed territory card onto a corkboard already showing three other territory cards.',
  },
  {
    short: 'AIGC exploration',
    tier: 'The rest is execution',
    title: 'AIGC exploration.',
    body: 'Dozens of visual directions per route in parallel, faster than traditional sketching and closer to the final asset.',
    image: '/Images/cc-p3-aigc.jpg',
    alt: 'A monitor showing a grid of twelve AI-explored variations of the same campaign key visual, beside a printed reference pack and test prints.',
  },
  {
    short: 'Refinement',
    tier: 'The rest is execution',
    title: 'Refinement and presentation.',
    body: 'The winning route sharpened into a presentable platform: hero visuals, mood film, copy system, architecture.',
    image: '/Images/cc-p4-refine.jpg',
    alt: 'A creative director annotating a printed key visual with a graphite pencil, the print on a warm oak worktable beside a feedback sheet.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation across markets.',
    body: 'Local executions of the hub idea: language, cultural references, market-specific extensions, channel cut-downs.',
    image: '/Images/cc-p5-adapt.jpg',
    alt: 'A worktable laid out with the same key visual adapted into seven market variants, different headlines and languages, central image consistent.',
  },
];

/* The old agency timeline, split into the phases the source case
   describes (three agencies briefed in January, deck in April). */
const oldPhases = [
  { label: 'Concepts', dur: 'Six weeks', span: 6 },
  { label: 'Adaptations', dur: 'Two weeks', span: 2 },
  { label: 'Production files', dur: 'Two weeks', span: 2 },
];

/* FAQ: wording adapted from the source. One answer links to the
   Copyright guide. */
const faqs = [
  {
    q: 'How long does a concept project take?',
    a: "One to two weeks for first round. Three to four weeks total from brief to approved concept and architecture. Faster on a route extension. Tight launch window, we compress to ten days for a single-territory focused brief.",
  },
  {
    q: 'How is the work scoped?',
    a: "Project-based for one-off concepts. Monthly retainer for clients running multiple campaigns a quarter. We scope firm after the first call.",
  },
  {
    q: 'What does a concept project cost?',
    a: "We do not publish pricing because real concept work scales with the brief. Single-market, single-territory in three weeks sits in a different range from multi-market platform work across six routes. We quote firm after a thirty-minute call, with the scope written up so you can compare it like-for-like against any other partner.",
  },
  {
    q: 'How many rounds of revisions are included?',
    a: "Three rounds on the final concept, two on the territory stage. Most projects close inside two rounds at each stage. The visualization step front-loads alignment, so revision cycles run shorter than on traditional concept work.",
  },
  {
    q: 'What do I need to send to get started?',
    a: "The brief, even a rough one. Existing brand guidelines if they exist. Recent campaign work, with notes on what tested well and what did not. Audience research, even fragments. References you admire or want to differentiate from. The fewer assumptions we have to make, the sharper round one comes out.",
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior creatives with agency backgrounds (Publicis, Ogilvy, BBDO, Wieden) lead every project. AI specialists run the visualization layer. Strategists sit in the brief and the review. No junior teams running concept work on their own.',
  },
  {
    q: 'Will the concepts look like us, or like AI?',
    a: 'Like you, ideally a sharper version of you. We train our visualization references on your brand world, your past campaigns and the references you respond to. For brands without a strong existing system, we calibrate against direct competitors and the direction you give us.',
  },
  {
    q: 'How do you avoid the AI sameness problem?',
    a: 'By not running open-ended generation against generic prompts. Researchers at Dalarna University ran 700 image generation loops and found models converge on twelve dominant motifs when left to themselves. Our work starts with senior creative direction, brand-trained references and a clear point of view. The AI extends the direction. It does not pick it.',
  },
  {
    q: 'Can the concept be produced by anyone, or only by you?',
    a: 'By anyone. We deliver concepts as production-ready creative systems with full direction documentation. Your existing agency, in-house team or production partner can take it forward. About half our concept clients produce with us. The other half take it elsewhere.',
  },
  {
    q: 'What about copyright on AI-generated concept work?',
    a: 'You own the final deliverables. We use commercially safe models, document the workflow and keep the strategic IP, the territories, headlines and architecture, entirely original. For the legal side in full, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can you handle concepts across multiple markets at once?',
    a: 'Yes. Most of our concept work is multi-market by default. Creative talent recruited from the markets you sell into. We pressure-test territories against cultural references in each market before recommending the route that travels best.',
  },
  {
    q: 'Do you do naming and branding too?',
    a: 'Not in this scope. Concept creation is campaign-level creative direction. Naming, identity systems and full brand strategy work sit in a separate practice. If a project needs both, we sequence them or partner with a specialist branding studio.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/services/design/concept-creation`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Concept Creation',
  description:
    'Campaign concepts pressure-tested in days rather than months. Senior creative direction with AI-powered visualization, so routes are proven before the deck goes up.',
  serviceType: 'Campaign concept creation',
  url: pageUrl,
  provider: { '@type': 'Organization', name: 'hubStudio', url: SITE },
  areaServed: 'Worldwide',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE}/services` },
    { '@type': 'ListItem', position: 3, name: 'Concept Creation', item: pageUrl },
  ],
};
---

<Layout
  title="Concept Creation Services | AI-Native | hubStudio"
  description="Campaign concepts pressure-tested in days, not months. Senior creative direction, AI-powered visualization, built for every market you sell into."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Concept Creation
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Campaign</span></span>
            <span class="line"><span class="line__i serif">concepts.</span></span>
            <span class="line"><span class="line__i">In days.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Pressure-tested early. <em>Not after the deck.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most concept work dies in the deck. Three rounds in, no one can
              tell the routes apart, and the route that ships is the fourth
              version of an idea that was in the room in week two.
            </p>
            <p>
              We moved visualization into week one. By the time the deck lands
              in the boardroom, the routes look like routes. And the room can
              actually pick one.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Senior creative direction <span>/</span> AI-native visualization
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/cc-hero.jpg"
          alt="A creative director reviewing three large printed campaign key-visual mockups pinned to a plaster wall in a sunlit Paris atelier."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Concept routes</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              The route that ships<br />
              <span class="serif">is round four</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              A global beauty brand briefed three agencies on a relaunch in
              January. By April there were nine routes, sixty slides each, and
              three strategy directors in a Paris boardroom who could not tell
              the routes apart anymore.
            </p>
            <p class="r" style="--d:.16s">
              The launch slipped a quarter. The budget went sideways. The route
              that finally shipped was the fourth round of an idea that had been
              in the room since week two.
            </p>
            <p class="why__clients r" style="--d:.22s">
              We hear some version of that story from new clients most months.
              So we moved <strong>visualization</strong> into week one.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/cc-roots.jpg"
              alt="A Paris strategy boardroom in late afternoon, ten campaign concept boards leaned against the wall, three people mid-discussion at the table."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The boardroom in week ten</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across roughly 60 concept engagements between January 2024 and March
            2026: three times the routes explored per brief, 70% less time from
            brief to approved direction, five days to first visualized round.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">creative platform</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">briefs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Briefs we have worked on in the past eighteen months, brand names
            withheld where NDAs apply. Each cover is an authored campaign
            artifact, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · AI SAMENESS (was sourcing) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/cc-sameness-main.jpg"
                alt="A studio wall covered with a contact-sheet print-out of forty-eight near-identical AI-generated images, beside a single authored campaign key visual that clearly breaks the pattern."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/cc-sameness-inset.jpg"
              alt="A close-up of a creative director's hand drawing a single decisive red mark on a printed campaign key visual."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">12 motifs</span>
            <span class="source__stat-cap">Out of 700 AI generations, all converged</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The trap to avoid</p>
          <h2 class="dh r" style="--d:.05s">
            The AI <span class="serif">sameness</span> trap.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            In December 2025, researchers at Dalarna University ran 700 image
            generation loops across diverse prompts. All 700 runs converged on
            nearly identical visuals: what the authors called "visual elevator
            music."
          </p>
          <p class="source__p r" style="--d:.16s">
            Just twelve dominant motifs accounted for the output. Stormy
            lighthouses, palatial interiors, commercially safe aesthetics.
            Volume without judgment is not a moat, it is a liability. The
            Canva 2026 marketing study ran the consumer side: 70% of consumers
            say they can usually spot AI ads because they are missing soul, and
            87% say the best advertising still needs a human touch.
          </p>
          <ul class="creds r" style="--d:.22s">
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Brand-trained references
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Senior direction first
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Final human pass
            </li>
            <li class="cred">
              <svg viewBox="0 0 14 14" aria-hidden="true">
                <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Commercially safe models
            </li>
          </ul>
          <p class="source__p r" style="--d:.26s">
            We do not run open-ended generation against a generic prompt and
            pick the least bad output. We build brand-trained references, write
            creative direction at the territory stage and use AI to extend a
            point of view rather than replace one.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Sameness is the default. Authorship is the discipline. The work has
            to defend its place in one sentence, or it does not ship.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Judgment is the<br /><span class="serif">bottleneck</span> now.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Every route used to need a photographer, a location, a model and a
          producer to herd them. Agencies hedged. Visualization is close to
          free now, so the constraint is judgment. Which territory lands. Which
          visual earns attention. Which headline does not sound like the last
          campaign in the category.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with a Q3 relaunch, three or four markets, six
            possible routes. The same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Twelve weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief three agencies, wait six weeks for concepts,
                two more for adaptation, another two for production references.
                Twelve weeks, three or four review rounds, and a room that can
                no longer tell the routes apart.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Five days</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to visualized round</span>
                  <span class="vs__seg-dur">Five days</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: senior creative direction in the first session,
                three to five territories visualized at hero quality inside the
                first week. Mood films cut from AI-generated footage before a
                production day is booked. The room picks one because the routes
                look like routes.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Before the<br />first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put it
            in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us a concept brief. You will hear back from a creative director,
          not a salesperson. First round lands inside ten days. Whatever we
          produce in that round is yours, regardless of whether you continue
          with us.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
