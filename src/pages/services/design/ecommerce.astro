---
/**
 * eCommerce Content  ·  /services/design/ecommerce
 *
 * Mirrors the "Pressroom" art direction of /services/design/packaging-merch-design.
 * Print-production language (crop marks, calibration colour bar, mono figure
 * labels, dashed dieline rules) frames bold editorial typography and the
 * studio's own product photography. Adapted to marketplace content: hero
 * product shots, mobile detail pages, marketplace dashboards.
 *
 * Copy from ecommerce-content-page.md. Process step numerals are intentionally
 * dropped: the project's permanent "no numbers in cards / step lists" rule
 * overrides the source numbering. All imagery sits in /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio product photography, each with an invented brand mark. */
const samples = [
  {
    src: '/Images/ecom-onyx.jpg',
    brand: 'Onyx',
    kind: 'Consumer tech, Amazon main',
    alt: 'A single matte black portable bluetooth speaker on pure white seamless, photographed for an Amazon main image.',
  },
  {
    src: '/Images/ecom-stride.jpg',
    brand: 'Stride',
    kind: 'Footwear, Shopify catalog',
    alt: 'A beige minimalist low-top sneaker on warm sand-coloured paper, three-quarter angle, Shopify catalog hero.',
  },
  {
    src: '/Images/ecom-velve.jpg',
    brand: 'Velve',
    kind: 'Beauty, Tmall flagship',
    alt: 'An open rose-gold cushion compact on a pale pink backdrop, photographed for a Tmall beauty flagship.',
  },
  {
    src: '/Images/ecom-pylon.jpg',
    brand: 'Pylon',
    kind: 'Skincare, Tmall hero',
    alt: 'A frosted glass serum bottle with a black dropper cap on a pale stone gray backdrop, premium skincare hero.',
  },
  {
    src: '/Images/ecom-maison.jpg',
    brand: 'Maison',
    kind: 'FMCG, retail listing',
    alt: 'A matte cylindrical paint can in dusty blue on a warm beige paper background, an FMCG retail listing image.',
  },
  {
    src: '/Images/ecom-atelier.jpg',
    brand: 'Atelier',
    kind: 'Fragrance, DTC hero',
    alt: 'A tall amber glass fragrance bottle with a brushed gold cap on a deep burgundy seamless backdrop.',
  },
];

/* Calibration colour bar: a printer's strip, used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Recent-project results, drawn from the source copy. */
const stats = [
  { from: 24, to: 82, suffix: '%', label: 'First-review approval', note: 'Client baseline was 24%' },
  { from: 0, to: 9, suffix: 'x', label: 'Asset output per SKU', note: 'Without new headcount' },
  { from: 0, to: 38, suffix: '%', label: 'Main-image CTR lift', note: 'Average after rebuild' },
];

/* The two coverage areas. Tag rows surface phrases named in the prose. */
const coverage = [
  {
    fig: 'B',
    label: 'Imagery & video',
    heading: 'Photography, AI imagery, short-form video.',
    image: '/Images/ecom-imagery.jpg',
    alt: 'A single matte glass perfume bottle on pure white seamless, the kind of frame used as an Amazon main image.',
    body: [
      'Hero shots that pass preflight. Lifestyle, on-model, flat-lay, scale, ingredient close-ups, packaging, 360-degree spins. We shoot real product when the brief calls for it. We generate the rest from brand-trained models. Most catalogs run about 70 percent generated, 30 percent shot.',
      'Short-form video runs in parallel: fifteen to thirty seconds for Amazon, 9:16 vertical for Tmall and Douyin, six-second hooks for paid social, longer cuts for YouTube and TikTok.',
    ],
    tags: [
      'Hero product', 'Lifestyle', 'On-model', 'Flat-lay', 'Scale',
      'Ingredient close-up', '360 spins', 'Vertical video', '9:16 hooks', 'AR-ready 3D',
    ],
  },
  {
    fig: 'C',
    label: 'Listings & copy',
    heading: 'Mobile detail pages, copy, marketplace files.',
    image: '/Images/ecom-listings.jpg',
    alt: 'Three smartphones laid in a row, each showing a different mobile product detail page, an example of marketplace listing work.',
    lead: 'Each marketplace reads listings differently. We staff for that.',
    body: [
      'Amazon RGB 255 white mains at 2,000 pixels for zoom. A+ Content, comparison charts, brand story modules. Tmall 800 by 800 mains, 750 by 1,000 verticals, white slot under 300 kilobytes, mobile detail pages sliced for fast load. Douyin 9:16 in correct encoding. Shopify image sets sized for AVIF and WebP delivery.',
      'Copy written in-region: Mandarin in Shanghai, French in Paris, German in Berlin. Titles inside 200 characters, bullets that lead with benefit, backend search terms, A+ overlay text, and detail page copy written for the Rufus semantic layer, not the old keyword era.',
    ],
    tags: [
      'Amazon A+', 'Tmall PDP', 'JD listings', 'Douyin video', 'Shopify PDP',
      'Rufus-aware copy', 'Title and bullets', 'Backend search', 'Transcreation', 'Regulatory language',
    ],
  },
];

/* Marketplace ops capability tags. */
const credentials = ['Amazon SC', 'Tmall TP', 'JD POP', 'Douyin Storefront'];

/* Process steps. Numerals dropped per the no-numbers rule; the source's
   own "first two steps are where it's won" sets each step's tier. */
const processSteps = [
  {
    short: 'Brief',
    tier: 'Where it is won',
    title: 'Brief and SKU audit.',
    body: 'Channels, languages, regulatory codes, launch calendar.',
    image: '/Images/ecom-p1-brief.jpg',
    alt: 'A studio worktable flat-lay with skincare bottles, printed channel specs and brief notes, the start of an eCommerce content engagement.',
  },
  {
    short: 'Channel architecture',
    tier: 'Where it is won',
    title: 'Channel architecture. The step that matters most.',
    body: 'Senior art directors decide how each marketplace will read the brand. This is where an Amazon main image earns its 75 milliseconds, and where a Tmall detail page earns its scroll.',
    image: '/Images/ecom-p2-direction.jpg',
    alt: 'A frosted glass skincare bottle styled as a single editorial hero shot on a stone ledge, an art-directed marketplace hero.',
  },
  {
    short: 'AIGC production',
    tier: 'The rest is execution',
    title: 'AIGC production.',
    body: 'Variants across crops, backgrounds and markets, faster than a traditional shoot day.',
    image: '/Images/ecom-p3-aigc.jpg',
    alt: 'A nine-frame grid of the same skincare bottle photographed against different coloured seamless backdrops.',
  },
  {
    short: 'Marketplace files',
    tier: 'The rest is execution',
    title: 'Marketplace-ready files.',
    body: 'Specs, encoding, slicing, A+ modules, all built into the brief from day one.',
    image: '/Images/ecom-p4-files.jpg',
    alt: 'A laptop showing a six-up grid of the same product in different crops, with a printed channel checklist beside it.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation at scale.',
    body: 'Market variants, SKU extensions, seasonal refresh cycles.',
    image: '/Images/ecom-p5-scale.jpg',
    alt: 'A row of the same skincare bottle in different market label variants on warm beige paper.',
  },
];

/* The process splits into two tiers: the steps where the project is won, and
   the steps that are execution. Each renders in its own block below. */
const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* The old agency timeline, split into the phases the copy names. */
const oldPhases = [
  { label: 'Concepts', dur: 'Four weeks', span: 4 },
  { label: 'Shoot & retouch', dur: 'Four weeks', span: 4 },
  { label: 'Adaptation', dur: 'Four weeks', span: 4 },
];

/* FAQ: copy adapted from source; one answer links to the Copyright guide. */
const faqs = [
  {
    q: 'How long does an eCommerce content project take?',
    a: "Roughly two weeks for a single-SKU pack on one channel. Three to four weeks for a 20 to 50 SKU catalog on one channel. Four to six weeks for a full multi-channel rollout across Amazon, Shopify and Tmall at the same time. Faster on extensions of a brand system we have already built, slower when we are building that system with you from scratch.",
  },
  {
    q: 'How quickly can we get on a first call?',
    a: 'Within two business days of the brief landing in our inbox. The first call runs about 30 minutes. You bring the SKU list and target channels. We bring questions and an initial scope.',
  },
  {
    q: 'How do you handle the Rufus and AI-search shift on Amazon?',
    a: 'We write listings to read on two layers. The classic keyword layer still drives roughly 80 percent of discovery. The Rufus semantic layer mediates 15 to 20 percent of mobile queries and growing. In practice that means claims have to be specific and verifiable, with measurable attributes (dimensions, materials, weight, use cases) instead of marketing adjectives. Copy is structured around the actual questions shoppers ask. And the claims need to match what the reviews say, because Rufus cross-checks the listing against the review body before it recommends anything.',
  },
  {
    q: 'How is the work priced?',
    a: 'Project-based for one-off catalogs, monthly retainer for ongoing volume and seasonal refresh cycles, quarterly advance billing on the retainer side. Firm number after the first call, once the SKU list, channel mix and asset count are clear. On volume work the cost per asset typically lands well below where traditional studios end up.',
  },
  {
    q: 'Who owns the IP, the model weights and the source files?',
    a: 'You do. The final deliverables, the source files, and the brand-trained model weights all transfer to you when the project closes. No vendor lock-in, no licensing fees, no per-asset usage caps. If you ever want to take the workflow in-house, the handover is yours.',
  },
  {
    q: 'What about NDAs, data handling and security?',
    a: 'Mutual NDA on request before the first scoping call. Brand assets stored in encrypted project environments, accessible only to the team on the engagement. Source files purged from working environments 90 days after project close unless you ask us to keep them. We work under Hong Kong law via Beyond Border Group Limited, and we can sign your DPA if your legal team prefers it.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. For full detail on the legal side, see our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'How many rounds of revisions are included?',
    a: 'Three. Most projects close inside two. Beyond round three we quote hourly, though it is rare on catalog work because the brand system gets locked in the brief.',
  },
  {
    q: 'What is the minimum I need to send to get started?',
    a: "A SKU list and at least one product reference image. Everything else (brand guidelines, copy, current listing analytics, target markets) is useful but not mandatory. If brand guidelines do not exist, we work from what does and flag the gaps.",
  },
  {
    q: 'Who actually does the work?',
    a: 'Senior art directors lead every project, most of them from agency backgrounds at Publicis, Ogilvy or WPP. AI specialists handle the production volume underneath them. The channel-ready files get built by marketplace operators who have run live accounts on Amazon, Tmall and Shopify themselves. Mandarin copywriters work in-region in Shanghai. No junior teams running a brief alone.',
  },
  {
    q: 'Will the work look like us, or like generic AI?',
    a: 'Like you. We train custom models on your existing brand assets so the output sits inside your visual system. The brands losing to AI sameness are usually the ones running off-the-shelf prompts on stock models. We do the opposite. And for categories where it really matters (luxury, beauty hero shots, anything with reflective or transparent surfaces) we still shoot. Hybrid is the working model, not full-stack generation.',
  },
  {
    q: 'Do you actually understand Tmall, JD and Douyin, or just Western platforms?',
    a: 'Our production team is based in Shanghai, and we have shipped Tmall flagship work, JD listing packs and Douyin short video for foreign brands entering China as well as Chinese brands going abroad. Every platform has its own rules by category, its own reading patterns, its own visual conventions. A mobile Tmall detail page that scrolls for two meters needs a completely different architecture from an Amazon listing. The difference there is not translation, it is structure.',
  },
  {
    q: 'What is your view on translation versus transcreation for China?',
    a: 'Translation alone is why foreign brands close Tmall stores. We do not translate. We write the Chinese copy in-region, with copywriters who know how Chinese shoppers read a detail page, and we adapt the visual system to match. Same logic for European markets, where the gap between a French market and a German one is not just about word length.',
  },
  {
    q: 'Can you handle a full multi-market catalog, or just one channel?',
    a: 'Both. Some clients come for a single Amazon US rebuild. Others come with 200 SKUs going live across Amazon US, Amazon EU, Shopify, Tmall, JD and Douyin in five languages, with seasonal refresh cycles for each. The workflow scales either way.',
  },
  {
    q: 'Can we start small to see if it works?',
    a: 'Yes. Send us one SKU and one channel. Inside two weeks you get the full asset pack, the copy, and a production estimate for scaling. No retainer, no commitment, the work is yours either way.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="eCommerce Content Services | AI-Native | HubStudio"
  description="Product images, video, copy and detail pages for Amazon, Tmall, JD, Shopify and Douyin. Marketplace-ready files, every SKU, every region."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> eCommerce Content
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">eCommerce</span></span>
            <span class="line"><span class="line__i serif">Content</span></span>
            <span class="line"><span class="line__i">Studio.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Photograph it. Write it. Ship it. <em>Every channel.</em>
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Most studios cannot keep up with the volume marketplaces now
              demand. Most off-the-shelf AI tools cannot get to the quality
              brands actually need.
            </p>
            <p>
              We do both. Senior art directors run the creative; AI specialists
              run the production; marketplace operators ship files that pass
              preflight on the first upload.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See the work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> All major marketplaces
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/ecom-hero.jpg"
          alt="A single matte white ceramic skincare bottle on a soft warm beige paper backdrop, lit from camera left, the kind of editorial hero shot used as a marketplace main image."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Studio work <span>/</span> Pylon</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters now</p>
            <h2 class="dh r" style="--d:.05s">
              Your listing has<br /><span class="serif">a new reader</span>.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              The old A9 algorithm asked whether a listing contained the right
              keywords. Rufus asks whether the product actually answers what the
              customer is trying to do, then cross-checks the claims against the
              reviews. Generic copy that survived the keyword era stops working.
            </p>
            <p class="r" style="--d:.16s">
              The big spenders went first. L'Oreal took campaign turnaround from
              weeks down to days. Nestle built a digital-twin pipeline covering
              4,000 products and reported time and cost savings above 70 percent.
              Zalando said roughly 70 percent of its editorial campaign images
              were already AI-crafted by the end of 2024.
            </p>
            <p class="why__clients r" style="--d:.22s">
              Clients have included <strong>HiSense</strong>,
              <strong>Camper</strong>, <strong>age20</strong>,
              <strong>Shiseido RQ PYOLOGY</strong> and <strong>M. Bricolage</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/ecom-why.jpg"
              alt="A hand in soft afternoon light holds a phone showing a single beauty product on a vertical mobile shopping listing, on a warm wood cafe table."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The seventy-five millisecond test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Numbers below are averages across roughly 50 multi-SKU engagements
            over the last two years, not single-project highs.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Two lanes, one <span class="serif">brand voice</span>.
          </h2>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Hero frames and detail page architecture, generated and finished in
            the studio. Every frame is authored work, not a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · MARKETPLACE OPS (OPTIONAL) ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/ecom-ops.jpg"
                alt="A studio workstation: a laptop screen showing a marketplace seller dashboard with several product listings, a printed channel checklist beside it on a warm wood desk."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/ecom-ops-inset.jpg"
              alt="A hand using a stylus to annotate a printed product listing proof sheet on a warm wood desk."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">2 wks</span>
            <span class="source__stat-cap">Brief to live listings, single SKU</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need the listings<br />uploaded too? We can<br /><span class="serif">handle</span> that.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            This part is optional. Most clients come for the creative and hand
            the files to their internal ops team.
          </p>
          <p class="source__p r" style="--d:.16s">
            If you do not have one, we run upload and listing optimisation
            alongside the content across Amazon, Shopify, Tmall, JD and Douyin:
            keyword research, Rufus-aware copy structuring, variation trees,
            image slot sequencing, A+ assembly, mobile detail page slicing.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            Live accounts already running across the major Western and Chinese
            marketplaces. Variation trees, listing audits and seasonal refresh
            cycles handled in-house, with regulatory copy and category language
            adapted per market.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            If you already have a marketplace operations partner, no problem.
            We deliver platform-ready files and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Channel architecture<br />is where it is <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          Most studios sell process. We sell the channel call. AI made the
          production side cheap and fast for everyone. It did not replace the
          editor who decides what a mobile detail page should actually do.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps are where it is won or lost. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THE MATH ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>The new math</p>
          <h2 class="dh r" style="--d:.05s">
            How AI changes<br />the <span class="serif">math</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            A client lands with 60 SKUs for a Q3 launch across four markets. The
            same brief, run two ways.
          </p>
        </header>

        <div class="vs">
          <article class="vs__row vs__row--old r">
            <div class="vs__side">
              <span class="vs__tag">The old workflow</span>
              <span class="vs__total">Twelve weeks</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar">
                {
                  oldPhases.map((ph, i) => (
                    <span class="vs__seg" style={`--span:${ph.span};--i:${i}`}>
                      <span class="vs__seg-label">{ph.label}</span>
                      <span class="vs__seg-dur">{ph.dur}</span>
                    </span>
                  ))
                }
              </div>
              <p class="vs__p">
                Old workflow: brief a studio, four weeks for concepts, four for
                shoot and retouch, four for adaptation across channels and
                markets. Twelve weeks, multiple revision rounds, and a launch
                window already half burned.
              </p>
            </div>
          </article>

          <article class="vs__row vs__row--new r">
            <div class="vs__side">
              <span class="vs__tag vs__tag--new">Our workflow</span>
              <span class="vs__total vs__total--new">Twelve days</span>
            </div>
            <div class="vs__main">
              <div class="vs__bar vs__bar--new">
                <span class="vs__seg vs__seg--solo" style="--span:1;--i:0">
                  <span class="vs__seg-label">Brief to live files</span>
                  <span class="vs__seg-dur">Twelve working days</span>
                </span>
                <span class="vs__rest" aria-hidden="true"></span>
              </div>
              <p class="vs__p">
                Our workflow: hero shots, lifestyle, copy, mobile detail pages
                and short-form video produced in parallel from one brief. SKU
                adaptation across markets without rebuilding every layout.
                Marketplace preflight built into the brief, not patched in at
                the end.
              </p>
            </div>
          </article>
        </div>

        <div class="hub r">
          <div class="hub__copy">
            <span class="hub__badge">hub4You / AI agent platform</span>
            <h3 class="dh dh--sm hub__head">
              Quarterly to <span class="serif">weekly</span>.
            </h3>
            <p class="hub__text">
              For brands running hundreds of SKUs, we deploy hub4You, our custom
              AI agent setup trained on your own brand system. It generates
              on-brand product imagery, copy variants and detail page layouts on
              demand, and connects directly to your DAM and PIM so the output
              lands where your team already works. That is the gap between
              launching quarterly and launching weekly.
            </p>
            <Button variant="primary" href="/hub4you">Explore hub4You</Button>
          </div>
          <div class="hub__media">
            <div class="win" id="win">
              <div class="win__bar" aria-hidden="true">
                <span></span><span></span><span></span>
                <em>hub4You</em>
              </div>
              <img
                src="/Images/hub4fashion.jpg"
                alt="The hub4You platform generating on-brand product visuals from a model and a background."
                width="2000"
                height="1125"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Fifteen, before<br />the first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            The things brands ask before we start. If yours is not here, put it
            in the brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a<br />real <span class="serif">SKU</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Pick one product on one channel where the listing is not performing.
          Send us the brief. Inside two weeks of the first call you will have a
          full listing pack ready to upload, plus a production estimate for the
          rest of the catalog. No retainer, no commitment, whatever we ship is
          yours to keep regardless.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
