---
/**
 * Print Design  ·  /services/design/print-design
 *
 * Sibling to /services/design/packaging-merch-design. Same "Pressroom"
 * art direction (crop marks, calibration colour bar, mono figure labels,
 * dieline rules) since the language of prepress is the literal subject of
 * this page. Copy adapted from print-design-page.md.
 *
 * Process step numerals are intentionally dropped per the project's
 * permanent "no numbers in cards / step lists" rule. All imagery sits in
 * /public/Images.
 */
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';

/* Studio samples, each with an invented brand mark spanning the format
   list called out in the source brief. */
const samples = [
  {
    src: '/Images/print-sample-maven.jpg',
    brand: 'Maven',
    kind: 'Beauty look-book',
    alt: 'Open beauty look-book on a sandstone slab, a single skincare bottle on the left page and the Maven wordmark on the right.',
  },
  {
    src: '/Images/print-sample-solano.jpg',
    brand: 'Solano',
    kind: 'FMCG retail POS',
    alt: 'Coral-red Solano shelf-talker, wobbler and hanging banner laid flat on a concrete surface under hard directional light.',
  },
  {
    src: '/Images/print-sample-lirien.jpg',
    brand: 'Lirien',
    kind: 'Hospitality invitation',
    alt: 'Letterpress invitation suite on cream cotton stock with a deep navy Lirien wordmark and deckled paper edges.',
  },
  {
    src: '/Images/print-sample-veld.jpg',
    brand: 'Veld',
    kind: 'Automotive brochure',
    alt: 'Premium dealer brochure standing on a stained-oak counter, a half-profile coupe on the cover and a small Veld wordmark at the foot.',
  },
  {
    src: '/Images/print-sample-polaris.jpg',
    brand: 'Polaris Bio',
    kind: 'Pharma annual report',
    alt: 'Clothbound annual report open on pale concrete, a serif headline on the left page and the Polaris Bio mark reversed out of a navy band.',
  },
  {
    src: '/Images/print-sample-bevra.jpg',
    brand: 'Bevra',
    kind: 'Beverage OOH',
    alt: 'A 96-sheet billboard against an overcast sky carrying a single chilled bottle and the Bevra wordmark above a bus shelter.',
  },
];

/* Calibration colour bar: a printer's strip used as a section divider. */
const colourBar = [
  '#e94e1b', '#c73e10', '#1e3a8a', '#0e1f4e', '#0e1633',
  '#6b6b73', '#a8a299', '#d8d3cb', '#e5e1db', '#ffffff',
];

/* Engagement-level stats lifted from the source. */
const stats = [
  { from: 22, to: 78, suffix: '%', label: 'Creative approval rate', note: 'Up from 22% before' },
  { from: 0, to: 60, suffix: '%', label: 'Lower content cost', note: 'On recent campaigns' },
  { from: 0, to: 7, suffix: 'x', label: 'Asset output', note: 'Without a single new hire' },
];

/* Two lanes, with every named print format from the source surfaced as
   chips. The seven lanes the source lists collapse cleanly into these
   two by attention span: long-read editorial vs. high-impact short-form. */
const coverage = [
  {
    fig: 'B',
    label: 'Editorial & brand',
    heading: 'Long-read editorial and brand systems.',
    image: '/Images/print-cover-editorial.jpg',
    alt: 'Two open editorial spreads on a warm plaster surface, a large-format magazine and a slim hardcover annual report.',
    body: [
      'Brochures, catalogs, look-books, magazines, annual reports, white papers, stationery. Formats that get read. Typography earns its space; the grid holds across a hundred pages.',
    ],
    tags: [
      'Brochures', 'Catalogs', 'Look-books', 'Annual reports',
      'White papers', 'Stationery',
    ],
  },
  {
    fig: 'C',
    label: 'Retail, OOH & events',
    heading: 'High-impact, three-second print.',
    image: '/Images/print-cover-retail.jpg',
    alt: 'A six-sheet poster on a weathered brick wall in golden hour light beside the edge of a transit shelter.',
    lead: 'Print that has to land from across an aisle, or from a moving car.',
    body: [
      'In-store kit, OOH from 6-sheet to 96-sheet, transit and airport, building wraps to OAAA specs. Booths, retractables, wayfinding, credentials. Direct mail, PR boxes, variable data.',
    ],
    tags: [
      'Retail & POS', 'Out-of-home', 'Transit & airport',
      'Building wraps', 'Trade-show', 'Direct mail',
    ],
  },
];

/* Production-side credentials for the optional production section. */
const credentials = ['FSC stocks', 'Soy inks', 'ISO 12647', 'NDA in place'];

/* Process steps. Numerals dropped per the no-numbers rule. The source
   itself calls out which steps are where the work is won, vs. execution. */
const processSteps = [
  {
    short: 'Brief & spec',
    tier: 'Where it is won',
    title: 'Brief and print spec.',
    body: 'Format, stock, finish, binding, print method, supplier, regulatory copy. Locked before the first sketch.',
    image: '/Images/print-p1-brief.jpg',
    alt: 'Folded mock-up brochure, paper-stock swatch book, Pantone guide fanned out, marker and steel ruler on a worktable.',
  },
  {
    short: 'Creative direction',
    tier: 'Where it is won',
    title: 'Creative direction.',
    body: 'Art directors set the grid, the type hierarchy, the image cadence, and the cover the rest earns its way around.',
    image: '/Images/print-p2-direction.jpg',
    alt: 'An art director leaning over a worktable covered in printed layout proofs, marking a single page with a pencil.',
  },
  {
    short: 'AI exploration',
    tier: 'The rest is execution',
    title: 'AI exploration.',
    body: 'Dozens of layout directions in parallel. Photoreal mockups in context, before a sample is ordered.',
    image: '/Images/print-p3-aigc.jpg',
    alt: 'A wall pinned with twenty printed variations of the same brochure cover, arranged in a grid.',
  },
  {
    short: 'Prepress',
    tier: 'The rest is execution',
    title: 'Refinement and prepress.',
    body: 'Typography, master pages, color management, dielines, ink coverage, preflight on the final PDF.',
    image: '/Images/print-p4-prepress.jpg',
    alt: 'A printer’s hands inspecting a press sheet at a lightbox with a loupe, crop marks and a colour bar at the edge.',
  },
  {
    short: 'Adaptation',
    tier: 'The rest is execution',
    title: 'Adaptation at scale.',
    body: 'Market variants, format extensions, language localization. EN to FR or DE expands 15 to 30%; ZH, KR, JP contracts. No reflowing every page.',
    image: '/Images/print-p5-adapt.jpg',
    alt: 'Five language variants of the same brochure cover laid out side by side on a long worktable.',
  },
];

const wonSteps = processSteps.filter((s) => s.tier === 'Where it is won');
const execSteps = processSteps.filter((s) => s.tier === 'The rest is execution');

/* Three documented shifts in AI for print design since 2025, laid out as
   press-wire dispatches: a mono dateline (Filed YYYY / source) above a
   two-column body. The stat is the tabloid anchor on the left, the
   editorial headline + prose runs on the right. The numerals are content
   (real percentages and multipliers), not decorative ordinals, so the
   no-numbers-in-cards rule does not fire. */
const shifts = [
  {
    year: '2025',
    src: 'Nestlé · NVIDIA Omniverse',
    stat: '70%',
    statCap: 'Less time & cost',
    head: 'Digital twins of four thousand products.',
    body: 'Nestlé built an AI content service on NVIDIA Omniverse, generating localized packaging from digital twins of 4,000 SKUs. Time and cost of scaling cut over 70%.',
  },
  {
    year: 'May 2025',
    src: 'Coca-Cola · Adobe Fizzion',
    stat: '10x',
    statCap: 'Faster than manual',
    head: 'A brand system that learns itself.',
    body: "Coca-Cola launched Fizzion with Adobe in May 2025. It learns a brand's system, then generates hundreds of localized variants inside Illustrator, InDesign and Photoshop. Up to ten times faster than manual.",
  },
  {
    year: '2025',
    src: 'PRINTING United Alliance',
    stat: '85%',
    statCap: 'Of print providers',
    head: 'The industry stops hedging.',
    body: 'PRINTING United Alliance, 2025: 85% of print service providers now call AI critical to staying competitive. Most are piloting it in prepress, estimating and workflow.',
  },
];

/* FAQ: tightened to eight questions, answers trimmed. The legal answer
   keeps its link to the Copyright and AI guide. */
const faqs = [
  {
    q: 'How long does a print project take?',
    a: 'One to two weeks for a standard piece. Three to four for a multi-format campaign. Add 1 to 5 weeks for printing.',
  },
  {
    q: 'Who does the work?',
    a: 'Art directors from agency backgrounds (Publicis, Ogilvy, WPP) lead. AI specialists handle volume. Prepress by people who have been on press.',
  },
  {
    q: 'What about copyright on AI-generated work?',
    a: 'You own the final deliverables. We use commercially safe models and document the workflow. Full detail in our Copyright and AI guide.',
    link: { match: 'Copyright and AI guide', href: '/resources/copyright-and-ai' },
  },
  {
    q: 'Can we start small?',
    a: 'Yes. One brief, two weeks, three layout directions and a production estimate. No retainer.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Print Design Services | AI-Native | hubStudio"
  description="Press-ready print design across every format: brochures, OOH, retail, editorial. Senior art directors lead, prepress built in, every market."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <div class="hero__panel-in">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>Design service
            <span class="kicker__sep">/</span> Print
          </p>
          <h1 class="hero__title">
            <span class="line"><span class="line__i">Print</span></span>
            <span class="line"><span class="line__i serif">Design.</span></span>
          </h1>
          <p class="hero__tag r" style="--d:.45s">
            Press-ready layouts, <em>every format</em>.
          </p>
          <div class="hero__lead r" style="--d:.55s">
            <p>
              Brochure to press Tuesday. Dielines on the wrong layer, cover
              still RGB, preflight kicks it back before lunch.
            </p>
            <p>
              So prepress is the first conversation, not the last.
            </p>
          </div>
          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href="/contact">Start the brief</Button>
            <a class="ghost-link ghost-link--light" href="#proof">
              See sample work
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="hero__meta r" style="--d:.72s">
            Shanghai studio <span>/</span> Design
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/Images/print-hero.jpg"
          alt="Hardcover monograph and a perfect-bound editorial catalog open on a plaster worktable beside a stack of folded brochures."
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">Editorial</span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it earns the budget</p>
            <h2 class="dh r" style="--d:.05s">
              The brochure on<br />the <span class="serif">desk</span> wins.
            </h2>
          </div>
          <div class="why__text">
            <p class="r" style="--d:.1s">
              Digital travels further. Trust has moved the other way. A
              brochure on a buyer's desk earns more attention than ten
              retargeting ads.
            </p>
            <p class="r" style="--d:.16s">
              Print also punishes sloppy work. One misregistered Pantone on
              a 6-sheet and the trust evaporates.
            </p>
            <p class="why__clients r" style="--d:.22s">
              <strong>82% of U.S. consumers trust print advertising</strong>,
              the highest of any ad format.
              <span class="why__src">MarketingSherpa, 2024.</span>
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src="/Images/print-roots.jpg"
              alt="A printed brochure on a sunlit walnut desk beside an espresso cup, a metal pen and a closed slim laptop."
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">The desk test</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">
            Across 40 print engagements: approval up from 22% to 78%, cost
            down 60%, output 7x. No new hires.
          </p>
          <div class="stats__grid">
            {
              stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER ============ -->
    <section class="cover">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            Every format, one <span class="serif">brand system</span>.
          </h2>
          <p class="band__note r" style="--d:.1s">
            A 200-page catalog and a highway billboard share almost nothing in
            their craft. We staff each format with art directors who've done
            it before, on one brand system.
          </p>
        </header>

        {
          coverage.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              <figure class="feature__media crop r-clip">
                <div class="crop__inner">
                  <img
                    src={c.image}
                    alt={c.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="fig">{c.label}</figcaption>
              </figure>
              <div class="feature__body">
                <p class="feature__idx r"><span class="feature__tick"></span>Coverage</p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                {c.lead && <p class="feature__lead r" style="--d:.1s">{c.lead}</p>}
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / GALLERY ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Selected <span class="serif">proofs</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">
            Authored work, never a stock pull.
          </p>
        </header>

        <div class="sheet">
          {
            samples.map((s, i) => (
              <figure class="shot crop r-clip" style={`--d:${(i % 3) * 0.08}s`}>
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · OPTIONAL PRODUCTION ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src="/Images/print-pressroom.jpg"
                alt="A four-colour offset press in mid-run with a freshly printed sheet being lifted at the delivery end."
                width="1024"
                height="1024"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src="/Images/print-p4-prepress.jpg"
              alt="A printer's hands checking a press sheet at a lightbox with a loupe magnifier."
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">1&ndash;5 wks</span>
            <span class="source__stat-cap">Approved design to delivered units</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Optional capability</p>
          <h2 class="dh r" style="--d:.05s">
            Need it printed too?<br />We can <span class="serif">handle</span> that.
          </h2>
          <p class="source__lead r" style="--d:.1s">
            Optional. Most clients hand files to their own printer.
          </p>
          <p class="source__p r" style="--d:.16s">
            If you don't have one, we run production across offset, digital,
            wide-format and specialty presses. Soft-touch, spot UV, foil,
            emboss, die-cut, FSC stocks: the finishes printers quietly drop.
          </p>
          <ul class="creds r" style="--d:.22s">
            {
              credentials.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M2 7.5 5.5 11 12 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p r" style="--d:.26s">
            One to three weeks for standard work, three to five for
            large-format OOH with install.
          </p>
          <p class="source__p source__p--quiet r" style="--d:.3s">
            Already have a printer? We deliver press-ready files matched to
            their specs and step back.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="shell craft__intro">
        <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
        <h2 class="dh r" style="--d:.05s">
          Creative is where<br />it's <span class="serif">won</span>.
        </h2>
        <p class="craft__lede r" style="--d:.12s">
          AI made the technical side cheap. Picking the layout that's worth
          printing is the part that's still hard.
        </p>
        <p class="craft__note r" style="--d:.16s">
          First two steps win it. The rest is execution.
        </p>
      </div>

      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                processSteps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                processSteps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <figure class="seq__media crop">
                      <div class="crop__inner">
                        <img
                          src={s.image}
                          alt={s.alt}
                          width="1200"
                          height="900"
                          loading="lazy"
                        />
                      </div>
                    </figure>
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · THREE SHIFTS ============ -->
    <section class="math">
      <div class="shell">
        <header class="band">
          <p class="kicker kicker--light r"><span class="kicker__tick"></span>Where it's going</p>
          <h2 class="dh r" style="--d:.05s">
            How AI rewrote<br />print <span class="serif">design</span>.
          </h2>
          <p class="band__note band__note--light r" style="--d:.1s">
            Three documented shifts since 2025. The economics of print design
            moved sharply, fast.
          </p>
        </header>

        <div class="wire">
          {
            shifts.map((s, i) => (
              <article class="wire__item r" style={`--d:${i * 0.06}s`}>
                <header class="wire__meta">
                  <span class="wire__tick" aria-hidden="true"></span>
                  <span class="wire__filed">Filed {s.year}</span>
                  <span class="wire__sep">/</span>
                  <span class="wire__src">{s.src}</span>
                </header>
                <div class="wire__body">
                  <div class="wire__figure">
                    <span class="wire__stat">{s.stat}</span>
                    <span class="wire__cap">{s.statCap}</span>
                  </div>
                  <div class="wire__copy">
                    <h3 class="wire__head">{s.head}</h3>
                    <p class="wire__p">{s.body}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <aside class="risk r" style="--d:.05s">
          <p class="risk__lede">The risk is real.</p>
          <p class="risk__body">
            Same models, converging outputs. Print Monthly called it "AI-led
            sameness" in 2026. The studios still winning print work are the
            ones whose creative direction is strong enough that AI amplifies
            it, instead of standing in for it.
          </p>
        </aside>
      </div>
    </section>

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Four questions,<br /><span class="serif">answered</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What brands ask before the first call.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href="/contact">Start the brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          Try it on a real<br /><span class="serif">brief</span>.
        </h2>
        <p class="end__p r" style="--d:.12s">
          Send us a print job. Inside two weeks: three layout directions and
          a production estimate. Yours to keep, even if you walk.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href="/contact">Start the brief</Button>
          <a class="ghost-link ghost-link--light" href="/work">
            See more work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ===================== Foundations ===================== */
