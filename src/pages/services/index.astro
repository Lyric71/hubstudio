// Structured data: every service line as a Service entity, provided by
// hubStudio. Gives search engines and AI assistants the full service surface.
const SITE = 'https://hubstudio.ai';
const serviceListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'hubStudio creative services',
  url: `${SITE}/services`,
  itemListElement: categories
    .flatMap((cat) => cat.services)
    .map((svc, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: svc.name,
        description: svc.desc,
        url: `${SITE}${svc.href}`,
        serviceType: svc.name,
        provider: { '@type': 'Organization', name: 'hubStudio', url: SITE },
      },
    })),
};
---

<Layout
  title="Creative Services: 20 Lines, One Studio | hubStudio"
  description="Twenty creative service lines under one studio: social, video, motion, ecommerce, web, strategy, brand identity, and sales communications."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceListSchema)} />

  <!-- ===== Hero ===== -->
  <section class="svc-hero">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1 class="headline h1 reveal svc-hero__title">
        Twenty service lines. One <span class="accent">studio</span>.
      </h1>
      <p class="lead svc-hero__lead">
        From a single social post to a full campaign system: every format your brand
        needs, produced in days, not weeks. Explore the work, grouped six ways.
      </p>
      <nav class="svc-jump" aria-label="Service categories">
        {
          categories.map((cat) => (
            <a class="svc-jump__link" href={`#${cat.id}`}>
              {cat.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ===== Categories ===== -->
  <div class="svc-cats">
    <div class="container">
      {
        categories.map((cat) => (
          <section class="svc-cat" id={cat.id}>
            <header class="svc-cat__head">
              <h2 class="svc-cat__title reveal">{cat.title}</h2>
              <p class="svc-cat__blurb">{cat.blurb}</p>
            </header>
            <div class="svc-grid">
              {cat.services.map((svc) => (
                <a class="svc-card" href={svc.href}>
                  <div class="svc-card__media">
                    <img
                      class="svc-card__img"
                      src={svc.img}
                      alt={svc.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="svc-card__body">
                    <h3 class="svc-card__name">{svc.name}</h3>
                    <p class="svc-card__desc">{svc.desc}</p>
                    <span class="svc-card__cta">
                      View service <span aria-hidden="true">&rarr;</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <!-- ===== Closing CTA ===== -->
  <section class="svc-cta">
    <div class="container">
      <div class="svc-cta__card card card--orange grain">
        <span class="eyebrow svc-cta__eyebrow">Where to start</span>
        <h2 class="headline h3 svc-cta__title">Not sure which service you need?</h2>
        <p class="svc-cta__text">
          Tell us what you are shipping. We will point you to the right service, or
          build the mix that fits the brief.
        </p>
        <Button variant="primary-inverse" href="/contact">Talk to us</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---------------------------------------------------- */
  .svc-hero {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 76px);
  }
  .svc-hero__title {
    margin-top: 16px;
    max-width: 16ch;
  }
  .svc-hero__lead {
    margin-top: 22px;
    max-width: 56ch;
  }

  /* Category jump links */
  .svc-jump {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .svc-jump__link {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--text-ink);
    transition: color 120ms ease-out, border-color 120ms ease-out,
      background-color 120ms ease-out;
  }
  .svc-jump__link:hover {
    color: var(--brand-orange);
    border-color: var(--brand-orange);
  }

  /* ---- Category sections --------------------------------------- */
  .svc-cats {
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .svc-cat {
    scroll-margin-top: 96px;
  }
  .svc-cat + .svc-cat {
    margin-top: clamp(64px, 9vw, 112px);
  }
  .svc-cat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 32px;
    padding-top: 26px;
    border-top: 1px solid var(--line-strong);
    margin-bottom: 36px;
  }
  .svc-cat__title {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(28px, 3.2vw, 46px);
  }
  .svc-cat__blurb {
    font-size: var(--type-body);
    color: var(--text-mute);
  }

  /* ---- Service grid + cards ------------------------------------ */
  .svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-card);
  }
  @media (min-width: 640px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-white);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
  }
  .svc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(10, 10, 20, 0.12);
  }
  .svc-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-cream);
  }
  .svc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease-out;
  }
  .svc-card:hover .svc-card__img {
    transform: scale(1.04);
  }
  .svc-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px 24px;
  }
  .svc-card__name {
    font-family: var(--font-sans);
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .svc-card__desc {
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--text-mute);
  }
  .svc-card__cta {
    margin-top: auto;
    padding-top: 14px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .svc-card__cta span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .svc-card:hover .svc-card__cta span {
    transform: translateX(4px);
  }

  /* ---- Closing CTA -------------------------------------------- */
  .svc-cta {
    padding-bottom: clamp(80px, 10vw, 150px);
  }
  .svc-cta__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: clamp(40px, 6vw, 76px) clamp(24px, 5vw, 64px);
    color: #fff;
  }
  .svc-cta__eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }
  .svc-cta__title {
    color: #fff;
  }
  .svc-cta__text {
    max-width: 44ch;
    color: rgba(255, 255, 255, 0.86);
  }
  .svc-cta__card .btn {
    margin-top: 10px;
  }
</style>

<script>
  /* Fade-in on scroll, matching the home page reveal pattern. */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>
