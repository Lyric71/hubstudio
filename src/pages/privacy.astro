---
/**
 * Privacy Policy (`/privacy`).
 * Compact legal hero + sticky table of contents + numbered sections.
 * Adapted for hubStudio: content production studio operated by
 * BeyondBorderGroup LTD, Hong Kong SAR.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const updated = '18 May 2026';

interface Block {
  p?: string;
  sub?: string;
  list?: string[];
  note?: string;
  table?: { head: string[]; rows: string[][] };
}
interface Section {
  id: string;
  title: string;
  blocks: Block[];
}

const sections: Section[] = [
  {
    id: 'who-we-are',
    title: 'Who we are',
    blocks: [
      {
        p: 'hubStudio is operated by BeyondBorderGroup LTD, a company registered in the Hong Kong Special Administrative Region. We are the data controller responsible for the personal data described here. "We", "us", and "our" refer to hubStudio throughout this policy.',
      },
      {
        p: 'This policy covers the hubStudio website at hubstudio.ai, the hub4You platform, and personal data we handle in the course of a client engagement.',
      },
    ],
  },
  {
    id: 'what-we-collect',
    title: 'Information we collect',
    blocks: [
      { sub: 'Information you give us' },
      {
        list: [
          'Identity and contact details: your name, email address, phone number, and company',
          'Engagement information: briefs, feedback, project materials, and anything you share through our contact form, by email, or during a project',
          'Account information: the details needed to create and manage a hub4You account',
        ],
      },
      { sub: 'Information we collect automatically' },
      {
        list: [
          'Technical data: IP address, browser type, operating system, and device information',
          'Usage data: pages viewed, referring URL, time on page, and session duration, collected through cookies and similar technologies',
        ],
      },
    ],
  },
  {
    id: 'how-we-use',
    title: 'How we use your information',
    blocks: [
      { sub: 'We use personal data to:' },
      {
        list: [
          'Respond to your enquiries and requests',
          'Deliver, manage, and improve the services you engage us for',
          'Create and administer hub4You accounts',
          'Process payments and manage client accounts',
          'Send marketing communications where you have asked to receive them',
          'Analyse and improve our website and platform',
          'Meet our legal, accounting, and regulatory obligations',
        ],
      },
      {
        p: 'We rely on one of the following bases for each use: performing a contract with you, your consent, our legitimate interest in running and improving our business, or a legal obligation. Where we rely on consent, you can withdraw it at any time.',
      },
    ],
  },
  {
    id: 'sharing',
    title: 'How we share information',
    blocks: [
      {
        p: 'We do not sell, rent, or trade your personal data. We share it only in these situations:',
      },
      {
        list: [
          'With trusted service providers, such as hosting, payment, and email providers, who process data on our instructions under confidentiality obligations',
          'Within the BeyondBorderGroup network, where this is needed to deliver a service you have engaged',
          'Where disclosure is required by law, regulation, or a valid legal request',
          'In connection with a business sale or reorganisation, with safeguards over your data',
        ],
      },
    ],
  },
  {
    id: 'international',
    title: 'International transfers',
    blocks: [
      {
        p: 'hubStudio works across 16 markets, so your data may be processed in a country other than your own. When we transfer personal data across borders, we take steps to ensure it stays protected to a standard consistent with this policy and applicable law.',
      },
    ],
  },
  {
    id: 'security',
    title: 'Data security and retention',
    blocks: [
      {
        p: 'We apply organisational and technical safeguards to protect personal data against unauthorised access, alteration, disclosure, or destruction. No system is completely secure, but we work to reduce risk and to respond promptly if an issue arises.',
      },
      {
        p: 'We keep personal data only as long as needed for the purpose it was collected for, or as long as the law requires for tax, accounting, and record-keeping. When data is no longer needed, we delete or anonymise it.',
      },
    ],
  },
  {
    id: 'your-rights',
    title: 'Your rights',
    blocks: [
      { sub: 'Depending on where you live, you may have the right to:' },
      {
        list: [
          'Access the personal data we hold about you',
          'Correct inaccurate or incomplete data',
          'Request deletion of your data',
          'Object to or restrict certain processing',
          'Withdraw consent you have given',
          'Receive a copy of your data in a portable format',
        ],
      },
      {
        note: 'To exercise any of these rights, contact us at hello@hubstudio.ai. We will respond within the timeframe set by applicable law. You also have the right to complain to your local data protection authority.',
      },
    ],
  },
  {
    id: 'cookies',
    title: 'Cookies',
    blocks: [
      {
        p: 'Our website uses cookies and similar technologies. How they work, and how to manage them, is set out in our Cookie Policy.',
      },
    ],
  },
  {
    id: 'third-party',
    title: 'Third-party links',
    blocks: [
      {
        p: 'Our website and content may link to sites we do not operate. We are not responsible for the privacy practices of those sites, and we encourage you to read their policies before sharing personal data.',
      },
    ],
  },
  {
    id: 'children',
    title: "Children's privacy",
    blocks: [
      {
        p: 'Our website and services are intended for businesses and are not directed at individuals under 18. We do not knowingly collect personal data from children. If you believe a child has provided us with data, contact us and we will delete it.',
      },
    ],
  },
  {
    id: 'changes',
    title: 'Changes to this policy',
    blocks: [
      {
        p: 'We may update this policy as our services and legal obligations evolve. The current version always sits on this page with its effective date. Significant changes will be flagged here, and where required we will seek your consent.',
      },
    ],
  },
  {
    id: 'contact',
    title: 'Contact us',
    blocks: [
      {
        p: 'Questions about this policy, or about how we handle your data, can be sent to hello@hubstudio.ai, or through the contact page on this site.',
      },
    ],
  },
];

const toc = sections.map((s) => ({ id: s.id, title: s.title }));
const related = [
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Cookie Policy', href: '/cookies' },
];
---

<Layout
  title="Privacy Policy | hubStudio"
  description="How hubStudio collects, uses, stores, and protects your personal data across our website, the hub4You platform, and our services."
>
  <!-- ===== Hero ===== -->
  <section class="section legal-hero">
    <div class="container">
      <div class="legal-hero__inner">
        <span class="eyebrow">Legal</span>
        <h1 class="headline h2 reveal legal-hero__title">
          Privacy <span class="accent">Policy</span>.
        </h1>
        <p class="lead legal-hero__lead">
          This policy explains what personal data hubStudio collects when you visit our website,
          use hub4You, or engage our services, how we use it, and the rights you hold over it.
        </p>
        <span class="chip legal-hero__chip">
          <span class="chip__dot"></span>Last updated {updated}
        </span>
      </div>
    </div>
  </section>

  <!-- ===== Body ===== -->
  <section class="legal-main">
    <div class="container">
      <div class="legal-grid">
        <nav class="toc" aria-label="On this page">
          <p class="toc__title">On this page</p>
          <ol class="toc__list">
            {
              toc.map((item, i) => (
                <li>
                  <a href={`#${item.id}`}>
                    <span class="toc__num">{String(i + 1).padStart(2, '0')}</span>
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="legal-body">
          {
            sections.map((sec, i) => (
              <section class="legal-sec" id={sec.id}>
                <span class="legal-sec__n">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="legal-sec__title">{sec.title}</h2>
                {sec.blocks.map((b) =>
                  b.p ? (
                    <p class="legal-p">{b.p}</p>
                  ) : b.note ? (
                    <p class="legal-note">{b.note}</p>
                  ) : b.sub ? (
                    <p class="legal-sub">{b.sub}</p>
                  ) : b.list ? (
                    <ul class="legal-list">
                      {b.list.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  ) : null,
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Closing ===== -->
  <section class="section--tight">
    <div class="container">
      <div class="legal-cta card card--navy">
        <span class="eyebrow">Your data, your call</span>
        <h2 class="headline h3 reveal legal-cta__head">
          Questions about your <span class="accent">privacy</span>?
        </h2>
        <p class="legal-cta__text">
          Write to us at <a href="mailto:hello@hubstudio.ai">hello@hubstudio.ai</a> to access,
          correct, or delete your data, or to ask anything about this policy.
        </p>
        <Button variant="primary-inverse" href="/contact">Contact hubStudio</Button>
        <div class="legal-cta__links">
          {related.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section--tight {
    padding-block: 24px 96px;
  }

  /* ---- Hero ---- */
  .legal-hero {
    padding-top: 64px;
    padding-bottom: 0;
  }
  .legal-hero__inner {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    display: grid;
    gap: 18px;
    justify-items: center;
  }
  .legal-hero__title {
    margin-top: 4px;
  }
  .legal-hero__lead {
    max-width: 60ch;
  }
  .legal-hero__chip {
    margin-top: 6px;
    background: rgba(233, 78, 27, 0.1);
    color: var(--brand-orange);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* ---- Body layout ---- */
  .legal-main {
    padding-block: 56px 24px;
  }
  .legal-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .legal-grid {
      grid-template-columns: 240px 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* ---- Table of contents ---- */
  @media (min-width: 1000px) {
    .toc {
      position: sticky;
      top: 96px;
    }
  }
  .toc__title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .toc__list {
    margin-top: 14px;
    display: grid;
  }
  .toc__list a {
    display: block;
    padding: 7px 0 7px 14px;
    border-left: 2px solid var(--line-hairline);
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-mute);
    transition:
      color 120ms ease-out,
      border-color 120ms ease-out;
  }
  .toc__list a:hover {
    color: var(--brand-orange);
    border-color: var(--brand-orange);
  }
  .toc__num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--brand-orange);
    margin-right: 8px;
  }

  /* ---- Sections ---- */
  .legal-body {
    max-width: 70ch;
  }
  .legal-sec {
    padding-block: 30px;
    border-top: 1px solid var(--line-hairline);
    scroll-margin-top: 104px;
  }
  .legal-sec:first-child {
    border-top: none;
    padding-top: 0;
  }
  .legal-sec__n {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--brand-orange);
  }
  .legal-sec__title {
    margin-top: 8px;
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .legal-p {
    margin-top: 14px;
    font-size: var(--type-small);
    line-height: 1.7;
    color: var(--text-mute);
  }
  .legal-sub {
    margin-top: 18px;
    font-size: var(--type-body);
    font-weight: 600;
    color: var(--text-ink);
  }
  .legal-list {
    margin-top: 12px;
    display: grid;
    gap: 9px;
  }
  .legal-list li {
    position: relative;
    padding-left: 22px;
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--text-mute);
  }
  .legal-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-orange);
    opacity: 0.6;
  }
  .legal-note {
    margin-top: 16px;
    padding: 20px 22px;
    border-radius: 16px;
    background: var(--bg-cream);
    border: 1px solid var(--line-hairline);
    font-size: var(--type-small);
    line-height: 1.65;
    color: var(--text-mute);
  }

  /* ---- Closing ---- */
  .legal-cta {
    max-width: 880px;
    margin-inline: auto;
    padding: 48px;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  @media (max-width: 600px) {
    .legal-cta {
      padding: 36px 24px;
    }
  }
  .legal-cta .eyebrow {
    color: var(--brand-orange);
  }
  .legal-cta__head {
    max-width: 20ch;
  }
  .legal-cta__text {
    max-width: 50ch;
    font-size: var(--type-small);
    line-height: 1.6;
    color: rgba(240, 237, 233, 0.78);
  }
  .legal-cta__text a {
    color: var(--brand-orange);
  }
  .legal-cta :global(.btn) {
    margin-top: 8px;
  }
  .legal-cta__links {
    margin-top: 18px;
    padding-top: 20px;
    border-top: 1px solid rgba(240, 237, 233, 0.14);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .legal-cta__links a {
    color: rgba(240, 237, 233, 0.62);
    transition: color 120ms ease-out;
  }
  .legal-cta__links a:hover {
    color: var(--brand-orange);
  }
</style>

<script>
  /* Reveal headlines on scroll. */
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>
