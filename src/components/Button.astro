---
/**
 * Button: §7 component library.
 * Renders an <a> when `href` is set, otherwise a <button>.
 * A link into the app (sign-up, sign-in, the app itself) opens in a new tab.
 */
import { APP_URL } from '../lib/links';

type Variant = 'primary' | 'primary-inverse' | 'secondary' | 'on-dark' | 'ghost';

interface Props {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', href, type = 'button', class: extra = '' } = Astro.props;
const cls = `btn btn--${variant} ${extra}`.trim();
const newTab = href?.startsWith(APP_URL) ? { target: '_blank', rel: 'noopener' } : {};
---

{
  href ? (
    <a href={href} class={cls} {...newTab}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls}>
      <slot />
    </button>
  )
}
