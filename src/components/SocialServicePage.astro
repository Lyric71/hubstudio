---
/**
 * Shared Pressroom template for the 12 Social Networks pillar service pages
 * (/services/social/*).
 *
 * Visuals alternate between:
 *   1. 100% realistic platform screenshots (LinkedIn, Meta, TikTok, X, YouTube, WeChat, RedNote, Douyin, Weibo)
 *   2. 100% realistic hubStudio app screenshots (<AppShot /> with localized .fr.webp / .zh.webp captures)
 *   3. Editorial business lifestyle photography in the style of the website
 *
 * No ordinal numerals in any card, tile, or step list. Zero em-dashes (U+2014).
 */
import Layout from '../layouts/Layout.astro';
import Button from './Button.astro';
import AppShot from './AppShot.astro';
import ServiceAppOrStudio from './ServiceAppOrStudio.astro';
import InsightsLayer from './InsightsLayer.astro';
import { APP_SIGNUP, BRIEF_URL } from '../lib/links';
import type { SocialServiceData } from '../data/social-services';

interface Props {
  service: SocialServiceData;
}

const { service } = Astro.props;
const BRIEF = `${BRIEF_URL}?service=social-${service.slug}`;

const colourBar = [
  '#0E1633',
  '#0E1F4E',
  '#1E2D5F',
  '#E94E1B',
  '#FF6B3A',
  '#D03E0E',
  '#F5EDE3',
  '#F0EDE9',
  '#E7E3DD',
  '#FFFFFF',
];

const SITE = 'https://www.hubstudio.ai';
const pageUrl = `${SITE}/services/social/${service.slug}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Studio', item: `${SITE}/studio` },
    { '@type': 'ListItem', position: 3, name: service.name, item: pageUrl },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `${service.name} | hubStudio`,
  serviceType: service.serviceType,
  description: service.metaDescription,
  url: pageUrl,
  image: `${SITE}${service.hero.image}`,
  provider: { '@id': `${SITE}/#organization` },
  areaServed: 'Worldwide',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  image={service.hero.image}
  preloadImage={service.hero.image}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Top scroll progress -->
  <div class="prog" aria-hidden="true"><span class="prog__bar"></span></div>

  <div class="page">
    <!-- ============ S1 · HERO ============ -->
    <section class="hero">
      <div class="hero__panel">
        <svg class="hero__reg" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
        </svg>

        <div class="hero__panel-in">
          <p class="kicker kicker--light r" style="--d:.05s">
            <span class="kicker__tick"></span>
            <a class="kicker__crumb" href="/studio">Studio</a>
            <span class="kicker__sep">&middot;</span>
            Social networks
            <span class="kicker__sep">&middot;</span>
            {service.group}
          </p>

          <h1 class="hero__title">
            <span class="line"><span class="line__i">{service.hero.line1}</span></span>
            <span class="line"><span class="line__i">{service.hero.line2}</span></span>
            <span class="line"><span class="line__i serif">{service.hero.serifLine}</span></span>
          </h1>

          <p class="hero__tag r" style="--d:.42s">
            {service.hero.tagPre}<em>{service.hero.tagEm}</em>{service.hero.tagPost}
          </p>

          <div class="hero__lead">
            {
              service.hero.lead.map((p, idx) => (
                <p class="r" style={`--d:${0.5 + idx * 0.08}s`}>
                  {p}
                </p>
              ))
            }
          </div>

          <div class="hero__cta r" style="--d:.65s">
            <Button variant="primary" href={BRIEF}>Send a brief</Button>
            <a class="ghost-link ghost-link--light" href="#coverage">
              See what we cover
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M4 10h12M11 5l5 5-5 5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>

          <p class="hero__meta r" style="--d:.72s">
            Hong Kong headquarters <span>/</span> studios in Shanghai and Changsha
          </p>
        </div>
      </div>

      <div class="hero__visual">
        <img
          src={service.hero.image}
          alt={service.hero.alt}
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__chip">
          {service.hero.chipPre} <span>/</span> {service.hero.chipPost}
        </span>
      </div>
    </section>

    <!-- calibration bar -->
    <div class="cbar" aria-hidden="true">
      {colourBar.map((c) => <span style={`background:${c}`}></span>)}
    </div>

    <!-- ============ S2 · WHY IT MATTERS ============ -->
    <section class="why">
      <div class="shell">
        <div class="why__top">
          <div class="why__head">
            <p class="kicker kicker--light r"><span class="kicker__tick"></span>Why it matters</p>
            <h2 class="dh r" style="--d:.05s">
              {service.why.titleLine1}<br />
              <span class="serif">{service.why.titleSerif}</span>{service.why.titlePost}
            </h2>
          </div>
          <div class="why__text">
            {
              service.why.paragraphs.map((p, idx) => (
                <p class="r" style={`--d:${0.1 + idx * 0.06}s`}>
                  {p}
                </p>
              ))
            }
            <p class="why__clients r" style="--d:.24s">
              Clients across social and content have included <strong>HiSense</strong>,
              <strong>Camper</strong>, <strong>iFLYTEK</strong>, and <strong>age20</strong>.
            </p>
          </div>
        </div>

        <figure class="why__shot crop r-clip">
          <div class="crop__inner">
            <img
              src={service.why.image}
              alt={service.why.alt}
              width="1408"
              height="768"
              loading="lazy"
            />
          </div>
          <figcaption class="fig">{service.why.caption}</figcaption>
        </figure>

        <div class="stats">
          <p class="stats__quote r">{service.why.quote}</p>
          <div class="stats__grid">
            {
              service.why.stats.map((s, i) => (
                <div class="stat r" style={`--d:${i * 0.1}s`}>
                  <span
                    class="stat__num"
                    data-from={s.from}
                    data-to={s.to}
                    data-suffix={s.suffix}
                  >
                    {s.from}{s.suffix}
                  </span>
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__note">{s.note}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S3 · WHAT WE COVER (Alternating Platform / App / Lifestyle) ============ -->
    <section class="cover" id="coverage">
      <div class="shell">
        <header class="band">
          <p class="kicker r"><span class="kicker__tick"></span>The work, defined</p>
          <h2 class="dh r" style="--d:.05s">
            {service.cover.headingPre}<span class="serif">{service.cover.headingSerif}</span>{service.cover.headingPost}
          </h2>
          <p class="band__note r" style="--d:.1s">{service.cover.note}</p>
        </header>

        {
          service.cover.lanes.map((c, i) => (
            <article class={`feature ${i % 2 === 1 ? 'feature--rev' : ''}`}>
              {c.shot ? (
                <div class="feature__media feature__media--shot r">
                  <AppShot shot={c.shot} path={c.path} caption={c.caption ?? true} />
                </div>
              ) : (
                <figure class="feature__media crop r-clip">
                  <div class="crop__inner">
                    <img
                      src={c.image}
                      alt={c.alt}
                      width="1024"
                      height="820"
                      loading="lazy"
                    />
                  </div>
                  <figcaption class="fig">{c.label}</figcaption>
                </figure>
              )}

              <div class="feature__body">
                <p class="feature__idx r">
                  <span class="feature__tick"></span>
                  {c.label}
                </p>
                <h3 class="dh dh--sm r" style="--d:.05s">{c.heading}</h3>
                <p class="feature__lead r" style="--d:.1s">{c.lead}</p>
                {c.body.map((para, pi) => (
                  <p class="feature__p r" style={`--d:${0.12 + pi * 0.06}s`}>
                    {para}
                  </p>
                ))}
                <p class="feature__scope r" style="--d:.24s">In scope</p>
                <ul class="chips r" style="--d:.28s">
                  {c.tags.map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ S4 · PROOF / CONTACT SHEET ============ -->
    <section class="proof" id="proof">
      <div class="shell">
        <header class="band band--split">
          <div>
            <p class="kicker r"><span class="kicker__tick"></span>Contact sheet</p>
            <h2 class="dh r" style="--d:.05s">
              Platform, app &amp; <span class="serif">studio</span>.
            </h2>
          </div>
          <p class="band__note r" style="--d:.1s">{service.proof.note}</p>
        </header>

        <div class="sheet">
          {
            service.proof.samples.map((s, i) => (
              <figure
                class={`shot crop r-clip ${s.isApp ? 'shot--app' : ''}`}
                style={`--d:${(i % 3) * 0.08}s`}
              >
                <div class="crop__inner">
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="1024"
                    height="1024"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot__cap">
                  <span class="shot__brand">{s.brand}</span>
                  <span class="shot__kind">{s.kind}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S5 · ECOSYSTEM / CHINA & GLOBAL SPOTLIGHT ============ -->
    <section class="source">
      <div class="shell source__grid">
        <div class="source__visual">
          <figure class="source__main crop">
            <div class="crop__inner">
              <img
                src={service.source.mainImage}
                alt={service.source.mainAlt}
                width="1024"
                height="820"
                loading="lazy"
              />
            </div>
          </figure>
          <figure class="source__inset">
            <img
              src={service.source.insetImage}
              alt={service.source.insetAlt}
              width="1024"
              height="1024"
              loading="lazy"
            />
          </figure>
          <div class="source__stat">
            <span class="source__stat-num">{service.source.statNum}</span>
            <span class="source__stat-cap">{service.source.statCap}</span>
          </div>
        </div>

        <div class="source__body">
          <p class="kicker kicker--light r">
            <span class="kicker__tick"></span>{service.source.kicker}
          </p>
          <h2 class="dh r" style="--d:.05s">
            {service.source.headingLine1}<br />
            {service.source.headingLine2Pre}<span class="serif">{service.source.headingSerif}</span>{service.source.headingLine2Post}
          </h2>
          <p class="source__lead r" style="--d:.1s">{service.source.lead}</p>
          {
            service.source.paragraphs.map((p, idx) => (
              <p class="source__p r" style={`--d:${0.16 + idx * 0.06}s`}>
                {p}
              </p>
            ))
          }
          <ul class="creds r" style="--d:.24s">
            {
              service.source.creds.map((c) => (
                <li class="cred">
                  <svg viewBox="0 0 14 14" aria-hidden="true">
                    <path
                      d="M2 7.5 5.5 11 12 3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {c}
                </li>
              ))
            }
          </ul>
          <p class="source__p source__p--quiet r" style="--d:.3s">{service.source.quietNote}</p>
        </div>
      </div>
    </section>

    <!-- ============ S6 · PROCESS ============ -->
    <section class="craft" id="craft">
      <div class="seq" id="seq">
        <div class="seq__stick">
          <div class="shell craft__intro">
            <p class="kicker r"><span class="kicker__tick"></span>Our process</p>
            <h2 class="dh r" style="--d:.05s">
              {service.process.headingLine1}<br />
              {service.process.headingLine2Pre}<span class="serif">{service.process.headingSerif}</span>{service.process.headingLine2Post}
            </h2>
            <p class="craft__lede r" style="--d:.12s">{service.process.lede}</p>
            <p class="craft__note r" style="--d:.16s">{service.process.note}</p>
          </div>

          <div class="shell seq__stage">
            <div class="seq__nav" aria-label="Process steps">
              {
                service.process.steps.map((s, i) => (
                  <button
                    class="seq__step"
                    type="button"
                    data-i={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    <span class="seq__step-dot">
                      <span class="seq__step-fill"></span>
                    </span>
                    <span class="seq__step-label">{s.short}</span>
                  </button>
                ))
              }
            </div>

            <div class="seq__panels">
              {
                service.process.steps.map((s, i) => (
                  <article
                    class="seq__panel"
                    data-panel={i}
                    data-active={i === 0 ? 'true' : 'false'}
                  >
                    {s.shot ? (
                      <div class="seq__media seq__media--shot">
                        <AppShot shot={s.shot} path={s.path} caption={s.caption ?? true} />
                      </div>
                    ) : (
                      <figure class="seq__media crop">
                        <div class="crop__inner">
                          <img
                            src={s.image}
                            alt={s.alt}
                            width="1200"
                            height="900"
                            loading="lazy"
                          />
                        </div>
                      </figure>
                    )}
                    <div class="seq__text">
                      <span class="seq__tier">{s.tier}</span>
                      <h3 class="seq__title">{s.title}</h3>
                      <p class="seq__body">{s.body}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ S7 · APP OR STUDIO + WAYS TO WORK ============ -->
    <ServiceAppOrStudio
      pre={service.appOrStudio.pre}
      accent={service.appOrStudio.accent}
      post={service.appOrStudio.post}
      intro={service.appOrStudio.intro}
      columns={[
        {
          label: 'In the app',
          title: 'What your team can do on its own',
          body: service.appOrStudio.inAppBody,
        },
        {
          label: 'From the studio',
          title: 'What our team adds',
          body: service.appOrStudio.fromStudioBody,
        },
      ]}
      shot={service.appOrStudio.shot}
      shotPath={service.appOrStudio.shotPath}
      shotCaption={service.appOrStudio.shotCaption}
      links={service.appOrStudio.links}
      highlight="studio-app"
      ways={service.appOrStudio.ways}
    />

    <!-- ============ S8 · FAQ ============ -->
    <section class="faq">
      <div class="shell faq__grid">
        <aside class="faq__intro">
          <p class="kicker r"><span class="kicker__tick"></span>Questions</p>
          <h2 class="dh r" style="--d:.05s">
            Common questions,<br />before the first <span class="serif">call</span>.
          </h2>
          <p class="faq__sub r" style="--d:.1s">
            What brands ask before we start. If yours is not here, include it in your brief.
          </p>
          <div class="r" style="--d:.16s">
            <Button variant="primary" href={BRIEF}>Send a brief</Button>
          </div>
        </aside>

        <div class="acc">
          {
            service.faqs.map((faq) => (
              <div class="acc__row r">
                <button class="acc__q" type="button" aria-expanded="false">
                  <span class="acc__qmark">Q</span>
                  <span class="acc__qtext">{faq.q}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <span></span><span></span>
                  </span>
                </button>
                <div class="acc__a">
                  <div class="acc__a-inner">
                    <p>
                      {faq.link ? (
                        <>
                          {faq.a.split(faq.link.match)[0]}
                          <a href={faq.link.href}>{faq.link.match}</a>
                          {faq.a.split(faq.link.match)[1]}
                        </>
                      ) : (
                        faq.a
                      )}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ S8b · FURTHER READING ============ -->
    <InsightsLayer placement="socialMedia" tone="white" id="reading" />

    <!-- ============ S9 · CLOSING ============ -->
    <section class="end">
      <svg class="end__reg" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="34" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M50 4v92M4 50h92" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div class="shell end__inner">
        <p class="kicker kicker--light r"><span class="kicker__tick"></span>Try us</p>
        <h2 class="end__title r" style="--d:.05s">
          {service.closing.titleLine1}<br />
          <span class="serif">{service.closing.titleSerif}</span>
        </h2>
        <p class="end__p r" style="--d:.12s">
          {service.closing.body}
          Rather run it yourself in the app? Create your hubStudio account. It costs nothing to start.
        </p>
        <div class="end__cta r" style="--d:.18s">
          <Button variant="primary" href={BRIEF}>Send a brief</Button>
          <a class="ghost-link ghost-link--light" href={APP_SIGNUP} target="_blank" rel="noopener">
            Create your account
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M4 10h12M11 5l5 5-5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
      <div class="cbar cbar--end" aria-hidden="true">
        {colourBar.map((c) => <span style={`background:${c}`}></span>)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .kicker__crumb {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .kicker__crumb:hover {
    color: var(--brand-orange);
  }

  /* ===================== Foundations ===================== */
  .page {
    --ink: #0e1633;
    --navy: #0e1f4e;
    --paper: #f0ede9;
    --paper-2: #e7e3dd;
    overflow-x: clip;
  }
  .shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 60px);
  }

  /* Scroll progress */
  .prog {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .prog__bar {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-orange);
  }

  /* Reveal primitives */
  .r,
  .r-clip {
    --d: 0s;
  }
  .r {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d);
  }
  .r.in {
    opacity: 1;
    transform: none;
  }
  .r-clip .crop__inner {
    clip-path: inset(0 0 101% 0);
    transition: clip-path 1.05s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip .crop__inner img {
    transform: scale(1.12);
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--d, 0s);
  }
  .r-clip.in .crop__inner {
    clip-path: inset(0 0 0 0);
  }
  .r-clip.in .crop__inner img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .r,
    .r.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .r-clip .crop__inner,
    .r-clip .crop__inner img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  /* Mono kicker label */
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .kicker--light {
    color: rgba(240, 237, 233, 0.66);
  }
  .kicker__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .kicker__sep {
    color: var(--brand-orange);
  }

  /* Display heading */
  .dh {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .dh--sm {
    font-size: clamp(26px, 2.6vw, 38px);
  }
  .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand-orange);
  }

  /* Figure caption + crop frame */
  .crop {
    position: relative;
    margin: 0;
  }
  .crop::before,
  .crop::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
  }
  .crop::before {
    top: -9px;
    left: -9px;
    border-top: 1.5px solid var(--brand-orange);
    border-left: 1.5px solid var(--brand-orange);
  }
  .crop::after {
    right: -9px;
    bottom: 28px;
    border-right: 1.5px solid var(--brand-orange);
    border-bottom: 1.5px solid var(--brand-orange);
  }
  .crop__inner {
    overflow: hidden;
    border-radius: 4px;
  }
  .crop__inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fig {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* Ghost link */
  .ghost-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-ink);
  }
  .ghost-link svg {
    width: 19px;
    height: 19px;
    transition: transform 0.24s ease-out;
  }
  .ghost-link:hover svg {
    transform: translateX(5px);
  }
  .ghost-link--light {
    color: var(--text-on-dark);
  }

  /* Section header band */
  .band {
    max-width: 720px;
    margin-bottom: clamp(40px, 5vw, 70px);
    display: grid;
    gap: 18px;
  }
  .band--split {
    max-width: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .band--split {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 18px 60px;
    }
    .band--split > div {
      display: grid;
      gap: 18px;
    }
  }
  .band__note {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
  }

  /* Calibration color bar */
  .cbar {
    display: flex;
    height: 12px;
  }
  .cbar span {
    flex: 1;
  }
  .cbar--end {
    margin-top: clamp(60px, 8vw, 110px);
  }

  /* ===================== S1 · Hero ===================== */
  .hero {
    display: grid;
    background: var(--ink);
    color: var(--text-on-dark);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__panel {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(40px, 4.4vw, 72px) clamp(24px, 5vw, 64px);
    overflow: clip;
  }
  .hero__reg {
    position: absolute;
    width: clamp(240px, 28vw, 420px);
    right: -12%;
    bottom: -14%;
    color: rgba(240, 237, 233, 0.055);
    pointer-events: none;
  }
  .hero__panel-in {
    position: relative;
    width: 100%;
    max-width: 600px;
  }
  .hero__title {
    margin-top: 24px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(44px, 6.2vw, 86px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding: 0.22em 0.14em;
    margin: -0.22em -0.14em;
  }
  .hero__title .line__i {
    display: block;
    transform: translateY(145%);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero__title .line:nth-child(1) .line__i {
    transition-delay: 0.12s;
  }
  .hero__title .line:nth-child(2) .line__i {
    transition-delay: 0.22s;
  }
  .hero__title .line:nth-child(3) .line__i {
    transition-delay: 0.32s;
  }
  .hero.in .hero__title .line__i {
    transform: translateY(0);
  }
  .hero__title .serif {
    font-size: 1.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line__i {
      transform: none;
    }
  }
  .hero__tag {
    margin-top: 26px;
    font-size: clamp(18px, 1.5vw, 23px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__tag em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--brand-orange);
  }
  .hero__lead {
    margin-top: 20px;
    display: grid;
    gap: 13px;
    max-width: 48ch;
  }
  .hero__lead p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.74);
  }
  .hero__cta {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .hero__meta {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1.5px dashed rgba(240, 237, 233, 0.2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
  }
  .hero__meta span {
    color: var(--brand-orange);
  }
  .hero__visual {
    position: relative;
    overflow: hidden;
    min-height: 58vh;
  }
  @media (min-width: 900px) {
    .hero__visual {
      min-height: auto;
    }
  }
  .hero__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero.in .hero__visual img {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__visual img {
      transform: none;
    }
  }
  .hero__chip {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    background: rgba(14, 22, 51, 0.82);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }
  .hero__chip span {
    color: var(--brand-orange);
  }

  /* ===================== S2 · Why ===================== */
  .why {
    background: var(--ink);
    color: var(--text-on-dark);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .why__top {
    display: grid;
    gap: 30px;
  }
  @media (min-width: 900px) {
    .why__top {
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: start;
    }
  }
  .why__head .dh {
    margin-top: 18px;
  }
  .why__text {
    display: grid;
    gap: 16px;
    align-content: start;
    padding-top: 6px;
  }
  .why__text p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: rgba(240, 237, 233, 0.78);
  }
  .why__clients {
    color: rgba(240, 237, 233, 0.6) !important;
  }
  .why__clients strong {
    color: var(--text-on-dark);
    font-weight: 600;
  }
  .why__shot {
    margin-top: clamp(40px, 5vw, 72px);
  }
  .why__shot .crop__inner {
    aspect-ratio: 16 / 8;
  }
  .why__shot .fig {
    color: rgba(240, 237, 233, 0.5);
  }

  /* Stats */
  .stats {
    margin-top: clamp(48px, 6vw, 84px);
    border-top: 1.5px dashed rgba(240, 237, 233, 0.22);
    padding-top: clamp(36px, 4vw, 56px);
  }
  .stats__quote {
    max-width: 60ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(19px, 1.9vw, 25px);
    line-height: 1.42;
    color: var(--text-on-dark);
  }
  .stats__grid {
    margin-top: 40px;
    display: grid;
    gap: 30px;
  }
  @media (min-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .stat {
    display: grid;
    gap: 5px;
    padding-top: 24px;
    border-top: 1.5px solid rgba(240, 237, 233, 0.16);
  }
  .stat__num {
    font-size: clamp(48px, 6vw, 84px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--brand-orange);
  }
  .stat__label {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 600;
  }
  .stat__note {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.55);
  }

  /* ===================== S3 · Cover ===================== */
  .cover {
    background: var(--paper);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .feature {
    display: grid;
    gap: 36px;
    align-items: center;
    padding-block: clamp(40px, 5vw, 72px);
    border-top: 1.5px dashed var(--line-strong);
  }
  .feature:last-child {
    border-bottom: 1.5px dashed var(--line-strong);
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
    }
    .feature--rev .feature__media {
      order: 2;
    }
  }
  .feature__media .crop__inner {
    aspect-ratio: 5 / 4;
  }
  .feature__media--shot {
    min-width: 0;
  }
  .feature__idx {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .feature__tick {
    width: 22px;
    height: 0;
    border-top: 1.5px solid var(--brand-orange);
  }
  .feature__body .dh {
    margin-top: 16px;
  }
  .feature__lead {
    margin-top: 14px;
    font-size: var(--type-lead);
    line-height: 1.42;
    color: var(--text-ink);
    font-weight: 500;
  }
  .feature__p {
    margin-top: 14px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .feature__scope {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line-hairline);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .chips {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 500;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .chip:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
  }

  /* ===================== S4 · Proof sheet ===================== */
  .proof {
    background: var(--bg-white);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .sheet {
    display: grid;
    gap: clamp(22px, 3vw, 40px);
  }
  @media (min-width: 720px) {
    .sheet {
      grid-template-columns: repeat(3, 1fr);
    }
    .sheet .shot:nth-child(3n + 2) {
      margin-top: 60px;
    }
    .sheet .shot:nth-child(3n) {
      margin-top: 30px;
    }
  }
  .shot .crop__inner {
    aspect-ratio: 1 / 1;
    background: #10172e;
  }
  .shot--app .crop__inner {
    background: #f6f4f0;
    border: 1px solid var(--line-strong);
  }
  .shot--app .crop__inner img {
    object-fit: cover;
    object-position: top left;
  }
  .shot .crop__inner img {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shot:hover .crop__inner img {
    transform: scale(1.06);
  }
  .shot__cap {
    margin-top: 14px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--ink);
  }
  .shot__brand {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .shot__kind {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* ===================== S5 · Source / Ecosystem spotlight ===================== */
  .source {
    background: var(--navy);
    color: var(--text-on-dark);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .source__grid {
    display: grid;
    gap: 52px;
  }
  @media (min-width: 940px) {
    .source__grid {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 70px;
      align-items: center;
    }
  }
  .source__visual {
    position: relative;
  }
  .source__main .crop__inner {
    aspect-ratio: 5 / 4;
  }
  .source__inset {
    position: absolute;
    right: -14px;
    bottom: -34px;
    width: 42%;
    max-width: 200px;
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 5px solid var(--navy);
    box-shadow: 0 20px 36px rgba(0, 0, 0, 0.42);
  }
  .source__inset img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  @media (max-width: 520px) {
    .source__inset {
      display: none;
    }
  }
  .source__stat {
    position: absolute;
    left: -10px;
    top: 36px;
    display: grid;
    gap: 3px;
    padding: 15px 19px;
    border-radius: 12px;
    background: var(--brand-orange);
    color: #fff;
    box-shadow: 0 16px 32px rgba(233, 78, 27, 0.42);
  }
  .source__stat-num {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .source__stat-cap {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    max-width: 16ch;
    line-height: 1.4;
  }
  .source__body .dh {
    margin-top: 16px;
  }
  .source__lead {
    margin-top: 20px;
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-on-dark);
  }
  .source__p {
    margin-top: 15px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: rgba(240, 237, 233, 0.78);
  }
  .source__p--quiet {
    color: rgba(240, 237, 233, 0.55);
  }
  .creds {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .cred {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(240, 237, 233, 0.2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .cred:hover {
    border-color: var(--brand-orange);
    background: rgba(233, 78, 27, 0.16);
  }
  .cred svg {
    width: 13px;
    height: 13px;
    color: var(--brand-orange);
  }

  /* ===================== S6 · Process ===================== */
  .craft {
    background: var(--paper);
    padding-top: clamp(72px, 8vw, 120px);
  }
  .craft--pinned {
    padding-top: 0;
  }
  .craft__intro {
    margin-bottom: clamp(20px, 2.4vh, 32px);
  }
  .craft__intro .kicker {
    color: var(--brand-orange);
  }
  .craft__intro .dh {
    margin-top: 10px;
  }
  .craft__lede {
    margin-top: 12px;
    font-size: var(--type-lead);
    line-height: 1.48;
    color: var(--text-mute);
  }
  .craft__note {
    margin-top: 14px;
    display: inline-block;
    padding: 11px 18px;
    border-left: 3px solid var(--brand-orange);
    background: rgba(233, 78, 27, 0.07);
    border-radius: 0 10px 10px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-ink);
  }
  @media (min-width: 880px) {
    .craft__intro {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      column-gap: clamp(40px, 5vw, 72px);
      align-items: start;
    }
    .craft__intro .kicker {
      grid-column: 1 / -1;
    }
    .craft__intro .dh {
      grid-column: 1;
      grid-row: 2 / span 2;
      margin-top: 10px;
    }
    .craft__lede {
      grid-column: 2;
      grid-row: 2;
      margin-top: 10px;
    }
    .craft__note {
      grid-column: 2;
      grid-row: 3;
      margin-top: 12px;
      justify-self: start;
    }
  }

  .seq__nav {
    display: none;
  }
  .seq__panels {
    display: grid;
    gap: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(80px, 10vw, 150px);
  }
  .seq__panel {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 760px) {
    .seq__panel {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .seq__panel:nth-child(even) .seq__media {
      order: 2;
    }
  }
  .seq__media .crop__inner {
    aspect-ratio: 4 / 3;
  }
  .seq__media--shot {
    min-width: 0;
  }
  .seq__tier {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }
  .seq__title {
    margin-top: 12px;
    font-size: clamp(25px, 2.7vw, 38px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }
  .seq__body {
    margin-top: 14px;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }

  .craft--pinned .seq {
    height: 380vh;
  }
  .craft--pinned .seq__stick {
    position: sticky;
    top: var(--nav-h);
    min-height: calc(100vh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(20px, 2.8vh, 36px) clamp(24px, 3.5vh, 44px);
    overflow: hidden;
  }
  .craft--pinned .seq__stage {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vh, 24px);
  }
  .craft--pinned .seq__nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  .seq__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
  }
  .seq__step-dot {
    height: 5px;
    border-radius: 3px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .seq__step-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--brand-orange);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .seq__step-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-mute);
    transition: color 0.3s ease;
  }
  .seq__step[data-active='true'] .seq__step-label {
    color: var(--text-ink);
  }
  .craft--pinned .seq__panels {
    position: relative;
    display: block;
    height: clamp(290px, 44vh, 420px);
    padding-bottom: 0;
  }
  .craft--pinned .seq__panel {
    position: absolute;
    inset: 0;
    align-content: start;
    padding-top: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(26px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.5s;
  }
  .craft--pinned .seq__panel[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .craft--pinned .seq__panel:nth-child(even) .seq__media {
    order: 0;
  }
  .craft--pinned .seq__media .crop__inner {
    aspect-ratio: auto;
    height: clamp(260px, 40vh, 390px);
  }
  .craft--pinned .seq__media--shot :global(.appshot__frame img) {
    max-height: clamp(210px, 34vh, 320px);
    width: 100%;
    object-fit: cover;
    object-position: top;
  }
  @media (prefers-reduced-motion: reduce) {
    .craft--pinned .seq__panel {
      transition: none;
    }
  }

  /* ===================== S8 · FAQ ===================== */
  .faq {
    background: var(--paper);
    padding-block: clamp(80px, 10vw, 150px);
  }
  .faq__grid {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 1000px) {
    .faq__grid {
      grid-template-columns: 0.78fr 1.22fr;
      gap: 72px;
      align-items: start;
    }
    .faq__intro {
      position: sticky;
      top: 96px;
    }
  }
  .faq__intro .dh {
    margin-top: 18px;
  }
  .faq__sub {
    margin-top: 18px;
    margin-bottom: 26px;
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-mute);
  }
  .acc {
    display: grid;
  }
  .acc__row {
    border-top: 1.5px solid var(--ink);
  }
  .acc__row:last-child {
    border-bottom: 1.5px solid var(--ink);
  }
  .acc__q {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 16px;
    padding: 26px 0;
    background: transparent;
    border: none;
    text-align: left;
  }
  .acc__qmark {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-orange);
    padding-top: 3px;
  }
  .acc__qtext {
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-ink);
    transition: color 0.18s ease;
  }
  .acc__q:hover .acc__qtext {
    color: var(--brand-orange);
  }
  .acc__icon {
    position: relative;
    width: 22px;
    height: 22px;
    margin-top: 2px;
  }
  .acc__icon span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--text-ink);
    transform: translate(-50%, -50%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .acc__icon span:last-child {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .acc__q[aria-expanded='true'] .acc__icon span:last-child {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .acc__q[aria-expanded='true'] .acc__icon span {
    background: var(--brand-orange);
  }
  .acc__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.32s ease;
  }
  .acc__q[aria-expanded='true'] + .acc__a {
    grid-template-rows: 1fr;
  }
  .acc__a-inner {
    overflow: hidden;
  }
  .acc__a-inner p {
    padding: 0 0 26px 41px;
    max-width: 64ch;
    font-size: var(--type-body);
    line-height: 1.66;
    color: var(--text-mute);
  }
  .acc__a-inner a {
    color: var(--brand-orange);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ===================== S9 · Closing ===================== */
  .end {
    position: relative;
    background: var(--ink);
    color: var(--text-on-dark);
    padding-top: clamp(80px, 11vw, 150px);
    overflow: clip;
  }
  .end__reg {
    position: absolute;
    width: clamp(300px, 36vw, 560px);
    top: -16%;
    right: -9%;
    color: rgba(240, 237, 233, 0.05);
    pointer-events: none;
  }
  .end__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 22px;
  }
  .end__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(40px, 6.6vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .end__p {
    max-width: 54ch;
    font-size: var(--type-lead);
    line-height: 1.5;
    color: rgba(240, 237, 233, 0.78);
  }
  .end__cta {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
</style>

<script>
  import { t } from '../scripts/i18n';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* Scroll progress */
  const progBar = document.querySelector<HTMLElement>('.prog__bar');
  if (progBar) {
    const onScroll = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      progBar.style.transform = `scaleX(${max > 0 ? Math.min(1, d.scrollTop / max) : 0})`;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  /* Reveal on scroll */
  const revealEls = document.querySelectorAll('.r, .r-clip, .hero');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: '0px 0px -7% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  /* Count-up stats */
  const nums = Array.from(document.querySelectorAll<HTMLElement>('.stat__num'));
  const runCount = (el: HTMLElement) => {
    const from = Number(el.dataset.from || 0);
    const to = Number(el.dataset.to || 0);
    const suffix = el.dataset.suffix || '';
    if (reduceMotion.matches) {
      el.textContent = t(`{n}${suffix}`, { n: to });
      return;
    }
    const dur = 1500;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = t(`{n}${suffix}`, { n: Math.round(from + (to - from) * eased) });
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && nums.length) {
    const io2 = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runCount(e.target as HTMLElement);
            io2.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((n) => io2.observe(n));
  } else {
    nums.forEach(runCount);
  }

  /* Process: pinned scroll sequence */
  const craft = document.getElementById('craft');
  const seq = document.getElementById('seq');
  if (craft && seq) {
    const steps = Array.from(seq.querySelectorAll<HTMLElement>('.seq__step'));
    const panels = Array.from(seq.querySelectorAll<HTMLElement>('.seq__panel'));
    const fills = steps.map((s) => s.querySelector<HTMLElement>('.seq__step-fill'));
    const n = panels.length;
    const wide = window.matchMedia('(min-width: 880px)');

    const setActive = (idx: number, sub: number) => {
      panels.forEach((p, i) => (p.dataset.active = String(i === idx)));
      steps.forEach((s, i) => {
        s.dataset.active = String(i === idx);
        const f = fills[i];
        if (f) f.style.transform = `scaleX(${i < idx ? 1 : i === idx ? sub : 0})`;
      });
    };

    const stick = seq.querySelector<HTMLElement>('.seq__stick');
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!craft.classList.contains('craft--pinned')) return;
      const stickH = stick ? stick.offsetHeight : window.innerHeight;
      const stickTop = stick ? parseFloat(getComputedStyle(stick).top) || 0 : 0;
      const total = Math.max(1, seq.offsetHeight - stickH);
      const scrolled = Math.min(total, Math.max(0, stickTop - seq.getBoundingClientRect().top));
      const p = total > 0 ? scrolled / total : 0;
      const exact = p * n;
      const idx = Math.min(n - 1, Math.floor(exact));
      const sub = Math.min(1, Math.max(0, exact - idx));
      setActive(idx, idx === n - 1 ? 1 : sub);
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const applyMode = () => {
      if (wide.matches && !reduceMotion.matches) {
        craft.classList.add('craft--pinned');
        update();
      } else {
        craft.classList.remove('craft--pinned');
        panels.forEach((p) => (p.dataset.active = 'true'));
      }
    };

    steps.forEach((s, i) => {
      s.addEventListener('click', () => {
        if (!craft.classList.contains('craft--pinned')) return;
        const stickH = stick ? stick.offsetHeight : window.innerHeight;
        const stickTop = stick ? parseFloat(getComputedStyle(stick).top) || 0 : 0;
        const railTop = seq.getBoundingClientRect().top + window.scrollY - stickTop;
        const total = Math.max(1, seq.offsetHeight - stickH);
        window.scrollTo({
          top: railTop + ((i + 0.5) / n) * total,
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
        });
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      applyMode();
      update();
    });
    applyMode();
  }

  /* FAQ accordion: one open at a time */
  const accQs = Array.from(document.querySelectorAll<HTMLButtonElement>('.acc__q'));
  accQs.forEach((q) => {
    q.addEventListener('click', () => {
      const open = q.getAttribute('aria-expanded') === 'true';
      accQs.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      q.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });
</script>
