---
/**
 * Footer: §5. Top-level menu entries only (no mega-menu links) as a static
 * link list on --bg-ink. Small logo, location line, copyright, legal links.
 */
import Logo from './Logo.astro';
import { getLocaleFromUrl, localizePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const lp = (p: string) => localizePath(p, locale);
const year = new Date().getFullYear();

/* Top-level menu entries only, mirroring the header nav. No mega-menu links. */
const navLinks: { label: string; href: string }[] = [
  { label: 'Services', href: '/services' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'The Studio', href: '/the-studio' },
  { label: 'Work', href: '/work' },
  { label: 'Resources', href: '/resources' },
  { label: 'hub4You', href: '/hub4you' },
];

/* Sister agencies: the BeyondBorderGroup network. */
const network: { name: string; desc: string; logo: string; href: string }[] = [
  {
    name: 'BeyondBorderGroup.com',
    desc: 'Market entry consulting for Western brands growing in China.',
    logo: '/AgencyLogos/beyondbordergroup.png',
    href: 'https://beyondbordergroup.com',
  },
  {
    name: 'NuvoraStudio.com',
    desc: 'LinkedIn presence built daily. Content, ads, executive branding.',
    logo: '/AgencyLogos/nuvora.png',
    href: 'https://nuvorastudio.com',
  },
  {
    name: 'ChinaWebFoundry.com',
    desc: 'Websites built for the Chinese internet. ICP, Baidu SEO, hosting.',
    logo: '/AgencyLogos/chinawebfoundry.png',
    href: 'https://chinawebfoundry.com',
  },
  {
    name: 'BeyondCompass.com',
    desc: 'Vetted distributor and Tmall partner introductions in China.',
    logo: '/AgencyLogos/beyondcompass.png',
    href: 'https://beyondcompass.com',
  },
  {
    name: 'TheRedScroll.com',
    desc: 'Daily WeChat, Douyin, RedNote and Weibo operations from the ground.',
    logo: '/AgencyLogos/theredscroll.png',
    href: 'https://theredscroll.com',
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href={lp('/')} aria-label="hubStudio home"><Logo tone="dark" /></a>
      <p class="site-footer__line">
        A production house built for what content has become.
      </p>
      <p class="site-footer__loc">Studios across 16 markets &middot; Working worldwide</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={lp(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__network">
    <p class="site-footer__heading">Our network</p>
    <ul class="footer-net">
      {
        network.map((n) => (
          <li class="footer-net__item">
            <a class="footer-net__card" href={n.href} target="_blank" rel="noopener">
              <img src={n.logo} alt={`${n.name} logo`} loading="lazy" />
            </a>
            <p class="footer-net__name">{n.name}</p>
            <p class="footer-net__desc">{n.desc}</p>
          </li>
        ))
      }
    </ul>

    <a class="footer-parent" href="https://beyondbordergroup.org" target="_blank" rel="noopener">
      <span class="footer-parent__logo">
        <img src="/AgencyLogos/beyondbordergroup.png" alt="BeyondBorderGroup logo" loading="lazy" />
      </span>
      <span class="footer-parent__body">
        <span class="footer-parent__eyebrow">Parent group</span>
        <span class="footer-parent__name">BeyondBorderGroup.org</span>
        <span class="footer-parent__text">
          The umbrella group connecting our specialised China agencies.
        </span>
      </span>
      <span class="footer-parent__cta">Visit <span aria-hidden="true">&rarr;</span></span>
    </a>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} hubStudio. All rights reserved.</p>
    <div class="site-footer__legal">
      <a href={lp('/privacy')}>Privacy</a>
      <a href={lp('/terms')}>Terms</a>
      <a href={lp('/cookies')}>Cookies</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .site-footer__inner {
    display: grid;
    gap: 48px;
    padding-block: 80px 56px;
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 3fr;
      gap: 64px;
    }
  }
  .site-footer__line {
    margin-top: 20px;
    max-width: 30ch;
    font-size: var(--type-small);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.72);
  }
  .site-footer__loc {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__nav {
    display: flex;
    align-items: center;
  }
  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .site-footer__nav a {
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.82);
    transition: color 120ms ease-out;
  }
  .site-footer__nav a:hover {
    color: var(--brand-orange);
  }
  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
    margin-bottom: 16px;
  }
  /* ---- Our network ---------------------------------------------- */
  .site-footer__network {
    padding-bottom: 64px;
  }
  .footer-net {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 24px;
  }
  @media (min-width: 640px) {
    .footer-net {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .footer-net {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .footer-net__card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 22px;
    background: #fff;
    border-radius: 14px;
    transition: transform 200ms ease-out;
  }
  .footer-net__card:hover {
    transform: translateY(-3px);
  }
  .footer-net__card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .footer-net__name {
    margin-top: 16px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--text-on-dark);
  }
  .footer-net__desc {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(240, 237, 233, 0.55);
  }

  .footer-parent {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 22px 24px;
    border-radius: 18px;
    background: linear-gradient(110deg, #16244d, var(--bg-ink) 78%);
    border: 1px solid rgba(240, 237, 233, 0.12);
    transition: border-color 160ms ease-out;
  }
  .footer-parent:hover {
    border-color: rgba(240, 237, 233, 0.3);
  }
  .footer-parent__logo {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 92px;
    background: #fff;
    border-radius: 12px;
  }
  .footer-parent__logo img {
    width: 90%;
    height: auto;
  }
  .footer-parent__body {
    display: grid;
    gap: 5px;
    flex: 1;
  }
  .footer-parent__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6ea6e6;
  }
  .footer-parent__name {
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-on-dark);
  }
  .footer-parent__text {
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.6);
  }
  .footer-parent__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 22px;
    border: 1px solid rgba(240, 237, 233, 0.3);
    border-radius: var(--radius-pill);
    font-size: var(--type-button);
    font-weight: 600;
    color: var(--text-on-dark);
  }
  @media (max-width: 639px) {
    .footer-parent {
      flex-wrap: wrap;
    }
    .footer-parent__cta {
      width: 100%;
      justify-content: center;
    }
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    padding-block: 24px 32px;
    border-top: 1px solid rgba(240, 237, 233, 0.12);
    font-size: 12px;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__legal {
    display: flex;
    gap: 24px;
  }
  .site-footer__legal a:hover {
    color: var(--brand-orange);
  }
</style>
