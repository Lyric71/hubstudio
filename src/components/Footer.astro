---
/**
 * Footer: §5. Top-level menu entries only (no mega-menu links) as a static
 * link list on --bg-ink. Small logo, location line, copyright, legal links.
 */
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { APP_SIGNUP, APP_SIGNIN } from '../lib/links';

const year = new Date().getFullYear();

/* The two offers first, then the rest of the header, then the company.
   English addresses: on a French or Chinese page the middleware points them
   at the translated pages (src/i18n). */
const navLinks: { label: string; href: string }[] = [
  { label: 'The app', href: '/app' },
  { label: 'The studio', href: '/studio' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Work', href: '/work' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Resources', href: '/resources' },
  { label: 'About', href: '/about' },
  { label: 'Partners', href: '/partners' },
  { label: 'Contact', href: '/contact' },
  { label: 'Help center', href: '/help' },
];

/* Parent group: the BearingBridge AI lockup, rendered as on bearingbridge.com. */
const parent = {
  name: 'BearingBridge AI',
  desc: 'Every team you cannot afford to hire, running inside one app.',
  href: 'https://www.bearingbridge.com',
};
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="hubStudio home"><Logo tone="dark" /></a>
      <p class="site-footer__line">
        An AI production app, and the studio that runs on it.
      </p>
      <p class="site-footer__app">
        <a href={APP_SIGNUP} rel="noopener">Create your account</a>
        <span aria-hidden="true">/</span>
        <a href={APP_SIGNIN} rel="noopener">Sign in</a>
      </p>
      <p class="site-footer__loc">Working worldwide</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__network">
    <p class="site-footer__heading">Part of</p>
    <a
      class="footer-parent"
      href={parent.href}
      target="_blank"
      rel="noopener"
      aria-label={parent.name}
    >
      <span class="footer-parent__bar" aria-hidden="true"></span>
      <span class="footer-parent__word"
        >bearingbridge<span class="footer-parent__ai">ai</span></span
      >
    </a>
    <p class="footer-parent__desc">{parent.desc}</p>
  </div>


  <div class="container site-footer__bottom">
    <p>&copy; <span data-no-i18n>{year}</span> hubStudio. All rights reserved.</p>
    <LangSwitch variant="row" class="ls-row--quiet" />
    <div class="site-footer__legal">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/cookies">Cookies</a>
      <a class="site-footer__tool" href="/pricing/calculator" rel="nofollow"
        >Quotation engine</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .site-footer__inner {
    display: grid;
    gap: 48px;
    padding-block: 80px 56px;
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 3fr;
      gap: 64px;
    }
  }
  .site-footer__line {
    margin-top: 20px;
    max-width: 30ch;
    font-size: var(--type-small);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.72);
  }
  .site-footer__app {
    margin-top: 18px;
    display: flex;
    gap: 10px;
    font-size: var(--type-small);
    font-weight: 600;
  }
  .site-footer__app a {
    color: var(--brand-orange);
  }
  .site-footer__app a:hover {
    color: #fff;
  }
  .site-footer__app span {
    color: rgba(240, 237, 233, 0.3);
  }
  .site-footer__loc {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__nav {
    display: flex;
    align-items: center;
  }
  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .site-footer__nav a {
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.82);
    transition: color 120ms ease-out;
  }
  .site-footer__nav a:hover {
    color: var(--brand-orange);
  }
  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
    margin-bottom: 16px;
  }
  /* ---- Part of: BearingBridge AI lockup -------------------------- */
  .site-footer__network {
    padding-bottom: 64px;
  }
  .footer-parent {
    display: inline-flex;
    align-items: center;
    gap: 0.52em;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #eaeaea;
    transition: opacity 160ms ease-out;
  }
  .footer-parent:hover {
    opacity: 0.78;
  }
  .footer-parent__bar {
    flex: none;
    width: 0.52em;
    height: 1.354em;
    background: #1bcde8;
    transform: skew(-18deg);
  }
  .footer-parent__ai {
    margin-left: 0.21em;
    color: #1bcde8;
  }
  .footer-parent__desc {
    margin-top: 14px;
    max-width: 42ch;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(240, 237, 233, 0.55);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    padding-block: 24px 32px;
    border-top: 1px solid rgba(240, 237, 233, 0.12);
    font-size: 12px;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__legal {
    display: flex;
    gap: 24px;
  }
  .site-footer__legal a:hover {
    color: var(--brand-orange);
  }
  /* Internal quoting tool: password-gated, so it reads as instrumentation
     rather than another legal page. */
  .site-footer__tool {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.38);
  }
</style>
