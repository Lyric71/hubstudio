---
/**
 * Footer: §5. Top-level menu entries only (no mega-menu links) as a static
 * link list on --bg-ink. Small logo, location line, copyright, legal links.
 */
import Logo from './Logo.astro';
import { getLocaleFromUrl, localizePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const lp = (p: string) => localizePath(p, locale);
const year = new Date().getFullYear();

/* Header top-level entries, plus the hub4You platform. No mega-menu links. */
const navLinks: { label: string; href: string }[] = [
  { label: 'Services', href: '/services' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'The Studio', href: '/the-studio' },
  { label: 'Work', href: '/work' },
  { label: 'Resources', href: '/resources' },
  { label: 'hub4You', href: '/hub4you' },
];

/* Parent group: the BearingBridge AI lockup, rendered as on bearingbridge.com. */
const parent = {
  name: 'BearingBridge AI',
  desc: 'Every team you cannot afford to hire, running inside one app.',
  href: 'https://www.bearingbridge.com',
};
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href={lp('/')} aria-label="hubStudio home"><Logo tone="dark" /></a>
      <p class="site-footer__line">
        A production house built for what content has become.
      </p>
      <p class="site-footer__loc">Working worldwide</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={lp(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__network">
    <p class="site-footer__heading">Part of</p>
    <a
      class="footer-parent"
      href={parent.href}
      target="_blank"
      rel="noopener"
      aria-label={parent.name}
    >
      <span class="footer-parent__bar" aria-hidden="true"></span>
      <span class="footer-parent__word"
        >bearingbridge<span class="footer-parent__ai">ai</span></span
      >
    </a>
    <p class="footer-parent__desc">{parent.desc}</p>
  </div>


  <div class="container site-footer__bottom">
    <p>&copy; {year} hubStudio. All rights reserved.</p>
    <div class="site-footer__legal">
      <a href={lp('/privacy')}>Privacy</a>
      <a href={lp('/terms')}>Terms</a>
      <a href={lp('/cookies')}>Cookies</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .site-footer__inner {
    display: grid;
    gap: 48px;
    padding-block: 80px 56px;
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 3fr;
      gap: 64px;
    }
  }
  .site-footer__line {
    margin-top: 20px;
    max-width: 30ch;
    font-size: var(--type-small);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.72);
  }
  .site-footer__loc {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__nav {
    display: flex;
    align-items: center;
  }
  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .site-footer__nav a {
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.82);
    transition: color 120ms ease-out;
  }
  .site-footer__nav a:hover {
    color: var(--brand-orange);
  }
  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
    margin-bottom: 16px;
  }
  /* ---- Part of: BearingBridge AI lockup -------------------------- */
  .site-footer__network {
    padding-bottom: 64px;
  }
  .footer-parent {
    display: inline-flex;
    align-items: center;
    gap: 0.52em;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #eaeaea;
    transition: opacity 160ms ease-out;
  }
  .footer-parent:hover {
    opacity: 0.78;
  }
  .footer-parent__bar {
    flex: none;
    width: 0.52em;
    height: 1.354em;
    background: #1bcde8;
    transform: skew(-18deg);
  }
  .footer-parent__ai {
    margin-left: 0.21em;
    color: #1bcde8;
  }
  .footer-parent__desc {
    margin-top: 14px;
    max-width: 42ch;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(240, 237, 233, 0.55);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    padding-block: 24px 32px;
    border-top: 1px solid rgba(240, 237, 233, 0.12);
    font-size: 12px;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__legal {
    display: flex;
    gap: 24px;
  }
  .site-footer__legal a:hover {
    color: var(--brand-orange);
  }
</style>
