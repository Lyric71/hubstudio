---
/**
 * Footer: §5. Top-level menu entries only (no mega-menu links) as a static
 * link list on --bg-ink. Small logo, location line, copyright, legal links.
 */
import Logo from './Logo.astro';
import { getLocaleFromUrl, localizePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const lp = (p: string) => localizePath(p, locale);
const year = new Date().getFullYear();

/* Header top-level entries, plus the hub4You platform. No mega-menu links. */
const navLinks: { label: string; href: string }[] = [
  { label: 'Services', href: '/services' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'The Studio', href: '/the-studio' },
  { label: 'Work', href: '/work' },
  { label: 'Resources', href: '/resources' },
  { label: 'hub4You', href: '/hub4you' },
];

/* Sister agencies: the BearingBridge group network. */
const network: { name: string; desc: string; logo: string; href: string }[] = [
  {
    name: 'TheChinaPath.com',
    desc: 'Full-service China entry. Branding through to ecommerce.',
    logo: '/AgencyLogos/thechinapath.png',
    href: 'https://thechinapath.com',
  },
  {
    name: 'BeyondBridge.ai',
    desc: 'The full pipeline for Chinese brands going overseas.',
    logo: '/AgencyLogos/beyondbridge.png',
    href: 'https://beyondbridge.ai',
  },
  {
    name: 'BearingBridge.ai',
    desc: 'AI adoption consulting. East and West, on your data.',
    logo: '/AgencyLogos/bearingbridgeai.svg',
    href: 'https://bearingbridge.ai',
  },
  {
    name: 'ChinaWebFoundry.com',
    desc: 'Websites built for the Chinese web. Baidu, ICP, AI engines.',
    logo: '/AgencyLogos/chinawebfoundry.png',
    href: 'https://chinawebfoundry.com',
  },
  {
    name: 'TheRedScroll.com',
    desc: 'Chinese social media. WeChat, Douyin, RedNote, Weibo.',
    logo: '/AgencyLogos/theredscroll.png',
    href: 'https://theredscroll.com',
  },
  {
    name: 'Compass',
    desc: 'A private database of vetted China distributors, Tmall TPs, and Douyin partners.',
    logo: '/AgencyLogos/compass.svg',
    href: 'https://compass.bearingbridge.com',
  },
  {
    name: 'Nuvora.studio',
    desc: 'LinkedIn-only B2B. Strategy, content, ads.',
    logo: '/AgencyLogos/nuvora.png',
    href: 'https://nuvora.studio',
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href={lp('/')} aria-label="hubStudio home"><Logo tone="dark" /></a>
      <p class="site-footer__line">
        A production house built for what content has become.
      </p>
      <p class="site-footer__loc">Working worldwide</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={lp(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__network">
    <p class="site-footer__heading">Our network</p>
    <ul class="footer-net">
      {
        network.map((n) => (
          <li class="footer-net__item">
            <a
              class="footer-net__card"
              href={n.href}
              target="_blank"
              rel="noopener"
              title={`${n.name} — ${n.desc}`}
            >
              <img src={n.logo} alt={`${n.name} logo`} loading="lazy" />
            </a>
            <p class="footer-net__desc">{n.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} hubStudio. All rights reserved.</p>
    <div class="site-footer__legal">
      <a href={lp('/privacy')}>Privacy</a>
      <a href={lp('/terms')}>Terms</a>
      <a href={lp('/cookies')}>Cookies</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }
  .site-footer__inner {
    display: grid;
    gap: 48px;
    padding-block: 80px 56px;
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 3fr;
      gap: 64px;
    }
  }
  .site-footer__line {
    margin-top: 20px;
    max-width: 30ch;
    font-size: var(--type-small);
    line-height: 1.55;
    color: rgba(240, 237, 233, 0.72);
  }
  .site-footer__loc {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__nav {
    display: flex;
    align-items: center;
  }
  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .site-footer__nav a {
    font-size: var(--type-small);
    color: rgba(240, 237, 233, 0.82);
    transition: color 120ms ease-out;
  }
  .site-footer__nav a:hover {
    color: var(--brand-orange);
  }
  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 237, 233, 0.5);
    margin-bottom: 16px;
  }
  /* ---- Our network ---------------------------------------------- */
  .site-footer__network {
    padding-bottom: 64px;
  }
  .footer-net {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 640px) {
    .footer-net {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 900px) {
    .footer-net {
      grid-template-columns: repeat(7, 1fr);
    }
  }
  .footer-net__card {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 12px 16px;
    background: #fff;
    border-radius: 10px;
    transition: transform 200ms ease-out;
  }
  .footer-net__card:hover {
    transform: translateY(-3px);
  }
  .footer-net__card img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .footer-net__desc {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(240, 237, 233, 0.55);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    padding-block: 24px 32px;
    border-top: 1px solid rgba(240, 237, 233, 0.12);
    font-size: 12px;
    color: rgba(240, 237, 233, 0.5);
  }
  .site-footer__legal {
    display: flex;
    gap: 24px;
  }
  .site-footer__legal a:hover {
    color: var(--brand-orange);
  }
</style>
