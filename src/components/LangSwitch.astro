---
/**
 * Language switcher: the same page in English, French or Chinese.
 *
 * `bar` sits in the header's right-hand cluster: a mono code (EN, FR, 中文)
 * that opens a three-line sheet. `row` is the flat version for the mobile
 * drawer and the footer: three links side by side.
 *
 * Each link points at the current page's own translation (src/i18n/paths.ts),
 * never at a language home. The links carry data-no-localize and the names
 * data-no-i18n, so the middleware leaves both alone: a language is always
 * named in itself. The "Language" label itself is translated.
 */
import { LOCALES, LOCALE_NAMES, HTML_LANG, pathIn, type Locale } from '../i18n/paths';

interface Props {
  variant?: 'bar' | 'row';
  class?: string;
}

const { variant = 'bar', class: className } = Astro.props;
const current: Locale = Astro.locals.locale ?? 'en';
const enPath = Astro.url.pathname;
const CODES: Record<Locale, string> = { en: 'EN', fr: 'FR', zh: '中文' };
const links = LOCALES.map((l) => ({ l, href: pathIn(enPath, l) ?? (l === 'en' ? '/' : `/${l}`) }));
---

{
  variant === 'bar' ? (
    <details class:list={['ls', className]} data-ls data-no-localize>
      <summary class="ls__btn" aria-label="Language">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path
            d="M1.9 8h12.2M8 1.75c1.7 1.8 2.55 3.88 2.55 6.25S9.7 12.45 8 14.25C6.3 12.45 5.45 10.37 5.45 8S6.3 3.55 8 1.75Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
          />
        </svg>
        <span data-no-i18n>{CODES[current]}</span>
      </summary>
      <ul class="ls__sheet">
        {links.map(({ l, href }) => (
          <li>
            <a
              href={href}
              hreflang={HTML_LANG[l]}
              lang={HTML_LANG[l]}
              aria-current={l === current ? 'true' : undefined}
            >
              <span class="ls__code" data-no-i18n>{CODES[l]}</span>
              <span data-no-i18n>{LOCALE_NAMES[l]}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <nav class:list={['ls-row', className]} aria-label="Language" data-no-localize>
      {links.map(({ l, href }) => (
        <a href={href} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === current ? 'true' : undefined}>
          <span data-no-i18n>{LOCALE_NAMES[l]}</span>
        </a>
      ))}
    </nav>
  )
}

<script>
  // Close the sheet on a click elsewhere or on Escape.
  for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-ls]')) {
    document.addEventListener('click', (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false;
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && el.open) {
        el.open = false;
        el.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .ls {
    position: relative;
  }
  .ls__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.1rem;
    padding: 0 0.7rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: currentColor;
    cursor: pointer;
    list-style: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  /* Below 1440 px the bar is full: the globe alone stands for the menu. */
  @media (max-width: 1439px) {
    .ls__btn {
      padding: 0 0.5rem;
    }
    .ls__btn span {
      display: none;
    }
  }
  .ls__btn::-webkit-details-marker {
    display: none;
  }
  .ls__btn svg {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    opacity: 0.7;
  }
  .ls__btn:hover,
  .ls[open] .ls__btn {
    border-color: color-mix(in oklab, currentColor 35%, transparent);
  }
  .ls__btn:focus-visible {
    outline: 2px solid var(--brand-orange);
    outline-offset: 2px;
  }
  .ls__sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 5;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--bg-white);
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.35);
    animation: ls-in 0.18s ease;
  }
  @keyframes ls-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .ls__sheet a {
    color: var(--text-ink);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .ls__sheet a:hover {
    background: color-mix(in oklab, var(--brand-orange) 10%, transparent);
  }
  .ls__sheet a[aria-current='true'] {
    color: var(--brand-orange);
  }
  .ls__code {
    min-width: 2.2rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--text-mute);
  }
  .ls-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.85rem;
  }
  .ls-row a {
    color: inherit;
    opacity: 0.72;
    text-decoration: none;
  }
  .ls-row a:hover {
    opacity: 1;
  }
  /* In a strip that already sets its own type (the footer's legal line). */
  .ls-row--quiet {
    font-size: inherit;
  }
  .ls-row a[aria-current='true'] {
    opacity: 1;
    color: var(--brand-orange);
  }
</style>
