---
/**
 * ServiceAppOrStudio: the "do it in the app, or have the studio do it?"
 * answer on a studio service page (/services/design/*), followed by the
 * three ways band.
 *
 * One section per service page. The head asks the question for that
 * service, two columns answer it honestly (what the app covers and what the
 * studio adds, or, where the app does not cover the job, how the studio runs
 * it and where the app still helps), an optional real capture of the app
 * sits beside them, and WaysToWork closes the section with the locked offer.
 *
 * Self-contained (own container, tokens and type) so it drops into any of
 * the service pages whatever their own art direction. No ordinal numerals.
 */
import WaysToWork from './WaysToWork.astro';
import AppShot from './AppShot.astro';
import type { AppShot as Shot } from '../data/app-shots';

type Way = 'app' | 'studio-app' | 'studio';

interface Column {
  /** Small mono label above the heading, e.g. "In the app". Optional. */
  label?: string;
  title: string;
  body: string[];
}

interface Props {
  eyebrow?: string;
  /** Headline pieces: pre + italic accent + post. */
  pre: string;
  accent: string;
  post?: string;
  intro: string;
  columns: Column[];
  shot?: Shot;
  /** App route shown in the capture's address bar. */
  shotPath?: string;
  shotCaption?: string | boolean;
  links?: { label: string; href: string }[];
  /** The way lifted in the band below. */
  highlight: Way;
  /** Headline and optional lead of the three ways band. */
  ways: { pre: string; accent: string; post?: string; lead?: string };
  id?: string;
}

const {
  eyebrow = 'App or studio',
  pre,
  accent,
  post = '',
  intro,
  columns,
  shot,
  shotPath = '',
  shotCaption = true,
  links = [],
  highlight,
  ways,
  id = 'app-or-studio',
} = Astro.props;
---

<section class:list={['saos', shot && 'saos--shot']} id={id}>
  <div class="saos__container">
    <header class="saos__head">
      <span class="saos__eyebrow">{eyebrow}</span>
      <h2 class="saos__title">
        {pre}<span class="saos__accent">{accent}</span>{post}
      </h2>
      <p class="saos__intro">{intro}</p>
    </header>

    <div class="saos__grid">
      <div class="saos__cols">
        {
          columns.map((c) => (
            <div class="saos__col">
              {c.label && (
                <span class="saos__label">
                  <span class="saos__dot" aria-hidden="true" />
                  {c.label}
                </span>
              )}
              <h3 class="saos__h3">{c.title}</h3>
              {c.body.map((p) => (
                <p class="saos__p">{p}</p>
              ))}
            </div>
          ))
        }
      </div>

      {
        shot && (
          <div class="saos__shot">
            <AppShot shot={shot} path={shotPath} caption={shotCaption} />
          </div>
        )
      }
    </div>

    {
      links.length > 0 && (
        <ul class="saos__links">
          {links.map((l) => (
            <li>
              <a href={l.href}>
                {l.label} <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<WaysToWork
  tone="white"
  highlight={highlight}
  eyebrow="Three ways to work"
  pre={ways.pre}
  accent={ways.accent}
  post={ways.post ?? ''}
  lead={ways.lead ?? ''}
  id={`${id}-ways`}
/>

<style>
  .saos {
    background: var(--bg-white);
    color: var(--text-ink);
    padding-block: clamp(80px, 10vw, 140px) clamp(8px, 2vw, 24px);
    border-top: 1px solid var(--line-hairline);
  }
  /* The ways band continues this section: pull it up so the two read as one. */
  .saos + :global(.wtw) {
    padding-top: clamp(48px, 6vw, 80px);
  }
  .saos__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad-mobile);
  }
  @media (min-width: 768px) {
    .saos__container {
      padding-inline: var(--container-pad-desktop);
    }
  }
  .saos__head {
    display: grid;
    gap: 14px;
    max-width: 780px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .saos__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .saos__title {
    font-size: var(--type-h2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: var(--lh-headline);
  }
  .saos__accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--brand-orange);
  }
  .saos__intro {
    font-size: var(--type-lead);
    line-height: 1.5;
    color: var(--text-mute);
    max-width: 60ch;
  }
  .saos__grid {
    display: grid;
    gap: clamp(36px, 5vw, 64px);
    align-items: start;
  }
  .saos__cols {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
  }
  @media (min-width: 900px) {
    /* Without a capture the two columns sit side by side. */
    .saos:not(.saos--shot) .saos__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .saos--shot .saos__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    }
    .saos--shot .saos__shot {
      position: sticky;
      top: 110px;
    }
  }
  .saos__col {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }
  .saos__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .saos__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .saos__h3 {
    font-size: var(--type-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .saos__p {
    font-size: var(--type-body);
    line-height: 1.62;
    color: var(--text-ink);
    max-width: 62ch;
  }
  .saos__p + .saos__p {
    margin-top: 4px;
  }
  .saos__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 22px;
    border-top: 1px solid var(--line-hairline);
  }
  .saos__links a {
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }
  .saos__links a span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .saos__links a:hover span {
    transform: translateX(5px);
  }
</style>
