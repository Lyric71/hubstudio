---
/**
 * Header: §5 navigation + mega menu.
 * Persistent top nav, mega-menu panels, mobile right-sheet drawer.
 * Every desktop panel opens with the same intro column (eyebrow · headline ·
 * blurb · "All of X" link), then a layout that fits the section: standard
 * (link groups · featured card), services (four-column design-service list)
 * or solutions (client/consulting columns · platform grid). Panels open on
 * hover / keyboard focus (CSS); JS handles the scroll state, Esc-to-close and
 * the mobile drawer.
 */
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { APP_SIGNUP, APP_SIGNIN, BRIEF_URL } from '../lib/links';

interface Props {
  /** When true the bar sits transparently over a dark hero: light text /
   *  cream-wordmark logo until the page scrolls past 80px. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

type Intro = { eyebrow: string; pre: string; accent: string; post: string; text: string };
type Link = { title: string; desc: string; href: string };
type Group = { heading: string; links: Link[] };
type Featured = {
  variant: 'orange' | 'navy' | 'cream';
  eyebrow: string;
  title: string;
  text: string;
  cta: { label: string; href: string };
  /** When set, the card art slot shows this image instead of a gradient. */
  image?: string;
};
type FlatLink = { label: string; href: string };
type ServiceGroup = { heading: string; links: FlatLink[] };
type SubGroup = { heading: string; links: FlatLink[] };
type SolutionCol = { heading: string; links?: FlatLink[]; subgroups?: SubGroup[] };
type MenuItem = {
  label: string;
  href: string;
  intro?: Intro;
  groups?: Group[];
  featured?: Featured;
  /** When set, the item renders the Services panel (grouped columns). */
  serviceGroups?: ServiceGroup[];
  /** When set, the item renders the Solutions panel (grouped columns). */
  solutionCols?: SolutionCol[];
  /** Short link list under the intro column (the Studio panel's own pages). */
  introLinks?: FlatLink[];
};

const menu: MenuItem[] = [
  {
    label: 'App',
    href: '/app',
    intro: {
      eyebrow: 'The hubStudio app',
      pre: 'Every engine, one ',
      accent: 'app',
      post: '.',
      text: 'Make images and video with the leading AI engines, then edit, approve, and publish them. You pay as you go, and there are no seat fees.',
    },
    groups: [
      {
        heading: 'Make',
        links: [
          { title: 'Create', desc: 'Explore, the Image and Video studios, Skills', href: '/app/create' },
          { title: 'Engines', desc: 'Every image and video engine, by maker', href: '/app/engines' },
          { title: 'Assets Library', desc: 'Files in folders, tags, versions, search', href: '/app/library' },
        ],
      },
      {
        heading: 'Edit',
        links: [
          { title: 'Image tools', desc: 'The Image editor and the Image anonymizer', href: '/app/image-tools' },
          { title: 'Video tools', desc: 'The Video editor and Shorts autopilot', href: '/app/video-tools' },
        ],
      },
      {
        heading: 'Ship',
        links: [
          { title: 'Publish', desc: 'LinkedIn, Instagram, Facebook, TikTok, X', href: '/app/publish' },
          { title: 'Review and clients', desc: 'Validation, Client space, your team', href: '/app/review' },
          { title: 'Help center', desc: 'Step-by-step guides to every screen', href: '/help' },
        ],
      },
    ],
    featured: {
      variant: 'navy',
      eyebrow: 'Open sign-up',
      title: 'Create your hubStudio account',
      text: 'The account is free. You pay only for what you run.',
      cta: { label: 'Create your account', href: APP_SIGNUP },
      image: '/Images/app/explore.webp',
    },
  },
  {
    label: 'Studio',
    href: '/studio',
    intro: {
      eyebrow: 'The hubStudio studio',
      pre: 'Twenty service lines. One ',
      accent: 'studio',
      post: '.',
      text: 'Senior art directors and AIGC specialists who take the brief and deliver the work, inside the app or outside it.',
    },
    introLinks: [
      { label: 'Studio + app', href: '/studio/with-the-app' },
      { label: 'How we use AI', href: '/studio/ai-excellence' },
      { label: 'Who we are', href: '/about' },
      { label: 'Creative talents', href: '/about/team' },
      { label: 'Partners', href: '/partners' },
    ],
    serviceGroups: [
      {
        heading: 'Content & Social',
        links: [
          { label: 'Social Media', href: '/services/design/social-media' },
          { label: 'Ad Creative', href: '/services/design/ad-creative' },
          { label: 'Short Video', href: '/services/design/short-video' },
          { label: 'Email Design', href: '/services/design/email-design' },
        ],
      },
      {
        heading: 'Video & Motion',
        links: [
          { label: 'Video Production', href: '/services/design/video-production' },
          { label: 'Motion Design', href: '/services/design/motion-design' },
        ],
      },
      {
        heading: 'Commerce & Web',
        links: [
          { label: 'eCommerce', href: '/services/design/ecommerce' },
          { label: 'Website Design', href: '/services/design/website-design' },
          { label: 'Print Design', href: '/services/design/print-design' },
        ],
      },
      {
        heading: 'Strategy & Direction',
        links: [
          { label: 'Marketing Strategy', href: '/services/design/marketing-strategy' },
          { label: 'Creative Strategy', href: '/services/design/creative-strategy' },
          { label: 'Concept Creation', href: '/services/design/concept-creation' },
          { label: 'Storyboard', href: '/services/design/storyboard' },
        ],
      },
      {
        heading: 'Brand Identity',
        links: [
          { label: 'Brand Identity', href: '/services/design/brand-identity' },
          { label: 'Illustration Design', href: '/services/design/illustration-design' },
          { label: 'Packaging & Merch Design', href: '/services/design/packaging-merch-design' },
        ],
      },
      {
        heading: 'Sales & Communications',
        links: [
          { label: 'Presentation Design', href: '/services/design/presentation-design' },
          { label: 'Pitch Deck', href: '/services/design/pitch-deck' },
          { label: 'Ebook and Digital Reports', href: '/services/design/ebook-digital-reports' },
          { label: 'Press Release', href: '/services/design/press-release' },
        ],
      },
    ],
  },
  {
    label: 'Solutions',
    href: '/solutions',
    intro: {
      eyebrow: 'Solutions',
      pre: 'Built around how your brand ',
      accent: 'sells',
      post: '.',
      text: 'Who we work with, the consulting we run, and the platforms we produce for, in the app and in the studio.',
    },
    solutionCols: [
      {
        heading: 'Who it is for',
        links: [
          { label: 'Brands', href: '/solutions/brands' },
          { label: 'Agencies', href: '/solutions/agencies' },
          { label: 'Retailers', href: '/solutions/retailers' },
          { label: 'Manufacturers', href: '/solutions/manufacturers' },
        ],
      },
      {
        heading: 'Consulting',
        links: [
          { label: 'Consulting', href: '/solutions/consulting' },
          { label: 'Training', href: '/solutions/training' },
        ],
      },
      {
        heading: 'AI Production',
        links: [
          { label: 'Image', href: '/solutions/ai-production/image' },
          { label: 'Video', href: '/solutions/ai-production/video' },
          { label: 'Content', href: '/solutions/ai-production/content' },
        ],
      },
      {
        heading: 'Platforms',
        subgroups: [
          {
            heading: 'Social',
            links: [
              { label: 'Meta', href: '/solutions/platforms/meta' },
              { label: 'TikTok', href: '/solutions/platforms/tiktok' },
              { label: 'LinkedIn', href: '/solutions/platforms/linkedin' },
              { label: 'WeChat', href: '/solutions/platforms/wechat' },
              { label: 'RedNote', href: '/solutions/platforms/rednote' },
              { label: 'Douyin', href: '/solutions/platforms/douyin' },
              { label: 'Weibo', href: '/solutions/platforms/weibo' },
            ],
          },
          {
            heading: 'eCommerce',
            links: [
              { label: 'Website', href: '/solutions/platforms/ecommerce-website' },
              { label: 'Amazon', href: '/solutions/platforms/amazon' },
              { label: 'Tmall', href: '/solutions/platforms/tmall' },
              { label: 'JD', href: '/solutions/platforms/jd' },
              { label: 'Shopify', href: '/solutions/platforms/shopify' },
            ],
          },
          {
            heading: 'Brand',
            links: [
              { label: 'Website', href: '/solutions/platforms/brand-website' },
            ],
          },
        ],
      },
    ],
  },
  {
    label: 'Work',
    href: '/work',
  },
  {
    label: 'Pricing',
    href: '/pricing',
  },
  {
    label: 'Resources',
    href: '/resources',
    intro: {
      eyebrow: 'Resources',
      pre: 'Worth ',
      accent: 'reading',
      post: '.',
      text: 'Perspectives, practical guides, the legal ground rules for AI content, and the app help center.',
    },
    groups: [
      {
        heading: 'Learn',
        links: [
          { title: 'Insights', desc: 'Essays on AI-native content', href: '/resources/insights' },
          { title: 'How-to guides', desc: 'Practical, step by step', href: '/resources/how-to' },
          { title: 'Glossary', desc: 'The vocabulary, defined', href: '/resources/glossary' },
        ],
      },
      {
        heading: 'Rights and help',
        links: [
          { title: 'Copyright & AI', desc: 'Using AI without risk', href: '/resources/copyright-and-ai' },
          { title: 'Help center', desc: 'Guides to the hubStudio app', href: '/help' },
          { title: 'About hubStudio', desc: 'The company and the people', href: '/about' },
        ],
      },
    ],
    featured: {
      variant: 'cream',
      eyebrow: 'Latest insight',
      title: 'If your content can be summarized, it will lose',
      text: 'Why AI search is forcing a new content system.',
      cta: { label: 'Read the insight', href: '/resources/insights/ai-search-content-systems' },
      image: '/Images/mega-resources.webp',
    },
  },
];
---

<header
  class="site-header"
  id="site-header"
  data-scrolled="false"
  data-overlay={overlay ? 'true' : 'false'}
>
  <div class="site-header__bar">
    <div class="container site-header__inner">
      <a class="site-header__logo" href="/" aria-label="hubStudio home">
        <Logo class="logo--light" />
        <Logo tone="dark" class="logo--dark" />
      </a>

      <nav class="primary-nav" aria-label="Primary">
        <ul class="menubar">
          {
            menu.map((item) => {
              /* Plain link: no dropdown */
              if (!item.groups && !item.serviceGroups && !item.solutionCols) {
                return (
                  <li class="nav-item">
                    <a class="nav-item__trigger" href={item.href}>
                      {item.label}
                    </a>
                  </li>
                );
              }
              return (
                <li class="nav-item">
                  <a class="nav-item__trigger" href={item.href} aria-haspopup="true">
                    {item.label}
                    <svg class="nav-item__chevron" viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M2 4 6 8 10 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>

                  <div class="mega" role="region" aria-label={item.label}>
                    <div
                      class:list={[
                        'container',
                        'mega__grid',
                        item.serviceGroups && 'mega__grid--services',
                        item.solutionCols && 'mega__grid--solutions',
                      ]}
                    >
                      {/* Column 1: shared intro */}
                      <div class="mega__intro">
                        <span class="eyebrow">{item.intro!.eyebrow}</span>
                        <p class="headline h3 mega__head">
                          {item.intro!.pre}
                          <span class="accent">{item.intro!.accent}</span>
                          {item.intro!.post}
                        </p>
                        <p class="mega__intro-text">{item.intro!.text}</p>
                        {item.introLinks && (
                          <ul class="mega__intro-list">
                            {item.introLinks.map((l) => (
                              <li>
                                <a class="sol-link" href={l.href}>
                                  {l.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                        <a class="mega__intro-link" href={item.href}>
                          All of {item.label} &rarr;
                        </a>
                      </div>

                      {/* Services layout */}
                      {item.serviceGroups && (
                        <div class="mega__services">
                          {item.serviceGroups.map((group) => (
                            <div class="mega__svc-col">
                              <p class="mega__group-head">{group.heading}</p>
                              <ul class="mega__svc-list">
                                {group.links.map((l) => (
                                  <li>
                                    <a class="sol-link" href={l.href}>
                                      {l.label}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      )}

                      {/* Solutions layout */}
                      {item.solutionCols && (
                        <div class="mega__solutions">
                          <div class="mega__sol-side">
                            {item.solutionCols
                              .filter((col) => col.links)
                              .map((col) => (
                                <div class="mega__sol-col">
                                  <p class="mega__group-head">{col.heading}</p>
                                  <ul class="mega__sol-list">
                                    {col.links!.map((l) => (
                                      <li>
                                        <a class="sol-link" href={l.href}>
                                          {l.label}
                                        </a>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              ))}
                          </div>
                          {item.solutionCols
                            .filter((col) => col.subgroups)
                            .map((col) => (
                              <div class="mega__sol-platforms">
                                <p class="mega__group-head">{col.heading}</p>
                                <div class="mega__sol-plat-grid">
                                  {col.subgroups!.map((sg) => (
                                    <div class="mega__sol-plat-col">
                                      <p class="mega__sol-sub-head">{sg.heading}</p>
                                      <ul class="mega__sol-list">
                                        {sg.links.map((l) => (
                                          <li>
                                            <a class="sol-link" href={l.href}>
                                              {l.label}
                                            </a>
                                          </li>
                                        ))}
                                      </ul>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            ))}
                        </div>
                      )}

                      {/* Standard layout: link groups + featured card */}
                      {item.groups && (
                        <div class="mega__lists" data-cols={item.groups.length}>
                          {item.groups.map((group) => (
                            <div class="mega__group">
                              <p class="mega__group-head">{group.heading}</p>
                              <ul>
                                {group.links.map((link) => (
                                  <li>
                                    <a class="mega__link" href={link.href}>
                                      <span class="mega__link-title">{link.title}</span>
                                      <span class="mega__link-desc">{link.desc}</span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      )}
                      {item.featured && (
                        <a
                          class={`mega__feat card card--${item.featured.variant}`}
                          href={/^https?:/.test(item.featured.cta.href) ? item.featured.cta.href : item.featured.cta.href}
                        >
                          {item.featured.image ? (
                            <img
                              class="mega__feat-img"
                              src={item.featured.image}
                              alt={item.featured.title}
                              width="400"
                              height="320"
                              loading="lazy"
                            />
                          ) : (
                            <span class={`mega__feat-art mega__feat-art--${item.featured.variant}`} aria-hidden="true" />
                          )}
                          <span class="mega__feat-body">
                            <span class="eyebrow">{item.featured.eyebrow}</span>
                            <span class="mega__feat-title">{item.featured.title}</span>
                            <span class="mega__feat-text">{item.featured.text}</span>
                            <span class="mega__feat-cta">{item.featured.cta.label} &rarr;</span>
                          </span>
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="site-header__actions">
        {/* The app door first (sign in, create an account), the studio door
            second (send a brief). See hubstudio-positioning.md. */}
        <LangSwitch class="site-header__lang" />
        <a class="site-header__signin" href={APP_SIGNIN} rel="noopener">Sign in</a>
        <a class="btn btn--primary site-header__engine" href={APP_SIGNUP} rel="noopener"
          >Create account</a
        >
        <a class="btn btn--secondary site-header__brief" href={BRIEF_URL}>Send a brief</a>
        <button
          class="site-header__burger"
          id="nav-burger"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          aria-label="Open menu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer (§5 right-sheet) -->
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <div class="mobile-drawer__panel">
      <div class="mobile-drawer__top container">
        <Logo />
        <button class="mobile-drawer__close" id="nav-close" aria-label="Close menu">&times;</button>
      </div>
      <div class="mobile-drawer__scroll container">
        {
          menu.map((item) => {
            /* Plain link */
            if (!item.groups && !item.serviceGroups && !item.solutionCols) {
              return (
                <div class="m-acc">
                  <a class="m-acc__trigger m-acc__trigger--link" href={item.href}>
                    {item.label}
                  </a>
                </div>
              );
            }
            return (
              <div class="m-acc">
                <button class="m-acc__trigger" aria-expanded="false">
                  {item.label}
                  <svg viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2 4 6 8 10 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="m-acc__panel">
                  <div class="m-acc__inner">
                    <p class="m-acc__intro">{item.intro!.text}</p>

                    {item.introLinks && (
                      <div class="m-acc__group">
                        <p class="mega__group-head">{item.label}</p>
                        <ul class="m-acc__group-list">
                          {item.introLinks.map((l) => (
                            <li>
                              <a href={l.href}>{l.label}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {item.serviceGroups &&
                      item.serviceGroups.map((group) => (
                        <div class="m-acc__group">
                          <p class="mega__group-head">{group.heading}</p>
                          <ul class="m-acc__group-list">
                            {group.links.map((l) => (
                              <li>
                                <a href={l.href}>{l.label}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}

                    {item.solutionCols &&
                      item.solutionCols.map((col) => (
                        <div class="m-acc__group">
                          <p class="mega__group-head">{col.heading}</p>
                          {col.links && (
                            <ul class="m-acc__group-list">
                              {col.links.map((l) => (
                                <li>
                                  <a href={l.href}>{l.label}</a>
                                </li>
                              ))}
                            </ul>
                          )}
                          {col.subgroups &&
                            col.subgroups.map((sg) => (
                              <div class="m-acc__sub">
                                <p class="m-acc__sub-head">{sg.heading}</p>
                                <ul class="m-acc__group-list">
                                  {sg.links.map((l) => (
                                    <li>
                                      <a href={l.href}>{l.label}</a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            ))}
                        </div>
                      ))}

                    {item.groups &&
                      item.groups.map((group) => (
                        <div class="m-acc__group">
                          <p class="mega__group-head">{group.heading}</p>
                          <ul class="m-acc__group-list">
                            {group.links.map((link) => (
                              <li>
                                <a href={link.href}>{link.title}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}

                    <a class="m-acc__all" href={item.href}>
                      All of {item.label} &rarr;
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="mobile-drawer__foot container">
        <a class="btn btn--primary" href={APP_SIGNUP} rel="noopener">Create account</a>
        <a class="btn btn--secondary" href={BRIEF_URL}>Send a brief</a>
        <a class="mobile-drawer__signin" href={APP_SIGNIN} rel="noopener">Already on hubStudio? Sign in</a>
        <LangSwitch variant="row" class="mobile-drawer__lang" />
      </div>
    </div>
  </div>
</header>

<style>
  /* ---- Nav bar -------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header__bar {
    background: transparent;
    transition: background-color 200ms ease-out, border-color 200ms ease-out;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled='true'] .site-header__bar {
    background: var(--bg-cream);
    border-bottom-color: var(--line-hairline);
  }
  .site-header__inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .site-header__inner {
      height: var(--nav-h);
    }
  }
  .site-header__logo {
    flex: none;
    display: inline-flex;
  }
  /* Two logo lockups, one shown at a time (dark-wordmark vs cream-wordmark). */
  .site-header__logo :global(.logo--dark) {
    display: none;
  }

  /* ---- Overlay mode: bar sits over a dark hero ----------------- */
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__logo :global(.logo--light) {
    display: none;
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__logo :global(.logo--dark) {
    display: inline-block;
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .nav-item__trigger {
    color: var(--text-on-dark);
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .nav-item__trigger:hover {
    color: var(--brand-orange);
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__burger {
    border-color: rgba(240, 237, 233, 0.42);
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__burger span {
    background: var(--text-on-dark);
  }
  /* Secondary CTA ("Talk to us") sits in the actions area over the dark hero,
     so its ink text and hairline border must lighten too or it vanishes. */
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__actions .btn--secondary {
    color: var(--text-on-dark);
    border-color: rgba(240, 237, 233, 0.42);
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__actions .btn--secondary:hover {
    border-color: var(--text-on-dark);
  }

  /* ---- Desktop menu bar ---------------------------------------- */
  .primary-nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .primary-nav {
      display: block;
    }
  }
  .menubar {
    display: flex;
    gap: 2px;
  }
  .nav-item {
    position: static;
  }
  .nav-item__trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    font-size: var(--type-button);
    font-weight: 500;
    color: var(--text-ink);
    border-radius: var(--radius-pill);
    transition: color 120ms ease-out;
    white-space: nowrap;
  }
  .nav-item__trigger:hover {
    color: var(--brand-orange);
  }
  .nav-item__chevron {
    flex: none;
    width: 11px;
    height: 11px;
    transition: transform 180ms ease-out;
  }
  .nav-item:hover .nav-item__chevron,
  .nav-item:focus-within .nav-item__chevron {
    transform: rotate(180deg);
  }

  /* ---- Mega panel ---------------------------------------------- */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--bg-cream);
    border-top: 1px solid var(--line-hairline);
    box-shadow: 0 18px 40px rgba(10, 10, 20, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 180ms ease-out, transform 180ms ease-out, visibility 0s linear 180ms;
  }
  .nav-item:hover .mega,
  .nav-item:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 180ms ease-out, transform 180ms ease-out;
  }
  .mega__grid {
    display: grid;
    grid-template-columns: 25% 1fr 25%;
    gap: 48px;
    min-height: 300px;
    padding-block: 34px;
  }
  .mega__grid--services,
  .mega__grid--solutions {
    grid-template-columns: 25% 1fr;
  }

  /* Column 1: shared intro */
  .mega__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--line-hairline);
    padding-right: 40px;
  }
  .mega__head {
    margin-top: 12px;
  }
  .mega__intro-text {
    margin-top: 14px;
    color: var(--text-mute);
    font-size: var(--type-small);
    line-height: 1.5;
  }
  .mega__intro-list {
    display: grid;
    gap: 1px;
    margin-top: 14px;
  }
  .mega__intro-link {
    display: inline-block;
    margin-top: 18px;
    font-size: var(--type-small);
    font-weight: 600;
    color: var(--brand-orange);
  }

  /* Standard: link groups */
  .mega__lists {
    display: grid;
    gap: 32px;
    align-content: center;
  }
  .mega__lists[data-cols='1'] .mega__group ul {
    grid-template-columns: repeat(2, 1fr);
    gap: 6px 28px;
  }
  .mega__lists[data-cols='2'] {
    grid-template-columns: repeat(2, 1fr);
  }
  .mega__lists[data-cols='3'] {
    grid-template-columns: repeat(3, 1fr);
  }
  .mega__group-head {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-bottom: 14px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--line-hairline);
  }
  .mega__group ul {
    display: grid;
    gap: 2px;
  }
  .mega__link {
    display: block;
    padding: 8px 10px;
    margin-inline: -10px;
    border-radius: 12px;
    transition: background-color 120ms ease-out;
  }
  .mega__link:hover {
    background: rgba(10, 10, 20, 0.04);
  }
  .mega__link-title {
    display: block;
    font-size: var(--type-small);
    font-weight: 600;
  }
  .mega__link-desc {
    display: block;
    font-size: 12px;
    color: var(--text-mute);
    margin-top: 1px;
  }

  /* ---- Services panel ------------------------------------------ */
  .mega__services {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 28px 20px;
    align-content: start;
  }
  .mega__svc-col {
    align-content: start;
  }
  /* Reserve two lines so single- and double-line heads align the
     hairline and the link list across all six columns. */
  .mega__svc-col .mega__group-head {
    min-height: 48px;
    line-height: 1.4;
  }
  .mega__svc-list {
    display: grid;
    gap: 1px;
    margin-top: 12px;
  }

  /* ---- Solutions panel ----------------------------------------- */
  .mega__solutions {
    display: grid;
    gap: 32px;
    align-content: start;
  }
  .mega__sol-side {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    align-content: start;
  }
  .mega__sol-plat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 12px;
  }
  .mega__sol-list {
    display: grid;
    gap: 1px;
    margin-top: 12px;
  }
  .mega__sol-plat-grid .mega__sol-list {
    margin-top: 4px;
  }
  .mega__sol-sub-head {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-ink);
    opacity: 0.6;
  }
  .sol-link {
    display: block;
    padding: 7px 10px;
    margin-inline: -10px;
    border-radius: 10px;
    font-size: var(--type-small);
    font-weight: 500;
    color: var(--text-ink);
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .sol-link:hover {
    background: rgba(10, 10, 20, 0.04);
    color: var(--brand-orange);
  }

  /* ---- Featured card ------------------------------------------- */
  .mega__feat {
    display: flex;
    flex-direction: column;
    align-self: start;
    overflow: hidden;
    transition: transform 200ms ease-out;
  }
  .mega__feat:hover {
    transform: translateY(-2px);
  }
  .mega__feat-art {
    height: 116px;
    flex: none;
  }
  .mega__feat-art--orange {
    background: linear-gradient(135deg, var(--brand-orange-deep), var(--brand-orange));
  }
  .mega__feat-art--navy {
    background: linear-gradient(135deg, #14275f, var(--brand-navy));
  }
  .mega__feat-art--cream {
    background: linear-gradient(135deg, #e5e1db, #d8d3cb);
  }
  .mega__feat-img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    flex: none;
  }
  .mega__feat-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mega__feat-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    margin-top: 4px;
  }
  .mega__feat-text {
    font-size: 12px;
    line-height: 1.45;
    opacity: 0.78;
  }
  .mega__feat-cta {
    font-size: 12px;
    font-weight: 600;
    margin-top: 6px;
  }
  .card--orange .eyebrow,
  .card--navy .eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }

  /* ---- Header actions ------------------------------------------ */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Below the desktop breakpoint the bar has no room for a second button, and
     the drawer already carries this one. */
  .site-header__engine {
    display: none;
  }
  @media (min-width: 1024px) {
    .site-header__engine {
      display: inline-flex;
      /* Held above its neighbour by a halo in the brand color, so the bar has an
         unmistakable first action without shouting a second one down. */
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand-orange) 14%, transparent);
      transition: box-shadow 0.18s ease;
    }
    .site-header__engine:hover {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--brand-orange) 20%, transparent);
    }
  }
  /* Sign in: a quiet text link, the returning user's door. The brief button
     needs the widest bar, so it steps back to the drawer below 1200px. */
  .site-header__signin {
    display: none;
    padding: 8px 6px;
    font-size: var(--type-button);
    font-weight: 500;
    color: var(--text-ink);
    white-space: nowrap;
    transition: color 120ms ease-out;
  }
  .site-header__signin:hover {
    color: var(--brand-orange);
  }
  .site-header__brief {
    display: none;
  }
  /* French labels run longer (Réalisations, Créer un compte, Envoyer un
     brief): between 1200 and 1535 px the French bar sits tighter so it
     still fits on one line. */
  @media (min-width: 1200px) and (max-width: 1535px) {
    .site-header:lang(fr) .nav-item__trigger {
      padding-inline: 7px;
    }
    .site-header:lang(fr) .site-header__inner,
    .site-header:lang(fr) .site-header__actions {
      gap: 6px;
    }
    .site-header:lang(fr) .site-header__actions .btn {
      padding-inline: 18px;
    }
  }
  /* Language switcher (LangSwitch.astro): same colour rules as Sign in. */
  .site-header :global(.site-header__lang) {
    display: none;
    color: var(--text-ink);
  }
  .site-header[data-overlay='true'][data-scrolled='false'] :global(.site-header__lang) {
    color: var(--text-on-dark);
  }
  .mobile-drawer__foot :global(.mobile-drawer__lang) {
    justify-content: center;
    margin-top: 8px;
  }
  @media (min-width: 1024px) {
    .site-header__signin {
      display: inline-flex;
    }
    .site-header :global(.site-header__lang) {
      display: block;
    }
  }
  @media (min-width: 1200px) {
    .site-header__brief {
      display: inline-flex;
    }
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__signin {
    color: var(--text-on-dark);
  }
  .site-header[data-overlay='true'][data-scrolled='false'] .site-header__signin:hover {
    color: var(--brand-orange);
  }
  .site-header__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 10px;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
  }
  .site-header__burger span {
    height: 1.6px;
    background: var(--text-ink);
    border-radius: 2px;
  }
  @media (min-width: 1024px) {
    .site-header__burger {
      display: none;
    }
  }

  /* ---- Mobile drawer ------------------------------------------- */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 150;
  }
  .mobile-drawer[hidden] {
    display: none;
  }
  .mobile-drawer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 20, 0.4);
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .mobile-drawer[data-open='true']::before {
    opacity: 1;
  }
  .mobile-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 92vw);
    background: var(--bg-cream);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 240ms ease-out;
  }
  .mobile-drawer[data-open='true'] .mobile-drawer__panel {
    transform: translateX(0);
  }
  .mobile-drawer__top {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
    border-bottom: 1px solid var(--line-hairline);
  }
  .mobile-drawer__close {
    background: transparent;
    border: none;
    font-size: 32px;
    line-height: 1;
    color: var(--text-ink);
  }
  .mobile-drawer__scroll {
    flex: 1;
    overflow-y: auto;
    padding-block: 8px 24px;
  }
  .mobile-drawer__foot {
    flex: none;
    display: grid;
    gap: 10px;
    padding-block: 18px;
    border-top: 1px solid var(--line-hairline);
  }
  .mobile-drawer__foot .btn {
    width: 100%;
  }
  .mobile-drawer__signin {
    padding-top: 4px;
    text-align: center;
    font-size: var(--type-small);
    color: var(--text-mute);
  }
  .mobile-drawer__signin:hover {
    color: var(--brand-orange);
  }
  .m-acc {
    border-bottom: 1px solid var(--line-hairline);
  }
  .m-acc__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    background: transparent;
    border: none;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-ink);
  }
  .m-acc__trigger svg {
    width: 14px;
    height: 14px;
    transition: transform 200ms ease-out;
  }
  .m-acc__trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .m-acc__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 240ms ease-in-out;
  }
  .m-acc__trigger[aria-expanded='true'] + .m-acc__panel {
    grid-template-rows: 1fr;
  }
  .m-acc__inner {
    overflow: hidden;
  }
  .m-acc__intro {
    margin-bottom: 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-mute);
  }
  .m-acc__group {
    margin-bottom: 18px;
  }
  .m-acc__group-list {
    display: grid;
    gap: 2px;
  }
  .m-acc__group-list a {
    display: block;
    padding: 8px 0;
    font-size: 15px;
  }
  .m-acc__link-title {
    display: block;
    font-weight: 600;
  }
  .m-acc__link-desc {
    display: block;
    font-size: 12px;
    color: var(--text-mute);
    margin-top: 1px;
  }
  .m-acc__sub {
    margin-top: 10px;
  }
  .m-acc__sub-head {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .m-acc__all {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 15px;
    font-weight: 600;
    color: var(--brand-orange);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const drawer = document.getElementById('mobile-drawer');
  const burger = document.getElementById('nav-burger');
  const closeBtn = document.getElementById('nav-close');

  /* Scroll state: cream background + hairline after 80px (§5). */
  const onScroll = () => {
    header?.setAttribute('data-scrolled', String(window.scrollY > 80));
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* Mobile drawer */
  const openDrawer = () => {
    if (!drawer) return;
    drawer.hidden = false;
    requestAnimationFrame(() => drawer.setAttribute('data-open', 'true'));
    burger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeDrawer = () => {
    if (!drawer) return;
    drawer.setAttribute('data-open', 'false');
    burger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      drawer.hidden = true;
    }, 260);
  };
  burger?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });

  /* Mobile accordion: one section open at a time */
  const accTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.m-acc__trigger'));
  accTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      accTriggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
      trigger.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  });

  /* Esc closes the drawer and any open desktop panel */
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (drawer && !drawer.hidden) closeDrawer();
    const active = document.activeElement as HTMLElement | null;
    if (active && active.closest('.nav-item')) active.blur();
  });
</script>
