---
/**
 * One feature video of the app (src/lib/feature-videos.ts), in the page's
 * language: its file, poster, captions, title and duration all come from the
 * manifest's version for that language, so the French page plays the -fr
 * file with French captions and the Chinese page the -zh one.
 *
 * The block carries data-no-i18n: its words are the manifest's own
 * translations, never the dictionaries'. A French or Chinese page renders the
 * English page with Astro.locals.locale set (src/middleware.ts), which is how
 * the right version is picked here.
 *
 * Native player only: controls, preload none (nothing but the poster loads
 * until the visitor presses play), playsinline, captions on by default. With
 * `lazy`, the poster itself waits until the video nears the viewport (a page
 * listing many videos); without JavaScript a lazy video still plays, it only
 * shows no poster. Playing one video pauses the others on the page.
 */
import { type Locale } from '../i18n/paths';
import { clock, inLang, isoDuration, type FeatureVideo } from '../lib/feature-videos';

interface Props {
  video: FeatureVideo;
  /** Poster loaded when the video nears the viewport. */
  lazy?: boolean;
  /** On an ink or navy band. */
  dark?: boolean;
  /** Larger caption, for the lead video of a group. */
  lead?: boolean;
}

const { video, lazy = false, dark = false, lead = false } = Astro.props;
const locale = (Astro.locals.locale ?? 'en') as Locale;
const v = inLang(video, locale);
const base = `/videos/${v.file}`;
---

<figure
  class:list={['fv', dark && 'fv--dark', lead && 'fv--lead']}
  data-no-i18n
  data-fv={video.number}
  data-topic={video.topic}
>
  <div class="fv__frame">
    <video
      class="fv__video"
      controls
      preload="none"
      playsinline
      width="1280"
      height="720"
      poster={lazy ? undefined : `${base}.jpg`}
      data-poster={lazy ? `${base}.jpg` : undefined}
      aria-label={v.title}
    >
      <source src={`${base}.mp4`} type="video/mp4" />
    </video>
  </div>
  <figcaption class="fv__cap">
    <span class="fv__title">{v.title}</span>
    <time class="fv__dur" datetime={isoDuration(v.duration)}>{clock(v.duration)}</time>
  </figcaption>
</figure>

<script>
  // Lazy posters: set when the video comes within a screen of the viewport.
  const lazy = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-poster]'));
  const show = (el: HTMLVideoElement) => {
    if (el.dataset.poster) el.poster = el.dataset.poster;
    delete el.dataset.poster;
  };
  if (lazy.length) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            show(e.target as HTMLVideoElement);
            io.unobserve(e.target);
          }
        },
        { rootMargin: '600px 0px', threshold: 0 },
      );
      lazy.forEach((el) => io.observe(el));
    } else lazy.forEach(show);
  }

  // One video plays at a time.
  const all = Array.from(document.querySelectorAll<HTMLVideoElement>('.fv__video'));
  for (const el of all) {
    el.addEventListener('play', () => {
      show(el);
      for (const other of all) if (other !== el && !other.paused) other.pause();
    });
  }
</script>

<style>
  .fv {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }
  /* The frame of the case studies' "in motion" videos (.vframe). */
  .fv__frame {
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: var(--bg-ink);
    border: 1px solid var(--line-hairline);
    box-shadow: 0 18px 36px -26px rgba(10, 10, 20, 0.5);
  }
  .fv--dark .fv__frame {
    border-color: rgba(240, 237, 233, 0.14);
    box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.7);
  }
  .fv__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--bg-ink);
  }
  /* The bottom band of every MP4 already carries a dark frame and burned-in
     white captions: remove the native control bar's dark gradient scrim so
     hovering the player never dims the captions underneath. */
  .fv__video::-webkit-media-controls-enclosure,
  .fv__video::-webkit-media-controls-panel {
    background: none !important;
    background-image: none !important;
    background-color: transparent !important;
  }
  .fv__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .fv__title {
    font-size: var(--type-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--text-ink);
  }
  .fv--lead .fv__title {
    font-size: var(--type-h4);
  }
  .fv__dur {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-mute);
  }
  .fv__dur::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--brand-orange);
    vertical-align: middle;
  }
  .fv--dark .fv__title {
    color: var(--text-on-dark);
  }
  .fv--dark .fv__dur {
    color: rgba(240, 237, 233, 0.62);
  }
</style>
