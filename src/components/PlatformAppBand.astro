---
/**
 * PlatformAppBand: the "app or studio" band on the /solutions/platforms pages.
 *
 * One short band per platform page that says plainly what the hubStudio app
 * does for that platform (publishes to it, makes files for it, or does not
 * touch it) and what the studio takes on. Western social pages pass two
 * columns and a real capture; Chinese platform pages pass prose only (the
 * app does not publish there, so no publishing screenshot); commerce pages
 * pass prose and at most one capture.
 *
 * Self-contained (own container, tokens and type) so it drops between the
 * page's own sections. No ordinal numerals: the columns carry no index.
 */
import AppShot from './AppShot.astro';
import type { AppShot as Shot } from '../data/app-shots';

interface Action {
  label: string;
  href: string;
  kind?: 'primary' | 'secondary' | 'text';
  external?: boolean;
}

interface Column {
  title: string;
  items: string[];
}

interface Props {
  eyebrow?: string;
  /** Headline pieces: pre + italic accent + post. */
  pre: string;
  accent: string;
  post?: string;
  paras: string[];
  columns?: Column[];
  shot?: Shot;
  /** App route for the capture's address bar. */
  path?: string;
  actions: Action[];
  tone?: 'white' | 'cream';
  id?: string;
}

const {
  eyebrow = 'The app and the studio',
  pre,
  accent,
  post = '',
  paras,
  columns,
  shot,
  path = '',
  actions,
  tone = 'white',
  id = 'app-or-studio',
} = Astro.props;
---

<section class:list={['pab', `pab--${tone}`]} id={id}>
  <div class="pab__container">
    <div class:list={['pab__top', shot && 'has-shot']}>
      <div class="pab__text">
        <span class="pab__eyebrow">
          <span class="pab__dot" aria-hidden="true"></span>
          {eyebrow}
        </span>
        <h2 class="pab__title">
          {pre}<span class="pab__accent">{accent}</span>{post}
        </h2>
        {paras.map((p, i) => <p class:list={['pab__p', i === 0 && 'pab__p--lead']}>{p}</p>)}
        {
          !columns && (
            <div class="pab__actions">
              {actions.map((a) => (
                <a
                  class:list={['pab__btn', `pab__btn--${a.kind ?? 'text'}`]}
                  href={a.href}
                  {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {a.label}
                  {(a.kind ?? 'text') === 'text' && <span aria-hidden="true">&rarr;</span>}
                </a>
              ))}
            </div>
          )
        }
      </div>
      {
        shot && (
          <div class="pab__shot">
            <AppShot shot={shot} path={path} caption />
          </div>
        )
      }
    </div>

    {
      columns && (
        <>
          <div class="pab__cols">
            {columns.map((c) => (
              <div class="pab__col">
                <h3 class="pab__col-title">{c.title}</h3>
                <ul class="pab__list">
                  {c.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="pab__actions">
            {actions.map((a) => (
              <a
                class:list={['pab__btn', `pab__btn--${a.kind ?? 'text'}`]}
                href={a.href}
                {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {a.label}
                {(a.kind ?? 'text') === 'text' && <span aria-hidden="true">&rarr;</span>}
              </a>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .pab {
    --pab-bg: var(--bg-white);
    --pab-card: var(--bg-cream);
    background: var(--pab-bg);
    color: var(--text-ink);
    padding-block: clamp(72px, 9vw, 130px);
  }
  .pab--cream {
    --pab-bg: var(--bg-cream);
    --pab-card: var(--bg-white);
  }
  .pab__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad-mobile);
  }
  @media (min-width: 768px) {
    .pab__container {
      padding-inline: var(--container-pad-desktop);
    }
  }
  .pab__top {
    display: grid;
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }
  .pab__top:not(.has-shot) .pab__text {
    max-width: 780px;
  }
  @media (min-width: 1024px) {
    .pab__top.has-shot {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  .pab__text {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .pab__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--type-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .pab__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-orange);
  }
  .pab__title {
    font-size: var(--type-h2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: var(--lh-headline);
    max-width: 22ch;
  }
  .pab__accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--brand-orange);
  }
  .pab__p {
    font-size: var(--type-body);
    line-height: 1.64;
    color: var(--text-mute);
    max-width: 62ch;
  }
  .pab__p--lead {
    color: var(--text-ink);
  }
  .pab__shot {
    min-width: 0;
  }
  .pab__cols {
    display: grid;
    gap: var(--gap-card);
    margin-top: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 860px) {
    .pab__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pab__col {
    padding: clamp(24px, 3vw, 34px);
    background: var(--pab-card);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-card);
  }
  .pab__col-title {
    font-size: var(--type-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .pab__list {
    display: grid;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pab__list li {
    position: relative;
    padding-left: 20px;
    font-size: var(--type-body);
    line-height: 1.55;
  }
  .pab__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 2px;
    background: var(--brand-orange);
  }
  .pab__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 12px;
  }
  .pab__cols + .pab__actions {
    margin-top: clamp(28px, 3vw, 40px);
  }
  .pab__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--type-button);
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: transform 140ms ease-out;
  }
  .pab__btn--primary,
  .pab__btn--secondary {
    padding: 12px 22px;
    border-radius: var(--radius-pill);
  }
  .pab__btn--primary {
    background: var(--brand-orange-cta);
    color: #fff;
  }
  .pab__btn--secondary {
    border: 1px solid var(--line-strong);
    color: var(--text-ink);
  }
  .pab__btn--primary:hover,
  .pab__btn--secondary:hover {
    transform: translateY(-3px);
  }
  .pab__btn--text {
    color: var(--brand-orange);
  }
  .pab__btn--text span {
    display: inline-block;
    transition: transform 160ms ease-out;
  }
  .pab__btn--text:hover span {
    transform: translateX(5px);
  }
</style>
